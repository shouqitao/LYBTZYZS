# ========================================
# 根目录保护规则 - 防止临时文件污染根目录
# ========================================

# 根目录临时JSON文件
/*.json
!/.env.example

# 根目录临时文本文件
/*.txt
!/README.md

# 根目录截图文件
/*.png
/*.jpg
/*.jpeg

# 根目录备份文件
/*.backup
/*.bak
/*.md.backup

# VS自动生成的用户配置
/*.slnLaunch.user

# 无扩展名临时文件
/制定*
/版本*
/nul

# 根目录中文临时文档
/问题*.md
/临时*.md

# ========================================
# Project specific temporary files
# ========================================
temp/
*.temp
*.tmp
*.local.md
*.private.*

# 构建日志和临时文件（防止污染根目录）
*.log
build.log
desktop-build*.log
desktop-warnings.log
*_build_output.txt
mcp-commands.log

# 备份文件
*.bak
*.backup
*_backup.*
*.bak.*

# IDE用户配置
*.slnLaunch.user

# 异常文件名（防止命令错误产生）
nul
*[*]*
更新时间：*
核心业务模块详细文档
**制定日期**
**版本**

# AI工具临时文件
temp_*.txt

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# XML Documentation files (generated by compiler)
src/**/*.xml
*.xml.meta

# 构建输出目录 - 安全忽略所有构建产物
BIN/**
bin/**
obj/**
logs/**
out/**
build/
packages/
artifacts/

# 确保没有发布配置文件泄露 - 删除反忽略规则
# 已删除：!BIN/LybtWebApi/Release/appsettings*.json (安全风险)
!BIN/LybtWebApi/Release/*.bat
!BIN/LybtDesktop/Release/*.config

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Test results
[Tt]est[Rr]esult*/
TestResult.xml
nunit-*.xml
*.coverage
*.coveragexml
tests/TestResults/
tests/**/*.trx
tests/**/*.coverage
tests/**/TestResults/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Database files
*.mdf
*.ldf
*.ndf

# Windows system files
Thumbs.db
Desktop.ini
nul

# Temporary files
*.tmp
*.temp
.cache/

# Claude Code 工具文件 - 保留本地但不上传
.claude/
!.claude/commands/
!.claude/core/
!.claude/modes/
.serena/
.ai/*
!.ai/rules.json
ai/
ai-starter/

# IDE和工具生成的文件 - 更新规则
.vscode/
*.code-workspace

# 项目需求文档（PRP） - 本地开发使用
PRPs/

# 备份文件和临时目录
backup_*/
shrimp-data/
*.backup

# 应用图标和资源文件（仅根目录下的临时文件）
/app.ico
# 允许 Assets 目录下的应用图标
!**/Assets/**/*.ico

# Python脚本和临时工具（非开发必需）
fix_*.py
rename_*.py
test_*.py
*_test.py
generate_*.py
check_*.py
performance_*.py
integration_*.py
analyze_*.py

# 示例和模板目录
use-cases/
examples/
templates/

# 截图和图片文件
*.png
*.jpg
*.jpeg
*.gif
*.bmp
PixPin_*.png

# 测试和覆盖率报告
coverage/
coverage-report/
TestResults/
*.trx
*.coveragexml
tests/TestResults/
tests/Coverage/

# 任务管理文件

# IDE和编辑器配置文件（已在上方定义）

# 服务器端敏感文件
.encryption-key
server.log
*.log
build_output.txt

# Python缓存文件
__pycache__/
*.pyc
*.pyo

# 配置文件中的敏感信息
appsettings.Local.json
*.secret
*.private

# 环境变量文件 - 包含敏感配置信息
.env
.env.local
.env.development
.env.staging
.env.production
*.env

# Test helper scripts (excluded from VCS)
tests/*.ps1
tests/**/*.ps1
tests/*.sh
tests/**/*.sh
tests/*.py
tests/**/*.py

# Local worktrees and publish output (do not commit)
.worktrees/
publish/**

# Process/temporary files in repo root (keep locally, exclude from VCS)
apply-summary-*.md
pass*-apply-summary*.md
error.txt
temp_auth.json
scriptshealth-check.ps1
update_client_readmes_detailed.py
 
# Ignore Adobe Illustrator files
*.ai
