# 凌隐宝堂生产环境配置 - Ansible模板
# Generated at {{ ansible_date_time.iso8601 }}

# 应用配置
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000;https://+:5001
ASPNETCORE_HTTPS_PORT=5001

# 数据库配置
ConnectionStrings__DefaultConnection=Server={{ db_host }};Database=LYBTDB;User Id={{ db_user }};Password={{ db_password }};TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;Connection Timeout=30;Max Pool Size=100;Min Pool Size=10

# Redis配置
Redis__ConnectionString={{ redis_host }}:6379,password={{ redis_password }},ssl=True,abortConnect=False,connectTimeout=5000,syncTimeout=5000,connectRetry=3
Redis__InstanceName=lybt-prod
Redis__DefaultExpiration=3600

# JWT配置
JWT__SecretKey={{ jwt_secret }}
JWT__Issuer=LYBT.WebAPI
JWT__Audience=LYBT.Client
JWT__ExpireMinutes=480
JWT__RefreshExpireMinutes=43200

# 日志配置
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__System=Warning
Serilog__WriteTo__0__Name=Console
Serilog__WriteTo__1__Name=File
Serilog__WriteTo__1__Args__path=/var/log/lybt/lybt-.log
Serilog__WriteTo__1__Args__rollingInterval=Day
Serilog__WriteTo__1__Args__retainedFileCountLimit=30
Serilog__WriteTo__2__Name=Seq
Serilog__WriteTo__2__Args__serverUrl={{ seq_url }}
Serilog__WriteTo__2__Args__apiKey={{ seq_api_key }}

# 性能配置
Performance__EnableResponseCaching=true
Performance__ResponseCacheDuration=300
Performance__EnableRequestCompression=true
Performance__EnableResponseCompression=true
Performance__MaxConcurrentRequests=1000
Performance__RequestQueueLimit=5000

# 安全配置
Security__EnableRateLimiting=true
Security__RateLimitRequests=100
Security__RateLimitWindow=60
Security__EnableCors=true
Security__AllowedOrigins={{ allowed_origins | join(',') }}
Security__RequireHttps=true
Security__EnableHSTS=true
Security__MaxAge=31536000

# 监控配置
Monitoring__EnableHealthChecks=true
Monitoring__HealthCheckInterval=30
Monitoring__EnableMetrics=true
Monitoring__MetricsEndpoint=/metrics
Monitoring__EnableTracing=true
Monitoring__TracingSampleRate=0.1
Monitoring__JaegerHost={{ jaeger_host }}
Monitoring__JaegerPort=6831

# 存储配置
Storage__Provider=Azure
Storage__ConnectionString={{ storage_connection_string }}
Storage__ContainerName=lybt-prod
Storage__MaxUploadSize=52428800
Storage__AllowedExtensions=.jpg,.jpeg,.png,.pdf,.doc,.docx

# 邮件配置
Email__SmtpHost={{ smtp_host }}
Email__SmtpPort={{ smtp_port }}
Email__SmtpUser={{ smtp_user }}
Email__SmtpPassword={{ smtp_password }}
Email__EnableSsl=true
Email__FromAddress=noreply@lybt.com
Email__FromName=凌隐宝堂中医诊所

# 缓存配置
Cache__Provider=Redis
Cache__DefaultExpiration=3600
Cache__EnableDistributed=true
Cache__EnableMemoryCache=true
Cache__MemoryCacheSize=1024

# API限流配置
RateLimit__EnableEndpointRateLimiting=true
RateLimit__StackBlockedRequests=false
RateLimit__HttpStatusCode=429
RateLimit__GeneralRules__0__Endpoint=*
RateLimit__GeneralRules__0__Period=1m
RateLimit__GeneralRules__0__Limit=60

# 特性开关
Features__EnableSwagger=false
Features__EnableHangfire=true
Features__EnableSignalR=true
Features__EnableWebSockets=true
Features__EnableBackgroundJobs=true
Features__EnableScheduledTasks=true

# 备份配置
Backup__EnableAutoBackup=true
Backup__BackupInterval=86400
Backup__BackupRetention=30
Backup__BackupPath=/backup/lybt
Backup__EncryptBackup=true

# 审计配置
Audit__EnableAuditLog=true
Audit__AuditLogPath=/var/log/lybt/audit
Audit__AuditLogRetention=365
Audit__LogSensitiveData=false

# 应用洞察配置
ApplicationInsights__InstrumentationKey={{ app_insights_key }}
ApplicationInsights__EnableAdaptiveSampling=true
ApplicationInsights__MaxTelemetryItemsPerSecond=100

# CDN配置
CDN__Enabled=true
CDN__BaseUrl={{ cdn_url }}
CDN__PurgeOnDeploy=true

# 集群配置
Cluster__NodeId={{ ansible_hostname }}
Cluster__EnableDistributedLock=true
Cluster__LockProvider=Redis
Cluster__SessionAffinity=true