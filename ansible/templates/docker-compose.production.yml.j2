version: '3.8'

services:
  # SQL Server数据库
  sqlserver:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: lybt-sqlserver
    restart: always
    environment:
      - ACCEPT_EULA=Y
      - SA_PASSWORD={{ db_sa_password }}
      - MSSQL_PID=Standard
      - MSSQL_MEMORY_LIMIT_MB=4096
      - MSSQL_AGENT_ENABLED=true
    ports:
      - "1433:1433"
    volumes:
      - sqlserver-data:/var/opt/mssql
      - {{ backup_path }}/sql:/backup
    networks:
      - lybt-network
    healthcheck:
      test: /opt/mssql-tools/bin/sqlcmd -S localhost -U SA -P '{{ db_sa_password }}' -Q 'SELECT 1'
      interval: 30s
      timeout: 10s
      retries: 5
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 4G
        reservations:
          cpus: '1'
          memory: 2G

  # Redis缓存
  redis:
    image: redis:7-alpine
    container_name: lybt-redis
    restart: always
    command: redis-server --requirepass {{ redis_password }} --maxmemory 2gb --maxmemory-policy allkeys-lru --appendonly yes
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
      - ./redis.conf:/usr/local/etc/redis/redis.conf
    networks:
      - lybt-network
    healthcheck:
      test: redis-cli -a {{ redis_password }} ping
      interval: 30s
      timeout: 10s
      retries: 5
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 512M

  # Web API服务
  webapi:
    image: lybt/webapi:{{ deploy_version }}
    container_name: lybt-webapi
    restart: always
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://+:5000;https://+:5001
      - ASPNETCORE_HTTPS_PORT=5001
      - ConnectionStrings__DefaultConnection=Server=sqlserver;Database=LYBTDB;User Id=sa;Password={{ db_sa_password }};TrustServerCertificate=True
      - Redis__ConnectionString=redis:6379,password={{ redis_password }}
    ports:
      - "5000:5000"
      - "5001:5001"
    volumes:
      - {{ deployment_path }}/uploads:/app/uploads
      - {{ log_path }}:/app/logs
      - {{ config_path }}/appsettings.Production.json:/app/appsettings.Production.json:ro
      - {{ config_path }}/ssl.pfx:/app/ssl.pfx:ro
    networks:
      - lybt-network
    depends_on:
      sqlserver:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: curl -f http://localhost:5000/health || exit 1
      interval: 30s
      timeout: 10s
      retries: 5
    deploy:
      mode: replicated
      replicas: {{ webapi_replicas | default(3) }}
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          cpus: '2'
          memory: 2G
        reservations:
          cpus: '1'
          memory: 1G

  # Nginx反向代理
  nginx:
    image: nginx:alpine
    container_name: lybt-nginx
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ config_path }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ config_path }}/ssl.crt:/etc/nginx/ssl.crt:ro
      - {{ config_path }}/ssl.key:/etc/nginx/ssl.key:ro
      - nginx-cache:/var/cache/nginx
      - {{ log_path }}/nginx:/var/log/nginx
    networks:
      - lybt-network
    depends_on:
      - webapi
    healthcheck:
      test: nginx -t && curl -f http://localhost/health || exit 1
      interval: 30s
      timeout: 10s
      retries: 5
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.5'
          memory: 256M

  # Seq日志服务
  seq:
    image: datalust/seq:latest
    container_name: lybt-seq
    restart: always
    environment:
      - ACCEPT_EULA=Y
      - SEQ_API_KEY={{ seq_api_key }}
    ports:
      - "5341:80"
      - "45341:45341"
    volumes:
      - seq-data:/data
    networks:
      - lybt-network
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M

  # Prometheus监控
  prometheus:
    image: prom/prometheus:latest
    container_name: lybt-prometheus
    restart: always
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=30d'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    networks:
      - lybt-network
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M

  # Grafana仪表板
  grafana:
    image: grafana/grafana:latest
    container_name: lybt-grafana
    restart: always
    environment:
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_password }}
      - GF_INSTALL_PLUGINS=redis-datasource,mssql-datasource
    ports:
      - "3000:3000"
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/dashboards:/etc/grafana/provisioning/dashboards
      - ./grafana/datasources:/etc/grafana/provisioning/datasources
    networks:
      - lybt-network
    depends_on:
      - prometheus
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 512M
        reservations:
          cpus: '0.5'
          memory: 256M

  # Jaeger追踪
  jaeger:
    image: jaegertracing/all-in-one:latest
    container_name: lybt-jaeger
    restart: always
    environment:
      - COLLECTOR_ZIPKIN_HOST_PORT=:9411
      - COLLECTOR_OTLP_ENABLED=true
    ports:
      - "6831:6831/udp"
      - "6832:6832/udp"
      - "5778:5778"
      - "16686:16686"
      - "14268:14268"
      - "14269:14269"
      - "14250:14250"
      - "9411:9411"
    networks:
      - lybt-network
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M

networks:
  lybt-network:
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.0.0/16

volumes:
  sqlserver-data:
    driver: local
  redis-data:
    driver: local
  seq-data:
    driver: local
  prometheus-data:
    driver: local
  grafana-data:
    driver: local
  nginx-cache:
    driver: local