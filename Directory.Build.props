<!-- Directory.Build.props - 全解决方案构建配置统一 -->
<Project>
  
  <!-- 统一输出路径配置 -->
  <PropertyGroup>
    <!-- 所有构建产物统一输出到解决方案根目录的 BIN 文件夹 -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)BIN\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)BIN\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    
    <!-- 确保输出目录存在 -->
    <CreateOutputPath>true</CreateOutputPath>
  </PropertyGroup>
  
  <!-- 统一编译配置 -->
  <PropertyGroup>
    <!-- 统一编译器设置 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors />
    
    <!-- 优化设置 -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">true</DebugSymbols>
    
    <!-- 防止 AssemblyInfo 重复生成 - 保留自动生成，清理手动文件 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 统一包引用版本管理 -->
  <PropertyGroup>
    <!-- 常用包版本集中管理 -->
    <AutoMapperVersion>13.0.1</AutoMapperVersion>
    <EntityFrameworkVersion>8.0.17</EntityFrameworkVersion>
    <SwashbuckleVersion>9.0.1</SwashbuckleVersion>
    <PrismVersion>9.0.537</PrismVersion>
    <StyleCopAnalyzersVersion>1.1.118</StyleCopAnalyzersVersion>
  </PropertyGroup>

  <!-- UltraThink全局StyleCop配置 - 相对宽松的规则 -->
  <PropertyGroup>
    <!-- C# 语言版本 -->
    <LangVersion>12.0</LangVersion>
    
    <!-- StyleCop禁用规则 - 保持代码整洁但不过度严格 -->
    <NoWarn>$(NoWarn);SA1101;SA1124;SA1633;SA1309;SA1202;SA1204;SA1128;SA1116;SA1117;SA1505;SA1508;SA1507;SA1513;SA1516;SA1518</NoWarn>
    
    <!-- 分析器设置 -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <!-- StyleCop.Analyzers包引用 - 仅在需要的项目中启用 -->
  <ItemGroup Condition="'$(EnableStyleCop)' == 'true'">
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 全局StyleCop配置文件 -->
  <ItemGroup Condition="'$(EnableStyleCop)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
  </ItemGroup>

</Project>
