<!-- Directory.Build.props - 全解决方案构建配置统一 -->
<Project>
  
  <!-- 输出路径: 使用默认的项目本地 bin 目录，避免并行构建文件锁定 -->
  
  <!-- 语言与可空性 (集中管理，各 .csproj 无需重复声明) -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 统一编译配置 -->
  <PropertyGroup>
    <!-- 统一编译器设置 -->
    <!-- CI 环境告警即错误，本地保持宽松 -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(CI)' != 'true'">false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors />

    <!-- 抑制XML文档注释警告 - Issue #789 -->
    <!-- CS1591: 缺少公共可见类型或成员的XML注释 -->
    <!-- CS1570: XML注释格式错误 -->
    <!-- CS1572: XML注释包含与实际参数不匹配的参数标记 -->
    <!-- CS1573: XML注释中的参数与实际参数不匹配 -->
    <!-- CS1587: XML注释没有放在有效语言元素上 -->
    <NoWarn>$(NoWarn);CS1591;CS1570;CS1572;CS1573;CS1587</NoWarn>

    <!-- 优化设置 -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">true</DebugSymbols>

    <!-- 防止 AssemblyInfo 重复生成 - 保留自动生成，清理手动文件 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- OpenSpec: refactor-viewmodel-composition - 源生成器支持 -->
    <!-- 允许查看CommunityToolkit.Mvvm生成的代码用于调试 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- 包版本通过 Directory.Packages.props 中央管理，这里不再定义版本变量 -->

  <!-- 产品元数据 -->
  <PropertyGroup>
    <Authors>LYBT Team</Authors>
    <Company>凌隐宝堂</Company>
    <Product>凌隐宝堂中医诊所管理系统</Product>
    <Copyright>Copyright (c) 2024-$([System.DateTime]::Now.Year) 凌隐宝堂</Copyright>
  </PropertyGroup>

  <!-- 统一版本管理 -->
  <PropertyGroup>
    <VersionPrefix>2.1.0</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
  </PropertyGroup>

</Project>
