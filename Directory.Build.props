<Project>
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
    
    <!-- 启用中央包管理 (Central Package Management) -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    
    <!-- 解决Assembly属性重复问题 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    
    <!-- 代码分析配置 - DT-007渐进式代码质量提升 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    
    <!-- 小诊所实用化配置：保留核心警告，禁用影响业务交付的格式警告 -->
    <!-- 保留重要警告：CS8618(空引用), CS8625(空赋值), CS1591(缺少XML注释) -->
    <!-- 禁用过度严格的StyleCop格式要求，专注于功能和安全性 -->
    <NoWarn>$(NoWarn);SA1633;SA1200;SA1101;SA1309;SA1516;SA1602;SA1649;SA1500;SA1202;SA1629;SA1413;SA1611;SA1402;SA1615;SA1124;SA1505;SA1204;SA1401;SA1201;SA1210;SA1208;SA1503;SA1623;SA1003;SA1203;SA1127;SA1134;SA1128;SA1214;SA1618;SA1012;SA1117;SA1108;SA1512;CS1570;CS1587;NU1903;CS0162;CS0414;CS0168;CS0219;CS0169;CS1591;IDE0005;IDE0051;IDE0052;IDE0058;IDE0059;IDE1006;MSB3061</NoWarn>
    
    <!-- 启用关键安全和质量警告 - 针对小诊所业务需求 -->
    <!-- CS8618: 启用空引用检查，确保数据安全 -->
    <!-- CS8625: 启用空值赋值检查，防止运行时错误 --> 
    <!-- CS1998: 启用异步方法检查，提升性能 -->
    
    <!-- 使用默认输出路径 -->
    <!-- 每个项目将输出到自己的 bin\$(Configuration)\$(TargetFramework) 目录 -->
  </PropertyGroup>

  <!-- 对所有 C# 项目自动引用 StyleCop.Analyzers -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>