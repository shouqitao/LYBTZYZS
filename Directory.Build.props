<!-- Directory.Build.props - 全解决方案构建配置统一 -->
<Project>
  
  <!-- 统一输出路径配置 -->
  <PropertyGroup>
    <!-- Issue #839: 分离 Server 和 Desktop 输出目录，避免文件锁定冲突 -->
    <!-- 根据项目路径判断是 Server 还是 Desktop 项目 -->
    <IsServerProject Condition="$(MSBuildProjectDirectory.Contains('src\Server')) OR $(MSBuildProjectDirectory.Contains('src/Server'))">true</IsServerProject>
    <IsDesktopProject Condition="$(MSBuildProjectDirectory.Contains('src\Client\Desktop')) OR $(MSBuildProjectDirectory.Contains('src/Client/Desktop'))">true</IsDesktopProject>
    
    <!-- Server 项目输出到 BIN\Server\ -->
    <BaseOutputPath Condition="'$(IsServerProject)' == 'true'">$(MSBuildThisFileDirectory)BIN\Server\</BaseOutputPath>

    <!-- Desktop 项目输出到 BIN\Desktop\ -->
    <BaseOutputPath Condition="'$(IsDesktopProject)' == 'true'">$(MSBuildThisFileDirectory)BIN\Desktop\</BaseOutputPath>

    <!-- Tests 项目输出到 BIN\Tests\ -->
    <BaseOutputPath Condition="$(MSBuildProjectDirectory.Contains('tests\')) OR $(MSBuildProjectDirectory.Contains('tests/'))">$(MSBuildThisFileDirectory)BIN\Tests\</BaseOutputPath>

    <!-- Shared 项目不设置独立输出路径,跟随引用方输出 -->

    <!-- 确保输出目录存在 -->
    <CreateOutputPath>true</CreateOutputPath>
  </PropertyGroup>
  
  <!-- 统一编译配置 -->
  <PropertyGroup>
    <!-- 统一编译器设置 -->
    <!-- CI 环境告警即错误，本地保持宽松 -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(CI)' != 'true'">false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors />

    <!-- 抑制XML文档注释警告 - Issue #789 -->
    <!-- CS1591: 缺少公共可见类型或成员的XML注释 -->
    <!-- CS1570: XML注释格式错误 -->
    <!-- CS1572: XML注释包含与实际参数不匹配的参数标记 -->
    <!-- CS1573: XML注释中的参数与实际参数不匹配 -->
    <!-- CS1587: XML注释没有放在有效语言元素上 -->
    <NoWarn>$(NoWarn);CS1591;CS1570;CS1572;CS1573;CS1587</NoWarn>

    <!-- 优化设置 -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">true</DebugSymbols>

    <!-- 防止 AssemblyInfo 重复生成 - 保留自动生成，清理手动文件 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 统一包引用版本管理 -->
  <PropertyGroup>
    <!-- 常用包版本集中管理 -->
    <AutoMapperVersion>13.0.1</AutoMapperVersion>
    <EntityFrameworkVersion>8.0.17</EntityFrameworkVersion>
    <SwashbuckleVersion>9.0.1</SwashbuckleVersion>
    <PrismVersion>8.1.97</PrismVersion>
  </PropertyGroup>


</Project>
