<Project>
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
    <DocumentationOutputPath>$(SolutionDir)Documentation</DocumentationOutputPath>
    
    <!-- 解决Assembly属性重复问题 -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    
    <!-- 统一输出路径配置 -->
    <!-- WebAPI项目直接输出到 BIN/LYBT.WebAPI，不含TargetFramework子目录 -->
    <OutputPath Condition="'$(MSBuildProjectName)' == 'LYBT.WebAPI'">$(SolutionDir)BIN\LYBT.WebAPI\</OutputPath>
    <AppendTargetFrameworkToOutputPath Condition="'$(MSBuildProjectName)' == 'LYBT.WebAPI'">false</AppendTargetFrameworkToOutputPath>
    <!-- WPF Shell项目直接输出到 BIN/LYBT.Desktop，不含TargetFramework子目录 -->
    <OutputPath Condition="'$(MSBuildProjectName)' == 'LYBT.WPF.Client.Shell'">$(SolutionDir)BIN\LYBT.Desktop\</OutputPath>
    <AppendTargetFrameworkToOutputPath Condition="'$(MSBuildProjectName)' == 'LYBT.WPF.Client.Shell'">false</AppendTargetFrameworkToOutputPath>
    <!-- 其他项目输出到临时目录，避免污染主目录 -->
    <OutputPath Condition="'$(OutputPath)' == ''">$(SolutionDir)BIN\temp\$(MSBuildProjectName)\$(Configuration)\$(TargetFramework)\</OutputPath>
    
    <!-- 统一中间输出路径，避免在项目目录生成obj -->
    <BaseIntermediateOutputPath>$(SolutionDir)BIN\temp\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- 构建时复制文档文件到解决方案文件夹 -->
  <Target Name="CopyDocumentationFiles" AfterTargets="Build">
    <ItemGroup>
      <!-- 查找所有模块的FUNCTIONALITY.md文件 -->
      <FunctionalityDocs Include="$(MSBuildProjectDirectory)\FUNCTIONALITY.md" Condition="Exists('$(MSBuildProjectDirectory)\FUNCTIONALITY.md')" />
      <!-- 查找所有模块的README.md文件 -->
      <ReadmeDocs Include="$(MSBuildProjectDirectory)\README.md" Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />
    </ItemGroup>
    
    <!-- 创建文档输出目录 -->
    <MakeDir Directories="$(DocumentationOutputPath)" Condition="!Exists('$(DocumentationOutputPath)')" />
    
    <!-- 复制FUNCTIONALITY.md文件，使用项目名称作为前缀 -->
    <Copy 
      SourceFiles="@(FunctionalityDocs)" 
      DestinationFiles="$(DocumentationOutputPath)\$(MSBuildProjectName)_FUNCTIONALITY.md"
      Condition="@(FunctionalityDocs) != ''"
      SkipUnchangedFiles="true" />
    
    <!-- 复制README.md文件，使用项目名称作为前缀 -->
    <Copy 
      SourceFiles="@(ReadmeDocs)" 
      DestinationFiles="$(DocumentationOutputPath)\$(MSBuildProjectName)_README.md"
      Condition="@(ReadmeDocs) != ''"
      SkipUnchangedFiles="true" />
      
    <!-- 输出构建信息 -->
    <Message Text="文档文件已复制到: $(DocumentationOutputPath)" Importance="high" Condition="@(FunctionalityDocs) != '' OR @(ReadmeDocs) != ''" />
  </Target>

  <!-- 清理时删除文档文件 -->
  <Target Name="CleanDocumentationFiles" AfterTargets="Clean">
    <ItemGroup>
      <DocumentationFiles Include="$(DocumentationOutputPath)\$(MSBuildProjectName)_*.md" />
    </ItemGroup>
    
    <Delete Files="@(DocumentationFiles)" />
    <Message Text="已清理文档文件: @(DocumentationFiles)" Importance="high" Condition="@(DocumentationFiles) != ''" />
  </Target>
</Project>
