+++ src/Server/Modules/LYBT.Module.Prescriptions/Controllers/CompatibilityNotesController.cs
@@ -0,0 +1,75 @@
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Caching.Memory;
+using LYBT.Infrastructure.Controllers;
+using LYBT.Module.Prescriptions.Services;
+using LYBT.Shared.Models.Contracts.Compatibility;
+using LYBT.Shared.Models.Common;
+
+namespace LYBT.Module.Prescriptions.Controllers
+{
+    /// <summary>
+    /// 配伍记录管理控制器
+    /// </summary>
+    [ApiController]
+    [ApiVersion("1")]
+    [Route("api/v{version:apiVersion}/prescriptions/{prescriptionId:guid}/compat-notes")]
+    [Authorize]
+    public class CompatibilityNotesController : BaseApiController
+    {
+        private readonly CompatibilityNoteService _service;
+
+        public CompatibilityNotesController(
+            CompatibilityNoteService service,
+            ILogger<CompatibilityNotesController> logger,
+            IMemoryCache cache) : base(logger, cache)
+        {
+            _service = service;
+        }
+
+        /// <summary>
+        /// 创建配伍记录
+        /// </summary>
+        [HttpPost]
+        public async Task<ActionResult<ApiResponse<CompatibilityNoteDto>>> Create(
+            [FromRoute] Guid prescriptionId,
+            [FromBody] CompatibilityNoteCreateDto createDto)
+        {
+            try
+            {
+                var validation = ValidateGuid<CompatibilityNoteDto>(prescriptionId, "处方ID");
+                if (validation != null) return validation;
+
+                var currentUserId = GetCurrentUserId();
+                var result = await _service.CreateAsync(prescriptionId, createDto, currentUserId);
+                
+                return HandleServiceResult(result, "配伍记录创建成功");
+            }
+            catch (Exception ex)
+            {
+                return HandleException<CompatibilityNoteDto>(ex, "创建配伍记录", prescriptionId);
+            }
+        }
+
+        /// <summary>
+        /// 获取处方的配伍记录列表
+        /// </summary>
+        [HttpGet]
+        public async Task<ActionResult<ApiResponse<List<CompatibilityNoteDto>>>> GetByPrescription(
+            [FromRoute] Guid prescriptionId)
+        {
+            try
+            {
+                var validation = ValidateGuid<List<CompatibilityNoteDto>>(prescriptionId, "处方ID");
+                if (validation != null) return validation;
+
+                var result = await _service.GetByPrescriptionIdAsync(prescriptionId);
+                return HandleServiceResult(result, "查询配伍记录成功");
+            }
+            catch (Exception ex)
+            {
+                return HandleException<List<CompatibilityNoteDto>>(ex, "查询配伍记录", prescriptionId);
+            }
+        }
+    }
+}
