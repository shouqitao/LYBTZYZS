-namespace LYBT.Infrastructure.Transactions
-{
-    /// <summary>
-    /// 分布式事务协调器 - 企业级事务管理
-    /// 注意：对于小型诊所应用过于复杂，EF Core内置事务已足够
-    /// 此实现展示了复杂事务协调的各种企业级特性
-    /// </summary>
-    public class TransactionCoordinator<TRequest> : ITransactionCoordinator<TRequest>
-        where TRequest : class
-    {
-        private readonly IServiceProvider _serviceProvider;
-        private readonly ITransactionStateManager _stateManager;
-        private readonly ICompensationManager _compensationManager;
-        private readonly ILogger<TransactionCoordinator<TRequest>> _logger;
-        
-        private readonly List<ITransactionStep<TRequest>> _steps;
-        private readonly Dictionary<string, object> _transactionMetrics;
-        
-        public TransactionCoordinator(
-            IServiceProvider serviceProvider,
-            ITransactionStateManager stateManager,
-            ICompensationManager compensationManager,
-            ILogger<TransactionCoordinator<TRequest>> logger)
-        {
-            _serviceProvider = serviceProvider ?? throw new ArgumentNullException(nameof(serviceProvider));
-            _stateManager = stateManager ?? throw new ArgumentNullException(nameof(stateManager));
-            _compensationManager = compensationManager ?? throw new ArgumentNullException(nameof(compensationManager));
-            _logger = logger ?? throw new ArgumentNullException(nameof(logger));
-            
-            _steps = new List<ITransactionStep<TRequest>>();
-            _transactionMetrics = new Dictionary<string, object>();
-        }
-        
-        public async Task<TransactionResult<TRequest>> ExecuteAsync(
-            TRequest request, 
-            CancellationToken cancellationToken = default)
-        {
-            var transactionId = Guid.NewGuid();
-            var context = new TransactionContext<TRequest>(transactionId, request);
-            
-            _logger.LogInformation("开始执行事务 {TransactionId}", transactionId);
-            
-            try
-            {
-                // 预检查所有步骤
-                await ValidateStepsAsync(context, cancellationToken);
-                
-                // 按顺序执行步骤
-                foreach (var step in _steps.OrderBy(s => s.Order))
-                {
-                    await ExecuteStepWithRetryAsync(step, context, cancellationToken);
-                }
-                
-                // 提交事务
-                await CommitTransactionAsync(context, cancellationToken);
-                
-                _logger.LogInformation("事务 {TransactionId} 执行成功", transactionId);
-                return TransactionResult<TRequest>.Success(request);
-            }
-            catch (Exception ex)
-            {
-                _logger.LogError(ex, "事务 {TransactionId} 执行失败，开始补偿", transactionId);
-                
-                // 执行补偿操作
-                await CompensateAsync(context, cancellationToken);
-                
-                return TransactionResult<TRequest>.Failed($"事务执行失败: {ex.Message}");
-            }
-            finally
-            {
-                // 清理资源和记录指标
-                await CleanupAsync(context);
-                RecordTransactionMetrics(context);
-            }
-        }
-        
-        private async Task ExecuteStepWithRetryAsync(
-            ITransactionStep<TRequest> step, 
-            TransactionContext<TRequest> context,
-            CancellationToken cancellationToken)
-        {
-            const int maxRetries = 3;
-            var retryCount = 0;
-            
-            while (retryCount < maxRetries)
-            {
-                try
-                {
-                    if (!await step.CanExecuteAsync(context.Request, cancellationToken))
-                    {
-                        _logger.LogWarning("步骤 {StepName} 不满足执行条件，跳过", step.GetType().Name);
-                        return;
-                    }
-                    
-                    var result = await step.ExecuteAsync(context.Request, cancellationToken);
-                    context.AddExecutedStep(step, result);
-                    
-                    if (!result.IsSuccess)
-                    {
-                        throw new TransactionStepException(
-                            $"步骤 {step.GetType().Name} 执行失败: {result.ErrorMessage}");
-                    }
-                    
-                    _logger.LogDebug("步骤 {StepName} 执行成功", step.GetType().Name);
