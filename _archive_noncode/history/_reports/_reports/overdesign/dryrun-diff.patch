-                    
-                    _logger.LogWarning(ex, "步骤 {StepName} 执行失败，{Delay}秒后重试 ({RetryCount}/{MaxRetries})", 
-                        step.GetType().Name, delay.TotalSeconds, retryCount, maxRetries);
-                    
-                    await Task.Delay(delay, cancellationToken);
-                }
-            }
-            
-            throw new TransactionStepException(
-                $"步骤 {step.GetType().Name} 在{maxRetries}次重试后仍然失败");
-        }
