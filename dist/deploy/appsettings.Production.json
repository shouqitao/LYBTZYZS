{
  "_comment": "生产环境配置 - 仅包含与 appsettings.json 不同的覆盖项",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LYBTDB;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=30;Max Pool Size=50;Min Pool Size=5;Pooling=true;Encrypt=false;Application Name=LYBT.WebAPI"
  },

  "Jwt": {
    "SecretKey": "${JWT_SECRET}",
    "AccessTokenExpirationMinutes": 30
  },

  "DefaultPasswords": {
    "SysAdminPassword": "${SYSADMIN_PASSWORD}",
    "NewUserPassword": "${NEWUSER_PASSWORD}"
  },

  "Database": {
    "EnsureCreatedInDevelopment": false,
    "ConnectionPool": {
      "MinConnections": 10
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lybt-web-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionStringName": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "SystemLogs",
            "schemaName": "dbo",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 50,
            "period": "00:00:05"
          },
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "LYBT.WebAPI",
      "Environment": "Production"
    }
  },

  "Cors": {
    "AllowedOrigins": ["http://192.168.190.6", "https://192.168.190.6"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Request-Id", "X-Correlation-Id"],
    "AllowCredentials": true,
    "MaxAge": 86400
  },

  "DesktopUpdate": {
    "Enabled": true,
    "ReleasesPath": "C:\\Services\\LYBT-releases",
    "MaxRetentionCount": 5,
    "DownloadBaseUrl": "/releases",
    "CheckEndpoint": "/api/version",
    "_comment": "Desktop 自动升级：ReleasesPath 与 WebAPI 部署目录独立，避免 publish 清空"
  },

  "SystemAdmin": {
    "AllowAutoCreateInProduction": false,
    "InitialSetupToken": "${LYBT_INITIAL_SETUP_TOKEN}"
  }
}
