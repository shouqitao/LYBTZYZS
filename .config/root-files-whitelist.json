{
  "description": "根目录文件白名单配置 - 仅这些文件/模式被允许存在于项目根目录",
  "version": "1.0.3",
  "last_updated": "2025-10-28",

  "allowed_files": [
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "version.txt",
    "shrimp-rules.md",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".runsettings",
    ".env.example",
    "global.json",
    "nuget.config",
    "Directory.Build.props",
    "Directory.Packages.props"
  ],
  
  "allowed_patterns": [
    "*.sln"
  ],
  
  "allowed_dirs": [
    "src",
    "tests",
    "docs",
    "docs-archive",
    "scripts",
    ".github",
    ".claude",
    ".config",
    ".githooks",
    ".git",
    ".vs",
    ".ai",
    ".serena",
    "BIN",
    ".spec-workflow",
    "openspec"
  ],
  
  "blocked_patterns": [
    "/*.json",
    "/*.txt",
    "/*.png",
    "/*.jpg",
    "/*.jpeg",
    "/*.gif",
    "/*.bmp",
    "/*.backup",
    "/*.bak",
    "/*.md.backup",
    "/*.slnLaunch.user",
    "/nul",
    "/制定*",
    "/版本*",
    "/问题*.md",
    "/临时*.md"
  ],
  
  "notes": [
    "此配置用于pre-commit hook和CI检查",
    "修改此文件后需更新.githooks/pre-commit脚本",
    "allowed_files: 精确文件名匹配",
    "allowed_patterns: 支持通配符（如*.sln）",
    "allowed_dirs: 允许的目录（包括隐藏目录）",
    "blocked_patterns: 明确禁止的模式（优先级高于允许规则）",
    "shrimp-rules.md: shrimp-task-manager MCP工具的必需配置文件"
  ]
}
