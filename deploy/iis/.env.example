# LYBTZYZS IIS 部署脚本环境变量模板
# 由 deploy.ps1 写入机器级环境变量，通过 appsettings.Override.json 的 ${VAR} 替换注入
# 仅包含部署必需的密钥，完整运行时配置见: src/Server/Services/LYBT.WebAPI/.env.example

JWT_SECRET=replace-with-32-plus-char-random-secret
SYSADMIN_PASSWORD=replace-with-strong-password
NEWUSER_PASSWORD=replace-with-strong-password

# 可选：覆盖 ASP.NET Core 环境
ASPNETCORE_ENVIRONMENT=Production
