{
  "Repository Interface": {
    "prefix": "repo-interface",
    "description": "创建 Repository 接口",
    "body": [
      "using LYBT.Shared.Dtos.${1:Entity};",
      "",
      "namespace LYBT.Desktop.${2:ModuleName}.Interfaces;",
      "",
      "/// <summary>",
      "/// ${3:实体}数据访问接口",
      "/// </summary>",
      "public interface I${1:Entity}Repository",
      "{",
      "    /// <summary>",
      "    /// 获取所有${3:实体}",
      "    /// </summary>",
      "    Task<List<${1:Entity}Dto>> GetAllAsync();",
      "",
      "    /// <summary>",
      "    /// 根据ID获取${3:实体}",
      "    /// </summary>",
      "    Task<${1:Entity}Dto?> GetByIdAsync(int id);",
      "",
      "    /// <summary>",
      "    /// 添加${3:实体}",
      "    /// </summary>",
      "    Task<${1:Entity}Dto> AddAsync(Create${1:Entity}Dto dto);",
      "",
      "    /// <summary>",
      "    /// 更新${3:实体}",
      "    /// </summary>",
      "    Task UpdateAsync(int id, Update${1:Entity}Dto dto);",
      "",
      "    /// <summary>",
      "    /// 删除${3:实体}",
      "    /// </summary>",
      "    Task DeleteAsync(int id);",
      "    $0",
      "}"
    ]
  },
  "Repository Implementation": {
    "prefix": "repo-impl",
    "description": "创建 Repository 实现类",
    "body": [
      "using LYBT.Desktop.${1:ModuleName}.Interfaces;",
      "using LYBT.Shared.ApiInterfaces;",
      "using LYBT.Shared.Dtos.${2:Entity};",
      "using Microsoft.Extensions.Logging;",
      "",
      "namespace LYBT.Desktop.${1:ModuleName}.Repositories;",
      "",
      "/// <summary>",
      "/// ${3:实体}数据访问实现",
      "/// </summary>",
      "public class ${2:Entity}Repository : I${2:Entity}Repository",
      "{",
      "    private readonly I${2:Entity}Api _api;",
      "    private readonly ILogger<${2:Entity}Repository> _logger;",
      "",
      "    public ${2:Entity}Repository(",
      "        I${2:Entity}Api api,",
      "        ILogger<${2:Entity}Repository> logger)",
      "    {",
      "        _api = api;",
      "        _logger = logger;",
      "    }",
      "",
      "    public async Task<List<${2:Entity}Dto>> GetAllAsync()",
      "    {",
      "        try",
      "        {",
      "            _logger.LogInformation(\"正在获取所有${3:实体}...\");",
      "            return await _api.GetAll${2:Entity}sAsync();",
      "        }",
      "        catch (Exception ex)",
      "        {",
      "            _logger.LogError(ex, \"获取所有${3:实体}失败\");",
      "            throw; // 异常向上抛出，由 ViewModel 处理",
      "        }",
      "    }",
      "",
      "    public async Task<${2:Entity}Dto?> GetByIdAsync(int id)",
      "    {",
      "        try",
      "        {",
      "            _logger.LogInformation(\"正在获取${3:实体} {Id}...\", id);",
      "            return await _api.Get${2:Entity}ByIdAsync(id);",
      "        }",
      "        catch (Exception ex)",
      "        {",
      "            _logger.LogError(ex, \"获取${3:实体} {Id} 失败\", id);",
      "            throw;",
      "        }",
      "    }",
      "",
      "    public async Task<${2:Entity}Dto> AddAsync(Create${2:Entity}Dto dto)",
      "    {",
      "        try",
      "        {",
      "            _logger.LogInformation(\"正在添加${3:实体}...\");",
      "            return await _api.Create${2:Entity}Async(dto);",
      "        }",
      "        catch (Exception ex)",
      "        {",
      "            _logger.LogError(ex, \"添加${3:实体}失败\");",
      "            throw;",
      "        }",
      "    }",
      "",
      "    public async Task UpdateAsync(int id, Update${2:Entity}Dto dto)",
      "    {",
      "        try",
      "        {",
      "            _logger.LogInformation(\"正在更新${3:实体} {Id}...\", id);",
      "            await _api.Update${2:Entity}Async(id, dto);",
      "        }",
      "        catch (Exception ex)",
      "        {",
      "            _logger.LogError(ex, \"更新${3:实体} {Id} 失败\", id);",
      "            throw;",
      "        }",
      "    }",
      "",
      "    public async Task DeleteAsync(int id)",
      "    {",
      "        try",
      "        {",
      "            _logger.LogInformation(\"正在删除${3:实体} {Id}...\", id);",
      "            await _api.Delete${2:Entity}Async(id);",
      "        }",
      "        catch (Exception ex)",
      "        {",
      "            _logger.LogError(ex, \"删除${3:实体} {Id} 失败\", id);",
      "            throw;",
      "        }",
      "    }",
      "    $0",
      "}"
    ]
  },
