{
  "Prism Module Class": {
    "prefix": "prism-module",
    "description": "创建 Prism 模块类（包含 RegisterTypes 方法）",
    "body": [
      "using Prism.Ioc;",
      "using Prism.Modularity;",
      "",
      "namespace LYBT.Desktop.${1:ModuleName};",
      "",
      "/// <summary>",
      "/// ${1:ModuleName} 模块",
      "/// </summary>",
      "[Module(ModuleName = nameof(${1:ModuleName}Module))]",
      "${2:// [ModuleDependency(\"DependencyModule\")]}",
      "public class ${1:ModuleName}Module : IModule",
      "{",
      "    public void OnInitialized(IContainerProvider containerProvider)",
      "    {",
      "        // 模块初始化",
      "    }",
      "",
      "    public void RegisterTypes(IContainerRegistry containerRegistry)",
      "    {",
      "        // ADR-002 架构标准：",
      "        // - Infrastructure Service (Foundation/Infrastructure) 由 Shell 统一注册",
      "        // - Repository (数据访问层) 由各业务模块自行注册",
      "        containerRegistry.RegisterSingleton<I${3:Entity}Repository, ${3:Entity}Repository>();",
      "",
      "        // 注册 ViewModel",
      "        containerRegistry.Register<${3:Entity}ManagementViewModel>();",
      "",
      "        // 注册视图用于导航",
      "        containerRegistry.RegisterForNavigation<Views.${3:Entity}ManagementView>();",
      "",
      "        // 注册对话框（可选）",
      "        // containerRegistry.RegisterDialog<Views.${3:Entity}EditorDialog, ViewModels.${3:Entity}EditorDialogViewModel>();",
      "    }",
      "}"
    ]
  },
  "Prism Module RegisterTypes": {
    "prefix": "prism-register",
    "description": "Prism 模块 RegisterTypes 方法模板",
    "body": [
      "public void RegisterTypes(IContainerRegistry containerRegistry)",
      "{",
      "    // ADR-002 架构标准：",
      "    // - Infrastructure Service (Foundation/Infrastructure) 由 Shell 统一注册",
      "    // - Repository (数据访问层) 由各业务模块自行注册",
      "    containerRegistry.RegisterSingleton<I${1:Entity}Repository, ${1:Entity}Repository>();",
      "",
      "    // 注册 ViewModel",
      "    containerRegistry.Register<${1:Entity}ManagementViewModel>();",
      "    containerRegistry.Register<${1:Entity}DetailViewModel>();",
      "",
      "    // 注册视图用于导航",
      "    containerRegistry.RegisterForNavigation<Views.${1:Entity}ManagementView>();",
      "    containerRegistry.RegisterForNavigation<Views.${1:Entity}DetailView>();",
      "    $0",
      "}"
    ]
  },
  "Repository Singleton Registration": {
    "prefix": "register-repository",
    "description": "注册 Repository 为单例",
    "body": [
      "// Repository (数据访问层) 由各业务模块自行注册",
      "containerRegistry.RegisterSingleton<I${1:Entity}Repository, ${1:Entity}Repository>();$0"
    ]
  },
  "ViewModel Registration": {
    "prefix": "register-viewmodel",
    "description": "注册 ViewModel（瞬时）",
    "body": [
      "// 注册 ViewModel",
      "containerRegistry.Register<${1:Entity}${2:Management}ViewModel>();$0"
    ]
  },
  "View Navigation Registration": {
    "prefix": "register-navigation",
    "description": "注册视图用于导航",
    "body": [
      "// 注册视图用于导航",
      "containerRegistry.RegisterForNavigation<Views.${1:Entity}${2:Management}View>();$0"
    ]
  },
  "Dialog Registration": {
    "prefix": "register-dialog",
    "description": "注册对话框（View + ViewModel）",
    "body": [
      "// 注册对话框",
      "containerRegistry.RegisterDialog<Views.${1:Entity}${2:Editor}Dialog, ViewModels.${1:Entity}${2:Editor}DialogViewModel>();$0"
    ]
  }
}
