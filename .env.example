# =================================================================
# 凌隐宝堂中医诊所管理系统 - 生产环境配置模板
# =================================================================
# 警告：此文件仅作为配置示例，切勿在其中存储真实密钥！
# 请复制为 .env 文件并填写实际配置值
# =================================================================

# ==================== 数据库配置 ====================
# SQL Server连接字符串（生产环境）
DATABASE_CONNECTION_STRING="Server=your-server;Database=LYBTDB;User Id=your-user;Password=your-password;TrustServerCertificate=true;MultipleActiveResultSets=true;"

# ==================== JWT安全配置 ====================
# JWT密钥（至少32字符，建议使用Base64编码的随机密钥）
# 生成命令：powershell -Command "[Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])"
JWT_SECRET="YOUR_STRONG_JWT_SECRET_KEY_HERE_AT_LEAST_32_CHARACTERS_LONG"

# JWT发行者和受众
JWT_ISSUER="LYBT.WebAPI"
JWT_AUDIENCE="LYBT.Client"

# JWT过期时间配置（分钟）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 系统管理员配置 ====================
# 系统管理员默认密码（首次部署使用，需立即更改）
ADMIN_DEFAULT_PASSWORD="YourSecureAdminPassword2025!"

# 新用户默认密码（需符合密码策略）
USER_DEFAULT_PASSWORD="YourSecureUserPassword2025!"

# ==================== 加密配置 ====================
# 数据加密密钥（用于敏感数据加密）
ENCRYPTION_KEY="YOUR_ENCRYPTION_KEY_HERE"

# ==================== 应用程序设置 ====================
# 环境标识
ASPNETCORE_ENVIRONMENT="Production"

# 应用程序URL
APPLICATION_URL="https://your-domain.com"

# CORS允许的源
ALLOWED_ORIGINS="https://your-frontend.com"

# ==================== 日志配置 ====================
# 日志级别（Information, Warning, Error, Critical）
LOG_LEVEL="Information"

# 日志保留天数
LOG_RETENTION_DAYS=30

# ==================== 邮件服务配置（可选） ====================
# SMTP服务器配置
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@domain.com"
SMTP_PASSWORD="your-email-password"
SMTP_FROM_EMAIL="noreply@your-domain.com"
SMTP_FROM_NAME="凌隐宝堂系统"

# ==================== Redis缓存配置（可选） ====================
# Redis连接字符串
REDIS_CONNECTION_STRING="localhost:6379,password=your-redis-password"

# ==================== 安全配置 ====================
# 启用HTTPS重定向
ENABLE_HTTPS_REDIRECT=true

# 启用HSTS
ENABLE_HSTS=true

# 账户锁定设置
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ==================== 性能配置 ====================
# 数据库连接池设置
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=2

# 请求超时设置（秒）
REQUEST_TIMEOUT_SECONDS=30

# ==================== 备份配置 ====================
# 备份路径
BACKUP_PATH="/var/backups/lybt"

# 自动备份间隔（小时）
AUTO_BACKUP_INTERVAL_HOURS=24

# =================================================================
# 部署说明：
# 1. 复制此文件为 .env
# 2. 填写所有必需的配置值
# 3. 确保 .env 文件权限设置为 600（仅所有者可读写）
# 4. 将 .env 文件添加到 .gitignore（永远不要提交到版本控制）
# 5. 定期轮换密钥和密码
#
# 安全建议：
# - 使用强密码生成器创建所有密钥
# - 考虑使用密钥管理服务（如 Azure Key Vault）
# - 定期审计和更新配置
# - 监控异常登录尝试
# - 实施密钥轮换策略
# =================================================================