&lt;UserControl x:Class="LYBT.UI.PrismWpf.Views.UserManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MaterialDesignPaper}"&gt;

    &lt;Grid Margin="16"&gt;
        &lt;Grid.RowDefinitions&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
            &lt;RowDefinition Height="*"/&gt;
            &lt;RowDefinition Height="Auto"/&gt;
        &lt;/Grid.RowDefinitions&gt;

        &lt;!-- 页面标题 --&gt;
        &lt;StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16"&gt;
            &lt;materialDesign:PackIcon Kind="AccountGroup" 
                                   Width="32" Height="32" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/&gt;
            &lt;TextBlock Text="用户管理" 
                      FontSize="24" FontWeight="Bold"
                      VerticalAlignment="Center" 
                      Margin="12,0,0,0"/&gt;
        &lt;/StackPanel&gt;

        &lt;!-- 搜索和操作栏 --&gt;
        &lt;materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16"&gt;
            &lt;Grid&gt;
                &lt;Grid.ColumnDefinitions&gt;
                    &lt;ColumnDefinition Width="*"/&gt;
                    &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;/Grid.ColumnDefinitions&gt;

                &lt;!-- 搜索框 --&gt;
                &lt;TextBox Grid.Column="0"
                        materialDesign:HintAssist.Hint="搜索用户名或姓名"
                        materialDesign:HintAssist.IsFloating="True"
                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"&gt;
                    &lt;TextBox.InputBindings&gt;
                        &lt;KeyBinding Key="Enter" Command="{Binding SearchCommand}"/&gt;
                    &lt;/TextBox.InputBindings&gt;
                &lt;/TextBox&gt;

                &lt;!-- 搜索按钮 --&gt;
                &lt;Button Grid.Column="1"
                       Content="搜索"
                       Command="{Binding SearchCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Margin="0,0,8,0"&gt;
                    &lt;Button.Content&gt;
                        &lt;StackPanel Orientation="Horizontal"&gt;
                            &lt;materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"/&gt;
                            &lt;TextBlock Text="搜索" Margin="4,0,0,0"/&gt;
                        &lt;/StackPanel&gt;
                    &lt;/Button.Content&gt;
                &lt;/Button&gt;

                &lt;!-- 新增用户按钮 --&gt;
                &lt;Button Grid.Column="2"
                       Content="新增用户"
                       Command="{Binding CreateUserCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"&gt;
                    &lt;Button.Content&gt;
                        &lt;StackPanel Orientation="Horizontal"&gt;
                            &lt;materialDesign:PackIcon Kind="AccountPlus" Width="16" Height="16"/&gt;
                            &lt;TextBlock Text="新增用户" Margin="4,0,0,0"/&gt;
                        &lt;/StackPanel&gt;
                    &lt;/Button.Content&gt;
                &lt;/Button&gt;
            &lt;/Grid&gt;
        &lt;/materialDesign:Card&gt;

        &lt;!-- 用户列表 --&gt;
        &lt;materialDesign:Card Grid.Row="2"&gt;
            &lt;DataGrid ItemsSource="{Binding Users}"
                     SelectedItem="{Binding SelectedUser}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     HeadersVisibility="All"
                     GridLinesVisibility="Horizontal"
                     Style="{StaticResource MaterialDesignDataGrid}"
                     ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                     CellStyle="{StaticResource MaterialDesignDataGridCell}"&gt;
                
                &lt;DataGrid.Columns&gt;
                    &lt;!-- 用户名 --&gt;
                    &lt;DataGridTextColumn Header="用户名" 
                                      Binding="{Binding UserName}" 
                                      Width="120"
                                      IsReadOnly="True"/&gt;
                    
                    &lt;!-- 真实姓名 --&gt;
                    &lt;DataGridTextColumn Header="真实姓名" 
                                      Binding="{Binding RealName}" 
                                      Width="120"
                                      IsReadOnly="True"/&gt;
                    
                    &lt;!-- 拼音码 --&gt;
                    &lt;DataGridTextColumn Header="拼音码" 
                                      Binding="{Binding PinyinCode}" 
                                      Width="100"
                                      IsReadOnly="True"/&gt;
                    
                    &lt;!-- 角色 --&gt;
                    &lt;DataGridTextColumn Header="角色" 
                                      Binding="{Binding RoleDisplay}" 
                                      Width="100"
                                      IsReadOnly="True"/&gt;
                    
                    &lt;!-- 状态 --&gt;
                    &lt;DataGridTemplateColumn Header="状态" Width="80"&gt;
                        &lt;DataGridTemplateColumn.CellTemplate&gt;
                            &lt;DataTemplate&gt;
                                &lt;materialDesign:Chip Content="{Binding StatusDisplay}"
                                                   IsEnabled="False"&gt;
                                    &lt;materialDesign:Chip.Style&gt;
                                        &lt;Style TargetType="materialDesign:Chip" BasedOn="{StaticResource {x:Type materialDesign:Chip}}"&gt;
                                            &lt;Style.Triggers&gt;
                                                &lt;DataTrigger Binding="{Binding IsActive}" Value="True"&gt;
                                                    &lt;Setter Property="Background" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/&gt;
                                                    &lt;Setter Property="Foreground" Value="White"/&gt;
                                                &lt;/DataTrigger&gt;
                                                &lt;DataTrigger Binding="{Binding IsActive}" Value="False"&gt;
                                                    &lt;Setter Property="Background" Value="{DynamicResource MaterialDesignBodyLight}"/&gt;
                                                    &lt;Setter Property="Foreground" Value="White"/&gt;
                                                &lt;/DataTrigger&gt;
                                            &lt;/Style.Triggers&gt;
                                        &lt;/Style&gt;
                                    &lt;/materialDesign:Chip.Style&gt;
                                &lt;/materialDesign:Chip&gt;
                            &lt;/DataTemplate&gt;
                        &lt;/DataGridTemplateColumn.CellTemplate&gt;
                    &lt;/DataGridTemplateColumn&gt;
                    
                    &lt;!-- 创建时间 --&gt;
                    &lt;DataGridTextColumn Header="创建时间" 
                                      Binding="{Binding CreatedTime, StringFormat='yyyy-MM-dd HH:mm'}" 
                                      Width="140"
                                      IsReadOnly="True"/&gt;
                    
                    &lt;!-- 操作列 --&gt;
                    &lt;DataGridTemplateColumn Header="操作" Width="200"&gt;
                        &lt;DataGridTemplateColumn.CellTemplate&gt;
                            &lt;DataTemplate&gt;
                                &lt;StackPanel Orientation="Horizontal" HorizontalAlignment="Center"&gt;
                                    &lt;!-- 编辑按钮 --&gt;
                                    &lt;Button Content="编辑"
                                           Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           Margin="2,0"&gt;
                                        &lt;Button.Content&gt;
                                            &lt;materialDesign:PackIcon Kind="Edit" Width="16" Height="16"/&gt;
                                        &lt;/Button.Content&gt;
                                    &lt;/Button&gt;
                                    
                                    &lt;!-- 重置密码按钮 --&gt;
                                    &lt;Button Content="重置密码"
                                           Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           Margin="2,0"&gt;
                                        &lt;Button.Content&gt;
                                            &lt;materialDesign:PackIcon Kind="Key" Width="16" Height="16"/&gt;
                                        &lt;/Button.Content&gt;
                                    &lt;/Button&gt;
                                    
                                    &lt;!-- 启用/禁用按钮 --&gt;
                                    &lt;Button Command="{Binding DataContext.ToggleUserStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           Margin="2,0"&gt;
                                        &lt;Button.Content&gt;
                                            &lt;materialDesign:PackIcon Width="16" Height="16"&gt;
                                                &lt;materialDesign:PackIcon.Style&gt;
                                                    &lt;Style TargetType="materialDesign:PackIcon"&gt;
                                                        &lt;Style.Triggers&gt;
                                                            &lt;DataTrigger Binding="{Binding IsActive}" Value="True"&gt;
                                                                &lt;Setter Property="Kind" Value="AccountCancel"/&gt;
                                                                &lt;Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/&gt;
                                                            &lt;/DataTrigger&gt;
                                                            &lt;DataTrigger Binding="{Binding IsActive}" Value="False"&gt;
                                                                &lt;Setter Property="Kind" Value="AccountCheck"/&gt;
                                                                &lt;Setter Property="Foreground" Value="{DynamicResource MaterialDesignValidationErrorBrush}"/&gt;
                                                            &lt;/DataTrigger&gt;
                                                        &lt;/Style.Triggers&gt;
                                                    &lt;/Style&gt;
                                                &lt;/materialDesign:PackIcon.Style&gt;
                                            &lt;/materialDesign:PackIcon&gt;
                                        &lt;/Button.Content&gt;
                                    &lt;/Button&gt;
                                &lt;/StackPanel&gt;
                            &lt;/DataTemplate&gt;
                        &lt;/DataGridTemplateColumn.CellTemplate&gt;
                    &lt;/DataGridTemplateColumn&gt;
                &lt;/DataGrid.Columns&gt;
            &lt;/DataGrid&gt;
        &lt;/materialDesign:Card&gt;

        &lt;!-- 分页控件 --&gt;
        &lt;materialDesign:Card Grid.Row="3" Padding="16" Margin="0,16,0,0"&gt;
            &lt;Grid&gt;
                &lt;Grid.ColumnDefinitions&gt;
                    &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;ColumnDefinition Width="*"/&gt;
                    &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;/Grid.ColumnDefinitions&gt;

                &lt;!-- 每页大小选择 --&gt;
                &lt;StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"&gt;
                    &lt;TextBlock Text="每页显示：" VerticalAlignment="Center" Margin="0,0,8,0"/&gt;
                    &lt;ComboBox SelectedItem="{Binding PageSize}"
                             ItemsSource="{Binding PageSizeOptions}"
                             Width="80"
                             Style="{StaticResource MaterialDesignComboBox}"/&gt;
                    &lt;TextBlock Text="条" VerticalAlignment="Center" Margin="8,0,0,0"/&gt;
                &lt;/StackPanel&gt;

                &lt;!-- 分页信息 --&gt;
                &lt;TextBlock Grid.Column="1" 
                          Text="{Binding PaginationInfo}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/&gt;

                &lt;!-- 分页按钮 --&gt;
                &lt;StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"&gt;
                    &lt;Button Content="首页"
                           Command="{Binding FirstPageCommand}"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           Margin="2,0"/&gt;
                    &lt;Button Content="上一页"
                           Command="{Binding PreviousPageCommand}"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           Margin="2,0"/&gt;
                    &lt;Button Content="下一页"
                           Command="{Binding NextPageCommand}"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           Margin="2,0"/&gt;
                    &lt;Button Content="末页"
                           Command="{Binding LastPageCommand}"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           Margin="2,0"/&gt;
                &lt;/StackPanel&gt;
            &lt;/Grid&gt;
        &lt;/materialDesign:Card&gt;

        &lt;!-- 加载指示器 --&gt;
        &lt;Grid Grid.RowSpan="4" 
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"&gt;
            &lt;StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"&gt;
                &lt;ProgressBar IsIndeterminate="True" 
                           Width="50" Height="50"
                           Style="{StaticResource MaterialDesignCircularProgressBar}"/&gt;
                &lt;TextBlock Text="正在加载..." 
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0"
                          Foreground="White"/&gt;
            &lt;/StackPanel&gt;
        &lt;/Grid&gt;
    &lt;/Grid&gt;
&lt;/UserControl&gt;