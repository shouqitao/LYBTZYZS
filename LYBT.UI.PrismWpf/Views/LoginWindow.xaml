&lt;Window x:Class="LYBT.UI.PrismWpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="LYBT中医诊所管理系统 - 登录" 
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    &lt;materialDesign:DialogHost CloseOnClickAway="True"&gt;
        &lt;Grid&gt;
            &lt;Grid.RowDefinitions&gt;
                &lt;RowDefinition Height="120"/&gt;
                &lt;RowDefinition Height="*"/&gt;
                &lt;RowDefinition Height="80"/&gt;
            &lt;/Grid.RowDefinitions&gt;

            &lt;!-- 标题区域 --&gt;
            &lt;StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"&gt;
                &lt;materialDesign:PackIcon Kind="Hospital" 
                                       Width="48" Height="48" 
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                       HorizontalAlignment="Center"/&gt;
                &lt;TextBlock Text="LYBT中医诊所管理系统" 
                          FontSize="18" FontWeight="Bold"
                          HorizontalAlignment="Center" 
                          Margin="0,10,0,5"
                          Foreground="{DynamicResource MaterialDesignBody}"/&gt;
                &lt;TextBlock Text="系统登录" 
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource MaterialDesignBodyLight}"/&gt;
            &lt;/StackPanel&gt;

            &lt;!-- 登录表单区域 --&gt;
            &lt;StackPanel Grid.Row="1" Margin="40,20" VerticalAlignment="Center"&gt;
                &lt;!-- 用户名输入 --&gt;
                &lt;TextBox Name="UserNameTextBox"
                        materialDesign:HintAssist.Hint="用户名"
                        materialDesign:HintAssist.IsFloating="True"
                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Margin="0,0,0,20"&gt;
                    &lt;TextBox.Style&gt;
                        &lt;Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"&gt;
                            &lt;Style.Triggers&gt;
                                &lt;Trigger Property="Validation.HasError" Value="True"&gt;
                                    &lt;Setter Property="materialDesign:ValidationAssist.HasError" Value="True"/&gt;
                                &lt;/Trigger&gt;
                            &lt;/Style.Triggers&gt;
                        &lt;/Style&gt;
                    &lt;/TextBox.Style&gt;
                &lt;/TextBox&gt;

                &lt;!-- 密码输入 --&gt;
                &lt;PasswordBox Name="PasswordBox"
                            materialDesign:HintAssist.Hint="密码"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            Margin="0,0,0,20"
                            Style="{StaticResource MaterialDesignOutlinedPasswordBox}"&gt;
                &lt;/PasswordBox&gt;

                &lt;!-- 记住登录状态 --&gt;
                &lt;CheckBox Content="记住登录状态" 
                         IsChecked="{Binding RememberMe}"
                         Margin="0,0,0,20"
                         Style="{StaticResource MaterialDesignCheckBox}"/&gt;

                &lt;!-- 错误消息显示 --&gt;
                &lt;TextBlock Text="{Binding ErrorMessage}" 
                          Foreground="{DynamicResource ValidationErrorBrush}"
                          FontSize="12"
                          Margin="0,0,0,10"
                          TextWrapping="Wrap"
                          Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/&gt;

                &lt;!-- 登录按钮 --&gt;
                &lt;Button Content="登录"
                       Command="{Binding LoginCommand}"
                       IsDefault="True"
                       Height="40"
                       FontSize="14"
                       FontWeight="Bold"
                       Style="{StaticResource MaterialDesignRaisedButton}"&gt;
                    &lt;Button.IsEnabled&gt;
                        &lt;MultiBinding Converter="{StaticResource MultiBooleanAndConverter}"&gt;
                            &lt;Binding Path="CanLogin"/&gt;
                            &lt;Binding Path="IsLoading" Converter="{StaticResource InverseBooleanConverter}"/&gt;
                        &lt;/MultiBinding&gt;
                    &lt;/Button.IsEnabled&gt;
                &lt;/Button&gt;

                &lt;!-- 加载指示器 --&gt;
                &lt;ProgressBar IsIndeterminate="True" 
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,10,0,0"
                           Height="4"/&gt;
            &lt;/StackPanel&gt;

            &lt;!-- 底部信息 --&gt;
            &lt;StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"&gt;
                &lt;TextBlock Text="默认管理员账号: sysadmin"
                          FontSize="12"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource MaterialDesignBodyLight}"
                          Margin="0,0,0,5"/&gt;
                &lt;TextBlock Text="© 2024 LYBT 中医诊所管理系统"
                          FontSize="10"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource MaterialDesignBodyLight}"/&gt;
            &lt;/StackPanel&gt;
        &lt;/Grid&gt;
    &lt;/materialDesign:DialogHost&gt;
&lt;/Window&gt;