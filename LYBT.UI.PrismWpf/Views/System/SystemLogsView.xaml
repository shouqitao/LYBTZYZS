<UserControl x:Class="LYBT.UI.PrismWpf.Views.System.SystemLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" 
                   Text="操作日志" 
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                   Margin="0,0,0,16"/>

        <!-- 筛选工具栏 -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 日志类型 -->
                <ComboBox Grid.Row="0" Grid.Column="0"
                          materialDesign:HintAssist.Hint="日志类型"
                          ItemsSource="{Binding LogTypes}"
                          SelectedItem="{Binding SelectedLogType}"/>

                <!-- 操作类型 -->
                <ComboBox Grid.Row="0" Grid.Column="2"
                          materialDesign:HintAssist.Hint="操作类型"
                          ItemsSource="{Binding ActionTypes}"
                          SelectedItem="{Binding SelectedActionType}"/>

                <!-- 时间范围 -->
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal">
                    <DatePicker materialDesign:HintAssist.Hint="开始日期"
                                SelectedDate="{Binding StartDate}"
                                Width="95"/>
                    <TextBlock Text="至" VerticalAlignment="Center" Margin="8,0"/>
                    <DatePicker materialDesign:HintAssist.Hint="结束日期"
                                SelectedDate="{Binding EndDate}"
                                Width="95"/>
                </StackPanel>

                <!-- 搜索框 -->
                <TextBox Grid.Row="0" Grid.Column="6"
                         materialDesign:HintAssist.Hint="搜索操作人或内容"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 搜索按钮 -->
                <Button Grid.Row="0" Grid.Column="8"
                        Content="搜索"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>

                <!-- 第二行：额外操作 -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="9" 
                            Orientation="Horizontal"
                            Margin="0,16,0,0">
                    <Button Content="导出日志" 
                            Command="{Binding ExportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="清理日志" 
                            Command="{Binding CleanupCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="刷新" 
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- 日志列表 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Logs}"
                  SelectedItem="{Binding SelectedLog}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  materialDesign:DataGridAssist.CellPadding="8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding LogTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="130"/>
                <DataGridTextColumn Header="类型" Binding="{Binding LogType}" Width="80"/>
                <DataGridTextColumn Header="操作" Binding="{Binding ActionType}" Width="80"/>
                <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="100"/>
                <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="100"/>
                <DataGridTextColumn Header="功能" Binding="{Binding Function}" Width="120"/>
                <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="300"/>
                <DataGridTextColumn Header="IP地址" Binding="{Binding ClientIP}" Width="120"/>
                <DataGridTemplateColumn Header="操作" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="详情" 
                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页控件 -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 条记录'}" 
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Button Content="上一页" 
                    Command="{Binding PreviousPageCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
            <TextBlock Text="{Binding CurrentPage}" 
                       VerticalAlignment="Center"
                       Margin="8,0"/>
            <TextBlock Text="/" 
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TotalPages}" 
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <Button Content="下一页" 
                    Command="{Binding NextPageCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>

</UserControl>