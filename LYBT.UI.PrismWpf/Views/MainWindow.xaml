<Window x:Class="LYBT.UI.PrismWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" 
        Height="800" Width="1200" 
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <materialDesign:DialogHost CloseOnClickAway="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <materialDesign:ColorZone Grid.Row="0" 
                                    Mode="PrimaryMid" 
                                    Padding="16">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="Hospital" 
                                               Width="32" Height="32" 
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                        <TextBlock Text="{Binding Title}" 
                                  FontSize="20" FontWeight="Bold"
                                  VerticalAlignment="Center" 
                                  Margin="12,0,0,0"
                                  Foreground="White"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                              DockPanel.DockPanel.Dock="Right"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.RealName, StringFormat='欢迎，{0}'}" 
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Foreground="White"/>
                        <Button Content="注销"
                               Command="{Binding LogoutCommand}"
                               Style="{StaticResource MaterialDesignFlatButton}"
                               Foreground="White"/>
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- 主内容区域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航菜单 -->
                <materialDesign:ColorZone Grid.Column="0" 
                                        Mode="Light" 
                                        Padding="0"
                                        Effect="{DynamicResource MaterialDesignShadowDepth1}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 用户管理 -->
                            <Expander Header="用户管理" IsExpanded="True">
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountGroup" 
                                                                   Width="20" Height="20"
                                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" 
                                                     Margin="8,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <StackPanel>
                                    <Button Content="用户列表"
                                           Command="{Binding NavigateCommand}"
                                           CommandParameter="UserManagement"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="32,8"/>
                                    <Button Content="角色管理"
                                           Command="{Binding NavigateCommand}"
                                           CommandParameter="RoleManagement"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="32,8"/>
                                </StackPanel>
                            </Expander>

                            <!-- 患者管理 -->
                            <Expander Header="患者管理">
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountHeart" 
                                                                   Width="20" Height="20"
                                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" 
                                                     Margin="8,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <StackPanel>
                                    <Button Content="患者列表"
                                           Command="{Binding NavigateCommand}"
                                           CommandParameter="PatientManagement"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="32,8"/>
                                </StackPanel>
                            </Expander>

                            <!-- 医生管理 -->
                            <Expander Header="医生管理">
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DoctorBag" 
                                                                   Width="20" Height="20"
                                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" 
                                                     Margin="8,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <StackPanel>
                                    <Button Content="医生列表"
                                           Command="{Binding NavigateCommand}"
                                           CommandParameter="DoctorManagement"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="32,8"/>
                                </StackPanel>
                            </Expander>

                            <!-- 药材管理 -->
                            <Expander Header="药材管理">
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pill" 
                                                                   Width="20" Height="20"
                                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" 
                                                     Margin="8,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <StackPanel>
                                    <Button Content="药材列表"
                                           Command="{Binding NavigateCommand}"
                                           CommandParameter="HerbManagement"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="32,8"/>
                                    <Button Content="经验方模板"
                                           Command="{Binding NavigateCommand}"
                                           CommandParameter="FormulaTemplateManagement"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="32,8"/>
                                </StackPanel>
                            </Expander>

                            <!-- 系统设置 -->
                            <Expander Header="系统设置">
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Settings" 
                                                                   Width="20" Height="20"
                                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" 
                                                     Margin="8,0,0,0"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <StackPanel>
                                    <Button Content="系统配置"
                                           Command="{Binding NavigateCommand}"
                                           CommandParameter="SystemSettings"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="32,8"/>
                                    <Button Content="操作日志"
                                           Command="{Binding NavigateCommand}"
                                           CommandParameter="SystemLogs"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Padding="32,8"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:ColorZone>

                <!-- 右侧内容区域 -->
                <ContentControl Grid.Column="1" 
                              prism:RegionManager.RegionName="ContentRegion"
                              Margin="8"/>
            </Grid>

            <!-- 底部状态栏 -->
            <materialDesign:ColorZone Grid.Row="2" 
                                    Mode="Dark" 
                                    Padding="8,4">
                <DockPanel>
                    <TextBlock Text="{Binding StatusMessage}" 
                              FontSize="12"
                              DockPanel.DockPanel.Dock="Left"
                              VerticalAlignment="Center"
                              Foreground="White"/>
                    <TextBlock Text="{Binding CurrentTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                              FontSize="12"
                              DockPanel.DockPanel.Dock="Right"
                              VerticalAlignment="Center"
                              Foreground="White"/>
                </DockPanel>
            </materialDesign:ColorZone>
        </Grid>
    </materialDesign:DialogHost>
</Window>
