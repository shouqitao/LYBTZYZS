<UserControl x:Class="LYBT.WPF.Client.Modules.FrontDesk.Views.FrontDeskMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid Background="#f8f9fa">
        <Border Background="White" 
                CornerRadius="8" 
                Margin="40"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                MinWidth="600"
                MinHeight="400">
            <Border.Effect>
                <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
            </Border.Effect>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <!-- 图标 -->
                <TextBlock Text="🏥" 
                           FontSize="80" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>
                
                <!-- 标题 -->
                <TextBlock Text="前台工作界面" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#2E86AB" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                
                <!-- 副标题 -->
                <TextBlock Text="Front Desk Workspace" 
                           FontSize="16" 
                           Foreground="#6c757d" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30"/>
                
                <!-- 功能说明 -->
                <TextBlock Text="前台功能模块正在开发中..." 
                           FontSize="18" 
                           Foreground="#495057" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>
                
                <!-- 功能列表 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Border Background="#e3f2fd" 
                            CornerRadius="20" 
                            Padding="15,8" 
                            Margin="10,0">
                        <TextBlock Text="患者挂号" FontSize="14" Foreground="#1976d2"/>
                    </Border>
                    <Border Background="#f3e5f5" 
                            CornerRadius="20" 
                            Padding="15,8" 
                            Margin="10,0">
                        <TextBlock Text="排队管理" FontSize="14" Foreground="#7b1fa2"/>
                    </Border>
                    <Border Background="#e8f5e8" 
                            CornerRadius="20" 
                            Padding="15,8" 
                            Margin="10,0">
                        <TextBlock Text="接待服务" FontSize="14" Foreground="#388e3c"/>
                    </Border>
                </StackPanel>
                
                <!-- 状态信息 -->
                <TextBlock Text="🔧 敬请期待后续版本更新" 
                           FontSize="14" 
                           Foreground="#adb5bd" 
                           HorizontalAlignment="Center" 
                           Margin="0,30,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>