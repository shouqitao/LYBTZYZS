{
  "name": "1b. Close Active Medical Cases",
  "request": {
    "method": "GET",
    "header": [
      {
        "key": "Authorization",
        "value": "Bearer {{doctorToken}}",
        "type": "text"
      }
    ],
    "url": {
      "raw": "{{baseUrl}}/api/v1/medicalcases?status=Active&PatientId={{testPatientId}}&page=1&pageSize=100&includeAllDoctors=true",
      "host": ["{{baseUrl}}"],
      "path": ["api", "v1", "medicalcases"],
      "query": [
        {"key": "status", "value": "Active"},
        {"key": "PatientId", "value": "{{testPatientId}}"},
        {"key": "page", "value": "1"},
        {"key": "pageSize", "value": "100"},
        {"key": "includeAllDoctors", "value": "true"}
      ]
    },
    "description": "Cleanup: Close any active medical cases for the test patient to ensure tests can create new cases"
  },
  "response": [],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Check if testPatientId exists (should be set by previous request)",
          "if (!pm.environment.get('testPatientId')) {",
          "    console.log('WARNING: testPatientId not set. Skipping cleanup.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Close all active medical cases for the test patient",
          "const jsonData = pm.response.json();",
          "if (jsonData.success && jsonData.data && jsonData.data.items) {",
          "    const activeCases = jsonData.data.items;",
          "    console.log(`Found ${activeCases.length} active medical case(s) for test patient`);",
          "    ",
          "    activeCases.forEach(function(medicalCase) {",
          "        const caseId = medicalCase.id;",
          "        const closeUrl = pm.environment.get('baseUrl') + '/api/v1/medicalcases/' + caseId + '/close';",
          "        const token = pm.environment.get('doctorToken');",
          "        ",
          "        pm.sendRequest({",
          "            url: closeUrl,",
          "            method: 'PUT',",
          "            header: {",
          "                'Authorization': 'Bearer ' + token,",
          "                'Content-Type': 'application/json'",
          "            },",
          "            body: {",
          "                mode: 'raw',",
          "                raw: JSON.stringify({",
          "                    Remark: 'Closed by test cleanup'",
          "                })",
          "            }",
          "        }, function(err, response) {",
          "            if (err) {",
          "                console.log('Failed to close case ' + caseId + ':', err);",
          "            } else {",
          "                const result = response.json();",
          "                if (result.success) {",
          "                    console.log('✓ Closed medical case:', caseId);",
          "                } else {",
          "                    console.log('✗ Failed to close case ' + caseId + ':', result.message);",
          "                }",
          "            }",
          "        });",
          "    });",
          "} else {",
          "    console.log('No active medical cases found for test patient');",
          "}"
        ]
      }
    }
  ]
}
