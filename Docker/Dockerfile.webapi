# 凌隐宝堂WebAPI容器化部署 - UltraThink重构容器化架构
# 多阶段构建，优化镜像大小和安全性

# ==================== 构建阶段 ====================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# 复制解决方案文件
COPY ["LYBT.Backend.sln", "./"]
COPY ["LYBT.All.sln", "./"]

# 复制项目文件（按依赖顺序，优化Docker层缓存）
COPY ["src/Backend/Core/LYBT.Models/*.csproj", "src/Backend/Core/LYBT.Models/"]
COPY ["src/Backend/Core/LYBT.Infrastructure/*.csproj", "src/Backend/Core/LYBT.Infrastructure/"]
COPY ["src/Backend/Core/LYBT.Domain/*.csproj", "src/Backend/Core/LYBT.Domain/"]

# 复制业务模块项目文件
COPY ["src/Backend/Modules/Auth/*.csproj", "src/Backend/Modules/Auth/"]
COPY ["src/Backend/Modules/Users/*.csproj", "src/Backend/Modules/Users/"]
COPY ["src/Backend/Modules/Patients/*.csproj", "src/Backend/Modules/Patients/"]
COPY ["src/Backend/Modules/Consultation/*.csproj", "src/Backend/Modules/Consultation/"]
COPY ["src/Backend/Modules/MedicalCase/*.csproj", "src/Backend/Modules/MedicalCase/"]
COPY ["src/Backend/Modules/Prescriptions/*.csproj", "src/Backend/Modules/Prescriptions/"]
COPY ["src/Backend/Modules/Herbs/*.csproj", "src/Backend/Modules/Herbs/"]
COPY ["src/Backend/Modules/Formula/*.csproj", "src/Backend/Modules/Formula/"]

# 复制WebAPI项目文件
COPY ["src/Backend/Services/LYBT.WebAPI/*.csproj", "src/Backend/Services/LYBT.WebAPI/"]

# 复制共享模型
COPY ["src/Shared/LYBT.Shared.Models/*.csproj", "src/Shared/LYBT.Shared.Models/"]

# 还原NuGet包（利用Docker层缓存）
RUN dotnet restore "src/Backend/Services/LYBT.WebAPI/LYBT.WebAPI.csproj"

# 复制所有源代码
COPY . .

# 设置工作目录为WebAPI项目
WORKDIR "/src/src/Backend/Services/LYBT.WebAPI"

# 构建发布版本
RUN dotnet build "LYBT.WebAPI.csproj" -c Release -o /app/build

# ==================== 发布阶段 ====================
FROM build AS publish
RUN dotnet publish "LYBT.WebAPI.csproj" -c Release -o /app/publish /p:UseAppHost=false

# ==================== 运行时阶段 ====================
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

# 安装必要的依赖
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 创建非root用户提高安全性
RUN groupadd -r lybtapp && useradd --no-log-init -r -g lybtapp lybtapp

# 设置工作目录
WORKDIR /app

# 复制发布的应用程序
COPY --from=publish /app/publish .

# 创建日志目录并设置权限
RUN mkdir -p /app/logs && chown -R lybtapp:lybtapp /app

# 设置环境变量
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:5000
ENV DOTNET_PRINT_TELEMETRY_MESSAGE=false
ENV DOTNET_USE_POLLING_FILE_WATCHER=true
ENV TZ=Asia/Shanghai

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/api/v1/performance/health-check || exit 1

# 切换到非root用户
USER lybtapp

# 暴露端口
EXPOSE 5000

# 启动命令
ENTRYPOINT ["dotnet", "LYBT.WebAPI.dll"]

# 元数据标签
LABEL maintainer="LYBT Development Team"
LABEL version="1.0.0"
LABEL description="凌隐宝堂中医诊所管理系统 - Web API服务"
LABEL build-date=""
LABEL vcs-url=""