{
  "dashboard": {
    "id": null,
    "title": "凌隐宝堂系统总览 - UltraThink重构监控面板",
    "tags": ["lybt", "overview", "monitoring"],
    "style": "dark",
    "timezone": "Asia/Shanghai",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "系统健康状态",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"lybt-webapi\"}",
            "legendFormat": "Web API",
            "refId": "A"
          },
          {
            "expr": "up{job=\"lybt-database\"}",
            "legendFormat": "数据库",
            "refId": "B"
          },
          {
            "expr": "up{job=\"lybt-redis\"}",
            "legendFormat": "Redis缓存",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {
                    "color": "red",
                    "text": "离线"
                  },
                  "1": {
                    "color": "green",
                    "text": "在线"
                  }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "none"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "horizontal",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          },
          "textMode": "value_and_name"
        }
      },
      {
        "id": 2,
        "title": "当前告警数量",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "ALERTS{alertstate=\"firing\", severity=\"critical\"}",
            "legendFormat": "严重告警",
            "refId": "A"
          },
          {
            "expr": "ALERTS{alertstate=\"firing\", severity=\"warning\"}",
            "legendFormat": "警告告警",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "title": "系统负载概览",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "cpu_usage_percent",
            "legendFormat": "CPU使用率",
            "refId": "A"
          },
          {
            "expr": "memory_usage_percent",
            "legendFormat": "内存使用率",
            "refId": "B"
          },
          {
            "expr": "disk_usage_percent",
            "legendFormat": "磁盘使用率",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 4,
        "title": "API请求率 (QPS)",
        "type": "graph",
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"lybt-webapi\"}[5m])",
            "legendFormat": "总请求率",
            "refId": "A"
          },
          {
            "expr": "rate(http_requests_total{job=\"lybt-webapi\", code=~\"2..\"}[5m])",
            "legendFormat": "成功请求率",
            "refId": "B"
          },
          {
            "expr": "rate(http_requests_total{job=\"lybt-webapi\", code=~\"4..\"}[5m])",
            "legendFormat": "客户端错误率",
            "refId": "C"
          },
          {
            "expr": "rate(http_requests_total{job=\"lybt-webapi\", code=~\"5..\"}[5m])",
            "legendFormat": "服务器错误率",
            "refId": "D"
          }
        ],
        "yAxes": [
          {
            "label": "请求/秒",
            "min": 0
          },
          {
            "show": false
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [100],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "10s",
          "handler": 1,
          "name": "API请求率过高告警",
          "noDataState": "no_data"
        }
      },
      {
        "id": 5,
        "title": "API响应时间分布",
        "type": "graph",
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"lybt-webapi\"}[5m]))",
            "legendFormat": "50%响应时间",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.90, rate(http_request_duration_seconds_bucket{job=\"lybt-webapi\"}[5m]))",
            "legendFormat": "90%响应时间",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"lybt-webapi\"}[5m]))",
            "legendFormat": "95%响应时间",
            "refId": "C"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"lybt-webapi\"}[5m]))",
            "legendFormat": "99%响应时间",
            "refId": "D"
          }
        ],
        "yAxes": [
          {
            "label": "秒",
            "min": 0
          },
          {
            "show": false
          }
        ]
      },
      {
        "id": 6,
        "title": "数据库性能指标",
        "type": "graph",
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 0,
          "y": 17
        },
        "targets": [
          {
            "expr": "sqlserver_connections",
            "legendFormat": "当前连接数",
            "refId": "A"
          },
          {
            "expr": "rate(sqlserver_queries_total[5m])",
            "legendFormat": "查询速率",
            "refId": "B"
          },
          {
            "expr": "sqlserver_slow_queries_per_sec",
            "legendFormat": "慢查询/秒",
            "refId": "C"
          }
        ]
      },
      {
        "id": 7,
        "title": "Redis缓存指标",
        "type": "graph",
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 8,
          "y": 17
        },
        "targets": [
          {
            "expr": "redis_connected_clients",
            "legendFormat": "连接客户端数",
            "refId": "A"
          },
          {
            "expr": "rate(redis_commands_total[5m])",
            "legendFormat": "命令执行速率",
            "refId": "B"
          },
          {
            "expr": "redis_memory_used_bytes",
            "legendFormat": "内存使用量",
            "refId": "C"
          },
          {
            "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total) * 100",
            "legendFormat": "缓存命中率",
            "refId": "D"
          }
        ]
      },
      {
        "id": 8,
        "title": "安全事件统计",
        "type": "graph",
        "gridPos": {
          "h": 9,
          "w": 8,
          "x": 16,
          "y": 17
        },
        "targets": [
          {
            "expr": "increase(security_login_failures_total[5m])",
            "legendFormat": "登录失败次数",
            "refId": "A"
          },
          {
            "expr": "increase(rate_limit_blocked_total[5m])",
            "legendFormat": "限流阻止次数",
            "refId": "B"
          },
          {
            "expr": "increase(security_attacks_blocked_total[5m])",
            "legendFormat": "攻击拦截次数",
            "refId": "C"
          }
        ]
      },
      {
        "id": 9,
        "title": "业务指标概览",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 26
        },
        "targets": [
          {
            "expr": "patient_registrations_total",
            "legendFormat": "总患者数",
            "refId": "A"
          },
          {
            "expr": "increase(patient_registrations_total[1d])",
            "legendFormat": "今日新增患者",
            "refId": "B"
          },
          {
            "expr": "prescriptions_total",
            "legendFormat": "总处方数",
            "refId": "C"
          },
          {
            "expr": "increase(prescriptions_total[1d])",
            "legendFormat": "今日新增处方",
            "refId": "D"
          },
          {
            "expr": "consultations_total",
            "legendFormat": "总诊疗次数",
            "refId": "E"
          },
          {
            "expr": "increase(consultations_total[1d])",
            "legendFormat": "今日诊疗次数",
            "refId": "F"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "horizontal"
        }
      }
    ]
  }
}