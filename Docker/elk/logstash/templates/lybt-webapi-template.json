{
  "index_patterns": ["lybt-webapi-*"],
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "index.lifecycle.name": "lybt-logs-policy",
    "index.lifecycle.rollover_alias": "lybt-webapi-logs",
    "index.refresh_interval": "5s",
    "index.mapping.total_fields.limit": 2000,
    "analysis": {
      "analyzer": {
        "chinese_analyzer": {
          "tokenizer": "ik_max_word",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "true",
    "properties": {
      "@timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "log_timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "log_level": {
        "type": "keyword"
      },
      "logger_name": {
        "type": "keyword"
      },
      "message": {
        "type": "text",
        "analyzer": "chinese_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "log_message": {
        "type": "text",
        "analyzer": "chinese_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "severity": {
        "type": "keyword"
      },
      "service": {
        "type": "keyword"
      },
      "environment": {
        "type": "keyword"
      },
      "system": {
        "type": "keyword"
      },
      "processed_at": {
        "type": "date"
      },
      "tags": {
        "type": "keyword"
      },
      "fields": {
        "type": "object",
        "properties": {
          "log_type": {
            "type": "keyword"
          },
          "service": {
            "type": "keyword"
          },
          "debug": {
            "type": "boolean"
          }
        }
      },
      "structured_data": {
        "type": "object",
        "dynamic": true
      },
      "client_ip": {
        "type": "ip"
      },
      "user_agent": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "geoip": {
        "type": "object",
        "properties": {
          "city_name": {
            "type": "keyword"
          },
          "continent_code": {
            "type": "keyword"
          },
          "country_code2": {
            "type": "keyword"
          },
          "country_code3": {
            "type": "keyword"
          },
          "country_name": {
            "type": "keyword"
          },
          "dma_code": {
            "type": "long"
          },
          "ip": {
            "type": "ip"
          },
          "latitude": {
            "type": "float"
          },
          "location": {
            "type": "geo_point"
          },
          "longitude": {
            "type": "float"
          },
          "postal_code": {
            "type": "keyword"
          },
          "region_code": {
            "type": "keyword"
          },
          "region_name": {
            "type": "keyword"
          },
          "timezone": {
            "type": "keyword"
          }
        }
      },
      "ua": {
        "type": "object",
        "properties": {
          "device": {
            "type": "keyword"
          },
          "major": {
            "type": "keyword"
          },
          "minor": {
            "type": "keyword"
          },
          "name": {
            "type": "keyword"
          },
          "os": {
            "type": "keyword"
          },
          "os_major": {
            "type": "keyword"
          },
          "os_minor": {
            "type": "keyword"
          },
          "os_name": {
            "type": "keyword"
          },
          "patch": {
            "type": "keyword"
          }
        }
      },
      "http_method": {
        "type": "keyword"
      },
      "url": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "response_code": {
        "type": "short"
      },
      "response_time": {
        "type": "float"
      },
      "request_size": {
        "type": "long"
      },
      "response_size": {
        "type": "long"
      },
      "username": {
        "type": "keyword"
      },
      "session_id": {
        "type": "keyword"
      },
      "correlation_id": {
        "type": "keyword"
      },
      "trace_id": {
        "type": "keyword"
      },
      "span_id": {
        "type": "keyword"
      },
      "error_type": {
        "type": "keyword"
      },
      "error_message": {
        "type": "text",
        "analyzer": "chinese_analyzer"
      },
      "stack_trace": {
        "type": "text"
      }
    }
  },
  "aliases": {
    "lybt-webapi-logs": {}
  }
}