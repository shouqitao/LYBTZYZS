{
  "index_patterns": ["lybt-security-*"],
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "index.lifecycle.name": "lybt-security-policy",
    "index.lifecycle.rollover_alias": "lybt-security-logs",
    "index.refresh_interval": "1s",
    "index.mapping.total_fields.limit": 2000,
    "analysis": {
      "analyzer": {
        "security_analyzer": {
          "tokenizer": "keyword",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "true",
    "properties": {
      "@timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "log_timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "security_event_type": {
        "type": "keyword"
      },
      "username": {
        "type": "keyword"
      },
      "client_ip": {
        "type": "ip"
      },
      "security_message": {
        "type": "text",
        "analyzer": "standard",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "message": {
        "type": "text",
        "analyzer": "standard",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "severity": {
        "type": "keyword"
      },
      "service": {
        "type": "keyword"
      },
      "environment": {
        "type": "keyword"
      },
      "system": {
        "type": "keyword"
      },
      "processed_at": {
        "type": "date"
      },
      "tags": {
        "type": "keyword"
      },
      "alert_priority": {
        "type": "keyword"
      },
      "fields": {
        "type": "object",
        "properties": {
          "log_type": {
            "type": "keyword"
          },
          "service": {
            "type": "keyword"
          }
        }
      },
      "geoip": {
        "type": "object",
        "properties": {
          "city_name": {
            "type": "keyword"
          },
          "continent_code": {
            "type": "keyword"
          },
          "country_code2": {
            "type": "keyword"
          },
          "country_code3": {
            "type": "keyword"
          },
          "country_name": {
            "type": "keyword"
          },
          "ip": {
            "type": "ip"
          },
          "latitude": {
            "type": "float"
          },
          "location": {
            "type": "geo_point"
          },
          "longitude": {
            "type": "float"
          },
          "postal_code": {
            "type": "keyword"
          },
          "region_code": {
            "type": "keyword"
          },
          "region_name": {
            "type": "keyword"
          },
          "timezone": {
            "type": "keyword"
          }
        }
      },
      "ua": {
        "type": "object",
        "properties": {
          "device": {
            "type": "keyword"
          },
          "name": {
            "type": "keyword"
          },
          "os": {
            "type": "keyword"
          },
          "os_name": {
            "type": "keyword"
          }
        }
      },
      "http_method": {
        "type": "keyword"
      },
      "url": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "response_code": {
        "type": "short"
      },
      "user_agent": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "session_id": {
        "type": "keyword"
      },
      "correlation_id": {
        "type": "keyword"
      },
      "trace_id": {
        "type": "keyword"
      },
      "attack_type": {
        "type": "keyword"
      },
      "threat_level": {
        "type": "keyword"
      },
      "blocked": {
        "type": "boolean"
      },
      "failure_count": {
        "type": "integer"
      },
      "brute_force_detected": {
        "type": "boolean"
      },
      "source_country": {
        "type": "keyword"
      },
      "source_city": {
        "type": "keyword"
      },
      "risk_score": {
        "type": "float"
      },
      "is_internal_ip": {
        "type": "boolean"
      },
      "request_headers": {
        "type": "object",
        "dynamic": true
      },
      "payload": {
        "type": "text",
        "index": false
      }
    }
  },
  "aliases": {
    "lybt-security-logs": {}
  }
}