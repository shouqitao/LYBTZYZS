dotnet_diagnostic.CA1047.severity = suggestion   # 不要在密封类型中声明受保护的成员
dotnet_diagnostic.CA1050.severity = suggestion   # 在命名空间中声明类型
dotnet_diagnostic.CA1051.severity = suggestion   # 不要声明可见实例字段
dotnet_diagnostic.CA1052.severity = suggestion   # 静态容器类型应该是 static 或 NotInheritable
dotnet_diagnostic.CA1054.severity = suggestion   # URI 参数不应为字符串
dotnet_diagnostic.CA1055.severity = suggestion   # URI 返回值不应为字符串
dotnet_diagnostic.CA1056.severity = suggestion   # URI 属性不应为字符串
dotnet_diagnostic.CA1058.severity = suggestion   # 类型不应扩展某些基类型
dotnet_diagnostic.CA1060.severity = suggestion   # 将 pinvoke 移到本机方法类
dotnet_diagnostic.CA1061.severity = suggestion   # 不要隐藏基类方法
dotnet_diagnostic.CA1062.severity = suggestion   # 验证公共方法的参数
dotnet_diagnostic.CA1063.severity = suggestion   # 正确实现 IDisposable
dotnet_diagnostic.CA1064.severity = suggestion   # 异常应该是公共的
dotnet_diagnostic.CA1065.severity = suggestion   # 不要在意外的位置引发异常
dotnet_diagnostic.CA1066.severity = suggestion   # 实现 IEquatable 时重写 Equals
dotnet_diagnostic.CA1067.severity = suggestion   # 实现 IEquatable 时重写 Equals
dotnet_diagnostic.CA1068.severity = suggestion   # CancellationToken 参数必须最后出现
dotnet_diagnostic.CA1069.severity = suggestion   # 枚举不应具有重复值

# 全球化规则  
dotnet_diagnostic.CA1303.severity = none         # 不要将文本作为本地化参数传递
dotnet_diagnostic.CA1304.severity = suggestion   # 指定 CultureInfo
dotnet_diagnostic.CA1305.severity = suggestion   # 指定 IFormatProvider
dotnet_diagnostic.CA1307.severity = suggestion   # 为了清晰起见，请指定 StringComparison
dotnet_diagnostic.CA1308.severity = suggestion   # 将字符串规范化为大写
dotnet_diagnostic.CA1309.severity = suggestion   # 使用序号字符串比较
dotnet_diagnostic.CA1310.severity = suggestion   # 为了正确性，请指定 StringComparison

# 互操作性规则
dotnet_diagnostic.CA1401.severity = suggestion   # P/Invoke 不应是可见的
dotnet_diagnostic.CA1416.severity = warning      # 验证平台兼容性
dotnet_diagnostic.CA1417.severity = warning      # 不要在 P/Invoke 的字符串参数上使用 OutAttribute

# 可维护性规则
dotnet_diagnostic.CA1501.severity = suggestion   # 避免过度继承
dotnet_diagnostic.CA1502.severity = suggestion   # 避免过度复杂性
dotnet_diagnostic.CA1505.severity = suggestion   # 避免不可维护的代码
dotnet_diagnostic.CA1506.severity = suggestion   # 避免过度类耦合
dotnet_diagnostic.CA1507.severity = suggestion   # 使用 nameof 表达式命名符号
dotnet_diagnostic.CA1508.severity = suggestion   # 避免死代码
dotnet_diagnostic.CA1509.severity = suggestion   # 代码度量配置文件中的条目无效

# 命名规则
dotnet_diagnostic.CA1700.severity = suggestion   # 不要将枚举值命名为"Reserved"
dotnet_diagnostic.CA1707.severity = none         # 标识符不应包含下划线
dotnet_diagnostic.CA1708.severity = suggestion   # 标识符应以大小写之外的差别进行区分
dotnet_diagnostic.CA1710.severity = suggestion   # 标识符应具有正确的后缀
dotnet_diagnostic.CA1711.severity = suggestion   # 标识符不应具有不正确的后缀
dotnet_diagnostic.CA1712.severity = suggestion   # 不要将类型名用作枚举值的前缀
dotnet_diagnostic.CA1713.severity = suggestion   # 事件不应具有 before 或 after 前缀
dotnet_diagnostic.CA1714.severity = suggestion   # Flags 枚举应具有复数名称
dotnet_diagnostic.CA1715.severity = suggestion   # 标识符应具有正确的前缀
dotnet_diagnostic.CA1716.severity = suggestion   # 标识符不应与关键字冲突
dotnet_diagnostic.CA1717.severity = suggestion   # 只有 FlagsAttribute 枚举应具有复数名称
dotnet_diagnostic.CA1720.severity = suggestion   # 标识符包含类型名称
dotnet_diagnostic.CA1721.severity = suggestion   # 属性名不应与 get 方法冲突
dotnet_diagnostic.CA1724.severity = suggestion   # 类型名不应与命名空间冲突
dotnet_diagnostic.CA1725.severity = suggestion   # 参数名应与基声明冲突

# 可靠性规则
dotnet_diagnostic.CA2000.severity = suggestion   # 丢失范围之前释放对象
dotnet_diagnostic.CA2002.severity = suggestion   # 不要锁定具有弱标识的对象
dotnet_diagnostic.CA2007.severity = suggestion   # 考虑对等待的任务调用 ConfigureAwait
dotnet_diagnostic.CA2008.severity = suggestion   # 不要在未传递 TaskScheduler 的情况下创建任务
dotnet_diagnostic.CA2009.severity = suggestion   # 不要对 ImmutableCollection 值调用 ToImmutableCollection
dotnet_diagnostic.CA2011.severity = warning      # 避免无限递归
dotnet_diagnostic.CA2012.severity = suggestion   # 正确使用 ValueTask
dotnet_diagnostic.CA2013.severity = warning      # 不要将 ReferenceEquals 与值类型结合使用
dotnet_diagnostic.CA2014.severity = warning      # 不要在循环中使用 stackalloc
dotnet_diagnostic.CA2015.severity = warning      # 不要为派生自 MemoryManager<T> 的类型定义终结器
dotnet_diagnostic.CA2016.severity = suggestion   # 将 CancellationToken 参数转发到采用一个的方法

# 安全规则
dotnet_diagnostic.CA2100.severity = suggestion   # 检查 SQL 查询是否存在安全漏洞
dotnet_diagnostic.CA2101.severity = suggestion   # 指定对 P/Invoke 字符串参数进行封送处理
dotnet_diagnostic.CA2109.severity = suggestion   # 检查可见的事件处理程序
dotnet_diagnostic.CA2119.severity = suggestion   # 密封满足私有接口的方法
dotnet_diagnostic.CA2153.severity = warning      # 不要捕获损坏状态异常
