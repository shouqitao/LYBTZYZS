# EditorConfig is awesome: https://EditorConfig.org
# DT-007: EditorConfig code style configuration

root = true

# All files
[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Code files  
[*.{cs,vb}]
indent_style = space
indent_size = 4

# XML files
[*.{csproj,props,targets,config,resx}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space  
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# C# code style rules
[*.cs]

# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# this. preferences
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion  
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Language keywords vs BCL types preferences
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Modifier preferences
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion

# Expression-level preferences
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion

# C# formatting rules
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true  
csharp_new_line_before_finally = true

# Indentation preferences
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left

# Space preferences
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_around_binary_operators = before_and_after

# Wrapping preferences
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true

# C# code style rules
csharp_prefer_braces = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion

# 'using' directive preferences
csharp_using_directive_placement = outside_namespace:suggestion

# ======================================================================
# 代码分析规则 - Code Analysis Rules
# ======================================================================

# ----------------------
# IDE0xxx - 代码风格规则
# ----------------------

# 移除不必要的 using
dotnet_diagnostic.IDE0005.severity = warning

# 移除不可达代码
dotnet_diagnostic.IDE0035.severity = warning

# 移除不必要的抑制
dotnet_diagnostic.IDE0079.severity = suggestion

# 移除不必要的抑制运算符
dotnet_diagnostic.IDE0080.severity = suggestion

# 移除不必要的等式运算符
dotnet_diagnostic.IDE0100.severity = suggestion

# 简化条件表达式
dotnet_diagnostic.IDE0075.severity = suggestion

# 使用系统 HashCode
dotnet_diagnostic.IDE0070.severity = suggestion

# 简化插值
dotnet_diagnostic.IDE0071.severity = suggestion

# 添加缺失的 case
dotnet_diagnostic.IDE0072.severity = suggestion

# 使用文件作用域命名空间
dotnet_diagnostic.IDE0161.severity = suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# 使用表达式主体
dotnet_diagnostic.IDE0022.severity = suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_indexers = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

# 使用模式匹配
dotnet_diagnostic.IDE0020.severity = suggestion
dotnet_diagnostic.IDE0038.severity = suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion

# 使用 var 关键字
dotnet_diagnostic.IDE0007.severity = suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# 使用集合初始化器
dotnet_diagnostic.IDE0028.severity = suggestion

# 使用自动属性
dotnet_diagnostic.IDE0032.severity = suggestion

# 使用显式元组名称
dotnet_diagnostic.IDE0033.severity = suggestion

# 简化默认表达式
dotnet_diagnostic.IDE0034.severity = suggestion

# 移除不必要的 return
dotnet_diagnostic.IDE0058.severity = none

# 移除不必要的值赋值
dotnet_diagnostic.IDE0059.severity = suggestion

# 移除未使用的参数
dotnet_diagnostic.IDE0060.severity = suggestion

# 使用表达式主体 lambda
dotnet_diagnostic.IDE0053.severity = suggestion
csharp_style_expression_bodied_lambdas = when_on_single_line:suggestion

# ----------------------
# CAxxxx - 代码质量规则
# ----------------------

# 性能规则
dotnet_diagnostic.CA1822.severity = suggestion   # 标记成员为静态
dotnet_diagnostic.CA1825.severity = warning      # 避免零长度数组分配
dotnet_diagnostic.CA1826.severity = warning      # 使用属性而不是 Linq 方法
dotnet_diagnostic.CA1827.severity = warning      # 不要使用 Count()/LongCount()
dotnet_diagnostic.CA1828.severity = warning      # 不要使用 CountAsync() 而使用 AnyAsync()
dotnet_diagnostic.CA1829.severity = warning      # 使用 Length/Count 属性而不是 Count() 方法
dotnet_diagnostic.CA1830.severity = suggestion   # 优先使用强类型的 Append 和 Insert 方法
dotnet_diagnostic.CA1831.severity = warning      # 对字符串使用 AsSpan 而不是基于范围的索引器
dotnet_diagnostic.CA1832.severity = suggestion   # 使用 AsSpan 或 AsMemory 而不是基于范围的索引器
dotnet_diagnostic.CA1833.severity = suggestion   # 使用 AsSpan 或 AsMemory 而不是基于范围的索引器
dotnet_diagnostic.CA1834.severity = suggestion   # 对单字符字符串使用 StringBuilder.Append(char)
dotnet_diagnostic.CA1835.severity = suggestion   # 优先使用基于 Memory 的 ReadAsync/WriteAsync 方法
dotnet_diagnostic.CA1836.severity = suggestion   # 如果可用，优先使用 IsEmpty 而不是 Count
dotnet_diagnostic.CA1837.severity = suggestion   # 使用 Environment.ProcessId 而不是 Process.GetCurrentProcess().Id
dotnet_diagnostic.CA1838.severity = suggestion   # 避免为 P/Invoke 参数使用 StringBuilder

# 设计规则
dotnet_diagnostic.CA1000.severity = suggestion   # 不要在泛型类型中声明静态成员
dotnet_diagnostic.CA1001.severity = warning      # 具有可释放字段的类型应该是可释放的
dotnet_diagnostic.CA1002.severity = suggestion   # 不要公开泛型列表
dotnet_diagnostic.CA1003.severity = suggestion   # 使用泛型事件处理程序实例
dotnet_diagnostic.CA1005.severity = suggestion   # 避免泛型类型的参数过多
dotnet_diagnostic.CA1008.severity = suggestion   # 枚举应具有零值
dotnet_diagnostic.CA1010.severity = suggestion   # 集合应实现泛型接口
dotnet_diagnostic.CA1012.severity = suggestion   # 抽象类型不应具有构造函数
dotnet_diagnostic.CA1014.severity = none         # 用 CLSCompliantAttribute 标记程序集
dotnet_diagnostic.CA1016.severity = suggestion   # 用 AssemblyVersionAttribute 标记程序集
dotnet_diagnostic.CA1017.severity = suggestion   # 用 ComVisibleAttribute 标记程序集
dotnet_diagnostic.CA1018.severity = suggestion   # 用 AttributeUsageAttribute 标记特性
dotnet_diagnostic.CA1019.severity = suggestion   # 定义特性参数的访问器
dotnet_diagnostic.CA1021.severity = suggestion   # 避免使用 out 参数
dotnet_diagnostic.CA1024.severity = suggestion   # 在适用处使用属性
dotnet_diagnostic.CA1027.severity = suggestion   # 用 FlagsAttribute 标记枚举
dotnet_diagnostic.CA1028.severity = suggestion   # 枚举存储应为 Int32
dotnet_diagnostic.CA1030.severity = suggestion   # 在适用处使用事件
dotnet_diagnostic.CA1031.severity = suggestion   # 不要捕获一般异常类型
dotnet_diagnostic.CA1032.severity = suggestion   # 实现标准异常构造函数
dotnet_diagnostic.CA1033.severity = suggestion   # 接口方法应可由子类型调用
dotnet_diagnostic.CA1034.severity = suggestion   # 嵌套类型不应是可见的
dotnet_diagnostic.CA1036.severity = suggestion   # 重写可比较类型中的方法
dotnet_diagnostic.CA1040.severity = suggestion   # 避免使用空接口
dotnet_diagnostic.CA1041.severity = suggestion   # 提供 ObsoleteAttribute 消息
dotnet_diagnostic.CA1043.severity = suggestion   # 将整型或字符串参数用于索引器
dotnet_diagnostic.CA1044.severity = suggestion   # 属性不应是只写的
dotnet_diagnostic.CA1045.severity = suggestion   # 不要通过引用传递类型
