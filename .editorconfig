dotnet_diagnostic.CA2227.severity = suggestion   # 集合属性应为只读
dotnet_diagnostic.CA2229.severity = suggestion   # 实现序列化构造函数
dotnet_diagnostic.CA2231.severity = suggestion   # 重写 ValueType.Equals 时重载运算符 equals
dotnet_diagnostic.CA2234.severity = suggestion   # 传递 System.Uri 对象，而不传递字符串
dotnet_diagnostic.CA2235.severity = suggestion   # 标记所有不可序列化的字段
dotnet_diagnostic.CA2237.severity = suggestion   # 用 SerializableAttribute 标记 ISerializable 类型
dotnet_diagnostic.CA2241.severity = suggestion   # 为格式化方法提供正确的参数
