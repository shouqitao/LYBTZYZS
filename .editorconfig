dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

# Symbol specifications
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
dotnet_naming_symbols.non_field_members.applicable_accessibilities = public, internal, private, protected, protected_internal

# Naming styles  
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.prefixed_with_i.capitalization = pascal_case
dotnet_naming_style.prefixed_with_i.required_prefix = I

# Private fields naming - underscore prefix
dotnet_naming_rule.private_fields_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_with_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# ======================================================================
# 项目特定配置 - Project Specific Configuration  
# ======================================================================

# ----------------------
# 抑制规则 - 基于项目实际情况
# ----------------------

# 抑制 XML 文档注释警告（已在 Directory.Build.props 中配置）
# 这些规则与项目当前文档策略一致
dotnet_diagnostic.CS1591.severity = none    # 缺少公共可见类型或成员的XML注释
dotnet_diagnostic.CS1570.severity = none    # XML注释格式错误
dotnet_diagnostic.CS1572.severity = none    # XML注释包含与实际参数不匹配的参数标记
dotnet_diagnostic.CS1573.severity = none    # XML注释中的参数与实际参数不匹配
dotnet_diagnostic.CS1587.severity = none    # XML注释没有放在有效语言元素上

# WPF 和 Prism 相关抑制
dotnet_diagnostic.CA1822.severity = none    # WPF 事件处理程序不能是静态的
dotnet_diagnostic.CA1062.severity = none    # WPF 绑定参数可能为 null，但由框架保证

# Entity Framework 相关抑制
dotnet_diagnostic.CA2007.severity = none    # EF Core 查询不需要 ConfigureAwait(false)
dotnet_diagnostic.CA1056.severity = none    # 某些 URI 属性可以是字符串（如配置）

# 中医诊所业务相关抑制
dotnet_diagnostic.CA1303.severity = none    # 暂不考虑本地化，诊所内部使用
dotnet_diagnostic.CA1307.severity = none    # 中文字符串比较暂用默认规则

# ----------------------
# 文件类型特定配置
# ----------------------

# 测试文件配置
[*Test*.cs,*Tests.cs,*.Test.cs]
dotnet_diagnostic.CA1062.severity = none    # 测试中的参数验证可以放松
dotnet_diagnostic.CA2007.severity = none    # 测试中不需要 ConfigureAwait
dotnet_diagnostic.CA1707.severity = none    # 测试方法名可以包含下划线
dotnet_diagnostic.CA1822.severity = none    # 测试方法不需要是静态的

# ViewModel 文件配置
[*ViewModel.cs,*ViewModels.cs]
dotnet_diagnostic.CA1822.severity = none    # ViewModel 方法通常需要实例绑定
dotnet_diagnostic.CA1062.severity = none    # Prism 注入的参数由框架保证非空

# 数据传输对象配置
[*Dto.cs,*Request.cs,*Response.cs,*Model.cs]
dotnet_diagnostic.CA1051.severity = none    # DTO 可以有公共字段
dotnet_diagnostic.CA2227.severity = none    # DTO 集合属性可以是可设置的

# 配置文件
[*Config.cs,*Configuration.cs,*Settings.cs]
dotnet_diagnostic.CA1051.severity = none    # 配置类可以有公共字段
dotnet_diagnostic.CA2227.severity = none    # 配置集合属性可以是可设置的

# 迁移文件
[*Migration*.cs]
dotnet_diagnostic.IDE0040.severity = none   # 迁移代码中的字符串不需要 nameof
dotnet_diagnostic.CA1062.severity = none    # 迁移参数由 EF 保证非空

# ----------------------
# 严格模式文件（核心业务逻辑）
# ----------------------

# 业务服务层 - 更严格的规则
[*BusinessService.cs,*Service.cs]
dotnet_diagnostic.CA1062.severity = warning  # 业务服务必须验证参数
dotnet_diagnostic.CA2007.severity = suggestion  # 考虑使用 ConfigureAwait
dotnet_diagnostic.CA1031.severity = warning  # 不要捕获一般异常
dotnet_diagnostic.IDE0060.severity = warning  # 移除未使用的参数

# 数据访问层 - 数据安全相关
[*Repository.cs,*DbContext.cs]
dotnet_diagnostic.CA2100.severity = warning  # 检查 SQL 注入漏洞
dotnet_diagnostic.CA2007.severity = suggestion  # 数据库操作考虑 ConfigureAwait
dotnet_diagnostic.CA1062.severity = warning  # 验证数据库参数

# 控制器 - API 安全性
[*Controller.cs]
dotnet_diagnostic.CA1062.severity = warning  # 验证 API 参数
dotnet_diagnostic.CA2100.severity = warning  # 防止 SQL 注入
dotnet_diagnostic.CA1054.severity = suggestion  # URI 参数类型检查

# ----------------------
# 性能关键代码配置
# ----------------------

# 启用所有性能相关警告
[*Performance*.cs,*Cache*.cs,*Query*.cs]
dotnet_diagnostic.CA1822.severity = warning  # 性能关键代码建议静态方法
dotnet_diagnostic.CA1825.severity = warning  # 避免零长度数组
dotnet_diagnostic.CA1826.severity = warning  # 使用属性而不是 LINQ
dotnet_diagnostic.CA1827.severity = warning  # 优化 Count() 调用
dotnet_diagnostic.CA1828.severity = warning  # 优化 CountAsync() 调用
dotnet_diagnostic.CA1829.severity = warning  # 使用 Length/Count 属性
dotnet_diagnostic.CA1834.severity = warning  # StringBuilder 优化
dotnet_diagnostic.CA1835.severity = warning  # 异步 I/O 优化

# ----------------------
# 代码质量等级设置
# ----------------------

# 默认质量等级（适中严格度）
dotnet_analyzer_diagnostic.category-design.severity = suggestion
dotnet_analyzer_diagnostic.category-performance.severity = suggestion  
dotnet_analyzer_diagnostic.category-reliability.severity = warning
dotnet_analyzer_diagnostic.category-security.severity = warning
dotnet_analyzer_diagnostic.category-usage.severity = suggestion

# ----------------------
# 自定义规则配置
# ----------------------

# 针对医疗数据的特殊处理
# 确保敏感数据处理的安全性
dotnet_diagnostic.CA5394.severity = warning  # 不要使用不安全的随机性
dotnet_diagnostic.CA5397.severity = warning  # 不要使用已弃用的 SslProtocols 值

# 确保异步代码的正确性（医疗系统稳定性要求）
dotnet_diagnostic.VSTHRD002.severity = warning  # 避免同步阻塞
dotnet_diagnostic.VSTHRD100.severity = error    # 避免异步 void（医疗系统要求更严格）
dotnet_diagnostic.VSTHRD104.severity = warning  # 提供异步选项

# 确保资源正确释放（医疗数据完整性）
dotnet_diagnostic.CA2000.severity = warning    # 释放对象
dotnet_diagnostic.CA1063.severity = warning    # 正确实现 IDisposable

# ----------------------
# IDE 集成配置
# ----------------------

# Visual Studio Code 动作设置
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion

# 重构建议启用
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion

# ----------------------
# 编译器配置
# ----------------------

# 确保与 Directory.Build.props 中的配置一致
# 这些设置会被构建文件覆盖，但提供 IDE 提示