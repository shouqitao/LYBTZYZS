dotnet_diagnostic.CA2315.severity = suggestion   # 不要使用不安全的反序列化程序 ObjectStateFormatter
dotnet_diagnostic.CA2321.severity = suggestion   # 不要使用 SimpleTypeResolver 对 JavaScriptSerializer 进行反序列化
dotnet_diagnostic.CA2322.severity = suggestion   # 在反序列化之前，确保未使用 SimpleTypeResolver 初始化 JavaScriptSerializer

