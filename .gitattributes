# Git attributes configuration for LYBT project
# 统一行尾和编码策略，确保跨平台一致性

# Default behavior: normalize line endings to CRLF on Windows, LF on Unix
* text=auto

# Text files that should have LF line endings (Unix-style)
# CI/CD和脚本文件统一使用LF
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Text files that should have CRLF line endings (Windows-style)
# Windows特定脚本和批处理文件
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# C# source files - let Git handle line endings automatically
# C#源代码文件让Git自动处理，保持项目一致性
*.cs text
*.csproj text
*.sln text
*.config text
*.props text
*.targets text

# Documentation files
*.txt text
*.docx binary
*.pdf binary

# Configuration files
*.gitignore text
*.editorconfig text
global.json text
Directory.Build.props text

# Binary files (ensure they remain untouched)
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary
*.iso binary

# Image files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.svg text

# Font files
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Database files
*.db binary
*.sqlite binary
*.mdf binary
*.ldf binary

# Visual Studio files
*.suo binary
*.user text
*.userprefs text
*.suo binary
*.cache binary

# Package files
*.nupkg binary
*.snupkg binary
