<UserControl x:Class="LYBT.WPF.Client.Core.Controls.Herbs.OptimizedHerbListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <!-- 操作按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" 
            BorderBrush="#E0E6ED" 
            BorderThickness="0,0,0,1"
            Padding="16,12"
            MinHeight="68">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- 状态指示器 -->
                <ColumnDefinition Width="180"/> <!-- 药材名称 -->
                <ColumnDefinition Width="120"/> <!-- 规格 -->
                <ColumnDefinition Width="100"/> <!-- 价格 -->
                <ColumnDefinition Width="100"/> <!-- 库存 -->
                <ColumnDefinition Width="60"/>  <!-- 单位 -->
                <ColumnDefinition Width="*"/>   <!-- 描述/备注 -->
                <ColumnDefinition Width="Auto"/> <!-- 操作按钮 -->
            </Grid.ColumnDefinitions>

            <!-- 状态指示器 -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <!-- 启用/禁用状态 -->
                <Ellipse Width="8" Height="8" 
                         Fill="{Binding IsEnabled, Converter={StaticResource BooleanToBrushConverter}}"
                         Margin="0,0,4,0"
                         VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 药材名称 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" 
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#2C3E50"/>
                <TextBlock Text="{Binding PinyinCode}" 
                           FontSize="11"
                           Foreground="#7F8C8D"
                           Margin="0,2,0,0"
                           Visibility="{Binding PinyinCode, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 规格 -->
            <TextBlock Grid.Column="2" 
                       Text="{Binding Specification}" 
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="#34495E"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Specification}"/>

            <!-- 价格 -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock FontSize="14" FontWeight="Bold" Foreground="#E74C3C">
                    <Run Text="￥"/>
                    <Run Text="{Binding Price, StringFormat='{}{0:F2}'}"/>
                </TextBlock>
                <TextBlock Text="{Binding Unit, StringFormat='/ {0}'}" 
                           FontSize="11"
                           Foreground="#7F8C8D"/>
            </StackPanel>

            <!-- 库存 -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#27AE60">
                    <Run Text="{Binding CurrentStock, StringFormat='{}{0:F1}'}"/>
                </TextBlock>
                <TextBlock Text="{Binding Unit}" 
                           FontSize="11"
                           Foreground="#7F8C8D"/>
            </StackPanel>

            <!-- 单位 -->
            <TextBlock Grid.Column="5" 
                       Text="{Binding Unit}" 
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#7F8C8D"
                       HorizontalAlignment="Center"/>

            <!-- 描述/备注 -->
            <StackPanel Grid.Column="6" 
                        VerticalAlignment="Center" 
                        Margin="12,0">
                <TextBlock Text="{Binding Description}" 
                           FontSize="12"
                           Foreground="#5D6D7E"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="200"
                           ToolTip="{Binding Description}"
                           Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="7" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                <Button Content="详情" 
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#3498DB"
                        Foreground="White"
                        Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
                <Button Content="编辑" 
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2ECC71"
                        Foreground="White"
                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>