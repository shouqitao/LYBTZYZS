<Window x:Class="LYBT.WPF.Client.Modules.Users.Views.UserProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="编辑个人资料" 
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="编辑个人资料" 
                   FontSize="20" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 头像部分 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 当前头像 -->
                    <Border Grid.Column="0"
                            Width="80" Height="80"
                            CornerRadius="40"
                            Background="#E0E0E0"
                            Margin="0,0,20,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                        <Setter Property="Background" Value="#2E86AB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- 默认头像 -->
                            <TextBlock Text="{Binding AvatarInitial}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasAvatar, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <!-- 用户头像 -->
                            <Image Source="{Binding AvatarSource}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image.Clip>
                                    <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    
                    <!-- 头像操作 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="个人头像"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="选择图片"
                                    Command="{Binding SelectAvatarCommand}"
                                    Padding="15,8"
                                    Margin="0,0,10,0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#2196F3"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="删除头像"
                                    Command="{Binding RemoveAvatarCommand}"
                                    Padding="15,8"
                                    Cursor="Hand"
                                    Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F44336"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#D32F2F"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="支持 JPG、PNG 格式，大小不超过 2MB"
                                   FontSize="11"
                                   Foreground="#999"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 基本信息 -->
                <Border Background="#F8F9FA"
                        CornerRadius="4"
                        Padding="15"
                        Margin="0,0,0,15">
                    <TextBlock Text="基本信息"
                               FontWeight="Bold"
                               FontSize="14"/>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 用户名（只读） -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="用户名" 
                               VerticalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBox Grid.Row="0" Grid.Column="1" 
                             Text="{Binding Username}"
                             IsReadOnly="True"
                             Background="#F5F5F5"
                             Height="35"
                             Padding="10,0"
                             Margin="0,0,0,15"/>

                    <!-- 真实姓名 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="真实姓名" 
                               VerticalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             Text="{Binding RealName, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,0"
                             Margin="0,0,0,15">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#DDD"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 邮箱 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="邮箱" 
                               VerticalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBox Grid.Row="2" Grid.Column="1" 
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,0"
                             Margin="0,0,0,15">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#DDD"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 电话 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" 
                               Text="电话" 
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" 
                             Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#DDD"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 工作信息 -->
                <Border Background="#F8F9FA"
                        CornerRadius="4"
                        Padding="15"
                        Margin="0,0,0,15">
                    <TextBlock Text="工作信息"
                               FontWeight="Bold"
                               FontSize="14"/>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 部门 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="部门" 
                               VerticalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBox Grid.Row="0" Grid.Column="1" 
                             Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,0"
                             Margin="0,0,0,15">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#DDD"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 职位 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="职位" 
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Padding="10,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#DDD"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 错误提示 -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#F44336"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮 -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" 
                    Content="保存修改" 
                    Height="35"
                    Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"
                    IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4CAF50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Grid.Column="1" 
                    Content="取消" 
                    Height="35"
                    Margin="10,0,0,0"
                    Command="{Binding CancelCommand}"
                    IsCancel="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="Foreground" Value="#666"/>
                        <Setter Property="BorderBrush" Value="#DDD"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>