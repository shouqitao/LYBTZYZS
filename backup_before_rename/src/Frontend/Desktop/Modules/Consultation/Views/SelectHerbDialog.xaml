<Window x:Class="LYBT.WPF.Client.Modules.Consultation.Views.SelectHerbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="选择药材"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Foreground="Black"
        Background="White"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="Segoe UI">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索框 -->
                <TextBox Grid.Column="0" 
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         BorderBrush="White" BorderThickness="1" Padding="5"
                         Foreground="White"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- 默认用量 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="默认用量：" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding DefaultQuantity}" 
                             Width="50"
                             BorderBrush="White" BorderThickness="1" Padding="5"
                             Foreground="White"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="g" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 刷新按钮 -->
                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        Background="Transparent" BorderThickness="0" Padding="8"
                        Foreground="White"
                        ToolTip="刷新列表"
                        Margin="8,0,0,0">
                    <TextBlock Text="🔄" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </Button>

                <!-- 清空选择按钮 -->
                <Button Grid.Column="3"
                        Command="{Binding ClearSelectionCommand}"
                        Background="Transparent" BorderThickness="0" Padding="8"
                        Foreground="White"
                        ToolTip="清空已选"
                        Margin="8,0,0,0">
                    <TextBlock Text="🧹" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.4*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：药材列表 -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#E0E0E0">
                <Grid>
                    <!-- 药材列表 -->
                    <DataGrid ItemsSource="{Binding Herbs}"
                              SelectedItem="{Binding SelectedHerb}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" 
                                          Command="{Binding AddToSelectionCommand}"/>
                        </DataGrid.InputBindings>
                        
                        <DataGrid.Columns>
                            <!-- 药材名称 -->
                            <DataGridTextColumn Header="药材名称" 
                                                Binding="{Binding Name}" 
                                                Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 拼音码 -->
                            <DataGridTextColumn Header="拼音码" 
                                                Binding="{Binding PinYinCode}" 
                                                Width="80"/>

                            <!-- 产地 -->
                            <DataGridTextColumn Header="产地" 
                                                Binding="{Binding Origin}" 
                                                Width="100"/>

                            <!-- 规格 -->
                            <DataGridTextColumn Header="规格" 
                                                Binding="{Binding Spec}" 
                                                Width="80"/>

                            <!-- 单价 -->
                            <DataGridTextColumn Header="单价" 
                                                Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Price" StringFormat="¥{0:F2}/{1}">
                                        <Binding.ConverterParameter>
                                            <Binding Path="Unit"/>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 功效 -->
                            <DataGridTextColumn Header="功效" 
                                                Binding="{Binding Effect}" 
                                                Width="*"/>

                            <!-- 快速添加 -->
                            <DataGridTemplateColumn Header="操作" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.QuickAddCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="8"
                                                Height="24"
                                                ToolTip="快速添加">
                                            <TextBlock Text="+" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态提示 -->
                    <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32">
                        <StackPanel>
                            <TextBlock Text="💊" 
                                       Width="64" Height="64"
                                       HorizontalAlignment="Center"
                                       FontSize="48"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       FontSize="16"
                                       Margin="0,16,0,0"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <!-- 加载指示器 -->
                    <ProgressBar
                                 IsIndeterminate="True"
                                 Width="48" Height="48"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- 右侧：已选药材列表 -->
            <Border Grid.Column="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="0" 
                               FontSize="16"
                               FontWeight="Medium"
                               Margin="0,0,0,12">
                        <Run Text="已选药材"/>
                        <Run Text="(" Foreground="Gray"/>
                        <Run Text="{Binding SelectionCount}" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <Run Text="味)" Foreground="Gray"/>
                    </TextBlock>

                    <!-- 已选列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" 
                                            Padding="12"
                                            Background="#F5F5F5"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 药材信息 -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding HerbName}" 
                                                           FontWeight="Medium"
                                                           FontSize="14"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="60"
                                                              BorderBrush="Gray" BorderThickness="1" Padding="5"
                                                             Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Unit}" 
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,12,0"/>
                                                    <TextBlock Text="{Binding PriceText}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 删除按钮 -->
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.RemoveFromSelectionCommand, 
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="8"
                                                    ToolTip="移除">
                                                <TextBlock Text="×" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 总价 -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource PrimaryHueLightBrush}"
                            Padding="12"
                            CornerRadius="4"
                            Margin="0,12,0,0">
                        <TextBlock FontSize="16" FontWeight="Medium">
                            <Run Text="预估总价："/>
                            <Run Text="￥" Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                            <Run Text="{Binding TotalPrice, StringFormat=F2}" 
                                 Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="2" 
                Background="#F0F0F0"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 提示信息 -->
                <TextBlock Grid.Column="0" 
                           VerticalAlignment="Center"
                           Foreground="Gray">
                    <Run Text="共找到"/>
                    <Run Text="{Binding Herbs.Count}" FontWeight="Bold"/>
                    <Run Text="种药材，已选择"/>
                    <Run Text="{Binding SelectionCount}" FontWeight="Bold"/>
                    <Run Text="味"/>
                </TextBlock>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="确定添加" 
                            Command="{Binding ConfirmCommand}"
                            Background="#2196F3" Foreground="White" Padding="16,8" BorderThickness="0"
                            IsDefault="True"
                            Margin="0,0,8,0"
                            Width="100"/>
                    
                    <Button Content="取消" 
                            Command="{Binding CancelCommand}"
                            Background="Transparent" Foreground="Gray" Padding="16,8" BorderBrush="Gray" BorderThickness="1"
                            IsCancel="True"
                            Width="100"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>