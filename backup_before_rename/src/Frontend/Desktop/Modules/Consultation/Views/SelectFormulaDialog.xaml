<Window x:Class="LYBT.WPF.Client.Modules.Consultation.Views.SelectFormulaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="选择验方模板"
        Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="Black"
        Background="White"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="Segoe UI">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 分类筛选 -->
                <ComboBox Grid.Column="0" 
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Style="{StaticResource }"
                          Foreground="White"
                          BorderBrush="White"
                          Margin="0,0,8,0"/>

                <!-- 搜索框 -->
                <TextBox Grid.Column="1" 
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource }"
                         Foreground="White"
                         BorderBrush="White"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- 刷新按钮 -->
                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource }"
                        Foreground="White"
                        ToolTip="刷新列表">
                    <TextBlock Text="🔄" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.55*"/>
                <ColumnDefinition Width="0.45*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：验方列表 -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#E0E0E0">
                <Grid>
                    <!-- 验方列表 -->
                    <DataGrid ItemsSource="{Binding Formulas}"
                              SelectedItem="{Binding SelectedFormula}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" 
                                          Command="{Binding ConfirmCommand}"/>
                        </DataGrid.InputBindings>
                        
                        <DataGrid.Columns>
                            <!-- 验方名称 -->
                            <DataGridTextColumn Header="验方名称" 
                                                Binding="{Binding Name}" 
                                                Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 分类 -->
                            <DataGridTextColumn Header="分类" 
                                                Binding="{Binding Category}" 
                                                Width="80"/>

                            <!-- 药材数 -->
                            <DataGridTextColumn Header="药材数" 
                                                Binding="{Binding HerbCount}" 
                                                Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 主要药材 -->
                            <DataGridTextColumn Header="主要组成" 
                                                Binding="{Binding HerbNames}" 
                                                Width="*"/>

                            <!-- 参考价格 -->
                            <DataGridTextColumn Header="参考价" 
                                                Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="TotalPrice" StringFormat="¥{0:F2}"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 操作 -->
                            <DataGridTemplateColumn Header="操作" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ViewDetailsCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="4"
                                                Height="24"
                                                ToolTip="查看详情">
                                            <TextBlock Text="👁" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态提示 -->
                    <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="32">
                        <StackPanel>
                            <TextBlock Text="📋" 
                                       Width="64" Height="64"
                                       HorizontalAlignment="Center"
                                       FontSize="48"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                            <TextBlock Text="{Binding EmptyStateMessage}"
                                       FontSize="16"
                                       Margin="0,16,0,0"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <!-- 加载指示器 -->
                    <ProgressBar IsIndeterminate="True"
                                 Width="48" Height="48"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- 右侧：预览区 -->
            <Border Grid.Column="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="0" 
                               Text="验方详情预览"
                               FontSize="16"
                               FontWeight="Medium"
                               Margin="0,0,0,12"/>

                    <!-- 预览内容 -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Microsoft YaHei"
/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="2" 
                Background="#F0F0F0"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 提示信息 -->
                <TextBlock Grid.Column="0" 
                           VerticalAlignment="Center"
                           Foreground="Gray">
                    <Run Text="共找到"/>
                    <Run Text="{Binding Formulas.Count}" FontWeight="Bold"/>
                    <Run Text="个验方模板"/>
                </TextBlock>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="确定选择" 
                            Command="{Binding ConfirmCommand}"
                            Background="#2196F3" Foreground="White" Padding="16,8" BorderThickness="0"
                            IsDefault="True"
                            Margin="0,0,8,0"
                            Width="100"/>
                    
                    <Button Content="取消" 
                            Command="{Binding CancelCommand}"
                            Background="Transparent" Foreground="Gray" Padding="16,8" BorderBrush="Gray" BorderThickness="1"
                            IsCancel="True"
                            Width="100"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>