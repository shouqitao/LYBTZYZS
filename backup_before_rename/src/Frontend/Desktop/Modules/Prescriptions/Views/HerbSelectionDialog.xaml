<UserControl x:Class="LYBT.WPF.Client.Modules.Prescriptions.Views.HerbSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700"
             MinWidth="600" MinHeight="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <materialDesign:ColorZone Mode="PrimaryMid" Grid.Row="0" Padding="16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Foreground="White"/>
        </materialDesign:ColorZone>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="分类：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" 
                      SelectedItem="{Binding SelectedCategory}"
                      Margin="0,0,16,0"/>

            <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="搜索药材名称、拼音、别名..."
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

            <Button Grid.Column="3" Command="{Binding RefreshCommand}" 
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="刷新" Margin="8,0,0,0">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
        </Grid>

        <!-- 药材列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredHerbs}" 
                  SelectedItem="{Binding SelectedHerb}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" Margin="16,0,16,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="拼音" Binding="{Binding PinYin}" Width="100"/>
                <DataGridTextColumn Header="别名" Binding="{Binding Alias}" Width="100"/>
                <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="80"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="单价" Binding="{Binding Price, StringFormat='￥{0:F2}'}" Width="80"/>
                <DataGridTextColumn Header="库存" Binding="{Binding Stock}" Width="80"/>
                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 用量设置 -->
        <Grid Grid.Row="3" Margin="16,0,16,16" Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="用量：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding Quantity}" 
                     materialDesign:HintAssist.Hint="数量"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
            <TextBlock Grid.Column="2" Text="{Binding SelectedHerb.Unit}" 
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- 按钮栏 -->
        <Grid Grid.Row="4" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" IsIndeterminate="{Binding IsLoading}" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Margin="0,0,8,0"/>

            <Button Grid.Column="1" Command="{Binding ConfirmCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="确定" Margin="0,0,8,0" MinWidth="80"/>

            <Button Grid.Column="2" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="取消" MinWidth="80"/>
        </Grid>
    </Grid>
</UserControl>