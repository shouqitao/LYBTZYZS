<UserControl x:Class="LYBT.WPF.Client.Modules.Prescriptions.Views.PrescriptionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Command="{Binding AddPrescriptionCommand}" ToolTip="新建处方">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                        <TextBlock Text="新建处方"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding RefreshCommand}" ToolTip="刷新">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Margin="0,0,5,0"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="搜索患者姓名、处方号、诊断..."
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,10,0"/>

            <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}"
                        materialDesign:HintAssist.Hint="开始日期"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                        Margin="0,0,10,0" Width="120"/>

            <TextBlock Grid.Column="2" Text="至" VerticalAlignment="Center" Margin="5"/>

            <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}"
                        materialDesign:HintAssist.Hint="结束日期"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                        Margin="0,0,10,0" Width="120"/>

            <Button Grid.Column="4" Command="{Binding ClearFiltersCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="清除筛选" Margin="0,0,10,0"/>
        </Grid>

        <!-- 处方列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Prescriptions}" 
                  SelectedItem="{Binding SelectedPrescription}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="处方号" Binding="{Binding PrescriptionNo}" Width="150"/>
                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                <DataGridTextColumn Header="处方日期" Binding="{Binding PrescriptionDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="100"/>
                <DataGridTextColumn Header="诊断" Binding="{Binding Diagnosis}" Width="*"/>
                <DataGridTextColumn Header="剂数" Binding="{Binding TotalDoses}" Width="60"/>
                <DataGridTextColumn Header="总金额" Binding="{Binding TotalAmount, StringFormat='￥{0:F2}'}" Width="100"/>
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.ViewPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="查看" Margin="2"/>
                                <Button Command="{Binding DataContext.EditPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="编辑" Margin="2"/>
                                <Button Command="{Binding DataContext.CopyPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="复制" Margin="2"/>
                                <Button Command="{Binding DataContext.PrintPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="打印" Margin="2"/>
                                <Button Command="{Binding DataContext.DeletePrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="Red" Content="删除" Margin="2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="100" Height="15" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>