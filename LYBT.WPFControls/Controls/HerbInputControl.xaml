<UserControl x:Class="LYBT.WPFControls.HerbInputControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="clr-namespace:LYBT.WPFControls.Converters"
            x:Name="root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <c:TopMarginConverter x:Key="TopMarginConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Grid>
                <TextBox x:Name="PART_HerbBox" Width="160" Margin="0"
                         Text="{Binding HerbText, ElementName=root, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="PART_HerbBox_KeyDown"
                         LostKeyboardFocus="PART_HerbBox_LostKeyboardFocus"/>

                <Border Background="White" BorderBrush="#DDD" BorderThickness="1"

                        Visibility="{Binding IsSuggestionVisible, ElementName=root, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="{Binding ElementName=PART_HerbBox, Path=ActualHeight, Converter={StaticResource TopMarginConverter}}">
                    <ListBox x:Name="PART_SuggestionList"
                             ItemsSource="{Binding FilteredHerbs, ElementName=root}"
                             SelectedItem="{Binding SelectedSuggestion, ElementName=root, Mode=TwoWay}"
                             DisplayMemberPath="Name" MaxHeight="120"
                             KeyDown="PART_SuggestionList_KeyDown"/>
                </Border>
            </Grid>
            <TextBox x:Name="PART_AmountBox" Width="80" Margin="8,0"
                     Text="{Binding AmountText, ElementName=root, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="PART_AmountBox_KeyDown"/>
            <Button Content="添加" Width="60" Command="{Binding AddCommand, ElementName=root}"/>
        </StackPanel>
        <DataGrid x:Name="PART_List" Grid.Row="1" ItemsSource="{Binding ItemsSource, ElementName=root}" 
                  AutoGenerateColumns="False" HeadersVisibility="Column" Margin="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="药材" Binding="{Binding HerbName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="剂量" Binding="{Binding Quantity, Mode=TwoWay}" Width="80"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80"/>
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="×" Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Width="24" Height="24"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
