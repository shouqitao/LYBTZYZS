<UserControl x:Class="LYBT.UI.WPF.Controls.PagingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="上一页" Command="{Binding PrevPageCommand}" Margin="0,0,8,0"/>
        <TextBlock Text="页码:" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding PageIndex}" Margin="2,0"/>
        <TextBlock Text="/"/>
        <TextBlock Text="{Binding TotalPage}" Margin="2,0,8,0"/>
        <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="0,0,8,0"/>
        <TextBlock Text="每页:" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding PageSize}" Margin="2,0,8,0"/>
        <TextBlock Text="本页:" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding PagedList.Count}" Margin="2,0"/>
        <TextBlock Text=" 总共:" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding TotalCount}" Margin="2,0"/>
    </StackPanel>
</UserControl>
