<UserControl x:Class="LYBT.UI.WPF.Controls.PagingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="上一页" Command="{Binding PrevPageCommand}" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding CurrentPage}" Margin="0,0,4,0"/>
        <TextBlock Text="/" />
        <TextBlock Text="{Binding TotalPages}" Margin="4,0,8,0"/>
        <Button Content="下一页" Command="{Binding NextPageCommand}"/>
    </StackPanel>
</UserControl>
