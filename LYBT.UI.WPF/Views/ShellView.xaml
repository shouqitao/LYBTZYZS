<Window x:Class="LYBT.UI.WPF.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="凌隐宝堂中医诊所" Height="600" Width="1000"
        materialDesign:ColorZoneAssist.Mode="PrimaryDark">
    <Grid>
        <materialDesign:DrawerHost>
            <materialDesign:DrawerHost.LeftDrawerContent>
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding ViewName}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </materialDesign:DrawerHost.LeftDrawerContent>
            <Grid>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5"
                                Visibility="{Binding CurrentUser, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding CurrentUser.RealName}" Margin="0,0,10,0"/>
                        <Button Content="退出" Command="{Binding LogoutCommand}" />
                    </StackPanel>
                    <ContentControl prism:RegionManager.RegionName="MainRegion"/>
                </DockPanel>
            </Grid>
        </materialDesign:DrawerHost>
    </Grid>
</Window>
