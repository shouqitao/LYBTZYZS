<UserControl x:Class="LYBT.UI.WPF.Views.Components.NavigationDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LYBT.UI.WPF.Converters"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 导航项样式 -->
        <Style x:Key="NavigationItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Light}"
            BorderThickness="0,0,1,0"
            Width="280">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10">
            <StackPanel>
                <!-- 导航头部 -->
                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        Margin="10,0,10,15"
                        CornerRadius="10"
                        Padding="15,10">
                    <StackPanel>
                        <TextBlock Text="功能导航"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding NavigationCount, StringFormat='共 {0} 个功能模块'}"
                                   FontSize="11"
                                   Foreground="White"
                                   Opacity="0.8"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 快速访问区域 -->
                <Expander Header="快速访问" 
                          IsExpanded="True"
                          Margin="10,0,10,10">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QuickAccessItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <ItemsControl ItemsSource="{Binding QuickAccessItems}" Margin="5,5,5,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavigationItemStyle}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon, FallbackValue=Circle}"
                                                                Width="18" Height="18"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Star"
                                                                Width="14" Height="14"
                                                                VerticalAlignment="Center"
                                                                Margin="5,0,0,0"
                                                                Foreground="Gold"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- 主要功能区域 -->
                <Expander Header="主要功能" IsExpanded="True" Margin="10,0,10,10">
                    <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="5,5,5,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavigationItemStyle}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon, FallbackValue=Circle}"
                                                                Width="18" Height="18"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                        <materialDesign:PackIcon Kind="ChevronRight"
                                                                Width="14" Height="14"
                                                                VerticalAlignment="Center"
                                                                Margin="5,0,0,0"
                                                                Opacity="0.6"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- 最近访问区域 -->
                <Expander Header="最近访问" 
                          IsExpanded="False" 
                          Margin="10,0,10,10">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding RecentItems}" Margin="5,5,5,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavigationItemStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="{Binding Icon, FallbackValue=Circle}"
                                                                    Width="16" Height="16"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0"
                                                                    Opacity="0.7"/>
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       VerticalAlignment="Center"
                                                       FontSize="13"/>
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding DataContext.AddToQuickAccessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24" Height="24"
                                                    Margin="5,0,0,0"
                                                    ToolTip="添加到快速访问">
                                                <materialDesign:PackIcon Kind="StarPlus" Width="12" Height="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="清除最近访问"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding ClearRecentCommand}"
                                FontSize="11"
                                Margin="5,5,5,0"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Expander>

                <!-- 操作按钮区域 -->
                <StackPanel Margin="15,20,15,10">
                    <Button Content="刷新菜单"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding RefreshMenuCommand}"
                            Margin="0,0,0,10">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>

                <!-- 空状态提示 -->
                <Border Visibility="{Binding HasNavigationItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Background="{DynamicResource MaterialDesign.Brush.Background}"
                        Margin="20"
                        Padding="20"
                        CornerRadius="10">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                Width="48" Height="48"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10"/>
                        <TextBlock Text="暂无可用功能"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="请联系管理员分配相应权限"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>