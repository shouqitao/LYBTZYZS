<UserControl x:Class="LYBT.UI.WPF.Views.Components.WelcomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LYBT.UI.WPF.Converters"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 快速操作按钮样式 -->
        <Style x:Key="QuickAccessButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{DynamicResource MaterialDesign.ShadowDepth2}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{DynamicResource MaterialDesign.ShadowDepth4}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <materialDesign:Card Margin="10" Padding="20" materialDesign:ElevationAssist.Elevation="Dp4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 标题栏，包含用户信息和菜单 -->
                <RowDefinition Height="Auto"/>
                <!-- 欢迎信息 -->
                <RowDefinition Height="Auto"/>
                <!-- 快速操作 -->
                <RowDefinition Height="Auto"/>
                <!-- 引导信息 -->
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 - 整合了TopToolBar的功能 -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                    CornerRadius="10"
                    Padding="20,15"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：Logo和系统标题 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png"
                               Height="40"
                               Margin="0,0,15,0"
                               VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="凌隐宝堂中医诊所"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       FontFamily="微软雅黑"/>
                            <TextBlock Text="{Binding CurrentUserRole, StringFormat='当前角色：{0}'}"
                                       Foreground="White"
                                       FontSize="11"
                                       Opacity="0.8"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间：时间显示 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentDateTime}"
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- 右侧：用户菜单 -->
                    <materialDesign:PopupBox Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            StaysOpen="False"
                                            PlacementMode="BottomAndAlignRightEdges">
                        <materialDesign:PopupBox.ToggleContent>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCircle" 
                                                        Width="28" Height="28"/>
                                <materialDesign:PackIcon Kind="ChevronDown" 
                                                        Width="14" Height="14"
                                                        VerticalAlignment="Bottom"
                                                        Margin="-6,0,0,6"/>
                            </StackPanel>
                        </materialDesign:PopupBox.ToggleContent>
                        <materialDesign:PopupBox.PopupContent>
                            <StackPanel MinWidth="200">
                                <!-- 用户信息显示 -->
                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                                        Padding="15,10"
                                        Margin="-8,-8,-8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentUserName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding CurrentUserRole}"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                                <!-- 功能菜单 -->
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="修改密码"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding ShowChangePasswordCommand}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Key" 
                                                                        Width="16" Height="16"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="修改信息"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding ShowChangeProfileCommand}"
                                        Visibility="{Binding IsNotSysAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountEdit" 
                                                                        Width="16" Height="16"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="{Binding DoctorProfileButtonText}"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding ShowDoctorProfileCommand}"
                                        Visibility="{Binding IsDoctorRole, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Doctor" 
                                                                        Width="16" Height="16"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Separator Margin="0,5"/>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="主题切换"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding ToggleThemeCommand}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Palette" 
                                                                        Width="16" Height="16"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="系统设置"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding SystemSettingsCommand}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Settings" 
                                                                        Width="16" Height="16"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="关于系统"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding AboutSystemCommand}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Information" 
                                                                        Width="16" Height="16"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>

                                <Separator Margin="0,5"/>

                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="退出登录"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding LogoutCommand}"
                                        Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ExitToApp" 
                                                                        Width="16" Height="16"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox.PopupContent>
                    </materialDesign:PopupBox>
                </Grid>
            </Border>

            <!-- 欢迎标题 -->
            <TextBlock Grid.Row="1"
                       Text="{Binding WelcomeMessage}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <!-- 快速操作区域 -->
            <Grid Grid.Row="2" 
                  Visibility="{Binding HasNavigationItems, Converter={StaticResource BoolToVisibilityConverter}}"
                  Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 快速操作按钮 -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource QuickAccessButtonStyle}"
                            Command="{Binding OpenNavMenuCommand}"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Menu" Width="24" Height="24"/>
                            <TextBlock Text="功能菜单" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource QuickAccessButtonStyle}"
                            Command="{Binding RefreshMenuCommand}"
                            Background="{DynamicResource MaterialDesign.Brush.Secondary}">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                            <TextBlock Text="刷新" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 状态信息 -->
                <StackPanel Grid.Column="1" 
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <TextBlock Text="系统状态"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="系统运行正常"
                               FontSize="14"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    <TextBlock Text="{Binding CurrentRoles.Count, StringFormat='当前角色数: {0} 个'}"
                               FontSize="11"
                               Opacity="0.6"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 首次使用引导 -->
            <Border Grid.Row="3"
                    Visibility="{Binding HasNavigationItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="LightbulbOnOutline" 
                                                Width="24" Height="24"
                                                Foreground="White"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>
                        <TextBlock Text="使用提示"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="当前用户暂无可用功能权限。请联系系统管理员为您分配相应的角色权限，以便使用系统功能。"
                               FontSize="14"
                               Foreground="White"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>