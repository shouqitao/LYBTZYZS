<UserControl x:Class="LYBT.UI.WPF.Views.Admin.UserManagementView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:prism="http://prismlibrary.com/"
              xmlns:helpers="clr-namespace:LYBT.UI.WPF.Extensions"
              xmlns:converters="clr-namespace:LYBT.UI.WPF.Converters"
              xmlns:controls="clr-namespace:LYBT.WPFControls;assembly=LYBT.WPFControls"
              prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 统一的样式定义 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF9800"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#F44336"/>
        </Style>

        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.1" ShadowDepth="2" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Foreground" Value="#777777"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" MinWidth="400"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1.8*" MinWidth="350"/>
        </Grid.ColumnDefinitions>

        <!-- 用户列表区域 -->
        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="用户管理" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- 操作按钮区域 -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="新增用户" 
                                Command="{Binding AddUserCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}">
                            <Button.ToolTip>
                                <ToolTip Content="添加新的系统用户"/>
                            </Button.ToolTip>
                        </Button>

                        <Button Content="编辑用户" 
                                Command="{Binding EditUserCommand}" 
                                Style="{StaticResource ModernButtonStyle}"
                                IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBoolConverter}}">
                            <Button.ToolTip>
                                <ToolTip Content="编辑选中用户的信息"/>
                            </Button.ToolTip>
                        </Button>

                        <Button Content="启用用户" 
                                Command="{Binding EnableUserCommand}" 
                                Style="{StaticResource SuccessButtonStyle}"
                                IsEnabled="{Binding CanEnableUser}">
                            <Button.ToolTip>
                                <ToolTip Content="启用选中的禁用用户"/>
                            </Button.ToolTip>
                        </Button>

                        <Button Content="禁用用户" 
                                Command="{Binding DisableUserCommand}" 
                                Style="{StaticResource WarningButtonStyle}"
                                IsEnabled="{Binding CanDisableUser}">
                            <Button.ToolTip>
                                <ToolTip Content="禁用选中用户的访问权限"/>
                            </Button.ToolTip>
                        </Button>

                        <Button Content="重置密码" 
                                Command="{Binding ResetPasswordCommand}" 
                                Style="{StaticResource DangerButtonStyle}"
                                IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBoolConverter}}">
                            <Button.ToolTip>
                                <ToolTip Content="重置用户登录密码"/>
                            </Button.ToolTip>
                        </Button>

                        <Button Content="创建医生档案" 
                                Command="{Binding CreateDoctorProfileCommand}" 
                                Style="{StaticResource ModernButtonStyle}"
                                IsEnabled="{Binding CanCreateDoctorProfile}">
                            <Button.ToolTip>
                                <ToolTip Content="为选中用户创建医生档案"/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 用户列表 -->
                <controls:UserListView Grid.Row="2"
                                     ItemsSource="{Binding Users}"
                                     SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                     SearchKeyword="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     SearchCommand="{Binding SearchCommand}"
                                     LoadPageCommand="{Binding LoadPageCommand}"
                                     IsBusy="{Binding IsBusy}">
                    <controls:UserListView.Columns>
                        <DataGridTextColumn Header="账号" Binding="{Binding UserName}" Width="*" MinWidth="100"/>
                        <DataGridTextColumn Header="姓名" Binding="{Binding RealName}" Width="*" MinWidth="80"/>
                        <DataGridTextColumn Header="角色" Width="*" MinWidth="100">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Roles" Converter="{StaticResource RoleListToStringConverter}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="状态" Binding="{Binding IsActive}" Width="60">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="最近登录" Binding="{Binding LastLoginTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140" MinWidth="140"/>
                        <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" Width="150" MinWidth="120"/>
                        <DataGridTextColumn Header="手机号" Binding="{Binding PhoneNumber}" Width="110" MinWidth="100"/>
                    </controls:UserListView.Columns>
                </controls:UserListView>
            </Grid>
        </Border>

        <!-- 用户详情/编辑区域 -->
        <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}" Padding="20">
            <controls:UserProfileView Title="{Binding EditModeTitle}"
                                       SaveCommand="{Binding SaveUserCommand}"
                                       CancelCommand="{Binding CancelCommand}"
                                       IsEditable="{Binding IsEditable}">
                <controls:UserProfileView.ProfileContent>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding EditModeTitle}" Style="{StaticResource SectionHeaderStyle}"/>

                            <!-- 基本信息分组 -->
                            <Expander Header="基本信息" IsExpanded="True" Margin="0,0,0,16">
                                <StackPanel Margin="16,8,0,0">
                                    <TextBlock Text="账号 *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditingUser.UserName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                             Style="{StaticResource FormInputStyle}"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"/>

                                    <TextBlock Text="姓名 *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditingUser.RealName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                             Style="{StaticResource FormInputStyle}"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"/>

                                    <TextBlock Text="拼音码" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditingUser.PinyinCode, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource FormInputStyle}"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"/>

                                    <CheckBox Content="启用用户" 
                                              IsChecked="{Binding EditingUser.IsActive}" 
                                              Margin="0,8,0,16" 
                                              IsEnabled="{Binding IsEditable}"
                                              FontSize="13"/>
                                </StackPanel>
                            </Expander>

                            <!-- 角色权限分组 -->
                            <Expander Header="角色权限" IsExpanded="True" Margin="0,0,0,16">
                                <StackPanel Margin="16,8,0,0">
                                    <TextBlock Text="用户角色" Style="{StaticResource FormLabelStyle}"/>

                                    <!-- 角色选择操作按钮 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" 
                                                Visibility="{Binding IsEditable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="全选" Command="{Binding SelectAllRolesCommand}" 
                                                Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="6,2"/>
                                        <Button Content="全不选" Command="{Binding SelectNoneRolesCommand}" 
                                                Style="{StaticResource ModernButtonStyle}" FontSize="11" Padding="6,2"/>
                                    </StackPanel>

                                    <!-- 角色选择列表 - 使用 ItemsControl 和角色选择项 -->
                                    <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="0,0,0,12" Background="White">
                                        <ItemsControl ItemsSource="{Binding RoleSelectionItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayName}" 
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="0,2" FontSize="13"
                                                              IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <CheckBox.ToolTip>
                                                            <ToolTip Content="{Binding Description}"/>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- 联系信息分组 -->
                            <Expander Header="联系信息" IsExpanded="True" Margin="0,0,0,16">
                                <StackPanel Margin="16,8,0,0">
                                    <TextBlock Text="邮箱地址" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditingUser.Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                             Style="{StaticResource FormInputStyle}"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"/>

                                    <TextBlock Text="手机号码" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding EditingUser.PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                             Style="{StaticResource FormInputStyle}"
                                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"/>
                                </StackPanel>
                            </Expander>

                            <!-- 安全信息分组 -->
                            <Expander Header="安全信息" IsExpanded="False" Margin="0,0,0,16">
                                <StackPanel Margin="16,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="登录失败次数：" FontWeight="Medium" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedUser.FailedLoginCount}" Margin="0,0,0,4"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="账号锁定状态：" FontWeight="Medium" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                            <TextBlock.Text>
                                                <Binding Path="SelectedUser.LockoutEnd" Converter="{StaticResource LockoutStatusConverter}"/>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="锁定截止时间：" FontWeight="Medium" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedUser.LockoutEnd, StringFormat=yyyy-MM-dd HH:mm:ss}" Margin="0,0,0,4"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- 操作历史信息 -->
                            <Expander Header="操作信息" IsExpanded="False" Margin="0,0,0,16">
                                <StackPanel Margin="16,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="创建时间：" FontWeight="Medium" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedUser.CreatedTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Margin="0,0,0,4"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最近登录：" FontWeight="Medium" Margin="0,0,8,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedUser.LastLoginTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Margin="0,0,0,4"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </controls:UserProfileView.ProfileContent>
            </controls:UserProfileView>
        </Border>
    </Grid>
</UserControl>