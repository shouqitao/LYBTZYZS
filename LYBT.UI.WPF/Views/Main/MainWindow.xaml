<Window x:Class="LYBT.UI.WPF.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LYBT.UI.WPF.Views.Main" 
        xmlns:converters="clr-namespace:LYBT.UI.WPF.Converters"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        Title="凌隐宝堂中医诊所" Height="450" Width="800"
         WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- 登录区域 -->
        <ContentControl prism:RegionManager.RegionName="LoginRegion"
                        Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <!-- 主界面区域 -->
        <DockPanel Visibility="{Binding IsMainVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Header -->
            <Border DockPanel.Dock="Top" Height="60" Background="#374151">
                <TextBlock Text="凌隐宝堂中医诊所" Foreground="White" FontSize="20" Margin="20,0,0,0"/>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 左侧导航 -->
                <StackPanel Grid.Column="0" Background="#F3F4F6">
                    <!-- 绑定你的导航菜单 -->
                </StackPanel>
                <!-- 右侧内容区 -->
                <ContentControl Grid.Column="1" prism:RegionManager.RegionName="ContentRegion"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
