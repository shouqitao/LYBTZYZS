<Window x:Class="LYBT.UI.WPF.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:converters="clr-namespace:LYBT.UI.WPF.Converters"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="凌隐宝堂中医诊所"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <!-- 登录区域（只用于登录，登录成功后隐藏） -->
        <ContentControl prism:RegionManager.RegionName="LoginRegion"
                        Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <!-- 主界面区域（登录后可见，初始隐藏） -->
        <DockPanel Visibility="{Binding IsMainVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 顶部Header -->
            <Border DockPanel.Dock="Top" Height="60" Background="#374151">
                <TextBlock Text="凌隐宝堂中医诊所" Foreground="White" FontSize="20" Margin="20,0,0,0"/>
            </Border>
            <!-- 主内容区域，加载 HomeView -->
            <ContentControl DockPanel.Dock="Bottom" prism:RegionManager.RegionName="MainContentRegion"/>
        </DockPanel>
    </Grid>
</Window>
