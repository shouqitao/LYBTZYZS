<Window x:Class="LYBT.UI.WPF.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="凌隐宝堂中医诊所"
        Icon="/Assets/icon.ico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid>
        <!-- 功能区：登录、修改密码等界面 -->
        <ContentControl prism:RegionManager.RegionName="FunctionRegion"
                        Visibility="{Binding IsFunctionVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <!-- 主界面区域（登录后可见，初始隐藏） -->
        <DockPanel Visibility="{Binding IsMainVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 顶部Header -->
            <Border DockPanel.Dock="Top" Height="100" Background="#2C3E50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Logo区域，假设logo图片为Images/logo.png -->
                    <Image Source="/Assets/logo.png"
               Height="70"
               Margin="20,0,10,0"
               VerticalAlignment="Center"/>
                    <!-- 标题 -->
                    <TextBlock Grid.Column="1"
                   Text="凌隐宝堂中医诊所"
                   Foreground="#FFD700"
                   FontSize="36"
                   FontWeight="Bold"
                   FontFamily="微软雅黑"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,0"/>
                    <!-- 右上角功能按钮 -->
                    <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,22,0">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="修改密码"
                    Width="100" Height="34"
                    Margin="0,0,10,0"
                    Command="{Binding ShowChangePasswordCommand}"
                    Background="#FF57606A" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="修改信息"
                    Width="100" Height="34"
                    Margin="0,0,10,0"
                    Command="{Binding ShowChangeProfileCommand}"
                    Background="#FF57606A" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Visibility="{Binding IsNotSysAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="{Binding DoctorProfileButtonText}"
                    Width="120" Height="34"
                    Margin="0,0,10,0"
                    Visibility="{Binding IsDoctorRole, Converter={StaticResource BoolToVisibilityConverter}}"
                    Command="{Binding ShowDoctorProfileCommand}"
                    Background="#FF57606A" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"/>
                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                Command="{Binding ToggleThemeCommand}"
                                Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="ThemeLightDark"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="退出登录"
                    Width="100" Height="34"
                    Command="{Binding LogoutCommand}"
                    Background="#FF57606A" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 主内容区域，加载 HomeView -->
            <ContentControl DockPanel.Dock="Bottom" prism:RegionManager.RegionName="MainContentRegion"/>
        </DockPanel>
    </Grid>
</Window>