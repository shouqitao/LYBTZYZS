<Window x:Class="LYBT.UI.WPF.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="凌隐宝堂中医诊所"
        Icon="/Assets/icon.ico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid>
        <!-- 功能区：登录、修改密码等界面 -->
        <ContentControl prism:RegionManager.RegionName="FunctionRegion"
                        Visibility="{Binding IsFunctionVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <!-- 主界面区域（登录后可见，初始隐藏） -->
        <DockPanel Visibility="{Binding IsMainVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 顶部Header -->
            <Border DockPanel.Dock="Top" Height="100" Background="#2C3E50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource MaterialDesignToolButton}"
                            Command="{Binding ToggleNavDrawerCommand}" 
                            Margin="10,0">
                        <materialDesign:PackIcon Kind="Menu"/>
                    </Button>
                    <!-- Logo区域，假设logo图片为Images/logo.png -->
                    <Image Grid.Column="1" Source="/Assets/logo.png"
               Height="70"
               Margin="20,0,10,0"
               VerticalAlignment="Center"/>
                    <!-- 标题 -->
                    <TextBlock Grid.Column="2"
                   Text="凌隐宝堂中医诊所"
                   Foreground="#FFD700"
                   FontSize="36"
                   FontWeight="Bold"
                   FontFamily="微软雅黑"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,0"/>
                    <!-- 右上角菜单按钮 -->
                    <materialDesign:PopupBox Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,22,0"
                                            StaysOpen="False"
                                            PopupPlacement="Bottom">
                        <materialDesign:PackIcon Kind="AccountCircle" />
                        <materialDesign:PopupBox.PopupContent>
                            <StackPanel Margin="8">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="修改密码"
                                        Command="{Binding ShowChangePasswordCommand}"/>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="修改信息"
                                        Command="{Binding ShowChangeProfileCommand}"
                                        Visibility="{Binding IsNotSysAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="{Binding DoctorProfileButtonText}"
                                        Command="{Binding ShowDoctorProfileCommand}"
                                        Visibility="{Binding IsDoctorRole, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="主题切换"
                                        Command="{Binding ToggleThemeCommand}"/>
                                <Separator Margin="0,4"/>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="退出登录"
                                        Command="{Binding LogoutCommand}"/>
                            </StackPanel>
                        </materialDesign:PopupBox.PopupContent>
                    </materialDesign:PopupBox>
                </Grid>
            </Border>
            <!-- 主内容区域，加载 HomeView -->
            <ContentControl DockPanel.Dock="Bottom" prism:RegionManager.RegionName="MainContentRegion"/>
        </DockPanel>
    </Grid>
</Window>