<UserControl x:Class="LYBT.UI.WPF.Views.Main.DoctorProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 输入框样式 -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,16,12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 只读输入框样式 -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.Background}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- 下拉框样式 -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,16,12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 日期选择器样式 -->
        <Style x:Key="FormDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,16,12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="FormButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <!-- 加载遮罩 -->
        <Border x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Margin="0,0,0,15"/>
                <TextBlock x:Name="LoadingMessageText"
                           Text="正在加载医生信息..."
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 主要内容 -->
        <materialDesign:Card Width="650"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Padding="32"
                             materialDesign:ElevationAssist.Elevation="Dp8">
            <StackPanel>
                <!-- 标题区域 -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                    <materialDesign:PackIcon Kind="Doctor"
                                             Width="28" Height="28"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding EditModeTitle}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                               VerticalAlignment="Center"/>

                    <!-- 编辑模式指示器 -->
                    <Border Background="{DynamicResource MaterialDesign.Brush.Secondary}"
                            CornerRadius="12"
                            Padding="8,4"
                            Margin="16,0,0,0"
                            Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="编辑模式"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- 医生信息区域 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列 -->
                        <StackPanel Grid.Column="0">
                            <!-- 账号 -->
                            <TextBox Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     Text="{Binding Doctor.UserName, Mode=OneWay}"
                                     materialDesign:HintAssist.Hint="账号"
                                     materialDesign:HintAssist.IsFloating="True"
                                     materialDesign:HintAssist.FloatingScale="0.75"
                                     materialDesign:HintAssist.FloatingOffset="0,-20"/>

                            <!-- 姓名 -->
                            <TextBox Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     Text="{Binding Doctor.RealName, Mode=OneWay}"
                                     materialDesign:HintAssist.Hint="姓名"
                                     materialDesign:HintAssist.IsFloating="True"
                                     materialDesign:HintAssist.FloatingScale="0.75"
                                     materialDesign:HintAssist.FloatingOffset="0,-20"/>

                            <!-- 联系号码 -->
                            <TextBox Text="{Binding Doctor.ContactNumber, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="联系号码"
                                     materialDesign:HintAssist.IsFloating="True"
                                     materialDesign:HintAssist.FloatingScale="0.75"
                                     materialDesign:HintAssist.FloatingOffset="0,-20"
                                     IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <!-- 性别 -->
                            <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding GenderList}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Text"
                                      SelectedValue="{Binding Doctor.Gender}"
                                      materialDesign:HintAssist.Hint="性别"
                                      materialDesign:HintAssist.IsFloating="True"
                                      materialDesign:HintAssist.FloatingScale="0.75"
                                      materialDesign:HintAssist.FloatingOffset="0,-20"
                                      IsEnabled="{Binding IsEditable}"/>

                            <!-- 出生日期 -->
                            <DatePicker Style="{StaticResource FormDatePickerStyle}"
                                        SelectedDate="{Binding Doctor.Birthday}"
                                        materialDesign:HintAssist.Hint="出生日期"
                                        materialDesign:HintAssist.IsFloating="True"
                                        materialDesign:HintAssist.FloatingScale="0.75"
                                        materialDesign:HintAssist.FloatingOffset="0,-20"
                                        IsEnabled="{Binding IsEditable}"/>
                        </StackPanel>

                        <!-- 右列 -->
                        <StackPanel Grid.Column="2">
                            <!-- 拼音码 -->
                            <TextBox Text="{Binding Doctor.PinyinCode, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="拼音码"
                                     materialDesign:HintAssist.IsFloating="True"
                                     materialDesign:HintAssist.FloatingScale="0.75"
                                     materialDesign:HintAssist.FloatingOffset="0,-20"
                                     materialDesign:HintAssist.HelperText="用于快速检索"
                                     IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <!-- 执业证号 -->
                            <TextBox Text="{Binding Doctor.LicenseNumber, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="执业证号"
                                     materialDesign:HintAssist.IsFloating="True"
                                     materialDesign:HintAssist.FloatingScale="0.75"
                                     materialDesign:HintAssist.FloatingOffset="0,-20"
                                     materialDesign:HintAssist.HelperText="医师执业证书编号"
                                     IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                     Style="{StaticResource FormTextBoxStyle}"/>

                            <!-- 职称 -->
                            <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding TitleList}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Text"
                                      SelectedValue="{Binding Doctor.Title}"
                                      materialDesign:HintAssist.Hint="职称"
                                      materialDesign:HintAssist.IsFloating="True"
                                      materialDesign:HintAssist.FloatingScale="0.75"
                                      materialDesign:HintAssist.FloatingOffset="0,-20"
                                      IsEnabled="{Binding IsEditable}"/>

                            <!-- 状态 -->
                            <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                      ItemsSource="{Binding StatusList}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Text"
                                      SelectedValue="{Binding Doctor.Status}"
                                      materialDesign:HintAssist.Hint="状态"
                                      materialDesign:HintAssist.IsFloating="True"
                                      materialDesign:HintAssist.FloatingScale="0.75"
                                      materialDesign:HintAssist.FloatingOffset="0,-20"
                                      IsEnabled="{Binding IsEditable}"/>

                            <!-- 备注 -->
                            <TextBox Text="{Binding Doctor.Remark, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="备注"
                                     materialDesign:HintAssist.IsFloating="True"
                                     materialDesign:HintAssist.FloatingScale="0.75"
                                     materialDesign:HintAssist.FloatingOffset="0,-20"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="100"
                                     VerticalContentAlignment="Top"
                                     Padding="12,20,12,8"
                                     IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Margin="0,0,0,20"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 错误信息显示 -->
                <Border Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,16,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle"
                                                 Width="16" Height="16"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 成功信息显示 -->
                <Border x:Name="SuccessMessageBorder"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle"
                                                 Width="16" Height="16"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="SuccessMessageText"
                                   Text="医生信息保存成功"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 按钮区域 -->
                <Grid Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 保存按钮 -->
                    <Button Grid.Column="0"
                            Style="{StaticResource FormButtonStyle}"
                            Content="保存修改"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            IsDefault="True">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" 
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- 取消按钮 -->
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="取消"
                            Command="{Binding CancelCommand}"
                            Height="42"
                            FontSize="14"
                            FontWeight="Medium"
                            IsCancel="True">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cancel" 
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>

                <!-- 只读模式的操作按钮 -->
                <Grid Visibility="{Binding IsEditable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="返回"
                            Command="{Binding CancelCommand}"
                            Height="42"
                            FontSize="14"
                            FontWeight="Medium"
                            HorizontalAlignment="Center"
                            Width="200">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" 
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>

                <!-- 信息说明 -->
                <Expander Header="字段说明" 
                          Margin="0,16,0,0"
                          materialDesign:ExpanderAssist.HorizontalHeaderPadding="0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 账号和姓名：系统生成，不可修改
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 联系号码：用于紧急联系，请确保准确
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 拼音码：用于快速检索，建议使用姓名拼音首字母
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 执业证号：医师执业证书编号，必须准确填写
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 状态：影响医师的系统访问权限
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>