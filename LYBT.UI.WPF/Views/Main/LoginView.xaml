<UserControl x:Class="LYBT.UI.WPF.Views.Main.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True"
             KeyDown="UserControl_KeyDown">
    <Grid>
        <!-- 背景图片层添加蒙版效果 -->
        <Image Source="/Assets/bg.jpg"
               Stretch="UniformToFill"
               Opacity="0.6"
               Panel.ZIndex="0"/>

        <!-- 加载遮罩层 -->
        <Border Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Margin="0,0,0,10"/>
                <TextBlock Text="{Binding LoadingText}"
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 登录卡片部分 -->
        <materialDesign:Card Width="780"
                Height="510"
                Background="#F9FAFB"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.8*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：Logo和名称 -->
                <Border Grid.Column="0"
                        Background="#F8F8EC"
                        CornerRadius="14,0,0,14">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/Assets/logo.png"
                                   Width="142" Height="175" Margin="0,0,0,22"/>
                            <TextBlock Text="凌隐宝堂中医诊所"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="LYBT TCM CLINIC"
                                       FontSize="14"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="©2024 凌隐宝堂中医诊所 All Rights Reserved."
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,20,0,10"/>
                    </Grid>
                </Border>

                <!-- 右侧：登录表单 -->
                <Grid Grid.Column="1" Background="Transparent">
                    <!-- 右上角退出按钮 - 修复后的样式 -->
                    <Button x:Name="BtnExit"
                            Width="32" Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Panel.ZIndex="5"
                            Content="✕"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#666666"
                            Background="#F0F0F0"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnExit_Click"
                            ToolTip="退出系统"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="16">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFE5E5"/>
                                        <Setter Property="BorderBrush" Value="#FF9999"/>
                                        <Setter Property="Foreground" Value="#CC0000"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFCCCC"/>
                                        <Setter Property="BorderBrush" Value="#FF6666"/>
                                        <Setter Property="Foreground" Value="#990000"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                        <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                        <Setter Property="Foreground" Value="#999999"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 登录表单内容 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="240" Margin="0,10,0,0">
                        <TextBlock Text="用户登录"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#333"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <!-- 用户名输入 -->
                        <TextBox x:Name="userNameBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="用户名"
                                 Margin="0,0,0,15"
                                 FontSize="13"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                        <!-- 密码输入 -->
                        <PasswordBox x:Name="passwordBox"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     materialDesign:HintAssist.Hint="密码"
                                     Margin="0,0,0,15"
                                     FontSize="13"
                                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                        <!-- 记住密码和清空按钮 -->
                        <DockPanel Margin="0,0,0,20">
                            <CheckBox x:Name="ChkRememberMe"
                                      IsChecked="{Binding IsRemember}"
                                      Content="记住密码"
                                      FontSize="12"
                                      DockPanel.Dock="Left"
                                      IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="清空"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    FontSize="12"
                                    DockPanel.Dock="Right"
                                    Cursor="Hand"
                                    Padding="5,2"/>
                        </DockPanel>

                        <!-- 登录按钮 -->
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" x:Name="BtnLogin"
                                Content="登 录"
                                Command="{Binding LoginCommand}"
                                Height="40"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#4CAF50"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,15"/>

                        <!-- 错误消息 -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#F44336"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>