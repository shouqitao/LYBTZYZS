<UserControl x:Class="LYBT.UI.WPF.Views.Main.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             KeyDown="UserControl_KeyDown">
    <Grid>
        <!-- 全屏背景图（根据你实际路径设置 Source） -->
        <Image Source="/Assets/bg.jpg"
               Stretch="UniformToFill"
               Opacity="0.6"
               Panel.ZIndex="0"/>

        <!-- 登录卡片区，垂直居中、带阴影 -->
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1">
            <Border Padding="32" MinWidth="380" MinHeight="430"
                    Background="#FAFAFAEE" CornerRadius="14"
                    BorderBrush="#CCCCCC" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.16" BlurRadius="18" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Logo -->
                    <Image Source="/Assets/logo.jpg" Height="60" Width="60"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="用户登录" FontWeight="Bold" FontSize="22"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- 用户名 -->
                    <TextBlock Text="用户名" Margin="0,0,0,4" FontSize="15"/>
                    <TextBox x:Name="userNameBox"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Height="32" FontSize="15" Margin="0,0,0,16" />

                    <!-- 密码 -->
                    <TextBlock Text="密码" Margin="0,0,0,4" FontSize="15"/>
                    <PasswordBox x:Name="passwordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Height="32" FontSize="15" Margin="0,0,0,20"/>

                    <!-- 记住密码 + 登录 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox Content="记住密码" IsChecked="{Binding IsRemember}" />
                    </StackPanel>
                    <Button Content="登录" Command="{Binding LoginCommand}" Height="38"
                            FontSize="16" Margin="0,0,0,14" Name="loginButton"/>

                    <!-- 错误消息 -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                               Margin="0,8,0,0" FontSize="14" TextWrapping="Wrap"/>

                    <!-- 版权 -->
                    <TextBlock Text="© 2024 凌隐宝堂中医诊所 All Rights Reserved."
                               Foreground="#888" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,32,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
