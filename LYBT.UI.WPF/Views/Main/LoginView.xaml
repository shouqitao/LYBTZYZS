<UserControl x:Class="LYBT.UI.WPF.Views.Main.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             KeyDown="UserControl_KeyDown">
    <Grid>
        <!-- 背景图片层保留原有实现 -->
        <Image Source="/Assets/bg.jpg"
               Stretch="UniformToFill"
               Panel.ZIndex="0"/>
        <Border Background="#A6FFFFFF" Panel.ZIndex="1"/>

        <!-- 登录卡片部分，只修改这块为左右结构 -->
        <Border Width="520"
                Height="340"
                CornerRadius="14"
                Background="#F9FAFB"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                >

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.8*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：Logo和名称 -->
                <Border Grid.Column="0"
                        Background="#19b5fe"
                        CornerRadius="14,0,0,14">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
                        <Image Source="/Assets/Logo.jpg"
                               Width="72" Height="72" Margin="0,0,0,22"/>
                        <TextBlock Text="凌隐宝堂中医诊所"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="LYBT TCM CLINIC"
                                   FontSize="14"
                                   Foreground="#F6F6F6"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 右侧：登录表单 -->
                <Grid Grid.Column="1" Background="Transparent">
                    <!-- 右上角退出按钮 -->
                    <Button x:Name="BtnExit"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0"
                            Content="✕"
                            FontSize="15"
                            Foreground="#B0B0B0"
                            Background="Transparent"
                            BorderBrush="{x:Null}"
                            Cursor="Hand"/>
                    <!-- 登录表单内容 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="186">
                        <TextBlock Text="用户登录"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#222"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,19"/>
                        <TextBlock Text="用户名"
                                   FontSize="12"
                                   Margin="2,0,0,2"
                                   Foreground="#707070"/>
                        <TextBox x:Name="userNameBox"
                                 Height="30"
                                 Margin="0,0,0,7"
                                 FontSize="13"
                                 Padding="6"
                                 BorderBrush="#19b5fe"
                                 BorderThickness="1"
                                 Background="#F4F5F7"/>
                        <TextBlock Text="密码"
                                   FontSize="12"
                                   Margin="2,0,0,2"
                                   Foreground="#707070"/>
                        <PasswordBox x:Name="passwordBox"
                                     Height="30"
                                     Margin="0,0,0,7"
                                     FontSize="13"
                                     Padding="6"
                                     BorderBrush="#19b5fe"
                                     BorderThickness="1"
                                     Background="#F4F5F7"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkRememberMe"
                                      Content="记住密码"
                                      FontSize="12"
                                      Foreground="#888"/>
                        </StackPanel>
                        <Button x:Name="BtnLogin"
                                Content="登 录"
                                Height="32"
                                Margin="0,0,0,0"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#19b5fe"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
