<UserControl x:Class="LYBT.UI.WPF.Views.Main.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             KeyDown="UserControl_KeyDown">
    <Grid>
        <!-- 背景图片层添加蒙版效果 -->
        <Image Source="/Assets/bg.jpg"
               Stretch="UniformToFill"
               Opacity="0.6"
               Panel.ZIndex="0"/>

        <!-- 加载遮罩层 -->
        <Border Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Margin="0,0,0,10"/>
                <TextBlock Text="{Binding LoadingText}"
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 登录卡片部分 -->
        <Border Width="780"
                Height="510"
                CornerRadius="14"
                Background="#F9FAFB"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.8*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：Logo和名称 -->
                <Border Grid.Column="0"
                        Background="#F8F8EC"
                        CornerRadius="14,0,0,14">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/Assets/logo.png"
                                   Width="142" Height="175" Margin="0,0,0,22"/>
                            <TextBlock Text="凌隐宝堂中医诊所"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="LYBT TCM CLINIC"
                                       FontSize="14"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="©2024 凌隐宝堂中医诊所 All Rights Reserved."
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,20,0,10"/>
                    </Grid>
                </Border>

                <!-- 右侧：登录表单 -->
                <Grid Grid.Column="1" Background="Transparent">
                    <!-- 右上角退出按钮 -->
                    <Button x:Name="BtnExit"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0"
                            Content="✕"
                            FontSize="15"
                            Foreground="#B0B0B0"
                            Background="Transparent"
                            BorderBrush="{x:Null}"
                            Cursor="Hand"
                            Click="BtnExit_Click"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                    <!-- 登录表单内容 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200">
                        <TextBlock Text="用户登录"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#333"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <!-- 用户名输入 -->
                        <TextBlock Text="用户名"
                                   FontSize="12"
                                   Foreground="#666"
                                   Margin="2,0,0,5"/>
                        <TextBox x:Name="userNameBox"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35"
                                 Margin="0,0,0,15"
                                 FontSize="13"
                                 Padding="10,8"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Background="White"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                        <!-- 密码输入 -->
                        <TextBlock Text="密码"
                                   FontSize="12"
                                   Foreground="#666"
                                   Margin="2,0,0,5"/>
                        <PasswordBox x:Name="passwordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Height="35"
                                     Margin="0,0,0,15"
                                     FontSize="13"
                                     Padding="10,8"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1"
                                     Background="White"
                                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                        <!-- 记住密码和清空按钮 -->
                        <Grid Margin="0,0,0,20">
                            <CheckBox x:Name="ChkRememberMe"
                                      IsChecked="{Binding IsRemember}"
                                      Content="记住密码"
                                      FontSize="12"
                                      HorizontalAlignment="Left"
                                      IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="清空"
                                    Command="{Binding ClearCommand}"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#666"
                                    FontSize="12"
                                    Cursor="Hand"
                                    Padding="5,2"/>
                        </Grid>

                        <!-- 登录按钮 -->
                        <Button x:Name="BtnLogin"
                                Content="登 录"
                                Command="{Binding LoginCommand}"
                                Height="40"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#4CAF50"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,15">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#45A049"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#3E8E41"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#CCCCCC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 错误消息 -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#F44336"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
