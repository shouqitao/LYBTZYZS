<UserControl x:Class="LYBT.UI.WPF.Views.Main.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             KeyDown="UserControl_KeyDown">
    <Grid>
        <!-- 背景图片层添加蒙版效果，与其他页面保持一致 -->
        <Image Source="/Assets/bg.jpg"
               Stretch="UniformToFill"
               Opacity="0.6"
               Panel.ZIndex="0"/>


        <!-- 登录卡片部分，只修改这块为左右结构 -->
        <Border Width="780"
                Height="510"
                CornerRadius="14"
                Background="#F9FAFB"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                >

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.8*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：Logo和名称 -->
                <Border Grid.Column="0"
                        Background="#F8F8EC"
                        CornerRadius="14,0,0,14">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/Assets/logo.png"
                                   Width="142" Height="175" Margin="0,0,0,22"/>
                            <TextBlock Text="凌隐宝堂中医诊所"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="LYBT TCM CLINIC"
                                       FontSize="14"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="©2024 凌隐宝堂中医诊所 All Rights Reserved."
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,10"/>
                    </Grid>
                </Border>

                <!-- 右侧：登录表单 -->
                <Grid Grid.Column="1" Background="Transparent">
                    <!-- 右上角退出按钮 -->
                    <Button x:Name="BtnExit"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0"
                            Content="✕"
                            FontSize="15"
                            Foreground="#B0B0B0"
                            Background="Transparent"
                            BorderBrush="{x:Null}"
                            Cursor="Hand"
                            Click="BtnExit_Click"/>
                    <!-- 登录表单内容 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="186">
                        <TextBlock Text="用户登录"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#333"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,19"/>
                        <TextBlock Text="用户名"
                                   FontSize="12"
                                   Margin="2,0,0,2"/>
                        <TextBox x:Name="userNameBox"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"
                                 Margin="0,0,0,7"
                                 FontSize="13"
                                 Padding="6"
                                 BorderBrush="#F8F8EC"
                                 BorderThickness="1"
                                 Background="#F4F5F7"/>
                        <TextBlock Text="密码"
                                   FontSize="12"
                                   Margin="2,0,0,2"/>
                        <PasswordBox x:Name="passwordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Height="30"
                                     Margin="0,0,0,7"
                                     FontSize="13"
                                     Padding="6"
                                     BorderBrush="#F8F8EC"
                                     BorderThickness="1"
                                     Background="#F4F5F7"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkRememberMe"
                                      IsChecked="{Binding IsRemember}"
                                      Content="记住密码"
                                      FontSize="12"/>
                        </StackPanel>
                        <Button x:Name="BtnLogin"
                                Content="登 录"
                                Command="{Binding LoginCommand}"
                                Height="32"
                                Margin="0,0,0,0"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="Black"
                                Background="#F8F8EC"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
