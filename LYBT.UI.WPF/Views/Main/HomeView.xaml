<UserControl x:Class="LYBT.UI.WPF.Views.Main.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LYBT.UI.WPF.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 导航项样式 -->
        <Style x:Key="NavigationItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="DashboardCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}"/>
        </Style>

        <!-- 快速访问按钮样式 -->
        <Style x:Key="QuickAccessButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{DynamicResource MaterialDesign.ShadowDepth2}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{DynamicResource MaterialDesign.ShadowDepth4}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 主导航抽屉布局 -->
    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding DataContext.IsNavDrawerOpen, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" 
                               LeftDrawerCloseOnClickAway="True"
                               LeftDrawerCornerRadius="0,10,10,0">

        <!-- 左侧导航抽屉内容 -->
        <materialDesign:DrawerHost.LeftDrawerContent>
            <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                    BorderThickness="0,0,1,0"
                    Width="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10">
                    <StackPanel>
                        <!-- 导航头部 -->
                        <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                Margin="10,0,10,15"
                                CornerRadius="10"
                                Padding="15,10">
                            <StackPanel>
                                <TextBlock Text="功能导航"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NavigationCount, StringFormat='共 {0} 个功能模块'}"
                                           FontSize="11"
                                           Foreground="White"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 快速访问区域 -->
                        <Expander Header="快速访问" 
                                  IsExpanded="True"
                                  Margin="10,0,10,10">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QuickAccessItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <ItemsControl ItemsSource="{Binding QuickAccessItems}" Margin="5,5,5,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavigationItemStyle}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="{Binding Icon, FallbackValue=Circle}"
                                                                        Width="18" Height="18"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Kind="Star"
                                                                        Width="14" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        Margin="5,0,0,0"
                                                                        Foreground="Gold"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- 主要功能区域 -->
                        <Expander Header="主要功能" IsExpanded="True" Margin="10,0,10,10">
                            <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="5,5,5,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavigationItemStyle}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="{Binding Icon, FallbackValue=Circle}"
                                                                        Width="18" Height="18"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                                <materialDesign:PackIcon Kind="ChevronRight"
                                                                        Width="14" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        Margin="5,0,0,0"
                                                                        Opacity="0.6"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- 最近访问区域 -->
                        <Expander Header="最近访问" 
                                  IsExpanded="False" 
                                  Margin="10,0,10,10">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding RecentItems}" Margin="5,5,5,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NavigationItemStyle}"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="{Binding Icon, FallbackValue=Circle}"
                                                                            Width="16" Height="16"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,8,0"
                                                                            Opacity="0.7"/>
                                                    <TextBlock Text="{Binding DisplayName}" 
                                                               VerticalAlignment="Center"
                                                               FontSize="13"/>
                                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                                            Command="{Binding DataContext.AddToQuickAccessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="24" Height="24"
                                                            Margin="5,0,0,0"
                                                            ToolTip="添加到快速访问">
                                                        <materialDesign:PackIcon Kind="StarPlus" Width="12" Height="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="清除最近访问"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding ClearRecentCommand}"
                                        FontSize="11"
                                        Margin="5,5,5,0"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Expander>

                        <!-- 操作按钮区域 -->
                        <StackPanel Margin="15,20,15,10">
                            <Button Content="刷新菜单"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding RefreshMenuCommand}"
                                    Margin="0,0,0,10">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>

                        <!-- 空状态提示 -->
                        <Border Visibility="{Binding HasNavigationItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Background="{DynamicResource MaterialDesign.Brush.Background}"
                                Margin="20"
                                Padding="20"
                                CornerRadius="10">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="InformationOutline" 
                                                        Width="48" Height="48"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,10"/>
                                <TextBlock Text="暂无可用功能"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="请联系管理员分配相应权限"
                                           FontSize="12"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <!-- 主内容区域 -->
        <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 欢迎区域 -->
            <materialDesign:Card Grid.Row="0" Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <!-- 欢迎标题 -->
                    <TextBlock Text="{Binding WelcomeMessage}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <!-- 日期时间信息 -->
                    <TextBlock Text="{Binding CurrentDateTime}"
                               FontSize="16"
                               Opacity="0.8"
                               Margin="0,0,0,15"/>

                    <!-- 快速操作区域 -->
                    <Grid Visibility="{Binding HasNavigationItems, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 快速操作按钮 -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource QuickAccessButtonStyle}"
                                    Command="{Binding DataContext.ToggleNavDrawerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Menu" Width="24" Height="24"/>
                                    <TextBlock Text="功能菜单" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickAccessButtonStyle}"
                                    Command="{Binding RefreshMenuCommand}"
                                    Background="{DynamicResource MaterialDesign.Brush.Secondary}">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                                    <TextBlock Text="刷新" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- 显示加载中的快速操作 -->
                            <Button Style="{StaticResource QuickAccessButtonStyle}"
                                    IsEnabled="False"
                                    Background="Gray"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <ProgressBar IsIndeterminate="True" 
                                                 Width="24" Height="4"
                                                 Foreground="White"/>
                                    <TextBlock Text="加载中" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- 状态信息 -->
                        <StackPanel Grid.Column="1" 
                                    VerticalAlignment="Center"
                                    Margin="20,0,0,0">
                            <TextBlock Text="系统状态"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.7"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="14"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <TextBlock Text="{Binding NavigationCount, StringFormat='可用功能: {0} 个'}"
                                       FontSize="11"
                                       Opacity="0.6"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 首次使用引导 -->
                    <Border Visibility="{Binding HasNavigationItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="LightbulbOnOutline" 
                                                        Width="24" Height="24"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>
                                <TextBlock Text="使用提示"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="当前用户暂无可用功能权限。请联系系统管理员为您分配相应的角色权限，以便使用系统功能。"
                                       FontSize="14"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- 功能内容区域 -->
            <Border Grid.Row="1" 
                    Background="Transparent"
                    Margin="10,0,10,10">
                <ContentControl prism:RegionManager.RegionName="ContentRegion"
                                Background="{DynamicResource MaterialDesign.Brush.Background}"/>
            </Border>
        </Grid>
    </materialDesign:DrawerHost>
</UserControl>