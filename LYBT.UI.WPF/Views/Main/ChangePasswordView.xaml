<UserControl x:Class="LYBT.UI.WPF.Views.Main.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 输入框样式 -->
        <Style x:Key="FormPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,16,12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="FormButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <!-- 加载遮罩 -->
        <Border x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Margin="0,0,0,15"/>
                <TextBlock Text="正在修改密码..."
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 主要内容 -->
        <materialDesign:Card Width="480"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Padding="32"
                             materialDesign:ElevationAssist.Elevation="Dp8">
            <StackPanel>
                <!-- 标题区域 -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                    <materialDesign:PackIcon Kind="Key"
                                             Width="28" Height="28"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                    <TextBlock Text="修改密码"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 密码输入区域 -->
                <StackPanel>
                    <!-- 旧密码 -->
                    <PasswordBox x:Name="oldPasswordBox"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 materialDesign:HintAssist.Hint="请输入当前密码"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.FloatingScale="0.75"
                                 materialDesign:HintAssist.FloatingOffset="0,-20"
                                 PasswordChanged="OldPasswordBox_PasswordChanged"/>

                    <!-- 新密码 -->
                    <PasswordBox x:Name="newPasswordBox"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 materialDesign:HintAssist.Hint="请输入新密码"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.FloatingScale="0.75"
                                 materialDesign:HintAssist.FloatingOffset="0,-20"
                                 materialDesign:HintAssist.HelperText="密码长度6-20位，建议包含字母、数字和特殊字符"
                                 PasswordChanged="NewPasswordBox_PasswordChanged"/>

                    <!-- 确认新密码 -->
                    <PasswordBox x:Name="confirmPasswordBox"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 materialDesign:HintAssist.Hint="请再次输入新密码"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.FloatingScale="0.75"
                                 materialDesign:HintAssist.FloatingOffset="0,-20"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                 Margin="0,0,0,32"/>
                </StackPanel>

                <!-- 错误信息显示 -->
                <Border Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle"
                                                 Width="16" Height="16"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 成功信息显示 -->
                <Border x:Name="SuccessMessageBorder"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle"
                                                 Width="16" Height="16"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="SuccessMessageText"
                                   Text="密码修改成功"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 按钮区域 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 保存按钮 -->
                    <Button Grid.Column="0"
                            Style="{StaticResource FormButtonStyle}"
                            Content="保存修改"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            IsDefault="True">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" 
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- 取消按钮 -->
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="取消"
                            Command="{Binding CancelCommand}"
                            Height="42"
                            FontSize="14"
                            FontWeight="Medium"
                            IsCancel="True">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cancel" 
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>

                <!-- 密码强度提示 -->
                <Expander Header="密码安全建议" 
                          Margin="0,16,0,0"
                          materialDesign:ExpanderAssist.HorizontalHeaderPadding="0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 密码长度至少6位，建议8位以上
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 包含大小写字母、数字和特殊字符
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 避免使用常见密码或个人信息
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 定期更换密码以保证账户安全
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>