<UserControl x:Class="LYBT.UI.WPF.Views.Main.ChangeProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 输入框样式 -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ValidationError}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="FormButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <!-- 加载遮罩 -->
        <Border x:Name="LoadingOverlay"
                Background="#80000000"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Margin="0,0,0,15"/>
                <TextBlock Text="正在保存个人信息..."
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 主要内容 -->
        <materialDesign:Card Width="520"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Padding="32"
                             materialDesign:ElevationAssist.Elevation="Dp8">
            <StackPanel>
                <!-- 标题区域 -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,24">
                    <materialDesign:PackIcon Kind="AccountEdit"
                                             Width="28" Height="28"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                    <TextBlock Text="修改个人信息"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 输入区域 -->
                <StackPanel>
                    <!-- 姓名 -->
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding RealName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             materialDesign:HintAssist.Hint="真实姓名"
                             materialDesign:HintAssist.IsFloating="True"
                             materialDesign:HintAssist.HelperText="请输入您的真实姓名"/>

                    <!-- 邮箱 -->
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             materialDesign:HintAssist.Hint="电子邮箱"
                             materialDesign:HintAssist.IsFloating="True"
                             materialDesign:HintAssist.HelperText="请输入有效的电子邮箱地址"/>

                    <!-- 联系电话 -->
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             materialDesign:HintAssist.Hint="联系电话"
                             materialDesign:HintAssist.IsFloating="True"
                             materialDesign:HintAssist.HelperText="请输入有效的手机号码或固定电话"
                             Margin="0,0,0,24"/>
                </StackPanel>

                <!-- 错误信息显示 -->
                <Border Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle"
                                                 Width="16" Height="16"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 成功信息显示 -->
                <Border x:Name="SuccessMessageBorder"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle"
                                                 Width="16" Height="16"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="SuccessMessageText"
                                   Text="个人信息保存成功"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 验证信息展示 -->
                <Expander x:Name="ValidationStatusExpander"
                          Header="输入验证状态" 
                          Margin="0,0,0,16"
                          materialDesign:ExpanderAssist.HorizontalHeaderPadding="0"
                          Visibility="Collapsed">
                    <StackPanel Margin="0,8,0,0">
                        <!-- 姓名验证状态 -->
                        <StackPanel x:Name="RealNameValidationPanel" Orientation="Horizontal" Margin="0,2">
                            <materialDesign:PackIcon x:Name="RealNameValidationIcon"
                                                     Kind="Alert" 
                                                     Width="14" Height="14"
                                                     Foreground="Red"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="姓名格式" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RealNameValidationMessage"
                                       Text="未验证" 
                                       FontSize="12" 
                                       Margin="8,0,0,0"
                                       Foreground="Red"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 邮箱验证状态 -->
                        <StackPanel x:Name="EmailValidationPanel" Orientation="Horizontal" Margin="0,2">
                            <materialDesign:PackIcon x:Name="EmailValidationIcon"
                                                     Kind="Alert" 
                                                     Width="14" Height="14"
                                                     Foreground="Red"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="邮箱格式" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EmailValidationMessage"
                                       Text="未验证" 
                                       FontSize="12" 
                                       Margin="8,0,0,0"
                                       Foreground="Red"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 电话验证状态 -->
                        <StackPanel x:Name="PhoneValidationPanel" Orientation="Horizontal" Margin="0,2">
                            <materialDesign:PackIcon x:Name="PhoneValidationIcon"
                                                     Kind="Alert" 
                                                     Width="14" Height="14"
                                                     Foreground="Red"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="电话格式" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PhoneValidationMessage"
                                       Text="未验证" 
                                       FontSize="12" 
                                       Margin="8,0,0,0"
                                       Foreground="Red"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- 按钮区域 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 保存按钮 -->
                    <Button Grid.Column="0"
                            Style="{StaticResource FormButtonStyle}"
                            Content="保存修改"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}"
                            IsDefault="True">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" 
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- 取消按钮 -->
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="取消"
                            Command="{Binding CancelCommand}"
                            Height="42"
                            FontSize="14"
                            FontWeight="Medium"
                            IsCancel="True">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cancel" 
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>

                <!-- 填写说明 -->
                <Expander Header="填写说明" 
                          Margin="0,16,0,0"
                          materialDesign:ExpanderAssist.HorizontalHeaderPadding="0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 姓名：请填写真实姓名，用于身份识别
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 邮箱：用于接收系统通知和密码重置
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 电话：紧急联系方式，请确保号码有效
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7">
                            • 信息变更后请及时保存，避免数据丢失
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>