using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using LYBT.Module.Cashier.Interfaces;
using LYBT.Shared.Models.Common;
using LYBT.Shared.Models.Contracts.Cashier;

namespace LYBT.WebAPI.Controllers
{
    /// <summary>
    /// 收银控制器（替代BillingController）
    /// </summary>
    [Route("api/v1/[controller]")]
    [ApiController]
    [Authorize]
    public class CashierController : BaseController
    {
        private readonly ICashierService _cashierService;

        public CashierController(ICashierService cashierService)
        {
            _cashierService = cashierService;
        }

        /// <summary>
        /// 获取收费记录列表
        /// </summary>
        [HttpGet]
        public async Task<IActionResult> GetList()
        {
            var result = await _cashierService.GetListAsync();
            return Ok(result);
        }

        /// <summary>
        /// 分页获取收费记录列表
        /// </summary>
        [HttpGet("paged")]
        public async Task<IActionResult> GetPaged([FromQuery] PaginationRequest request)
        {
            var result = await _cashierService.GetPagedAsync(request);
            return Ok(result);
        }

        /// <summary>
        /// 获取收费详情
        /// </summary>
        [HttpGet("{id}")]
        public async Task<IActionResult> GetById(Guid id)
        {
            var result = await _cashierService.GetByIdAsync(id);
            if (result == null)
                return NotFound();
            return Ok(result);
        }

        /// <summary>
        /// 创建收费记录
        /// </summary>
        [HttpPost]
        public async Task<IActionResult> Create([FromBody] CashierCreateDto dto)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            var result = await _cashierService.CreateAsync(dto);
            return Ok(result);
        }

        /// <summary>
        /// 更新收费记录
        /// </summary>
        [HttpPut("{id}")]
        public async Task<IActionResult> Update(Guid id, [FromBody] CashierUpdateDto dto)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            var result = await _cashierService.UpdateAsync(id, dto);
            if (!result)
                return NotFound();
            
            return Ok(new { message = "收费记录更新成功" });
        }

        /// <summary>
        /// 作废收费记录
        /// </summary>
        [HttpPost("{id}/void")]
        public async Task<IActionResult> Void(Guid id, [FromBody] VoidRequestDto request)
        {
            var result = await _cashierService.VoidAsync(id, request.Reason);
            if (!result)
                return NotFound();
            
            return Ok(new { message = "收费记录已作废" });
        }

        /// <summary>
        /// 根据医疗案例ID获取收费记录
        /// </summary>
        [HttpGet("medical-case/{medicalCaseId}")]
        public async Task<IActionResult> GetByMedicalCaseId(Guid medicalCaseId)
        {
            var result = await _cashierService.GetByMedicalCaseIdAsync(medicalCaseId);
            if (result == null)
                return NotFound();
            return Ok(result);
        }

        /// <summary>
        /// 根据患者ID获取收费记录
        /// </summary>
        [HttpGet("patient/{patientId}")]
        public async Task<IActionResult> GetByPatientId(Guid patientId)
        {
            var result = await _cashierService.GetByPatientIdAsync(patientId);
            return Ok(result);
        }

        /// <summary>
        /// 获取今日收费记录
        /// </summary>
        [HttpGet("today")]
        public async Task<IActionResult> GetTodayBills()
        {
            var result = await _cashierService.GetTodayBillsAsync();
            return Ok(result);
        }

        /// <summary>
        /// 获取日期范围内的收费记录
        /// </summary>
        [HttpGet("date-range")]
        public async Task<IActionResult> GetByDateRange([FromQuery] DateTime startDate, [FromQuery] DateTime endDate)
        {
            var result = await _cashierService.GetByDateRangeAsync(startDate, endDate);
            return Ok(result);
        }

        /// <summary>
        /// 计算收费金额
        /// </summary>
        [HttpGet("calculate/{medicalCaseId}")]
        public async Task<IActionResult> CalculateAmount(Guid medicalCaseId)
        {
            var result = await _cashierService.CalculateAmountAsync(medicalCaseId);
            return Ok(new { amount = result });
        }

        /// <summary>
        /// 执行付款
        /// </summary>
        [HttpPost("{id}/payment")]
        public async Task<IActionResult> ProcessPayment(Guid id, [FromBody] PaymentDto payment)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            var result = await _cashierService.ProcessPaymentAsync(id, payment);
            if (!result.Success)
                return BadRequest(new { message = result.Message });
            
            return Ok(result);
        }

        /// <summary>
        /// 打印收费单据
        /// </summary>
        [HttpGet("{id}/print")]
        public async Task<IActionResult> PrintReceipt(Guid id)
        {
            var result = await _cashierService.PrintReceiptAsync(id);
            return File(result, "application/pdf", $"receipt_{id}.pdf");
        }

        /// <summary>
        /// 退费处理
        /// </summary>
        [HttpPost("{id}/refund")]
        public async Task<IActionResult> ProcessRefund(Guid id, [FromBody] RefundDto refund)
        {
            if (!ModelState.IsValid)
                return BadRequest(ModelState);

            var result = await _cashierService.ProcessRefundAsync(id, refund);
            if (!result.Success)
                return BadRequest(new { message = result.Message });
            
            return Ok(result);
        }

        /// <summary>
        /// 获取收费统计
        /// </summary>
        [HttpGet("statistics")]
        public async Task<IActionResult> GetStatistics([FromQuery] DateTime startDate, [FromQuery] DateTime endDate)
        {
            var result = await _cashierService.GetStatisticsAsync(startDate, endDate);
            return Ok(result);
        }
    }

    /// <summary>
    /// 作废请求DTO
    /// </summary>
    public class VoidRequestDto
    {
        public string Reason { get; set; } = string.Empty;
    }
}