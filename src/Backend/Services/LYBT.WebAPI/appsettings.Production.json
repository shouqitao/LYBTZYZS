{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=LYBTDB_Production;Integrated Security=true;TrustServerCertificate=true;"
  },
  "JwtOptions": {
    "Secret": "请替换为生产环境的强密钥-至少32个字符-建议使用随机生成的密钥",
    "Issuer": "LYBT.WebAPI",
    "Audience": "LYBT.Client",
    "ExpireMinutes": 480,
    "ClockSkewSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "LYBT.Infrastructure.Database.DatabaseInitializationService": "Information"
    }
  },
  "AllowedHosts": "*",
  "AuthOptions": {
    "MaxFailedLoginAttempts": 5,
    "AccountLockoutDuration": "00:30:00",
    "EnableDetailedLoginLogging": false
  },
  "UserOptions": {
    "DefaultUserPassword": "请设置更强的默认密码",
    "EnableUserCache": true,
    "MaxBatchOperationSize": 50,
    "EnableDetailedAuditLogging": false
  },
  "SysAdminOptions": {
    "DefaultPassword": "请设置强管理员密码",
    "RequirePasswordChangeOnFirstLogin": true,
    "EnableAccountLockout": true
  }
}