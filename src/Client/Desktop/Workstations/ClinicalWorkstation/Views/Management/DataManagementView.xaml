<UserControl x:Class="LYBT.Desktop.ClinicalWorkstation.Views.Management.DataManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="ManagementCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#DEE2E6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Padding" Value="20"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#007BFF"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#2C3E50"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="CardDescription" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#6C757D"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Background" Value="#007BFF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                   CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#0056B3"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- 标题 -->
                <TextBlock Text="数据管理中心" FontSize="24" FontWeight="Bold"
                          Foreground="#2C3E50" Margin="10,10,10,20"/>

                <!-- 管理卡片网格 -->
                <UniformGrid Columns="3">

                    <!-- 患者档案管理 -->
                    <Border Style="{StaticResource ManagementCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="👥" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="患者档案管理" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                管理患者基本信息、联系方式、过敏史等档案资料。支持新增、编辑、删除和查询患者信息。
                            </TextBlock>
                            <Button Content="进入管理"
                                   Style="{StaticResource ActionButton}"
                                   Command="{Binding NavigateToPatientsCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- 历史诊疗记录 -->
                    <Border Style="{StaticResource ManagementCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📋" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="历史诊疗记录" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                查看和管理所有历史诊疗记录，包括诊断信息、处方记录等。支持按患者、日期、诊断等条件查询。
                            </TextBlock>
                            <Button Content="查看记录"
                                   Style="{StaticResource ActionButton}"
                                   Command="{Binding NavigateToConsultationHistoryCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- 医疗案例库 -->
                    <Border Style="{StaticResource ManagementCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📚" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="医疗案例库" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                管理典型医疗案例，用于教学、研究和经验分享。可创建、编辑、分类管理医疗案例。
                            </TextBlock>
                            <Button Content="案例管理"
                                   Style="{StaticResource ActionButton}"
                                   Command="{Binding NavigateToMedicalCasesCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- 处方查询 -->
                    <Border Style="{StaticResource ManagementCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="💊" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="处方查询" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                查询历史处方记录，支持按患者、日期、药材等条件搜索。可导出处方清单和统计报表。
                            </TextBlock>
                            <Button Content="查询处方"
                                   Style="{StaticResource ActionButton}"
                                   Command="{Binding NavigateToPrescriptionQueryCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- 方剂模板 -->
                    <Border Style="{StaticResource ManagementCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📖" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="方剂模板库" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                管理常用方剂模板，包括经典方剂和自定义模板。提高开方效率，确保用药规范。
                            </TextBlock>
                            <Button Content="模板管理"
                                   Style="{StaticResource ActionButton}"
                                   Command="{Binding NavigateToFormulaTemplatesCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- 统计分析 -->
                    <Border Style="{StaticResource ManagementCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📊" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="统计分析" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}">
                                诊疗数据统计分析，包括患者统计、诊疗量统计、用药频率分析等数据报表。
                            </TextBlock>
                            <Button Content="查看统计"
                                   Style="{StaticResource ActionButton}"
                                   Command="{Binding NavigateToStatisticsCommand}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- 快速统计面板 -->
                <Border Background="White" CornerRadius="8" Margin="10,30,10,10" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 今日诊疗数 -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TodayConsultationCount}"
                                      FontSize="32" FontWeight="Bold" Foreground="#007BFF"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="今日诊疗" FontSize="14" Foreground="#6C757D"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 本周新增患者 -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding WeekNewPatientCount}"
                                      FontSize="32" FontWeight="Bold" Foreground="#28A745"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="本周新增" FontSize="14" Foreground="#6C757D"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 本月处方数 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MonthPrescriptionCount}"
                                      FontSize="32" FontWeight="Bold" Foreground="#FFC107"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="本月处方" FontSize="14" Foreground="#6C757D"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 总患者数 -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalPatientCount}"
                                      FontSize="32" FontWeight="Bold" Foreground="#6C757D"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="总患者数" FontSize="14" Foreground="#6C757D"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>