<UserControl x:Class="LYBT.Desktop.ClinicalWorkstation.Views.ClinicalWorkstationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- Issue #879: 移除重复标题栏，统一为侧边栏导航模式 -->
    <UserControl.Resources>
        <!-- 菜单按钮样式 -->
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F4F8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E86AB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航菜单 -->
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="诊疗功能" FontSize="16" FontWeight="Bold"
                               Foreground="#333" Margin="15,15,15,10"/>

                    <!-- 诊断录入 -->
                    <RadioButton GroupName="ClinicalMenu"
                                 IsChecked="{Binding IsDiagnosisSelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Diagnosis"
                                 Style="{StaticResource MenuRadioButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="诊断录入" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 处方开具 -->
                    <RadioButton GroupName="ClinicalMenu"
                                 IsChecked="{Binding IsPrescriptionSelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Prescription"
                                 Style="{StaticResource MenuRadioButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💊" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="处方开具" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 患者管理 -->
                    <Separator Margin="10,10"/>
                    <RadioButton GroupName="ClinicalMenu"
                                 IsChecked="{Binding IsPatientManagementSelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="PatientManagement"
                                 Style="{StaticResource MenuRadioButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏥" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="患者管理" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 历史记录 -->
                    <RadioButton GroupName="ClinicalMenu"
                                 IsChecked="{Binding IsHistorySelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="History"
                                 Style="{StaticResource MenuRadioButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📚" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="历史记录" FontSize="14"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="1" Background="White">
            <ContentControl prism:RegionManager.RegionName="ClinicalContentRegion"
                            Margin="20"/>
        </Border>
    </Grid>
</UserControl>
