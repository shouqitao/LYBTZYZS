<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 高对比度主题 - 自动适配系统高对比度模式 -->
    
    <Style x:Key="HighContrastDetector" TargetType="FrameworkElement">
        <Style.Triggers>
            <!-- 检测系统高对比度模式 -->
            <DataTrigger Binding="{x:Static SystemParameters.HighContrast}" Value="True">
                <!-- 启用高对比度色彩 -->
                <Setter Property="Tag" Value="HighContrast"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 高对比度色彩重写 -->
    <ResourceDictionary x:Key="HighContrastColors">
        <!-- 使用系统高对比度颜色 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="{x:Static SystemColors.HighlightColor}"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{x:Static SystemColors.HighlightColor}"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{x:Static SystemColors.HighlightColor}"/>
        
        <SolidColorBrush x:Key="BackgroundBrush" Color="{x:Static SystemColors.WindowColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{x:Static SystemColors.WindowColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{x:Static SystemColors.WindowColor}"/>
        
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
        <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
        
        <SolidColorBrush x:Key="BorderBrush" Color="{x:Static SystemColors.WindowFrameColor}"/>
        <SolidColorBrush x:Key="BorderFocusBrush" Color="{x:Static SystemColors.HighlightColor}"/>
        <SolidColorBrush x:Key="BorderErrorBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
        
        <SolidColorBrush x:Key="SuccessBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
    </ResourceDictionary>

    <!-- 高对比度时禁用阴影和圆角 -->
    <Style x:Key="HighContrastBorderStyle" TargetType="Border">
        <Style.Triggers>
            <DataTrigger Binding="{x:Static SystemParameters.HighContrast}" Value="True">
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>