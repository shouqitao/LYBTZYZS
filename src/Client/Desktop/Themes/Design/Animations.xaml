<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ====================================== -->
    <!-- 凌隐宝堂 动画系统 -->
    <!-- ====================================== -->
    
    <!-- 缓动函数 -->
    <PowerEase x:Key="EaseOut" EasingMode="EaseOut" Power="2"/>
    <PowerEase x:Key="EaseIn" EasingMode="EaseIn" Power="2"/>
    <PowerEase x:Key="EaseInOut" EasingMode="EaseInOut" Power="2"/>
    <BackEase x:Key="EaseBack" EasingMode="EaseOut" Amplitude="0.5"/>
    <ElasticEase x:Key="EaseElastic" EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
    <BounceEase x:Key="EaseBounce" EasingMode="EaseOut" Bounces="2" Bounciness="2"/>
    <CircleEase x:Key="EaseCircle" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseCubic" EasingMode="EaseInOut"/>
    
    <!-- ====================================== -->
    <!-- 淡入淡出动画 -->
    <!-- ====================================== -->
    
    <!-- 淡入 -->
    <Storyboard x:Key="FadeInStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- 淡出 -->
    <Storyboard x:Key="FadeOutStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="1" To="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- 淡入并上移 -->
    <Storyboard x:Key="FadeInUpStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
            From="20" To="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- ====================================== -->
    <!-- 缩放动画 -->
    <!-- ====================================== -->
    
    <!-- 放大进入 -->
    <Storyboard x:Key="ScaleInStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
            From="0.8" To="1"
            Duration="{StaticResource FastDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
            From="0.8" To="1"
            Duration="{StaticResource FastDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="{StaticResource FastDuration}"/>
    </Storyboard>
    
    <!-- 缩小退出 -->
    <Storyboard x:Key="ScaleOutStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
            From="1" To="0.8"
            Duration="{StaticResource FastDuration}"
            EasingFunction="{StaticResource EaseIn}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
            From="1" To="0.8"
            Duration="{StaticResource FastDuration}"
            EasingFunction="{StaticResource EaseIn}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="1" To="0"
            Duration="{StaticResource FastDuration}"/>
    </Storyboard>
    
    <!-- 脉冲效果 -->
    <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.05" EasingFunction="{StaticResource EaseInOut}"/>
            <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1" EasingFunction="{StaticResource EaseInOut}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.05" EasingFunction="{StaticResource EaseInOut}"/>
            <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1" EasingFunction="{StaticResource EaseInOut}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    
    <!-- ====================================== -->
    <!-- 滑动动画 -->
    <!-- ====================================== -->
    
    <!-- 从左滑入 -->
    <Storyboard x:Key="SlideInLeftStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
            From="-100" To="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="{StaticResource NormalDuration}"/>
    </Storyboard>
    
    <!-- 从右滑入 -->
    <Storyboard x:Key="SlideInRightStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
            From="100" To="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="{StaticResource NormalDuration}"/>
    </Storyboard>
    
    <!-- 从上滑入 -->
    <Storyboard x:Key="SlideInTopStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
            From="-50" To="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="{StaticResource NormalDuration}"/>
    </Storyboard>
    
    <!-- 从下滑入 -->
    <Storyboard x:Key="SlideInBottomStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
            From="50" To="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="{StaticResource NormalDuration}"/>
    </Storyboard>
    
    <!-- ====================================== -->
    <!-- 旋转动画 -->
    <!-- ====================================== -->
    
    <!-- 旋转进入 -->
    <Storyboard x:Key="RotateInStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
            From="-90" To="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="{StaticResource NormalDuration}"/>
    </Storyboard>
    
    <!-- 持续旋转（加载动画） -->
    <Storyboard x:Key="RotateForeverStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
            From="0" To="360"
            Duration="0:0:1.5"/>
    </Storyboard>
    
    <!-- ====================================== -->
    <!-- 抖动动画 -->
    <!-- ====================================== -->
    
    <!-- 水平抖动（错误提示） -->
    <Storyboard x:Key="ShakeStoryboard">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
            Duration="0:0:0.5">
            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-10"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="10"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="-10"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="10"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="-5"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="5"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="-2"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="2"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    
    <!-- ====================================== -->
    <!-- 涟漪效果（点击反馈） -->
    <!-- ====================================== -->
    
    <Storyboard x:Key="RippleStoryboard">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(Ellipse.Width)">
            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="100" EasingFunction="{StaticResource EaseOut}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(Ellipse.Height)">
            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="100" EasingFunction="{StaticResource EaseOut}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="Opacity">
            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.3"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    
    <!-- ====================================== -->
    <!-- 颜色动画 -->
    <!-- ====================================== -->
    
    <!-- 颜色渐变 -->
    <Storyboard x:Key="ColorChangeStoryboard">
        <ColorAnimation 
            Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseInOut}"/>
    </Storyboard>
    
    <!-- ====================================== -->
    <!-- 高度动画（展开/折叠） -->
    <!-- ====================================== -->
    
    <!-- 展开 -->
    <Storyboard x:Key="ExpandStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="Height"
            From="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- 折叠 -->
    <Storyboard x:Key="CollapseStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="Height"
            To="0"
            Duration="{StaticResource NormalDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
    <!-- ====================================== -->
    <!-- 阴影动画 -->
    <!-- ====================================== -->
    
    <!-- 阴影增强（悬浮效果） -->
    <Storyboard x:Key="ElevateStoryboard">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
            From="8" To="16"
            Duration="{StaticResource FastDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
            From="2" To="4"
            Duration="{StaticResource FastDuration}"
            EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>
    
</ResourceDictionary>