<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================== -->
    <!-- 凌隐宝堂 新中式极简主义 色彩系统 -->
    <!-- ====================================== -->

    <!-- 主色调 - 青绿色系（中医养生） -->
    <Color x:Key="PrimaryColor">#FF0FA968</Color>
    <Color x:Key="PrimaryLightColor">#FF3FBF85</Color>
    <Color x:Key="PrimaryDarkColor">#FF0B8050</Color>
    <Color x:Key="PrimaryForegroundColor">#FFFFFFFF</Color>

    <!-- 辅助色 - 暖棕色系（中药材） -->
    <Color x:Key="SecondaryColor">#FF8B6F47</Color>
    <Color x:Key="SecondaryLightColor">#FFA68B68</Color>
    <Color x:Key="SecondaryDarkColor">#FF6B5537</Color>
    <Color x:Key="SecondaryForegroundColor">#FFFFFFFF</Color>

    <!-- 强调色 - 朱红色系（印章/警示） -->
    <Color x:Key="AccentColor">#FFD2504A</Color>
    <Color x:Key="AccentLightColor">#FFE27570</Color>
    <Color x:Key="AccentDarkColor">#FFA23F3A</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>

    <!-- 背景色 - 灰白色系 -->
    <Color x:Key="BackgroundColor">#FFF8F9FA</Color>
    <Color x:Key="BackgroundLightColor">#FFFFFFFF</Color>
    <Color x:Key="BackgroundMediumColor">#FFF0F2F5</Color>
    <Color x:Key="BackgroundDarkColor">#FFE4E6EA</Color>

    <!-- 表面色 - 卡片/面板 -->
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceLightColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceMediumColor">#FFFAFBFC</Color>
    <Color x:Key="SurfaceDarkColor">#FFF5F6F8</Color>

    <!-- 文字色 - 墨色系 -->
    <Color x:Key="TextPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#FF606266</Color>
    <Color x:Key="TextTertiaryColor">#FF909399</Color>
    <Color x:Key="TextDisabledColor">#FFC0C4CC</Color>
    <Color x:Key="TextInverseColor">#FFFFFFFF</Color>

    <!-- 边框色 -->
    <Color x:Key="BorderLightColor">#FFE8EAEC</Color>
    <Color x:Key="BorderMediumColor">#FFDCDFE6</Color>
    <Color x:Key="BorderDarkColor">#FFC0C4CC</Color>

    <!-- 状态色 -->
    <Color x:Key="SuccessColor">#FF52C41A</Color>
    <Color x:Key="WarningColor">#FFFAAD14</Color>
    <Color x:Key="ErrorColor">#FFF5222D</Color>
    <Color x:Key="InfoColor">#FF1890FF</Color>

    <!-- 阴影色 -->
    <Color x:Key="ShadowColor">#1A000000</Color>
    <Color x:Key="ShadowLightColor">#0D000000</Color>
    <Color x:Key="ShadowMediumColor">#1A000000</Color>
    <Color x:Key="ShadowDarkColor">#33000000</Color>

    <!-- 覆盖层 -->
    <Color x:Key="OverlayColor">#66000000</Color>
    <Color x:Key="OverlayLightColor">#33000000</Color>
    <Color x:Key="OverlayDarkColor">#99000000</Color>

    <!-- ====================================== -->
    <!-- SolidColorBrush 画刷资源 -->
    <!-- ====================================== -->

    <!-- 主色画刷 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />

    <!-- 辅助色画刷 -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLightColor}" />
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDarkColor}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />

    <!-- 强调色画刷 -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />

    <!-- 背景画刷 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}" />
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMediumColor}" />
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDarkColor}" />

    <!-- 表面画刷 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}" />
    <SolidColorBrush x:Key="SurfaceMediumBrush" Color="{StaticResource SurfaceMediumColor}" />
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDarkColor}" />

    <!-- 文字画刷 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}" />

    <!-- 边框画刷 -->
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />

    <!-- 状态画刷 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- 阴影画刷 -->
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}" />
    <SolidColorBrush x:Key="ShadowLightBrush" Color="{StaticResource ShadowLightColor}" />
    <SolidColorBrush x:Key="ShadowMediumBrush" Color="{StaticResource ShadowMediumColor}" />
    <SolidColorBrush x:Key="ShadowDarkBrush" Color="{StaticResource ShadowDarkColor}" />

    <!-- 覆盖层画刷 -->
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="OverlayLightBrush" Color="{StaticResource OverlayLightColor}" />
    <SolidColorBrush x:Key="OverlayDarkBrush" Color="{StaticResource OverlayDarkColor}" />

    <!-- 透明画刷 -->
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- ====================================== -->
    <!-- 渐变画刷 -->
    <!-- ====================================== -->

    <!-- 主色渐变 -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0" />
        <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- 背景渐变 -->
    <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BackgroundLightColor}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- 卡片阴影效果 -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Color="{StaticResource ShadowLightColor}"
                      Opacity="0.3" />

    <DropShadowEffect x:Key="HoverShadowEffect"
                      BlurRadius="12"
                      ShadowDepth="4"
                      Direction="270"
                      Color="{StaticResource ShadowMediumColor}"
                      Opacity="0.4" />
</ResourceDictionary>
