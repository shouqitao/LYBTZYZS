<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 登录界面专用颜色系统 -->
    
    <!-- 浅色主题 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
            <!-- 品牌色彩 -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2E86AB"/>
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1F5F99"/>
            <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#164A7B"/>
            <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#CCCCCC"/>
            
            <!-- 语义色彩 -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#2196F3"/>
            
            <!-- 界面色彩 -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            
            <!-- 文本色彩 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
            <SolidColorBrush x:Key="TextHintBrush" Color="#999999"/>
            <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
            
            <!-- 边框色彩 -->
            <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="BorderFocusBrush" Color="#2E86AB"/>
            <SolidColorBrush x:Key="BorderErrorBrush" Color="#F44336"/>
            
            <!-- 阴影色彩 -->
            <Color x:Key="ShadowColor">#40000000</Color>
            <Color x:Key="OverlayColor">#80000000</Color>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!-- 深色主题（高对比度时自动切换） -->
    <ResourceDictionary x:Key="DarkTheme">
        <!-- 品牌色彩 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#42A5F5"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1E88E5"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1976D2"/>
        
        <!-- 界面色彩 -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#121212"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2D2D30"/>
        
        <!-- 文本色彩 -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="TextHintBrush" Color="#808080"/>
        
        <!-- 边框色彩 -->
        <SolidColorBrush x:Key="BorderBrush" Color="#404040"/>
        <SolidColorBrush x:Key="BorderFocusBrush" Color="#42A5F5"/>
    </ResourceDictionary>

</ResourceDictionary>