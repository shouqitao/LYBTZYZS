<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 合并颜色资源 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Design/AdminColors.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <!-- 管理员工作台专用控件样式 -->
    
    <!-- 导航按钮样式 -->
    <Style x:Key="AdminNavigationButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AdminTextOnDarkBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>      <!-- 选中指示器 -->
                                <ColumnDefinition Width="36"/>     <!-- 图标 -->
                                <ColumnDefinition Width="*"/>      <!-- 文本 -->
                                <ColumnDefinition Width="Auto"/>   <!-- 徽章 -->
                                <ColumnDefinition Width="12"/>     <!-- 右边距 -->
                            </Grid.ColumnDefinitions>
                            
                            <!-- 选中指示器 -->
                            <Rectangle x:Name="SelectionIndicator"
                                       Grid.Column="0"
                                       Fill="{DynamicResource AdminInfoBrush}"
                                       Width="4"
                                       VerticalAlignment="Stretch"
                                       Opacity="0"
                                       RadiusX="2" RadiusY="2"/>
                            
                            <!-- 图标 -->
                            <TextBlock x:Name="IconText"
                                       Grid.Column="1"
                                       Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       UseLayoutRounding="True"/>
                            
                            <!-- 文本内容 -->
                            <TextBlock x:Name="ContentText"
                                       Grid.Column="2"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis"
                                       UseLayoutRounding="True"/>
                            
                            <!-- 徽章 -->
                            <Border x:Name="BadgeBorder"
                                    Grid.Column="3"
                                    Background="{DynamicResource AdminErrorBrush}"
                                    CornerRadius="12"
                                    Padding="8,2"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding BadgeText, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding BadgeText}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           UseLayoutRounding="True"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <!-- 鼠标悬停效果 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" 
                                    Value="{DynamicResource AdminNavItemHoverBrush}"/>
                            <Setter TargetName="IconText" Property="Foreground" 
                                    Value="White"/>
                            <Setter TargetName="ContentText" Property="Foreground" 
                                    Value="White"/>
                        </Trigger>
                        
                        <!-- 按下效果 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" 
                                    Value="{DynamicResource AdminNavItemActiveBrush}"/>
                        </Trigger>
                        
                        <!-- 选中状态 (通过Tag属性控制) -->
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="ButtonBorder" Property="Background" 
                                    Value="{DynamicResource AdminNavItemActiveBrush}"/>
                            <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        
                        <!-- 禁用状态 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        
                        <!-- 键盘焦点 -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" 
                                    Value="{DynamicResource AdminInfoBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" 
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
        <!-- 动画效果 -->
        <Style.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Duration="0:0:0.2" 
                                         Storyboard.TargetProperty="Opacity" 
                                         To="0.9"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Duration="0:0:0.2" 
                                         Storyboard.TargetProperty="Opacity" 
                                         To="1.0"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
    
    <!-- 分隔符样式 -->
    <Style x:Key="AdminNavigationSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource AdminNavSeparatorBrush}"/>
        <Setter Property="Margin" Value="16,8"/>
        <Setter Property="Opacity" Value="0.3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    
    <!-- 工具栏按钮样式 -->
    <Style x:Key="AdminToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AdminInfoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          UseLayoutRounding="True"/>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AdminPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AdminPrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource AdminTextMutedBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- 次要工具栏按钮样式 -->
    <Style x:Key="AdminSecondaryToolbarButtonStyle" TargetType="Button" 
           BasedOn="{StaticResource AdminToolbarButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AdminTextMutedBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AdminSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AdminSecondaryDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- 标题样式 -->
    <Style x:Key="AdminWorkbenchTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    
    <!-- 面包屑导航样式 -->
    <Style x:Key="AdminBreadcrumbStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AdminTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    
    <!-- 内容区域样式 -->
    <Style x:Key="AdminContentAreaStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource AdminBackgroundBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    
    <!-- 加载指示器样式 -->
    <Style x:Key="AdminLoadingStyle" TargetType="Grid">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="Black" Opacity="0.3"/>
            </Setter.Value>
        </Setter>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    
</ResourceDictionary>