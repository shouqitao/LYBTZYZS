<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 引入依赖资源 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Design/Colors.xaml"/>
        <ResourceDictionary Source="../Design/Typography.xaml"/>
        <ResourceDictionary Source="../Design/Spacing.xaml"/>
        <ResourceDictionary Source="../Design/Animations.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <!-- ====================================== -->
    <!-- 现代输入框样式 -->
    <!-- ====================================== -->
    
    <!-- 基础TextBox模板 -->
    <ControlTemplate x:Key="ModernTextBoxTemplate" TargetType="TextBox">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 浮动标签 -->
            <TextBlock x:Name="FloatingLabel"
                       Grid.Row="0"
                       Text="{TemplateBinding Tag}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSM}"
                       Margin="0,0,0,4"
                       Visibility="Collapsed"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            
            <!-- 输入区域 -->
            <Border x:Name="BorderElement"
                    Grid.Row="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0,0,0,1.5"
                    CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 前置图标 -->
                    <ContentPresenter x:Name="PrefixIcon"
                                      Grid.Column="0"
                                      Content="{TemplateBinding Tag}"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                    
                    <!-- 占位符 -->
                    <TextBlock x:Name="PlaceholderText"
                               Grid.Column="1"
                               Text="{TemplateBinding Tag}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="{TemplateBinding FontSize}"
                               Margin="{TemplateBinding Padding}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, 
                                           Converter={StaticResource StringToVisibilityConverter}}"/>
                    
                    <!-- 输入框 -->
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Grid.Column="1"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"/>
                    
                    <!-- 清除按钮 -->
                    <Button x:Name="ClearButton"
                            Grid.Column="2"
                            Width="20" Height="20"
                            Margin="4,0,0,0"
                            Style="{StaticResource IconButton}"
                            Visibility="Collapsed"
                            Opacity="0">
                        <TextBlock Text="&#xE10A;" 
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="12"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- 底部线条动画 -->
            <Rectangle x:Name="FocusLine"
                       Grid.Row="1"
                       Height="2"
                       Fill="{DynamicResource PrimaryBrush}"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Left"
                       Width="0"/>
            
            <!-- 帮助文本/错误提示 -->
            <TextBlock x:Name="HelperText"
                       Grid.Row="2"
                       Text=""
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeXS}"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </Grid>
        
        <ControlTemplate.Triggers>
            <!-- 有文本时显示清除按钮 -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Text" Value=""/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ClearButton"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearButton"
                                                            Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ClearButton"
                                                            Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="ClearButton"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            
            <!-- 获得焦点 -->
            <Trigger Property="IsFocused" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 底部线条展开 -->
                            <DoubleAnimation Storyboard.TargetName="FocusLine"
                                             Storyboard.TargetProperty="Width"
                                             To="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- 标签上浮 -->
                            <DoubleAnimation Storyboard.TargetName="FloatingLabel"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="FloatingLabel"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.2"/>
                            <!-- 占位符淡出 -->
                            <DoubleAnimation Storyboard.TargetName="PlaceholderText"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- 底部线条收缩 -->
                            <DoubleAnimation Storyboard.TargetName="FocusLine"
                                             Storyboard.TargetProperty="Width"
                                             To="0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseIn"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <!-- 标签下沉（如果没有文本） -->
                            <DoubleAnimation Storyboard.TargetName="FloatingLabel"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="FloatingLabel"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="20" Duration="0:0:0.2"/>
                            <!-- 占位符淡入 -->
                            <DoubleAnimation Storyboard.TargetName="PlaceholderText"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            
            <!-- 鼠标悬浮 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BorderElement" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
            </Trigger>
            
            <!-- 禁用状态 -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
                <Setter TargetName="BorderElement" Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
            </Trigger>
            
            <!-- 只读状态 -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="BorderElement" Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    
    <!-- ====================================== -->
    <!-- TextBox样式 -->
    <!-- ====================================== -->
    
    <!-- 标准TextBox -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
        <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.3"/>
        <Setter Property="Template" Value="{StaticResource ModernTextBoxTemplate}"/>
    </Style>
    
    <!-- 轮廓TextBox（带边框） -->
    <Style x:Key="OutlinedTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource InputCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                                
                                <!-- 占位符 -->
                                <TextBlock x:Name="PlaceholderText"
                                           Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="BorderElement" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- 填充TextBox（带背景） -->
    <Style x:Key="FilledTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource InputCornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        
                        <!-- 底部聚焦线 -->
                        <Rectangle x:Name="FocusLine"
                                   Height="2"
                                   Fill="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Visibility="Collapsed"/>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BorderElement" Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- 搜索框 -->
    <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource OutlinedTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CornerRadiusFull}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- 搜索图标 -->
                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="12,0,8,0"
                                           VerticalAlignment="Center"/>
                                
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              Margin="0,8"
                                              VerticalAlignment="Center"/>
                                
                                <!-- 清除按钮 -->
                                <Button Grid.Column="2"
                                        x:Name="ClearButton"
                                        Width="32" Height="32"
                                        Margin="4,0,4,0"
                                        Style="{StaticResource IconButton}"
                                        Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, 
                                                     Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="&#xE10A;" 
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="12"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>