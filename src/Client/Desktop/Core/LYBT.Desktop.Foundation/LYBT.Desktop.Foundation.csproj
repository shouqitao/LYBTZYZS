<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Foundation</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 技术基础设施层 | HTTP、缓存、配置、安全、性能、诊断 | Issue #1114 Phase 1</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0-foundation</InformationalVersion>

    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Foundation</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT Desktop技术基础设施 - HTTP客户端、缓存、配置、安全、性能、诊断服务</PackageDescription>
    <PackageTags>Foundation;HTTP;Cache;Configuration;Security;Performance;Diagnostics;中医;诊所</PackageTags>
  </PropertyGroup>

  <!-- Test Access -->
  <ItemGroup Label="Internal Visibility">
    <InternalsVisibleTo Include="LYBT.Desktop.Foundation.Tests" />
  </ItemGroup>

  <!-- HTTP and Resilience -->
  <ItemGroup Label="HTTP Services">
    <PackageReference Include="Refit" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <!-- Prism Framework -->
  <ItemGroup Label="Prism Framework">
    <PackageReference Include="Prism.Core" />
  </ItemGroup>

  <!-- Configuration and Caching -->
  <ItemGroup Label="Configuration">
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

  <!-- Security -->
  <ItemGroup Label="Security">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Desktop Core">
    <ProjectReference Include="..\LYBT.Desktop.Contracts\LYBT.Desktop.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Utilities\LYBT.Shared.Utilities.csproj" />
    <!-- consolidate-exception-handling: 统一异常处理 -->
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.ExceptionHandling\LYBT.Shared.ExceptionHandling.csproj" />
  </ItemGroup>

</Project>
