    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT Desktop模型层 - ViewModels基类、对象映射、业务模型</PackageDescription>
    <PackageTags>Models;ViewModels;MVVM;Mapping;中医;诊所</PackageTags>
