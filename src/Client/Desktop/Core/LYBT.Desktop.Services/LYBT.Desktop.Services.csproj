<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Services</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 服务层 | API客户端、缓存、安全服务 | Issue #815 Phase 1</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-services</InformationalVersion>

    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Services</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT Desktop服务层 - HTTP客户端、缓存、安全服务、API封装</PackageDescription>
    <PackageTags>Services;API;HTTP;Cache;Security;中医;诊所</PackageTags>
  </PropertyGroup>

  <!-- Framework Dependencies -->
  <ItemGroup Label="Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="System.ComponentModel.Annotations" />
  </ItemGroup>

  <!-- HTTP and Resilience -->
  <ItemGroup Label="HTTP Services">
    <PackageReference Include="Refit" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <!-- Configuration and Caching -->
  <ItemGroup Label="Configuration">
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

  <!-- Security and Data -->
  <ItemGroup Label="Security">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- Object Mapping -->

  <!-- Project References -->
  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Interfaces\LYBT.Shared.Interfaces.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Utilities\LYBT.Shared.Utilities.csproj" />
  </ItemGroup>

</Project>