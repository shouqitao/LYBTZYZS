<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.LocalData</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 本地数据存储层 | SQL Server LocalDB + EF Core | OpenSpec: implement-local-mode</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2026</AssemblyCopyright>
  </PropertyGroup>

  <!-- EF Core SQL Server (LocalDB) -->
  <ItemGroup Label="Entity Framework">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Security -->
  <ItemGroup Label="Security">
    <PackageReference Include="BCrypt.Net-Next" />
  </ItemGroup>

  <!-- Mapping -->
  <ItemGroup Label="Mapping">
    <PackageReference Include="Riok.Mapperly" />
  </ItemGroup>

  <!-- Logging & Options -->
  <ItemGroup Label="Logging">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\..\..\Server\Core\LYBT.Entities\LYBT.Entities.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Validators\LYBT.Shared.Validators.csproj" />
    <ProjectReference Include="..\LYBT.Desktop.Contracts\LYBT.Desktop.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Configuration\LYBT.Shared.Configuration.csproj" />
  </ItemGroup>

</Project>
