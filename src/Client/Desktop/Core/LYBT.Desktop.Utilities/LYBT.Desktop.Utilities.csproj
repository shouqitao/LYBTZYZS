<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Utilities</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 桌面端工具类库 | Excel导入导出、通用工具</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-utilities</InformationalVersion>
  </PropertyGroup>

  <!-- Package References -->
  <ItemGroup Label="Excel Support">
    <PackageReference Include="NPOI" />
    <PackageReference Include="System.ComponentModel.Annotations" />
  </ItemGroup>

</Project>
