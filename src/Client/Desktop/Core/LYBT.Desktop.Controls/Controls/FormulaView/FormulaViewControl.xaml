<!--
    FormulaViewControl - 验方预览控件
    
    独立的验方预览控件，可在FormulaDetailView和FormulaImportDialog中复用
    通过DependencyProperty接收数据（使用object类型支持FormulaDetailModel和FormulaDetailDto）
    
    UI优化 (2025-12-16):
    - 采用多卡片分组布局，充分利用详情区域空间
    - 分为：基本信息、功效用法、药材组成、系统信息四个逻辑区域
    - 使用统一的DetailLabelStyle和DetailValueStyle样式
-->
<UserControl
    x:Class="LYBT.Desktop.Controls.Controls.FormulaView.FormulaViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters"
    x:Name="Root">

    <!--
        本地资源说明:
        - HerbTag 样式从 PreviewStyles.xaml 内联（全局已移除），供药材标签云使用
        - Detail 样式改用 MaterialDesign 内置 TextBlock 样式
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!--  药材标签容器样式  -->
            <Style x:Key="HerbTagStyle" TargetType="Border">
                <Setter Property="Background" Value="#E0F7FA" />
                <Setter Property="BorderBrush" Value="#5B8FA8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="MinWidth" Value="100" />
            </Style>

            <!--  药材名称文字样式  -->
            <Style x:Key="HerbTagNameStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  药材剂量文字样式  -->
            <Style x:Key="HerbTagDosageStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer DataContext="{Binding ElementName=Root}" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!--
                ========================================
                基本信息卡片
                ========================================
            -->
            <controls:InfoCard Title="基本信息" ShowTitle="True">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  验方名称  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="验方名称" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{Binding Formula.Name}" />

                        <!--  分类  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="分类" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{Binding Formula.Category, TargetNullValue='-'}" />

                        <!--  性味归经  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="性味归经" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            Text="{Binding Formula.Property, TargetNullValue='-'}"
                            TextWrapping="Wrap" />

                        <!--  药材数量  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="药材数量" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap">
                            <Run Text="{Binding Formula.HerbCount, Mode=OneWay}" />
                            <Run Text="味" />
                        </TextBlock>

                        <!--  状态  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="状态" />
                        <controls:StatusBadge
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Left"
                            Status="{Binding Formula.Status}" />
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!--
                ========================================
                功效用法卡片
                ========================================
            -->
            <controls:InfoCard
                Title="功效用法"
                Margin="0,12,0,0"
                ShowTitle="True">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  功效  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            Text="功效" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            Text="{Binding Formula.Effect, TargetNullValue='-'}"
                            TextWrapping="Wrap" />

                        <!--  用法  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            Text="用法" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            Text="{Binding Formula.Usage, TargetNullValue='-'}"
                            TextWrapping="Wrap" />

                        <!--  备注  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            Text="备注" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            Text="{Binding Formula.Remark, TargetNullValue='-'}"
                            TextWrapping="Wrap" />
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!--
                ========================================
                药材组成卡片
                ========================================
            -->
            <controls:InfoCard
                Title="药材组成"
                Margin="0,12,0,0"
                ShowTitle="True">
                <controls:InfoCard.Content>
                    <!--  药材列表 - 网格布局，一行4个  -->
                    <ItemsControl ItemsSource="{Binding Formula.Herbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource HerbTagStyle}">
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource HerbTagNameStyle}" Text="{Binding HerbName}" />
                                        <TextBlock Style="{DynamicResource HerbTagDosageStyle}" Text="{Binding Dosage, StringFormat={}{0}g}" />
                                        <!--  煎法显示（仅非默认时显示）  -->
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TcmOrangeBrush}"
                                            Visibility="{Binding DecocteMethod, Converter={x:Static converters:Cvt.DecocteMethodToVis}}">
                                            <TextBlock.Text>
                                                <Binding Converter="{x:Static converters:Cvt.EnumDesc}" Path="DecocteMethod" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!--
                ========================================
                系统信息卡片
                ========================================
            -->
            <controls:InfoCard
                Title="系统信息"
                Margin="0,12,0,0"
                ShowTitle="True"
                Visibility="{Binding ShowSystemInfo, Converter={x:Static converters:Cvt.BoolToVis}}">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  是否共享  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="是否共享" />
                        <controls:StatusBadge
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Left"
                            Status="{Binding Formula.IsShared}" />

                        <!--  来源  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="来源" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{Binding Formula.Source, TargetNullValue='-'}" />

                        <!--  创建时间  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="创建时间" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{Binding Formula.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}" />

                        <!--  更新时间  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Margin="0,8,8,8"
                            VerticalAlignment="Center"
                            Text="更新时间" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Margin="0,8,16,8"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Text="{Binding Formula.UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}" />
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
