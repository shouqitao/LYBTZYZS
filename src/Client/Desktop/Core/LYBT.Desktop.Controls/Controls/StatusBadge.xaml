<!--
    StatusBadge - 状态徽章控件

    功能：
    - 以彩色徽章形式显示状态
    - 支持多种预设状态类型（Enabled/Disabled/Active/Inactive等）
    - 支持自定义颜色

    使用方式：
    <controls:StatusBadge Status="{Binding Status}"/>
    <controls:StatusBadge Status="Enabled"/>
    <controls:StatusBadge StatusText="自定义" BadgeType="Success"/>-->
<UserControl
    x:Class="LYBT.Desktop.Controls.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <!--
        资源加载说明:
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 徽章颜色资源已移至 App 级主题字典（Themes/Surfaces.xaml），由代码后置解析并随亮/暗主题切换
    -->

    <Border
        x:Name="BadgeBorder"
        MinWidth="48"
        Padding="8,4"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Background="{Binding BadgeBackground, ElementName=Root}"
        CornerRadius="4">
        <TextBlock
            x:Name="BadgeText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="Medium"
            Foreground="{Binding BadgeForeground, ElementName=Root}"
            Text="{Binding DisplayText, ElementName=Root}" />
    </Border>
</UserControl>
