<!--
    StatusBadge - 状态徽章控件

    功能：
    - 以彩色徽章形式显示状态
    - 支持多种预设状态类型（Enabled/Disabled/Active/Inactive等）
    - 支持自定义颜色

    使用方式：
    <controls:StatusBadge Status="{Binding Status}"/>
    <controls:StatusBadge Status="Enabled"/>
    <controls:StatusBadge StatusText="自定义" BadgeType="Success"/>-->
<UserControl
    x:Class="LYBT.Desktop.Controls.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <!--
        资源加载说明:
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 仅保留本地定义的徽章颜色资源
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!--  状态徽章颜色 - 使用主题资源  -->
            <SolidColorBrush x:Key="BadgeSuccessBackground" Color="#E8F5E9" />
            <SolidColorBrush x:Key="BadgeSuccessForeground" Color="#228B22" />
            <SolidColorBrush x:Key="BadgeDangerBackground" Color="#FDE7E9" />
            <SolidColorBrush x:Key="BadgeDangerForeground" Color="#A4262C" />
            <SolidColorBrush x:Key="BadgeWarningBackground" Color="#FFF8E1" />
            <SolidColorBrush x:Key="BadgeWarningForeground" Color="#B8860B" />
            <SolidColorBrush x:Key="BadgeInfoBackground" Color="#E0F7FA" />
            <SolidColorBrush x:Key="BadgeInfoForeground" Color="#3D5A80" />
            <SolidColorBrush x:Key="BadgeNeutralBackground" Color="{DynamicResource SecondaryRegionColor}" />
            <SolidColorBrush x:Key="BadgeNeutralForeground" Color="#757575" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="BadgeBorder"
        MinWidth="48"
        Padding="8,4"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Background="{Binding BadgeBackground, ElementName=Root}"
        CornerRadius="4">
        <TextBlock
            x:Name="BadgeText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="Medium"
            Foreground="{Binding BadgeForeground, ElementName=Root}"
            Text="{Binding DisplayText, ElementName=Root}" />
    </Border>
</UserControl>
