<!--
    SidebarControl - 侧边栏控件 (UI/UX Redesign 2026-06-21)

    新布局：
    - Row 0: 汉堡按钮 + Logo
    - Row 1: 用户头像 + 姓名 + 角色
    - Row 2: 导航菜单 (ItemsControl bound to NavigationItemsSource)
    - Row 3: Spacer (*)
    - Row 4: 时钟 + API状态 + 连接模式
    - Row 5: 退出登录

    绑定：
    - NavigationItemsSource: ObservableCollection<NavigationItem>
    - ConnectionDisplay: string (远程/本地)
    - IsRemoteMode: bool (颜色编码)
-->
<UserControl
    x:Class="LYBT.Desktop.Controls.Controls.SidebarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters"
    xmlns:models="clr-namespace:LYBT.Desktop.Controls.Models"
    x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  侧边栏宽度转换器  -->
            <converters:BoolToDoubleConverter
                x:Key="BoolToSidebarWidthConverter"
                FalseValue="56"
                TrueValue="220" />

            <!--  导航菜单项样式  -->
            <Style x:Key="NavMenuItemStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="False">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  导航项数据模板  -->
            <DataTemplate DataType="{x:Type models:NavigationItem}">
                <Button
                    Command="{Binding Command}"
                    Style="{StaticResource NavMenuItemStyle}"
                    ToolTip="{Binding Title}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="20"
                            Height="20"
                            Data="{Binding IconData}"
                            Fill="{DynamicResource SidebarTextBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource SidebarTextBrush}"
                            Text="{Binding Title}"
                            Visibility="{Binding IsExpanded, ElementName=Root, Converter={x:Static converters:Cvt.BoolToVis}}" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Width="{Binding IsExpanded, ElementName=Root, Converter={StaticResource BoolToSidebarWidthConverter}}" Background="{DynamicResource SidebarBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Row 0: 汉堡按钮 + Logo  -->
                <RowDefinition Height="Auto" />
                <!--  Row 1: 用户信息  -->
                <RowDefinition Height="Auto" />
                <!--  Row 2: 分隔线  -->
                <RowDefinition Height="*" />
                <!--  Row 3: 导航菜单  -->
                <RowDefinition Height="Auto" />
                <!--  Row 4: 状态信息(时钟+API+模式)  -->
                <RowDefinition Height="Auto" />
                <!--  Row 5: 分隔线  -->
                <RowDefinition Height="Auto" />
                <!--  Row 6: 退出登录  -->
            </Grid.RowDefinitions>

            <!--  Row 0: 汉堡按钮 + Logo  -->
            <Button
                Grid.Row="0"
                Height="56"
                Command="{Binding ToggleCommand, ElementName=Root}"
                Style="{StaticResource NavMenuItemStyle}"
                ToolTip="展开/收缩 (Ctrl+M)">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Width="24"
                        Height="24"
                        Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
                        Fill="{DynamicResource SidebarTextBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource SidebarTextBrush}"
                        Text="凌隐宝堂"
                        Visibility="{Binding IsExpanded, ElementName=Root, Converter={x:Static converters:Cvt.BoolToVis}}" />
                </StackPanel>
            </Button>

            <!--  Row 1: 用户信息 (点击弹出菜单)  -->
            <Button
                x:Name="UserAvatarButton"
                Grid.Row="1"
                Cursor="Hand"
                ToolTip="个人设置"
                Click="OnUserAvatarClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="UserBorder" Padding="12,12" Background="Transparent">
                                        <ContentPresenter x:Name="ContentHost" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="UserBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="False">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Border Padding="12,12">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Background="{DynamicResource SidebarAvatarBrush}"
                            CornerRadius="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="False">
                                            <Setter Property="Width" Value="28" />
                                            <Setter Property="Height" Value="28" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SidebarTextBrush}"
                                Text="{Binding CurrentUser.RealName, ElementName=Root, Converter={x:Static converters:Cvt.FirstChar}}" />
                        </Border>
                        <StackPanel
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsExpanded, ElementName=Root, Converter={x:Static converters:Cvt.BoolToVis}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SidebarTextBrush}"
                                Text="{Binding CurrentUser.RealName, ElementName=Root}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource SidebarSecondaryTextBrush}"
                                Text="{Binding CurrentUser.Role, ElementName=Root, Converter={x:Static converters:Cvt.EnumDesc}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>

            <!--  Row 2: 分隔线  -->
            <Border
                Grid.Row="2"
                Height="1"
                Margin="12,0"
                Background="{DynamicResource SidebarDividerBrush}" />

            <!--  Row 3: 导航菜单 (ItemsControl bound to NavigationItemsSource)  -->
            <StackPanel Grid.Row="3" Margin="0,8">
                <ItemsControl ItemsSource="{Binding NavigationItemsSource, ElementName=Root}" />
            </StackPanel>

            <!--  Row 4: 状态信息(时钟+API+模式) - 仅展开时显示完整信息  -->
            <Border Grid.Row="4" Padding="8,6">
                <Grid>
                    <!--  收缩状态: 仅 API 状态指示器  -->
                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding IsExpanded, ElementName=Root, Converter={x:Static converters:Cvt.InverseBoolToVis}}">
                        <Border
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource SidebarBrush}"
                            CornerRadius="12"
                            ToolTip="{Binding ApiStatus, ElementName=Root, Converter={x:Static converters:Cvt.ApiStatusToText}}">
                            <Ellipse
                                Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{Binding ApiStatus, ElementName=Root, Converter={x:Static converters:Cvt.ApiStatusToColor}}" />
                        </Border>
                    </StackPanel>

                    <!--  展开状态: 水平布局(API+模式+时钟)  -->
                    <StackPanel Margin="4,0,0,0" Visibility="{Binding IsExpanded, ElementName=Root, Converter={x:Static converters:Cvt.BoolToVis}}">
                        <!--  API 状态  -->
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{Binding ApiStatus, ElementName=Root, Converter={x:Static converters:Cvt.ApiStatusToColor}}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource SidebarSecondaryTextBrush}"
                                Text="{Binding ApiStatus, ElementName=Root, Converter={x:Static converters:Cvt.ApiStatusToText}}" />
                        </StackPanel>
                        <!--  连接模式徽章  -->
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal" ToolTip="当前连接模式">
                            <Path
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,17L7,12L8.41,10.59L11,13.17V7H13V13.17L15.59,10.59L17,12L12,17Z"
                                Fill="{Binding IsRemoteMode, ElementName=Root, Converter={x:Static converters:Cvt.BoolToColor}, ConverterParameter=Green|OrangeRed}"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{Binding IsRemoteMode, ElementName=Root, Converter={x:Static converters:Cvt.BoolToColor}, ConverterParameter=Green|OrangeRed}"
                                Text="{Binding ConnectionDisplay, ElementName=Root}" />
                        </StackPanel>
                        <!--  时钟  -->
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"
                                Fill="{DynamicResource SidebarSecondaryTextBrush}"
                                Stretch="Uniform" />
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SidebarTextBrush}"
                                    Text="{Binding CurrentTime, ElementName=Root, StringFormat=HH:mm:ss}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource SidebarSecondaryTextBrush}"
                                    Text="{Binding CurrentTime, ElementName=Root, StringFormat=yyyy-MM-dd}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Row 5: 分割线  -->
            <Border
                Grid.Row="5"
                Height="1"
                Margin="12,0"
                Background="{DynamicResource SidebarDividerBrush}" />

            <!--  Row 6: 退出登录  -->
            <Border Grid.Row="6">
                <Button
                    Command="{Binding LogoutCommand, ElementName=Root}"
                    Style="{StaticResource NavMenuItemStyle}"
                    ToolTip="退出登录">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="20"
                            Height="20"
                            Data="{DynamicResource IconLogout}"
                            Fill="{DynamicResource DangerBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource DangerBrush}"
                            Text="退出登录"
                            Visibility="{Binding IsExpanded, ElementName=Root, Converter={x:Static converters:Cvt.BoolToVis}}" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>
