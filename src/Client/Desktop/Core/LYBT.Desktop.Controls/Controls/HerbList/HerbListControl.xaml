<UserControl
    x:Class="LYBT.Desktop.Controls.Controls.HerbList.HerbListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:herbItem="clr-namespace:LYBT.Desktop.Controls.Controls.HerbItem"
    xmlns:local="clr-namespace:LYBT.Desktop.Controls.Controls.HerbList"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="HerbItemStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="2" />
        </Style>
    </UserControl.Resources>

    <!--  x:Name="LayoutRoot" 用于内部DataContext绑定，避免覆盖UserControl的DataContext  -->
    <Border
        x:Name="LayoutRoot"
        Padding="4"
        Background="{DynamicResource MaterialDesignPaper}"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  药材列表区域：为 ItemsControl 提供自带 ScrollViewer 的模板（CanContentScroll=True），
                  使 ItemsPanel 中的 VirtualizingStackPanel 成为滚动宿主并真正参与虚拟化。
                  原先外层 ScrollViewer 会以无限高度测量列表，虚拟化声明实际无效，所有行均被实例化。  -->
            <ItemsControl
                x:Name="ItemsHost"
                Grid.Row="0"
                ItemContainerStyle="{StaticResource HerbItemStyle}"
                ItemsSource="{Binding Items}"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.ScrollUnit="Pixel"
                VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer
                            CanContentScroll="True"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <herbItem:HerbItemControl
                            AllHerbs="{Binding AllHerbs}"
                            DeleteRequested="OnHerbItemDeleteRequested"
                            IsEditMode="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:HerbListControl}}, Path=IsEditMode}"
                            ItemChanged="OnHerbItemChanged"
                            ItemIndex="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                            NextItemRequested="OnHerbItemNextRequested" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  底部操作栏(仅编辑模式显示)  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsEditMode, Converter={x:Static converters:Cvt.BoolToVis}}">
                <TextBlock
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}">
                    <Run Text="共" />
                    <Run
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Text="{Binding ValidItemCount, Mode=OneWay}" />
                    <Run Text="味药材" />
                </TextBlock>
                <Button
                    Padding="12,4"
                    Background="Transparent"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                    Command="{Binding SortByRoleCommand}"
                    Content="按角色排序"
                    Cursor="Hand"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Button
                    Margin="8,0,0,0"
                    Padding="12,4"
                    Background="Transparent"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Error}"
                    Command="{Binding ClearAllCommand}"
                    Content="清空全部"
                    Cursor="Hand"
                    Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
