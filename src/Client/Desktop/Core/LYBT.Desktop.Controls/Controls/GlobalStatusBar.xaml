<UserControl
    x:Class="LYBT.Desktop.Controls.Controls.GlobalStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LYBT.Desktop.Controls.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="28"
    mc:Ignorable="d">

    <!--
        GlobalStatusBar - 精简版 (UI Redesign 2026-06-21)

        仅保留两列:
        - 左: 加载指示器 + 状态消息
        - 右: 版本号

        时钟/用户名/API状态/连接URL 已迁移到 SidebarControl
    -->
    <Border
        Background="{DynamicResource RegionBrush}"
        BorderBrush="{DynamicResource BorderLightBrush}"
        BorderThickness="0,1,0,0">
        <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  左: 加载指示器 + 状态消息  -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Ellipse
                    x:Name="LoadingEllipse"
                    Width="14"
                    Height="14"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5"
                    Stroke="{DynamicResource SuccessBrush}"
                    StrokeDashArray="8 4"
                    StrokeThickness="2"
                    Visibility="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>

            <!--  右: 版本号  -->
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource ThirdlyTextBrush}"
                Text="{Binding AppVersion, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=v{0}}" />
        </Grid>
    </Border>
</UserControl>
