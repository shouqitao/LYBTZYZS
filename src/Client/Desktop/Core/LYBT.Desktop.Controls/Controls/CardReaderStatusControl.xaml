<!--
    CardReaderStatusControl - 读卡器状态控件

    功能：
    - 显示读卡器连接状态
    - 提供手动读卡按钮
    - 支持自动读卡模式开关
    - 显示读卡进度和结果

    使用方式：
    <controls:CardReaderStatusControl
        IsConnected="{Binding IsCardReaderConnected}"
        IsAutoReadEnabled="{Binding IsAutoReadEnabled}"
        IsReading="{Binding IsReading}"
        StatusMessage="{Binding CardReaderStatusMessage}"
        ReadCardCommand="{Binding ReadCardCommand}"
        ToggleAutoReadCommand="{Binding ToggleAutoReadCommand}"/>-->
<UserControl
    x:Class="LYBT.Desktop.Controls.Controls.CardReaderStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="60"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  卡片背景 - 使用主题资源  -->
            <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource SecondaryRegionColor}" />
            <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Padding="12,8"
        Background="{StaticResource CardBackground}"
        BorderBrush="{StaticResource CardBorder}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  状态指示器  -->
            <StackPanel
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  连接状态点  -->
                <Ellipse
                    Width="10"
                    Height="10"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.Outline}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=Root}" Value="True">
                                    <Setter Property="Fill" Value="#228B22" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReading, ElementName=Root}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!--  读卡器图标  -->
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="20"
                    Text="&#xE8EA;">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Outline}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="#228B22" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!--  状态信息  -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="{Binding StatusMessage, ElementName=Root, FallbackValue=读卡器未连接}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=Root}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!--  自动读卡开关  -->
            <StackPanel
                Grid.Column="2"
                Margin="8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                    Text="自动" />
                <ToggleButton
                    x:Name="AutoReadToggle"
                    Command="{Binding ToggleAutoReadCommand, ElementName=Root}"
                    Cursor="Hand"
                    IsChecked="{Binding IsAutoReadEnabled, ElementName=Root, Mode=TwoWay}"
                    IsEnabled="{Binding IsConnected, ElementName=Root}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>

            <!--  手动读卡按钮  -->
            <Button
                Grid.Column="3"
                Padding="12,6"
                Command="{Binding ReadCardCommand, ElementName=Root}"
                Cursor="Hand"
                IsEnabled="{Binding CanManualRead, ElementName=Root}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Background="{DynamicResource MaterialDesign.Brush.Primary}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Text="&#xE8C8;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="读卡" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
