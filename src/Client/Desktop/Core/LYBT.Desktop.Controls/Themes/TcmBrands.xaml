<!--
    TcmBrands.xaml - 中医品牌色彩系统

    定义 TCM 专用品牌色，用于按钮、状态指示器等需要品牌标识的场景。
    所有颜色定义为 DynamicResource，支持亮色/暗色主题切换。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TCM 品牌绿 (药材/确认/成功) -->
    <Color x:Key="TcmGreenColor">#2E8B57</Color>
    <SolidColorBrush x:Key="TcmGreenBrush" Color="{StaticResource TcmGreenColor}" />

    <!-- TCM 品牌金 (处方/警告/重要) -->
    <Color x:Key="TcmGoldColor">#DAA520</Color>
    <SolidColorBrush x:Key="TcmGoldBrush" Color="{StaticResource TcmGoldColor}" />

    <!-- TCM 品牌橙 (编辑/进行中) -->
    <Color x:Key="TcmOrangeColor">#E65100</Color>
    <SolidColorBrush x:Key="TcmOrangeBrush" Color="{StaticResource TcmOrangeColor}" />

    <!-- 暗色主题色键（亮色键名 + "Dark" 后缀，由 ThemeService.ApplyCustomPalette 主题切换时应用） -->
    <Color x:Key="TcmGreenColorDark">#4CAF50</Color>
    <Color x:Key="TcmGoldColorDark">#FFD54F</Color>
    <Color x:Key="TcmOrangeColorDark">#FF9800</Color>

</ResourceDictionary>
