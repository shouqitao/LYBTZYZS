<!--
    Surfaces.xaml - 表面色彩层次系统

    定义 4 级 Surface，解决 MDIX Light 主题全白无层次问题。
    暖灰色底 (#FAF8F5) 让白色面板/卡片明显浮起，同时保持中医温暖质感。

    层次结构：
    L0 Background  → 页面/容器底色（暖灰）
    L1 Surface     → 面板/工具栏（纯白）
    L2 Raised      → 浮起卡片（纯白 + 轻投影）
    L3 Overlay     → 模态弹窗（纯白 + 重投影）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======== Surface 色阶 ======== -->

    <!-- L0: 应用背景（暖灰白，让白色面板浮起） -->
    <Color x:Key="SurfaceLevel0Color">#FAF8F5</Color>
    <SolidColorBrush x:Key="SurfaceLevel0Brush" Color="{DynamicResource SurfaceLevel0Color}" />

    <!-- L1: 面板表面（纯白） -->
    <Color x:Key="SurfaceLevel1Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceLevel1Brush" Color="{DynamicResource SurfaceLevel1Color}" />

    <!-- L2: 浮起表面（纯白 + 投影，投影在使用处定义） -->
    <Color x:Key="SurfaceLevel2Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceLevel2Brush" Color="{DynamicResource SurfaceLevel2Color}" />

    <!-- L3: 弹窗表面（纯白 + 重投影，投影在使用处定义） -->
    <Color x:Key="SurfaceLevel3Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceLevel3Brush" Color="{DynamicResource SurfaceLevel3Color}" />

    <!-- ======== 覆盖 MDIX 默认背景 Brush ======== -->
    <!-- MDIX 默认 Background 为白色，覆盖为暖灰以创建层次 -->
    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{DynamicResource SurfaceLevel0Color}" />

    <!-- ======== 覆盖层遮罩 ======== -->
    <!-- 半透明黑遮罩：加载态覆盖层背景（LoadingOverlay / BaseDetailContainer 使用）
         取值与 LoginView 现有加载遮罩 (#80000000) 一致；遮罩为黑色半透明，亮/暗主题通用 -->
    <SolidColorBrush x:Key="DarkOpacityBrush" Color="#80000000" />

    <!-- ======== 分隔线 ======== -->
    <Color x:Key="DividerColor">#E0DCD5</Color>
    <Color x:Key="DividerLightColor">#EDE9E3</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerColor}" />
    <SolidColorBrush x:Key="DividerLightBrush" Color="{DynamicResource DividerLightColor}" />

    <!-- ======== 暗色主题色键 ======== -->
    <!-- 暗色值 = 亮色键名 + "Dark" 后缀；由 ThemeService.ApplyCustomPalette 在主题切换时写入 Application 资源 -->
    <Color x:Key="SurfaceLevel0ColorDark">#1E1E1E</Color>
    <Color x:Key="SurfaceLevel1ColorDark">#2D2D30</Color>
    <Color x:Key="SurfaceLevel2ColorDark">#2D2D30</Color>
    <Color x:Key="SurfaceLevel3ColorDark">#3F3F46</Color>
    <Color x:Key="DividerColorDark">#3F3F46</Color>
    <Color x:Key="DividerLightColorDark">#333338</Color>

    <!-- ======== 状态徽章色彩（StatusBadge 使用） ======== -->
    <Color x:Key="BadgeSuccessBackgroundColor">#E8F5E9</Color>
    <Color x:Key="BadgeSuccessForegroundColor">#228B22</Color>
    <Color x:Key="BadgeDangerBackgroundColor">#FDE7E9</Color>
    <Color x:Key="BadgeDangerForegroundColor">#A4262C</Color>
    <Color x:Key="BadgeWarningBackgroundColor">#FFF8E1</Color>
    <Color x:Key="BadgeWarningForegroundColor">#B8860B</Color>
    <Color x:Key="BadgeInfoBackgroundColor">#E0F7FA</Color>
    <Color x:Key="BadgeInfoForegroundColor">#3D5A80</Color>
    <Color x:Key="BadgeNeutralBackgroundColor">#F5F5F5</Color>
    <Color x:Key="BadgeNeutralForegroundColor">#757575</Color>

    <!-- 状态徽章暗色（深色背景 + 亮色前景） -->
    <Color x:Key="BadgeSuccessBackgroundColorDark">#1B5E20</Color>
    <Color x:Key="BadgeSuccessForegroundColorDark">#81C784</Color>
    <Color x:Key="BadgeDangerBackgroundColorDark">#B71C1C</Color>
    <Color x:Key="BadgeDangerForegroundColorDark">#EF9A9A</Color>
    <Color x:Key="BadgeWarningBackgroundColorDark">#7A5900</Color>
    <Color x:Key="BadgeWarningForegroundColorDark">#FFD54F</Color>
    <Color x:Key="BadgeInfoBackgroundColorDark">#0D47A1</Color>
    <Color x:Key="BadgeInfoForegroundColorDark">#81D4FA</Color>
    <Color x:Key="BadgeNeutralBackgroundColorDark">#3F3F46</Color>
    <Color x:Key="BadgeNeutralForegroundColorDark">#BDBDBD</Color>

    <!-- 状态徽章画刷（引用上述色键，随主题自动更新） -->
    <SolidColorBrush x:Key="BadgeSuccessBackground" Color="{DynamicResource BadgeSuccessBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeSuccessForeground" Color="{DynamicResource BadgeSuccessForegroundColor}" />
    <SolidColorBrush x:Key="BadgeDangerBackground" Color="{DynamicResource BadgeDangerBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeDangerForeground" Color="{DynamicResource BadgeDangerForegroundColor}" />
    <SolidColorBrush x:Key="BadgeWarningBackground" Color="{DynamicResource BadgeWarningBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeWarningForeground" Color="{DynamicResource BadgeWarningForegroundColor}" />
    <SolidColorBrush x:Key="BadgeInfoBackground" Color="{DynamicResource BadgeInfoBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeInfoForeground" Color="{DynamicResource BadgeInfoForegroundColor}" />
    <SolidColorBrush x:Key="BadgeNeutralBackground" Color="{DynamicResource BadgeNeutralBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeNeutralForeground" Color="{DynamicResource BadgeNeutralForegroundColor}" />

    <!-- ======== 投影效果 Token ======== -->

    <!-- Elevation 1: 卡片（InfoCard 等浮起元素） -->
    <DropShadowEffect x:Key="Elevation1"
                      BlurRadius="8" ShadowDepth="1"
                      Opacity="0.06" Color="Black" Direction="270" />

    <!-- Elevation 2: 面板（Master/Detail 面板边缘） -->
    <DropShadowEffect x:Key="Elevation2"
                      BlurRadius="12" ShadowDepth="2"
                      Opacity="0.08" Color="Black" Direction="270" />

    <!-- Elevation 3: 弹窗（Dialog） -->
    <DropShadowEffect x:Key="Elevation3"
                      BlurRadius="24" ShadowDepth="8"
                      Opacity="0.12" Color="Black" Direction="270" />

</ResourceDictionary>
