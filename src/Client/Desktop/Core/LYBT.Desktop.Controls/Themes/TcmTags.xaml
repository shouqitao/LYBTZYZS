<!--
    TcmTags.xaml - 中药标签与紧凑区块样式

    提取自以下逐字重复的本地定义（两份内容完全一致）：
    - HerbTagStyle / HerbTagNameStyle / HerbTagDosageStyle：
      FormulaViewControl 与 MedicalCaseViewControl
    - CompactSectionBorderStyle：
      MedicalCaseEditControl 与 MedicalCaseViewControl

    引用方式：Style="{DynamicResource ...}" / Style="{StaticResource ...}"
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Compact模式区域边框样式 -->
    <Style x:Key="CompactSectionBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignOutline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <!--  药材标签容器样式  -->
    <Style x:Key="HerbTagStyle" TargetType="Border">
        <Setter Property="Background" Value="#E0F7FA"/>
        <Setter Property="BorderBrush" Value="#5B8FA8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinWidth" Value="100"/>
    </Style>

    <!--  药材名称文字样式  -->
    <Style x:Key="HerbTagNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--  药材剂量文字样式  -->
    <Style x:Key="HerbTagDosageStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
</ResourceDictionary>
