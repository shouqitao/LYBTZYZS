<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TODO: phase 2 - migrate to MDIX. These are structural ListBox templates kept for now. -->

    <!--
        ====================================================================
        Navigation Suggestions Panel - Phase 2.1: Navigation Improvements
        导航建议面板 - 显示智能导航建议
        ====================================================================
    -->

    <!-- Suggestion Item Style -->
    <Style x:Key="SuggestionItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="SuggestionBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SuggestionBorder" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Surface}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SuggestionBorder" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Suggestion Type Badge Style -->
    <Style x:Key="SuggestionTypeBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Suggestion Type Text Style -->
    <Style x:Key="SuggestionTypeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Navigation Suggestions Panel Style -->
    <Style x:Key="NavigationSuggestionsPanelStyle" TargetType="ListBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Outline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SuggestionItemContainerStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Background="{DynamicResource Alt1Brush}"
                                    Padding="12,8"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="建议导航"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>

                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Command="{Binding RefreshCommand}"
                                            Padding="8,4"
                                            FontSize="12"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                            Style="{StaticResource MaterialDesignFlatButton}"/>
                                </Grid>
                            </Border>

                            <!-- Items -->
                            <ScrollViewer Grid.Row="1"
                                        VerticalScrollBarVisibility="Auto"
                                        Padding="4">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
