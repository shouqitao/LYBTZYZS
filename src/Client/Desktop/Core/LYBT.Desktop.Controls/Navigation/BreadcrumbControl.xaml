<UserControl x:Class="LYBT.Desktop.Controls.Navigation.BreadcrumbControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nav="clr-namespace:LYBT.Desktop.Controls.Navigation"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="800">

    <!-- Breadcrumb Control -->
    <ItemsControl ItemsSource="{Binding Items}"
                  Background="Transparent"
                  HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Margin="16,12"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="nav:BreadcrumbItem">
                <ContentControl Style="{DynamicResource BreadcrumbItemContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Active Breadcrumb (Not clickable) -->
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                   FontWeight="SemiBold"
                                   Padding="8,6"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsActive, Converter={x:Static converters:Cvt.BoolToVis}}"/>

                        <!-- Non-Active Breadcrumb (Clickable) -->
                        <Button Content="{Binding Title}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding IsActive, Converter={x:Static converters:Cvt.InverseBoolToVis}}"/>
                    </StackPanel>
                </ContentControl>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
