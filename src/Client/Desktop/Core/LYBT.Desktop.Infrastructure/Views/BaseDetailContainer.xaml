<!--
    BaseDetailContainer - 详情页容器控件
    OpenSpec: refactor-detail-view-container

    功能：
    - 容器化架构，支持查看/编辑模式独立定义
    - Header: 返回按钮 + 标题 + 编辑按钮 + 自定义操作区
    - Content: ViewContent(查看面板) / EditContent(编辑面板) 切换
    - Footer: 保存/取消按钮（仅编辑模式显示）

    使用方式：
    <views:BaseDetailContainer
        Title="患者详情"
        IsEditMode="{Binding IsEditMode}"
        GoBackCommand="{Binding GoBackCommand}"
        SwitchToEditCommand="{Binding SwitchToEditModeCommand}"
        SaveCommand="{Binding SubmitCommand}"
        CancelCommand="{Binding CancelCommand}">
        <views:BaseDetailContainer.ViewContent>
            ... 查看模式内容 ...
        </views:BaseDetailContainer.ViewContent>
        <views:BaseDetailContainer.EditContent>
            ... 编辑模式内容 ...
        </views:BaseDetailContainer.EditContent>
    </views:BaseDetailContainer>
-->
<UserControl x:Class="LYBT.Desktop.Infrastructure.Views.BaseDetailContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 布尔值转可见性转换器 -->
            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <!-- Null转可见性转换器 - OpenSpec: unify-medicalcase-view-edit-pattern -->
            <infrastructure:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <infrastructure:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />

            <!-- 卡片阴影 -->
            <DropShadowEffect x:Key="CardShadow"
                              BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.08"
                              Color="#000000"/>

            <!-- 过渡动画时长 -->
            <Duration x:Key="TransitionDuration">0:0:0.25</Duration>

            <!-- 查看模式面板样式 - 带淡入淡出动画 -->
            <Style x:Key="ViewContentStyle" TargetType="ContentPresenter">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform X="0" Y="0"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 编辑模式时隐藏并淡出 -->
                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                    </DataTrigger>
                    <!-- 查看模式时显示并淡入 -->
                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="{StaticResource TransitionDuration}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="-8" To="0"
                                                     Duration="{StaticResource TransitionDuration}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 编辑模式面板样式 - 带淡入淡出动画 -->
            <Style x:Key="EditContentStyle" TargetType="ContentPresenter">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform X="0" Y="0"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 编辑模式时显示并淡入 -->
                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="{StaticResource TransitionDuration}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="8" To="0"
                                                     Duration="{StaticResource TransitionDuration}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                    <!-- 查看模式时隐藏 -->
                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Footer面板样式 - 带淡入淡出动画 -->
            <Style x:Key="FooterStyle" TargetType="Grid">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform X="0" Y="0"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 编辑模式时显示并从底部滑入 -->
                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1"
                                                     Duration="{StaticResource TransitionDuration}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="16" To="0"
                                                     Duration="{StaticResource TransitionDuration}">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                    <!-- 查看模式时隐藏 -->
                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 页面加载淡入动画 -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header -->
            <RowDefinition Height="*" />      <!-- Content -->
            <RowDefinition Height="Auto" />  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: Header - 标题栏 -->
        <Grid Grid.Row="0" Margin="40,28,40,0">
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="32,24"
                    Effect="{StaticResource CardShadow}">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 返回按钮 -->
                    <Button Grid.Column="0"
                            Command="{Binding GoBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource SecondaryButton}"
                            Content="← 返回"
                            Padding="16,10"
                            VerticalAlignment="Center"/>

                    <!-- 页面标题 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="20,0,0,0" />

                    <!-- 操作按钮区域 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- 自定义操作按钮 -->
                        <ContentPresenter Content="{Binding ActionButtons, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                        <!-- 查看模式：显示编辑按钮（受ShowEditButton和IsEditMode双重控制） -->
                        <Border Visibility="{Binding ShowEditButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Command="{Binding SwitchToEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    Style="{StaticResource SuccessButton}"
                                    Content="编辑"
                                    Padding="20,10"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: Content - 内容区域 -->
        <!-- 带滚动的内容区域（默认模式） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="40,28,40,0"
                      Visibility="{Binding UseContentScrolling, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <!-- 查看模式面板 - 带过渡动画 -->
                <ContentPresenter Content="{Binding ViewContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Style="{StaticResource ViewContentStyle}" />

                <!-- 编辑模式面板 - 带过渡动画 -->
                <ContentPresenter Content="{Binding EditContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Style="{StaticResource EditContentStyle}" />
            </Grid>
        </ScrollViewer>

        <!-- 不带滚动的内容区域（用于需要Height="*"填充的布局） -->
        <Grid Grid.Row="1" Margin="40,28,40,0"
              Visibility="{Binding UseContentScrolling, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <!-- 查看模式面板 - 带过渡动画 -->
            <ContentPresenter Content="{Binding ViewContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Style="{StaticResource ViewContentStyle}" />

            <!-- 编辑模式面板 - 带过渡动画 -->
            <ContentPresenter Content="{Binding EditContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Style="{StaticResource EditContentStyle}" />
        </Grid>

        <!-- Row 2: Footer - 底部操作栏（仅编辑模式显示）- 带过渡动画 -->
        <!-- OpenSpec: unify-medicalcase-view-edit-pattern - 支持FooterContent自定义 -->
        <Grid Grid.Row="2" Margin="40,28,40,28"
              Style="{StaticResource FooterStyle}">
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="32,24"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <!-- 默认Footer：保存/取消按钮（当FooterContent为null时显示） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding FooterContent, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseNullToVisibilityConverter}}">
                        <!-- 取消按钮 -->
                        <Button Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource SecondaryButton}"
                                Content="取消"
                                Padding="32,12"
                                FontSize="15"
                                MinWidth="120"/>

                        <!-- 保存按钮 -->
                        <Button Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="32,12"
                                FontSize="15"
                                MinWidth="120"
                                Margin="16,0,0,0">
                            <Button.Content>
                                <TextBlock Text="{Binding SaveButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Button.Content>
                        </Button>
                    </StackPanel>

                    <!-- 自定义Footer：当FooterContent有值时显示 -->
                    <ContentPresenter Content="{Binding FooterContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Visibility="{Binding FooterContent, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Loading遮罩 -->
        <Grid Grid.RowSpan="3"
              Background="{StaticResource OverlayBrush}"
              Visibility="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="..."
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <TextBlock Text="{Binding LoadingMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
