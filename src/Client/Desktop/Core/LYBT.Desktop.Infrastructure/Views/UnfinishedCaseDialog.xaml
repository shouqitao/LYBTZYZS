<Window x:Class="LYBT.Desktop.Infrastructure.Views.UnfinishedCaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:LYBT.Desktop.Infrastructure.ViewModels"
        Title="{Binding Title}"
        Width="550" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBackgroundBrush}">

    <!-- OpenSpec: optimize-medicalcase-navigation - 统一四选项弹窗 -->
    <Window.DataContext>
        <viewmodels:UnfinishedCaseDialogViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <!-- 取消按钮样式 -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource StateDisabledBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 图标和消息 -->
            <RowDefinition Height="*"/>      <!-- 选项说明 -->
            <RowDefinition Height="Auto"/>   <!-- 按钮区 -->
        </Grid.RowDefinitions>

        <!-- 消息区域 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="?" FontSize="32" FontWeight="Bold" VerticalAlignment="Top" Margin="0,0,15,0"
                       Foreground="{StaticResource BrandPrimaryBrush}"/>
            <TextBlock Text="{Binding Message}"
                      FontSize="16"
                      TextWrapping="Wrap"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

        <!-- 选项说明区域 -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceCardBrush}"
                Padding="15"
                CornerRadius="5"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                Margin="0,0,0,20">
            <StackPanel>
                <!-- 选项1 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text=">" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"
                               Foreground="{StaticResource BrandPrimaryBrush}"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="继续看诊：" FontWeight="Bold"/>
                        <Run Text="恢复之前的医案，继续编辑"/>
                    </TextBlock>
                </StackPanel>

                <!-- 选项2 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"
                               Foreground="{StaticResource SemanticSuccessBrush}"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="新建医案：" FontWeight="Bold"/>
                        <Run Text="关闭旧医案后创建新的"/>
                    </TextBlock>
                </StackPanel>

                <!-- 选项3 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="x" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"
                               Foreground="{StaticResource SemanticWarningBrush}"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="仅关闭：" FontWeight="Bold"/>
                        <Run Text="关闭旧医案（从待看诊列表移除）"/>
                    </TextBlock>
                </StackPanel>

                <!-- 选项4 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="-" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="取消：" FontWeight="Bold"/>
                        <Run Text="什么都不做，关闭对话框"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Center">
            <Button Content="继续看诊"
                   Command="{Binding ContinueCommand}"
                   Style="{StaticResource PrimaryButtonStyle}"/>

            <Button Content="新建医案"
                   Command="{Binding CreateNewCommand}"
                   Style="{StaticResource SecondaryButtonStyle}"/>

            <Button Content="仅关闭"
                   Command="{Binding CloseOnlyCommand}"
                   Style="{StaticResource SecondaryButtonStyle}"/>

            <Button Content="取消"
                   Command="{Binding CancelCommand}"
                   Style="{StaticResource CancelButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
