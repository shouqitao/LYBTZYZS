<!--
    SearchBox - 搜索框控件
    OpenSpec: refactor-master-detail-layout

    功能：
    - 搜索输入框 + 清除按钮 + 搜索按钮
    - 支持防抖搜索
    - 支持占位符文本

    使用方式：
    <controls:SearchBox
        SearchText="{Binding SearchText, Mode=TwoWay}"
        SearchCommand="{Binding SearchCommand}"
        Placeholder="请输入搜索关键词..."/>-->
<UserControl
    x:Class="LYBT.Desktop.Infrastructure.Controls.SearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
    xmlns:helpers="clr-namespace:LYBT.Desktop.Infrastructure.Helpers"
    x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - Converter使用 x:Static 引用静态实例，绕过资源字典查找
        - 本地定义的搜索框样式和图标资源
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!--  绑定代理 - 用于VisualBrush中访问控件属性  -->
            <helpers:BindingProxy x:Key="RootProxy" Data="{Binding ElementName=Root}" />

            <!--  清除按钮样式  -->
            <Style x:Key="ClearButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <Path
                                    Width="12"
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M4,4 L12,12 M12,4 L4,12"
                                    Stretch="Uniform"
                                    Stroke="#888888"
                                    StrokeThickness="1.5" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8E8E8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  搜索图标路径  -->
            <Geometry x:Key="SearchIconGeometry">M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</Geometry>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Padding="8,4"
        Background="{DynamicResource RegionBrush}"
        BorderBrush="{DynamicResource BorderLightBrush}"
        BorderThickness="1"
        CornerRadius="6"
        DataContext="{Binding ElementName=Root}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  搜索图标  -->
            <Path
                Grid.Column="0"
                Width="16"
                Height="16"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Data="{StaticResource SearchIconGeometry}"
                Fill="#888888"
                Stretch="Uniform" />

            <!--  输入框  -->
            <TextBox
                Grid.Column="1"
                Padding="0,4"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontSize="14"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="#333333" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush AlignmentX="Left" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="#AAAAAA"
                                                    Text="{Binding Data.Placeholder, Source={StaticResource RootProxy}}" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush AlignmentX="Left" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="#AAAAAA"
                                                    Text="{Binding Data.Placeholder, Source={StaticResource RootProxy}}" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!--  清除按钮  -->
            <Button
                Grid.Column="2"
                Command="{Binding ClearCommand}"
                Style="{StaticResource ClearButtonStyle}"
                ToolTip="清除搜索"
                Visibility="{Binding SearchText, Converter={x:Static converters:Cvt.NullToVis}}" />

            <!--  搜索按钮  -->
            <Button
                Grid.Column="3"
                Margin="8,0,0,0"
                Padding="12,6"
                Command="{Binding SearchCommand}"
                Content="搜索"
                FontSize="13"
                Style="{DynamicResource PrimaryButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
