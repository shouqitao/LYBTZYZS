<!--
    DataGridToolbar - 数据列表工具栏控件
    OpenSpec: refactor-master-detail-layout

    功能：
    - 新增/刷新/导出按钮组
    - 可选的批量操作按钮
    - 支持自定义附加按钮

    使用方式：
    <controls:DataGridToolbar
        CreateCommand="{Binding CreateCommand}"
        RefreshCommand="{Binding RefreshCommand}"
        ExportCommand="{Binding ExportCommand}"/>
-->
<UserControl x:Class="LYBT.Desktop.Infrastructure.Controls.DataGridToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <infrastructure:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

            <!-- 工具栏按钮图标 -->
            <Geometry x:Key="AddIcon">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</Geometry>
            <Geometry x:Key="RefreshIcon">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</Geometry>
            <Geometry x:Key="ExportIcon">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</Geometry>
            <Geometry x:Key="DeleteIcon">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</Geometry>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
        <!-- 注意：不设置Grid的DataContext，以便AdditionalContent能继承父级的ViewModel DataContext -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧按钮组 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <!-- 新增按钮 -->
                <Button Command="{Binding CreateCommand, ElementName=Root}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding CreateCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}"
                        ToolTip="新增"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIcon}"
                              Fill="White"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="新增"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 刷新按钮 -->
                <Button Command="{Binding RefreshCommand, ElementName=Root}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding RefreshCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}"
                        ToolTip="刷新"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource RefreshIcon}"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="刷新"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 附加内容插槽 -->
                <ContentPresenter Content="{Binding AdditionalContent, ElementName=Root}"/>
            </StackPanel>

            <!-- 右侧按钮组 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <!-- 批量删除按钮 -->
                <Button Command="{Binding BatchDeleteCommand, ElementName=Root}"
                        Style="{StaticResource DangerButtonStyle}"
                        Visibility="{Binding BatchDeleteCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}"
                        ToolTip="批量删除"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource DeleteIcon}"
                              Fill="White"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="批量删除"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 导出按钮 -->
                <Button Command="{Binding ExportCommand, ElementName=Root}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding ExportCommand, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}"
                        ToolTip="导出">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ExportIcon}"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="导出"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
