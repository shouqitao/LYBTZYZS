<!--
    StatusBadge - 状态徽章控件
    OpenSpec: refactor-master-detail-layout - UI优化

    功能：
    - 以彩色徽章形式显示状态
    - 支持多种预设状态类型（Enabled/Disabled/Active/Inactive等）
    - 支持自定义颜色

    使用方式：
    <controls:StatusBadge Status="{Binding Status}"/>
    <controls:StatusBadge Status="Enabled"/>
    <controls:StatusBadge StatusText="自定义" BadgeType="Success"/>-->
<UserControl
    x:Class="LYBT.Desktop.Infrastructure.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 仅保留本地定义的徽章颜色资源
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!--  状态徽章颜色 - 使用主题资源  -->
            <SolidColorBrush x:Key="BadgeSuccessBackground" Color="{DynamicResource LightSuccessColor}" />
            <SolidColorBrush x:Key="BadgeSuccessForeground" Color="{DynamicResource DarkSuccessColor}" />
            <SolidColorBrush x:Key="BadgeDangerBackground" Color="{DynamicResource LightDangerColor}" />
            <SolidColorBrush x:Key="BadgeDangerForeground" Color="{DynamicResource DarkDangerColor}" />
            <SolidColorBrush x:Key="BadgeWarningBackground" Color="{DynamicResource LightWarningColor}" />
            <SolidColorBrush x:Key="BadgeWarningForeground" Color="{DynamicResource DarkWarningColor}" />
            <SolidColorBrush x:Key="BadgeInfoBackground" Color="{DynamicResource LightInfoColor}" />
            <SolidColorBrush x:Key="BadgeInfoForeground" Color="{DynamicResource DarkInfoColor}" />
            <SolidColorBrush x:Key="BadgeNeutralBackground" Color="{DynamicResource SecondaryRegionColor}" />
            <SolidColorBrush x:Key="BadgeNeutralForeground" Color="{DynamicResource SecondaryTextColor}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        x:Name="BadgeBorder"
        MinWidth="48"
        Padding="8,4"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Background="{Binding BadgeBackground, ElementName=Root}"
        CornerRadius="4">
        <TextBlock
            x:Name="BadgeText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="Medium"
            Foreground="{Binding BadgeForeground, ElementName=Root}"
            Text="{Binding DisplayText, ElementName=Root}" />
    </Border>
</UserControl>
