<!--
    StatusBadge - 状态徽章控件
    OpenSpec: refactor-master-detail-layout - UI优化

    功能：
    - 以彩色徽章形式显示状态
    - 支持多种预设状态类型（Enabled/Disabled/Active/Inactive等）
    - 支持自定义颜色

    使用方式：
    <controls:StatusBadge Status="{Binding Status}"/>
    <controls:StatusBadge Status="Enabled"/>
    <controls:StatusBadge StatusText="自定义" BadgeType="Success"/>
-->
<UserControl x:Class="LYBT.Desktop.Infrastructure.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 仅保留本地定义的徽章颜色资源
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 状态徽章颜色 -->
            <SolidColorBrush x:Key="BadgeSuccessBackground" Color="#E6F4EA"/>
            <SolidColorBrush x:Key="BadgeSuccessForeground" Color="#1E7D34"/>
            <SolidColorBrush x:Key="BadgeDangerBackground" Color="#FCE8E8"/>
            <SolidColorBrush x:Key="BadgeDangerForeground" Color="#C42B1C"/>
            <SolidColorBrush x:Key="BadgeWarningBackground" Color="#FFF4CE"/>
            <SolidColorBrush x:Key="BadgeWarningForeground" Color="#9D5D00"/>
            <SolidColorBrush x:Key="BadgeInfoBackground" Color="#E5F6FD"/>
            <SolidColorBrush x:Key="BadgeInfoForeground" Color="#0078D4"/>
            <SolidColorBrush x:Key="BadgeNeutralBackground" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="BadgeNeutralForeground" Color="#616161"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="BadgeBorder"
            Padding="8,4"
            CornerRadius="4"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{Binding BadgeBackground, ElementName=Root}"
            MinWidth="48">
        <TextBlock x:Name="BadgeText"
                   Text="{Binding DisplayText, ElementName=Root}"
                   FontSize="12"
                   FontWeight="Medium"
                   Foreground="{Binding BadgeForeground, ElementName=Root}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
