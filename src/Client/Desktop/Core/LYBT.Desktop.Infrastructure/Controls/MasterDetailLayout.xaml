<!--
    MasterDetailLayout - Master-Detail布局容器控件
    OpenSpec: refactor-master-detail-layout

    功能：
    - 左右分割布局，支持GridSplitter调节
    - 左侧Master区域显示列表
    - 右侧Detail区域显示详情/编辑（浮动卡片效果）
    - 支持空状态提示

    UI优化 (2025-12-16):
    - Detail面板添加阴影和圆角（浮动卡片效果）
    - GridSplitter改进视觉反馈
    - 使用统一间距令牌
    - 添加微妙过渡效果

    使用方式：
    <controls:MasterDetailLayout HasSelection="{Binding HasSelection}">
        <controls:MasterDetailLayout.MasterContent>
            ... 列表内容 ...
        </controls:MasterDetailLayout.MasterContent>
        <controls:MasterDetailLayout.DetailContent>
            ... 详情内容 ...
        </controls:MasterDetailLayout.DetailContent>
        <controls:MasterDetailLayout.EmptyContent>
            ... 空状态提示 ...
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
-->
<UserControl x:Class="LYBT.Desktop.Infrastructure.Controls.MasterDetailLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
             x:Name="Root">

    <!--
        资源架构说明 (OpenSpec: migrate-to-handycontrol, 2026-01-22):

        本地样式使用 DynamicResource 引用全局资源（Brush/Color/CornerRadius/Effect）

        资源来源：
        - Brush/Color: App.xaml → HandyControl Theme.xaml + TCM.Theme.xaml
        - CornerRadius/Effect: App.xaml → TCM.Theme.xaml

        Converter 使用 x:Static 引用静态实例，无需资源字典。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- ====================================================================
                 GridSplitter样式 - 改进的视觉反馈
                 注意：ControlTemplate 内部的 DynamicResource 是安全的，
                       因为模板实例化时元素已在视觉树中
                 ==================================================================== -->
            <Style x:Key="MasterDetailSplitterStyle" TargetType="GridSplitter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Width" Value="12"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Cursor" Value="SizeWE"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <!-- 视觉分割线 -->
                                <Border x:Name="SplitterLine"
                                        Width="1"
                                        Background="{DynamicResource SecondaryBorderBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"/>
                                <!-- 拖动指示器 -->
                                <Border x:Name="DragIndicator"
                                        Width="4"
                                        CornerRadius="2"
                                        Background="{DynamicResource PrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Height="48"
                                        Opacity="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SplitterLine" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="SplitterLine" Property="Width" Value="2"/>
                                    <Setter TargetName="DragIndicator" Property="Opacity" Value="0.3"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="SplitterLine" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="SplitterLine" Property="Width" Value="2"/>
                                    <Setter TargetName="DragIndicator" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ====================================================================
                 Detail面板样式 - 浮动卡片效果
                 ==================================================================== -->
            <Style x:Key="DetailPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}"/>
                <Setter Property="Margin" Value="8,12,12,12"/>
                <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
            </Style>

            <!-- ====================================================================
                 Master面板样式 - 简洁列表区域
                 ==================================================================== -->
            <Style x:Key="MasterPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
            </Style>

            <!-- ====================================================================
                 空状态面板样式
                 ==================================================================== -->
            <Style x:Key="EmptyStatePanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}"/>
                <Setter Property="Margin" Value="8,12,12,12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 主容器 - 使用SurfaceBrush作为整体背景 -->
    <Border Background="{DynamicResource SecondaryRegionBrush}">
        <!-- 注意：不设置Grid的DataContext，以便内容能继承父级的ViewModel DataContext -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding MasterWidth, ElementName=Root}" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{Binding DetailWidth, ElementName=Root}" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Master区域 - 列表 -->
            <Border Grid.Column="0" Style="{StaticResource MasterPanelStyle}">
                <ContentPresenter Content="{Binding MasterContent, ElementName=Root}"/>
            </Border>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" Style="{StaticResource MasterDetailSplitterStyle}"/>

            <!-- Detail区域 - 浮动卡片 -->
            <Grid Grid.Column="2">
                <!-- 有选中项时显示详情（带阴影卡片） -->
                <Border Style="{StaticResource DetailPanelStyle}"
                        Visibility="{Binding HasSelection, ElementName=Root, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <ContentPresenter Content="{Binding DetailContent, ElementName=Root}"/>
                </Border>

                <!-- 无选中项时显示空状态 -->
                <Border Style="{StaticResource EmptyStatePanelStyle}"
                        Visibility="{Binding HasSelection, ElementName=Root, Converter={x:Static converters:Cvt.InverseBoolToVis}}">
                    <ContentPresenter Content="{Binding EmptyContent, ElementName=Root}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
