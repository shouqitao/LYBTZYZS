<!--
    PatientInfoCardControl - 患者信息卡片控件
    OpenSpec: refactor-medicalcase-workspace

    功能：
    - 显示患者基本信息（姓名、性别、年龄等）
    - 支持三种显示模式：Full/Compact/Minimal
    - 可配置历史按钮和就诊次数显示

    使用方式：
    <controls:PatientInfoCardControl
        Patient="{Binding CurrentPatient}"
        DisplayMode="Full"
        ShowHistoryButton="True"
        HistoryCommand="{Binding ViewHistoryCommand}"
        ShowVisitCount="True"/>
-->
<UserControl x:Class="LYBT.Desktop.Infrastructure.Controls.PatientInfoCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LYBT.Desktop.Infrastructure.Controls"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters">

    <!--
        资源加载说明 (OpenSpec: migrate-to-handycontrol):
        - 所有资源通过 App.xaml 全局加载，控件级别不再合并资源字典
        - CardShadow 已在 TCM.Theme.xaml 全局定义
    -->
    <UserControl.Resources>
        <!-- 本地资源已迁移到全局，保留空Resources便于将来扩展 -->
    </UserControl.Resources>

    <!-- 使用DynamicResource：Shell Design Tokens通过App级别加载 -->
    <Border Background="{DynamicResource SecondaryRegionBrush}"
            CornerRadius="16"
            Padding="24,20"
            Effect="{StaticResource CardShadow}">
        <StackPanel>
            <!-- 患者基本信息 - 始终显示 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <!-- 头像占位 -->
                <Border Width="48" Height="48"
                        CornerRadius="24"
                        Background="{DynamicResource PrimaryBrush}"
                        Margin="0,0,16,0">
                    <TextBlock Text="{Binding Patient.Name, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:Cvt.FirstChar}}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 姓名、性别、年龄 -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Patient.Name, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Patient.Gender, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Patient.AgeDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 详细信息 - Full模式显示 -->
            <StackPanel x:Name="DetailPanel">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static local:PatientCardDisplayMode.Compact}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static local:PatientCardDisplayMode.Minimal}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- 分隔线 -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,12"/>

                <!-- 联系电话 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="联系电话"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Patient.PhoneNumber, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue='-'}"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>

                <!-- 挂号时间 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="挂号时间"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Patient.RegistrationTimeDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>

                <!-- 就诊次数 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowVisitCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock Grid.Column="0"
                               Text="就诊次数"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}">
                        <Run Text="{Binding Patient.VisitCount, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Run Text="次"/>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <!-- 查看历史按钮 -->
            <Button Content="查看历史"
                    Command="{Binding HistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowHistoryButton, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="{x:Static local:PatientCardDisplayMode.Minimal}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
