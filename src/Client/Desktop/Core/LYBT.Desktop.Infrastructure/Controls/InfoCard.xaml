<!--
    InfoCard - 信息卡片控件
    OpenSpec: refactor-detail-view-container

    功能：
    - 用于查看模式下的信息分组展示
    - 卡片式布局，带标题和内容区域
    - 支持自定义内容

    使用方式：
    <controls:InfoCard Title="基本信息">
        <Grid>
            ... 内容 ...
        </Grid>
    </controls:InfoCard>

    注意：
    - 此控件依赖 App 级别加载的 Design Tokens (SecondaryRegionBrush, PrimaryTextBrush 等)
    - 不要在此控件中合并 UnifiedComponents.xaml，避免资源加载顺序问题
-->
<UserControl x:Class="LYBT.Desktop.Infrastructure.Controls.InfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - Converter使用 x:Static 引用静态实例，绕过资源字典查找
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 卡片阴影 - 本地定义，不依赖外部资源 -->
            <DropShadowEffect x:Key="CardShadow"
                              BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.08"
                              Color="#000000"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 使用DynamicResource：SecondaryRegionBrush定义在Shell/DesignTokens/Colors.Light.xaml，通过App级别加载 -->
    <Border Background="{DynamicResource SecondaryRegionBrush}"
            CornerRadius="16"
            Padding="40,32"
            Effect="{StaticResource CardShadow}"
            Margin="0,0,0,20">
        <StackPanel>
            <!-- 卡片标题 -->
            <TextBlock x:Name="TitleBlock"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,24"
                       Visibility="{Binding ShowTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:Cvt.BoolToVis}}"/>

            <!-- 卡片内容 -->
            <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
    </Border>
</UserControl>
