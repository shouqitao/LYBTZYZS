<!--
    CardReaderStatusControl - 读卡器状态控件
    OpenSpec: integrate-cardreader-module - 身份证读卡器UI集成

    功能：
    - 显示读卡器连接状态
    - 提供手动读卡按钮
    - 支持自动读卡模式开关
    - 显示读卡进度和结果

    使用方式：
    <controls:CardReaderStatusControl
        IsConnected="{Binding IsCardReaderConnected}"
        IsAutoReadEnabled="{Binding IsAutoReadEnabled}"
        IsReading="{Binding IsReading}"
        StatusMessage="{Binding CardReaderStatusMessage}"
        ReadCardCommand="{Binding ReadCardCommand}"
        ToggleAutoReadCommand="{Binding ToggleAutoReadCommand}"/>-->
<UserControl
    x:Class="LYBT.Desktop.Infrastructure.Controls.CardReaderStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="60"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  状态颜色  -->
            <SolidColorBrush x:Key="ConnectedColor" Color="#1E7D34" />
            <SolidColorBrush x:Key="DisconnectedColor" Color="#9E9E9E" />
            <SolidColorBrush x:Key="ReadingColor" Color="#0078D4" />
            <SolidColorBrush x:Key="ErrorColor" Color="#C42B1C" />

            <!--  卡片背景 - 使用主题资源  -->
            <SolidColorBrush x:Key="CardBackground" Color="{DynamicResource SecondaryRegionColor}" />
            <SolidColorBrush x:Key="CardBorder" Color="{DynamicResource BorderColor}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Padding="12,8"
        Background="{StaticResource CardBackground}"
        BorderBrush="{StaticResource CardBorder}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  状态指示器  -->
            <StackPanel
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  连接状态点  -->
                <Ellipse
                    Width="10"
                    Height="10"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource DisconnectedColor}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=Root}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource ConnectedColor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReading, ElementName=Root}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource ReadingColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!--  读卡器图标  -->
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="20"
                    Text="&#xE8EA;">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource DisconnectedColor}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ConnectedColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!--  状态信息  -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="{Binding StatusMessage, ElementName=Root, FallbackValue=读卡器未连接}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#424242" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected, ElementName=Root}" Value="False">
                                    <Setter Property="Foreground" Value="#9E9E9E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!--  自动读卡开关  -->
            <StackPanel
                Grid.Column="2"
                Margin="8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#757575"
                    Text="自动" />
                <ToggleButton
                    x:Name="AutoReadToggle"
                    Width="40"
                    Height="20"
                    Command="{Binding ToggleAutoReadCommand, ElementName=Root}"
                    Cursor="Hand"
                    IsChecked="{Binding IsAutoReadEnabled, ElementName=Root, Mode=TwoWay}"
                    IsEnabled="{Binding IsConnected, ElementName=Root}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border
                                    x:Name="track"
                                    Width="40"
                                    Height="20"
                                    Background="{DynamicResource BorderLightBrush}"
                                    CornerRadius="10" />
                                <Ellipse
                                    x:Name="thumb"
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    Fill="White">
                                    <Ellipse.Effect>
                                        <DropShadowEffect
                                            BlurRadius="2"
                                            Opacity="0.3"
                                            ShadowDepth="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="#0078D4" />
                                    <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="track" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </StackPanel>

            <!--  手动读卡按钮  -->
            <Button
                Grid.Column="3"
                Padding="12,6"
                Command="{Binding ReadCardCommand, ElementName=Root}"
                Cursor="Hand"
                IsEnabled="{Binding CanManualRead, ElementName=Root}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#0078D4" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#106EBE" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#005A9E" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#CCCCCC" />
                                            <Setter Property="Foreground" Value="#999999" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Text="&#xE8C8;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="读卡" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
