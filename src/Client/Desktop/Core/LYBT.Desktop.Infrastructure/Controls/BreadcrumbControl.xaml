<UserControl
    x:Class="LYBT.Desktop.Infrastructure.Controls.BreadcrumbControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
    x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="BreadcrumbItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        Padding="16,8"
        Background="{DynamicResource RegionBrush}"
        BorderBrush="{DynamicResource BorderLightBrush}"
        BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal">
            <!-- 后退按钮 -->
            <Button
                Command="{Binding NavigateBackCommand, ElementName=Root}"
                Style="{StaticResource BreadcrumbItemButton}"
                ToolTip="后退 (Alt+Left)">
                <Path
                    Width="16"
                    Height="16"
                    Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                    Fill="{DynamicResource PrimaryTextBrush}"
                    Stretch="Uniform" />
            </Button>

            <!-- 前进按钮 -->
            <Button
                Margin="2,0,8,0"
                Command="{Binding NavigateForwardCommand, ElementName=Root}"
                Style="{StaticResource BreadcrumbItemButton}"
                ToolTip="前进 (Alt+Right)">
                <Path
                    Width="16"
                    Height="16"
                    Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                    Fill="{DynamicResource PrimaryTextBrush}"
                    Stretch="Uniform" />
            </Button>

            <!-- 分隔线 -->
            <Border Width="1" Margin="0,2" Background="{DynamicResource BorderLightBrush}" />

            <!-- 面包屑列表 -->
            <ItemsControl
                x:Name="BreadcrumbItems"
                ItemsSource="{Binding Breadcrumbs, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!-- 非首项显示分隔符 -->
                            <TextBlock
                                Margin="4,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource ThirdlyTextBrush}"
                                Text=">" />
                            <!-- 面包屑项按钮 -->
                            <Button
                                Click="OnBreadcrumbItemClick"
                                CommandParameter="{Binding}"
                                Cursor="Hand">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource BreadcrumbItemButton}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock
                                    x:Name="ItemText"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding Title}" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
