<!--
    DetailToolbar - 详情工具栏控件
    OpenSpec: refactor-master-detail-layout

    功能：
    - 编辑/保存/取消/删除按钮组
    - 根据IsEditMode自动切换显示

    使用方式：
    <controls:DetailToolbar
        IsEditMode="{Binding IsEditMode}"
        EditCommand="{Binding EditCommand}"
        SaveCommand="{Binding SaveCommand}"
        CancelCommand="{Binding CancelCommand}"
        DeleteCommand="{Binding DeleteCommand}"/>
-->
<UserControl x:Class="LYBT.Desktop.Infrastructure.Controls.DetailToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <infrastructure:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <!-- 危险按钮样式 -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="#D13438"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FDE7E9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1"
            Padding="16,12"
            DataContext="{Binding ElementName=Root}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 标题区域（可选） -->
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Visibility="{Binding Title, Converter={StaticResource NullToVisibilityConverter}}"/>

            <!-- 按钮组 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- 查看模式 - 编辑按钮 -->
                <Button Content="编辑"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding EditCommand}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>

                <!-- 编辑模式 - 保存按钮 -->
                <Button Content="保存"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>

                <!-- 编辑模式 - 取消按钮 -->
                <Button Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>

                <!-- 删除按钮 -->
                <Button Content="删除"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding ShowDeleteButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Padding="16,8"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
