<UserControl
    x:Class="LYBT.Desktop.Infrastructure.Controls.GlobalStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LYBT.Desktop.Infrastructure.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="32"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  状态样式  -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>

        <!--  成功状态样式  -->
        <Style
            x:Key="SuccessStatusStyle"
            BasedOn="{StaticResource StatusTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <!--  错误状态样式  -->
        <Style
            x:Key="ErrorStatusStyle"
            BasedOn="{StaticResource StatusTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>

        <!--  警告状态样式  -->
        <Style
            x:Key="WarningStatusStyle"
            BasedOn="{StaticResource StatusTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <!--  信息状态样式  -->
        <Style
            x:Key="InfoStatusStyle"
            BasedOn="{StaticResource StatusTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
        </Style>

        <!--  进度条样式  -->
        <Style x:Key="StatusProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="{DynamicResource BorderLightBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!--  加载指示器动画  -->
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="LoadingEllipse"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0"
                To="360"
                Duration="0:0:1" />
        </Storyboard>
    </UserControl.Resources>

    <Border
        Background="{DynamicResource RegionBrush}"
        BorderBrush="{DynamicResource BorderLightBrush}"
        BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  状态栏内容  -->
            <Grid Grid.Row="0" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  加载指示器  -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <Ellipse
                        x:Name="LoadingEllipse"
                        Width="16"
                        Height="16"
                        RenderTransformOrigin="0.5,0.5"
                        Stroke="{DynamicResource SuccessBrush}"
                        StrokeDashArray="8 4"
                        StrokeThickness="2">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding LoadingMessage}" />
                </StackPanel>

                <!--  状态消息  -->
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding StatusMessage}" />

                <!--  进度显示  -->
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding OperationProgress, StringFormat={}{0}%}"
                    Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}" />

                <!--  当前用户名 - US-SHELL-007 (CODE-21)  -->
                <TextBlock
                    Grid.Column="3"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding CurrentUserName}"
                    Visibility="{Binding CurrentUserName, Converter={x:Static converters:Cvt.StringToVis}}" />

                <!--  版本号 - US-SHELL-007 (CODE-21)  -->
                <TextBlock
                    Grid.Column="4"
                    Foreground="{DynamicResource ThirdlyTextBrush}"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding AppVersion, StringFormat=v{0}}" />

                <!--  系统时间  -->
                <TextBlock
                    Grid.Column="5"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding Source={x:Static local:SystemTimeProvider.Instance}, Path=CurrentTime, StringFormat=HH:mm:ss}" />
            </Grid>

            <!--  进度条  -->
            <ProgressBar
                Grid.Row="1"
                Style="{StaticResource StatusProgressBarStyle}"
                Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}"
                Value="{Binding OperationProgress}" />
        </Grid>
    </Border>
</UserControl>