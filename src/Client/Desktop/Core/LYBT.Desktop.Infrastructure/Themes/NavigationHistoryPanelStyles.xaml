<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:LYBT.Desktop.Infrastructure.Navigation">

    <!--
        ====================================================================
        Navigation History Panel - Phase 2.1: Navigation Improvements
        导航历史面板 - 显示和管理导航历史记录

        Usage:
        <nav:NavigationHistoryPanel ItemsSource="{Binding History}"/>
        ====================================================================
    -->

    <!-- History Item Container Style -->
    <Style x:Key="HistoryItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4"
                            x:Name="HistoryBorder">
                        <ContentPresenter/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <VisualState.Storyboard>
                                        <ColorAnimation Storyboard.TargetName="HistoryBorder"
                                                        Storyboard.TargetProperty="(Border.Background).Color"
                                                        To="{DynamicResource HoverBackgroundBrush}"
                                                        Duration="0:0:0.2"/>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Storyboard>
                                        <ColorAnimation Storyboard.TargetName="HistoryBorder"
                                                        Storyboard.TargetProperty="(Border.Background).Color"
                                                        To="{DynamicResource SelectedBackgroundBrush}"
                                                        Duration="0:0:0.2"/>
                                    </VisualState.Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- History Item Title Style -->
    <Style x:Key="HistoryItemTitleStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- History Item Timestamp Style -->
    <Style x:Key="HistoryItemTimestampStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- Navigation History Panel Style -->
    <Style x:Key="NavigationHistoryPanelStyle" TargetType="ListBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource HistoryItemContainerStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Background="{DynamicResource Alt1Brush}"
                                    Padding="12,8"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="导航历史"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <Button Grid.Column="1"
                                            Content="清除"
                                            Command="{Binding ClearHistoryCommand}"
                                            Padding="8,4"
                                            FontSize="12"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Items -->
                            <ScrollViewer Grid.Row="1"
                                        VerticalScrollBarVisibility="Auto"
                                        Padding="4">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
