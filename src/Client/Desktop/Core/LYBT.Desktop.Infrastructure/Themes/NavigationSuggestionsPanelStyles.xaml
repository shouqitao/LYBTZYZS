<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nav="clr-namespace:LYBT.Desktop.Infrastructure.Navigation">

    <!--
        ====================================================================
        Navigation Suggestions Panel - Phase 2.1: Navigation Improvements
        导航建议面板 - 显示智能导航建议
        ====================================================================
    -->

    <!-- Suggestion Item Style -->
    <Style x:Key="SuggestionItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4"
                            x:Name="SuggestionBorder">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <TextBlock Grid.Column="0"
                                       Text="🔗"
                                       FontSize="16"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>

                            <!-- Content -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Reason}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Opacity="0.8"/>
                            </StackPanel>

                            <!-- Confidence Indicator -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Alt2Brush}"
                                    Padding="6,2"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding Confidence, StringFormat={}{0:P0}}"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <VisualState.Storyboard>
                                        <ColorAnimation Storyboard.TargetName="SuggestionBorder"
                                                        Storyboard.TargetProperty="(Border.Background).Color"
                                                        To="{DynamicResource HoverBackgroundBrush}"
                                                        Duration="0:0:0.2"/>
                                    </VisualState.Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Suggestion Type Badge Style -->
    <Style x:Key="SuggestionTypeBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Suggestion Type Text Style -->
    <Style x:Key="SuggestionTypeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Navigation Suggestions Panel Style -->
    <Style x:Key="NavigationSuggestionsPanelStyle" TargetType="ListBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SuggestionItemContainerStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Background="{DynamicResource Alt1Brush}"
                                    Padding="12,8"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="建议导航"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <Button Grid.Column="1"
                                            Content="刷新"
                                            Command="{Binding RefreshCommand}"
                                            Padding="8,4"
                                            FontSize="12"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Items -->
                            <ScrollViewer Grid.Row="1"
                                        VerticalScrollBarVisibility="Auto"
                                        Padding="4">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
