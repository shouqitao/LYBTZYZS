<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        ====================================================================
        Type Ramp - 字号大小系统
        遵循WPF最佳实践，为1920x1080优化
        格式: FontSize/LineHeight (单位: epx - 有效像素)
        ====================================================================
    -->
    <FontFamily x:Key="PrimaryFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>

    <!--  Caption: 12/16 epx  -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="LineHeightCaption">16</sys:Double>

    <!--  Body: 14/20 epx (默认正文)  -->
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="LineHeightBody">20</sys:Double>

    <!--  Subtitle: 20/28 epx  -->
    <sys:Double x:Key="FontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="LineHeightSubtitle">28</sys:Double>

    <!--  Title: 28/36 epx  -->
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>
    <sys:Double x:Key="LineHeightTitle">36</sys:Double>

    <!--  Display: 40/52 epx (大标题)  -->
    <sys:Double x:Key="FontSizeDisplay">40</sys:Double>
    <sys:Double x:Key="LineHeightDisplay">52</sys:Double>

    <!--  Large Display: 68/92 epx (重大标题)  -->
    <sys:Double x:Key="FontSizeLargeDisplay">68</sys:Double>
    <sys:Double x:Key="LineHeightLargeDisplay">92</sys:Double>

    <!--
        ====================================================================
        Spacing System - 间距系统
        所有间距基于4 epx的倍数
        ====================================================================
    -->
    <Thickness x:Key="SpacingXSmall">4</Thickness>
    <Thickness x:Key="SpacingSmall">8</Thickness>
    <Thickness x:Key="SpacingMedium">12</Thickness>
    <Thickness x:Key="SpacingLarge">16</Thickness>
    <Thickness x:Key="SpacingXLarge">24</Thickness>
    <Thickness x:Key="SpacingXXLarge">32</Thickness>

    <!--
        ====================================================================
        Corner Radius - 圆角半径系统
        ====================================================================
    -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>

    <!--
        ====================================================================
        Elevation System - 阴影系统 (Fluent Design)
        OpenSpec: refactor-master-detail-layout - UI优化
        ====================================================================
    -->
    <!--  卡片阴影效果 - 用于各类卡片  -->
    <DropShadowEffect
        x:Key="CardShadow"
        BlurRadius="12"
        Direction="270"
        Opacity="0.12"
        ShadowDepth="4"
        Color="#000000" />

    <!--  浮动层阴影效果 - 用于弹窗和菜单等  -->
    <DropShadowEffect
        x:Key="FloatingShadow"
        BlurRadius="16"
        Direction="270"
        Opacity="0.16"
        ShadowDepth="8"
        Color="#000000" />

    <!--  微妙阴影效果 - 用于分割线等  -->
    <DropShadowEffect
        x:Key="SubtleShadow"
        BlurRadius="4"
        Direction="270"
        Opacity="0.08"
        ShadowDepth="1"
        Color="#000000" />

    <!--
        ====================================================================
        颜色定义
        OpenSpec: migrate-to-handycontrol
        
        颜色资源由 App.xaml 统一加载:
        - HandyControl SkinDefault.xaml + Theme.xaml (基础颜色)
        - TCM.Theme.xaml (中医五行配色覆盖: PrimaryBrush, DangerBrush 等)
        
        此文件中的 StaticResource 引用通过 Application.Resources 解析
        ====================================================================
    -->

</ResourceDictionary>
