<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TCM (中医) 主题配色
        OpenSpec: migrate-to-handycontrol
        
        基于中医五行理论设计:
        - 木(绿): 生长、肝经、春季 → 主品牌色 PrimaryColor
        - 土(棕): 稳定、脾经、大地 → 强调色 AccentColor
        - 金(白): 纯净、肺经、秋收 → 背景色 BackgroundColor
        - 水(青): 宁静、肾经、智慧 → 侧边栏 SidebarColor (自定义)
        - 火(金): 温暖、心经、活力 → 标题色 TitleColor
        
        注意: 此文件仅覆盖HandyControl标准颜色键，不创建兼容别名
        所有控件应直接使用HandyControl标准资源键
    -->

    <!--  ==================== 覆盖 HandyControl 标准颜色 ====================  -->

    <!--  Primary Color (木绿 - 主品牌色)  -->
    <Color x:Key="LightPrimaryColor">#E8F5E9</Color>
    <Color x:Key="PrimaryColor">#2E8B57</Color>
    <Color x:Key="DarkPrimaryColor">#228B22</Color>

    <!--  Danger Color (保持HC默认，略微调整)  -->
    <Color x:Key="LightDangerColor">#FDE7E9</Color>
    <Color x:Key="DangerColor">#C75050</Color>
    <Color x:Key="DarkDangerColor">#A4262C</Color>

    <!--  Warning Color (火金色调)  -->
    <Color x:Key="LightWarningColor">#FFF8E1</Color>
    <Color x:Key="WarningColor">#DAA520</Color>
    <Color x:Key="DarkWarningColor">#B8860B</Color>

    <!--  Info Color (水青色调)  -->
    <Color x:Key="LightInfoColor">#E0F7FA</Color>
    <Color x:Key="InfoColor">#5B8FA8</Color>
    <Color x:Key="DarkInfoColor">#3D5A80</Color>

    <!--  Success Color (与Primary相同，木绿)  -->
    <Color x:Key="LightSuccessColor">#E8F5E9</Color>
    <Color x:Key="SuccessColor">#2E8B57</Color>
    <Color x:Key="DarkSuccessColor">#228B22</Color>

    <!--  Text Colors  -->
    <Color x:Key="PrimaryTextColor">#2D2D2D</Color>
    <Color x:Key="SecondaryTextColor">#666666</Color>
    <Color x:Key="ThirdlyTextColor">#999999</Color>
    <Color x:Key="ReverseTextColor">#2D2D2D</Color>
    <Color x:Key="TextIconColor">#FFFFFF</Color>

    <!--  Border Colors  -->
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="SecondaryBorderColor">#EEEEEE</Color>

    <!--  Region/Background Colors (金白色调)  -->
    <Color x:Key="BackgroundColor">#FAF8F5</Color>
    <Color x:Key="RegionColor">#FFFFFF</Color>
    <Color x:Key="SecondaryRegionColor">#F5F5F5</Color>
    <Color x:Key="ThirdlyRegionColor">#FFFFFF</Color>

    <!--  Title Colors (火金色调)  -->
    <Color x:Key="TitleColor">#B8860B</Color>
    <Color x:Key="SecondaryTitleColor">#DAA520</Color>

    <!--  Default Colors  -->
    <Color x:Key="DefaultColor">#FFFFFF</Color>
    <Color x:Key="DarkDefaultColor">#F5F5F5</Color>

    <!--  Accent Color (土棕色调)  -->
    <Color x:Key="AccentColor">#8B7355</Color>
    <Color x:Key="DarkAccentColor">#7A6548</Color>

    <!--  Mask/Opacity Colors  -->
    <Color x:Key="DarkMaskColor">#20000000</Color>
    <Color x:Key="DarkOpacityColor">#40000000</Color>

    <!--  Mask/Opacity Brushes (项目特有，HC不提供)  -->
    <SolidColorBrush x:Key="DarkMaskBrush" Color="{StaticResource DarkMaskColor}" />
    <SolidColorBrush x:Key="DarkOpacityBrush" Color="{StaticResource DarkOpacityColor}" />

    <!--  ==================== 项目自定义颜色 (非HC标准) ====================  -->

    <!--  侧边栏色 (水青 - 项目特有)  -->
    <Color x:Key="SidebarColor">#2B4162</Color>
    <Color x:Key="SidebarHoverColor">#3D5A80</Color>
    <Color x:Key="SidebarTextColor">#FFFFFF</Color>
    <Color x:Key="SidebarTextSecondaryColor">#9DB5CC</Color>
    <Color x:Key="SidebarAvatarColor">#5A8FBF</Color>
    <Color x:Key="SidebarDividerColor">#3D5A80</Color>

    <!--  侧边栏画刷  -->
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarSecondaryTextBrush" Color="{StaticResource SidebarTextSecondaryColor}" />
    <SolidColorBrush x:Key="SidebarAvatarBrush" Color="{StaticResource SidebarAvatarColor}" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="{StaticResource SidebarDividerColor}" />

    <!--  DataGrid专用色  -->
    <Color x:Key="DataGridAlternateRowColor">#F9F9F9</Color>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource DataGridAlternateRowColor}" />

    <!--  ==================== 标准 Brushes (确保存在，用于兼容性) ====================  -->

    <!--  Primary Brushes  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />

    <!--  Danger Brushes  -->
    <SolidColorBrush x:Key="LightDangerBrush" Color="{StaticResource LightDangerColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DarkDangerBrush" Color="{StaticResource DarkDangerColor}" />

    <!--  Warning Brushes  -->
    <SolidColorBrush x:Key="LightWarningBrush" Color="{StaticResource LightWarningColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DarkWarningBrush" Color="{StaticResource DarkWarningColor}" />

    <!--  Info Brushes  -->
    <SolidColorBrush x:Key="LightInfoBrush" Color="{StaticResource LightInfoColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="DarkInfoBrush" Color="{StaticResource DarkInfoColor}" />

    <!--  Success Brushes  -->
    <SolidColorBrush x:Key="LightSuccessBrush" Color="{StaticResource LightSuccessColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="{StaticResource DarkSuccessColor}" />

    <!--  Text Brushes  -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdlyTextColor}" />

    <!--  Region Brushes  -->
    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdlyRegionColor}" />

    <!--  Border Brushes  -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource SecondaryBorderColor}" />

    <!--  ==================== 项目特定设计Token ====================  -->

    <!--  圆角  -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>

    <!--  阴影效果  -->
    <DropShadowEffect
        x:Key="CardShadow"
        BlurRadius="12"
        Direction="270"
        Opacity="0.12"
        ShadowDepth="4"
        Color="#000000" />

    <DropShadowEffect
        x:Key="FloatingShadow"
        BlurRadius="16"
        Direction="270"
        Opacity="0.16"
        ShadowDepth="8"
        Color="#000000" />

    <!--  语义化颜色定义 - Phase 3 规范化添加  -->
    <!--  阴影  -->
    <Color x:Key="ShadowColor">#000000</Color>
    <SolidColorBrush
        x:Key="ShadowBrush"
        Opacity="0.12"
        Color="{StaticResource ShadowColor}" />

    <!--  验证/错误  -->
    <Color x:Key="ValidationErrorColor">#DC3545</Color>
    <Color x:Key="ValidationWarningColor">#FFC107</Color>
    <Color x:Key="ValidationSuccessColor">#28A745</Color>
    <SolidColorBrush x:Key="ValidationErrorBrush" Color="{StaticResource ValidationErrorColor}" />
    <SolidColorBrush x:Key="ValidationWarningBrush" Color="{StaticResource ValidationWarningColor}" />
    <SolidColorBrush x:Key="ValidationSuccessBrush" Color="{StaticResource ValidationSuccessColor}" />

    <!--  禁用状态  -->
    <Color x:Key="DisabledForegroundColor">#757575</Color>
    <Color x:Key="DisabledBackgroundColor">#F5F5F5</Color>
    <Color x:Key="DisabledBorderColor">#E0E0E0</Color>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="{StaticResource DisabledBorderColor}" />

    <!--  悬停/高亮  -->
    <Color x:Key="HoverBackgroundColor">#F5F5F5</Color>
    <Color x:Key="SelectedBackgroundColor">#E3F2FD</Color>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{StaticResource SelectedBackgroundColor}" />

    <!--  DataGrid 特定  -->
    <Color x:Key="DataGridAlternatingRowColor">#FAFAFA</Color>
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="{StaticResource DataGridAlternatingRowColor}" />

    <!--  边框/分割线  -->
    <Color x:Key="BorderLightColor">#E0E0E0</Color>
    <Color x:Key="BorderMediumColor">#BDBDBD</Color>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />

</ResourceDictionary>
