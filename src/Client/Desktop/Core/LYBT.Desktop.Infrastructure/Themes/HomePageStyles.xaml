<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        OpenSpec: migrate-to-handycontrol
        注意: 此资源字典需要合并TCM.Theme.xaml，因为内部样式使用了StaticResource引用颜色
        （DropShadowEffect.Color和GradientStop.Color不是DependencyProperty，必须用StaticResource）
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TCM.Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        HomePageStyles.xaml - 首页共享样式
        OpenSpec: cleanup-ui-dead-code

        用途: Admin/Clinical首页卡片样式
        从AdminHomeView和ClinicalHomeView提取的公共样式
    -->

    <!-- ========================================
         功能卡片样式 (Function Card Style)
         用于Admin和Clinical首页的功能入口卡片
         ======================================== -->
    <Style x:Key="FunctionCardStyle" TargetType="Border">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="180" />
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="8"
                    Opacity="0.1"
                    ShadowDepth="2"
                    Color="Black" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect
                            BlurRadius="16"
                            Opacity="0.2"
                            ShadowDepth="4"
                            Color="{StaticResource PrimaryColor}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========================================
         主功能卡片样式 (Primary Function Card Style)
         用于Clinical首页的主要操作入口（如开始接诊）
         ======================================== -->
    <Style x:Key="PrimaryFunctionCardStyle" TargetType="Border">
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="200" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="12"
                    Opacity="0.25"
                    ShadowDepth="3"
                    Color="{StaticResource PrimaryColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="{StaticResource LightPrimaryColor}" />
                    <GradientStop Offset="1" Color="{StaticResource DarkPrimaryColor}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================
         统计卡片样式 (Stats Card Style)
         用于Clinical首页的统计信息展示
         ======================================== -->
    <Style x:Key="StatsCardStyle" TargetType="Border">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="200" />
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="8"
                    Opacity="0.1"
                    ShadowDepth="2"
                    Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================
         卡片图标样式 (Card Icon Style)
         用于卡片内的图标显示
         ======================================== -->
    <Style x:Key="CardIconStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="56" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- ========================================
         卡片标题样式 (Card Title Style)
         用于卡片内的标题文字
         ======================================== -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
