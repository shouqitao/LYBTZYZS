<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ====================================================================
        Preview Styles - 预览界面统一样式
        OpenSpec: optimize-preview-layout
        用于所有ViewControl预览组件的布局和样式统一
        ====================================================================
    -->

    <!--  预览标题样式 - 实体名称/编号，大字体醒目显示  -->
    <Style x:Key="PreviewTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="#201F1E" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  预览副标题样式 - 次要标识信息  -->
    <Style x:Key="PreviewSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="#605E5C" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>

    <!--  预览头部容器样式 - 标题+Badge区域  -->
    <Style x:Key="PreviewHeaderStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!--  预览字段行样式 - 标签+值对容器  -->
    <Style x:Key="PreviewFieldRowStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--  预览分组标题样式  -->
    <Style x:Key="PreviewSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="#201F1E" />
        <Setter Property="Margin" Value="0,8,0,12" />
    </Style>

    <!--  预览分隔线样式  -->
    <Style x:Key="PreviewDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="#E1DFDD" />
        <Setter Property="Margin" Value="0,16,0,16" />
    </Style>

    <!--
        ====================================================================
        Status Badge Styles - 状态徽章样式
        ====================================================================
    -->

    <!--  Badge基础样式  -->
    <Style x:Key="PreviewBadgeBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Badge文字样式  -->
    <Style x:Key="PreviewBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!--  成功状态Badge - 绿色  -->
    <Style
        x:Key="PreviewBadgeSuccessStyle"
        BasedOn="{StaticResource PreviewBadgeBaseStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="#107C10" />
    </Style>

    <!--  信息状态Badge - 青色  -->
    <Style
        x:Key="PreviewBadgeInfoStyle"
        BasedOn="{StaticResource PreviewBadgeBaseStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="#00B7C3" />
    </Style>

    <!--  警告状态Badge - 橙色  -->
    <Style
        x:Key="PreviewBadgeWarningStyle"
        BasedOn="{StaticResource PreviewBadgeBaseStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="#F7630C" />
    </Style>

    <!--  默认状态Badge - 灰色  -->
    <Style
        x:Key="PreviewBadgeDefaultStyle"
        BasedOn="{StaticResource PreviewBadgeBaseStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="#8A8886" />
    </Style>

    <!--  主要状态Badge - 蓝色  -->
    <Style
        x:Key="PreviewBadgePrimaryStyle"
        BasedOn="{StaticResource PreviewBadgeBaseStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="#0078D4" />
    </Style>

    <!--
        ====================================================================
        Grid Layout Helpers - 网格布局辅助
        ====================================================================
    -->

    <!--  2列布局间距  -->
    <GridLength x:Key="PreviewColumnGap">40</GridLength>

    <!--  3列布局间距  -->
    <GridLength x:Key="PreviewColumnGapSmall">24</GridLength>

    <!--
        ====================================================================
        摘要信息样式 - 用于显示关键元数据
        ====================================================================
    -->

    <!--  摘要行容器样式  -->
    <Style x:Key="PreviewSummaryRowStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!--  摘要项样式  -->
    <Style x:Key="PreviewSummaryItemStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#605E5C" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  摘要分隔符样式  -->
    <Style x:Key="PreviewSummarySeparatorStyle" TargetType="TextBlock">
        <Setter Property="Text" Value=" | " />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#C8C6C4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        ====================================================================
        Herb Tags Display Styles - 药材标签云展示样式
        用于处方和验方的药材列表只读展示
        ====================================================================
    -->

    <!--  药材标签容器样式 - 淡蓝色背景更醒目  -->
    <Style x:Key="HerbTagStyle" TargetType="Border">
        <Setter Property="Background" Value="#E3F2FD" />
        <Setter Property="BorderBrush" Value="#90CAF9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MinWidth" Value="100" />
    </Style>

    <!--  药材名称文字样式  -->
    <Style x:Key="HerbTagNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  药材剂量文字样式  -->
    <Style x:Key="HerbTagDosageStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#666666" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!--  煎法标签样式 - 非默认煎法时显示  -->
    <Style x:Key="HerbTagDecocteStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFF3E0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  煎法文字样式  -->
    <Style x:Key="HerbTagDecocteTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#E65100" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  药材标签列表容器样式 (WrapPanel)  -->
    <Style x:Key="HerbTagsContainerStyle" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

</ResourceDictionary>
