<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Infrastructure</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - WPF基础设施库 | 主题、控件、工具类 | Issue #815 Phase 1</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-infrastructure</InformationalVersion>

    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Infrastructure</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT WPF基础设施 - 主题系统、自定义控件、UI工具类库</PackageDescription>
    <PackageTags>WPF;UI;Infrastructure;中医;诊所;主题;控件</PackageTags>
  </PropertyGroup>

  <!-- WPF Framework Dependencies -->
  <!-- OpenSpec: refactor-viewmodel-composition - CommunityToolkit.Mvvm源生成器支持 -->
  <ItemGroup Label="WPF Framework">
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="HandyControl" />
    <PackageReference Include="NPOI" />
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.Wpf" />
    <!-- OpenSpec: adopt-mapperly-unified-mapping - 编译时映射源生成器 -->
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <!-- Configuration -->
  <ItemGroup Label="Configuration">
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- refactor-logging-system: Serilog日志集成 -->
  <ItemGroup Label="Logging">
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Shared Libraries">
    <!-- OpenSpec: optimize-desktop-core - 添加Components引用支持IHerbItemEditable -->
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Components\LYBT.Shared.Components.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.ExceptionHandling\LYBT.Shared.ExceptionHandling.csproj" />
    <!-- unify-logging-system: 统一日志系统 -->
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Logging\LYBT.Shared.Logging.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Utilities\LYBT.Shared.Utilities.csproj" />
  </ItemGroup>

  <!-- Core Dependencies -->
  <ItemGroup Label="Core Dependencies">
    <ProjectReference Include="..\LYBT.Desktop.Foundation\LYBT.Desktop.Foundation.csproj" />
    <!-- OpenSpec: implement-local-mode - DataSource 实现需要 Contracts 接口和 Entities -->
    <ProjectReference Include="..\LYBT.Desktop.Contracts\LYBT.Desktop.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\Server\Core\LYBT.Entities\LYBT.Entities.csproj" />
  </ItemGroup>

  <!-- Core_New Dependencies -->
  <ItemGroup Label="Core_New Dependencies">
  </ItemGroup>

</Project>