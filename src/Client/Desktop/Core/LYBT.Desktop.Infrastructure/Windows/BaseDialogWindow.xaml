<!--
    BaseDialogWindow - 基础对话框窗口
    统一所有Dialog的样式和行为
-->
<Window x:Class="LYBT.Desktop.Infrastructure.Windows.BaseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Background="{DynamicResource MaterialDesign.Brush.Paper}"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Controls;component/Themes/UnifiedComponents.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="{DynamicResource MaterialDesign.Brush.Paper}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}"
            BorderThickness="1">
        <ContentControl Content="{Binding}" />
    </Border>
</Window>
