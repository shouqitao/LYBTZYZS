<UserControl x:Class="LYBT.Desktop.Infrastructure.Navigation.Controls.NavigationHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nav="clr-namespace:LYBT.Desktop.Infrastructure.Navigation.Controls"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LYBT.Desktop.Infrastructure;component/Themes/NavigationHistoryPanelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converter for timestamp formatting -->
            <converters:TimestampFormatConverter x:Key="TimestampConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Navigation History Panel -->
    <Grid>
        <!-- Empty State -->
        <TextBlock Text="暂无导航历史"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="14"
                   Visibility="{Binding HasHistory, Converter={x:Static converters:Cvt.InverseBoolToVis}}"/>

        <!-- History List -->
        <ListBox ItemsSource="{Binding History}"
                 SelectedItem="{Binding SelectedEntry}"
                 Style="{DynamicResource NavigationHistoryPanelStyle}"
                 Visibility="{Binding HasHistory, Converter={x:Static converters:Cvt.BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="nav:NavigationEntry">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DataContext.GetNavigationIcon(Uri), RelativeSource={RelativeSource AncestorType=ListBox, Mode=FindAncestor}, Mode=OneWay, Converter={StaticResource ResourceKey=IconConverter}}"
                                       FontSize="18"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>

                            <!-- Title -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       Style="{DynamicResource HistoryItemTitleStyle}"/>
                        </Grid>

                        <!-- Timestamp Row -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Timestamp, Converter={StaticResource TimestampConverter}}"
                                   Style="{DynamicResource HistoryItemTimestampStyle}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>
