<UserControl x:Class="LYBT.Desktop.Infrastructure.Navigation.Controls.BreadcrumbControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nav="clr-namespace:LYBT.Desktop.Infrastructure.Navigation.Controls"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LYBT.Desktop.Infrastructure;component/Themes/BreadcrumbStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Breadcrumb Control -->
    <ItemsControl ItemsSource="{Binding Items}"
                  Style="{DynamicResource BreadcrumbControlStyle}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="nav:BreadcrumbItem">
                <ContentControl Style="{DynamicResource BreadcrumbItemContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Active Breadcrumb (Not clickable) -->
                        <TextBlock Text="{Binding Title}"
                                   Style="{DynamicResource BreadcrumbTextStyle_Active}"
                                   Visibility="{Binding IsActive, Converter={x:Static converters:Cvt.BoolToVis}}"/>

                        <!-- Non-Active Breadcrumb (Clickable) -->
                        <Button Content="{Binding Title}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{DynamicResource BreadcrumbButtonStyle}"
                                Visibility="{Binding IsActive, Converter={x:Static converters:Cvt.InverseBoolToVis}}"/>
                    </StackPanel>
                </ContentControl>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
