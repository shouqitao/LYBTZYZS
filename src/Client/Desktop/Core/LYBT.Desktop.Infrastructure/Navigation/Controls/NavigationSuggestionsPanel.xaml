<UserControl x:Class="LYBT.Desktop.Infrastructure.Navigation.Controls.NavigationSuggestionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nav="clr-namespace:LYBT.Desktop.Infrastructure.Navigation.Controls"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LYBT.Desktop.Infrastructure;component/Themes/NavigationSuggestionsPanelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:SuggestionTypeColorConverter x:Key="SuggestionTypeColorConverter"/>
            <converters:SuggestionTypeTextConverter x:Key="SuggestionTypeTextConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Navigation Suggestions Panel -->
    <Grid>
        <!-- Empty State -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasSuggestions, Converter={x:Static converters:Cvt.InverseBoolToVis}}">
            <TextBlock Text="🔗"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       Opacity="0.5"/>
            <TextBlock Text="暂无导航建议"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="14"/>
        </StackPanel>

        <!-- Suggestions List -->
        <ListBox ItemsSource="{Binding Suggestions}"
                 SelectedItem="{Binding SelectedSuggestion}"
                 Style="{DynamicResource NavigationSuggestionsPanelStyle}"
                 Visibility="{Binding HasSuggestions, Converter={x:Static converters:Cvt.BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="nav:NavigationSuggestion">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title and Reason Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <TextBlock Grid.Column="0"
                                       Text="💡"
                                       FontSize="16"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>

                            <!-- Content -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Type Badge -->
                            <Border Grid.Column="2"
                                    Background="{Binding Type, Converter={StaticResource SuggestionTypeColorConverter}}"
                                    Padding="6,2"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Type, Converter={StaticResource SuggestionTypeTextConverter}}"
                                           Style="{DynamicResource SuggestionTypeTextStyle}"/>
                            </Border>
                        </Grid>

                        <!-- Reason Row -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Reason}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="28,0,0,0"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Loading Indicator -->
        <Grid Background="White"
              Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="⏳"
                           FontSize="32"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="加载建议中..."
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="14"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
