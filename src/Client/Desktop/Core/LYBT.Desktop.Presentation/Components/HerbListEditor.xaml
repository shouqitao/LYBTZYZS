<UserControl x:Class="LYBT.Desktop.Presentation.Components.HerbListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LYBT.Desktop.Presentation.Components"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="800">
    <!--
    HerbListEditor - 药材列表编辑器控件
    OpenSpec: unify-medicalcase-view-edit-pattern - Task 2.2

    功能：
    - 使用ItemsControl + UniformGrid(Columns=4)展示药材卡片
    - 内部复用HerbCardControl作为ItemTemplate
    - 支持编辑/只读模式切换
    - UI只显示药材名+剂量（不显示价格）

    使用方式：
    <components:HerbListEditor
        HerbItems="{Binding HerbItems}"
        IsEditMode="{Binding IsEditMode}"
        DeleteHerbCommand="{Binding DeleteHerbCommand}"
        DosageCompletedCommand="{Binding DosageCompletedCommand}"
        AddNewRowCommand="{Binding AddNewRowCommand}" />
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 用于空状态提示 -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- 药材列表 -->
        <ItemsControl x:Name="HerbItemsControl"
                      ItemsSource="{Binding HerbItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 4列均匀分布，VerticalAlignment=Top防止拉伸 -->
                    <UniformGrid Columns="4" VerticalAlignment="Top" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 复用HerbCardControl -->
                    <local:HerbCardControl
                        IsEditMode="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ShowPrice="False"
                        DeleteCommand="{Binding DeleteHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        DosageCompletedCommand="{Binding DosageCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        AddNewRowCommand="{Binding AddNewRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态提示 - 仅在只读模式且无药材时显示 -->
        <TextBlock x:Name="EmptyPlaceholder"
                   Text="暂无药材"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="#999"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
