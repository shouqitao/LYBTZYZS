<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Presentation</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - UI基础设施层 | 导航、通知、主题、用户体验、打印 | Issue #1114 Phase 1</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0-presentation</InformationalVersion>

    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Presentation</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT Desktop UI基础设施 - 导航服务、通知服务、主题管理、用户体验优化、打印服务</PackageDescription>
    <PackageTags>Presentation;Navigation;Notifications;Theming;UX;Print;WPF;中医;诊所</PackageTags>
  </PropertyGroup>

  <!-- Prism Framework -->
  <ItemGroup Label="Prism Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.Wpf" />
  </ItemGroup>

  <!-- WPF and UI -->
  <ItemGroup Label="WPF and UI">
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Desktop Dependencies">
    <ProjectReference Include="..\LYBT.Desktop.Foundation\LYBT.Desktop.Foundation.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Interfaces\LYBT.Shared.Interfaces.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Utilities\LYBT.Shared.Utilities.csproj" />
  </ItemGroup>

</Project>
