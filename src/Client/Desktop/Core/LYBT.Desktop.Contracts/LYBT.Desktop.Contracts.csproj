<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- A-18 P1-1: Refit Api 接口 internal 化后，仅实现层（Foundation）与测试可见 -->
  <ItemGroup Label="Internal Visibility">
    <InternalsVisibleTo Include="LYBT.Desktop.Foundation" />
    <InternalsVisibleTo Include="LYBT.Tests.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Refit" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.Wpf" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Events\SyncEvents.cs" />
    <Compile Remove="Events\CacheEvents.cs" />
    <Compile Remove="Services\IViewModelServices.cs" />
    <Compile Remove="Services\IUiThreadDispatcher.cs" />
    <!-- MedicalCaseNavigationParameters 继承 Prism.Regions.NavigationParameters，仅桌面目标可用 -->
    <Compile Remove="Models\MedicalCaseNavigationParameters.cs" />
    <!-- BreadcrumbItem 含 ICommand（WPF 类型）；INavigationCoordinator 引用它（导航协调器为 Desktop UI 概念，实现全在 net8.0-windows 的 Infrastructure） -->
    <Compile Remove="UI\BreadcrumbItem.cs" />
    <Compile Remove="Services\INavigationCoordinator.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
  </ItemGroup>

</Project>
