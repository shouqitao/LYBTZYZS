<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8622;CS1570;CS1587;NU1903</NoWarn>
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Core</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - WPF核心基础设施库 | UltraThink架构支撑 | 企业级组件集成</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-core-enterprise</InformationalVersion>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Core</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT WPF核心基础设施 - MVVM基础、UI组件、服务接口、工具类库 | UltraThink架构标准</PackageDescription>
    <PackageTags>WPF;MVVM;中医;诊所;核心;基础设施;UltraThink;企业级</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>bin\Debug\net8.0-windows\LYBT.Desktop.Core.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>bin\Release\net8.0-windows\LYBT.Desktop.Core.xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- WPF Framework Dependencies -->
  <ItemGroup Label="WPF Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Prism.Wpf" />
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <!-- Configuration and Validation -->
  <ItemGroup Label="Configuration">
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <!-- Serialization and Data Processing -->
  <ItemGroup Label="Data Processing">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NPOI" />
    <PackageReference Include="AutoMapper" />
  </ItemGroup>

  <!-- Resilience and Performance -->
  <ItemGroup Label="Resilience">
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\src\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
    <ProjectReference Include="..\..\..\..\src\Shared\LYBT.Shared.Interfaces\LYBT.Shared.Interfaces.csproj" />
    <ProjectReference Include="..\..\..\..\src\Shared\LYBT.Shared.Utilities\LYBT.Shared.Utilities.csproj" />
  </ItemGroup>

  <!-- Resource Files -->
  <ItemGroup Label="Documentation">
    <None Include="README.md" />
  </ItemGroup>

</Project>