<Window x:Class="LYBT.Desktop.Core.Views.Dialogs.CriticalErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding WindowTitle}" 
        Width="600" 
        Height="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0" Background="#F44336" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="❌" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="严重错误" 
                              FontSize="18" 
                              FontWeight="Bold" 
                              Foreground="White"/>
                    <TextBlock Text="系统遇到了严重问题，请查看详细信息并联系技术支持" 
                              FontSize="12" 
                              Foreground="White" 
                              Opacity="0.9"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" Margin="15" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 用户消息 -->
                <TextBlock Text="错误描述：" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                <Border Background="#FFF3E0"
                        BorderBrush="#FFB74D"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,0,0,15">
                    <TextBlock Text="{Binding UserMessage}" 
                              TextWrapping="Wrap"/>
                </Border>

                <!-- 建议操作 -->
                <TextBlock Text="建议操作：" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                <ItemsControl ItemsSource="{Binding SuggestedActions}" Margin="0,0,0,15">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="• " FontWeight="Bold"/>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 详细信息 -->
                <Expander Header="详细技术信息" IsExpanded="False" Margin="0,0,0,10">
                    <StackPanel Margin="15,10,0,0">
                        <TextBlock Text="错误类型：" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding ErrorType}" 
                                  Margin="0,0,0,10" 
                                  FontFamily="Consolas"
                                  FontSize="11"/>

                        <TextBlock Text="错误时间：" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding Timestamp}" 
                                  Margin="0,0,0,10"
                                  FontSize="11"/>

                        <TextBlock Text="错误ID：" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding ErrorId}" 
                                  Margin="0,0,0,10"
                                  FontFamily="Consolas"
                                  FontSize="10"/>

                        <TextBlock Text="技术详情：" FontWeight="Bold" FontSize="12"/>
                        <TextBox Text="{Binding TechnicalDetails}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                FontFamily="Consolas"
                                FontSize="10"
                                Background="#F5F5F5"
                                Height="120"
                                Margin="0,0,0,10"/>

                        <TextBlock Text="堆栈跟踪：" FontWeight="Bold" FontSize="12"/>
                        <TextBox Text="{Binding StackTrace}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                FontFamily="Consolas"
                                FontSize="9"
                                Background="#F5F5F5"
                                Height="150"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CopyButtonText}"
                       Width="120"
                       Height="32"
                       Margin="0,0,10,0"
                       Command="{Binding CopyCommand}"
                       IsEnabled="{Binding IsCopyEnabled}"/>
                
                <Button Content="报告问题"
                       Width="100"
                       Height="32"
                       Margin="0,0,10,0"
                       Command="{Binding ReportCommand}"/>
                
                <Button Content="关闭"
                       Width="80"
                       Height="32"
                       IsDefault="True"
                       Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>