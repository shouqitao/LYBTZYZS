<Window x:Class="LYBT.Desktop.Core.Views.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印预览" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/Icons/Actions/icon-print-24.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 打印预览内容 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border Background="White" Margin="20" Padding="40"
                    BorderBrush="LightGray" BorderThickness="1"
                    Effect="{DynamicResource DropShadowBrush}">
                <TextBlock Name="PreviewTextBlock"
                           FontFamily="宋体" FontSize="14" LineHeight="18"
                           TextWrapping="Wrap" Foreground="Black" />
            </Border>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="10">
            <Button Name="PrintButton" Content="打印" Padding="15,5"
                    Click="PrintButton_Click" IsDefault="True" Margin="0,0,10,0" />
            <Button Name="SaveButton" Content="保存为文件" Padding="15,5"
                    Click="SaveButton_Click" Margin="0,0,10,0" />
            <Button Name="CloseButton" Content="关闭" Padding="15,5"
                    Click="CloseButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
