<UserControl x:Class="LYBT.Desktop.Printing.Templates.PrescriptionPrintA4Template"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:LYBT.Desktop.Printing.Models"
             mc:Ignorable="d"
             Width="794" Height="1123"
             d:DataContext="{d:DesignInstance Type=models:PrescriptionPrintModel, IsDesignTimeCreatable=True}"
             Background="White">
    <!--
    A4纸张尺寸: 210mm x 297mm
    96 DPI: 1mm = 3.78px
    宽度: 210 * 3.78 = 794px
    高度: 297 * 3.78 = 1123px
    边距: 15mm(57px) 全方位
    内容区宽度: 794 - 57*2 = 680px
    字体: SimSun(宋体), PRD 规格:
      诊所名称 18pt 加粗, 科室 14pt, 正文 11pt, 辅助 10pt
    -->

    <UserControl.Resources>
        <FontFamily x:Key="PrintFont">SimSun, 宋体, Microsoft YaHei</FontFamily>

        <!-- 诊所名称样式: A4 18pt (A5 16pt) -->
        <Style x:Key="ClinicNameStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 诊所信息样式: A4 10pt (A5 8pt) -->
        <Style x:Key="ClinicInfoStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- 标题样式: A4 17pt (A5 15pt) -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,8"/>
        </Style>

        <!-- 标签样式: A4 11pt (A5 10.5pt) -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- 下划线字段容器样式 -->
        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- 字段值文本样式: A4 11pt (A5 10.5pt) -->
        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
        </Style>

        <!-- 诊断标签样式: A4 10pt (A5 9.5pt) -->
        <Style x:Key="DiagnosisLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="#444444"/>
        </Style>

        <!-- Rp样式: A4 12pt (A5 11pt) -->
        <Style x:Key="RpStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,6"/>
        </Style>

        <!-- 药材项样式: A4 11pt, 宽 135px (A5 10.5pt, 95px) -->
        <Style x:Key="HerbItemStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="135"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 用法样式: A4 11pt (A5 10.5pt) -->
        <Style x:Key="UsageStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <!-- 医嘱样式: A4 10pt (A5 9.5pt) -->
        <Style x:Key="AdviceStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PrintFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </UserControl.Resources>

    <!-- 边距: A4 15mm(57px) (A5 8mm/30px) -->
    <Grid Margin="57,57,57,57">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: 诊所信息 -->
            <RowDefinition Height="Auto"/>  <!-- 1: 标题 -->
            <RowDefinition Height="Auto"/>  <!-- 2: 患者信息行1 -->
            <RowDefinition Height="Auto"/>  <!-- 3: 患者信息行2 -->
            <RowDefinition Height="Auto"/>  <!-- 4: 住址 -->
            <RowDefinition Height="Auto"/>  <!-- 5: 诊断 -->
            <RowDefinition Height="Auto"/>  <!-- 6: 四诊区域 -->
            <RowDefinition Height="Auto"/>  <!-- 7: 诊见(症状综合) -->
            <RowDefinition Height="Auto"/>  <!-- 8: Rp. + 药材 + 服法 + 医嘱 -->
            <RowDefinition Height="*"/>     <!-- 9: 空白填充 -->
            <RowDefinition Height="Auto"/>  <!-- 10: 分隔线 -->
            <RowDefinition Height="Auto"/>  <!-- 11: 签名行 -->
            <RowDefinition Height="Auto"/>  <!-- 12: 费用行 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 诊所信息 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource ClinicNameStyle}" Text="{Binding ClinicName, Mode=OneWay}"/>
            <TextBlock Style="{StaticResource ClinicInfoStyle}">
                <Run Text="{Binding ClinicAddress, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding ClinicPhone, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <!-- Row 1: 标题 -->
        <TextBlock Grid.Row="1" Style="{StaticResource TitleStyle}" Text="普通处方笺"/>

        <!-- Row 2: 姓名/性别/年龄/时间 -->
        <Grid Grid.Row="2" Height="24" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="姓名："/>
            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding PatientName}"/>
            </Border>
            <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="  性别："/>
            <Border Grid.Column="3" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding Gender}"/>
            </Border>
            <TextBlock Grid.Column="4" Style="{StaticResource LabelStyle}" Text="  年龄："/>
            <Border Grid.Column="5" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding Age, StringFormat={}{0}岁}"/>
            </Border>
            <TextBlock Grid.Column="6" Style="{StaticResource LabelStyle}" Text="  时间："/>
            <Border Grid.Column="7" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ConsultationDate, StringFormat=yyyy年M月d日}"/>
            </Border>
        </Grid>

        <!-- Row 3: 门诊号/科别/电话 -->
        <Grid Grid.Row="3" Height="24" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="门诊号："/>
            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding OutpatientNumber}"/>
            </Border>
            <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="  科别："/>
            <Border Grid.Column="3" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding Department}"/>
            </Border>
            <TextBlock Grid.Column="4" Style="{StaticResource LabelStyle}" Text="  电话："/>
            <Border Grid.Column="5" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding PatientPhone}"/>
            </Border>
        </Grid>

        <!-- Row 4: 住址 -->
        <Grid Grid.Row="4" Height="24" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="住址："/>
            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding PatientAddress}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- Row 5: 诊断 -->
        <Grid Grid.Row="5" Height="24" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="诊断："/>
            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding TcmDiagnosis}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- Row 6: 四诊区域 (望/闻/舌/脉) -->
        <Grid Grid.Row="6" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 望诊 + 闻诊 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DiagnosisLabelStyle}" Text="望诊："/>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" FontSize="10"
                           Text="{Binding InspectionDiagnosis}" TextTrimming="CharacterEllipsis"/>
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource DiagnosisLabelStyle}" Text="  闻诊："/>
            <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" FontSize="10"
                           Text="{Binding AuscultationDiagnosis}" TextTrimming="CharacterEllipsis"/>
            </Border>
            <!-- 舌诊 + 脉诊 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DiagnosisLabelStyle}" Text="舌诊："/>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" FontSize="10"
                           Text="{Binding TongueDiagnosis}" TextTrimming="CharacterEllipsis"/>
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource DiagnosisLabelStyle}" Text="  脉诊："/>
            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" FontSize="10"
                           Text="{Binding PulseDiagnosis}" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- Row 7: 诊见(症状综合) -->
        <Grid Grid.Row="7" Height="24" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="诊见："/>
            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding SymptomsText}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- Row 8: 处方内容 (Rp. + 药材 + 服法 + 医嘱) -->
        <StackPanel Grid.Row="8">
            <TextBlock Style="{StaticResource RpStyle}" Text="Rp."/>
            <ItemsControl x:Name="HerbsItemsControl" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource HerbItemStyle}">
                            <Run Text="{Binding HerbName, Mode=OneWay}"/><Run Text="{Binding Dosage, StringFormat={}{0:0.##}, Mode=OneWay}"/><Run Text="{Binding Unit, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 服法 -->
            <TextBlock Style="{StaticResource UsageStyle}">
                <Run Text="{Binding DosageCount, Mode=OneWay}"/><Run Text="剂，"/><Run Text="{Binding Usage, Mode=OneWay}"/>
            </TextBlock>
            <!-- 医嘱 -->
            <TextBlock Style="{StaticResource AdviceStyle}" Text="{Binding Advice, Mode=OneWay}"/>
        </StackPanel>

        <!-- Row 9: 弹性空白填充 -->
        <Border Grid.Row="9"/>

        <!-- Row 10: 分隔线 -->
        <Border Grid.Row="10" BorderBrush="Black" BorderThickness="0,0,0,1.5" Margin="0,0,0,6"/>

        <!-- Row 11: 签名行 -->
        <Grid Grid.Row="11" Height="24" Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="医师签字："/>
            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding DoctorName}"/>
            </Border>
            <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="  审核："/>
            <Border Grid.Column="3" Style="{StaticResource FieldBorderStyle}"/>
            <TextBlock Grid.Column="4" Style="{StaticResource LabelStyle}" Text="  调配："/>
            <Border Grid.Column="5" Style="{StaticResource FieldBorderStyle}"/>
        </Grid>

        <!-- Row 12: 费用行 -->
        <Grid Grid.Row="12" Height="24" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="诊疗费："/>
            <Border Grid.Column="1" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ConsultationFee, StringFormat={}{0:F0}}"/>
            </Border>
            <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="  药费："/>
            <Border Grid.Column="3" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding MedicineFee, StringFormat={}{0:F0}}"/>
            </Border>
            <TextBlock Grid.Column="4" Style="{StaticResource LabelStyle}" Text="  折扣："/>
            <Border Grid.Column="5" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding Discount, StringFormat={}{0:P0}}"/>
            </Border>
            <TextBlock Grid.Column="6" Style="{StaticResource LabelStyle}" Text="  合计："/>
            <Border Grid.Column="7" Style="{StaticResource FieldBorderStyle}">
                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding TotalPrice, StringFormat={}{0:F0}}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
