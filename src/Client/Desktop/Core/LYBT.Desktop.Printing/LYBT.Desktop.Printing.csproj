<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Printing</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 打印服务模块 | OpenSpec: create-printing-module</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright (c) 凌隐宝堂中医诊所 2025</AssemblyCopyright>

    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Printing</PackageId>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT WPF打印服务 - 通用打印、预览、导出功能</PackageDescription>
    <PackageTags>WPF;Printing;FixedDocument;XPS;中医;诊所</PackageTags>
  </PropertyGroup>

  <!-- WPF Framework Dependencies -->
  <ItemGroup Label="WPF Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Core Dependencies -->
  <ItemGroup Label="Core Dependencies">
    <ProjectReference Include="..\LYBT.Desktop.Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
  </ItemGroup>

</Project>
