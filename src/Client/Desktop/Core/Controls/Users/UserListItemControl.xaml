<UserControl x:Class="LYBT.WPF.Client.Controls.Users.UserListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="800">
    
    <Border BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F5F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 头像 -->
            <Border Grid.Column="0"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Background="#2E86AB"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <TextBlock Text="{Binding Data.Username, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource FirstCharacterConverter}}"
                          FontSize="16"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

            <!-- 用户名 -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Data.Username, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <!-- 真实姓名 -->
            <TextBlock Grid.Column="2"
                       Text="{Binding Data.RealName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="14"
                       VerticalAlignment="Center"/>

            <!-- 角色 -->
            <Border Grid.Column="3"
                    Background="#E3F2FD" 
                    CornerRadius="12" 
                    Padding="12,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <TextBlock Text="{Binding Data.Role, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                          FontSize="12"
                          Foreground="#1976D2"/>
            </Border>

            <!-- 状态 -->
            <Border Grid.Column="4"
                    CornerRadius="12" 
                    Padding="12,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Data.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Text" Value="启用"/>
                                    <Setter Property="Foreground" Value="#388E3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Text" Value="禁用"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 联系方式 -->
            <TextBlock Grid.Column="5"
                       Text="{Binding Data.Email, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="12"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="7"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="编辑"
                        Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Data, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                      Fill="#666" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DataContext.ToggleUserStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding Data, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="ToolTip" Value="禁用"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="ToolTip" Value="启用"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Width="16" 
                                      Height="16"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Data.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <!-- 禁用图标 -->
                                                    <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M7,10L17,10L17,14L7,14Z"/>
                                                    <Setter Property="Fill" Value="#F44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Data.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                    <!-- 启用图标 -->
                                                    <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M10,16.5L16,12L10,7.5"/>
                                                    <Setter Property="Fill" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>