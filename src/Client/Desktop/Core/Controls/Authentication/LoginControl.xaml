<UserControl x:Class="LYBT.WPF.Client.Controls.Authentication.LoginControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400">
    <Grid>
        <Border Background="White" 
            CornerRadius="8" 
            Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="5" Opacity="0.2" BlurRadius="10"/>
        </Border.Effect>
        
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题Logo -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <Border Width="80" Height="80" 
                        CornerRadius="40"
                        Background="#2E86AB"
                        HorizontalAlignment="Center">
                    <TextBlock Text="凌" 
                               FontSize="36" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="凌隐宝堂中医诊所" 
                          FontSize="22" 
                          FontWeight="Bold" 
                          Foreground="#2E86AB" 
                          HorizontalAlignment="Center"
                          Margin="0,12,0,0"/>
                <TextBlock Text="诊疗管理系统" 
                          FontSize="14" 
                          Foreground="#666" 
                          HorizontalAlignment="Center" 
                          Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 用户名输入 -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="用户名" 
                          FontSize="14" 
                          Foreground="#333" 
                          Margin="0,0,0,8"/>
                <Border BorderBrush="#DDD" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="#F5F5F5" 
                                Padding="12,0"
                                BorderBrush="#DDD"
                                BorderThickness="0,0,1,0">
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                  Fill="#666" 
                                  Width="16" 
                                  Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        
                        <TextBox Grid.Column="1"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0"
                                 Padding="12,10"
                                 FontSize="14"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 密码输入 -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="密码" 
                          FontSize="14" 
                          Foreground="#333" 
                          Margin="0,0,0,8"/>
                <Border BorderBrush="#DDD" 
                        BorderThickness="1" 
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="#F5F5F5" 
                                Padding="12,0"
                                BorderBrush="#DDD"
                                BorderThickness="0,0,1,0">
                            <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" 
                                  Fill="#666" 
                                  Width="16" 
                                  Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        
                        <PasswordBox Grid.Column="1"
                                     x:Name="PasswordBox"
                                     BorderThickness="0"
                                     Padding="12,10"
                                     FontSize="14"
                                     VerticalAlignment="Center">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 记住我 -->
            <CheckBox Grid.Row="6" 
                      Content="记住我" 
                      IsChecked="{Binding RememberMe}" 
                      FontSize="14" 
                      Foreground="#666"/>

            <!-- 登录按钮 -->
            <Button Grid.Row="8" 
                    Content="登 录" 
                    Height="44" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    Background="#2E86AB" 
                    Foreground="White" 
                    BorderThickness="0"
                    Command="{Binding LoginCommand}"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F5F99"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#164A7B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 错误消息 -->
            <Border Grid.Row="10" 
                    Background="#FFEBEE"
                    CornerRadius="4"
                    Padding="12,8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" 
                          Foreground="#D32F2F" 
                          FontSize="13" 
                          TextWrapping="Wrap"/>
            </Border>

            <!-- 底部链接 -->
            <StackPanel Grid.Row="11" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom">
                <Button Content="忘记密码？"
                        Command="{Binding ForgotPasswordCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#2E86AB"
                        Cursor="Hand"
                        Margin="0,0,16,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                      TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button Content="系统设置"
                        Command="{Binding SystemSettingsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#2E86AB"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}"
                                      TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    
    <!-- 加载遮罩 -->
    <Grid Background="#80000000" 
          Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Background="White" 
                CornerRadius="8" 
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <ProgressBar IsIndeterminate="True" 
                            Width="200" 
                            Height="4"/>
                <TextBlock Text="正在登录..." 
                          FontSize="14" 
                          HorizontalAlignment="Center" 
                          Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>