<UserControl x:Class="LYBT.Desktop.Core.Controls.GlobalStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LYBT.Desktop.Core.Controls"
             mc:Ignorable="d"
             Height="32">

    <UserControl.Resources>
        <!-- 状态样式 -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>

        <!-- 成功状态样式 -->
        <Style x:Key="SuccessStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
            <Setter Property="Foreground" Value="#2E7D32" />
        </Style>

        <!-- 错误状态样式 -->
        <Style x:Key="ErrorStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
            <Setter Property="Foreground" Value="#D32F2F" />
        </Style>

        <!-- 警告状态样式 -->
        <Style x:Key="WarningStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
            <Setter Property="Foreground" Value="#F57C00" />
        </Style>

        <!-- 信息状态样式 -->
        <Style x:Key="InfoStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
            <Setter Property="Foreground" Value="#1976D2" />
        </Style>

        <!-- 进度条样式 -->
        <Style x:Key="StatusProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="#4CAF50" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 加载指示器动画 -->
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingEllipse"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                           From="0" To="360" Duration="0:0:1" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <!-- 加载状态触发器 -->
        <DataTrigger Binding="{Binding IsGlobalLoading, RelativeSource={RelativeSource Self}}" Value="True">
            <DataTrigger.EnterActions>
                <BeginStoryboard x:Name="LoadingStoryboard">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="LoadingEllipse"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                    </Storyboard>
                </BeginStoryboard>
            </DataTrigger.EnterActions>
            <DataTrigger.ExitActions>
                <StopStoryboard BeginStoryboardName="LoadingStoryboard" />
            </DataTrigger.ExitActions>
        </DataTrigger>
    </UserControl.Triggers>

    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 状态栏内容 -->
            <Grid Grid.Row="0" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 加载指示器 -->
                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           Visibility="{Binding IsGlobalLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse x:Name="LoadingEllipse"
                             Width="16" Height="16"
                             Stroke="#4CAF50"
                             StrokeThickness="2"
                             StrokeDashArray="8 4"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="{Binding LoadingMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource StatusTextStyle}" />
                </StackPanel>

                <!-- 状态消息 -->
                <Grid Grid.Column="1">
                    <!-- 成功消息 -->
                    <TextBlock Text="{Binding StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource SuccessStatusStyle}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{x:Static local:FeedbackTypeToVisibilityConverter.Instance}">
                                <Binding Path="CurrentFeedbackType" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                <Binding Source="Success" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- 错误消息 -->
                    <TextBlock Text="{Binding StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource ErrorStatusStyle}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{x:Static local:FeedbackTypeToVisibilityConverter.Instance}">
                                <Binding Path="CurrentFeedbackType" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                <Binding Source="Error" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- 警告消息 -->
                    <TextBlock Text="{Binding StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource WarningStatusStyle}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{x:Static local:FeedbackTypeToVisibilityConverter.Instance}">
                                <Binding Path="CurrentFeedbackType" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                <Binding Source="Warning" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- 信息消息 -->
                    <TextBlock Text="{Binding StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource InfoStatusStyle}">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{x:Static local:FeedbackTypeToVisibilityConverter.Instance}">
                                <Binding Path="CurrentFeedbackType" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                <Binding Source="Info" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>

                <!-- 进度显示 -->
                <TextBlock Grid.Column="2"
                           Text="{Binding OperationProgress, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0}%}"
                           Style="{StaticResource StatusTextStyle}"
                           Visibility="{Binding IsGlobalLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- 系统状态 -->
                <TextBlock Grid.Column="3"
                           Text="{Binding Source={x:Static local:SystemTimeProvider.Instance}, Path=CurrentTime, StringFormat=HH:mm:ss}"
                           Style="{StaticResource StatusTextStyle}"
                           Foreground="#888888" />
            </Grid>

            <!-- 进度条 -->
            <ProgressBar Grid.Row="1"
                         Style="{StaticResource StatusProgressBarStyle}"
                         Value="{Binding OperationProgress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Visibility="{Binding IsGlobalLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
