<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ====================================== -->
    <!-- Icon Resources Dictionary -->
    <!-- 图标资源字典 -->
    <!-- ====================================== -->
    
    <!-- Application Icons / 应用图标 -->
    <BitmapImage x:Key="AppIconLarge" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/App/app.ico"/>
    
    <!-- Action Icons / 操作图标 -->
    <!-- These will be populated when actual icon files are added -->
    <!-- 当添加实际图标文件时会填充这些资源 -->
    
    <!-- Example usage / 使用示例:
    <BitmapImage x:Key="SaveIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Actions/icon-save-24.png"/>
    <BitmapImage x:Key="DeleteIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Actions/icon-delete-24.png"/>
    <BitmapImage x:Key="EditIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Actions/icon-edit-24.png"/>
    <BitmapImage x:Key="AddIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Actions/icon-add-24.png"/>
    <BitmapImage x:Key="SearchIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Actions/icon-search-24.png"/>
    <BitmapImage x:Key="PrintIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Actions/icon-print-24.png"/>
    <BitmapImage x:Key="RefreshIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Actions/icon-refresh-24.png"/>
    -->
    
    <!-- Status Icons / 状态图标 -->
    <!-- Example usage / 使用示例:
    <BitmapImage x:Key="SuccessIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Status/icon-success-16.png"/>
    <BitmapImage x:Key="WarningIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Status/icon-warning-16.png"/>
    <BitmapImage x:Key="ErrorIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Status/icon-error-16.png"/>
    <BitmapImage x:Key="InfoIcon" UriSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Icons/Status/icon-info-16.png"/>
    -->
    
    <!-- Vector Icons using Path Geometry / 使用路径几何的矢量图标 -->
    <!-- These can be used instead of bitmap images for better scaling -->
    
    <!-- Save Icon -->
    <Geometry x:Key="SaveIconGeometry">
        M19,12V19A2,2 0 0,1 17,21H7A2,2 0 0,1 5,19V5A2,2 0 0,1 7,3H12.5L19,9.5V12M14,3V8H19M17,12L12,17L7,12L9.5,14.5L12,12L14.5,14.5L17,12Z
    </Geometry>
    
    <!-- Delete Icon -->
    <Geometry x:Key="DeleteIconGeometry">
        M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z
    </Geometry>
    
    <!-- Edit Icon -->
    <Geometry x:Key="EditIconGeometry">
        M20.71,7.04L18.46,4.79L15.21,8.04L17.46,10.29M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25Z
    </Geometry>
    
    <!-- Add Icon -->
    <Geometry x:Key="AddIconGeometry">
        M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z
    </Geometry>
    
    <!-- Search Icon -->
    <Geometry x:Key="SearchIconGeometry">
        M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z
    </Geometry>
    
    <!-- Print Icon -->
    <Geometry x:Key="PrintIconGeometry">
        M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z
    </Geometry>
    
    <!-- Refresh Icon -->
    <Geometry x:Key="RefreshIconGeometry">
        M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z
    </Geometry>
    
    <!-- Icon Styles / 图标样式 -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    
    <Style x:Key="SmallIconPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    
    <Style x:Key="LargeIconPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>
    
</ResourceDictionary>