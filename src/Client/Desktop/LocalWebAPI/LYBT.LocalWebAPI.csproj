<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LYBT.Tests.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <!-- 独立宿主（LocalWebApiHost.Main）专用配置：仅调试期随本项目的构建输出使用；
         桌面发布包由 Shell 的 appsettings.json 提供配置，本文件不得进入发布产物
         （避免运维误改「未被加载」的配置）。 -->
    <Content Update="appsettings.localwebapi.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Shared/LYBT.Shared.Models/LYBT.Shared.Models.csproj" />
    <ProjectReference Include="../Core/LYBT.Desktop.Contracts/LYBT.Desktop.Contracts.csproj" />
    <ProjectReference Include="../../../Shared/LYBT.Shared.Logging/LYBT.Shared.Logging.csproj" />
    <ProjectReference Include="../../../Shared/LYBT.Entities/LYBT.Entities.csproj" />
    <ProjectReference Include="../../../Server/Core/LYBT.Infrastructure/LYBT.Infrastructure.csproj" />
    <!-- P07 Whitelist: unified Service layer, see ADR-0010/0023 -->
    <!-- Server modules (unified Service layer — same as Remote WebAPI) -->
    <ProjectReference Include="../../../Server/Modules/LYBT.Module.Identity/LYBT.Module.Identity.csproj" />
    <ProjectReference Include="../../../Server/Modules/LYBT.Module.Patients/LYBT.Module.Patients.csproj" />
    <ProjectReference Include="../../../Server/Modules/LYBT.Module.Catalog/LYBT.Module.Catalog.csproj" />
    <ProjectReference Include="../../../Server/Modules/LYBT.Module.MedicalCases/LYBT.Module.MedicalCases.csproj" />
    <ProjectReference Include="../../../Server/Modules/LYBT.Module.Registrations/LYBT.Module.Registrations.csproj" />
    <ProjectReference Include="../../../Server/Modules/LYBT.Module.Reports/LYBT.Module.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
