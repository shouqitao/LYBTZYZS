<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 前台工作台主题色彩 -->
    <SolidColorBrush x:Key="ReceptionistPrimaryBrush" Color="#28A745"/>
    <SolidColorBrush x:Key="ReceptionistSecondaryBrush" Color="#20C997"/>
    <SolidColorBrush x:Key="ReceptionistAccentBrush" Color="#B8E6C1"/>
    
    <!-- 前台工作台按钮样式 -->
    <Style x:Key="ReceptionistButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ReceptionistPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ReceptionistSecondaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>