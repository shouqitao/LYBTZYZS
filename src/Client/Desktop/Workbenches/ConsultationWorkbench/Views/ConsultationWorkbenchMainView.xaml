<UserControl x:Class="LYBT.Desktop.Workbench.Consultation.Views.ConsultationWorkbenchMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Themes/Design/Workbenches/WorkbenchStyles.xaml"/>
                <ResourceDictionary Source="../../../Themes/Design/Components/NavigationStyles.xaml"/>
                <ResourceDictionary Source="../../../Themes/Design/SystemManagement/ManagementViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- 看诊工作台专用样式 -->
            <Style x:Key="ConsultationMenuButton" TargetType="Button" BasedOn="{StaticResource WorkbenchNavigationButton}">
                <Setter Property="Height" Value="50"/>
                <Setter Property="Margin" Value="0,2"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E8F4FD"/>
                        <Setter Property="BorderBrush" Value="#4A90E2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="QuickActionButton" TargetType="Button">
                <Setter Property="Background" Value="#28A745"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#218838"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180" MaxWidth="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 左侧导航菜单 -->
        <Border Grid.Column="0" 
                Background="#F8FAFB" 
                BorderBrush="#E0E6ED" 
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="15">
                    
                    <!-- 工作台标题 -->
                    <TextBlock Text="看诊工作台" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#2C3E50" 
                               Margin="0,0,0,20"/>
                    
                    <!-- 快速操作区 -->
                    <TextBlock Text="快速操作" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#6C757D" 
                               Margin="0,0,0,10"/>
                    
                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <Button Content="新增患者" 
                                Style="{StaticResource QuickActionButton}"
                                Command="{Binding QuickAddPatientCommand}"/>
                        <Button Content="开始看诊" 
                                Style="{StaticResource QuickActionButton}"
                                Background="#007BFF"
                                Command="{Binding StartConsultationCommand}"/>
                    </UniformGrid>
                    
                    <Separator Margin="0,0,0,15" Background="#DEE2E6"/>
                    
                    <!-- 主要功能导航 -->
                    <TextBlock Text="主要功能" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#6C757D" 
                               Margin="0,0,0,15"/>
                    
                    <!-- 患者管理 -->
                    <Button Style="{StaticResource ConsultationMenuButton}"
                            Command="{Binding NavigateToPatientsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="18" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="患者管理" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="查看和管理患者档案" FontSize="11" Foreground="#6C757D"/>
                            </StackPanel>
                            <Border Background="#17A2B8" 
                                    CornerRadius="10" 
                                    Padding="6,2" 
                                    Margin="10,0,0,0"
                                    Visibility="{Binding PatientsNotificationVisibility}">
                                <TextBlock Text="{Binding NewPatientsCount}" 
                                           Foreground="White" 
                                           FontSize="10" 
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    
                    <!-- 看诊管理 -->
                    <Button Style="{StaticResource ConsultationMenuButton}"
                            Command="{Binding NavigateToConsultationsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚕️" FontSize="18" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="看诊管理" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="中医四诊及诊断记录" FontSize="11" Foreground="#6C757D"/>
                            </StackPanel>
                            <Border Background="#28A745" 
                                    CornerRadius="10" 
                                    Padding="6,2" 
                                    Margin="10,0,0,0"
                                    Visibility="{Binding ConsultationsNotificationVisibility}">
                                <TextBlock Text="{Binding TodayConsultationsCount}" 
                                           Foreground="White" 
                                           FontSize="10" 
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    
                    <!-- 医疗案例 -->
                    <Button Style="{StaticResource ConsultationMenuButton}"
                            Command="{Binding NavigateToMedicalCasesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="18" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="医疗案例" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="诊疗案例及病历管理" FontSize="11" Foreground="#6C757D"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    
                    <!-- 处方管理 -->
                    <Button Style="{StaticResource ConsultationMenuButton}"
                            Command="{Binding NavigateToPrescriptionsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" FontSize="18" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="处方管理" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="开具和管理处方" FontSize="11" Foreground="#6C757D"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    
                    <!-- 验方模板 - UltraThink Phase 3.4: 增强功能集成 -->
                    <Button Style="{StaticResource ConsultationMenuButton}"
                            Command="{Binding NavigateToFormulasCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="验方模板" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="导入导出·复制·经典验方管理" FontSize="11" Foreground="#6C757D"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    
                    <Separator Margin="0,15" Background="#DEE2E6"/>
                    
                    <!-- 个人设置 -->
                    <Button Style="{StaticResource ConsultationMenuButton}"
                            Command="{Binding NavigateToPersonalSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="18" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="个人设置" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="个人信息及偏好设置" FontSize="11" Foreground="#6C757D"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- 右侧内容区域 -->
        <ContentControl Grid.Column="1" 
                        prism:RegionManager.RegionName="ConsultationWorkbenchContentRegion"
                        Background="White"/>
    </Grid>
</UserControl>