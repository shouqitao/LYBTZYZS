<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Workbench.Core</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 工作台核心框架 | 导航路由系统 | 角色工作台基础</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-workbench-core</InformationalVersion>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Workbench.Core</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT工作台核心框架 - 导航系统、路由管理、角色工作台基础设施 | 企业级工作台架构</PackageDescription>
    <PackageTags>WPF;工作台;导航;路由;角色;中医;诊所;核心框架</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Naming Configuration -->
    <AssemblyName>LYBT.Desktop.Workbench.Core</AssemblyName>
    <RootNamespace>LYBT.Desktop.Workbench.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Prism Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core"  />
    <PackageReference Include="Prism.DryIoc"  />
    <PackageReference Include="Prism.Wpf"  />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Core Dependencies">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Core.csproj" />
  </ItemGroup>

  <!-- Documentation -->
  <ItemGroup Label="Documentation">
    <None Include="README.md" />
  </ItemGroup>

</Project>