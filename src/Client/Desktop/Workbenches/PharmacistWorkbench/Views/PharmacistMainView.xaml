<UserControl x:Class="LYBT.Desktop.Workbench.Pharmacist.Views.PharmacistMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 药剂师工作台标题 -->
        <Border Grid.Row="0" Background="#6F42C1" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="药剂师工作台" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Pharmacist Workbench" FontSize="14" Foreground="#D1C4E9" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航菜单 -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        
                        <!-- 药品调配 -->
                        <Button Command="{Binding NavigateToDrugPreparationCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💊" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="药品调配" FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- 中药材管理 - UltraThink Phase 3.3 功能集成 -->
                        <Button Command="{Binding NavigateToHerbManagementCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌿" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="中药材管理" FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- 库存管理 -->
                        <Button Command="{Binding NavigateToInventoryManagementCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="库存管理" FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- 用药指导 -->
                        <Button Command="{Binding NavigateToMedicationGuidanceCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="用药指导" FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧内容区域 -->
            <ContentControl Grid.Column="1" prism:RegionManager.RegionName="PharmacistContentRegion"/>

        </Grid>
    </Grid>
</UserControl>