<Window x:Class="LYBT.Desktop.Workbench.Admin.Views.Management.Formulas.Dialogs.HerbSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择药材" 
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 搜索框 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="搜索药材:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtSearch" Height="32" FontSize="14" 
                     TextChanged="TxtSearch_TextChanged"
                     ToolTip="输入药材名称、拼音码进行搜索"/>
        </StackPanel>
        
        <!-- 药材列表 -->
        <DataGrid Grid.Row="1" x:Name="DgHerbs" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,15"
                  MouseDoubleClick="DgHerbs_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="药材名称" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="拼音码" Binding="{Binding PinYinCode}" Width="100"/>
                <DataGridTextColumn Header="产地" Binding="{Binding Origin}" Width="80"/>
                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="80"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="单价" Binding="{Binding Price, StringFormat='{}{0:F2}'}" Width="80"/>
                <DataGridTextColumn Header="功效" Binding="{Binding Effect}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button x:Name="BtnSelect" Content="选择" Width="80" Height="35" 
                    Margin="0,0,10,0" Click="BtnSelect_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="取消" Width="80" Height="35" 
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>