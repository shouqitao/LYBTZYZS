<Window x:Class="LYBT.Desktop.Workbench.Admin.Views.Management.Formulas.Dialogs.FormulaPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="验方详情预览" 
        Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 验方名称 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="验方名称:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtName" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
            </StackPanel>
            
            <!-- 功效 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="功效:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtEffect" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- 用法 -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="用法:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtUsage" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- 适应症 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="适应症:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtIndications" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- 禁忌症 -->
            <StackPanel Grid.Row="4" Margin="0,0,0,15">
                <TextBlock Text="禁忌症:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtContraindications" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- 制备方法 -->
            <StackPanel Grid.Row="5" Margin="0,0,0,15">
                <TextBlock Text="制备方法:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtPreparation" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- 共享状态 -->
            <StackPanel Grid.Row="6" Margin="0,0,0,15">
                <TextBlock Text="共享状态:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtIsShared" FontSize="14"/>
            </StackPanel>
            
            <!-- 创建信息 -->
            <StackPanel Grid.Row="7" Margin="0,0,0,15">
                <TextBlock Text="创建信息:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtCreatedInfo" FontSize="12" Foreground="#7F8C8D"/>
            </StackPanel>
            
            <!-- 更新信息 -->
            <StackPanel Grid.Row="8" Margin="0,0,0,15">
                <TextBlock Text="更新信息:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtUpdatedInfo" FontSize="12" Foreground="#7F8C8D"/>
            </StackPanel>
            
            <!-- 药材组成 -->
            <GroupBox Grid.Row="9" Header="药材组成" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15">
                <DataGrid x:Name="DgHerbs" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Width="60">
                            <DataGridTextColumn.Binding>
                                <Binding Path="SortOrder"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="药材名称" Binding="{Binding HerbName}" Width="150"/>
                        <DataGridTextColumn Header="用量" Width="80">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Quantity" StringFormat="{}{0}g"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="制法" Binding="{Binding Preparation}" Width="100"/>
                        <DataGridTextColumn Header="用法" Binding="{Binding Usage}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            
            <!-- 按钮区域 -->
            <StackPanel Grid.Row="11" Orientation="Horizontal" 
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnPrint" Content="打印" Width="80" Height="35" 
                        Margin="0,0,10,0" Click="BtnPrint_Click"/>
                <Button x:Name="BtnClose" Content="关闭" Width="80" Height="35" 
                        Click="BtnClose_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>