<UserControl x:Class="LYBT.Desktop.Workbench.Admin.Views.Management.Users.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.Desktop.Core.Converters;assembly=LYBT.Desktop.Core"
             xmlns:local="clr-namespace:LYBT.Desktop.Workbench.Admin.Helpers"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource AdminBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/AdminTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            
            <!-- 状态转换器 -->
            <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
            <converters:UserRoleDisplayConverter x:Key="UserRoleDisplayConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
            <RowDefinition Height="Auto"/>  <!-- 筛选栏 -->
            <RowDefinition Height="*"/>     <!-- 数据网格 -->
            <RowDefinition Height="Auto"/>  <!-- 分页栏 -->
            <RowDefinition Height="Auto"/>  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AdminToolbarBackgroundBrush}" 
                BorderBrush="{DynamicResource AdminToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <!-- 添加用户按钮 -->
                <Button Content="&#xE710;" 
                        Command="{Binding AddCommand}"
                        Style="{DynamicResource AdminToolbarButtonStyle}"
                        Margin="0,0,8,0"
                        Width="32" Height="32"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        ToolTip="添加新用户"/>
                
                <TextBlock Text="添加用户" 
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"
                           Foreground="{DynamicResource AdminTextPrimaryBrush}"
                           FontWeight="Medium"/>

                <!-- 刷新按钮 -->
                <Button Content="&#xE72C;" 
                        Command="{Binding RefreshCommand}"
                        Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                        Margin="0,0,8,0"
                        Width="32" Height="32"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        ToolTip="刷新数据"/>

                <!-- 导出按钮 -->
                <Button Content="&#xEDE1;" 
                        Command="{Binding ExportCommand}"
                        Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                        Margin="0,0,16,0"
                        Width="32" Height="32"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        ToolTip="导出数据"/>

                <!-- 间距 -->
                <Rectangle Width="1" 
                           Fill="{DynamicResource AdminToolbarBorderBrush}"
                           Margin="8,4"/>

                <!-- 统计信息 -->
                <StackPanel Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="总用户数：" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AdminTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Statistics.TotalCount}" 
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AdminTextPrimaryBrush}"
                               Margin="0,0,16,0"/>
                    
                    <TextBlock Text="活跃用户：" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AdminTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Statistics.ActiveCount}" 
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AdminSuccessBrush}"
                               Margin="0,0,16,0"/>
                    
                    <TextBlock Text="医生数量：" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AdminTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Statistics.DoctorCount}" 
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AdminInfoBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 筛选栏 -->
        <Border Grid.Row="1" 
                Background="{DynamicResource AdminSurfaceBrush}"
                BorderBrush="{DynamicResource AdminToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>  <!-- 搜索框 -->
                    <ColumnDefinition Width="Auto"/> <!-- 角色筛选 -->
                    <ColumnDefinition Width="Auto"/> <!-- 状态筛选 -->
                    <ColumnDefinition Width="*"/>    <!-- 空白 -->
                    <ColumnDefinition Width="Auto"/> <!-- 清除按钮 -->
                </Grid.ColumnDefinitions>

                <!-- 搜索框 -->
                <Border Grid.Column="0" 
                        Background="White"
                        BorderBrush="{DynamicResource AdminToolbarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 搜索图标 -->
                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource AdminTextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,8,0"/>

                        <!-- 搜索文本框 -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 Padding="0,8"
                                 FontSize="14">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                    <TextBlock Text="搜索用户名、姓名或电话..."
                                                               Foreground="{DynamicResource AdminTextMutedBrush}"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- 清除搜索按钮 -->
                        <Button Grid.Column="2"
                                Content="&#xE711;"
                                Command="{Binding ClearSearchCommand}"
                                Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                                Width="24" Height="24"
                                Margin="4,0,8,0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                ToolTip="清除搜索"/>
                    </Grid>
                </Border>

                <!-- 角色筛选 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="角色："
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AdminTextSecondaryBrush}"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding RoleOptions}"
                              SelectedItem="{Binding SelectedRole}"
                              Width="120"
                              Height="32"/>
                </StackPanel>

                <!-- 状态筛选 -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="状态："
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AdminTextSecondaryBrush}"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedValue="{Binding SelectedActiveStatus}"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              Width="80"
                              Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据网格 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  Background="White"
                  AlternatingRowBackground="#F9F9F9">
            
            <DataGrid.Columns>
                <!-- 头像列 -->
                <DataGridTemplateColumn Header="头像" Width="60" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="{DynamicResource AdminPrimaryBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding RealName, Converter={StaticResource StringToInitialsConverter}}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 用户名列 -->
                <DataGridTextColumn Header="用户名" 
                                    Binding="{Binding Username}" 
                                    Width="120"
                                    FontWeight="SemiBold"/>

                <!-- 真实姓名列 -->
                <DataGridTextColumn Header="真实姓名" 
                                    Binding="{Binding RealName}" 
                                    Width="100"/>

                <!-- 角色列 -->
                <DataGridTemplateColumn Header="角色" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AdminInfoBrush}"
                                    CornerRadius="12"
                                    Padding="8,2">
                                <TextBlock Text="{Binding Role, Converter={StaticResource UserRoleDisplayConverter}}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 电话号码列 -->
                <DataGridTextColumn Header="电话号码" 
                                    Binding="{Binding PhoneNumber}" 
                                    Width="120"/>

                <!-- 状态列 -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsActive, Converter={StaticResource BooleanToBrushConverter}}"
                                    CornerRadius="12"
                                    Padding="8,2">
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 在线状态列 -->
                <DataGridTemplateColumn Header="在线状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" 
                                         Fill="{Binding IsOnline, Converter={StaticResource BooleanToOnlineBrushConverter}}"
                                         Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding IsOnline, Converter={StaticResource BooleanToOnlineStatusConverter}}"
                                           FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 最后登录时间列 -->
                <DataGridTextColumn Header="最后登录" 
                                    Binding="{Binding LastLoginTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" 
                                    Width="140"/>

                <!-- 操作列 -->
                <DataGridTemplateColumn Header="操作" Width="200" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- 编辑按钮 -->
                                <Button Content="&#xE70F;"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                                        Width="24" Height="24"
                                        Margin="2"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10"
                                        ToolTip="编辑用户"/>

                                <!-- 重置密码按钮 -->
                                <Button Content="&#xE8AC;"
                                        Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                                        Width="24" Height="24"
                                        Margin="2"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10"
                                        ToolTip="重置密码"/>

                                <!-- 启用/禁用按钮 -->
                                <Button Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                                        Width="24" Height="24"
                                        Margin="2"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10">
                                    <Button.Content>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToToggleIconConverter}}"/>
                                    </Button.Content>
                                    <Button.ToolTip>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToToggleTooltipConverter}}"/>
                                    </Button.ToolTip>
                                </Button>

                                <!-- 删除按钮 -->
                                <Button Content="&#xE74D;"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                                        Width="24" Height="24"
                                        Margin="2"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10"
                                        Foreground="{DynamicResource AdminErrorBrush}"
                                        ToolTip="删除用户"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页栏 -->
        <Border Grid.Row="3" 
                Background="{DynamicResource AdminSurfaceBrush}"
                BorderBrush="{DynamicResource AdminToolbarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 每页大小选择 -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <TextBlock Text="每页显示："
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AdminTextSecondaryBrush}"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{x:Static local:PageSizeOptions.Options}"
                              SelectedItem="{Binding PageSize}"
                              Width="80"
                              Height="28"/>
                </StackPanel>

                <!-- 分页导航 -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <!-- 上一页按钮 -->
                    <Button Content="&#xE76B;"
                            Command="{Binding PreviousPageCommand}"
                            Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                            Width="28" Height="28"
                            Margin="4,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            ToolTip="上一页"/>

                    <!-- 页码信息 -->
                    <TextBlock VerticalAlignment="Center"
                               Margin="8,0">
                        <Run Text="{Binding CurrentPage}"/>
                        <Run Text="/" Foreground="{DynamicResource AdminTextMutedBrush}"/>
                        <Run Text="{Binding TotalPages}"/>
                    </TextBlock>

                    <!-- 下一页按钮 -->
                    <Button Content="&#xE76C;"
                            Command="{Binding NextPageCommand}"
                            Style="{DynamicResource AdminSecondaryToolbarButtonStyle}"
                            Width="28" Height="28"
                            Margin="4,0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            ToolTip="下一页"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="4" 
                Background="{DynamicResource AdminNavHeaderBrush}"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 状态消息 -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AdminTextOnDarkBrush}"
                           VerticalAlignment="Center"
                           FontSize="12"/>

                <!-- 加载指示器 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE1CD;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource AdminInfoBrush}"
                               Margin="0,0,4,0">
                        <TextBlock.RenderTransform>
                            <RotateTransform/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="加载中..."
                               Foreground="{DynamicResource AdminTextOnDarkBrush}"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>