<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ================================== -->
    <!-- 完整的自包含管理员主题资源定义      -->
    <!-- ================================== -->
    
    <!-- 管理员工作台专用颜色系统 -->
    <!-- 基于Material Design Professional色彩理论 -->
    
    <!-- 主色调系统 - 专业深蓝色 -->
    <Color x:Key="AdminPrimaryColor">#1E3A5F</Color>
    <Color x:Key="AdminPrimaryLightColor">#2C4F7C</Color>
    <Color x:Key="AdminPrimaryDarkColor">#0F1C2E</Color>
    
    <!-- 次要色调 - 优雅蓝灰色 -->
    <Color x:Key="AdminSecondaryColor">#3B4A5C</Color>
    <Color x:Key="AdminSecondaryLightColor">#4A5B6D</Color>
    <Color x:Key="AdminSecondaryDarkColor">#2A3441</Color>
    
    <!-- 背景色系 -->
    <Color x:Key="AdminBackgroundColor">#F7F8FA</Color>
    <Color x:Key="AdminSurfaceColor">#FFFFFF</Color>
    <Color x:Key="AdminCardColor">#FFFFFF</Color>
    
    <!-- 导航专用色彩 -->
    <Color x:Key="AdminNavBackgroundColor">#1E3A5F</Color>
    <Color x:Key="AdminNavHeaderColor">#0F1C2E</Color>
    <Color x:Key="AdminNavItemHoverColor">#2C4F7C</Color>
    <Color x:Key="AdminNavItemActiveColor">#3B4A5C</Color>
    <Color x:Key="AdminNavSeparatorColor">#2A3441</Color>
    
    <!-- 工具栏色彩 -->
    <Color x:Key="AdminToolbarBackgroundColor">#FAFBFC</Color>
    <Color x:Key="AdminToolbarBorderColor">#E1E5E9</Color>
    
    <!-- 文本色彩 -->
    <Color x:Key="AdminTextPrimaryColor">#1A1D23</Color>
    <Color x:Key="AdminTextSecondaryColor">#5A6C7D</Color>
    <Color x:Key="AdminTextOnDarkColor">#E8EDF2</Color>
    <Color x:Key="AdminTextMutedColor">#8B9BAB</Color>
    
    <!-- 状态色彩 -->
    <Color x:Key="AdminSuccessColor">#10B981</Color>
    <Color x:Key="AdminWarningColor">#F59E0B</Color>
    <Color x:Key="AdminErrorColor">#EF4444</Color>
    <Color x:Key="AdminInfoColor">#3B82F6</Color>
    
    <!-- 画刷资源 -->
    <SolidColorBrush x:Key="AdminPrimaryBrush" Color="{StaticResource AdminPrimaryColor}"/>
    <SolidColorBrush x:Key="AdminPrimaryLightBrush" Color="{StaticResource AdminPrimaryLightColor}"/>
    <SolidColorBrush x:Key="AdminPrimaryDarkBrush" Color="{StaticResource AdminPrimaryDarkColor}"/>
    
    <SolidColorBrush x:Key="AdminSecondaryBrush" Color="{StaticResource AdminSecondaryColor}"/>
    <SolidColorBrush x:Key="AdminSecondaryLightBrush" Color="{StaticResource AdminSecondaryLightColor}"/>
    <SolidColorBrush x:Key="AdminSecondaryDarkBrush" Color="{StaticResource AdminSecondaryDarkColor}"/>
    
    <SolidColorBrush x:Key="AdminBackgroundBrush" Color="{StaticResource AdminBackgroundColor}"/>
    <SolidColorBrush x:Key="AdminSurfaceBrush" Color="{StaticResource AdminSurfaceColor}"/>
    <SolidColorBrush x:Key="AdminCardBrush" Color="{StaticResource AdminCardColor}"/>
    
    <SolidColorBrush x:Key="AdminNavBackgroundBrush" Color="{StaticResource AdminNavBackgroundColor}"/>
    <SolidColorBrush x:Key="AdminNavHeaderBrush" Color="{StaticResource AdminNavHeaderColor}"/>
    <SolidColorBrush x:Key="AdminNavItemHoverBrush" Color="{StaticResource AdminNavItemHoverColor}"/>
    <SolidColorBrush x:Key="AdminNavItemActiveBrush" Color="{StaticResource AdminNavItemActiveColor}"/>
    <SolidColorBrush x:Key="AdminNavSeparatorBrush" Color="{StaticResource AdminNavSeparatorColor}"/>
    
    <SolidColorBrush x:Key="AdminToolbarBackgroundBrush" Color="{StaticResource AdminToolbarBackgroundColor}"/>
    <SolidColorBrush x:Key="AdminToolbarBorderBrush" Color="{StaticResource AdminToolbarBorderColor}"/>
    
    <SolidColorBrush x:Key="AdminTextPrimaryBrush" Color="{StaticResource AdminTextPrimaryColor}"/>
    <SolidColorBrush x:Key="AdminTextSecondaryBrush" Color="{StaticResource AdminTextSecondaryColor}"/>
    <SolidColorBrush x:Key="AdminTextOnDarkBrush" Color="{StaticResource AdminTextOnDarkColor}"/>
    <SolidColorBrush x:Key="AdminTextMutedBrush" Color="{StaticResource AdminTextMutedColor}"/>
    
    <SolidColorBrush x:Key="AdminSuccessBrush" Color="{StaticResource AdminSuccessColor}"/>
    <SolidColorBrush x:Key="AdminWarningBrush" Color="{StaticResource AdminWarningColor}"/>
    <SolidColorBrush x:Key="AdminErrorBrush" Color="{StaticResource AdminErrorColor}"/>
    <SolidColorBrush x:Key="AdminInfoBrush" Color="{StaticResource AdminInfoColor}"/>
    
    <!-- 渐变画刷 -->
    <LinearGradientBrush x:Key="AdminNavGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AdminNavBackgroundColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AdminNavHeaderColor}" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- ================================== -->
    <!-- 控件样式定义                        -->
    <!-- ================================== -->
    
    <!-- 导航按钮样式 -->
    <Style x:Key="AdminNavigationButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AdminTextOnDarkBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>      <!-- 选中指示器 -->
                                <ColumnDefinition Width="36"/>     <!-- 图标 -->
                                <ColumnDefinition Width="*"/>      <!-- 文本 -->
                                <ColumnDefinition Width="Auto"/>   <!-- 徽章 -->
                                <ColumnDefinition Width="12"/>     <!-- 右边距 -->
                            </Grid.ColumnDefinitions>
                            
                            <!-- 选中指示器 -->
                            <Rectangle x:Name="SelectionIndicator"
                                       Grid.Column="0"
                                       Fill="{DynamicResource AdminInfoBrush}"
                                       Width="4"
                                       VerticalAlignment="Stretch"
                                       Opacity="0"
                                       RadiusX="2" RadiusY="2"/>
                            
                            <!-- 图标 -->
                            <TextBlock x:Name="IconText"
                                       Grid.Column="1"
                                       Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       UseLayoutRounding="True"/>
                            
                            <!-- 文本内容 -->
                            <TextBlock x:Name="ContentText"
                                       Grid.Column="2"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis"
                                       UseLayoutRounding="True"/>
                            
                            <!-- 徽章 -->
                            <Border x:Name="BadgeBorder"
                                    Grid.Column="3"
                                    Background="{DynamicResource AdminErrorBrush}"
                                    CornerRadius="12"
                                    Padding="8,2"
                                    Margin="4,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           UseLayoutRounding="True"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <!-- 鼠标悬停效果 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" 
                                    Value="{DynamicResource AdminNavItemHoverBrush}"/>
                            <Setter TargetName="IconText" Property="Foreground" 
                                    Value="White"/>
                            <Setter TargetName="ContentText" Property="Foreground" 
                                    Value="White"/>
                        </Trigger>
                        
                        <!-- 按下效果 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" 
                                    Value="{DynamicResource AdminNavItemActiveBrush}"/>
                        </Trigger>
                        
                        <!-- 选中状态 (通过Tag属性控制) -->
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="ButtonBorder" Property="Background" 
                                    Value="{DynamicResource AdminNavItemActiveBrush}"/>
                            <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        
                        <!-- 禁用状态 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        
                        <!-- 键盘焦点 -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" 
                                    Value="{DynamicResource AdminInfoBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" 
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- 分隔符样式 -->
    <Style x:Key="AdminNavigationSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource AdminNavSeparatorBrush}"/>
        <Setter Property="Margin" Value="16,8"/>
        <Setter Property="Opacity" Value="0.3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    
    <!-- 工具栏按钮样式 -->
    <Style x:Key="AdminToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AdminInfoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          UseLayoutRounding="True"/>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AdminPrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AdminPrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource AdminTextMutedBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- 次要工具栏按钮样式 -->
    <Style x:Key="AdminSecondaryToolbarButtonStyle" TargetType="Button" 
           BasedOn="{StaticResource AdminToolbarButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AdminTextMutedBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AdminSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AdminSecondaryDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- 标题样式 -->
    <Style x:Key="AdminWorkbenchTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    
    <!-- 面包屑导航样式 -->
    <Style x:Key="AdminBreadcrumbStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AdminTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    
    <!-- 内容区域样式 -->
    <Style x:Key="AdminContentAreaStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource AdminBackgroundBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    
    <!-- 高对比度主题支持 -->
    <Style x:Key="AdminHighContrastBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AdminNavSeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- 简化样式，移除可能导致问题的Trigger -->
    </Style>
    
</ResourceDictionary>