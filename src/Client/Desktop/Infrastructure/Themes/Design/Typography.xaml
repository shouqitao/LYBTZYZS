<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====================================== -->
    <!-- 凌隐宝堂 字体系统 -->
    <!-- ====================================== -->

    <!-- 字体家族 -->
    <FontFamily x:Key="ChineseFontFamily">Microsoft YaHei UI, 微软雅黑, PingFang SC, Hiragino Sans GB, Source Han Sans CN, Noto Sans CJK SC, sans-serif</FontFamily>
    <FontFamily x:Key="EnglishFontFamily">Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Code, Consolas, Monaco, Courier New, monospace</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

    <!-- 默认字体 -->
    <FontFamily x:Key="DefaultFontFamily">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>

    <!-- 字体大小 -->
    <sys:Double x:Key="FontSizeXS">10</sys:Double>
    <sys:Double x:Key="FontSizeSM">12</sys:Double>
    <sys:Double x:Key="FontSizeMD">14</sys:Double>
    <sys:Double x:Key="FontSizeLG">16</sys:Double>
    <sys:Double x:Key="FontSizeXL">20</sys:Double>
    <sys:Double x:Key="FontSize2XL">24</sys:Double>
    <sys:Double x:Key="FontSize3XL">32</sys:Double>
    <sys:Double x:Key="FontSize4XL">40</sys:Double>

    <!-- 标题字体大小 -->
    <sys:Double x:Key="H1FontSize">32</sys:Double>
    <sys:Double x:Key="H2FontSize">28</sys:Double>
    <sys:Double x:Key="H3FontSize">24</sys:Double>
    <sys:Double x:Key="H4FontSize">20</sys:Double>
    <sys:Double x:Key="H5FontSize">16</sys:Double>
    <sys:Double x:Key="H6FontSize">14</sys:Double>

    <!-- 字体粗细 -->
    <FontWeight x:Key="FontWeightThin">Thin</FontWeight>
    <FontWeight x:Key="FontWeightLight">Light</FontWeight>
    <FontWeight x:Key="FontWeightRegular">Regular</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <!-- 行高 -->
    <sys:Double x:Key="LineHeightTight">1.2</sys:Double>
    <sys:Double x:Key="LineHeightNormal">1.5</sys:Double>
    <sys:Double x:Key="LineHeightRelaxed">1.8</sys:Double>
    <sys:Double x:Key="LineHeightLoose">2.0</sys:Double>

    <!-- ====================================== -->
    <!-- 文字样式 -->
    <!-- ====================================== -->

    <!-- 基础文字样式 -->
    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- H1 标题 -->
    <Style x:Key="H1TextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource H1FontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- H2 标题 -->
    <Style x:Key="H2TextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource H2FontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- H3 标题 -->
    <Style x:Key="H3TextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource H3FontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- H4 标题 -->
    <Style x:Key="H4TextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource H4FontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- H5 标题 -->
    <Style x:Key="H5TextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource H5FontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- H6 标题 -->
    <Style x:Key="H6TextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource H6FontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- 正文 -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- 小字 -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 超小字 -->
    <Style x:Key="OverlineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <!-- CharacterSpacing 在WPF中不支持 -->
    </Style>

    <!-- 强调文字 -->
    <Style x:Key="EmphasisTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!-- 链接文字 -->
    <Style x:Key="LinkTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- 代码文字 -->
    <Style x:Key="CodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="Background" Value="{DynamicResource BackgroundDarkBrush}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <!-- 错误文字 -->
    <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- 成功文字 -->
    <Style x:Key="SuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <!-- 警告文字 -->
    <Style x:Key="WarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <!-- 禁用文字 -->
    <Style x:Key="DisabledTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- 图标文字 -->
    <Style x:Key="IconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
