<UserControl x:Class="LYBT.Desktop.Sysadmin.Views.LogLevelControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:prism="http://prismlibrary.com/">

    <materialDesign:DialogHost>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource MaterialDesign.Brush.Background}">
            <StackPanel Margin="32" MaxWidth="800">

                <!-- 页面标题 -->
                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Text="日志级别控制" Margin="0,0,0,24" />

                <!-- 当前状态卡片 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Text="当前级别" Opacity="0.6" />
                        <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Text="{Binding CurrentLevel}"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- 快捷操作卡片 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="快捷操作" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="开启 Debug (60分钟)" Command="{Binding EnableDebugCommand}"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                    Margin="0,0,8,0" />
                            <Button Content="关闭 Debug" Command="{Binding DisableDebugCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 手动设置卡片 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="手动设置级别" Margin="0,0,0,16" />

                        <WrapPanel>
                            <Button Content="Verbose" Command="{Binding SetLevelCommand}" CommandParameter="Verbose"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Margin="0,0,8,8" />
                            <Button Content="Debug" Command="{Binding SetLevelCommand}" CommandParameter="Debug"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Margin="0,0,8,8" />
                            <Button Content="Info" Command="{Binding SetLevelCommand}" CommandParameter="Information"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Margin="0,0,8,8" />
                            <Button Content="Warning" Command="{Binding SetLevelCommand}" CommandParameter="Warning"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Warning}" Margin="0,0,8,8" />
                            <Button Content="Error" Command="{Binding SetLevelCommand}" CommandParameter="Error"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Error}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 状态消息 -->
                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Text="{Binding StatusMessage}" Opacity="0.6"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </materialDesign:DialogHost>
</UserControl>
