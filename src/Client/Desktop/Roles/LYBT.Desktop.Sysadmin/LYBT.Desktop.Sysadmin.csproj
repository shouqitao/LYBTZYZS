<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Sysadmin</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 系统运维控制台模块 | 仪表盘 + 管理员账号管理 + 日志级别控制</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>

    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Sysadmin</PackageId>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT系统运维控制台模块 - 暗色仪表盘、管理员账号管理、运行时日志级别控制</PackageDescription>
    <PackageTags>WPF;系统运维;仪表盘;日志控制;中医;诊所</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://gitee.com/shouqitao/LYBTZYZS.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <AssemblyName>LYBT.Desktop.Sysadmin</AssemblyName>
    <RootNamespace>LYBT.Desktop.Sysadmin</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
    <Page Remove="bin\**" />
  </ItemGroup>

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Prism.Wpf" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Infrastructure Dependencies">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Foundation\LYBT.Desktop.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Desktop Core">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Contracts\LYBT.Desktop.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
  </ItemGroup>

  <!-- 业务模块引用（复用UserMasterDetailControl） -->
  <ItemGroup Label="Business Module Controls">
    <ProjectReference Include="..\..\Modules\LYBT.Desktop.Users\LYBT.Desktop.Users.csproj" />
  </ItemGroup>

</Project>
