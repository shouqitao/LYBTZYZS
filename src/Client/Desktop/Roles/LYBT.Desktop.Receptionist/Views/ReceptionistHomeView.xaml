<UserControl x:Class="LYBT.Desktop.Receptionist.Views.ReceptionistHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <!-- UI Redesign 2026-06-21: emoji → 矢量图标, 本地样式 → 全局 TransparentCardButton -->
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- 标题区域 -->
            <TextBlock Margin="0,0,0,8"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                       Text="前台工作台" />
            <TextBlock Margin="0,0,0,40"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                       Text="患者登记与挂号管理" />
            
            <!-- 搜索栏 -->
            <Border Margin="0,0,0,40"
                    Padding="16"
                    Background="{DynamicResource MaterialDesignBody}"
                    CornerRadius="8"
                    Width="600">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" Opacity="0.1" ShadowDepth="2" Color="Gray" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Height="44"
                             VerticalContentAlignment="Center"
                             FontSize="16"
                             Padding="12,0"
                             BorderThickness="0"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入患者姓名、拼音码或身份证号快速搜索">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchPatientCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="24,0"
                            Height="44"
                            Content="搜索"
                            Command="{Binding SearchPatientCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </Grid>
            </Border>
            
            <!-- 上层：主卡片 + 统计卡片 -->
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                
                <!-- 主卡片：新建挂号 -->
                <Border Margin="12" Style="{StaticResource PrimaryFunctionCardStyle}">
                    <Button Command="{Binding CreateNewRegistrationCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="64" Height="64" Margin="0,0,0,16"
                                  HorizontalAlignment="Center"
                                  Data="{DynamicResource IconRegistration}"
                                  Fill="White" Stretch="Uniform" />
                            <TextBlock Margin="0,0,0,8"
                                       HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="新建挂号" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="14"
                                       Foreground="White"
                                       Opacity="0.85"
                                       Text="为患者创建挂号记录" />
                        </StackPanel>
                    </Button>
                </Border>
                
                <!-- 主卡片：新建患者 -->
                <Border Margin="12" Style="{StaticResource PrimaryFunctionCardStyle}">
                    <Button Command="{Binding CreateNewPatientCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="64" Height="64" Margin="0,0,0,16"
                                  HorizontalAlignment="Center"
                                  Data="{DynamicResource IconPatients}"
                                  Fill="White" Stretch="Uniform" />
                            <TextBlock Margin="0,0,0,8"
                                       HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="新建患者" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="14"
                                       Foreground="White"
                                       Opacity="0.85"
                                       Text="创建新患者档案" />
                        </StackPanel>
                    </Button>
                </Border>
                
                <!-- 统计卡片 -->
                <Border Margin="12" Style="{StaticResource StatsCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,0,20"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Text="今日统计" />
                        
                        <!-- 今日挂号量 -->
                        <StackPanel Margin="0,0,0,16" HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                       Text="{Binding TodayRegistrationCount, FallbackValue=0}" />
                            <TextBlock Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                       Text=" 挂号" />
                        </StackPanel>
                        
                        <!-- 等待中 -->
                        <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                       Text="等待中 " />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#DAA520"
                                       Text="{Binding WaitingCount, FallbackValue=0}" />
                        </StackPanel>
                        
                        <!-- 已完成 -->
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                       Text="已完成 " />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#2E8B57"
                                       Text="{Binding CompletedCount, FallbackValue=0}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <!-- 下层4个辅助卡片 -->
            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                
                <!-- 辅助卡片1：患者管理 -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToPatientManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconPatients}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="患者管理" />
                        </StackPanel>
                    </Button>
                </Border>
                
                <!-- 辅助卡片2：挂号队列 -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToRegistrationQueueCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconRegistration}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="挂号队列" />
                        </StackPanel>
                    </Button>
                </Border>
                
                <!-- 辅助卡片3：身份证读卡 -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToCardReaderCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconCard}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="身份证读卡" />
                        </StackPanel>
                    </Button>
                </Border>
                
                <!-- 辅助卡片4：刷新数据 -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding RefreshDataCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconRefresh}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="刷新数据" />
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
