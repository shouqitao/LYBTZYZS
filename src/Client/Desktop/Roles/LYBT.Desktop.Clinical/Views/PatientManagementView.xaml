<!--
    PatientManagementView - 患者管理视图

    薄包装View，复用业务模块的PatientMasterDetailControl
    View在角色台，Control在业务模块

    权限设计：
    - 诊所共享患者：只读参考
    - 医生自创患者：可完整管理
-->
<UserControl x:Class="LYBT.Desktop.Clinical.Views.PatientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:patientControls="clr-namespace:LYBT.Desktop.Patients.Controls;assembly=LYBT.Desktop.Patients"
             xmlns:vm="clr-namespace:LYBT.Desktop.Patients.ViewModels;assembly=LYBT.Desktop.Patients"
             d:DataContext="{d:DesignInstance vm:PatientMasterDetailViewModel}"
             mc:Ignorable="d">
    <Grid>
        <patientControls:PatientMasterDetailControl />
    </Grid>
</UserControl>
