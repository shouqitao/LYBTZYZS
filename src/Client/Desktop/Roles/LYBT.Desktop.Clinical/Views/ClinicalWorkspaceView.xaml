<UserControl x:Class="LYBT.Desktop.Clinical.Views.ClinicalWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:patientControls="clr-namespace:LYBT.Desktop.Patients.Controls;assembly=LYBT.Desktop.Patients"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="WorkspaceActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 视觉基线 v1：按 clinical-workspace.pen + desktop-layout-framework 对齐：主内容 $bg-warm gap16，工具栏48/56，内容区三栏 260/fill/240，文字居中，描边可见 -->
    <Grid Background="{DynamicResource SurfaceLevel0Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="240" MaxWidth="340"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--  Column 0: 患者选择列表  -->
        <Border Grid.Column="0"
                Background="{DynamicResource MaterialDesignBody}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}"
                BorderThickness="0,0,1,0">
            <patientControls:PatientSelectionControl
                PatientDoubleClicked="PatientSelectionControl_PatientDoubleClicked"/>
        </Border>

        <!--  Column 1: 分隔条  -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesign.Brush.Outline}"/>

        <!--  Column 2: 看诊工作区（铺满，gap16）  -->
        <Grid Grid.Column="2" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 患者信息条 56h -->
                <RowDefinition Height="Auto"/>  <!-- 空状态提示 -->
                <RowDefinition Height="*"/>     <!-- 历史面板 -->
                <RowDefinition Height="Auto"/>  <!-- 操作按钮 右置 -->
            </Grid.RowDefinitions>

            <!--  Row 0: 患者信息条（仅患者已选时显示）  -->
            <Border Grid.Row="0"
                    Padding="16,10"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding SelectedPatient, Converter={x:Static converters:Cvt.NotNullToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                               Text="{Binding SelectedPatient.Name}"
                               VerticalAlignment="Center"/>
                    <TextBlock Margin="16,0,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                               VerticalAlignment="Center"
                               Text="{Binding SelectedPatient.Gender}"/>
                    <TextBlock Margin="16,0,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                               VerticalAlignment="Center"
                               Text="{Binding SelectedPatient.Age, StringFormat={}{0}岁}"/>
                </StackPanel>
            </Border>

            <!--  Row 1: 空状态提示（仅未选患者时显示）  -->
            <StackPanel Grid.Row="1"
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding SelectedPatient, Converter={x:Static converters:Cvt.InverseNullToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                             Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"/>
                    <TextBlock FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                               VerticalAlignment="Center"
                               Text="请从左侧选择患者"/>
                </StackPanel>
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                           HorizontalAlignment="Center"
                           Text="双击患者或选中后点击「开始看诊」"/>
            </StackPanel>

            <!--  Row 2: 历史就诊记录面板（可折叠，仅患者已选时显示）  -->
            <Expander Grid.Row="2"
                      Header="历史就诊记录"
                      IsExpanded="False"
                      Margin="8,8,8,0"
                      Visibility="{Binding HasSelection, Converter={x:Static converters:Cvt.BoolToVis}}">
                <ItemsControl ItemsSource="{Binding PatientHistory}" MaxHeight="180">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6"
                                    Margin="0,0,0,4"
                                    Background="{DynamicResource MaterialDesign.Brush.Paper}"
                                    CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="90"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding Date, StringFormat=yyyy-MM-dd}"/>
                                    <TextBlock Width="180"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Diagnosis}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Summary}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!--  Row 3: 操作按钮区（仅患者已选时显示）  -->
            <Border Grid.Row="3"
                    Padding="16,12"
                    Background="{DynamicResource MaterialDesignBody}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding SelectedPatient, Converter={x:Static converters:Cvt.NotNullToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="开始看诊"
                            Command="{Binding StartConsultationCommand}"
                            Style="{StaticResource WorkspaceActionButton}"/>
                    <Button Content="新建患者"
                            Command="{Binding NewPatientCommand}"
                            Style="{StaticResource WorkspaceActionButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
