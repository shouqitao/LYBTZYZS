<!--
    HerbReferenceView - 药材参考视图
    OpenSpec: refactor-admin-workspace

    薄包装View，复用业务模块的HerbMasterDetailControl
    View在角色台，Control在业务模块
    用于医生诊疗时查看药材信息
-->
<UserControl x:Class="LYBT.Desktop.Clinical.Views.HerbReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:herbControls="clr-namespace:LYBT.Desktop.Herbs.Controls;assembly=LYBT.Desktop.Herbs">
    <Grid>
        <herbControls:HerbMasterDetailControl />
    </Grid>
</UserControl>
