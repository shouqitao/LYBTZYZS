<!--
    MedicalCaseWorkspaceView - 医案工作区视图
    OpenSpec: refactor-clinical-workflow
    OpenSpec: refactor-medicalcase-workspace V2

    医生工作台专用视图 V2布局
    - 左侧25%: 患者信息卡片 + 待诊队列
    - 右侧75%: BaseDetailContainer (查看/编辑模式)
      - ViewContent: 只读模式，使用MedicalCaseViewControl紧凑模式
      - EditContent: 编辑模式，使用MedicalCaseEditControl紧凑模式
        - 诊断三行布局: 现病史 / 舌诊+脉诊 / 中医诊断
        - 右上角工具栏: 经验方/历史处方/清空
      - FooterContent: 自定义底部操作栏（备注、修改原因、操作按钮）
-->
<UserControl x:Class="LYBT.Desktop.Clinical.Views.MedicalCaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:LYBT.Desktop.MedicalCase.Controls;assembly=LYBT.Desktop.MedicalCase"
             xmlns:infraControls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- 转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ========================================
         V2布局: 左25% + 右75%
         OpenSpec: refactor-medicalcase-workspace V2 TASK-V2-007
         ======================================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*" MinWidth="280" MaxWidth="350"/>
            <ColumnDefinition Width="75*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================
             左侧: 患者信息卡片 + 待诊队列
             ======================================== -->
        <Grid Grid.Column="0" Margin="12,12,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 患者信息卡片 -->
                <RowDefinition Height="*"/>     <!-- 待诊队列 -->
            </Grid.RowDefinitions>

            <!-- 患者信息卡片 -->
            <infraControls:PatientInfoCardControl Grid.Row="0"
                Patient="{Binding CurrentPatientDisplayModel}"
                DisplayMode="Compact"
                ShowHistoryButton="True"
                HistoryCommand="{Binding ViewPatientHistoryCommand}"
                Margin="0,0,0,12"/>

            <!-- 待诊队列 - OpenSpec: refactor-medicalcase-workspace V2 -->
            <infraControls:PendingQueueControl Grid.Row="1"
                Title="待看诊队列"
                PendingQueue="{Binding PendingQueue}"
                SelectedItem="{Binding SelectedPendingCase, Mode=TwoWay}"
                SelectCommand="{Binding SelectPendingCaseCommand}"
                RefreshCommand="{Binding RefreshQueueCommand}"
                IsRefreshing="{Binding IsRefreshingPendingQueue}"
                IsEmpty="{Binding HasNoPendingCases}"
                IsCompactMode="True"
                AutoRefreshEnabled="True"
                AutoRefreshInterval="30"/>
        </Grid>

        <!-- ========================================
             右侧: BaseDetailContainer (查看/编辑)
             ======================================== -->
        <views:BaseDetailContainer Grid.Column="1"
            Title="{Binding HeaderTitle}"
            IsEditMode="{Binding IsEditing, Mode=OneWay}"
            GoBackCommand="{Binding BackCommand}"
            SwitchToEditCommand="{Binding EnterEditModeCommand}"
            ShowEditButton="{Binding CanEdit}"
            UseContentScrolling="False"
            Margin="12,0,0,0">

            <!-- ========================================
                 ActionButtons - Header右侧自定义内容
                 显示患者信息
                 ======================================== -->
            <views:BaseDetailContainer.ActionButtons>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="患者：" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PatientName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock Text="{Binding PatientInfo}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </views:BaseDetailContainer.ActionButtons>

            <!-- ========================================
                 ViewContent - 只读模式内容
                 OpenSpec: refactor-medicalcase-workspace V2
                 使用MedicalCaseViewControl紧凑模式
                 ======================================== -->
            <views:BaseDetailContainer.ViewContent>
                <!-- V2布局: 使用MedicalCaseViewControl紧凑模式 -->
                <!-- OpenSpec: consolidate-panel-viewmodels - 绑定路径改为Consultation.和Prescription. -->
                <controls:MedicalCaseViewControl
                    IsCompactMode="True"
                    PresentIllness="{Binding Consultation.PresentIllness}"
                    TongueDiagnosis="{Binding Consultation.TongueDiagnosis}"
                    PulseDiagnosis="{Binding Consultation.PulseDiagnosis}"
                    TcmDiagnosis="{Binding Consultation.TcmDiagnosis}"
                    HerbItems="{Binding Prescription.Items}"
                    AllHerbs="{Binding AllHerbs}"
                    DoseCount="{Binding Prescription.DosageCount}"
                    Usage="{Binding Prescription.Usage}"
                    TotalPrice="{Binding Prescription.SingleDosePrice}"
                    ShowPrintButton="False"/>
            </views:BaseDetailContainer.ViewContent>

            <!-- ========================================
                 EditContent - 编辑模式内容
                 OpenSpec: refactor-medicalcase-workspace V2
                 使用MedicalCaseEditControl统一诊断+处方编辑
                 ======================================== -->
            <views:BaseDetailContainer.EditContent>
                <!-- V2布局: 使用MedicalCaseEditControl紧凑模式 -->
                <!-- OpenSpec: consolidate-panel-viewmodels - 绑定路径改为Consultation.和Prescription. -->
                <controls:MedicalCaseEditControl
                    IsCompactMode="True"
                    PresentIllness="{Binding Consultation.PresentIllness, Mode=TwoWay}"
                    TongueDiagnosis="{Binding Consultation.TongueDiagnosis, Mode=TwoWay}"
                    PulseDiagnosis="{Binding Consultation.PulseDiagnosis, Mode=TwoWay}"
                    TcmDiagnosis="{Binding Consultation.TcmDiagnosis, Mode=TwoWay}"
                    HerbItems="{Binding Prescription.Items, Mode=TwoWay}"
                    AllHerbs="{Binding AllHerbs}"
                    HerbCount="{Binding Prescription.ItemCount}"
                    DoseCount="{Binding Prescription.DosageCount, Mode=TwoWay}"
                    Usage="{Binding Prescription.Usage, Mode=TwoWay}"
                    TotalPrice="{Binding Prescription.SingleDosePrice}"
                    ImportFormulaCommand="{Binding OpenFormulaImportDialogCommand}"
                    ImportHistoryCommand="{Binding OpenHistoryCopyDialogCommand}"
                    ClearAllCommand="{Binding ClearHerbItemsCommand}"
                    IsEnabled="{Binding IsPrescriptionEnabled}"
                    Margin="0,0,0,8"/>
            </views:BaseDetailContainer.EditContent>

            <!-- ========================================
                 FooterContent - 自定义底部操作栏
                 备注、修改原因、操作按钮
                 ======================================== -->
            <views:BaseDetailContainer.FooterContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 备注标签 -->
                    <TextBlock Grid.Column="0"
                               Text="备注："
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <!-- 备注输入框 -->
                    <TextBox Grid.Column="1"
                             Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditableTextBoxStyle}"
                             MinHeight="36"
                             MaxLength="500"
                             ToolTip="医案备注信息（最多500字）"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"
                             IsReadOnly="{Binding IsReadOnly}"/>

                    <!-- 修改原因输入区域（历史修改模式显示） -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsHistoricalEditMode, Converter={StaticResource BoolToVisibility}}"
                                Margin="16,0,0,0">
                        <TextBlock Text="修改原因："
                                   FontSize="13"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Text="{Binding EditReason, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 Width="200"
                                 MinHeight="36"
                                 MaxLength="200"
                                 ToolTip="请输入修改原因（必填）"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 操作按钮组 -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Clinical只读模式: 修改医案按钮 -->
                        <Button Content="修改医案"
                                Command="{Binding EnterEditModeCommand}"
                                Style="{StaticResource SuccessButton}"
                                ToolTip="进入编辑模式，可修改诊断和处方内容"
                                Visibility="{Binding ShowEditButton, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,0"/>

                        <!-- Clinical编辑模式: 暂存医案按钮 -->
                        <Button Content="暂存医案"
                                Command="{Binding SaveAndStayCommand}"
                                Style="{StaticResource WarningButton}"
                                ToolTip="保存当前进度，可随时点击'修改医案'继续编辑"
                                Visibility="{Binding ShowDraftButton, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,0"/>

                        <!-- 所有模式: 打印处方笺按钮 -->
                        <Button Content="打印处方笺"
                                Command="{Binding PrintPrescriptionCommand}"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="{Binding CanPrintPrescription}"
                                ToolTip="打印当前处方"
                                Margin="0,0,8,0"/>

                        <!-- Clinical编辑模式: 完成看诊按钮 -->
                        <Button Content="完成看诊"
                                Command="{Binding CompleteConsultationCommand}"
                                Style="{StaticResource SuccessButton}"
                                IsEnabled="{Binding CanComplete}"
                                ToolTip="完成本次看诊，关闭医案"
                                Visibility="{Binding ShowCompleteButton, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Management编辑模式: 保存医案按钮 -->
                        <Button Content="保存医案"
                                Command="{Binding SaveAndStayCommand}"
                                Style="{StaticResource SuccessButton}"
                                ToolTip="保存修改并留在当前界面"
                                Visibility="{Binding ShowSaveButton, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </views:BaseDetailContainer.FooterContent>
        </views:BaseDetailContainer>
    </Grid>
</UserControl>
