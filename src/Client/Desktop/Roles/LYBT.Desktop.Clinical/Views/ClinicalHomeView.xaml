<UserControl
    x:Class="LYBT.Desktop.Clinical.Views.ClinicalHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- OpenSpec: cleanup-ui-dead-code - 使用共享HomePageStyles -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/HomePageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--  透明按钮样式（无hover直角覆盖）- Clinical专用  -->
            <Style x:Key="TransparentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  全屏居中布局  -->
    <Grid Background="{StaticResource SurfaceBackgroundBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--  标题区域  -->
            <TextBlock
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                FontSize="28"
                FontWeight="Bold"
                Foreground="{StaticResource BrandPrimaryBrush}"
                Text="临床工作站" />
            <TextBlock
                Margin="0,0,0,40"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="凌隐宝堂中医诊所" />

            <!--  上层：主卡片 + 统计卡片  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <!--  主卡片：开始接诊  -->
                <Border Margin="12" Style="{StaticResource PrimaryFunctionCardStyle}">
                    <Button
                        Style="{StaticResource TransparentButtonStyle}"
                        Command="{Binding StartMedicalCaseCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                FontSize="64"
                                Text="&#x1F9D1;&#x200D;&#x2695;&#xFE0F;" />
                            <TextBlock
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="开始接诊" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                Foreground="White"
                                Opacity="0.85"
                                Text="点击进入患者选择" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  统计卡片  -->
                <Border Margin="12" Style="{StaticResource StatsCardStyle}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="今日统计" />

                        <!--  今日接诊数  -->
                        <StackPanel
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandPrimaryBrush}"
                                Text="{Binding TodayConsultationCount, FallbackValue=0}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text=" 人" />
                        </StackPanel>

                        <!--  待完成病历  -->
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="待完成病历: " />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SemanticErrorBrush}"
                                Text="{Binding PendingCaseCount, FallbackValue=0}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text=" 份" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  下层：4个辅助卡片  -->
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <!--  辅助卡片1：患者管理  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button
                        Style="{StaticResource TransparentButtonStyle}"
                        Command="{Binding NavigateToPatientManagementCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="&#x1F464;" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="患者管理" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  辅助卡片2：病历查询  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button
                        Style="{StaticResource TransparentButtonStyle}"
                        Command="{Binding NavigateToMedicalCaseQueryCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="&#x1F4CB;" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="病历查询" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  辅助卡片3：药材库  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button
                        Style="{StaticResource TransparentButtonStyle}"
                        Command="{Binding NavigateToHerbLibraryCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="&#x1F33F;" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="药材库" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  辅助卡片4：验方库  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button
                        Style="{StaticResource TransparentButtonStyle}"
                        Command="{Binding NavigateToFormulaLibraryCommand}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="&#x1F4D6;" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="验方库" />
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
