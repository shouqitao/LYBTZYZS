<UserControl x:Class="LYBT.Desktop.Clinical.Views.ClinicalHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 中心内容区 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel MaxWidth="800" Margin="40">
                <!-- Logo区域 -->
                <TextBlock Text="凌隐宝堂中医诊所"
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="#2E86AB"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10" />
                <TextBlock Text="临床工作站"
                          FontSize="18"
                          Foreground="#666"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,40" />

                <!-- 开始接诊按钮 (Issue #1486: 150x50px, PrimaryButton) -->
                <Button Command="{Binding StartConsultationCommand}"
                       Style="{StaticResource PrimaryButton}"
                       Content="开始接诊"
                       Width="150"
                       Height="50"
                       FontSize="16"
                       Margin="0,0,0,30" />

                <!-- 统计功能占位卡片 (Issue #1553: MVP阶段暂不实现统计功能) -->
                <Border Background="White"
                       BorderBrush="{StaticResource BorderBrush}"
                       BorderThickness="1"
                       CornerRadius="5"
                       Margin="0,0,0,20">
                    <StackPanel Margin="20" HorizontalAlignment="Center">
                        <TextBlock Text="📊 统计功能"
                                  Style="{StaticResource H2TextBlock}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10" />
                        <TextBlock Text="统计功能开发中（MVP后期实现）"
                                  Style="{StaticResource CaptionTextBlock}"
                                  Foreground="#999"
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <!-- 底部提示 -->
                <TextBlock Text="提示：点击【开始接诊】选择患者后进入就诊流程"
                          Style="{StaticResource CaptionTextBlock}"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Margin="0,20,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
