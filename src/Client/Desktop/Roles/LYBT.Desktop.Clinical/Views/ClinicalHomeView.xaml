<UserControl
    x:Class="LYBT.Desktop.Clinical.Views.ClinicalHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--  Issue #1827: 医生工作台主页 - 卡片式布局重构  -->
    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="800" Margin="40">

                <!--  标题区域  -->
                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#2E86AB"
                    Text="凌隐宝堂中医诊所" />
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    Foreground="#666"
                    Text="临床工作站" />

                <!--  用户信息与操作区域 (Issue #1887-1891)  -->
                <Border
                    MinWidth="400"
                    Margin="0,0,0,30"
                    Padding="20,15"
                    HorizontalAlignment="Center"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="👤" />
                        <TextBlock
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding CurrentUserName, FallbackValue='医生'}" />
                    </StackPanel>
                </Border>

                <!--  上层：主卡片 + 统计卡片  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <!--  主卡片：开始接诊 (500x220px)  -->
                    <Border
                        Grid.Column="0"
                        Height="220"
                        CornerRadius="12"
                        Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.2"
                                            ShadowDepth="2"
                                            Color="Black" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                        To="1.05"
                                                        Duration="0:0:0.3" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                        To="1.05"
                                                        Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                        To="1.0"
                                                        Duration="0:0:0.3" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                        To="1.0"
                                                        Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!--  渐变背景  -->
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#4A90E2" />
                                <GradientStop Offset="1" Color="#357ABD" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding StartConsultationCommand}"
                            Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!--  图标 (80x80px)  -->
                                <TextBlock
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center"
                                    FontSize="60"
                                    Text="🧑‍⚕️" />

                                <!--  大字标题  -->
                                <TextBlock
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center"
                                    FontSize="36"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="开始接诊" />

                                <!--  副标题  -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="White"
                                    Opacity="0.8"
                                    Text="点击进入患者选择" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!--  统计卡片 (240x220px)  -->
                    <Border
                        Grid.Column="2"
                        Height="220"
                        Padding="20"
                        Background="#F5F5F5"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel VerticalAlignment="Center">
                            <!--  标题  -->
                            <TextBlock
                                Margin="0,0,0,24"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#333"
                                Text="今日统计" />

                            <!--  今日接诊数  -->
                            <StackPanel
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    FontWeight="Bold"
                                    Foreground="#4A90E2"
                                    Text="{Binding TodayConsultationCount}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="#666"
                                    Text=" 人" />
                            </StackPanel>

                            <!--  待完成病历  -->
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#666"
                                    Text="待完成病历: " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="#FF6B6B"
                                    Text="{Binding PendingCaseCount}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#666"
                                    Text=" 份" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  下层：4个辅助卡片  -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <!--  辅助卡片1：患者管理  -->
                    <Border
                        Grid.Column="0"
                        Height="160"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding NavigateToPatientManagementCommand}"
                            Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    FontSize="48"
                                    Text="👤" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="#333"
                                    Text="患者管理" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!--  辅助卡片2：病历查询  -->
                    <Border
                        Grid.Column="2"
                        Height="160"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding NavigateToMedicalCaseQueryCommand}"
                            Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    FontSize="48"
                                    Text="📋" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="#333"
                                    Text="病历查询" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!--  辅助卡片3：药材库  -->
                    <Border
                        Grid.Column="4"
                        Height="160"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding NavigateToHerbLibraryCommand}"
                            Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    FontSize="48"
                                    Text="🌿" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="#333"
                                    Text="药材库" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!--  辅助卡片4：验方库  -->
                    <Border
                        Grid.Column="6"
                        Height="160"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding NavigateToFormulaLibraryCommand}"
                            Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center"
                                    FontSize="48"
                                    Text="📖" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="#333"
                                    Text="验方库" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>

                <!--  底部提示  -->
                <TextBlock
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="提示：点击【开始接诊】选择患者后进入就诊流程"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
