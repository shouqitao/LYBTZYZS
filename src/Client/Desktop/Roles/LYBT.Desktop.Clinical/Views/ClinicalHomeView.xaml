<UserControl
    x:Class="LYBT.Desktop.Clinical.Views.ClinicalHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--  全屏居中布局 (UI Redesign 2026-06-21: emoji → 矢量图标, 本地样式 → 全局)  -->
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!--  标题区域  -->
            <TextBlock
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Text="临床工作台" />
            <TextBlock
                Margin="0,0,0,40"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                Text="凌隐宝堂中医诊所" />

            <!--  上层：主卡片 + 统计卡片  -->
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                <!--  主卡片：开始接诊  -->
                <Border Margin="12" Style="{StaticResource PrimaryFunctionCardStyle}">
                    <Button Command="{Binding StartMedicalCaseCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path
                                Width="64"
                                Height="64"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Center"
                                Data="{DynamicResource IconStethoscope}"
                                Fill="White"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="开始接诊" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                Foreground="White"
                                Opacity="0.85"
                                Text="点击进入患者选择" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  统计卡片  -->
                <Border Margin="12" Style="{StaticResource StatsCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="今日统计" />

                        <!--  今日接诊量  -->
                        <StackPanel
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Text="{Binding TodayConsultationCount, FallbackValue=0}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                Text=" 人" />
                        </StackPanel>

                        <!--  待完成医案  -->
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                Text="待完成医案 " />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                                Text="{Binding PendingCaseCount, FallbackValue=0}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                                Text=" 份" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  下层5个辅助卡片  -->
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <!--  辅助卡片1：患者管理  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToPatientManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconPatients}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="患者管理" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  辅助卡片2：挂号队列  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToRegistrationQueueCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconRegistration}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="挂号队列" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  辅助卡片3：医案查询  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToMedicalCaseQueryCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconMedicalCase}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="医案查询" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  辅助卡片4：药材库  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToHerbLibraryCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconHerbs}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="药材库" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  辅助卡片5：验方库  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToFormulaLibraryCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconFormula}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="验方库" />
                        </StackPanel>
                    </Button>
                </Border>


            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
