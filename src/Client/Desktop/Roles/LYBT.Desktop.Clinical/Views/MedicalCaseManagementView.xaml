<!--
    MedicalCaseManagementView - 医案管理视图

    薄包装View，复用业务模块的MedicalCaseMasterDetailControl
    View在角色台，Control在业务模块

    权限设计：
    - 诊所共享医案：只读参考
    - 医生自创医案：可完整管理
-->
<UserControl x:Class="LYBT.Desktop.Clinical.Views.MedicalCaseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:medicalCaseControls="clr-namespace:LYBT.Desktop.MedicalCase.Controls;assembly=LYBT.Desktop.MedicalCase"
             xmlns:vm="clr-namespace:LYBT.Desktop.MedicalCase.ViewModels;assembly=LYBT.Desktop.MedicalCase"
             d:DataContext="{d:DesignInstance vm:MedicalCaseMasterDetailViewModel}"
             mc:Ignorable="d">
    <Grid>
        <medicalCaseControls:MedicalCaseMasterDetailControl />
    </Grid>
</UserControl>
