<UserControl
    x:Class="LYBT.Desktop.Admin.Views.SystemSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!--  Epic #1832 Phase 1: 已完全迁移到UnifiedDesignSystem  -->
        <!--  所有样式从UnifiedDesignSystem.xaml (应用级资源) 继承  -->
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,2"
            Padding="{StaticResource ToolBarPadding}"
            Background="{StaticResource SurfaceBrush}">
            <TextBlock Style="{StaticResource HeaderText}" Text="系统设置" />
        </Border>

        <!--  内容区域  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="{StaticResource SpacingLarge}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  基本设置  -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="基本设置" />

                        <!--  系统名称  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource LabelText}"
                                Text="系统名称：" />
                            <TextBox
                                Grid.Column="1"
                                Width="Auto"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  医院名称  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource LabelText}"
                                Text="医院名称：" />
                            <TextBox
                                Grid.Column="1"
                                Width="Auto"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding HospitalName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  联系电话  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource LabelText}"
                                Text="联系电话：" />
                            <TextBox
                                Grid.Column="1"
                                Width="Auto"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  数据库设置  -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="数据库设置" />

                        <!--  数据库备份  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource LabelText}"
                                Text="自动备份：" />
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="启用数据库自动备份"
                                FontSize="{StaticResource FontSizeNormal}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                IsChecked="{Binding AutoBackupEnabled}" />
                        </Grid>

                        <!--  备份路径  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource LabelText}"
                                Text="备份路径：" />
                            <TextBox
                                Grid.Column="1"
                                Width="Auto"
                                Margin="0,0,12,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding BrowseBackupPathCommand}"
                                Content="浏览..."
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  操作按钮  -->
                <StackPanel
                    Margin="{StaticResource SpacingMedium}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,12,0"
                        Command="{Binding SaveCommand}"
                        Content="保存设置"
                        Style="{StaticResource PrimaryButton}" />
                    <Button
                        Margin="0,0,12,0"
                        Command="{Binding ResetCommand}"
                        Content="重置"
                        Style="{StaticResource SecondaryButton}" />
                    <Button
                        Command="{Binding NavigateToHomeCommand}"
                        Content="🏠 返回主页"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="返回管理员主页" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
