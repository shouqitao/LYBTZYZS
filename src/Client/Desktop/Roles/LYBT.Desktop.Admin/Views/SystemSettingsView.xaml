<UserControl x:Class="LYBT.Desktop.Admin.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- Phase 1: 迁移到UnifiedDesignSystem - 删除所有内联样式 -->
        <!-- 所有样式现在从UnifiedDesignSystem.xaml (应用级资源) 继承 -->
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="White"
                Padding="40,24"
                Margin="0,0,0,2">
            <TextBlock Text="系统设置"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="40,24">
            <StackPanel>
                <!-- 基本设置 -->
                <Border Background="White"
                        Padding="32"
                        Margin="0,0,0,16"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="基本设置"/>

                        <!-- 系统名称 -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="系统名称："/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     Padding="12,0"
                                     FontSize="15"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1"/>
                        </Grid>

                        <!-- 医院名称 -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="医院名称："/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding HospitalName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     Padding="12,0"
                                     FontSize="15"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1"/>
                        </Grid>

                        <!-- 联系电话 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="联系电话："/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     Padding="12,0"
                                     FontSize="15"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 数据库设置 -->
                <Border Background="White"
                        Padding="32"
                        Margin="0,0,0,16"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="数据库设置"/>

                        <!-- 数据库备份 -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="自动备份："/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AutoBackupEnabled}"
                                      Content="启用数据库自动备份"
                                      VerticalAlignment="Center"
                                      FontSize="15"/>
                        </Grid>

                        <!-- 备份路径 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="备份路径："/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     Padding="12,0"
                                     FontSize="15"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1"
                                     Margin="0,0,12,0"/>
                            <Button Grid.Column="2"
                                    Content="浏览..."
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseBackupPathCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存设置"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,12,0"
                            Command="{Binding SaveCommand}"/>                    <Button Content="重置"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetCommand}"
                            Margin="0,0,12,0"/>
                    <Button Content="🏠 返回主页"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToHomeCommand}"
                            ToolTip="返回管理员主页" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
