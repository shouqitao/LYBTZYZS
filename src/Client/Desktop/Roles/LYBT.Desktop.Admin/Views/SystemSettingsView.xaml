<!--
    SystemSettingsView - 系统设置视图
    统一风格: 与其他管理界面保持一致的工具栏布局
-->
<UserControl
    x:Class="LYBT.Desktop.Admin.Views.SystemSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏: 与其他管理界面保持一致  -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左侧: 标题  -->
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource HeaderText}"
                    Text="系统设置" />

                <!--  右侧: 操作按钮  -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding SaveCommand}"
                        Content="保存设置"
                        Style="{StaticResource SuccessButton}"
                        Margin="{StaticResource SpacingSmall}" />
                    <Button
                        Command="{Binding ResetCommand}"
                        Content="重置"
                        Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource SpacingSmall}" />
                    <Button
                        Command="{Binding NavigateToHomeCommand}"
                        Content="返回主页"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="返回管理员主页"
                        Margin="{StaticResource SpacingSmall}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  内容区域  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="{StaticResource SpacingLarge}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  基本设置  -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="基本设置" />

                        <!--  系统名称  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="系统名称：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  医院名称  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="医院名称：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding HospitalName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  联系电话  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="联系电话：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  数据库设置  -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="数据库设置" />

                        <!--  数据库备份  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="自动备份：" />
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="启用数据库自动备份"
                                FontSize="{StaticResource FontSizeNormal}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                IsChecked="{Binding AutoBackupEnabled}" />
                        </Grid>

                        <!--  备份路径  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="备份路径：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                Margin="0,0,12,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding BrowseBackupPathCommand}"
                                Content="浏览..."
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
