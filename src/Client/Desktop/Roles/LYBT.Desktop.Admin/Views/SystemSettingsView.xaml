<UserControl x:Class="LYBT.Desktop.Admin.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- Epic #1832 Phase 1: 已完全迁移到UnifiedDesignSystem -->
        <!-- 所有样式从UnifiedDesignSystem.xaml (应用级资源) 继承 -->
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                Padding="{StaticResource ToolBarPadding}"
                Margin="0,0,0,2">
            <TextBlock Text="系统设置"
                       Style="{StaticResource HeaderText}"/>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource SpacingLarge}">
            <StackPanel>
                <!-- 基本设置 -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Text="基本设置"
                                   Style="{StaticResource TitleText}"/>

                        <!-- 系统名称 -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="系统名称："
                                       Style="{StaticResource LabelText}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}"
                                     Width="Auto"
                                     HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- 医院名称 -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="医院名称："
                                       Style="{StaticResource LabelText}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding HospitalName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}"
                                     Width="Auto"
                                     HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- 联系电话 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="联系电话："
                                       Style="{StaticResource LabelText}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}"
                                     Width="Auto"
                                     HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 数据库设置 -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Text="数据库设置"
                                   Style="{StaticResource TitleText}"/>

                        <!-- 数据库备份 -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="自动备份："
                                       Style="{StaticResource LabelText}"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AutoBackupEnabled}"
                                      Content="启用数据库自动备份"
                                      VerticalAlignment="Center"
                                      FontSize="{StaticResource FontSizeNormal}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <!-- 备份路径 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="备份路径："
                                       Style="{StaticResource LabelText}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBox}"
                                     Width="Auto"
                                     HorizontalAlignment="Stretch"
                                     Margin="0,0,12,0"/>
                            <Button Grid.Column="2"
                                    Content="浏览..."
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseBackupPathCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="{StaticResource SpacingMedium}">
                    <Button Content="保存设置"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,12,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="重置"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetCommand}"
                            Margin="0,0,12,0"/>
                    <Button Content="🏠 返回主页"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToHomeCommand}"
                            ToolTip="返回管理员主页" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
