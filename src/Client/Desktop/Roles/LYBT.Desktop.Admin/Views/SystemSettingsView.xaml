<!--
    SystemSettingsView - 系统设置视图
    统一规范: 提供保存配置和重置的功能按钮操作
-->
<UserControl
    x:Class="LYBT.Desktop.Admin.Views.SystemSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏: 提供保存配置和重置  -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左侧: 标题  -->
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource HeaderText}"
                    Text="系统设置" />

                <!--  右侧: 操作按钮  -->
                <!--  返回首页按钮已移除 - 使用导航栏的"首页"按钮统一导航  -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Margin="{StaticResource SpacingSmall}"
                        Command="{Binding SaveCommand}"
                        Content="保存配置"
                        Style="{StaticResource SuccessButton}" />
                    <Button
                        Margin="{StaticResource SpacingSmall}"
                        Command="{Binding ResetCommand}"
                        Content="重置"
                        Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  设置内容  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="{StaticResource SpacingLarge}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  基本设置  -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="基本设置" />

                        <!--  系统名称  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="系统名称：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  医院名称  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="医院名称：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding HospitalName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  联系电话  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="联系电话：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  D2: 诊所信息配置  -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="诊所信息" />

                        <!--  诊所名称  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="诊所名称：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding ClinicName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  科室  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="科室：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding ClinicDepartment, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  地址  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="地址：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding ClinicAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  电话  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="电话：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding ClinicPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  邮箱  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="邮箱：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding ClinicEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--  执业许可证号  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="许可证号：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding LicenseNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  数据库配置  -->
                <Border Style="{StaticResource ContentContainer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitleText}" Text="数据库配置" />

                        <!--  数据库备份  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="自动备份：" />
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="启用数据库自动备份"
                                FontSize="{StaticResource FontSizeNormal}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                IsChecked="{Binding AutoBackupEnabled}" />
                        </Grid>

                        <!--  备份路径  -->
                        <Grid Margin="{StaticResource SpacingMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelText}"
                                Text="备份路径：" />
                            <TextBox
                                Grid.Column="1"
                                MaxWidth="400"
                                Margin="0,0,12,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BaseTextBox}"
                                Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding BrowseBackupPathCommand}"
                                Content="浏览..."
                                Style="{StaticResource SecondaryButton}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
