<UserControl
    x:Class="LYBT.Desktop.Admin.Views.AdminHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!--  BooleanToVisibilityConverter for sysadmin visibility control  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <!--  功能卡片样式  -->
        <Style x:Key="FunctionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F8FF" />
                    <Setter Property="BorderBrush" Value="#2E86AB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  卡片图标样式  -->
        <Style x:Key="CardIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>

        <!--  卡片标题样式  -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2E86AB" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Margin="40">
                <!--  标题区域  -->
                <TextBlock
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#2E86AB"
                    Text="凌隐宝堂中医诊所" />
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    Foreground="#666"
                    Text="系统管理工作台" />

                <!--  用户信息与操作区域 (Issue #1892)  -->
                <Border
                    MinWidth="400"
                    Margin="0,0,0,30"
                    Padding="20,15"
                    HorizontalAlignment="Center"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Text="👤" />
                        <TextBlock
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding CurrentUserName, FallbackValue='系统管理员'}" />
                        <!--  Issue #1887-1892: 独立的修改信息和修改密码按钮  -->
                        <!--  sysadmin 用户隐藏"修改个人信息"按钮  -->
                        <Button
                            Margin="0,0,10,0"
                            Padding="15,8"
                            Command="{Binding EditProfileCommand}"
                            Content="修改个人信息"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding IsNotSysAdmin, Converter={StaticResource BoolToVisConverter}}" />
                        <Button
                            Margin="0"
                            Padding="15,8"
                            Command="{Binding ChangePasswordCommand}"
                            Content="修改密码"
                            Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>

                <!--  6个功能卡片（3×2网格）  -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  卡片1: 用户管理  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource FunctionCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToUserManagementCommand}" Gesture="LeftClick" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="👤" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="用户管理" />
                        </StackPanel>
                    </Border>

                    <!--  卡片2: 药材管理  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource FunctionCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToHerbManagementCommand}" Gesture="LeftClick" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="🌿" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="药材管理" />
                        </StackPanel>
                    </Border>

                    <!--  卡片3: 患者管理  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource FunctionCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToPatientManagementCommand}" Gesture="LeftClick" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="🏥" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="患者管理" />
                        </StackPanel>
                    </Border>

                    <!--  卡片4: 验方管理  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource FunctionCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToFormulaManagementCommand}" Gesture="LeftClick" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="📋" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="验方管理" />
                        </StackPanel>
                    </Border>

                    <!--  卡片5: 病历管理  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource FunctionCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToMedicalCaseManagementCommand}" Gesture="LeftClick" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="📁" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="病历管理" />
                        </StackPanel>
                    </Border>

                    <!--  卡片6: 系统设置  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource FunctionCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToSystemSettingsCommand}" Gesture="LeftClick" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardIconStyle}" Text="⚙️" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="系统设置" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  底部提示  -->
                <TextBlock
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlock}"
                    Text="提示：点击功能卡片进入相应管理模块"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
