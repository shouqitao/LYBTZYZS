<UserControl
    x:Class="LYBT.Desktop.Admin.Views.AdminHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <!--  全屏居中布局  -->
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!--  标题区域  -->
            <TextBlock
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeXXL}"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryBrush}"
                Text="系统管理工作台" />
            <TextBlock
                Margin="0,0,0,40"
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeMD}"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="凌隐宝堂中医诊所" />

            <!--  7个功能卡片（统一为 Button + Path 矢量图标）居中  -->
            <UniformGrid
                HorizontalAlignment="Center"
                Columns="3"
                Rows="3">

                <!--  卡片1: 用户管理  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToUserManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconUsers}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="用户管理" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  卡片2: 药材管理  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToHerbManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconHerbs}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="药材管理" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  卡片3: 患者管理  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToPatientManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconPatients}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="患者管理" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  卡片4: 验方管理  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToFormulaManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconFormula}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="验方管理" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  卡片5: 医案管理  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToMedicalCaseManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconMedicalCase}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="医案管理" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  卡片6: 系统设置  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToSystemSettingsCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconSettings}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="系统设置" />
                        </StackPanel>
                    </Button>
                </Border>

                <!--  卡片7: 统计报表  -->
                <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                    <Button Command="{Binding NavigateToReportsCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource CardIconStyle}" Data="{DynamicResource IconReports}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="统计报表" />
                        </StackPanel>
                    </Button>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
