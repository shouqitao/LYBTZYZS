<UserControl x:Class="LYBT.Desktop.Admin.Sysadmin.Views.SysadminHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sysadmin="clr-namespace:LYBT.Desktop.Admin.Sysadmin.ViewModels"
             xmlns:views="clr-namespace:LYBT.Desktop.Admin.Sysadmin.Views"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:prism="http://prismlibrary.com/">

    <UserControl.Resources>
        <Style x:Key="FunctionCardStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="MinHeight" Value="180" />
            <Setter Property="Background" Value="{DynamicResource SurfaceLevel0Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Outline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.1" ShadowDepth="2" Color="Black" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" Opacity="0.2" ShadowDepth="4" Color="{DynamicResource MaterialDesignColor.PrimaryDark}" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <materialDesign:DialogHost>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SurfaceLevel0Brush}">
            <StackPanel Margin="32" MaxWidth="800">

                <!-- 标题区 -->
                <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           Text="运维设置" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Text="凌隐宝堂中医诊所 · 系统运维"
                           Opacity="0.6" Margin="0,0,0,32" />

                <!-- 配置中心（SHELL-018 Phase 2+3: 双模式布局——远程 2 面板 / 本地 2 面板） -->
                <Border Margin="0,0,0,24" Style="{StaticResource FunctionCardStyle}" MinHeight="0" Padding="24">
                    <TabControl>
                        <!-- Tab 1：客户端配置（远程）/ 本地配置（本地全栈） -->
                        <TabItem Header="配置">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Text="修改配置后自动保存至本机 JSON 文件；功能开关与诊所信息即时生效，其余重启后生效。"
                                           Opacity="0.6" Margin="0,0,0,16" />

                        <!-- 组 1：诊所信息 -->
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="诊所信息" Margin="0,8,0,8" />
                        <!-- 视觉基线 v1 -->
    <Grid Background="{DynamicResource SurfaceLevel0Brush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="名称" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ClinicName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,8">
                                <TextBlock Text="地址" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ClinicAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="电话" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ClinicPhone, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,8">
                                <TextBlock Text="科室" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ClinicDepartment, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="执业许可证号" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ClinicLicenseNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,8">
                                <TextBlock Text="邮箱" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ClinicEmail, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                        </Grid>
                        <Button Content="保存诊所信息"
                                Command="{Binding ConfigCenter.SaveClinicCommand}"
                                HorizontalAlignment="Right" Padding="16,6" Margin="0,0,0,12" />

                        <!-- 组 2：会话设置 -->
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="会话设置（重启生效）" Margin="0,8,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="超时（分钟，1-120）" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.InactivityTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,12,8">
                                <TextBlock Text="提前提醒（分钟，0-10）" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.WarningBeforeTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,8">
                                <TextBlock Text="检测间隔（秒，10-120）" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ActivityCheckIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                        </Grid>
                        <Button Content="保存会话设置"
                                Command="{Binding ConfigCenter.SaveSessionCommand}"
                                HorizontalAlignment="Right" Padding="16,6" Margin="0,0,0,12" />

                        <!-- 组 3：连接设置 -->
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="连接设置（重启生效）" Margin="0,8,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="API 地址" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="测试连通"
                                    Command="{Binding ConfigCenter.TestConnectionCommand}"
                                    Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Bottom" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="超时（秒，5-300）" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding ConfigCenter.ApiTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                        </Grid>
                        <Button Content="保存连接设置"
                                Command="{Binding ConfigCenter.SaveConnectionCommand}"
                                HorizontalAlignment="Right" Padding="16,6" Margin="0,0,0,12" />

                        <!-- 组 4：安全策略 -->
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="安全策略（重启生效）" Margin="0,8,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="新用户首次登录强制改密"
                                      IsChecked="{Binding ConfigCenter.ForceChangeOnFirstLogin}"
                                      VerticalAlignment="Center" Margin="0,0,12,8" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="新用户默认密码（留空不改）" FontSize="12" Opacity="0.7" />
                                <PasswordBox x:Name="NewUserPasswordBox" Padding="8,6"
                                             behaviors:PasswordBoxHelper.BoundPassword="{Binding ConfigCenter.NewUserPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="保存安全策略"
                                Command="{Binding ConfigCenter.SaveSecurityCommand}"
                                CommandParameter="{Binding ConfigCenter.NewUserPassword}"
                                HorizontalAlignment="Right" Padding="16,6" Margin="0,0,0,12" />

                        <!-- 组 5：功能开关（热更新） -->
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="功能开关（即时生效）" Margin="0,8,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="处方冲突时覆盖（OverwriteConflicts）"
                                      IsChecked="{Binding ConfigCenter.OverwriteConflicts}"
                                      VerticalAlignment="Center" Margin="0,0,12,8" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="重复药材合并策略（Skip/Update/Error/Max）" FontSize="12" Opacity="0.7" />
                                <ComboBox SelectedItem="{Binding ConfigCenter.DuplicateHerbMergeStrategy}"
                                          ItemsSource="{x:Static sysadmin:ConfigurationCenterViewModel.MergeStrategies}"
                                          Padding="8,4" />
                            </StackPanel>
                        </Grid>
                        <Button Content="保存功能开关"
                                Command="{Binding ConfigCenter.SaveFeatureTogglesCommand}"
                                HorizontalAlignment="Right" Padding="16,6" Margin="0,0,0,12" />

                        <!-- 读卡器诊断（SHELL-019: 测试模式——厂家选择/探测/读卡/参数覆盖/持久化） -->
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="读卡器诊断" Margin="0,8,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="厂家选择" FontSize="12" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding CardReaderDiagnostics.ReaderTypes}"
                                          SelectedItem="{Binding CardReaderDiagnostics.SelectedReaderType}"
                                          Padding="8,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,12,8">
                                <TextBlock Text="USB 端口（仅自动检测失败时覆盖）" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding CardReaderDiagnostics.UsbPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,8">
                                <TextBlock Text="连接/读取超时（毫秒）" FontSize="12" Opacity="0.7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CardReaderDiagnostics.ConnectTimeout, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Text="{Binding CardReaderDiagnostics.ReadTimeout, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                </Grid>
                            </StackPanel>
                            <Button Grid.Column="3" Content="运行诊断"
                                    Command="{Binding CardReaderDiagnostics.RunDiagnosticsCommand}"
                                    Padding="16,6" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                        </Grid>

                        <!-- 诊断报告 -->
                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}" BorderThickness="1"
                                CornerRadius="4" Padding="12,8" Margin="0,0,0,8" MaxHeight="160">
                            <ItemsControl ItemsSource="{Binding CardReaderDiagnostics.ReportLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Margin="0,1" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                            <TextBlock Text="{Binding CardReaderDiagnostics.StatusMessage}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="保存配置（测试通过后）"
                                    Command="{Binding CardReaderDiagnostics.SaveSettingsCommand}"
                                    Padding="16,6" />
                        </StackPanel>

                        <!-- 本地模式：重启内嵌服务（决策 B——本地配置生效 = 重启 LocalWebAPI） -->
                        <Button Content="重启本地服务（使配置生效）"
                                Command="{Binding ConfigCenter.RestartLocalServiceCommand}"
                                HorizontalAlignment="Right" Padding="16,6"
                                Visibility="{Binding ConfigCenter.IsLocalMode, Converter={x:Static converters:Cvt.BoolToVis}}" />

                        <!-- 状态条 -->
                        <Border Background="#F5F5F5" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ConfigCenter.StatusMessage}"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Primary}" FontSize="12" />
                        </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab 2（远程）：服务端配置 -->
                        <TabItem Header="服务端配置" Visibility="{Binding IsRemoteMode, Converter={x:Static converters:Cvt.BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Text="通过 Configuration API 管理远程服务器业务参数（敏感配置只读掩码；改后重启生效）。"
                                           Opacity="0.6" Margin="0,0,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 节列表 -->
                                    <ListBox Grid.Column="0"
                                             ItemsSource="{Binding ServerConfig.Sections}"
                                             SelectedItem="{Binding ServerConfig.SelectedSection}"
                                             DisplayMemberPath="DisplayName"
                                             Margin="0,0,12,0" />

                                    <!-- 节键值编辑（I-9 修复：绑可编辑条目集合，脱敏项只读） -->
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ServerConfig.SelectedSection.Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsReadOnly}" Padding="8,6" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="保存节" Command="{Binding ServerConfig.SaveSectionCommand}" Padding="16,6" Margin="0,0,12,0" />
                                    <Button Content="重启服务" Command="{Binding ServerConfig.RestartServerCommand}" Padding="16,6" />
                                </StackPanel>

                                <Border Background="#F5F5F5" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding ServerConfig.StatusMessage}"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" FontSize="12" />
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab 2'（本地）：备份恢复 -->
                        <TabItem Header="备份恢复" Visibility="{Binding IsLocalMode, Converter={x:Static converters:Cvt.BoolToVis}}">
                            <views:BackupManagementView />
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- 功能入口：运维功能卡片导航（设计决策 2026-08-17：各角色 Home View 是导航中心） -->
                <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Text="功能入口" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">

                    <!-- 卡片1: 用户管理 -->
                    <Border Margin="0,0,12,0" Style="{StaticResource FunctionCardStyle}">
                        <Button Command="{Binding NavigateToUserManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountTie"
                                                          Width="40" Height="40"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,12"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="用户管理" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 卡片2: 日志控制 -->
                    <Border Margin="0,0,12,0" Style="{StaticResource FunctionCardStyle}">
                        <Button Command="{Binding NavigateToLogLevelControlCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Tune"
                                                          Width="40" Height="40"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,12"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="日志控制" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 卡片3: 部署管理 -->
                    <Border Margin="0,0,12,0" Style="{StaticResource FunctionCardStyle}">
                        <Button Command="{Binding NavigateToDeploymentCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Upload"
                                                          Width="40" Height="40"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,12"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="部署管理" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 卡片4: 安全审计（US-SHELL-014） -->
                    <Border Margin="0,0,12,0" Style="{StaticResource FunctionCardStyle}">
                        <Button Command="{Binding NavigateToSecurityAuditLogCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldSearch"
                                                          Width="40" Height="40"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,12"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="安全审计" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 卡片5: 备份管理（设计 N3：SysadminHome 补备份入口） -->
                    <Border Margin="0,0,12,0" Style="{StaticResource FunctionCardStyle}">
                        <Button Command="{Binding NavigateToBackupManagementCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="BackupRestore"
                                                          Width="40" Height="40"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,12"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="备份管理" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 卡片6: 初始化向导（B-07：可随时重新运行首次运行向导） -->
                    <Border Margin="0,0,12,0" Style="{StaticResource FunctionCardStyle}">
                        <Button Command="{Binding NavigateToInitializationWizardCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AutoFix"
                                                          Width="40" Height="40"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,12"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}" Text="初始化向导" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <!-- 状态卡片 -->
                <UniformGrid Columns="2">

                    <!-- 数据库状态 -->
                    <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Database"
                                                      Width="40" Height="40"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,0,16"
                                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Text="数据库"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <materialDesign:PackIcon Kind="CheckCircle"
                                                          Width="16" Height="16"
                                                          Margin="0,0,6,0" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Text="{Binding Dashboard.DbStatus.Value}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 系统信息 -->
                    <Border Margin="12" Style="{StaticResource FunctionCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline"
                                                      Width="40" Height="40"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,0,16"
                                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Text="系统信息"
                                       HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Text="{Binding Dashboard.SystemInfo.Value}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Text="{Binding Dashboard.SystemInfo.Status}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </materialDesign:DialogHost>
</UserControl>
