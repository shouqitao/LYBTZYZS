<UserControl x:Class="LYBT.Desktop.Admin.Sysadmin.Views.SecurityAuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Border Margin="16" Background="#FBF7F3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Command="{Binding GoBackCommand}" Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="返回" Margin="0,0,8,0">
                    <md:PackIcon Kind="ArrowLeft"/>
                </Button>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource MaterialDesignTitleTextBlock}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Filters -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Width="160" Margin="0,0,8,0"
                         md:HintAssist.Hint="事件类型"
                         Text="{Binding FilterEventType, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Width="160" Margin="0,0,8,0"
                         md:HintAssist.Hint="用户名"
                         Text="{Binding FilterUserName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="搜索" Command="{Binding SearchCommand}"
                        Style="{StaticResource MaterialDesignContainedButton}" Margin="0,0,8,0"/>
                <Button Content="重置" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>

            <!-- Empty state -->
            <TextBlock Grid.Row="2" Text="{Binding EmptyMessage}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={x:Static converters:Cvt.BoolToVis}}"/>

            <!-- Log list -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding Logs}" AutoGenerateColumns="False"
                      IsReadOnly="True" GridLinesVisibility="None" HeadersVisibility="Column"
                      CanUserAddRows="False" SelectedItem="{Binding SelectedLog}"
                      Visibility="{Binding IsEmpty, Converter={x:Static converters:Cvt.InverseBoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160"/>
                    <DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="120"/>
                    <DataGridTextColumn Header="事件类型" Binding="{Binding EventType}" Width="140"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                    <DataGridTemplateColumn Header="结果" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="失败"/>
                                            <Setter Property="Foreground" Value="#A4262C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                    <Setter Property="Text" Value="成功"/>
                                                    <Setter Property="Foreground" Value="#228B22"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="失败原因" Binding="{Binding FailureReason}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail + loading -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="{Binding SelectedLog.Details, StringFormat=详情：{0}}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedLog}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="加载中..." HorizontalAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="第"/><Run Text="{Binding CurrentPage, Mode=OneWay}"/><Run Text="页"/>
                        <Run Text="/"/><Run Text="{Binding TotalPages, Mode=OneWay}"/><Run Text="页"/>
                        <Run Text="(共"/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text="条)"/>
                    </TextBlock>
                    <Button Content="下一页" Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
