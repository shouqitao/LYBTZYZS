<UserControl x:Class="LYBT.Desktop.Admin.Sysadmin.Views.ConfigExportImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <materialDesign:DialogHost>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SurfaceLevel0Brush}">
            <StackPanel Margin="32" MaxWidth="980">

                <!-- 页面标题 -->
                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Text="配置导入导出" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Text="US-SHELL-016 · 把可移植的客户端配置导出为单个 JSON 配置包，或从配置包导入并应用"
                           Opacity="0.6" Margin="0,0,0,24" />

                <!-- 导出卡片 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="导出配置包" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.6"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="导出诊所信息、连接设置、功能开关与角色权限快照；JWT 密钥、默认密码、数据库口令等安全项一律不写入配置包。" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="保存位置（*.json）"
                                     Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="选择保存位置…"
                                    Command="{Binding SelectExportPathCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="12,0,0,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="导出配置包"
                                    Command="{Binding ExportCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 导入卡片 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="导入配置包" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.6"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="导入前先校验文件格式（JSON 解析失败或 packageVersion 不支持将被拒绝）；导入会覆盖当前配置，安全项（口令等）不在包内、保持本机现值。" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="配置文件路径（*.json）"
                                     Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="选择配置文件…"
                                    Command="{Binding SelectImportPathCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="12,0,0,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="导入配置包"
                                    Command="{Binding ImportCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </Grid>

                        <!-- 进行中 -->
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,16,0,0"
                                     Visibility="{Binding IsBusy, Converter={x:Static converters:Cvt.BoolToVis}}" />

                        <!-- 重启提示 -->
                        <Border Background="#FFF4CE" CornerRadius="4" Padding="12,8" Margin="0,16,0,0"
                                Visibility="{Binding RequiresRestart, Converter={x:Static converters:Cvt.BoolToVis}}">
                            <TextBlock Text="连接设置已变更：请重启应用后生效。"
                                       TextWrapping="Wrap" Foreground="#8A6D3B" FontSize="12" />
                        </Border>

                        <!-- 导入报告 -->
                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}" BorderThickness="1"
                                CornerRadius="4" Padding="12,8" Margin="0,16,0,0" MaxHeight="240"
                                Visibility="{Binding HasReport, Converter={x:Static converters:Cvt.BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ReportLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="0,1"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- 状态 / 错误 -->
                        <TextBlock Text="{Binding StatusMessage}" Opacity="0.75"
                                   TextWrapping="Wrap" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#A4262C"
                                   TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 说明卡片（只读） -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="配置包说明" Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run Text="含：" FontWeight="SemiBold" />
                            <Run Text="诊所信息、连接设置（模式 / 远程地址 / 本地数据库元数据）、功能开关、角色权限快照。" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run Text="不含：" FontWeight="SemiBold" />
                            <Run Text="JWT 密钥、默认密码、数据库口令等安全项与令牌；口令以占位符 *** 呈现，导入时保留本机当前口令。" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   TextWrapping="Wrap">
                            <Run Text="角色权限：" FontWeight="SemiBold" />
                            <Run Text="由代码定义（导航守卫 + 角色定义），导入仅校验快照一致性，不覆盖权限。" />
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </materialDesign:DialogHost>
</UserControl>
