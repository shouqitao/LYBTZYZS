<UserControl x:Class="LYBT.Desktop.Admin.Sysadmin.Views.BackupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:prism="http://prismlibrary.com/">

    <materialDesign:DialogHost>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="#FBF7F3">
            <StackPanel Margin="32" MaxWidth="900">

                <!-- 页面标题 -->
                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Text="备份恢复" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Text="本地数据库备份与恢复（LocalDB）"
                           Opacity="0.6" Margin="0,0,0,24" />

                <!-- 备份状态卡片 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <!-- 视觉基线 v1 -->
    <Grid Background="#FBF7F3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Text="上次备份" Opacity="0.6" />
                            <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Text="{Binding LastBackupTime}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Text="备份文件数" Opacity="0.6" />
                            <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Text="{Binding BackupFileCount}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Text="总大小" Opacity="0.6" />
                            <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Text="{Binding TotalSize}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="立即备份" Command="{Binding BackupCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                            <TextBlock Text="{Binding StatusMessage}" Opacity="0.6"
                                       Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="260" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- 备份文件列表 -->
                <materialDesign:Card Padding="24" UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="备份文件（保留 7 天）" Margin="0,0,0,12" />

                        <DataGrid ItemsSource="{Binding BackupFiles}"
                                  SelectedItem="{Binding SelectedBackup}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="360"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="备份时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeBytes}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="刷新" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="恢复所选备份" Margin="16,0,0,0"
                                    Click="RestoreButton_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </materialDesign:DialogHost>
</UserControl>
