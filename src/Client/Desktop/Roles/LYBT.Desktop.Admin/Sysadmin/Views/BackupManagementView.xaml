<UserControl x:Class="LYBT.Desktop.Admin.Sysadmin.Views.BackupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <materialDesign:DialogHost>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SurfaceLevel0Brush}">
            <StackPanel Margin="32" MaxWidth="980">

                <!-- 页面标题 -->
                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Text="备份恢复" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                           Text="数据库备份与恢复（远程模式=服务端 SQL Server；本地模式=本机 LocalDB）"
                           Opacity="0.6" Margin="0,0,0,24" />

                <!-- 备份状态卡片 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Text="上次备份" Opacity="0.6" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Text="{Binding LastBackupTime}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Text="备份文件数" Opacity="0.6" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Text="{Binding BackupFileCount}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Text="总大小" Opacity="0.6" />
                                <TextBlock Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Text="{Binding TotalSize}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.6"
                                   TextWrapping="Wrap" Margin="0,12,0,0">
                            <Run Text="备份目录："/><Run Text="{Binding BackupDirectory, Mode=OneWay}"/>
                            <Run Text="　|　"/><Run Text="{Binding RetentionInfo, Mode=OneWay}"/>
                            <Run Text="　|　"/><Run Text="{Binding AutoBackupInfo, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- 进度（备份/恢复进行中） -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsOperationRunning, Converter={x:Static converters:Cvt.BoolToVis}}">
                            <TextBlock Text="{Binding OperationPhase}" Opacity="0.75" Margin="0,0,0,6" />
                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}" Opacity="0.75"
                                   TextWrapping="Wrap" Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#A4262C"
                                   TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 备份操作卡片 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24"
                                     UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="执行备份" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="压缩备份" IsChecked="{Binding CompressBackup}"
                                      VerticalAlignment="Center" Margin="0,0,16,0" />
                            <CheckBox Content="加密备份" IsChecked="{Binding EncryptBackup}"
                                      VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBox Width="220" materialDesign:HintAssist.Hint="加密口令（加密时必填）"
                                     Text="{Binding EncryptionPassword, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding EncryptBackup}"
                                     VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="立即全量备份" Command="{Binding BackupFullCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button Content="立即差异备份" Command="{Binding BackupDifferentialCommand}"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="差异备份依赖最近一次全量备份" />
                            <Button Content="清理过期备份" Command="{Binding CleanupCommand}"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 备份文件列表 -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24" UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="{Binding RetentionInfo, StringFormat=备份文件（{0}，超期自动清理）}"
                                   Margin="0,0,0,12" />

                        <DataGrid ItemsSource="{Binding BackupFiles}"
                                  SelectedItem="{Binding SelectedBackup}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="320"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="90" />
                                <DataGridTextColumn Header="备份时间" Binding="{Binding CreatedAtText}" Width="150" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                                <DataGridTextColumn Header="保护" Binding="{Binding ProtectionText}" Width="90" />
                                <DataGridTextColumn Header="基准" Binding="{Binding BaseText}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="刷新" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="恢复所选备份" Margin="12,0,0,0"
                                    Command="{Binding OpenRestorePanelCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button Content="删除所选备份" Margin="12,0,0,0"
                                    Command="{Binding DeleteCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 恢复确认面板（红色警告 + 输入「确认恢复」+ 倒计时） -->
                <materialDesign:Card Margin="0,0,0,16" Padding="24" UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp3"
                                     Visibility="{Binding IsRestorePanelVisible, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Text="恢复确认" Foreground="#A4262C" Margin="0,0,0,8" />
                        <TextBlock Foreground="#A4262C" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="警告：整库恢复将覆盖当前数据库的全部数据；选择性恢复将按所选表/记录覆盖当前库对应数据。恢复前会自动创建保护性备份，恢复完成后需重启应用。" />
                        <TextBlock Text="{Binding RestoreTargetText, StringFormat=目标备份：{0}}"
                                   TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="整库恢复" GroupName="RestoreMode"
                                         IsChecked="{Binding IsSelectiveRestore, Converter={x:Static converters:Cvt.InverseBool}}"
                                         VerticalAlignment="Center" Margin="0,0,16,0" />
                            <RadioButton Content="选择性恢复（表/记录）" GroupName="RestoreMode"
                                         IsChecked="{Binding IsSelectiveRestore}"
                                         VerticalAlignment="Center" />
                            <CheckBox Content="恢复前自动备份当前数据" Margin="24,0,0,0"
                                      IsChecked="{Binding CreatePreRestoreBackup}"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBox materialDesign:HintAssist.Hint="备份口令（备份已加密时必填）" Width="280"
                                 HorizontalAlignment="Left"
                                 Text="{Binding RestorePassword, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <DataGrid ItemsSource="{Binding RestorableTables}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False"
                                  MaxHeight="240"
                                  GridLinesVisibility="Horizontal"
                                  Visibility="{Binding IsSelectiveRestore, Converter={x:Static converters:Cvt.BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="60" />
                                <DataGridTextColumn Header="表名" Binding="{Binding TableName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="当前记录数" Binding="{Binding RowCount}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="记录 Id（可选，逗号分隔；留空=整表）"
                                                    Binding="{Binding RecordIdsText}" Width="300"
                                                    IsReadOnly="{Binding SupportsRecordSelection, Converter={x:Static converters:Cvt.InverseBool}}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="{Binding RestoreCountdown, StringFormat=倒计时 {0}s}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Width="160" VerticalAlignment="Center"
                                     materialDesign:HintAssist.Hint="输入：确认恢复"
                                     Text="{Binding RestoreConfirmText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="执行恢复" Margin="12,0,0,0"
                                    Command="{Binding ConfirmRestoreCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                            <Button Content="取消" Margin="12,0,0,0"
                                    Command="{Binding CancelRestoreCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </materialDesign:DialogHost>
</UserControl>
