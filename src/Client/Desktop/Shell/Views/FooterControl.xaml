<UserControl x:Class="LYBT.Desktop.Shell.Views.FooterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Height="32">
    <!-- 底部状态栏：h32 暖灰 背景 顶部描边 #E9DFD7 1px padding[0,24] gap8 space_between -->
    <Border Background="#FBF7F3" BorderBrush="#E9DFD7" BorderThickness="0,1,0,0" Padding="24,0" Height="32">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左组 gap16：API状态 + 连接模式 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="{Binding ApiStatusIcon}" Width="14" Height="14"
                                         Foreground="{Binding ApiStatusColor}" VerticalAlignment="Center" ToolTip="API 连接状态"/>
                <TextBlock Text="API 已连接" FontFamily="Noto Sans SC" FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <TextBlock Text="{Binding ConnectionModeDisplay, FallbackValue=远程模式}" FontFamily="Noto Sans SC" FontSize="12" Foreground="#8D6E63" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>

            <!-- 右时间 12 #8D6E63 -->
            <TextBlock Grid.Column="1" Text="{Binding CurrentTimeDisplay, FallbackValue=2026-08-23 10:00}" FontFamily="Noto Sans SC" FontSize="12"
                       Foreground="#8D6E63" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>
