<UserControl x:Class="LYBT.Desktop.Shell.Views.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:shell="clr-namespace:LYBT.Desktop.Shell.Views">
    <!-- AppShell: Header(48) + 下部 [SideNav(240/64) + 右列(ContentRegion + Footer32)] -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Row0 ColSpan2 -->
        <shell:HeaderControl Grid.Row="0"/>

        <!-- 下部 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SideNav 贯通到底 -->
            <shell:SideNavControl Grid.Column="0"/>

            <!-- 右列 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <!-- ContentRegion 唯一 -->
                <Border Grid.Row="0" Margin="4" Background="Transparent" CornerRadius="4">
                    <ContentControl prism:RegionManager.RegionName="ContentRegion"/>
                </Border>

                <!-- Footer -->
                <shell:FooterControl Grid.Row="1"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
