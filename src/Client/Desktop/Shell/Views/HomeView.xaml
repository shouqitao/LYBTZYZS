<UserControl x:Class="LYBT.Desktop.Shell.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 中心内容区 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel MaxWidth="800" Margin="40">
                <!-- Logo区域 -->
                <TextBlock Text="凌隐宝堂中医诊所"
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="#2E86AB"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10" />
                <TextBlock Text="临床工作站"
                          FontSize="18"
                          Foreground="#666"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,40" />

                <!-- 开始接诊按钮 (Issue #1486: 150x50px, PrimaryButton) -->
                <Button Command="{Binding StartConsultationCommand}"
                       Style="{StaticResource PrimaryButton}"
                       Content="开始接诊"
                       Width="150"
                       Height="50"
                       FontSize="16"
                       Margin="0,0,0,30" />

                <!-- 今日统计卡片 (Issue #1486: 可选统计信息) -->
                <Border Background="White"
                       BorderBrush="{StaticResource BorderBrush}"
                       BorderThickness="1"
                       CornerRadius="5"
                       Margin="0,0,0,20">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                  Style="{StaticResource H2TextBlock}"
                                  Text="今日统计"
                                  Margin="0,0,0,15" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TodayConsultationCount}"
                                          FontSize="36"
                                          FontWeight="Bold"
                                          Foreground="{StaticResource SuccessBrush}"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="今日接诊"
                                          Style="{StaticResource CaptionTextBlock}"
                                          HorizontalAlignment="Center"
                                          Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PendingCaseCount}"
                                          FontSize="36"
                                          FontWeight="Bold"
                                          Foreground="{StaticResource WarningBrush}"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="待完成医案"
                                          Style="{StaticResource CaptionTextBlock}"
                                          HorizontalAlignment="Center"
                                          Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 底部提示 -->
                <TextBlock Text="提示：点击【开始接诊】选择患者后进入就诊流程"
                          Style="{StaticResource CaptionTextBlock}"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Margin="0,20,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
