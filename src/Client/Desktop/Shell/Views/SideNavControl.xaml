<UserControl x:Class="LYBT.Desktop.Shell.Views.SideNavControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <!-- 左侧导航：展开240 / 收拢64 fill=$primary-dark -->
    <Border Background="#4E342E" ClipToBounds="True">
        <DockPanel LastChildFill="True">
            <!-- 汉堡按钮 h40 居中 -->
            <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsSidebarExpanded}" Height="40" Margin="0,8,0,0"
                          Foreground="#F0E4DE" ToolTip="收起/展开侧边栏 (Ctrl+M)">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignHamburgerToggleButton}">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <!-- 导航分组标题 11/600 #C9B8A6 仅展开（设计稿：临床/目录/管理） -->
            <TextBlock DockPanel.Dock="Top" Text="功能导航" FontFamily="Noto Sans SC" FontSize="11" FontWeight="SemiBold"
                       Foreground="#C9B8A6" Opacity="0.9" Margin="12,8,0,4"
                       Visibility="{Binding IsNavTextVisible, Converter={x:Static converters:Cvt.BoolToVis}}"/>

            <!-- 底部固定区：弹性 + 分割线 + 深色模式 + 退出 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                <Border Height="1" Background="White" Opacity="0.14" Margin="12,0,12,8"/>
                <!-- 深色模式 -->
                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                              HorizontalAlignment="Center" Margin="0,4,0,0"
                              Foreground="#F0E4DE" ToolTip="切换深色/浅色主题"/>
                <Border Height="1" Background="White" Opacity="0.14" Margin="12,8,12,0"/>
                <Button Command="{Binding LogoutCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                        HorizontalAlignment="Center" Foreground="#F0E4DE" Padding="8,4" Margin="0,8,0,0" ToolTip="退出">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="退出" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center"
                                   Visibility="{Binding IsNavTextVisible, Converter={x:Static converters:Cvt.BoolToVis}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 弹性空间（占满） -->
            <Border DockPanel.Dock="Bottom" />

            <!-- 导航列表（按 Group 分组：临床/目录/管理，设计稿对齐） -->
            <ListBox SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                     ItemsSource="{Binding GroupedNavigationItems}"
                     Background="Transparent" BorderThickness="0" Margin="0,4">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontFamily="Noto Sans SC" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#C9B8A6" Opacity="0.9" Margin="12,8,0,4"
                                           Visibility="{Binding DataContext.IsNavTextVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:Cvt.BoolToVis}}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignNavigationPrimaryListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="Margin" Value="4,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Height="38" CornerRadius="10" Margin="8,0" Padding="12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Background" Value="#6D4C41"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- 简化：收拢态居中通过 HorizontalAlignment Center 触发 -->
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="18" Height="18"
                                                         VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#E8DDD4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{Binding Title}" FontFamily="Noto Sans SC" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding DataContext.IsNavTextVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static converters:Cvt.BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#E8DDD4"/>
                                            <Setter Property="FontWeight" Value="Regular"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
