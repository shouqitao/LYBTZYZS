<Window
    x:Class="LYBT.Desktop.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:prism="http://prismlibrary.com/"


    Title="{Binding Title}"
    MinWidth="1024"
    MinHeight="768"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None">
    <Window.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding QuickAddPatientCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="C"
            Command="{Binding QuickStartMedicalCaseCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding
            Key="OemComma"
            Command="{Binding ShowSettingsCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="M"
            Command="{Binding ToggleDrawerCommand}"
            Modifiers="Ctrl" />
        <!-- 导航架构改进方案 v1.0 — 后退/前进快捷键 -->
        <KeyBinding
            Key="Left"
            Command="{Binding NavigateBackCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="Right"
            Command="{Binding NavigateForwardCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="Home"
            Command="{Binding NavigateToHomeCommand}"
            Modifiers="Alt" />
        <!-- Phase 2-3: 显示导航历史面板 -->
        <KeyBinding
            Key="H"
            Command="{Binding ShowHistoryCommand}"
            Modifiers="Ctrl+Shift" />
        <!-- Phase 2-3: 循环切换区域焦点 -->
        <KeyBinding Key="F6" Command="{Binding CycleRegionsCommand}" />
    </Window.InputBindings>

    <Grid>
        <!--  登录界面  -->
        <Grid Visibility="{Binding IsNotLoggedIn, Converter={x:Static converters:Cvt.BoolToVis}}">
            <ContentControl prism:RegionManager.RegionName="LoginRegion" />
        </Grid>

        <!--  登录后主界面：侧边栏 + 工作区  -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!--  侧边栏：宽度由SidebarControl内部控制  -->
                <ColumnDefinition Width="Auto" />
                <!--  工作区：占用剩余空间  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧边栏  -->
            <controls:SidebarControl
                Grid.Row="0"
                Grid.Column="0"
                ApiStatus="{Binding ApiStatus}"
                ConnectionDisplay="{Binding ConnectionModeDisplay}"
                CurrentTime="{Binding CurrentTime}"
                CurrentUser="{Binding CurrentUser}"
                EditProfileCommand="{Binding EditProfileCommand}"
                IsExpanded="{Binding IsDrawerOpen}"
                IsRemoteMode="{Binding IsRemoteMode}"
                LogoutCommand="{Binding LogoutCommand}"
                NavigateToHomeCommand="{Binding NavigateToHomeCommand}"
                NavigationItemsSource="{Binding NavigationItems}"
                ToggleCommand="{Binding ToggleDrawerCommand}" />

            <!--  右侧工作区  -->
            <Grid
                Grid.Row="0"
                Grid.Column="1"
                Background="{DynamicResource SecondaryRegionBrush}">
                <Grid.RowDefinitions>
                    <!-- 导航架构改进方案 v1.0 — 面包屑导航栏 -->
                    <RowDefinition Height="Auto" />
                    <!-- 内容区域 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 面包屑导航栏 -->
                <controls:BreadcrumbControl
                    Grid.Row="0"
                    Breadcrumbs="{Binding Breadcrumbs}"
                    NavigateBackCommand="{Binding NavigateBackCommand}"
                    NavigateForwardCommand="{Binding NavigateForwardCommand}"
                    NavigateToBreadcrumbCommand="{Binding NavigateToBreadcrumbCommand}" />

                <Border
                    Grid.Row="1"
                    Margin="12"
                    Background="White"
                    CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Direction="270"
                            Opacity="0.15"
                            ShadowDepth="2"
                            Color="Gray" />
                    </Border.Effect>
                    <Grid Margin="16">
                        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
                    </Grid>
                </Border>
            </Grid>

            <!--  状态栏  -->
            <DockPanel
                Grid.Row="1"
                Grid.ColumnSpan="2"
                LastChildFill="True">

                <!--  连接模式徽章 (远程模式=绿色 / 本地模式=橙色)  -->
                <Border
                    DockPanel.Dock="Right"
                    Margin="8,4,8,4"
                    Padding="10,2"
                    VerticalAlignment="Stretch"
                    CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource LightWarningBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource LightSuccessBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Medium"
                        Text="{Binding ConnectionModeDisplay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <controls:GlobalStatusBar
                    ConnectionUrl="{Binding ConnectionUrl}"
                    IsLocal="{Binding IsLocal}"
                    ConnectCommand="{Binding ConnectCommand}"
                    CurrentUserName="{Binding CurrentUserDisplayName}"
                    StatusMessage="{Binding ApiStatus}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
