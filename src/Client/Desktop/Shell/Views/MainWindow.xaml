<Window
    x:Class="LYBT.Desktop.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:prism="http://prismlibrary.com/"


    Title="{Binding Title}"
    MinWidth="1024"
    MinHeight="768"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None">
    <Window.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding QuickAddPatientCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="C"
            Command="{Binding QuickStartMedicalCaseCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding
            Key="OemComma"
            Command="{Binding ShowSettingsCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="M"
            Command="{Binding ToggleSidebarCommand}"
            Modifiers="Ctrl" />
        <!-- 导航架构改进方案 v1.0 — 后退/前进快捷键 -->
        <KeyBinding
            Key="Left"
            Command="{Binding NavigateBackCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="Right"
            Command="{Binding NavigateForwardCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="Home"
            Command="{Binding NavigateToHomeCommand}"
            Modifiers="Alt" />
        <!-- Phase 2-3: 显示导航历史面板 -->
        <KeyBinding
            Key="H"
            Command="{Binding ShowHistoryCommand}"
            Modifiers="Ctrl+Shift" />
        <!-- Phase 2-3: 循环切换区域焦点 -->
        <KeyBinding Key="F6" Command="{Binding CycleRegionsCommand}" />
    </Window.InputBindings>

    <Grid>
        <!--  登录界面  -->
        <Grid Visibility="{Binding IsNotLoggedIn, Converter={x:Static converters:Cvt.BoolToVis}}">
            <ContentControl prism:RegionManager.RegionName="LoginRegion" />
        </Grid>

        <!--  登录后主界面：侧边栏 + 工作区  -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!--  侧边栏：宽度由SidebarControl内部控制  -->
                <ColumnDefinition Width="Auto" />
                <!--  工作区：占用剩余空间  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧边栏 (贯穿全高)  -->
            <controls:SidebarControl
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                ApiStatus="{Binding ApiStatus}"
                ConnectionDisplay="{Binding ConnectionModeDisplay}"
                CurrentTime="{Binding CurrentTime}"
                CurrentUser="{Binding CurrentUser}"
                EditProfileCommand="{Binding EditProfileCommand}"
                GroupedNavItems="{Binding GroupedNavItems}"
                SelectedNavItem="{Binding SelectedNavItem, Mode=TwoWay}"
                IsExpanded="{Binding IsSidebarExpanded}"
                IsRemoteMode="{Binding IsRemoteMode}"
                LogoutCommand="{Binding LogoutCommand}"
                NavigateToHomeCommand="{Binding NavigateToHomeCommand}"
                ToggleCommand="{Binding ToggleSidebarCommand}" />

            <!--  右侧工作区  -->
            <Grid
                Grid.Row="0"
                Grid.Column="1"
                Background="{DynamicResource SecondaryRegionBrush}">
                <Grid.RowDefinitions>
                    <!-- 导航架构改进方案 v1.0 — 面包屑导航栏 -->
                    <RowDefinition Height="Auto" />
                    <!-- 内容区域 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 面包屑导航栏 -->
                <controls:BreadcrumbControl
                    Grid.Row="0"
                    Breadcrumbs="{Binding Breadcrumbs}"
                    NavigateBackCommand="{Binding NavigateBackCommand}"
                    NavigateForwardCommand="{Binding NavigateForwardCommand}"
                    NavigateToBreadcrumbCommand="{Binding NavigateToBreadcrumbCommand}" />

                <Border
                    Grid.Row="1"
                    Margin="12"
                    Background="White"
                    CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Direction="270"
                            Opacity="0.15"
                            ShadowDepth="2"
                            Color="Gray" />
                    </Border.Effect>
                    <Grid Margin="16">
                        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
                    </Grid>
                </Border>
            </Grid>

            <!--  状态栏 (仅右侧，不横跨侧边栏)  -->
            <DockPanel
                Grid.Row="1"
                Grid.Column="1"
                LastChildFill="True">

                <controls:GlobalStatusBar StatusMessage="{Binding ApiStatus}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
