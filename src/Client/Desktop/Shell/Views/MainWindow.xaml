<Window x:Class="LYBT.Desktop.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <local:ApiHealthStatusToColorConverter x:Key="ApiHealthStatusToColorConverter" xmlns:local="clr-namespace:LYBT.Desktop.Shell.Converters" />
        <local:ApiHealthStatusToTextConverter x:Key="ApiHealthStatusToTextConverter" xmlns:local="clr-namespace:LYBT.Desktop.Shell.Converters" />
        <local:FirstCharConverter x:Key="FirstCharConverter" xmlns:local="clr-namespace:LYBT.Desktop.Shell.Converters" />
        <infra:EnumDescriptionConverter x:Key="EnumDescriptionConverter" xmlns:infra="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure" />

        <!-- poc-drawer-layout: Drawer打开动画 -->
        <Storyboard x:Key="OpenDrawerStoryboard">
            <DoubleAnimation Storyboard.TargetName="DrawerPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DrawerOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.25" />
        </Storyboard>

        <!-- poc-drawer-layout: Drawer关闭动画 -->
        <Storyboard x:Key="CloseDrawerStoryboard">
            <DoubleAnimation Storyboard.TargetName="DrawerPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="-260" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DrawerOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2" />
        </Storyboard>

        <!-- poc-drawer-layout: Drawer菜单项样式 -->
        <Style x:Key="DrawerMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- poc-drawer-layout: 全局键盘快捷键 -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding QuickAddPatientCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding QuickStartConsultationCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
        <!-- poc-drawer-layout: Drawer快捷键 -->
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ToggleDrawerCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- 登录界面 -->
        <Grid Visibility="{Binding IsNotLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl prism:RegionManager.RegionName="LoginRegion" />
        </Grid>

        <!-- poc-drawer-layout: 登录后主界面（无Header，全屏工作区） -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- 主内容区域（100%空间） -->
            <Grid Background="{StaticResource SurfaceBrush}">
                <Border Background="White" Margin="12" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5" />
                    </Border.Effect>
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl Grid.Row="1" prism:RegionManager.RegionName="ContentRegion" />
                    </Grid>
                </Border>

                <!-- poc-drawer-layout: 汉堡按钮（左上角浮动） -->
                <Button x:Name="HamburgerButton"
                        Width="48" Height="48"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="20,20,0,0"
                        Command="{Binding ToggleDrawerCommand}"
                        Cursor="Hand"
                        ToolTip="菜单 (Ctrl+M)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.3" BlurRadius="6" />
                                            </Border.Effect>
                                            <!-- 汉堡图标(三条横线) -->
                                            <Path Fill="White" Stretch="Uniform" Width="22" Height="18"
                                                  Data="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#357ABD" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- poc-drawer-layout: 遮罩层（始终存在，通过Opacity和IsHitTestVisible控制） -->
            <Border x:Name="DrawerOverlay"
                    Background="#80000000"
                    Opacity="0"
                    IsHitTestVisible="{Binding IsDrawerOpen}">
                <Border.InputBindings>
                    <MouseBinding Command="{Binding CloseDrawerCommand}" Gesture="LeftClick" />
                </Border.InputBindings>
            </Border>

            <!-- poc-drawer-layout: Drawer面板（始终存在，通过TranslateTransform控制位置） -->
            <Border x:Name="DrawerPanel"
                    Width="260"
                    HorizontalAlignment="Left"
                    Background="White">
                <Border.RenderTransform>
                    <TranslateTransform X="-260" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" Opacity="0.3" BlurRadius="20" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Logo/系统名称 -->
                        <RowDefinition Height="Auto" />  <!-- 状态信息 -->
                        <RowDefinition Height="Auto" />  <!-- 用户信息 -->
                        <RowDefinition Height="Auto" />  <!-- 分隔线 -->
                        <RowDefinition Height="*" />     <!-- 菜单项 -->
                        <RowDefinition Height="Auto" />  <!-- 退出登录 -->
                    </Grid.RowDefinitions>

                    <!-- Logo和系统名称 -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,24">
                        <StackPanel>
                            <TextBlock Text="凌隐宝堂" FontSize="22" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="中医诊所诊疗系统" FontSize="13" Foreground="White" Opacity="0.85" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 状态信息（时间+API状态） -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="20,12">
                        <StackPanel>
                            <!-- 时间显示 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                      Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z" />
                                <TextBlock Text="{Binding CurrentTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- API状态 -->
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding ApiStatus, Converter={StaticResource ApiHealthStatusToColorConverter}}"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ApiStatus, Converter={StaticResource ApiHealthStatusToTextConverter}}"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <!-- 重试按钮 -->
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ApiStatus}" Value="Unhealthy">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Hyperlink Command="{Binding RetryHealthCheckCommand}" Foreground="{StaticResource PrimaryBrush}">
                                        <Run Text="重试" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 用户信息区域 -->
                    <Border Grid.Row="2" Padding="20,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <!-- 用户头像 -->
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimaryBrush}">
                                    <TextBlock Text="{Binding CurrentUser.RealName, Converter={StaticResource FirstCharConverter}}"
                                               FontSize="20" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding CurrentUser.RealName}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CurrentUser.Role, Converter={StaticResource EnumDescriptionConverter}}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 分隔线 -->
                    <Border Grid.Row="3" Height="1" Background="{StaticResource BorderBrush}" Margin="20,0" />

                    <!-- 菜单项 -->
                    <StackPanel Grid.Row="4" Margin="0,8">
                        <Button Style="{StaticResource DrawerMenuItemStyle}" Command="{Binding EditProfileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource TextSecondaryBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"
                                      Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                <TextBlock Text="修改个人信息" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DrawerMenuItemStyle}" Command="{Binding ChangePasswordCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource TextSecondaryBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"
                                      Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                                <TextBlock Text="修改密码" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 退出登录（底部固定） -->
                    <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                        <Button Style="{StaticResource DrawerMenuItemStyle}" Command="{Binding LogoutCommand}" Foreground="#E53935">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#E53935" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"
                                      Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" />
                                <TextBlock Text="退出登录" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <!-- poc-drawer-layout: Drawer状态触发器 -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DrawerOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
