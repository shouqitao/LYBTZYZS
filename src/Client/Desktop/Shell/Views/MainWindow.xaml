<Window
    x:Class="LYBT.Desktop.Shell.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:nav="clr-namespace:LYBT.Desktop.Infrastructure.Navigation.Controls;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"


    Title="{Binding Title}"
    MinWidth="1024"
    MinHeight="768"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None">

    <!--  OpenSpec: refactor-role-navigation - 样式已移至SidebarControl  -->

    <Window.InputBindings>
        <KeyBinding
            Key="N"
            Command="{Binding QuickAddPatientCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="C"
            Command="{Binding QuickStartMedicalCaseCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding
            Key="OemComma"
            Command="{Binding ShowSettingsCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="M"
            Command="{Binding ToggleDrawerCommand}"
            Modifiers="Ctrl" />
        <!-- 导航架构改进方案 v1.0 — 后退/前进快捷键 -->
        <KeyBinding
            Key="Left"
            Command="{Binding NavigateBackCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="Right"
            Command="{Binding NavigateForwardCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="Home"
            Command="{Binding NavigateToHomeCommand}"
            Modifiers="Alt" />
        <!-- Phase 2-3: 显示导航历史面板 -->
        <KeyBinding
            Key="H"
            Command="{Binding ShowHistoryCommand}"
            Modifiers="Ctrl+Shift" />
        <!-- Phase 2-3: 循环切换区域焦点 -->
        <KeyBinding Key="F6" Command="{Binding CycleRegionsCommand}" />
    </Window.InputBindings>

    <Grid>
        <!--  SYNC-D03: 模式切换遮罩层  -->
        <Grid Panel.ZIndex="100" Visibility="{Binding IsSwitchingMode, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Border Background="{StaticResource DarkMaskBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="正在切换模式..." />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="{StaticResource LYBTTextDisabledBrush}"
                        Text="请稍候，系统正在重置连接" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  登录界面  -->
        <Grid Visibility="{Binding IsNotLoggedIn, Converter={x:Static converters:Cvt.BoolToVis}}">
            <ContentControl prism:RegionManager.RegionName="LoginRegion" />
        </Grid>

        <!--  登录后主界面：侧边栏 + 工作区  -->
        <!--  OpenSpec: refactor-role-navigation - 侧边栏已提取为SidebarControl  -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!--  侧边栏：宽度由SidebarControl内部控制  -->
                <ColumnDefinition Width="Auto" />
                <!--  工作区：占用剩余空间  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧边栏  -->
            <controls:SidebarControl
                Grid.Row="0"
                Grid.Column="0"
                ApiStatus="{Binding ApiStatus}"
                ConnectionModeText="{Binding ConnectionModeText}"
                CurrentTime="{Binding CurrentTime}"
                CurrentUser="{Binding CurrentUser}"
                EditProfileCommand="{Binding EditProfileCommand}"
                IsExpanded="{Binding IsDrawerOpen}"
                IsLocalMode="{Binding IsLocalMode}"
                IsSwitchingMode="{Binding IsSwitchingMode}"
                LogoutCommand="{Binding LogoutCommand}"
                NavigateToHomeCommand="{Binding NavigateToHomeCommand}"
                SwitchModeCommand="{Binding SwitchModeCommand}"
                ToggleCommand="{Binding ToggleDrawerCommand}" />

            <!--  右侧工作区  -->
            <Grid
                Grid.Row="0"
                Grid.Column="1"
                Background="{DynamicResource SecondaryRegionBrush}">
                <Grid.RowDefinitions>
                    <!-- 导航架构改进方案 v1.0 — 面包屑导航栏 -->
                    <RowDefinition Height="Auto" />
                    <!-- 内容区域 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 面包屑导航栏 -->
                <controls:BreadcrumbControl
                    Grid.Row="0"
                    Breadcrumbs="{Binding Breadcrumbs}"
                    NavigateBackCommand="{Binding NavigateBackCommand}"
                    NavigateForwardCommand="{Binding NavigateForwardCommand}"
                    NavigateToBreadcrumbCommand="{Binding NavigateToBreadcrumbCommand}" />

                <Border
                    Grid.Row="1"
                    Margin="12"
                    Background="White"
                    CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Direction="270"
                            Opacity="0.15"
                            ShadowDepth="2"
                            Color="Gray" />
                    </Border.Effect>
                    <Grid Margin="16">
                        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
                    </Grid>
                </Border>
            </Grid>

            <!--  状态栏  -->
            <controls:GlobalStatusBar
                Grid.Row="1"
                Grid.ColumnSpan="2"
                CurrentUserName="{Binding CurrentUserDisplayName}"
                IsLoading="{Binding IsSyncing}"
                LoadingMessage="正在同步..."
                StatusMessage="{Binding SyncStatusMessage}" />
        </Grid>

        <!-- Phase 3: NavigationHistoryPanel Overlay -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="White"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,12,12,0"
            Width="300"
            MaxHeight="400"
            Panel.ZIndex="100"
            Visibility="{Binding ShowNavigationHistory, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="12"
                    ShadowDepth="0"
                    Opacity="0.25"
                    Color="Black"/>
            </Border.Effect>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="导航历史"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Command="{Binding ToggleNavigationHistoryCommand}"
                            Padding="8"/>
                </Grid>

                <!-- Panel Content -->
                <nav:NavigationHistoryPanel
                    Grid.Row="1"
                    DataContext="{Binding NavigationHistoryPanelViewModel}"/>
            </Grid>
        </Border>

        <!-- Phase 3: NavigationSuggestionsPanel Overlay -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="White"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,0,12,12"
            Width="320"
            MaxHeight="300"
            Panel.ZIndex="100"
            Visibility="{Binding ShowNavigationSuggestions, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="12"
                    ShadowDepth="0"
                    Opacity="0.25"
                    Color="Black"/>
            </Border.Effect>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="智能建议"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Grid.Column="1"
                            Content="✕"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Command="{Binding ToggleNavigationSuggestionsCommand}"
                            Padding="8"/>
                </Grid>

                <!-- Panel Content -->
                <nav:NavigationSuggestionsPanel
                    Grid.Row="1"
                    DataContext="{Binding NavigationSuggestionsPanelViewModel}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
