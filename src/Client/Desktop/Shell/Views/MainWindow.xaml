<Window x:Class="LYBT.Desktop.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White">

    <!-- OpenSpec: refactor-role-navigation - 样式已移至SidebarControl -->

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding QuickAddPatientCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding QuickStartMedicalCaseCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ToggleDrawerCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- 登录界面 -->
        <Grid Visibility="{Binding IsNotLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl prism:RegionManager.RegionName="LoginRegion" />
        </Grid>

        <!-- 登录后主界面：侧边栏 + 工作区 -->
        <!-- OpenSpec: refactor-role-navigation - 侧边栏已提取为SidebarControl -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <!-- 侧边栏：宽度由SidebarControl内部控制 -->
                <ColumnDefinition Width="Auto" />
                <!-- 工作区：占用剩余空间 -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧边栏 -->
            <controls:SidebarControl Grid.Column="0"
                IsExpanded="{Binding IsDrawerOpen}"
                CurrentUser="{Binding CurrentUser}"
                ApiStatus="{Binding ApiStatus}"
                CurrentTime="{Binding CurrentTime}"
                ToggleCommand="{Binding ToggleDrawerCommand}"
                NavigateToHomeCommand="{Binding NavigateToHomeCommand}"
                EditProfileCommand="{Binding EditProfileCommand}"
                LogoutCommand="{Binding LogoutCommand}" />

            <!-- 右侧工作区 -->
            <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <Border Background="White" Margin="12" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.15" BlurRadius="8" />
                    </Border.Effect>
                    <Grid Margin="16">
                        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
