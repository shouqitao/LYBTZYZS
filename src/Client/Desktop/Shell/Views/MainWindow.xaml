<Window x:Class="LYBT.Desktop.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:LYBT.Desktop.Shell.Converters"
        xmlns:infra="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <local:ApiHealthStatusToColorConverter x:Key="ApiHealthStatusToColorConverter" />
        <local:ApiHealthStatusToTextConverter x:Key="ApiHealthStatusToTextConverter" />
        <local:FirstCharConverter x:Key="FirstCharConverter" />
        <local:BoolToSidebarWidthConverter x:Key="BoolToSidebarWidthConverter" />
        <infra:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />

        <!-- 侧边栏菜单项样式 -->
        <Style x:Key="SidebarMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding QuickAddPatientCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding QuickStartConsultationCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ToggleDrawerCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- 登录界面 -->
        <Grid Visibility="{Binding IsNotLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl prism:RegionManager.RegionName="LoginRegion" />
        </Grid>

        <!-- 登录后主界面：侧边栏 + 工作区 -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <!-- 侧边栏：宽度根据展开状态变化 -->
                <ColumnDefinition Width="{Binding IsDrawerOpen, Converter={StaticResource BoolToSidebarWidthConverter}}" />
                <!-- 工作区：占用剩余空间 -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧边栏 -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Row 0: 展开/收缩按钮 -->
                        <RowDefinition Height="Auto" />  <!-- Row 1: 用户信息 -->
                        <RowDefinition Height="Auto" />  <!-- Row 2: 分隔线 -->
                        <RowDefinition Height="*" />     <!-- Row 3: 菜单区域 -->
                        <RowDefinition Height="Auto" />  <!-- Row 4: 状态信息(网络+时间) -->
                        <RowDefinition Height="Auto" />  <!-- Row 5: 分隔线 -->
                        <RowDefinition Height="Auto" />  <!-- Row 6: 退出登录 -->
                    </Grid.RowDefinitions>

                    <!-- 展开/收缩按钮 + Logo -->
                    <Button Grid.Row="0" Style="{StaticResource SidebarMenuItemStyle}"
                            Command="{Binding ToggleDrawerCommand}" Height="56" ToolTip="展开/收缩 (Ctrl+M)">
                        <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                            <StackPanel Orientation="Horizontal">
                                <!-- 汉堡图标 -->
                                <Path Fill="{StaticResource SidebarTextBrush}" Width="24" Height="24" Stretch="Uniform"
                                      Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                                <!-- 系统名称（展开时显示） -->
                                <TextBlock Text="凌隐宝堂" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding IsDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 用户信息 -->
                    <Border Grid.Row="1" Padding="12,12">
                        <StackPanel Orientation="Horizontal">
                            <!-- 用户头像 -->
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SidebarAvatarBrush}">
                                <TextBlock Text="{Binding CurrentUser.RealName, Converter={StaticResource FirstCharConverter}}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- 用户名和角色（展开时显示） -->
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0"
                                        Visibility="{Binding IsDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentUser.RealName}" FontSize="13" Foreground="{StaticResource SidebarTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentUser.Role, Converter={StaticResource EnumDescriptionConverter}}"
                                           FontSize="11" Foreground="{StaticResource SidebarTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 分隔线 -->
                    <Border Grid.Row="2" Height="1" Background="{StaticResource SidebarDividerBrush}" Margin="12,0" />

                    <!-- 菜单项 -->
                    <StackPanel Grid.Row="3" Margin="0,8">
                        <!-- 修改个人信息 -->
                        <Button Style="{StaticResource SidebarMenuItemStyle}" Command="{Binding EditProfileCommand}" ToolTip="修改个人信息">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource SidebarTextBrush}" Width="20" Height="20" Stretch="Uniform"
                                      Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                <TextBlock Text="修改个人信息" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding IsDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                        <!-- 修改密码 -->
                        <Button Style="{StaticResource SidebarMenuItemStyle}" Command="{Binding ChangePasswordCommand}" ToolTip="修改密码">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource SidebarTextBrush}" Width="20" Height="20" Stretch="Uniform"
                                      Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                                <TextBlock Text="修改密码" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding IsDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 状态信息: 网络(上) + 时间(下) -->
                    <Border Grid.Row="4" Padding="8,6">
                        <Grid>
                            <!-- 收缩状态: 垂直居中 -->
                            <StackPanel Visibility="{Binding IsDrawerOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center">
                                <!-- 网络状态(上) -->
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource SidebarBackgroundBrush}" Margin="0,0,0,6"
                                        HorizontalAlignment="Center" ToolTip="{Binding ApiStatus, Converter={StaticResource ApiHealthStatusToTextConverter}}">
                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{Binding ApiStatus, Converter={StaticResource ApiHealthStatusToColorConverter}}" />
                                </Border>
                                <!-- 时间(下): 时间+日期 -->
                                <StackPanel HorizontalAlignment="Center" ToolTip="当前时间">
                                    <TextBlock Text="{Binding CurrentTime, StringFormat=HH:mm}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SidebarTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentTime, StringFormat=MM/dd}" FontSize="9"
                                               Foreground="{StaticResource SidebarTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 展开状态: 水平布局 -->
                            <StackPanel Visibility="{Binding IsDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="4,0,0,0">
                                <!-- 网络状态(上) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{Binding ApiStatus, Converter={StaticResource ApiHealthStatusToColorConverter}}" />
                                    <TextBlock Text="{Binding ApiStatus, Converter={StaticResource ApiHealthStatusToTextConverter}}"
                                               FontSize="11" Foreground="{StaticResource SidebarTextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <!-- 时间(下): 时间+日期 -->
                                <StackPanel Orientation="Horizontal">
                                    <Path Fill="{StaticResource SidebarTextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z" />
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding CurrentTime, StringFormat=HH:mm}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SidebarTextBrush}" />
                                        <TextBlock Text="{Binding CurrentTime, StringFormat=yyyy-MM-dd}" FontSize="10"
                                                   Foreground="{StaticResource SidebarTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 分割线 -->
                    <Border Grid.Row="5" Height="1" Background="{StaticResource SidebarDividerBrush}" Margin="12,0" />

                    <!-- 退出登录（底部） -->
                    <Border Grid.Row="6">
                        <Button Style="{StaticResource SidebarMenuItemStyle}" Command="{Binding LogoutCommand}" ToolTip="退出登录">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource ErrorBrush}" Width="20" Height="20" Stretch="Uniform"
                                      Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" />
                                <TextBlock Text="退出登录" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding IsDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧工作区 -->
            <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <Border Background="White" Margin="12" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.15" BlurRadius="8" />
                    </Border.Effect>
                    <Grid Margin="16">
                        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
