<UserControl x:Class="LYBT.Desktop.Shell.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="LightBlue">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="测试视图显示成功！" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      Foreground="DarkBlue"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="如果你看到这个页面，说明导航系统工作正常" 
                      FontSize="16" 
                      Foreground="DarkBlue"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,0"/>
            <TextBlock Text="问题在于HomeView的依赖注入或数据绑定" 
                      FontSize="14" 
                      Foreground="Red"
                      HorizontalAlignment="Center"
                      Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>