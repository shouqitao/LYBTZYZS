<Window x:Class="LYBT.Desktop.Shell.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凌隐宝堂中医诊所诊疗系统"
        Height="400" Width="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="White"
            BorderBrush="#0078D4"
            BorderThickness="2"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Logo 和标题区域 -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <!-- Logo 图标 -->
                <Viewbox Width="120" Height="120" Margin="0,0,0,20">
                    <Canvas Width="100" Height="100">
                        <!-- 简单的医疗图标 -->
                        <Ellipse Width="100" Height="100"
                                 Fill="#0078D4"
                                 Opacity="0.1"/>
                        <!-- 十字图标 -->
                        <Rectangle Width="60" Height="10"
                                   Canvas.Left="20" Canvas.Top="45"
                                   Fill="#0078D4"/>
                        <Rectangle Width="10" Height="60"
                                   Canvas.Left="45" Canvas.Top="20"
                                   Fill="#0078D4"/>
                    </Canvas>
                </Viewbox>

                <!-- 系统标题 -->
                <TextBlock Text="凌隐宝堂中医诊所诊疗系统"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0078D4"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Ling Yin Bao Tang TCM Clinic System"
                           FontSize="14"
                           Foreground="#666666"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 加载状态文本 -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Text="正在初始化..."
                       FontSize="14"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,10"/>

            <!-- 进度条 -->
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="2"
                         Height="6"
                         Margin="40,0,40,0"
                         IsIndeterminate="True"
                         Foreground="#0078D4"/>

            <!-- 版本信息和版权 -->
            <StackPanel Grid.Row="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="版本 1.0.0"
                           FontSize="12"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <TextBlock Text="© 2025 凌隐宝堂. All rights reserved."
                           FontSize="11"
                           Foreground="#CCCCCC"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
