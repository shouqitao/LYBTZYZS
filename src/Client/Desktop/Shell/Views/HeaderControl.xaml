<UserControl x:Class="LYBT.Desktop.Shell.Views.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Height="48">
    <!-- 顶部应用栏：h48 fill=$primary padding[0,24] gap12 align center -->
    <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="24,0" Height="48">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1: 品牌标识 36x36 fill=$accent r10 -->
            <Border Grid.Column="0" Width="36" Height="36" Background="#FFB300" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="医" FontFamily="Noto Sans SC" FontSize="20" FontWeight="Bold" Foreground="#4E342E"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Border>

            <!-- 2: 诊所名 17/600 白 -->
            <TextBlock Grid.Column="1" Text="凌隐宝堂中医诊所" FontFamily="Noto Sans SC" FontSize="17" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"/>

            <!-- 3: 弹性占位 -->
            <Border Grid.Column="2"/>

            <!-- 右侧用户区（4 分隔线 + 5 icon + 6 姓名 + 7 角色）可点击打开个人资料 -->
            <Button Grid.Column="3" Command="{Binding EditProfileCommand}" ToolTip="个人资料 (Ctrl+,)"
                    Background="Transparent" BorderThickness="0" Padding="6,4" VerticalAlignment="Center" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 4: 分隔线 1x20 白 30% -->
                    <Border Width="1" Height="20" Background="White" Opacity="0.3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- 5: icon account_circle 26x26 #F0E4DE -->
                    <materialDesign:PackIcon Kind="AccountCircle" Width="26" Height="26" Foreground="#F0E4DE" VerticalAlignment="Center"/>
                    <!-- 6: 姓名 13/600 白 -->
                    <TextBlock Text="{Binding CurrentUserDisplayName, FallbackValue=陈医生}" FontFamily="Noto Sans SC" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <!-- 7: 角色 12 #D9C7C1 -->
                    <TextBlock Text="{Binding CurrentUserRoleDisplay, FallbackValue=医生}" FontFamily="Noto Sans SC" FontSize="12"
                               Foreground="#D9C7C1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
