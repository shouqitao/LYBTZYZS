<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="LYBTMasterListWidth">320</sys:Double>
    <sys:Double x:Key="LYBTDetailMinWidth">400</sys:Double>

    <Style x:Key="LYBTPageContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LYBTBackgroundBrush}" />
        <Setter Property="Padding" Value="{StaticResource LYBTPaddingLarge}" />
        <Setter Property="Margin" Value="{StaticResource LYBTMarginLarge}" />
        <Setter Property="BorderBrush" Value="{StaticResource LYBTBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource LYBTCornerRadiusLg}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="LYBTCardContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LYBTSurfaceBrush}" />
        <Setter Property="Padding" Value="{StaticResource LYBTPaddingMedium}" />
        <Setter Property="Margin" Value="{StaticResource LYBTMarginMedium}" />
        <Setter Property="BorderBrush" Value="{StaticResource LYBTBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource LYBTCornerRadiusMd}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
