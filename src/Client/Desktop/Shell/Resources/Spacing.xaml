    <Thickness x:Key="LYBTMarginLarge">16</Thickness>

    <Thickness x:Key="LYBTPaddingSmall">4</Thickness>
    <Thickness x:Key="LYBTPaddingMedium">8</Thickness>
    <Thickness x:Key="LYBTPaddingLarge">16</Thickness>

</ResourceDictionary>
