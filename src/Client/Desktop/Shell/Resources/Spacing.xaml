                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="LYBTSpacingXs">4</sys:Double>
    <sys:Double x:Key="LYBTSpacingSm">8</sys:Double>
    <sys:Double x:Key="LYBTSpacingMd">16</sys:Double>
    <sys:Double x:Key="LYBTSpacingLg">24</sys:Double>
    <sys:Double x:Key="LYBTSpacingXl">32</sys:Double>

    <CornerRadius x:Key="LYBTCornerRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="LYBTCornerRadiusMd">8</CornerRadius>
