<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- UltraThink 统一设计系统 -->
    <!-- 基础颜色 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4CAF50"/>
    
    <!-- 背景和表面颜色 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#EEEEEE"/>
    
    <!-- 覆盖层和边框 -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="AlternateBorderBrush" Color="#E0E0E0"/>
    
    <!-- 文本颜色 -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
    
    <!-- 基础样式 -->
    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    
</ResourceDictionary>