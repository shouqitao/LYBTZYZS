<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        LYBTZYZS 设计Token系统 - 颜色定义 (浅色主题)
        OpenSpec: desktop-ui-ux-optimization
        
        单一数据源，所有组件引用这些Token
        命名规范: Brand/Semantic/Surface/Border/Text + 用途
    -->

    <!-- ==================== 品牌色 (Brand) ==================== -->
    <Color x:Key="BrandPrimary">#0078D4</Color>
    <Color x:Key="BrandPrimaryHover">#106EBE</Color>
    <Color x:Key="BrandPrimaryPressed">#005A9E</Color>
    <Color x:Key="BrandPrimaryLight">#E5F3FF</Color>
    <Color x:Key="BrandAccent">#2E8B57</Color>
    <Color x:Key="BrandAccentHover">#228B22</Color>
    <Color x:Key="BrandAccentLight">#E8F5E9</Color>

    <!-- ==================== 语义色 (Semantic) ==================== -->
    <Color x:Key="SemanticSuccess">#107C10</Color>
    <Color x:Key="SemanticSuccessHover">#0B5C0B</Color>
    <Color x:Key="SemanticSuccessLight">#DFF6DD</Color>
    <Color x:Key="SemanticWarning">#F7630C</Color>
    <Color x:Key="SemanticWarningHover">#D95A0A</Color>
    <Color x:Key="SemanticWarningLight">#FFF4CE</Color>
    <Color x:Key="SemanticError">#D13438</Color>
    <Color x:Key="SemanticErrorHover">#A4262C</Color>
    <Color x:Key="SemanticErrorLight">#FDE7E9</Color>
    <Color x:Key="SemanticInfo">#00B7C3</Color>
    <Color x:Key="SemanticInfoHover">#008B94</Color>
    <Color x:Key="SemanticInfoLight">#E0F7FA</Color>

    <!-- ==================== 表面色 (Surface) ==================== -->
    <Color x:Key="SurfaceBackground">#F5F5F5</Color>
    <Color x:Key="SurfaceCard">#FFFFFF</Color>
    <Color x:Key="SurfaceCardHover">#FAFAFA</Color>
    <Color x:Key="SurfaceOverlay">#40000000</Color>

    <!-- ==================== 边框色 (Border) ==================== -->
    <Color x:Key="BorderDefault">#E0E0E0</Color>
    <Color x:Key="BorderStrong">#C8C6C4</Color>
    <Color x:Key="BorderFocus">#0078D4</Color>
    <Color x:Key="BorderDivider">#EEEEEE</Color>

    <!-- ==================== 文本色 (Text) ==================== -->
    <Color x:Key="TextPrimary">#201F1E</Color>
    <Color x:Key="TextSecondary">#605E5C</Color>
    <Color x:Key="TextTertiary">#8A8886</Color>
    <Color x:Key="TextDisabled">#C8C6C4</Color>
    <Color x:Key="TextOnBrand">#FFFFFF</Color>

    <!-- ==================== 交互状态色 (State) ==================== -->
    <Color x:Key="StateHover">#F3F2F1</Color>
    <Color x:Key="StatePressed">#EDEBE9</Color>
    <Color x:Key="StateSelected">#E5F3FF</Color>
    <Color x:Key="StateSelectedHover">#CCE4FF</Color>
    <Color x:Key="StateDisabled">#F3F2F1</Color>

    <!-- ==================== DataGrid专用色 ==================== -->
    <Color x:Key="DataGridAlternateRow">#F9F9F9</Color>
    <Color x:Key="DataGridHover">#F5F5F5</Color>
    <Color x:Key="DataGridSelected">#E5F3FF</Color>

    <!-- ==================== 侧边栏色 (Sidebar) ==================== -->
    <Color x:Key="SidebarBackground">#2B4162</Color>
    <Color x:Key="SidebarHover">#3D5A80</Color>
    <Color x:Key="SidebarText">#FFFFFF</Color>
    <Color x:Key="SidebarTextSecondary">#9DB5CC</Color>
    <Color x:Key="SidebarAvatar">#5A8FBF</Color>
    <Color x:Key="SidebarDivider">#3D5A80</Color>

    <!-- ==================== 状态指示色 (Status) ==================== -->
    <Color x:Key="StatusComplete">#107C10</Color>
    <Color x:Key="StatusPending">#8A8886</Color>
    <Color x:Key="StatusInProgress">#F7630C</Color>

    <!-- ==================== UI元素色 (UI Elements) ==================== -->
    <Color x:Key="UISecondary">#6495ED</Color>
    <Color x:Key="UISecondaryHover">#4169E1</Color>
    <Color x:Key="UINeutral">#8A8886</Color>
    <Color x:Key="UINeutralHover">#605E5C</Color>
    <Color x:Key="UINeutralLight">#C8C6C4</Color>

    <!-- ==================== SolidColorBrush 资源 ==================== -->
    
    <!-- 品牌色画刷 -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHover}" />
    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{StaticResource BrandPrimaryPressed}" />
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{StaticResource BrandPrimaryLight}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccent}" />
    <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="{StaticResource BrandAccentHover}" />
    <SolidColorBrush x:Key="BrandAccentLightBrush" Color="{StaticResource BrandAccentLight}" />

    <!-- 语义色画刷 -->
    <SolidColorBrush x:Key="SemanticSuccessBrush" Color="{StaticResource SemanticSuccess}" />
    <SolidColorBrush x:Key="SemanticSuccessHoverBrush" Color="{StaticResource SemanticSuccessHover}" />
    <SolidColorBrush x:Key="SemanticSuccessLightBrush" Color="{StaticResource SemanticSuccessLight}" />
    <SolidColorBrush x:Key="SemanticWarningBrush" Color="{StaticResource SemanticWarning}" />
    <SolidColorBrush x:Key="SemanticWarningHoverBrush" Color="{StaticResource SemanticWarningHover}" />
    <SolidColorBrush x:Key="SemanticWarningLightBrush" Color="{StaticResource SemanticWarningLight}" />
    <SolidColorBrush x:Key="SemanticErrorBrush" Color="{StaticResource SemanticError}" />
    <SolidColorBrush x:Key="SemanticErrorHoverBrush" Color="{StaticResource SemanticErrorHover}" />
    <SolidColorBrush x:Key="SemanticErrorLightBrush" Color="{StaticResource SemanticErrorLight}" />
    <SolidColorBrush x:Key="SemanticInfoBrush" Color="{StaticResource SemanticInfo}" />
    <SolidColorBrush x:Key="SemanticInfoHoverBrush" Color="{StaticResource SemanticInfoHover}" />
    <SolidColorBrush x:Key="SemanticInfoLightBrush" Color="{StaticResource SemanticInfoLight}" />

    <!-- 表面色画刷 -->
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackground}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHover}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlay}" />

    <!-- 边框色画刷 -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefault}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}" />
    <SolidColorBrush x:Key="BorderDividerBrush" Color="{StaticResource BorderDivider}" />

    <!-- 文本色画刷 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}" />
    <SolidColorBrush x:Key="TextOnBrandBrush" Color="{StaticResource TextOnBrand}" />

    <!-- 交互状态画刷 -->
    <SolidColorBrush x:Key="StateHoverBrush" Color="{StaticResource StateHover}" />
    <SolidColorBrush x:Key="StatePressedBrush" Color="{StaticResource StatePressed}" />
    <SolidColorBrush x:Key="StateSelectedBrush" Color="{StaticResource StateSelected}" />
    <SolidColorBrush x:Key="StateSelectedHoverBrush" Color="{StaticResource StateSelectedHover}" />
    <SolidColorBrush x:Key="StateDisabledBrush" Color="{StaticResource StateDisabled}" />

    <!-- DataGrid画刷 -->
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="{StaticResource DataGridAlternateRow}" />
    <SolidColorBrush x:Key="DataGridHoverBrush" Color="{StaticResource DataGridHover}" />
    <SolidColorBrush x:Key="DataGridSelectedBrush" Color="{StaticResource DataGridSelected}" />

    <!-- 侧边栏画刷 -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackground}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHover}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarText}" />
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="{StaticResource SidebarTextSecondary}" />
    <SolidColorBrush x:Key="SidebarAvatarBrush" Color="{StaticResource SidebarAvatar}" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="{StaticResource SidebarDivider}" />

    <!-- 状态指示画刷 -->
    <SolidColorBrush x:Key="StatusCompleteBrush" Color="{StaticResource StatusComplete}" />
    <SolidColorBrush x:Key="StatusPendingBrush" Color="{StaticResource StatusPending}" />
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="{StaticResource StatusInProgress}" />

    <!-- UI元素画刷 -->
    <SolidColorBrush x:Key="UISecondaryBrush" Color="{StaticResource UISecondary}" />
    <SolidColorBrush x:Key="UISecondaryHoverBrush" Color="{StaticResource UISecondaryHover}" />
    <SolidColorBrush x:Key="UINeutralBrush" Color="{StaticResource UINeutral}" />
    <SolidColorBrush x:Key="UINeutralHoverBrush" Color="{StaticResource UINeutralHover}" />
    <SolidColorBrush x:Key="UINeutralLightBrush" Color="{StaticResource UINeutralLight}" />

</ResourceDictionary>