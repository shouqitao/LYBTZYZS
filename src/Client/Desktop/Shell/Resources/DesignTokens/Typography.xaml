<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        LYBTZYZS 设计Token系统 - 字体规范
        OpenSpec: desktop-ui-ux-optimization
        
        支持中英文混排，优先Segoe UI Variable，回退Microsoft YaHei UI
    -->

    <!-- ==================== 字体族 (Font Family) ==================== -->
    <FontFamily x:Key="FontFamilyPrimary">Segoe UI Variable, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Code, Consolas, Microsoft YaHei</FontFamily>

    <!-- ==================== 字号系统 (Type Scale) ==================== -->
    <sys:Double x:Key="TypeCaption">11</sys:Double>
    <sys:Double x:Key="TypeCaptionLarge">12</sys:Double>
    <sys:Double x:Key="TypeBody">14</sys:Double>
    <sys:Double x:Key="TypeBodyLarge">16</sys:Double>
    <sys:Double x:Key="TypeSubtitle">18</sys:Double>
    <sys:Double x:Key="TypeTitle">20</sys:Double>
    <sys:Double x:Key="TypeTitleLarge">24</sys:Double>
    <sys:Double x:Key="TypeHeadline">28</sys:Double>
    <sys:Double x:Key="TypeDisplay">32</sys:Double>
    <sys:Double x:Key="TypeDisplayLarge">40</sys:Double>

    <!-- ==================== 字重 (Font Weight) ==================== -->
    <FontWeight x:Key="WeightRegular">Regular</FontWeight>
    <FontWeight x:Key="WeightMedium">Medium</FontWeight>
    <FontWeight x:Key="WeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="WeightBold">Bold</FontWeight>

    <!-- ==================== 行高 (Line Height) ==================== -->
    <sys:Double x:Key="LineHeightCaption">16</sys:Double>
    <sys:Double x:Key="LineHeightBody">20</sys:Double>
    <sys:Double x:Key="LineHeightSubtitle">24</sys:Double>
    <sys:Double x:Key="LineHeightTitle">28</sys:Double>
    <sys:Double x:Key="LineHeightHeadline">36</sys:Double>
    <sys:Double x:Key="LineHeightDisplay">40</sys:Double>

    <!-- ==================== 文本样式预设 (Text Styles) ==================== -->
    
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaption}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightRegular}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightRegular}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
    </Style>

    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightSemiBold}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
    </Style>

    <Style x:Key="BodyLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodyLarge}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightRegular}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSubtitle}" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeSubtitle}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightSemiBold}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightSubtitle}" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightSemiBold}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightTitle}" />
    </Style>

    <Style x:Key="TitleLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeTitleLarge}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightBold}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightHeadline}" />
    </Style>

    <Style x:Key="HeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeHeadline}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightBold}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightHeadline}" />
    </Style>

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TypeDisplay}" />
        <Setter Property="FontWeight" Value="{StaticResource WeightBold}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightDisplay}" />
    </Style>

</ResourceDictionary>