<UserControl x:Class="LYBT.Desktop.Shell.Dialogs.Views.ApiConnectionFailedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Width="500" Height="380">

    <!-- enhance-shell-connection-dialog: API连接失败恢复对话框 -->
    <!-- 显示连接错误信息并提供重试/退出/查看日志操作 -->
    <!-- 注意: Prism对话框必须使用UserControl，Prism会自动包装为Window -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: 图标+标题 -->
            <RowDefinition Height="Auto"/>   <!-- Row 1: 错误摘要 -->
            <RowDefinition Height="Auto"/>   <!-- Row 2: 可能原因 -->
            <RowDefinition Height="Auto"/>   <!-- Row 3: 展开详情 -->
            <RowDefinition Height="*"/>      <!-- Row 4: 弹性空间 -->
            <RowDefinition Height="Auto"/>   <!-- Row 5: 按钮区 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 图标+标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <!-- 警告图标 (使用Path绘制) -->
            <Path Width="32" Height="32" Stretch="Uniform" Fill="#F59E0B"
                  Data="M12 2L1 21h22L12 2zm0 3.83L19.13 19H4.87L12 5.83zM11 16h2v2h-2v-2zm0-6h2v4h-2v-4z"/>
            <TextBlock Text="无法连接到服务器"
                       FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="#1F2937"/>
        </StackPanel>

        <!-- Row 1: 错误摘要 -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorSummary}"
                   TextWrapping="Wrap" FontSize="14"
                   Foreground="#4B5563"
                   Margin="0,0,0,12"/>

        <!-- Row 2: 可能原因列表 -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding PossibleReasons}" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="8,4,0,4">
                        <Ellipse Width="6" Height="6" Fill="#9CA3AF"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding}" FontSize="13" Foreground="#6B7280"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Row 3: 展开详情 -->
        <Expander Grid.Row="3" Header="展开详情"
                  IsExpanded="{Binding IsDetailsExpanded}"
                  Margin="0,0,0,16">
            <Border Background="#F3F4F6" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                <TextBlock Text="{Binding TechnicalDetails}"
                          FontFamily="Consolas" FontSize="12"
                          Foreground="#374151"
                          TextWrapping="Wrap"/>
            </Border>
        </Expander>

        <!-- Row 5: 按钮区域 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <!-- 离线模式按钮 (v2.0预留，当前禁用) -->
            <Button Content="离线模式(v2.0)"
                    Command="{Binding OfflineModeCommand}"
                    IsEnabled="{Binding IsOfflineModeEnabled}"
                    ToolTip="{Binding OfflineModeTooltip}"
                    Width="110" Height="32"
                    Margin="0,0,8,0"
                    FontSize="13"/>

            <!-- 查看日志按钮 -->
            <Button Content="查看日志"
                    Command="{Binding ViewLogsCommand}"
                    Width="80" Height="32"
                    Margin="0,0,8,0"
                    FontSize="13"/>

            <!-- 重试按钮 (主操作) -->
            <Button Content="重试"
                    Command="{Binding RetryCommand}"
                    Width="80" Height="32"
                    Margin="0,0,8,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Background="#3B82F6"
                    Foreground="White"/>

            <!-- 退出按钮 -->
            <Button Content="退出"
                    Command="{Binding ExitCommand}"
                    Width="80" Height="32"
                    FontSize="13"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
