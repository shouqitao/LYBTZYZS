<!--
    ConfirmationDialog - Prism 确认对话框

    重要: Prism DialogService 要求 Dialog 视图必须是 UserControl，
    DialogService 会将其嵌入到 DialogWindow 容器中显示。
    使用 Window 会导致 "Window 不能作为其他 Visual 的子元素" 错误。
-->
<UserControl x:Class="LYBT.Desktop.Shell.Dialogs.Views.ConfirmationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinWidth="400" MinHeight="200"
             d:DesignWidth="450" d:DesignHeight="300">

    <!-- Epic #1676 Phase 2: 通用确认对话框，支持删除选项 -->
    <!-- 转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters) -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: 图标 -->
            <RowDefinition Height="*"/>      <!-- Row 1: 消息 -->
            <RowDefinition Height="Auto"/>   <!-- Row 2: 删除选项 -->
            <RowDefinition Height="Auto"/>   <!-- Row 3: 按钮 -->
        </Grid.RowDefinitions>

        <!-- 图标 -->
        <Image Grid.Row="0" Width="48" Height="48" Margin="0,0,0,15"
               Source="{Binding IconSource}"
               HorizontalAlignment="Center"
               Stretch="Uniform"/>

        <!-- 消息 -->
        <TextBlock Grid.Row="1" Text="{Binding Message}"
                   TextWrapping="Wrap" FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- 删除选项（软删除/物理删除） -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15"
                    Visibility="{Binding ShowDeleteOptions, Converter={x:Static converters:Cvt.BoolToVis}}">
            <RadioButton Content="软删除（标记为已删除，可恢复）"
                         IsChecked="{Binding IsSoftDelete}"
                         Margin="0,5"
                         FontSize="13"/>
            <RadioButton Content="物理删除（永久删除，不可恢复）"
                         IsChecked="{Binding IsHardDelete}"
                         Margin="0,5"
                         FontSize="13"
                          Foreground="{StaticResource ValidationErrorBrush}"/>
        </StackPanel>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button Content="{Binding ConfirmButtonText}"
                    Command="{Binding ConfirmCommand}"
                    Width="100" Height="32"
                    Margin="0,0,10,0"
                    FontSize="14"/>
            <Button Content="{Binding CancelButtonText}"
                    Command="{Binding CancelCommand}"
                    Width="100" Height="32"
                    FontSize="14"/>
        </StackPanel>
    </Grid>
</UserControl>
