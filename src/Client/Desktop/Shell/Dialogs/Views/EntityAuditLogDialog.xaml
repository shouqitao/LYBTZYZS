<Window x:Class="LYBT.Desktop.Shell.Dialogs.Views.EntityAuditLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        MinHeight="400" MinWidth="700">

    <!-- OpenSpec: add-global-audit-system - 通用实体审计日志对话框 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 操作类型颜色 -->
        <Style x:Key="OperationTypeStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OperationTypeDisplay}" Value="创建">
                    <Setter Property="Foreground" Value="#4CAF50"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OperationTypeDisplay}" Value="修改">
                    <Setter Property="Foreground" Value="#2196F3"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OperationTypeDisplay}" Value="删除">
                    <Setter Property="Foreground" Value="#F44336"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OperationTypeDisplay}" Value="状态变更">
                    <Setter Property="Foreground" Value="#FF9800"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OperationTypeDisplay}" Value="恢复">
                    <Setter Property="Foreground" Value="#9C27B0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: 标题 -->
            <RowDefinition Height="*"/>      <!-- Row 1: 日志列表 -->
            <RowDefinition Height="Auto"/>   <!-- Row 2: 分页控件 -->
            <RowDefinition Height="Auto"/>   <!-- Row 3: 按钮 -->
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{Binding EntityDescription}" FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
            <TextBlock Text="查看此记录的所有变更历史" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 日志列表 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding AuditLogs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectedItem="{Binding SelectedLog}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="36"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0">
            <DataGrid.Columns>
                <!-- 操作时间 -->
                <DataGridTextColumn Header="操作时间" Binding="{Binding CreatedAtDisplay}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 操作类型 -->
                <DataGridTemplateColumn Header="操作类型" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OperationTypeDisplay}"
                                       Style="{StaticResource OperationTypeStyle}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 操作者 -->
                <DataGridTextColumn Header="操作者" Binding="{Binding OperatorName}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 角色 -->
                <DataGridTextColumn Header="角色" Binding="{Binding OperatorRoleDisplay}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="Foreground" Value="#666"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 变更字段 -->
                <DataGridTextColumn Header="变更字段" Binding="{Binding ChangedFieldsSummary}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ChangedFieldsSummary}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 原因 -->
                <DataGridTextColumn Header="修改原因" Binding="{Binding Reason}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Reason}"/>
                            <Setter Property="Foreground" Value="#888"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 加载中提示 -->
        <Grid Grid.Row="1" Background="#80FFFFFF"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="正在加载..." FontSize="14" Foreground="#666"/>
            </StackPanel>
        </Grid>

        <!-- 空数据提示 -->
        <Grid Grid.Row="1"
              Visibility="{Binding ShowEmptyMessage, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="暂无变更记录" FontSize="14" Foreground="#999"/>
            </StackPanel>
        </Grid>

        <!-- 分页控件 -->
        <Grid Grid.Row="2" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 记录统计 -->
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#666" FontSize="12">
                <Run Text="共"/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text="条记录"/>
            </TextBlock>

            <!-- 分页按钮 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="上一页" Command="{Binding PreviousPageCommand}"
                        Width="70" Height="28" Margin="0,0,5,0"
                        IsEnabled="{Binding CanGoPrevious}"/>
                <TextBlock VerticalAlignment="Center" Margin="10,0" FontSize="12" Foreground="#666">
                    <Run Text="第"/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text="/"/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    <Run Text="页"/>
                </TextBlock>
                <Button Content="下一页" Command="{Binding NextPageCommand}"
                        Width="70" Height="28" Margin="5,0,0,0"
                        IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
        </Grid>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="刷新" Command="{Binding RefreshCommand}"
                    Width="80" Height="32" Margin="0,0,10,0"/>
            <Button Content="关闭" Command="{Binding CloseCommand}"
                    Width="80" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
