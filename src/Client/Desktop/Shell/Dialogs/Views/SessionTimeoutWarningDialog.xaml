<!--
    SessionTimeoutWarningDialog - 会话超时预警对话框（US-AUTH-014）

    重要: Prism DialogService 要求 Dialog 视图必须是 UserControl，
    DialogService 会将其嵌入到 DialogWindow 容器中显示。
    使用 Window 会导致 "Window 不能作为其他 Visual 的子元素" 错误。
-->
<UserControl x:Class="LYBT.Desktop.Shell.Dialogs.Views.SessionTimeoutWarningDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
             MinWidth="420" MinHeight="220"
             d:DesignWidth="440" d:DesignHeight="260">

    <!-- 会话因长时间无操作即将结束：倒计时 + 续期/退出 -->
    <materialDesign:Card Margin="8" Padding="24" UniformCornerRadius="12"
                         materialDesign:ElevationAssist.Elevation="Dp3">
        <StackPanel>

            <!-- 警告图标 + 标题/提示 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,16,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource TcmGoldBrush}">
                    <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap" FontSize="13" Opacity="0.75"
                               MaxWidth="320" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 倒计时（mm:ss） -->
            <TextBlock Text="{Binding RemainingText}"
                       FontSize="40" FontWeight="Bold"
                       Foreground="{DynamicResource TcmOrangeBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>
            <TextBlock Text="剩余可用时间"
                       FontSize="12" Opacity="0.6"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- 按钮区域 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="续期"
                        Command="{Binding ExtendCommand}"
                        Width="96" Height="32"
                        Margin="0,0,10,0"
                        FontSize="14"
                        Style="{DynamicResource MaterialDesignRaisedButton}"/>
                <Button Content="退出"
                        Command="{Binding LogoutCommand}"
                        Width="96" Height="32"
                        FontSize="14"/>
            </StackPanel>

        </StackPanel>
    </materialDesign:Card>
</UserControl>
