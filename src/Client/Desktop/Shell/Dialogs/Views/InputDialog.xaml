<UserControl x:Class="LYBT.Desktop.Shell.Dialogs.Views.InputDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinWidth="400" MinHeight="180"
             d:DesignWidth="450" d:DesignHeight="200">

    <!--
        InputDialog - Prism 输入对话框
        OpenSpec: fix-missing-dialogs - 系统性设计

        用于获取用户输入的对话框。
        重要: Prism DialogService 要求 Dialog 视图必须是 UserControl。
    -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: 提示消息 -->
            <RowDefinition Height="Auto"/>   <!-- Row 1: 输入框 -->
            <RowDefinition Height="*"/>      <!-- Row 2: 弹性空间 -->
            <RowDefinition Height="Auto"/>   <!-- Row 3: 按钮 -->
        </Grid.RowDefinitions>

        <!-- 提示消息 -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,16"/>

        <!-- 输入框 -->
        <TextBox Grid.Row="1"
                 Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14"
                 Height="32"
                 Padding="8,6"
                 VerticalContentAlignment="Center"
                 Style="{DynamicResource TextBoxExtend}">
            <TextBox.ToolTip>
                <ToolTip Content="{Binding Placeholder}"
                         Visibility="{Binding Placeholder, Converter={StaticResource StringToVisibilityConverter}}"/>
            </TextBox.ToolTip>
        </TextBox>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{Binding OkButtonText}"
                    Command="{Binding ConfirmCommand}"
                    Width="80" Height="32"
                    Margin="0,0,10,0"
                    FontSize="14"
                    Style="{DynamicResource ButtonPrimary}"/>
            <Button Content="{Binding CancelButtonText}"
                    Command="{Binding CancelCommand}"
                    Width="80" Height="32"
                    FontSize="14"/>
        </StackPanel>
    </Grid>
</UserControl>
