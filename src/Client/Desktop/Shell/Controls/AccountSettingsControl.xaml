<!--
    AccountSettingsControl - 账户设置控件 (MDIX Migration 2026-06-27)

    左右分栏布局，使用 MDIX 原生资源和样式
-->
<UserControl
    x:Class="LYBT.Desktop.Shell.Controls.AccountSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧面板 ============  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource MaterialDesign.Brush.Surface}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  返回按钮  -->
                <Button
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding GoBackCommand}"
                    Content="← 返回"
                    Margin="8,8,0,0" />

                <!--  头像 + 姓名 + 角色  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,8,0,24"
                    HorizontalAlignment="Center">
                    <Border
                        Width="64" Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        CornerRadius="32">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                            Foreground="White"
                            Text="{Binding CurrentUser.RealName, Converter={x:Static converters:Cvt.FirstChar}}" />
                    </Border>
                    <TextBlock
                        Margin="0,12,0,4"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="{Binding CurrentUser.RealName}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="{Binding CurrentUser.Role, Converter={x:Static converters:Cvt.EnumDesc}}" />
                </StackPanel>

                <!--  导航项  -->
                <StackPanel Grid.Row="2" Margin="12,0">
                    <RadioButton
                        Content="个人资料"
                        GroupName="ProfileNav"
                        IsChecked="{Binding IsProfileSelected, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Padding="12,10" Margin="0,2" />
                    <RadioButton
                        Content="安全设置"
                        GroupName="ProfileNav"
                        IsChecked="{Binding IsPasswordSelected, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Padding="12,10" Margin="0,2" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ 右侧内容 ============  -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24" MaxWidth="600">

                <!--  个人资料  -->
                <StackPanel Visibility="{Binding IsProfileSelected, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Text="个人资料" Margin="0,0,0,24" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="姓名" Margin="0,0,0,6" />
                    <TextBox
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Margin="0,0,0,16"
                        MaxLength="50"
                        Text="{Binding EditRealName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="手机号" Margin="0,0,0,6" />
                    <TextBox
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Margin="0,0,0,16"
                        MaxLength="20"
                        Text="{Binding EditPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="邮箱" Margin="0,0,0,6" />
                    <TextBox
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Margin="0,0,0,24"
                        MaxLength="100"
                        Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Height="1" Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.3" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="用户名" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="{Binding CurrentUser.UserName}" Margin="0,0,0,16" Opacity="0.7" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="角色" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="{Binding CurrentUser.Role, Converter={x:Static converters:Cvt.EnumDesc}}" Margin="0,0,0,16" Opacity="0.7" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="注册时间" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="{Binding CurrentUser.CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Margin="0,0,0,16" Opacity="0.7" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="最后登录" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="{Binding CurrentUser.LastLoginTime, StringFormat=yyyy-MM-dd HH:mm}" Margin="0,0,0,24" Opacity="0.7" />

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            Command="{Binding GoBackCommand}"
                            Content="取消" />
                        <Button
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            Command="{Binding SaveProfileCommand}"
                            Content="保存修改" />
                    </StackPanel>
                </StackPanel>

                <!--  安全设置  -->
                <StackPanel Visibility="{Binding IsPasswordSelected, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Text="安全设置" Margin="0,0,0,24" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="当前密码" Margin="0,0,0,6" />
                    <PasswordBox
                        x:Name="OldPasswordBox"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        Margin="0,0,0,16"
                        behaviors:PasswordBoxHelper.BoundPassword="{Binding OldPassword, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="新密码 (至少8位)" Margin="0,0,0,6" />
                    <PasswordBox
                        x:Name="NewPasswordBox"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        Margin="0,0,0,16"
                        behaviors:PasswordBoxHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="确认新密码" Margin="0,0,0,6" />
                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        Margin="0,0,0,24"
                        behaviors:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />

                    <Button
                        Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        HorizontalAlignment="Left"
                        Command="{Binding ChangePasswordCommand}"
                        Content="确认修改" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
