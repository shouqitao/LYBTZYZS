<!--
    AccountSettingsControl - 账户设置控件
    OpenSpec: migrate-views-to-role-modules

    功能：合并个人资料+修改密码，内嵌导航模式
    布局：左侧导航(280px) + 右侧内容区域
    设计：基于UnifiedComponents.xaml统一设计系统
-->
<UserControl x:Class="LYBT.Desktop.Shell.Controls.AccountSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource SurfaceCardBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 导航项样式 - 基于统一设计系统 -->
            <Style x:Key="NavItemStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="48"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="ItemBorder"
                                    Background="Transparent"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="Transparent"
                                    Padding="20,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="Icon"
                                          Width="22" Height="22"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Stretch="Uniform"
                                          Data="{TemplateBinding Tag}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Label"
                                               Text="{TemplateBinding Content}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DataGridHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DataGridSelectedBrush}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
                                    <Setter TargetName="Icon" Property="Fill" Value="{StaticResource BrandPrimaryBrush}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource BrandPrimaryBrush}"/>
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 返回按钮样式 -->
            <Style x:Key="BackButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource CornerRadiusSmall}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DataGridHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DataGridSelectedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 表单分组标题样式 -->
            <Style x:Key="FormSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- 表单描述文字样式 -->
            <Style x:Key="FormDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- 表单字段标签样式 -->
            <Style x:Key="FormFieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- 表单输入框样式 - 基于EditableTextBoxStyle -->
            <Style x:Key="FormInputStyle" TargetType="TextBox" BasedOn="{StaticResource EditableTextBoxStyle}">
                <Setter Property="MinWidth" Value="280"/>
            </Style>

            <!-- 密码框样式 - 与EditableTextBoxStyle视觉一致 -->
            <Style x:Key="FormPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="MinWidth" Value="280"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="PART_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource CornerRadiusSmall}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 内容卡片样式 -->
            <Style x:Key="FormCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}"/>
                <Setter Property="Padding" Value="32,28"/>
                <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>  <!-- 左侧导航 -->
            <ColumnDefinition Width="*"/>    <!-- 右侧内容 -->
        </Grid.ColumnDefinitions>

        <!-- ========================================
             左侧导航面板
             ======================================== -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBackgroundBrush}"
                BorderBrush="{StaticResource BorderDividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 返回按钮 -->
                    <RowDefinition Height="Auto"/>  <!-- 用户信息 -->
                    <RowDefinition Height="Auto"/>  <!-- 分隔线 -->
                    <RowDefinition Height="Auto"/>  <!-- 导航菜单 -->
                    <RowDefinition Height="*"/>     <!-- 填充 -->
                </Grid.RowDefinitions>

                <!-- 返回按钮区域 -->
                <Button Grid.Row="0"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource BackButtonStyle}"
                        Margin="16,20,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Fill="{StaticResource TextSecondaryBrush}"
                              Width="18" Height="18" Stretch="Uniform"
                              Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                        <TextBlock Text="返回"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 用户信息区域 -->
                <Border Grid.Row="1" Padding="24,16,24,24">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- 头像 -->
                        <Border Width="80" Height="80"
                                CornerRadius="40"
                                Background="{StaticResource BrandPrimaryBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16"
                                Effect="{StaticResource SubtleShadow}">
                            <TextBlock Text="{Binding RealName, Converter={StaticResource FirstCharacterConverter}}"
                                       FontSize="32"
                                       FontWeight="Medium"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- 姓名 -->
                        <TextBlock Text="{Binding RealName}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <!-- 角色 -->
                        <TextBlock Text="{Binding Role}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Row="2" Height="1" Background="{StaticResource BorderDividerBrush}" Margin="20,0"/>

                <!-- 导航菜单 -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <RadioButton x:Name="NavProfile"
                                 Content="个人资料"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding IsProfileSelected, Mode=TwoWay}"
                                 Tag="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    <RadioButton x:Name="NavPassword"
                                 Content="修改密码"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavItemStyle}"
                                 IsChecked="{Binding IsPasswordSelected, Mode=TwoWay}"
                                 Tag="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================
             右侧内容区域 - 横屏全宽布局
             ======================================== -->
        <Grid Grid.Column="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                <!-- ============ 个人资料表单 - 单行全宽布局 ============ -->
                <StackPanel Visibility="{Binding IsProfileSelected, Converter={StaticResource BoolToVis}}">

                    <!-- 顶部标题栏 -->
                    <Border BorderBrush="{StaticResource BorderDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="48,32,48,24">
                        <StackPanel>
                            <TextBlock Text="个人资料"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="管理您的个人信息，部分字段不可修改"
                                       Style="{StaticResource FormDescriptionStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 表单内容区 - 单行全宽 -->
                    <StackPanel Margin="48,24,48,24">
                        <!-- 用户名（只读） -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="用户名" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding UserName, Mode=OneWay}"
                                     Style="{StaticResource FormInputStyle}"
                                     IsReadOnly="True"
                                     MinWidth="0"/>
                        </StackPanel>

                        <!-- 角色（只读） -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="角色" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding Role, Mode=OneWay}"
                                     Style="{StaticResource FormInputStyle}"
                                     IsReadOnly="True"
                                     MinWidth="0"/>
                        </StackPanel>

                        <!-- 姓名 -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource FormFieldLabelStyle}">
                                <Run Text="姓名"/>
                                <Run Text=" *" Foreground="{StaticResource SemanticErrorBrush}"/>
                            </TextBlock>
                            <TextBox Text="{Binding RealName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInputStyle}"
                                     MinWidth="0"/>
                        </StackPanel>

                        <!-- 手机号 -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="手机号" Style="{StaticResource FormFieldLabelStyle}"/>
                            <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInputStyle}"
                                     MinWidth="0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 底部操作栏 -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource BorderDividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="48,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消"
                                    Command="{Binding GoBackCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="32,12"/>
                            <Button Content="保存修改"
                                    Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="32,12"
                                    Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 修改密码表单 - 单行全宽布局 ============ -->
                <StackPanel Visibility="{Binding IsPasswordSelected, Converter={StaticResource BoolToVis}}">

                    <!-- 顶部标题栏 -->
                    <Border BorderBrush="{StaticResource BorderDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="48,32,48,24">
                        <StackPanel>
                            <TextBlock Text="修改密码"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="定期修改密码可以提高账户安全性"
                                       Style="{StaticResource FormDescriptionStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 表单内容区 - 单行全宽 -->
                    <StackPanel Margin="48,24,48,24">
                        <!-- 当前密码 -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource FormFieldLabelStyle}">
                                <Run Text="当前密码"/>
                                <Run Text=" *" Foreground="{StaticResource SemanticErrorBrush}"/>
                            </TextBlock>
                            <PasswordBox x:Name="OldPasswordBox"
                                         Style="{StaticResource FormPasswordStyle}"
                                         MinWidth="0"/>
                        </StackPanel>

                        <!-- 新密码 -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource FormFieldLabelStyle}">
                                <Run Text="新密码"/>
                                <Run Text=" *" Foreground="{StaticResource SemanticErrorBrush}"/>
                            </TextBlock>
                            <PasswordBox x:Name="NewPasswordBox"
                                         Style="{StaticResource FormPasswordStyle}"
                                         MinWidth="0"/>
                            <TextBlock Text="密码长度至少6位"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- 确认密码 -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource FormFieldLabelStyle}">
                                <Run Text="确认密码"/>
                                <Run Text=" *" Foreground="{StaticResource SemanticErrorBrush}"/>
                            </TextBlock>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Style="{StaticResource FormPasswordStyle}"
                                         MinWidth="0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 底部操作栏 -->
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource BorderDividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="48,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消"
                                    Command="{Binding GoBackCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="32,12"/>
                            <Button Content="确认修改"
                                    Command="{Binding ChangePasswordCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="32,12"
                                    Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 错误提示区域 -->
            <Border Background="{StaticResource SemanticErrorBrush}"
                    CornerRadius="{StaticResource CornerRadiusSmall}"
                    Padding="16,12"
                    Margin="48,0,48,32"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    MaxWidth="600"
                    Effect="{StaticResource CardShadow}"
                    Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="White" Width="20" Height="20" Stretch="Uniform"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ValidationError}"
                               Foreground="White"
                               FontSize="{StaticResource FontSizeBody}"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 加载遮罩 -->
            <Grid Background="#80FFFFFF"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <Border Background="White"
                        CornerRadius="{StaticResource CornerRadiusMedium}"
                        Padding="32,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Effect="{StaticResource FloatingShadow}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="处理中..."
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
