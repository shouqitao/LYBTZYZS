<!--
    AccountSettingsControl - 账户设置控件 (Redesign 2026-06-21)

    新布局：左右分栏
    - 左侧 (260px): 返回按钮 + 头像 + 姓名/角色 + 导航
    - 右侧: ScrollViewer 内含 个人资料/安全设置 两个 StackPanel（BoolToVis 切换）
-->
<UserControl
    x:Class="LYBT.Desktop.Shell.Controls.AccountSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  导航项样式  -->
            <Style x:Key="ProfileNavItemStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  字段标签样式  -->
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <!--  只读字段样式  -->
            <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧面板 ============  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource MaterialDesignBody}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  返回按钮  -->
                <Button
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding GoBackCommand}"
                    Content="← 返回"
                    Cursor="Hand"
                    FontSize="13"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Padding="16,12" />

                <!--  头像 + 姓名 + 角色  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,8,0,24"
                    HorizontalAlignment="Center">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="32">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding CurrentUser.RealName, Converter={x:Static converters:Cvt.FirstChar}}" />
                    </Border>
                    <TextBlock
                        Margin="0,12,0,4"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding CurrentUser.RealName}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding CurrentUser.Role, Converter={x:Static converters:Cvt.EnumDesc}}" />
                </StackPanel>

                <!--  导航项  -->
                <StackPanel Grid.Row="2" Margin="12,0">
                    <RadioButton
                        Content="个人资料"
                        GroupName="ProfileNav"
                        IsChecked="{Binding IsProfileSelected}"
                        Style="{StaticResource ProfileNavItemStyle}" />
                    <RadioButton
                        Content="安全设置"
                        GroupName="ProfileNav"
                        IsChecked="{Binding IsPasswordSelected}"
                        Style="{StaticResource ProfileNavItemStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ 右侧内容 ============  -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,24">
                <!--  个人资料  -->
                <StackPanel Visibility="{Binding IsProfileSelected, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <TextBlock
                        Margin="0,0,0,24"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="个人资料" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="姓名" />
                    <TextBox
                        Margin="0,0,0,16"
                        Height="40"
                        FontSize="14"
                        MaxLength="50"
                        Padding="12,0"
                        Text="{Binding EditRealName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="手机号" />
                    <TextBox
                        Margin="0,0,0,16"
                        Height="40"
                        FontSize="14"
                        MaxLength="20"
                        Padding="12,0"
                        Text="{Binding EditPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="邮箱" />
                    <TextBox
                        Margin="0,0,0,24"
                        Height="40"
                        FontSize="14"
                        MaxLength="100"
                        Padding="12,0"
                        Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />

                    <Border
                        Height="1"
                        Margin="0,0,0,16"
                        Background="{DynamicResource BorderLightBrush}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                    <TextBlock Style="{StaticResource ReadOnlyFieldStyle}" Text="{Binding CurrentUser.UserName}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="角色" />
                    <TextBlock Style="{StaticResource ReadOnlyFieldStyle}" Text="{Binding CurrentUser.Role, Converter={x:Static converters:Cvt.EnumDesc}}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="注册时间" />
                    <TextBlock Style="{StaticResource ReadOnlyFieldStyle}" Text="{Binding CurrentUser.CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最后登录" />
                    <TextBlock Style="{StaticResource ReadOnlyFieldStyle}" Text="{Binding CurrentUser.LastLoginTime, StringFormat=yyyy-MM-dd HH:mm}" />

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <Button
                            Margin="0,0,12,0"
                            Padding="24,10"
                            Background="{DynamicResource BorderBrush}"
                            BorderThickness="0"
                            Command="{Binding GoBackCommand}"
                            Content="取消"
                            Cursor="Hand"
                            FontSize="14"
                            Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Button
                            Padding="24,10"
                            Background="{DynamicResource PrimaryBrush}"
                            BorderThickness="0"
                            Command="{Binding SaveProfileCommand}"
                            Content="保存修改"
                            Cursor="Hand"
                            FontSize="14"
                            Foreground="White" />
                    </StackPanel>
                </StackPanel>

                <!--  安全设置  -->
                <StackPanel Visibility="{Binding IsPasswordSelected, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <TextBlock
                        Margin="0,0,0,24"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="安全设置" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="当前密码" />
                    <PasswordBox
                        x:Name="OldPasswordBox"
                        Margin="0,0,0,16"
                        Height="40"
                        FontSize="14"
                        Padding="12,0"
                        behaviors:PasswordBoxHelper.BoundPassword="{Binding OldPassword, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="新密码 (至少8位)" />
                    <PasswordBox
                        x:Name="NewPasswordBox"
                        Margin="0,0,0,16"
                        Height="40"
                        FontSize="14"
                        Padding="12,0"
                        behaviors:PasswordBoxHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="确认新密码" />
                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Margin="0,0,0,24"
                        Height="40"
                        FontSize="14"
                        Padding="12,0"
                        behaviors:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />

                    <Button
                        HorizontalAlignment="Left"
                        Padding="24,10"
                        Background="{DynamicResource PrimaryBrush}"
                        BorderThickness="0"
                        Command="{Binding ChangePasswordCommand}"
                        Content="确认修改"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="White" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
