<!--
    AccountSettingsControl - 账户设置控件
    OpenSpec: migrate-views-to-role-modules
    
    功能：合并个人资料+修改密码，内嵌导航模式
    布局：左侧导航(280px) + 右侧内容区域
    设计：基于UnifiedComponents.xaml统一设计系统
-->
<UserControl
    x:Class="LYBT.Desktop.Shell.Controls.AccountSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource SecondaryRegionBrush}"
    mc:Ignorable="d">

    <!--
        资源加载说明 (OpenSpec: migrate-to-handycontrol):
        - 所有资源通过 App.xaml 全局加载，控件级别不再合并资源字典
        - BasedOn 的 StaticResource 引用通过 Application.Resources 解析
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!--  导航项样式 - 基于统一设计系统  -->
            <Style x:Key="NavItemStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="48" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="ItemBorder"
                                Padding="20,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path
                                        x:Name="Icon"
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center"
                                        Data="{TemplateBinding Tag}"
                                        Fill="{DynamicResource SecondaryTextBrush}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        x:Name="Label"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{DynamicResource PrimaryFontFamily}"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{TemplateBinding Content}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RegionBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  返回按钮样式  -->
            <Style x:Key="BackButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RegionBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  表单分组标题样式  -->
            <Style x:Key="FormSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{DynamicResource PrimaryFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Style>

            <!--  表单描述文字样式  -->
            <Style x:Key="FormDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="FontFamily" Value="{DynamicResource PrimaryFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  表单字段标签样式  -->
            <Style x:Key="FormFieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontFamily" Value="{DynamicResource PrimaryFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!--  表单输入框样式 - 基于EditableTextBoxStyle  -->
            <Style
                x:Key="FormInputStyle"
                BasedOn="{StaticResource EditableTextBoxStyle}"
                TargetType="TextBox">
                <Setter Property="MinWidth" Value="280" />
            </Style>

            <!--  密码框样式 - 与EditableTextBoxStyle视觉一致  -->
            <Style x:Key="FormPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MinWidth" Value="280" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
                <Setter Property="FontFamily" Value="{DynamicResource PrimaryFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="White" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border
                                x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusSmall}">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="PART_Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  内容卡片样式  -->
            <Style x:Key="FormCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
                <Setter Property="Padding" Value="32,28" />
                <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
            </Style>

            <!--  本地BoolToVis转换器已移除，改用x:Static converters:Cvt.BoolToVis  -->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <!--  左侧导航  -->
            <ColumnDefinition Width="*" />
            <!--  右侧内容  -->
        </Grid.ColumnDefinitions>

        <!--
            ========================================
            左侧导航面板
            ========================================
        -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource SecondaryBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  返回按钮  -->
                    <RowDefinition Height="Auto" />
                    <!--  用户信息  -->
                    <RowDefinition Height="Auto" />
                    <!--  分隔线  -->
                    <RowDefinition Height="Auto" />
                    <!--  导航菜单  -->
                    <RowDefinition Height="*" />
                    <!--  填充  -->
                </Grid.RowDefinitions>

                <!--  返回按钮区域  -->
                <Button
                    Grid.Row="0"
                    Margin="16,20,16,12"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource BackButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="18"
                            Height="18"
                            Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                            Fill="{DynamicResource SecondaryTextBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource PrimaryFontFamily}"
                            FontSize="{DynamicResource FontSizeBody}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="返回" />
                    </StackPanel>
                </Button>

                <!--  用户信息区域  -->
                <Border Grid.Row="1" Padding="24,16,24,24">
                    <StackPanel HorizontalAlignment="Center">
                        <!--  头像  -->
                        <Border
                            Width="80"
                            Height="80"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="40"
                            Effect="{DynamicResource SubtleShadow}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource PrimaryFontFamily}"
                                FontSize="32"
                                FontWeight="Medium"
                                Foreground="White"
                                Text="{Binding RealName, Converter={x:Static converters:Cvt.FirstChar}}" />
                        </Border>
                        <!--  姓名  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource PrimaryFontFamily}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{Binding RealName}" />
                        <!--  角色  -->
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource PrimaryFontFamily}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Foreground="{DynamicResource ThirdlyTextBrush}"
                            Text="{Binding Role}" />
                    </StackPanel>
                </Border>

                <!--  分隔线  -->
                <Border
                    Grid.Row="2"
                    Height="1"
                    Margin="20,0"
                    Background="{DynamicResource SecondaryBorderBrush}" />

                <!--  导航菜单  -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <RadioButton
                        x:Name="NavProfile"
                        Content="个人资料"
                        GroupName="NavGroup"
                        IsChecked="{Binding IsProfileSelected, Mode=TwoWay}"
                        Style="{StaticResource NavItemStyle}"
                        Tag="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                    <RadioButton
                        x:Name="NavPassword"
                        Content="修改密码"
                        GroupName="NavGroup"
                        IsChecked="{Binding IsPasswordSelected, Mode=TwoWay}"
                        Style="{StaticResource NavItemStyle}"
                        Tag="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ========================================
            右侧内容区域 - 横屏全宽布局
            ========================================
        -->
        <Grid Grid.Column="1" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!--  ============ 个人资料表单 - 单行全宽布局 ============  -->
                    <StackPanel Visibility="{Binding IsProfileSelected, Converter={x:Static converters:Cvt.BoolToVis}}">

                        <!--  顶部标题栏  -->
                        <Border
                            Padding="48,32,48,24"
                            BorderBrush="{DynamicResource SecondaryBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="{DynamicResource PrimaryFontFamily}"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="个人资料" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource FormDescriptionStyle}"
                                    Text="管理您的个人信息，部分字段不可修改" />
                            </StackPanel>
                        </Border>

                        <!--  表单内容区 - 单行全宽  -->
                        <StackPanel Margin="48,24,48,24">
                            <!--  用户名（只读）  -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="用户名" />
                                <TextBox
                                    MinWidth="0"
                                    IsReadOnly="True"
                                    Style="{StaticResource FormInputStyle}"
                                    Text="{Binding UserName, Mode=OneWay}" />
                            </StackPanel>

                            <!--  角色（只读）  -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="角色" />
                                <TextBox
                                    MinWidth="0"
                                    IsReadOnly="True"
                                    Style="{StaticResource FormInputStyle}"
                                    Text="{Binding Role, Mode=OneWay}" />
                            </StackPanel>

                            <!--  姓名  -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}">
                                    <Run Text="姓名" />
                                    <Run Foreground="{DynamicResource DangerBrush}" Text=" *" />
                                </TextBlock>
                                <TextBox
                                    MinWidth="0"
                                    Style="{StaticResource FormInputStyle}"
                                    Text="{Binding RealName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  手机号  -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="手机号" />
                                <TextBox
                                    MinWidth="0"
                                    Style="{StaticResource FormInputStyle}"
                                    Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!--  邮箱 (T5-P3-19)  -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="邮箱" />
                                <TextBox
                                    MinWidth="0"
                                    Style="{StaticResource FormInputStyle}"
                                    Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  底部操作栏  -->
                        <Border
                            Padding="48,20"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource SecondaryBorderBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Padding="32,12"
                                    Command="{Binding GoBackCommand}"
                                    Content="取消"
                                    Style="{DynamicResource SecondaryButton}" />
                                <Button
                                    Margin="16,0,0,0"
                                    Padding="32,12"
                                    Command="{Binding SaveProfileCommand}"
                                    Content="保存修改"
                                    Style="{DynamicResource PrimaryButton}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ============ 修改密码表单 - 单行全宽布局 ============  -->
                    <StackPanel Visibility="{Binding IsPasswordSelected, Converter={x:Static converters:Cvt.BoolToVis}}">

                        <!--  顶部标题栏  -->
                        <Border
                            Padding="48,32,48,24"
                            BorderBrush="{DynamicResource SecondaryBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="{DynamicResource PrimaryFontFamily}"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="修改密码" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource FormDescriptionStyle}"
                                    Text="定期修改密码可以提高账户安全性" />
                            </StackPanel>
                        </Border>

                        <!--  表单内容区 - 单行全宽  -->
                        <StackPanel Margin="48,24,48,24">
                            <!--  当前密码  -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}">
                                    <Run Text="当前密码" />
                                    <Run Foreground="{DynamicResource DangerBrush}" Text=" *" />
                                </TextBlock>
                                <PasswordBox
                                    x:Name="OldPasswordBox"
                                    MinWidth="0"
                                    Style="{StaticResource FormPasswordStyle}" />
                            </StackPanel>

                            <!--  新密码  -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}">
                                    <Run Text="新密码" />
                                    <Run Foreground="{DynamicResource DangerBrush}" Text=" *" />
                                </TextBlock>
                                <PasswordBox
                                    x:Name="NewPasswordBox"
                                    MinWidth="0"
                                    Style="{StaticResource FormPasswordStyle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource ThirdlyTextBrush}"
                                    Text="密码长度至少6位" />
                            </StackPanel>

                            <!--  确认密码  -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource FormFieldLabelStyle}">
                                    <Run Text="确认密码" />
                                    <Run Foreground="{DynamicResource DangerBrush}" Text=" *" />
                                </TextBlock>
                                <PasswordBox
                                    x:Name="ConfirmPasswordBox"
                                    MinWidth="0"
                                    Style="{StaticResource FormPasswordStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  底部操作栏  -->
                        <Border
                            Padding="48,20"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource SecondaryBorderBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Padding="32,12"
                                    Command="{Binding GoBackCommand}"
                                    Content="取消"
                                    Style="{DynamicResource SecondaryButton}" />
                                <Button
                                    Margin="16,0,0,0"
                                    Padding="32,12"
                                    Command="{Binding ChangePasswordCommand}"
                                    Content="确认修改"
                                    Style="{DynamicResource PrimaryButton}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!--  错误提示区域  -->
            <Border
                MaxWidth="600"
                Margin="48,0,48,32"
                Padding="16,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{DynamicResource DangerBrush}"
                CornerRadius="{DynamicResource CornerRadiusSmall}"
                Effect="{DynamicResource CardShadow}"
                Visibility="{Binding HasValidationError, Converter={x:Static converters:Cvt.BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                        Fill="White"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource PrimaryFontFamily}"
                        FontSize="{DynamicResource FontSizeBody}"
                        Foreground="White"
                        Text="{Binding ValidationError}" />
                </StackPanel>
            </Border>

            <!--  加载遮罩  -->
            <Grid Background="{StaticResource DarkMaskBrush}" Visibility="{Binding IsBusy, Converter={x:Static converters:Cvt.BoolToVis}}">
                <Border
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="{DynamicResource CornerRadiusMedium}"
                    Effect="{DynamicResource FloatingShadow}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource PrimaryFontFamily}"
                            FontSize="{DynamicResource FontSizeBody}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="处理中..." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
