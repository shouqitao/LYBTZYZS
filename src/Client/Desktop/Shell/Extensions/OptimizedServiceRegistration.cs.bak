using System;
using System.Collections.Generic;
using System.Net.Http;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Caching.Memory;
using Microsoft.Extensions.Http;
using Prism.Ioc;
using AutoMapper;
using Refit;
using LYBT.Desktop.Core.Interfaces.Services;
using LYBT.Desktop.Services;
using LYBT.Desktop.Core.Configuration;
using LYBT.Desktop.Core.Http;
using LYBT.Desktop.Core.Mapping;

namespace LYBT.Desktop.Shell.Extensions
{
    /// <summary>
    /// UltraThink Phase 5.2: 优化的服务注册扩展
    /// 实现模块化、按需加载和生命周期优化
    /// </summary>
    public static class OptimizedServiceRegistration
    {
        /// <summary>
        /// 注册所有服务 - 优化版本
        /// </summary>
        public static void RegisterAllServicesOptimized(this IContainerRegistry containerRegistry)
        {
            // 阶段1: 核心基础设施服务（立即加载）
            RegisterCoreInfrastructure(containerRegistry);
            
            // 阶段2: 应用基础服务（立即加载）
            RegisterApplicationFoundation(containerRegistry);
            
            // 阶段3: 业务服务（按需加载）
            RegisterBusinessServicesLazy(containerRegistry);
            
            // 阶段4: UI服务（按需加载）
            RegisterUIServicesLazy(containerRegistry);
        }

        #region 阶段1: 核心基础设施服务

        /// <summary>
        /// 注册核心基础设施服务
        /// </summary>
        private static void RegisterCoreInfrastructure(IContainerRegistry containerRegistry)
        {
            RegisterLoggingOptimized(containerRegistry);
            RegisterMemoryManagement(containerRegistry);
            RegisterConfigurationServices(containerRegistry);
        }

        /// <summary>
        /// 优化的日志注册
        /// </summary>
        private static void RegisterLoggingOptimized(IContainerRegistry containerRegistry)
        {
            // 使用延迟初始化的日志工厂
            containerRegistry.RegisterSingleton<ILoggerFactory>(() =>
            {
                return LoggerFactory.Create(builder =>
                {
                    builder.AddDebug()
                           .AddConsole()
                           .SetMinimumLevel(LogLevel.Information);
                    
#if DEBUG
                    builder.SetMinimumLevel(LogLevel.Debug);
#endif
                });
            });

            // 泛型日志器
            containerRegistry.RegisterSingleton(typeof(ILogger<>), typeof(Logger<>));
        }

        /// <summary>
        /// 内存管理服务
        /// </summary>
        private static void RegisterMemoryManagement(IContainerRegistry containerRegistry)
        {
            // 优化的内存缓存配置
            containerRegistry.RegisterSingleton<IMemoryCache>(() =>
            {
                var options = new MemoryCacheOptions
                {
                    SizeLimit = 1000,
                    CompactionPercentage = 0.25, // 25%压缩率
                    ExpirationScanFrequency = TimeSpan.FromMinutes(5)
                };
                return new MemoryCache(options);
            });

            // 缓存服务
            containerRegistry.RegisterSingleton<ICacheService, MemoryCacheService>();
        }

        /// <summary>
        /// 配置服务
        /// </summary>
        private static void RegisterConfigurationServices(IContainerRegistry containerRegistry)
        {
            // 应用配置
            containerRegistry.RegisterSingleton<IAppConfiguration>(() => 
                AppConfiguration.LoadFromFile("appsettings.json"));
        }

        #endregion

        #region 阶段2: 应用基础服务

        /// <summary>
        /// 注册应用基础服务
        /// </summary>
        private static void RegisterApplicationFoundation(IContainerRegistry containerRegistry)
        {
            RegisterAutoMapperOptimized(containerRegistry);
            RegisterHttpServicesOptimized(containerRegistry);
            RegisterSecurityServices(containerRegistry);
            RegisterErrorHandlingOptimized(containerRegistry);
        }

        /// <summary>
        /// 优化的AutoMapper注册
        /// </summary>
        private static void RegisterAutoMapperOptimized(IContainerRegistry containerRegistry)
        {
            // 延迟创建Mapper配置
            containerRegistry.RegisterSingleton<IMapper>(container =>
            {
                var loggerFactory = container.Resolve<ILoggerFactory>();
                
                var config = new MapperConfiguration(cfg =>
                {
                    cfg.AddProfile<MappingProfile>();
                    // 可以添加更多Profile
                }, loggerFactory);

                config.AssertConfigurationIsValid(); // 验证配置
                return config.CreateMapper();
            });
        }

        /// <summary>
        /// 优化的HTTP服务注册
        /// </summary>
        private static void RegisterHttpServicesOptimized(IContainerRegistry containerRegistry)
        {
            // HTTP客户端工厂
            containerRegistry.RegisterSingleton<System.Net.Http.IHttpClientFactory, OptimizedHttpClientFactory>();
            
            // 基础HTTP客户端
            containerRegistry.RegisterSingleton<HttpClient>(container =>
            {
                var factory = container.Resolve<System.Net.Http.IHttpClientFactory>();
                return factory.CreateClient("BaseClient");
            });
        }

        /// <summary>
        /// 安全相关服务
        /// </summary>
        private static void RegisterSecurityServices(IContainerRegistry containerRegistry)
        {
            containerRegistry.RegisterSingleton<ITokenManager, TokenManager>();
            containerRegistry.RegisterSingleton<IUserSessionManager, UserSessionManager>();
            containerRegistry.RegisterSingleton<IPermissionService, PermissionService>();
        }

        /// <summary>
        /// 优化的错误处理服务 - UltraThink Phase 5.3
        /// </summary>
        private static void RegisterErrorHandlingOptimized(IContainerRegistry containerRegistry)
        {
            // 错误处理依赖链
            containerRegistry.RegisterSingleton<IErrorClassifier, ErrorClassifier>();
            containerRegistry.RegisterSingleton<IUserNotificationService, UserNotificationService>();
            containerRegistry.RegisterSingleton<IGlobalExceptionHandler, GlobalExceptionHandler>();
            
            // 注册基础错误处理服务
            containerRegistry.RegisterSingleton<ErrorHandlingService>();
            
            // 注册增强错误处理服务，装饰基础服务
            containerRegistry.RegisterSingleton<IErrorHandlingService>(container =>
            {
                var baseService = container.Resolve<ErrorHandlingService>();
                var logger = container.Resolve<ILogger<EnhancedErrorHandlingService>>();
                var configuration = container.Resolve<IAppConfiguration>();
                var notificationService = container.Resolve<IUserNotificationService>();
                
                return new EnhancedErrorHandlingService(baseService, logger, configuration, notificationService);
            });
        }

        #endregion

        #region 阶段3: 业务服务（按需加载）

        /// <summary>
        /// 按需注册业务服务
        /// </summary>
        private static void RegisterBusinessServicesLazy(IContainerRegistry containerRegistry)
        {
            RegisterApiServicesLazy(containerRegistry);
            RegisterDomainServicesLazy(containerRegistry);
        }

        /// <summary>
        /// 按需注册API服务
        /// </summary>
        private static void RegisterApiServicesLazy(IContainerRegistry containerRegistry)
        {
            // API服务注册器
            containerRegistry.RegisterSingleton<IApiServiceRegistry, ApiServiceRegistry>();
            
            // 使用工厂模式按需创建API服务
            RegisterApiServiceFactory<IAuthApiService>(containerRegistry, false);
            RegisterApiServiceFactory<IUserApiService>(containerRegistry, true);
            RegisterApiServiceFactory<IPatientApiService>(containerRegistry, true);
            RegisterApiServiceFactory<IHerbApiService>(containerRegistry, true);
            RegisterApiServiceFactory<IFormulaApiService>(containerRegistry, true);
            RegisterApiServiceFactory<IConsultationApiService>(containerRegistry, true);
            RegisterApiServiceFactory<IPrescriptionApiService>(containerRegistry, true);
            RegisterApiServiceFactory<IMedicalCaseApiService>(containerRegistry, true);
        }

        /// <summary>
        /// 注册API服务工厂
        /// </summary>
        private static void RegisterApiServiceFactory<T>(IContainerRegistry containerRegistry, bool requiresAuth)
            where T : class
        {
            containerRegistry.Register<T>(container =>
            {
                var registry = container.Resolve<IApiServiceRegistry>();
                return registry.GetApiService<T>(requiresAuth);
            });
        }

        /// <summary>
        /// 按需注册领域服务
        /// </summary>
        private static void RegisterDomainServicesLazy(IContainerRegistry containerRegistry)
        {
            // 使用工厂模式注册领域服务
            var serviceFactories = new Dictionary<Type, Func<IContainerProvider, object>>
            {
                { typeof(IAuthenticationService), container => new AuthenticationService(
                    container.Resolve<IAuthApiService>(),
                    container.Resolve<ITokenManager>(),
                    container.Resolve<ILogger<AuthenticationService>>()) },

                { typeof(IUserService), container => new UserService(
                    container.Resolve<IUserApiService>(),
                    container.Resolve<IMapper>(),
                    container.Resolve<ILogger<UserService>>()) },

                { typeof(IPatientService), container => new PatientService(
                    container.Resolve<IPatientApiService>(),
                    container.Resolve<IMapper>(),
                    container.Resolve<ILogger<PatientService>>()) },

                { typeof(IHerbService), container => CreateCachedHerbService(container) },

                { typeof(IFormulaService), container => new FormulaService(
                    container.Resolve<IFormulaApiService>(),
                    container.Resolve<IMapper>(),
                    container.Resolve<ILogger<FormulaService>>()) },

                { typeof(IConsultationService), container => new ConsultationService(
                    container.Resolve<IConsultationApiService>(),
                    container.Resolve<IMapper>(),
                    container.Resolve<ILogger<ConsultationService>>()) },

                { typeof(IPrescriptionService), container => new PrescriptionService(
                    container.Resolve<IPrescriptionApiService>(),
                    container.Resolve<IMapper>(),
                    container.Resolve<ILogger<PrescriptionService>>()) },

                { typeof(IMedicalCaseService), container => new MedicalCaseService(
                    container.Resolve<IMedicalCaseApiService>(),
                    container.Resolve<IMapper>(),
                    container.Resolve<ILogger<MedicalCaseService>>()) }
            };

            foreach (var (serviceType, factory) in serviceFactories)
            {
                containerRegistry.Register(serviceType, factory);
            }
        }

        /// <summary>
        /// 创建缓存包装的药材服务
        /// </summary>
        private static IHerbService CreateCachedHerbService(IContainerProvider container)
        {
            var baseService = new HerbService(
                container.Resolve<IHerbApiService>(),
                container.Resolve<IMapper>(),
                container.Resolve<ILogger<HerbService>>());

            var cacheService = container.Resolve<ICacheService>();
            var logger = container.Resolve<ILogger<CachedHerbService>>();

            return new CachedHerbService(baseService, cacheService, logger);
        }

        #endregion

        #region 阶段4: UI服务（按需加载）

        /// <summary>
        /// 按需注册UI服务
        /// </summary>
        private static void RegisterUIServicesLazy(IContainerRegistry containerRegistry)
        {
            RegisterDialogServices(containerRegistry);
            RegisterViewModelServices(containerRegistry);
            RegisterPerformanceServices(containerRegistry);
        }

        /// <summary>
        /// 对话框服务
        /// </summary>
        private static void RegisterDialogServices(IContainerRegistry containerRegistry)
        {
            containerRegistry.RegisterSingleton<ICommonDialogService, SimpleDialogService>();
        }

        /// <summary>
        /// ViewModel服务
        /// </summary>
        private static void RegisterViewModelServices(IContainerRegistry containerRegistry)
        {
            // ViewModel工厂
            containerRegistry.RegisterSingleton<IViewModelFactory, ViewModelFactory>();
            
            // 只注册Shell ViewModels，其他按需加载
            containerRegistry.Register<HomeViewModel>();
        }

        /// <summary>
        /// 性能优化服务
        /// </summary>
        private static void RegisterPerformanceServices(IContainerRegistry containerRegistry)
        {
            containerRegistry.RegisterSingleton<IUIPerformanceOptimizer, UIPerformanceOptimizer>();
            containerRegistry.RegisterSingleton<ISmartLoadingManager, SmartLoadingManager>();
            containerRegistry.RegisterSingleton<ISmartConcurrencyManager, SmartConcurrencyManager>();
        }

        #endregion
    }

    /// <summary>
    /// API服务注册器接口
    /// </summary>
    public interface IApiServiceRegistry
    {
        T GetApiService<T>(bool requiresAuth) where T : class;
    }

    /// <summary>
    /// API服务注册器实现
    /// </summary>
    public class ApiServiceRegistry : IApiServiceRegistry
    {
        private readonly System.Net.Http.IHttpClientFactory _httpClientFactory;
        private readonly ITokenManager _tokenManager;
        private readonly Dictionary<Type, object> _serviceCache = new();

        public ApiServiceRegistry(System.Net.Http.IHttpClientFactory httpClientFactory, ITokenManager tokenManager)
        {
            _httpClientFactory = httpClientFactory;
            _tokenManager = tokenManager;
        }

        public T GetApiService<T>(bool requiresAuth) where T : class
        {
            var serviceType = typeof(T);
            
            if (_serviceCache.TryGetValue(serviceType, out var cachedService))
            {
                return (T)cachedService;
            }

            var httpClient = requiresAuth 
                ? _httpClientFactory.CreateClient("AuthenticatedClient")
                : _httpClientFactory.CreateClient("BaseClient");

            var service = RestService.For<T>(httpClient);
            _serviceCache[serviceType] = service;
            
            return service;
        }
    }

    /// <summary>
    /// 优化的HTTP客户端工厂
    /// </summary>
    public class OptimizedHttpClientFactory : System.Net.Http.IHttpClientFactory
    {
        private readonly Dictionary<string, HttpClient> _clients = new();
        private const string DefaultBaseUrl = "https://localhost:7001";

        public HttpClient CreateClient(string name)
        {
            if (_clients.TryGetValue(name, out var existingClient))
            {
                return existingClient;
            }

            var client = name switch
            {
                "BaseClient" => CreateBasicClient(),
                "AuthenticatedClient" => CreateAuthenticatedClient(),
                _ => new HttpClient()
            };

            _clients[name] = client;
            return client;
        }

        private HttpClient CreateBasicClient()
        {
            var client = new HttpClient();
            client.BaseAddress = new Uri(DefaultBaseUrl);
            client.DefaultRequestHeaders.Add("Accept", "application/json");
            return client;
        }

        private HttpClient CreateAuthenticatedClient()
        {
            // 这里需要实现认证客户端的创建逻辑
            // 暂时返回基础客户端
            return CreateBasicClient();
        }
    }

    /// <summary>
    /// ViewModel工厂接口
    /// </summary>
    public interface IViewModelFactory
    {
        T CreateViewModel<T>() where T : class;
    }

    /// <summary>
    /// ViewModel工厂实现
    /// </summary>
    public class ViewModelFactory : IViewModelFactory
    {
        private readonly IContainerProvider _container;

        public ViewModelFactory(IContainerProvider container)
        {
            _container = container;
        }

        public T CreateViewModel<T>() where T : class
        {
            return _container.Resolve<T>();
        }
    }
}