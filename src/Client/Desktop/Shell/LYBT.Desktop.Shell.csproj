<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Shell</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - WPF应用程序外壳 | Prism模块化架构 | 统一入口点</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-shell-enterprise</InformationalVersion>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Shell</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT WPF应用外壳 - Prism容器管理、模块编排、导航控制 | 企业级桌面应用启动器</PackageDescription>
    <PackageTags>WPF;Shell;应用外壳;Prism;模块化;中医;诊所;容器;导航</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Application Settings -->
    <ApplicationIcon>..\Assets\Icons\App\app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>bin\Debug\net8.0-windows\LYBT.Desktop.Shell.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>bin\Release\net8.0-windows\LYBT.Desktop.Shell.xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Exclusion Groups -->
  <ItemGroup Label="Resource Exclusions">
    <Compile Remove="Resources\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Remove="Resources\**" />
    <Page Remove="Resources\**" />
  </ItemGroup>

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core" Version="8.1.97" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
    <PackageReference Include="Prism.Wpf" Version="8.1.97" />
  </ItemGroup>

  <!-- Configuration and Logging -->
  <ItemGroup Label="Configuration and Logging">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <!-- Object Mapping -->
  <ItemGroup Label="Data Processing">
    <PackageReference Include="AutoMapper" Version="15.0.1" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Core Infrastructure">
    <ProjectReference Include="..\Core\LYBT.Desktop.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
    <ProjectReference Include="..\Services\LYBT.Desktop.Services.csproj" />
  </ItemGroup>

  <ItemGroup Label="Business Modules">
    <ProjectReference Include="..\Modules\Auth\LYBT.Desktop.Auth.csproj" />
    <ProjectReference Include="..\Modules\Users\LYBT.Desktop.Users.csproj" />
    <ProjectReference Include="..\Modules\Patients\LYBT.Desktop.Patients.csproj" />
    <ProjectReference Include="..\Modules\MedicalCase\LYBT.Desktop.MedicalCase.csproj" />
    <ProjectReference Include="..\Modules\Consultation\LYBT.Desktop.Consultation.csproj" />
    <ProjectReference Include="..\Modules\Prescriptions\LYBT.Desktop.Prescriptions.csproj" />
    <ProjectReference Include="..\Modules\Herbs\LYBT.Desktop.Herbs.csproj" />
    <ProjectReference Include="..\Modules\Formula\LYBT.Desktop.Formula.csproj" />
  </ItemGroup>

  <ItemGroup Label="Workbenches">
    <ProjectReference Include="..\Workbenches\Core\LYBT.Desktop.Workbench.Core.csproj" />
    <ProjectReference Include="..\Workbenches\SystemWorkbench\LYBT.Desktop.Workbench.Admin.csproj" />
    <ProjectReference Include="..\Workbenches\ConsultationWorkbench\LYBT.Desktop.Workbench.Consultation.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\src\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
  </ItemGroup>

  <!-- Configuration Files -->
  <ItemGroup Label="Configuration">
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Resource Files -->
  <ItemGroup Label="Application Resources">
    <Resource Include="..\Assets\Icons\App\app.ico" />
    <Resource Include="..\Themes\Design\*.xaml" />
    <Resource Include="..\Themes\Controls\*.xaml" />
    <Resource Include="..\Resources\*.xaml" />
  </ItemGroup>

  <!-- Documentation -->
  <ItemGroup Label="Documentation">
    <None Include="README.md" />
    <None Include="GlobalAssemblyInfo.cs" />
  </ItemGroup>

</Project>