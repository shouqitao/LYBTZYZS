<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- 程序集版本信息 - 通过MSBuild属性设置 -->
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <!-- 禁用重复属性的自动生成，避免与GlobalAssemblyInfo.cs冲突 -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Shell</PackageId>
    <PackageVersion>1.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT WPF应用外壳 - Prism容器管理、模块编排、导航控制 | 企业级桌面应用启动器</PackageDescription>
    <PackageTags>WPF;Shell;应用外壳;Prism;模块化;中医;诊所;容器;导航</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Application Settings -->
    <ApplicationIcon>Assets\Icons\App\app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- 注释掉Resource排除组，允许Resources目录下的XAML文件被包含 -->
  <!-- <ItemGroup Label="Resource Exclusions">
    <Compile Remove="Resources\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Remove="Resources\**" />
    <Page Remove="Resources\**" />
  </ItemGroup> -->

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Prism.Wpf" />
  </ItemGroup>

  <!-- Configuration and Logging -->
  <ItemGroup Label="Configuration and Logging">
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <!-- OpenSpec: standardize-api-architecture - AutoMapper已移除，使用Mapperly -->

  <!-- Project References -->
  <ItemGroup Label="Core Infrastructure - 简化三层架构">
    <ProjectReference Include="..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
    <ProjectReference Include="..\Core\LYBT.Desktop.Foundation\LYBT.Desktop.Foundation.csproj" />
    <ProjectReference Include="..\Core\LYBT.Desktop.Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
    <ProjectReference Include="..\Core\LYBT.Desktop.Models\LYBT.Desktop.Models.csproj" />
    <!-- OpenSpec: create-printing-module - 独立打印模块 -->
    <ProjectReference Include="..\Core\LYBT.Desktop.Printing\LYBT.Desktop.Printing.csproj" />
  </ItemGroup>

  <ItemGroup Label="Business Modules">
    <ProjectReference Include="..\Modules\LYBT.Desktop.Auth\LYBT.Desktop.Auth.csproj" />
    <ProjectReference Include="..\Modules\LYBT.Desktop.Users\LYBT.Desktop.Users.csproj" />
    <ProjectReference Include="..\Modules\LYBT.Desktop.Patients\LYBT.Desktop.Patients.csproj" />
    <ProjectReference Include="..\Modules\LYBT.Desktop.MedicalCase\LYBT.Desktop.MedicalCase.csproj" />
    <!-- LYBT.Desktop.Consultation已删除 - 功能已迁移到MedicalCase模块 -->
    <!-- LYBT.Desktop.Prescriptions已删除 - 空壳模块已移除 -->
    <ProjectReference Include="..\Modules\LYBT.Desktop.Herbs\LYBT.Desktop.Herbs.csproj" />
    <ProjectReference Include="..\Modules\LYBT.Desktop.Formula\LYBT.Desktop.Formula.csproj" />
    <!-- OpenSpec: integrate-cardreader-module - 身份证读卡模块 (已迁移到Core目录) -->
    <ProjectReference Include="..\Core\LYBT.Desktop.CardReader\LYBT.Desktop.CardReader.csproj" />
  </ItemGroup>

  <!-- Issue #1553: 角色主页模块 -->
  <ItemGroup Label="Role Home Modules">
    <ProjectReference Include="..\Roles\LYBT.Desktop.Clinical\LYBT.Desktop.Clinical.csproj" />
    <ProjectReference Include="..\Roles\LYBT.Desktop.Admin\LYBT.Desktop.Admin.csproj" />
  </ItemGroup>

  <!-- Configuration Files -->
  <ItemGroup Label="Configuration">
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Resource Files -->
  <ItemGroup Label="Application Resources">
    <Resource Include="Assets\Icons\App\app.ico" />
    <Resource Include="Assets\Images\Backgrounds\img-login-background.jpg" />
    <!-- UltraThink修复 Issue #856: XAML资源字典需要用Page而非Resource -->
    <!-- Page会编译为.baml并支持StaticResource查找，Resource只嵌入不编译 -->
    <!-- 使用 Link 将外部文件链接到项目内部的虚拟路径 -->
    <!-- UnifiedDesignSystem.xaml 已删除 (OpenSpec: migrate-to-handycontrol) - 死代码清理 -->
    <Page Include="..\Themes\Design\*.xaml">
      <Link>Themes\Design\%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="..\Themes\Controls\*.xaml">
      <Link>Themes\Controls\%(Filename)%(Extension)</Link>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <None Remove="LYBT.Desktop.Shell.xml" />
  </ItemGroup>

  <!-- Documentation -->
  <ItemGroup Label="Documentation">
    <None Include="README.md" />
    <None Include="GlobalAssemblyInfo.cs" />
  </ItemGroup>

</Project>