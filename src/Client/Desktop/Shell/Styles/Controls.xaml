    <!--  ========== 兼容性别名 (Legacy Compatibility) ==========  -->
    <!--
        以下别名用于兼容旧代码中的样式引用
        新代码应使用新命名: PrimaryButton, SecondaryButton, DangerButton
    -->

    <!--  按钮样式别名  -->
    <Style
        x:Key="PrimaryButtonStyle"
        BasedOn="{StaticResource PrimaryButton}"
        TargetType="Button" />
    <Style
        x:Key="SecondaryButtonStyle"
        BasedOn="{StaticResource SecondaryButton}"
        TargetType="Button" />
    <Style
        x:Key="DangerButtonStyle"
        BasedOn="{StaticResource DangerButton}"
        TargetType="Button" />
    <Style
        x:Key="SuccessButtonStyle"
        BasedOn="{StaticResource SuccessButton}"
        TargetType="Button" />

    <!--  输入控件样式别名  -->
    <Style
        x:Key="StandardTextBoxStyle"
        BasedOn="{StaticResource StandardTextBox}"
        TargetType="TextBox" />
    <Style
        x:Key="SearchTextBoxStyle"
        BasedOn="{StaticResource SearchTextBox}"
        TargetType="TextBox" />
    <Style
        x:Key="FormTextBoxStyle"
        BasedOn="{StaticResource FormTextBox}"
        TargetType="TextBox" />
    <Style
        x:Key="FormTextAreaStyle"
        BasedOn="{StaticResource FormTextArea}"
        TargetType="TextBox" />
    <Style
        x:Key="StandardComboBoxStyle"
        BasedOn="{StaticResource StandardComboBox}"
        TargetType="ComboBox" />

    <!--  DataGrid样式别名  -->
    <Style
        x:Key="StandardDataGridStyle"
        BasedOn="{StaticResource StandardDataGrid}"
        TargetType="DataGrid" />

    <!--  ========== 卡片与容器样式 ==========  -->

    <!--  面板卡片样式  -->
    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--  面板头部样式  -->
    <Style x:Key="PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="#F8F9FA" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!--  操作栏样式  -->
    <Style x:Key="ActionBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Height" Value="64" />
    </Style>

    <!--  信息栏样式  -->
    <Style x:Key="InfoBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
        <Setter Property="BorderBrush" Value="#90CAF9" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="50" />
    </Style>

    <!--  分隔线样式  -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DividerBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!--  卡片样式 (带阴影)  -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="5"
                    Direction="315"
                    Opacity="0.2"
                    ShadowDepth="2"
                    Color="Gray" />
            </Setter.Value>
        </Setter>
    </Style>

