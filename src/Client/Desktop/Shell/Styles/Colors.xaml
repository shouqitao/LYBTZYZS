<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    全局颜色系统 (Issue #1484)
    定义应用的核心颜色规范，所有界面统一使用
    -->

    <!-- 核心颜色 -->
    <Color x:Key="PrimaryColor">#2196F3</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FF9800</Color>
    <Color x:Key="ErrorColor">#F44336</Color>

    <!-- 背景颜色 -->
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <!-- 文本颜色 -->
    <Color x:Key="TextColor">#212121</Color>
    <Color x:Key="TextSecondaryColor">#757575</Color>

    <!-- 边框颜色 -->
    <Color x:Key="BorderColor">#E0E0E0</Color>

    <!-- 画刷定义 (基于颜色资源) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!-- 交互状态颜色 -->
    <Color x:Key="HoverColor">#E3F2FD</Color>
    <!-- Primary的浅色版本 -->
    <Color x:Key="PressedColor">#BBDEFB</Color>
    <!-- Primary的更浅版本 -->
    <Color x:Key="DisabledColor">#BDBDBD</Color>

    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />

</ResourceDictionary>
