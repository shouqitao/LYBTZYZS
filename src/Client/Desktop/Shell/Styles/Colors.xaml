<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    全局颜色系统 (Issue #1484, OpenSpec: cleanup-ui-layer, optimize-module-list-ui)
    定义应用的核心颜色规范，所有界面统一使用

    设计规范:
    - 主色调: Fluent Design Blue #0078D4 (UI-025)
    - 目标分辨率: 1920x1080 (Full HD)
    - 最小支持: 1366x768
    -->

    <!-- ==================== 主色调 (Fluent Design) ==================== -->
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryDarkColor">#005A9E</Color>
    <Color x:Key="PrimaryLightColor">#E5F3FF</Color>
    <!-- 悬停/按下状态颜色 - OpenSpec: optimize-module-list-ui UI-025 -->
    <Color x:Key="PrimaryHoverColor">#106EBE</Color>
    <Color x:Key="PrimaryPressedColor">#005A9E</Color>

    <!-- ==================== 功能色 (Fluent Design - UI-025) ==================== -->
    <Color x:Key="SuccessColor">#388E3C</Color>
    <Color x:Key="SuccessDarkColor">#2E7D32</Color>
    <Color x:Key="SuccessLightColor">#E8F5E9</Color>
    <Color x:Key="SuccessHoverColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#F57C00</Color>
    <Color x:Key="WarningDarkColor">#E65100</Color>
    <Color x:Key="WarningLightColor">#FFF3E0</Color>
    <Color x:Key="WarningHoverColor">#E65100</Color>
    <Color x:Key="ErrorColor">#D32F2F</Color>
    <Color x:Key="ErrorDarkColor">#B71C1C</Color>
    <Color x:Key="ErrorLightColor">#FFEBEE</Color>
    <!-- 别名: DangerColor = ErrorColor (兼容MedicalCaseStyles) -->
    <Color x:Key="DangerColor">#D32F2F</Color>
    <Color x:Key="DangerDarkColor">#B71C1C</Color>
    <Color x:Key="DangerLightColor">#FFEBEE</Color>
    <Color x:Key="DangerHoverColor">#B71C1C</Color>
    <Color x:Key="InfoColor">#00B7C3</Color>
    <Color x:Key="InfoDarkColor">#00939B</Color>
    <Color x:Key="InfoLightColor">#E0F7FA</Color>
    <Color x:Key="InfoHoverColor">#00A5AF</Color>

    <!-- ==================== 中性色/背景色 ==================== -->
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="DividerColor">#EEEEEE</Color>

    <!-- ==================== 文本颜色 ==================== -->
    <Color x:Key="TextColor">#212121</Color>
    <Color x:Key="TextPrimaryColor">#333333</Color>
    <Color x:Key="TextSecondaryColor">#757575</Color>
    <Color x:Key="TextHintColor">#999999</Color>
    <Color x:Key="TextDisabledColor">#BDBDBD</Color>

    <!-- ==================== 交互状态颜色 ==================== -->
    <Color x:Key="HoverColor">#E3F2FD</Color>
    <Color x:Key="PressedColor">#BBDEFB</Color>
    <Color x:Key="DisabledColor">#BDBDBD</Color>

    <!-- ==================== 状态指示颜色 ==================== -->
    <Color x:Key="StatusCompleteColor">#4CAF50</Color>
    <Color x:Key="StatusPendingColor">#9E9E9E</Color>
    <Color x:Key="StatusInProgressColor">#FFC107</Color>

    <!-- ==================== 侧边栏颜色 (poc-drawer-layout) ==================== -->
    <Color x:Key="SidebarBackgroundColor">#2B4162</Color>
    <Color x:Key="SidebarHoverColor">#3D5A80</Color>
    <Color x:Key="SidebarDividerColor">#3D5A80</Color>
    <Color x:Key="SidebarTextColor">#FFFFFF</Color>
    <Color x:Key="SidebarTextSecondaryColor">#9DB5CC</Color>
    <Color x:Key="SidebarAvatarColor">#4A90D9</Color>

    <!-- ==================== 主色调画刷 ==================== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <!-- OpenSpec: optimize-module-list-ui - UI-025 悬停/按下画刷 -->
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />

    <!-- ==================== 功能色画刷 (含悬停状态 - UI-025) ==================== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="{StaticResource SuccessDarkColor}" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningDarkBrush" Color="{StaticResource WarningDarkColor}" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}" />
    <SolidColorBrush x:Key="WarningHoverBrush" Color="{StaticResource WarningHoverColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource ErrorDarkColor}" />
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLightColor}" />
    <!-- 别名: DangerBrush = ErrorBrush (兼容MedicalCaseStyles) -->
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoDarkBrush" Color="{StaticResource InfoDarkColor}" />
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLightColor}" />
    <SolidColorBrush x:Key="InfoHoverBrush" Color="{StaticResource InfoHoverColor}" />

    <!-- ==================== 中性色画刷 ==================== -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <!-- ==================== 文本色画刷 ==================== -->
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextHintBrush" Color="{StaticResource TextHintColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <!-- ==================== 交互状态画刷 ==================== -->
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />

    <!-- ==================== 状态指示画刷 ==================== -->
    <SolidColorBrush x:Key="StatusCompleteBrush" Color="{StaticResource StatusCompleteColor}" />
    <SolidColorBrush x:Key="StatusPendingBrush" Color="{StaticResource StatusPendingColor}" />
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="{StaticResource StatusInProgressColor}" />

    <!-- ==================== 侧边栏画刷 (poc-drawer-layout) ==================== -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="{StaticResource SidebarDividerColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="{StaticResource SidebarTextSecondaryColor}" />
    <SolidColorBrush x:Key="SidebarAvatarBrush" Color="{StaticResource SidebarAvatarColor}" />

    <!-- ==================== 间距常量 (4px网格系统) ==================== -->
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">16</Thickness>
    <Thickness x:Key="SpacingLG">24</Thickness>
    <Thickness x:Key="SpacingXL">32</Thickness>

</ResourceDictionary>
