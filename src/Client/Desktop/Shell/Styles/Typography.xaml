<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        全局排版系统 (Issue #1484, OpenSpec: cleanup-ui-layer)
        定义统一的文本样式，确保界面排版一致性
        
        设计规范:
        - 字体: Microsoft YaHei (雅黑)
        - 基准字号: 14px
        - 行高: 1.5倍
        - 目标分辨率: 1920x1080
    -->

    <!--  ==================== 字号常量 ====================  -->
    <system:Double x:Key="FontSizeXS">12</system:Double>
    <system:Double x:Key="FontSizeSM">13</system:Double>
    <system:Double x:Key="FontSizeMD">14</system:Double>
    <system:Double x:Key="FontSizeLG">16</system:Double>
    <system:Double x:Key="FontSizeXL">20</system:Double>
    <system:Double x:Key="FontSizeXXL">24</system:Double>

    <!--  标题1样式 (H1)  -->
    <Style x:Key="H1TextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--  标题2样式 (H2)  -->
    <Style x:Key="H2TextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!--  正文样式 (Body)  -->
    <Style x:Key="BodyTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  说明文字样式 (Caption)  -->
    <Style x:Key="CaptionTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
    </Style>

    <!--  标签样式 (Label)  -->
    <Style x:Key="LabelTextBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  全局TextBlock默认样式  -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>

    <!--  ==================== 页面级样式 ====================  -->

    <!--  页面标题样式  -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXXL}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!--  区块标题样式  -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--  面板标题样式  -->
    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
    </Style>

    <!--  ==================== 表单样式 ====================  -->

    <!--  字段标签样式  -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--  必填标记样式  -->
    <Style x:Key="RequiredMark" TargetType="TextBlock">
        <Setter Property="Text" Value="*" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!--  提示文本样式  -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="Foreground" Value="{StaticResource ThirdlyTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
    </Style>

    <!--  ==================== 状态文本样式 ====================  -->

    <!--  状态文本样式  -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <!--  成功文本样式  -->
    <Style
        x:Key="SuccessText"
        BasedOn="{StaticResource StatusText}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>

    <!--  警告文本样式  -->
    <Style
        x:Key="WarningText"
        BasedOn="{StaticResource StatusText}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    </Style>

    <!--  错误文本样式  -->
    <Style
        x:Key="ErrorText"
        BasedOn="{StaticResource StatusText}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <!--  ==================== 兼容性别名 ====================  -->
    <!--  以下别名用于兼容旧代码，新代码应使用上述标准样式  -->

    <Style
        x:Key="PageTitleStyle"
        BasedOn="{StaticResource PageTitle}"
        TargetType="TextBlock" />
    <Style
        x:Key="SectionTitleStyle"
        BasedOn="{StaticResource SectionHeader}"
        TargetType="TextBlock" />
    <Style
        x:Key="SectionHeaderStyle"
        BasedOn="{StaticResource SectionHeader}"
        TargetType="TextBlock" />
    <Style
        x:Key="PanelTitleStyle"
        BasedOn="{StaticResource PanelTitle}"
        TargetType="TextBlock" />
    <Style
        x:Key="FieldLabelStyle"
        BasedOn="{StaticResource FieldLabel}"
        TargetType="TextBlock" />
    <Style
        x:Key="RequiredMarkStyle"
        BasedOn="{StaticResource RequiredMark}"
        TargetType="TextBlock" />
    <Style
        x:Key="HintTextStyle"
        BasedOn="{StaticResource HintText}"
        TargetType="TextBlock" />

</ResourceDictionary>
