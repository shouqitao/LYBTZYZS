<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        对话框窗口样式资源字典
        OpenSpec: add-prescription-import-dialogs
        
        用于 Prism DialogService 的统一窗口样式
        影响范围：9个对话框（FormulaImportDialog, HistoryCopyDialog, AuditReasonDialog等）
        
        注意：WindowStartupLocation 不是 DependencyProperty，需在代码中设置
    -->

    <!--  Prism对话框统一窗口样式  -->
    <Style x:Key="CustomDialogWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="Background" Value="White" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
    </Style>

</ResourceDictionary>
