<UserControl x:Class="LYBT.Desktop.Shared.Views.Prescriptions.PrescriptionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:enums="clr-namespace:LYBT.Shared.Models.Enums;assembly=LYBT.Shared.Models"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1400">
    
    <UserControl.Resources>
        <!-- 状态转换器 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- 处方状态颜色转换器 -->
        <Style x:Key="StatusStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PrescriptionStatus.Draft}">
                    <Setter Property="Text" Value="草稿"/>
                    <Setter Property="Background" Value="#6C757D"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:PrescriptionStatus.Completed}">
                    <Setter Property="Text" Value="完成"/>
                    <Setter Property="Background" Value="#28A745"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="#E9ECEF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📜" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="处方管理" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Prescription Management" FontSize="12" 
                               Foreground="Gray" VerticalAlignment="Bottom" Margin="15,0,0,2"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="处方模板" Command="{Binding ShowTemplatesCommand}" 
                            Background="#6F42C1" Foreground="White" Padding="12,6" Margin="5,0" BorderThickness="0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" 
                            Background="#28A745" Foreground="White" Padding="12,6" Margin="5,0" BorderThickness="0"/>
                    <Button Content="开新处方" Command="{Binding AddPrescriptionCommand}"
                            Background="#007BFF" Foreground="White" Padding="12,6" Margin="5,0" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索和过滤栏 -->
        <Border Grid.Row="1" Background="White" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="#E9ECEF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 搜索栏 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,8" VerticalAlignment="Center"
                             BorderBrush="#CED4DA" BorderThickness="1">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="输入患者姓名、医生姓名或诊断进行搜索..." 
                                                                   Foreground="#6C757D" FontSize="14" Margin="10,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}"
                            Background="#17A2B8" Foreground="White" Padding="15,8" Margin="10,0,0,0" BorderThickness="0"/>

                    <Button Grid.Column="2" Content="清空" Command="{Binding ClearCommand}"
                            Background="#6C757D" Foreground="White" Padding="15,8" Margin="5,0,0,0" BorderThickness="0"/>
                </Grid>

                <!-- 过滤器栏 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="状态筛选:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <ComboBox SelectedItem="{Binding FilterStatus}" ItemsSource="{Binding PrescriptionStatusOptions}"
                              Width="120" Margin="0,0,20,0"/>
                    
                    <CheckBox Content="仅今日处方" IsChecked="{Binding ShowTodayOnly}" 
                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                    
                    <TextBlock Text="快速筛选:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Button Content="草稿" Click="FilterDraft_Click" 
                            Background="#6C757D" Foreground="White" Padding="8,4" Margin="2,0" BorderThickness="0" FontSize="11"/>
                    <Button Content="待审" Click="FilterPending_Click"
                            Background="#FFC107" Foreground="Black" Padding="8,4" Margin="2,0" BorderThickness="0" FontSize="11"/>
                    <Button Content="已完成" Click="FilterCompleted_Click"
                            Background="#28A745" Foreground="White" Padding="8,4" Margin="2,0" BorderThickness="0" FontSize="11"/>
                    <Button Content="全部" Click="FilterAll_Click"
                            Background="#007BFF" Foreground="White" Padding="8,4" Margin="2,0" BorderThickness="0" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedPrescription}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="White" AlternatingRowBackground="#F8F9FA"
                  SelectionMode="Single" SelectionUnit="FullRow">
            
            <DataGrid.Columns>
                <!-- 序号 -->
                <DataGridTextColumn Header="序号" Width="50" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" 
                                 Converter="{StaticResource RowIndexConverter}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <!-- 患者姓名 -->
                <DataGridTextColumn Header="患者" Binding="{Binding PatientName}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 医生姓名 -->
                <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#495057"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 诊断 -->
                <DataGridTextColumn Header="诊断" Binding="{Binding Diagnosis}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="#495057"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 剂数 -->
                <DataGridTextColumn Header="剂数" Binding="{Binding DosageCount}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#007BFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 单剂价格 -->
                <DataGridTextColumn Header="单剂价格(元)" Binding="{Binding SingleDosePrice, StringFormat=F2}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="#E74C3C"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 总价格 -->
                <DataGridTextColumn Header="总价格(元)" Binding="{Binding TotalPrice, StringFormat=F2}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="#DC3545"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 总重量 -->
                <DataGridTextColumn Header="总重量(g)" Binding="{Binding TotalWeight, StringFormat=F1}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="#6C757D"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="8,4">
                                <TextBlock Style="{StaticResource StatusStyle}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 创建时间 -->
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=MM-dd HH:mm}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#6C757D"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="400">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="查看" Command="{Binding DataContext.ViewPrescriptionCommand, 
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="#17A2B8" Foreground="White" 
                                        Padding="6,3" Margin="1" BorderThickness="0" FontSize="10"/>
                                <Button Content="编辑" Command="{Binding DataContext.EditPrescriptionCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="#FFC107" Foreground="Black"
                                        Padding="6,3" Margin="1" BorderThickness="0" FontSize="10"/>
                                <Button Content="复制" Command="{Binding DataContext.CopyPrescriptionCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="#6F42C1" Foreground="White"
                                        Padding="6,3" Margin="1" BorderThickness="0" FontSize="10"/>
                                <Button Content="验证" Command="{Binding DataContext.ValidatePrescriptionCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="#28A745" Foreground="White"
                                        Padding="6,3" Margin="1" BorderThickness="0" FontSize="10"/>
                                <Button Content="打印" Command="{Binding DataContext.PrintPrescriptionCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="#FD7E14" Foreground="White"
                                        Padding="6,3" Margin="1" BorderThickness="0" FontSize="10"/>
                                <Button Content="提交" Command="{Binding DataContext.SubmitPrescriptionCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="#007BFF" Foreground="White"
                                        Padding="6,3" Margin="1" BorderThickness="0" FontSize="10"/>
                                <Button Content="草稿" Command="{Binding DataContext.SaveDraftCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="#6C757D" Foreground="White"
                                        Padding="6,3" Margin="1" BorderThickness="0" FontSize="10"/>
                                <Button Content="作废" Command="{Binding DataContext.VoidPrescriptionCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="#DC3545" Foreground="White"
                                        Padding="6,3" Margin="1" BorderThickness="0" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页控件 -->
        <Border Grid.Row="3" Background="#F8F9FA" Padding="20,15" BorderThickness="0,1,0,0" BorderBrush="#E9ECEF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#6C757D">
                        <Run Text="共"/>
                        <Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                        <Run Text="张处方"/>
                    </TextBlock>
                    <TextBlock Text="，" Foreground="#6C757D" Margin="5,0"/>
                    <TextBlock Text="草稿:" Foreground="#6C757D"/>
                    <TextBlock Text="{Binding Items.Count, Converter={StaticResource DraftCountConverter}}" 
                               FontWeight="Bold" Foreground="#6C757D" Margin="5,0"/>
                    <TextBlock Text="，" Foreground="#6C757D" Margin="5,0"/>
                    <TextBlock Text="待审:" Foreground="#6C757D"/>
                    <TextBlock Text="{Binding Items.Count, Converter={StaticResource PendingCountConverter}}" 
                               FontWeight="Bold" Foreground="#FFC107" Margin="5,0"/>
                    <TextBlock Text="，" Foreground="#6C757D" Margin="5,0"/>
                    <TextBlock Text="完成:" Foreground="#6C757D"/>
                    <TextBlock Text="{Binding Items.Count, Converter={StaticResource CompletedCountConverter}}" 
                               FontWeight="Bold" Foreground="#28A745" Margin="5,0"/>
                </StackPanel>

                <!-- 分页按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="首页" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"
                            Padding="10,5" Margin="2,0" Background="#6C757D" Foreground="White" BorderThickness="0"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"
                            Padding="10,5" Margin="2,0" Background="#6C757D" Foreground="White" BorderThickness="0"/>
                    
                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="10,0" 
                               FontWeight="Bold" FontSize="14"/>
                    
                    <Button Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}"
                            Padding="10,5" Margin="2,0" Background="#6C757D" Foreground="White" BorderThickness="0"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoToNextPage}"
                            Padding="10,5" Margin="2,0" Background="#6C757D" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载和错误状态 -->
        <Grid Grid.Row="4">
            <!-- 加载指示器 -->
            <ProgressBar IsIndeterminate="True" Height="4" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Foreground="#007BFF"/>

            <!-- 错误消息 -->
            <Border Background="#F8D7DA" Padding="15,10" Margin="20,10"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#721C24" VerticalAlignment="Center"/>
                    <Button Content="✖" Command="{Binding ClearErrorCommand}" 
                            Background="Transparent" BorderThickness="0" Foreground="#721C24"
                            Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>