<UserControl x:Class="LYBT.Desktop.ClinicalWorkstation.Views.Workflow.ClinicalWorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 步骤指示器样式 -->
            <Style x:Key="StepIndicator" TargetType="Border">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Background" Value="#E0E6ED"/>
                <Setter Property="BorderBrush" Value="#C0C7CF"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>

            <Style x:Key="ActiveStepIndicator" TargetType="Border" BasedOn="{StaticResource StepIndicator}">
                <Setter Property="Background" Value="#007BFF"/>
                <Setter Property="BorderBrush" Value="#0056B3"/>
            </Style>

            <Style x:Key="CompletedStepIndicator" TargetType="Border" BasedOn="{StaticResource StepIndicator}">
                <Setter Property="Background" Value="#28A745"/>
                <Setter Property="BorderBrush" Value="#1E7E34"/>
            </Style>

            <Style x:Key="StepConnector" TargetType="Rectangle">
                <Setter Property="Height" Value="2"/>
                <Setter Property="Fill" Value="#DEE2E6"/>
                <Setter Property="Margin" Value="5,0"/>
            </Style>

            <Style x:Key="ActiveStepConnector" TargetType="Rectangle" BasedOn="{StaticResource StepConnector}">
                <Setter Property="Fill" Value="#28A745"/>
            </Style>

            <!-- 转换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 标题区 -->
            <RowDefinition Height="Auto"/> <!-- 步骤指示器 -->
            <RowDefinition Height="*"/>    <!-- 内容区 -->
            <RowDefinition Height="Auto"/> <!-- 操作按钮区 -->
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="20,15">
            <StackPanel>
                <TextBlock Text="诊疗流程" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="{Binding StepDescription}" FontSize="14" Foreground="#6C757D" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 步骤指示器 -->
        <Grid Grid.Row="1" Background="White" Height="100">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- 步骤1：患者选择 -->
                <StackPanel>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPatientStepActive}" Value="True">
                                        <Setter Property="Background" Value="#007BFF"/>
                                        <Setter Property="BorderBrush" Value="#0056B3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPatientStepCompleted}" Value="True">
                                        <Setter Property="Background" Value="#28A745"/>
                                        <Setter Property="BorderBrush" Value="#1E7E34"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="选择患者" Margin="0,5,0,0" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 连接线1 -->
                <Rectangle Width="100" VerticalAlignment="Center" Margin="0,-20,0,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle" BasedOn="{StaticResource StepConnector}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPatientStepCompleted}" Value="True">
                                    <Setter Property="Fill" Value="#28A745"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 步骤2：诊断 -->
                <StackPanel>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiagnosisStepActive}" Value="True">
                                        <Setter Property="Background" Value="#007BFF"/>
                                        <Setter Property="BorderBrush" Value="#0056B3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDiagnosisStepCompleted}" Value="True">
                                        <Setter Property="Background" Value="#28A745"/>
                                        <Setter Property="BorderBrush" Value="#1E7E34"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="录入诊断" Margin="0,5,0,0" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 连接线2 -->
                <Rectangle Width="100" VerticalAlignment="Center" Margin="0,-20,0,0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle" BasedOn="{StaticResource StepConnector}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDiagnosisStepCompleted}" Value="True">
                                    <Setter Property="Fill" Value="#28A745"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 步骤3：处方（可选） -->
                <StackPanel>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepIndicator}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPrescriptionStepActive}" Value="True">
                                        <Setter Property="Background" Value="#007BFF"/>
                                        <Setter Property="BorderBrush" Value="#0056B3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPrescriptionStepCompleted}" Value="True">
                                        <Setter Property="Background" Value="#28A745"/>
                                        <Setter Property="BorderBrush" Value="#1E7E34"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="开立处方" FontSize="12"/>
                        <TextBlock Text="(可选)" FontSize="10" Foreground="#6C757D" Margin="3,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 内容区域 -->
        <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#DEE2E6" BorderThickness="0,1,0,1">
            <ContentControl prism:RegionManager.RegionName="WorkflowContentRegion"
                           Margin="20"/>
        </Border>

        <!-- 操作按钮区 -->
        <Border Grid.Row="3" Background="White" Padding="20,15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="取消流程"
                           Command="{Binding CancelWorkflowCommand}"
                           Width="100" Height="35"
                           Background="#6C757D" Foreground="White"
                           BorderThickness="0" FontWeight="Bold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                       CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 上一步按钮 -->
                    <Button Content="上一步"
                           Command="{Binding PreviousStepCommand}"
                           Width="100" Height="35"
                           Margin="0,0,10,0"
                           Background="#E9ECEF" Foreground="#495057"
                           BorderThickness="0" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 跳过处方按钮（仅在处方步骤显示） -->
                    <Button Content="跳过处方"
                           Command="{Binding SkipPrescriptionCommand}"
                           Width="100" Height="35"
                           Margin="0,0,10,0"
                           Background="#FFC107" Foreground="White"
                           BorderThickness="0" FontWeight="Bold"
                           Visibility="{Binding IsPrescriptionStepActive, Converter={StaticResource BoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                       CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 下一步/完成按钮 -->
                    <Button Width="100" Height="35"
                           Command="{Binding NextStepCommand}"
                           Background="#007BFF" Foreground="White"
                           BorderThickness="0" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="下一步"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPrescriptionStepActive}" Value="True">
                                        <Setter Property="Content" Value="完成"/>
                                        <Setter Property="Background" Value="#28A745"/>
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>