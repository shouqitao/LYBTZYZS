<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.WorkflowStepIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- 步骤样式 -->
        <Style x:Key="StepContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- 激活步骤样式 -->
        <Style x:Key="ActiveStepStyle" TargetType="Border" BasedOn="{StaticResource StepContainerStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <!-- 完成步骤样式 -->
        <Style x:Key="CompletedStepStyle" TargetType="Border" BasedOn="{StaticResource StepContainerStyle}">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        </Style>

        <!-- 待完成步骤样式 -->
        <Style x:Key="PendingStepStyle" TargetType="Border" BasedOn="{StaticResource StepContainerStyle}">
            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 步骤数字样式 -->
        <Style x:Key="StepNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- 步骤指示器 -->
    <ItemsControl ItemsSource="{Binding ElementName=Root, Path=Steps}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <!-- 步骤容器 -->
                    <Border Style="{StaticResource StepContainerStyle}"
                            Width="{Binding ElementName=Root, Path=StepWidth}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 步骤数字 -->
                            <Border Grid.Column="0" 
                                    Width="28" Height="28"
                                    CornerRadius="14"
                                    Background="{DynamicResource PrimaryBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource StepNumberStyle}"
                                           Text="{Binding Number}"/>
                            </Border>

                            <!-- 步骤标签 -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Label}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                    </Border>

                    <!-- 进度指示器（除了最后一步） -->
                    <Border Width="4" 
                            Height="4" 
                            CornerRadius="2"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsLast, Converter={x:Static converters:Cvt.InverseBoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SecondaryBorderBrush}"/>
                                <Style.Trigger>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
