<!--
    MedicalCaseMasterDetailControl - 医案Master-Detail控件
    
    可复用业务控件，供Admin和Clinical角色台使用
    从MedicalCaseMasterDetailView重构而来
    注意：医案不支持新建，新建通过挂号入口创建
-->
<controls:MasterDetailControlBase
    x:Class="LYBT.Desktop.MedicalCase.Controls.MedicalCaseMasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:local="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        资源加载说明:
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}">
        <!--
            ========================================
            Master区域: 医案列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  工具栏 - 仅刷新和批量删除  -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    BatchDeleteCommand="{Binding DeleteCommand}"
                    RefreshCommand="{Binding RefreshCommand}" />

                <!--  搜索框  -->
                <controls:SearchBox
                    Grid.Row="1"
                    Margin="12,8"
                    Placeholder="搜索患者姓名/诊断..."
                    SearchCommand="{Binding SearchCommand}"
                    SearchText="{Binding SearchText, Mode=TwoWay}" />

                <!--  医案列表  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    BorderThickness="0"
                    Background="Transparent"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <!--  患者姓名  -->
                        <DataGridTextColumn
                            Width="*" MinWidth="80"
                            Binding="{Binding PatientName}"
                            Header="患者"
                            ElementStyle="{StaticResource DataGridEmphasisCellStyle}" />

                        <!--  就诊日期  -->
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}"
                            Header="日期"
                            ElementStyle="{StaticResource DataGridMonoCellStyle}" />

                        <!--  中医诊断  -->
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Diagnosis}"
                            Header="诊断"
                            ElementStyle="{StaticResource DataGridSecondaryCellStyle}" />

                        <!--  状态  -->
                        <DataGridTemplateColumn Width="Auto" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding CaseStatus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!--  右键菜单 - ContextMenu需通过PlacementTarget获取DataContext  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding EditCommand}" Header="查看详情">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FileSearch" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding DeleteCommand}" Header="删除">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件  -->
                <controls:UnifiedPaginationBar
                    Grid.Row="3"
                    CurrentPage="{Binding CurrentPage}"
                    TotalPages="{Binding TotalPages}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageSizes="{Binding PageSizes}"
                    FirstPageCommand="{Binding GoToFirstPageCommand}"
                    PreviousPageCommand="{Binding GoToPreviousPageCommand}"
                    NextPageCommand="{Binding GoToNextPageCommand}"
                    LastPageCommand="{Binding GoToLastPageCommand}" />

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 医案详情
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  详情内容（Transitioner 切换查看/编辑）  -->
                <materialDesign:Transitioner
                    Grid.Row="1"
                    SelectedIndex="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToInt}}">
                    <materialDesign:TransitionerSlide>
                        <local:MedicalCaseViewControl
                            Margin="16"
                            Detail="{Binding CurrentDetail}"
                            ShowSystemInfo="True" />
                    </materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide>
                        <local:MedicalCaseEditControl
                            Margin="16"
                            AllHerbs="{Binding AllHerbs}"
                            Consultation="{Binding Consultation}"
                            ConsultationDate="{Binding CurrentDetail.ConsultationDate}"
                            CreatedAt="{Binding CurrentDetail.CreatedAt}"
                            DoctorName="{Binding CurrentDetail.DoctorName}"
                            ErrorsSource="{Binding CurrentDetail.Errors}"
                            FormulaSource="{Binding CurrentDetail.FormulaSource}"
                            PatientName="{Binding CurrentDetail.PatientName}"
                            Prescription="{Binding Prescription}"
                            Remark="{Binding CurrentDetail.Remark, Mode=TwoWay}"
                            Status="{Binding CurrentDetail.Status}"
                            UpdatedAt="{Binding CurrentDetail.UpdatedAt}" />
                    </materialDesign:TransitionerSlide>
                </materialDesign:Transitioner>

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="2"
                    IsLoading="{Binding IsBusy}"
                    LoadingText="正在处理..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选择医案时显示
            医案不支持新建，不显示新建按钮
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState Title="请选择医案" Subtitle="在左侧列表中选择一个医案查看详情" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
