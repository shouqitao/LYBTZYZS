<!--
    MedicalCaseViewControl - 医案预览控件
    OpenSpec: refactor-medicalcase-workspace V2
    OpenSpec: refactor-medicalcase-management

    支持两种显示模式:
    - Full (默认): MasterDetail右侧详情，完整InfoCard展示
    - Compact: Workspace紧凑型，简化的只读预览

    V2布局 (Compact模式):
    - 诊疗信息栏
    - 处方药材展示 (HerbListControl只读模式)
    - 底部信息栏 (剂数/用法/总价/打印按钮)
-->
<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.MedicalCaseViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:herbList="clr-namespace:LYBT.Desktop.Herbs.Controls.HerbList;assembly=LYBT.Desktop.Herbs"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 本地资源 CompactSectionBorderStyle 保留，仅供此控件使用
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Compact模式区域边框样式 -->
            <Style x:Key="CompactSectionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=Root}">
        <!-- Full模式: MasterDetail布局 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsCompactMode, Converter={x:Static converters:Cvt.InverseBoolToVis}}">
            <StackPanel>
                <!-- ========================================
                     患者信息卡片 - Full模式
                     ======================================== -->
                <controls:InfoCard Title="患者信息" ShowTitle="True">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 患者姓名 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="患者姓名" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.PatientName}" Style="{DynamicResource DetailValueStyle}" FontWeight="SemiBold"/>

                            <!-- 就诊日期 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="就诊日期" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Detail.ConsultationDate, StringFormat=yyyy-MM-dd}" Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 接诊医生 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="接诊医生" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.DoctorName, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 状态 -->
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" Style="{DynamicResource DetailLabelStyle}"/>
                            <controls:StatusBadge Grid.Row="1" Grid.Column="3"
                                                  Status="{Binding Detail.Status}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,4,0,4"/>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     诊疗信息卡片 - Full模式
                     ======================================== -->
                <controls:InfoCard Title="诊疗信息" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 现病史 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="现病史" Style="{DynamicResource DetailLabelStyle}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.PresentIllness, TargetNullValue='-'}"
                                       Style="{DynamicResource DetailValueStyle}" TextWrapping="Wrap"/>

                            <!-- 舌诊 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="舌诊" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.TongueDiagnosis, TargetNullValue='-'}"
                                       Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 脉诊 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="脉诊" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.PulseDiagnosis, TargetNullValue='-'}"
                                       Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 中医诊断 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="中医诊断" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.TcmDiagnosis, TargetNullValue='-'}"
                                       Style="{DynamicResource DetailValueStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     处方信息卡片 - Full模式
                     ======================================== -->
                <controls:InfoCard Title="处方信息" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <!-- 处方统计信息 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="药味" Style="{DynamicResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Style="{DynamicResource DetailValueStyle}">
                                    <Run Text="{Binding Detail.HerbCount, TargetNullValue=0, Mode=OneWay}"/>
                                    <Run Text="味"/>
                                </TextBlock>

                                <TextBlock Grid.Column="2" Text="剂数" Style="{DynamicResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="3" Style="{DynamicResource DetailValueStyle}">
                                    <Run Text="{Binding Detail.DoseCount, TargetNullValue=0, Mode=OneWay}"/>
                                    <Run Text="剂"/>
                                </TextBlock>

                                <TextBlock Grid.Column="4" Text="方源" Style="{DynamicResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="5" Text="{Binding Detail.FormulaSource, TargetNullValue='无'}"
                                           Style="{DynamicResource DetailValueStyle}"/>
                            </Grid>

                            <!-- 药材列表 - 网格布局，一行4列 -->
                            <ItemsControl ItemsSource="{Binding Detail.PrescriptionItems}"
                                          Visibility="{Binding Detail.HasPrescriptionItems, Converter={x:Static converters:Cvt.BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource HerbTagStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding HerbName}" Style="{DynamicResource HerbTagNameStyle}"/>
                                                <TextBlock Text="{Binding Dosage, StringFormat={}{0}g}" Style="{DynamicResource HerbTagDosageStyle}"/>
                                                <!-- 煎法显示（非默认时显示） -->
                                                <TextBlock Foreground="#E65100"
                                                           FontSize="11"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding DecocteMethod, Converter={x:Static converters:Cvt.DecocteMethodToVis}}">
                                                    <TextBlock.Text>
                                                        <Binding Path="DecocteMethod" Converter="{x:Static converters:Cvt.EnumDesc}"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 无处方提示 -->
                            <TextBlock Text="暂无处方药材"
                                       Foreground="{DynamicResource ThirdlyTextBrush}"
                                       FontStyle="Italic"
                                       Visibility="{Binding Detail.HasPrescriptionItems, Converter={x:Static converters:Cvt.InverseBoolToVis}}"/>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     备注卡片 - Full模式
                     ======================================== -->
                <controls:InfoCard Title="备注" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <TextBlock Text="{Binding Detail.Remark, TargetNullValue='暂无备注'}"
                                   Style="{DynamicResource DetailValueStyle}"
                                   TextWrapping="Wrap"/>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     系统信息卡片 - Full模式
                     ======================================== -->
                <controls:InfoCard Title="系统信息" ShowTitle="True" Margin="0,12,0,0"
                                   Visibility="{Binding ShowAuditInfo, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 创建时间 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="创建时间" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Detail.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                       Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 更新时间 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="更新时间" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="{Binding Detail.UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                       Style="{DynamicResource DetailValueStyle}"/>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================
             Compact模式: Workspace布局 (V2布局)
             诊疗信息 + 处方药材 + 底部信息
             ======================================== -->
        <Grid Visibility="{Binding IsCompactMode, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 诊疗信息 -->
                <RowDefinition Height="*"/>     <!-- 处方药材 -->
                <RowDefinition Height="Auto"/>  <!-- 底部信息 -->
            </Grid.RowDefinitions>

            <!-- 诊疗信息 - OpenSpec: unify-control-data-binding 布局优化 -->
            <Border Grid.Row="0" Style="{StaticResource CompactSectionBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8">
                        <Run Text="现病史: " FontWeight="SemiBold"/>
                        <Run Text="{Binding Consultation.PresentIllness, TargetNullValue='-'}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock>
                            <Run Text="舌诊: " FontWeight="SemiBold"/>
                            <Run Text="{Binding Consultation.TongueDiagnosis, TargetNullValue='-'}"/>
                        </TextBlock>
                        <TextBlock Margin="24,0,0,0">
                            <Run Text="脉诊: " FontWeight="SemiBold"/>
                            <Run Text="{Binding Consultation.PulseDiagnosis, TargetNullValue='-'}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock>
                        <Run Text="中医诊断: " FontWeight="SemiBold"/>
                        <Run Text="{Binding Consultation.TcmDiagnosis, TargetNullValue='-'}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 处方药材 - OpenSpec: unify-control-data-binding 布局优化 -->
            <Border Grid.Row="1" Style="{StaticResource CompactSectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="处方药材" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- 使用HerbListControl只读模式 -->
                    <herbList:HerbListControl Grid.Row="1"
                        HerbItems="{Binding Prescription.Items}"
                        AllHerbs="{Binding AllHerbs}"
                        IsEditMode="False"
                        Columns="4"/>
                </Grid>
            </Border>

            <!-- 底部信息 - OpenSpec: unify-control-data-binding 布局优化 -->
            <Border Grid.Row="2" Style="{StaticResource CompactSectionBorderStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧: 剂数、用法 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="剂数: "/>
                            <Run Text="{Binding Prescription.DosageCount, TargetNullValue=0}" FontWeight="SemiBold"/>
                            <Run Text="剂"/>
                        </TextBlock>
                        <TextBlock Margin="24,0,0,0" VerticalAlignment="Center">
                            <Run Text="用法: "/>
                            <Run Text="{Binding Prescription.Usage, TargetNullValue='-'}"/>
                        </TextBlock>
                        <TextBlock Margin="24,0,0,0" VerticalAlignment="Center">
                            <Run Text="总价: "/>
                            <Run Text="{Binding Prescription.SingleDosePrice, StringFormat='{}{0:F2}元'}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 右侧: 打印按钮 -->
                    <Button Grid.Column="2"
                            Content="打印"
                            Command="{Binding PrintCommand}"
                            Style="{DynamicResource PrimaryButton}"
                            Visibility="{Binding ShowPrintButton, Converter={x:Static converters:Cvt.BoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
