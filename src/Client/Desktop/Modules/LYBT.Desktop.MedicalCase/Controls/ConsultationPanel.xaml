<UserControl
    x:Class="LYBT.Desktop.MedicalCase.Controls.ConsultationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="False">

    <!--
        Epic #2210 Phase 4: 诊断面板UserControl
        OpenSpec: refactor-medicalcase-ui - UI重构版本
        OpenSpec: refactor-diagnosis-fields - 移除ChiefComplaint, FourDiagnosis, TreatmentPrinciple字段

        保留4个核心字段: PresentIllness, TongueDiagnosis, PulseDiagnosis, TCMDiagnosis

        新布局:
        - Row 0: 现病史
        - Row 1: 舌诊 + 脉诊 (并排)
        - Row 2: 中医诊断 (必填)
        - Row 3: 处方选项
    -->

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!--  现病史  -->
            <RowDefinition Height="Auto" />
            <!--  舌诊 + 脉诊 (固定高度)  -->
            <RowDefinition Height="*" />
            <!--  中医诊断  -->
            <RowDefinition Height="Auto" />
            <!--  处方选项  -->
        </Grid.RowDefinitions>

        <!--  Row 0: 现病史  -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,2"
                Style="{StaticResource FieldLabelStyle}"
                Text="现病史" />
            <TextBox
                Grid.Row="1"
                MinHeight="80"
                AcceptsReturn="True"
                Style="{StaticResource FormTextAreaStyle}"
                Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>

        <!--  Row 1: 舌诊 + 脉诊（并排）  -->
        <Grid
            Grid.Row="1"
            Height="100"
            Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  舌诊  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,2"
                    Style="{StaticResource FieldLabelStyle}"
                    Text="舌诊" />
                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Style="{StaticResource FormTextAreaStyle}"
                    Text="{Binding TongueDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>

            <!--  脉诊  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,2"
                    Style="{StaticResource FieldLabelStyle}"
                    Text="脉诊" />
                <TextBox
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Style="{StaticResource FormTextAreaStyle}"
                    Text="{Binding PulseDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <!--  Row 2: 中医诊断（必填）  -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,2"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0"
                    Style="{StaticResource FieldLabelStyle}"
                    Text="中医诊断" />
                <TextBlock Style="{StaticResource RequiredMarkStyle}" />
            </StackPanel>
            <TextBox
                Grid.Row="1"
                MinHeight="80"
                AcceptsReturn="True"
                Style="{StaticResource FormTextAreaStyle}"
                Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>

        <!--  Row 3: 处方选项  -->
        <Border
            Grid.Row="3"
            Padding="12,6"
            Background="{StaticResource BackgroundBrush}"
            CornerRadius="4">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="是否开处方：" />
                <RadioButton
                    Margin="0,0,24,0"
                    VerticalAlignment="Center"
                    Content="开处方"
                    FontSize="13"
                    GroupName="PrescriptionGroup"
                    IsChecked="{Binding NeedsPrescription}" />
                <RadioButton
                    VerticalAlignment="Center"
                    Content="不开处方"
                    FontSize="13"
                    GroupName="PrescriptionGroup"
                    IsChecked="{Binding NoPrescription, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
