<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.ConsultationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="False">

    <!--
    Epic #2210 Phase 4: 诊断面板UserControl
    OpenSpec: refactor-medicalcase-ui - UI重构版本
    用于MedicalCaseWorkspaceView的左侧40%区域

    设计变更:
    - 移除多余边框，使用留白分隔
    - 操作按钮固定在面板底部
    - 应用统一样式资源
    - 输入框使用Height="*"填满可用空间
    -->

    <!-- OpenSpec: cleanup-ui-layer - 使用全局样式系统，移除MedicalCaseStyles.xaml引用 -->

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- 主诉 -->
            <RowDefinition Height="*"/>    <!-- 现病史 -->
            <RowDefinition Height="Auto"/> <!-- 四诊合参 (固定高度) -->
            <RowDefinition Height="*"/>    <!-- 中医诊断 -->
            <RowDefinition Height="*"/>    <!-- 治疗原则 -->
            <RowDefinition Height="Auto"/> <!-- 处方选项 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 主诉（必填） -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="主诉" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                <TextBlock Style="{StaticResource RequiredMarkStyle}" />
            </StackPanel>
            <TextBox Grid.Row="1"
                     Style="{StaticResource FormTextAreaStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="50"
                     Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Row 1: 现病史 -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="现病史" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
            <TextBox Grid.Row="1"
                     Style="{StaticResource FormTextAreaStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="50"
                     Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Row 2: 四诊合参（新布局：四诊 + 舌诊/脉诊） -->
        <Grid Grid.Row="2" Margin="0,0,0,4" Height="260">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 四诊（合并望闻问切） -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="四诊" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                <TextBox Grid.Row="1"
                         Style="{StaticResource FormTextAreaStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding FourDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- 舌诊 + 脉诊（并排） -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 舌诊 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="舌诊" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                    <TextBox Grid.Row="1"
                             Style="{StaticResource FormTextAreaStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding TongueDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 脉诊 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="脉诊" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                    <TextBox Grid.Row="1"
                             Style="{StaticResource FormTextAreaStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding PulseDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Row 3: 中医诊断（必填） -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="中医诊断" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                <TextBlock Style="{StaticResource RequiredMarkStyle}" />
            </StackPanel>
            <TextBox Grid.Row="1"
                     Style="{StaticResource FormTextAreaStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="50"
                     Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Row 4: 治疗原则 -->
        <Grid Grid.Row="4" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="治疗原则" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
            <TextBox Grid.Row="1"
                     Style="{StaticResource FormTextAreaStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="40"
                     Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Row 5: 处方选项 -->
        <Border Grid.Row="5"
                Background="{StaticResource BackgroundBrush}"
                CornerRadius="4"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="是否开处方："
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <RadioButton Content="开处方"
                             FontSize="13"
                             GroupName="PrescriptionGroup"
                             IsChecked="{Binding NeedsPrescription}"
                             Margin="0,0,24,0"
                             VerticalAlignment="Center" />
                <RadioButton Content="不开处方"
                             FontSize="13"
                             GroupName="PrescriptionGroup"
                             IsChecked="{Binding NoPrescription, Mode=OneWay}"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
