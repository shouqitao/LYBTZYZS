<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.ConsultationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="False">

    <!--
    Epic #2210 Phase 4: 诊断面板UserControl
    用于MedicalCaseWorkspaceView的左侧40%区域
    基于ConsultationFormView简化而来
    -->

    <UserControl.Resources>
        <!-- 分组标题样式 -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Margin" Value="0,8,0,5" />
        </Style>

        <!-- 字段标签样式 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,3,8,0" />
        </Style>

        <!-- 必填标记样式 -->
        <Style x:Key="RequiredMarkStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#F44336" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="2,3,0,0" />
        </Style>

        <!-- 多行文本框样式 -->
        <Style x:Key="MultiLineTextBoxStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 操作按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 基本诊断信息 -->
            <RowDefinition Height="Auto" />  <!-- 处方选项 -->
            <RowDefinition Height="Auto" />  <!-- 四诊合参 -->
            <RowDefinition Height="Auto" />  <!-- 备注 -->
            <RowDefinition Height="Auto" />  <!-- 操作按钮 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 基本诊断信息 -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="10"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="基本诊断信息" />

                <!-- 主诉（必填） -->
                <StackPanel Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="主诉" />
                        <TextBlock Style="{StaticResource RequiredMarkStyle}" Text="*" />
                    </StackPanel>
                    <TextBox Height="50"
                             Style="{StaticResource MultiLineTextBoxStyle}"
                             Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 现病史 -->
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="现病史" />
                    <TextBox Height="50"
                             Style="{StaticResource MultiLineTextBoxStyle}"
                             Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 中医诊断（必填） -->
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="中医诊断" />
                        <TextBlock Style="{StaticResource RequiredMarkStyle}" Text="*" />
                    </StackPanel>
                    <TextBox Height="50"
                             Style="{StaticResource MultiLineTextBoxStyle}"
                             Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 治疗原则 -->
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="治疗原则" />
                    <TextBox Height="50"
                             Style="{StaticResource MultiLineTextBoxStyle}"
                             Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Row 1: 处方选项 -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="10"
                Background="#F8F9FA"
                BorderBrush="#E3F2FD"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="是否开处方：" />
                <RadioButton Margin="0,0,20,0"
                             Content="开处方"
                             FontSize="12"
                             GroupName="PrescriptionGroup"
                             IsChecked="{Binding NeedsPrescription}" />
                <RadioButton Content="不开处方"
                             FontSize="12"
                             GroupName="PrescriptionGroup"
                             IsChecked="{Binding NoPrescription, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Row 2: 四诊合参（可折叠） -->
        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="10"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <Expander Header="四诊合参（选填）" IsExpanded="False">
                <StackPanel Margin="0,10,0,0">
                    <!-- 望诊 -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="望诊（神色、形体、舌象）" />
                        <TextBox Height="40"
                                 Style="{StaticResource MultiLineTextBoxStyle}"
                                 Text="{Binding Inspection, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- 闻诊 -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="闻诊（语声、呼吸、口气）" />
                        <TextBox Height="40"
                                 Style="{StaticResource MultiLineTextBoxStyle}"
                                 Text="{Binding AuscultationOlfaction, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- 问诊 -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="问诊（主诉、病史等）" />
                        <TextBox Height="40"
                                 Style="{StaticResource MultiLineTextBoxStyle}"
                                 Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- 切诊 -->
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="切诊（脉象、腹诊）" />
                        <TextBox Height="40"
                                 Style="{StaticResource MultiLineTextBoxStyle}"
                                 Text="{Binding Palpation, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </Border>

        <!-- Row 3: 备注 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="备注" />
            <TextBox Height="40"
                     Style="{StaticResource MultiLineTextBoxStyle}"
                     Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- Row 4: 操作按钮 -->
        <StackPanel Grid.Row="4"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Background="#2196F3"
                    Command="{Binding SaveDraftCommand}"
                    Content="保存草稿"
                    Foreground="White"
                    Style="{StaticResource ActionButtonStyle}" />
            <Button Background="#4CAF50"
                    Command="{Binding ConfirmConsultationCommand}"
                    Content="确认诊断"
                    Foreground="White"
                    Style="{StaticResource ActionButtonStyle}"
                    ToolTip="确认诊断后启用处方面板" />
        </StackPanel>
    </Grid>
</UserControl>
