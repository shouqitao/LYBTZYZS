<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.ConsultationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="False">

    <!--
    Epic #2210 Phase 4: 诊断面板UserControl
    OpenSpec: refactor-medicalcase-ui - UI重构版本
    用于MedicalCaseWorkspaceView的左侧40%区域

    设计变更:
    - 移除多余边框，使用留白分隔
    - 操作按钮固定在面板底部
    - 应用统一样式资源
    -->

    <!-- OpenSpec: cleanup-ui-layer - 使用全局样式系统，移除MedicalCaseStyles.xaml引用 -->

    <!--
    OpenSpec: refactor-medicalcase-ui
    移除底部"保存草稿/确认诊断"按钮 - 功能已整合到底部操作栏
    - "保存草稿" → 底部"暂停看诊"
    - "确认诊断" → 在4:6统一界面中不需要，处方面板始终可见
    -->

    <!--
    OpenSpec: refactor-medicalcase-ui
    单列布局，输入框铺满可用空间
    顺序: 主诉 → 现病史 → 四诊 → 中医诊断 → 治疗原则
    -->
    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- 主诉 -->
            <RowDefinition Height="*"/>     <!-- 现病史 -->
            <RowDefinition Height="Auto"/>  <!-- 四诊合参 -->
            <RowDefinition Height="*"/>     <!-- 中医诊断 -->
            <RowDefinition Height="*"/>     <!-- 治疗原则 -->
            <RowDefinition Height="Auto"/>  <!-- 处方选项 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 主诉（必填） -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="主诉" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                <TextBlock Style="{StaticResource RequiredMarkStyle}" />
            </StackPanel>
            <TextBox Grid.Row="1"
                     Style="{StaticResource FormTextAreaStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Row 1: 现病史 -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="现病史" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
            <TextBox Grid.Row="1"
                     Style="{StaticResource FormTextAreaStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Row 2: 四诊合参（两行两列布局，多行文本） -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 望诊 -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="望诊" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                <TextBox Grid.Row="1"
                         Style="{StaticResource FormTextAreaStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Inspection, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- 闻诊 -->
            <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="闻诊" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                <TextBox Grid.Row="1"
                         Style="{StaticResource FormTextAreaStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding AuscultationOlfaction, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- 问诊 -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="问诊" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                <TextBox Grid.Row="1"
                         Style="{StaticResource FormTextAreaStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- 切诊 -->
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="切诊" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
                <TextBox Grid.Row="1"
                         Style="{StaticResource FormTextAreaStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Palpation, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>

        <!-- Row 3: 中医诊断（必填） -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="中医诊断" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                <TextBlock Style="{StaticResource RequiredMarkStyle}" />
            </StackPanel>
            <TextBox Grid.Row="1"
                     Style="{StaticResource FormTextAreaStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Row 4: 治疗原则 -->
        <Grid Grid.Row="4" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="治疗原则" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2" />
            <TextBox Grid.Row="1"
                     Style="{StaticResource FormTextAreaStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Row 5: 处方选项 -->
        <Border Grid.Row="5"
                Background="{StaticResource BackgroundBrush}"
                CornerRadius="4"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="是否开处方："
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <RadioButton Content="开处方"
                             FontSize="13"
                             GroupName="PrescriptionGroup"
                             IsChecked="{Binding NeedsPrescription}"
                             Margin="0,0,24,0"
                             VerticalAlignment="Center" />
                <RadioButton Content="不开处方"
                             FontSize="13"
                             GroupName="PrescriptionGroup"
                             IsChecked="{Binding NoPrescription, Mode=OneWay}"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!--
        OpenSpec: refactor-medicalcase-ui
        [已过时] 备注字段 - 诊断面板不需要，备注应属于医案(MedicalCase)层级
        -->
    </Grid>
</UserControl>
