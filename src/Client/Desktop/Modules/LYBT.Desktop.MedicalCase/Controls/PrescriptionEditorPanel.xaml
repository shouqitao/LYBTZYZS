<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.PrescriptionEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sharedControls="clr-namespace:LYBT.Desktop.Presentation.Components;assembly=LYBT.Desktop.Presentation"
             prism:ViewModelLocator.AutoWireViewModel="False">

    <!--
    Epic #2210 Phase 4: 处方面板UserControl
    OpenSpec: refactor-medicalcase-ui - UI重构版本
    用于MedicalCaseWorkspaceView的右侧60%区域

    设计变更:
    - 保留顶部快速导入按钮
    - 移除中间操作按钮行（添加行/保存草稿/删除处方）
    - 移除重复的治法方案/治疗原则字段（诊断区已有）
    - 优化药材卡片区视觉间距
    - 底部价格信息区使用卡片样式
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Presentation;component/Theming/MedicalCaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- Row 0: 药材卡片区域 -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 重复药材警告 -->
            <RowDefinition Height="Auto"/> <!-- Row 2: 处方信息（价格计算） -->
        </Grid.RowDefinitions>

        <!-- Row 0: 药材卡片区域 -->
        <Grid Grid.Row="0" Margin="12,8,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 统计信息 + 操作提示 -->
                <RowDefinition Height="*"/>    <!-- 卡片列表 -->
            </Grid.RowDefinitions>

            <!-- 统计信息与操作提示 -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,4"
                    Margin="0,0,0,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="药材总数："
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ItemCount}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" 味"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="输入药材名或拼音码，Enter选择后自动跳转"
                               FontSize="12"
                               Foreground="{StaticResource TextHintBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 药材卡片列表（Grid固定4列，铺满宽度，紧凑高度） -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding HerbItems}"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- OpenSpec: unify-herb-card-control - 使用共享HerbCardControl -->
                            <sharedControls:HerbCardControl
                                Margin="2"
                                Height="46"
                                ShowPrice="False"
                                IsEditMode="True"
                                DeleteCommand="{Binding DataContext.DeleteHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                DosageCompletedCommand="{Binding DataContext.DosageCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                AddNewRowCommand="{Binding DataContext.AddNewRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Row 1: 重复药材警告 -->
        <Border Grid.Row="1"
                Background="#FFF3E0"
                BorderBrush="#FFB74D"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,6"
                Margin="12,6,12,0"
                Visibility="{Binding DuplicateHerbsWarningVisibility}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="重复药材提示："
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="#F57C00"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DuplicateHerbsWarningText}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 2: 处方信息（价格计算卡片） -->
        <Border Grid.Row="2"
                Background="#F8F9FA"
                CornerRadius="4"
                Padding="12,8"
                Margin="12,8,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 剂数 -->
                <TextBlock Grid.Column="0"
                           Text="剂数："
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding DosageCount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MinHeight="32"
                         Margin="0,0,24,0"/>

                <!-- 用法 -->
                <TextBlock Grid.Column="2"
                           Text="用法："
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="3"
                         Text="{Binding Usage, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MinHeight="32"
                         Margin="0,0,24,0"/>

                <!-- 价格信息 -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <TextBlock Text="单剂："
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="4,0,0,0">
                        <Run Text="￥" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding SingleDosagePrice, Mode=OneWay, StringFormat=F2}"
                             FontWeight="Bold"
                             FontSize="15"
                             Foreground="#4CAF50"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="总计："
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="4,0,0,0">
                        <Run Text="￥" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat=F2}"
                             FontWeight="Bold"
                             FontSize="18"
                             Foreground="{StaticResource PrimaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
