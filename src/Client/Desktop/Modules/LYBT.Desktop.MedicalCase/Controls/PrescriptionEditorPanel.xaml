<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.PrescriptionEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sharedControls="clr-namespace:LYBT.Desktop.Presentation.Components;assembly=LYBT.Desktop.Presentation"
             prism:ViewModelLocator.AutoWireViewModel="False">

    <!--
    Epic #2210 Phase 4: 处方面板UserControl
    用于MedicalCaseWorkspaceView的右侧60%区域
    重构: 复用HerbCardControl和ItemsControl+UniformGrid模式（参考经验方EditFormulaDialog）
    区别: 处方需要计算单剂价格和总价格，经验方不需要
    Issue #2246: 添加验方导入和历史复制功能
    -->

    <UserControl.Resources>
        <!-- 标签样式 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 导入按钮样式 -->
        <Style x:Key="ImportButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2196F3"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Tab切换 -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 治法方案 -->
            <RowDefinition Height="*"/>    <!-- Row 2: HerbCardControl区域 -->
            <RowDefinition Height="Auto"/> <!-- Row 3: 重复药材警告 -->
            <RowDefinition Height="Auto"/> <!-- Row 4: 处方信息（价格计算） -->
        </Grid.RowDefinitions>

        <!-- Row 0: 导入操作按钮（Issue #2246: 验方导入和历史复制弹窗） -->
        <Border Grid.Row="0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,10"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="快速导入："
                           Style="{StaticResource FieldLabelStyle}"
                           FontWeight="Bold"
                           Margin="0,0,15,0"/>
                <Button Content="从验方导入"
                        Command="{Binding OpenFormulaImportDialogCommand}"
                        Style="{StaticResource ImportButtonStyle}"/>
                <Button Content="从历史处方复制"
                        Command="{Binding OpenHistoryCopyDialogCommand}"
                        Style="{StaticResource ImportButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Row 1: 治法方案/治疗原则 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 治法方案 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="治法方案" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding TreatmentMethod, UpdateSourceTrigger=PropertyChanged}"
                         Height="50"
                         Padding="5"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#BDBDBD"
                         BorderThickness="1"
                         FontSize="12" />
            </StackPanel>

            <!-- 治疗原则 -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="治疗原则" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}"
                         Height="50"
                         Padding="5"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#BDBDBD"
                         BorderThickness="1"
                         FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Row 2: 药材卡片区域（复用HerbCardControl） -->
        <Border Grid.Row="2"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Background="White"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 操作按钮 -->
                    <RowDefinition Height="*"/>    <!-- ItemsControl -->
                    <RowDefinition Height="Auto"/> <!-- 统计信息 -->
                </Grid.RowDefinitions>

                <!-- 操作按钮区 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                    <Button Content="添加行"
                            Command="{Binding AddRowCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#4CAF50"
                            Foreground="White"/>
                    <Button Content="保存草稿"
                            Command="{Binding SaveDraftCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#2196F3"
                            Foreground="White"/>
                    <Button Content="删除处方"
                            Command="{Binding DeletePrescriptionCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#D32F2F"
                            Foreground="White"/>
                    <TextBlock Text="输入药材名或拼音码，Enter选择后自动跳转"
                               FontSize="11"
                               Foreground="#999"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                </StackPanel>

                <!-- 药材卡片列表（UniformGrid 4列，参考经验方EditFormulaDialog） -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="8">
                    <ItemsControl ItemsSource="{Binding HerbItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Issue: unify-herb-card-control - 使用共享HerbCardControl，UI不显示价格（打印时显示） -->
                                <sharedControls:HerbCardControl
                                    ShowPrice="False"
                                    IsEditMode="True"
                                    DeleteCommand="{Binding DataContext.DeleteHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    DosageCompletedCommand="{Binding DataContext.DosageCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AddNewRowCommand="{Binding DataContext.AddNewRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 统计信息 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8">
                    <TextBlock Text="药材总数：" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Text="{Binding ItemCount}" FontWeight="Bold" Foreground="#2E86AB" VerticalAlignment="Center"/>
                    <TextBlock Text="味" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 3: 重复药材警告 -->
        <Border Grid.Row="3"
                Background="#FFF3E0"
                BorderBrush="#FFB74D"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8"
                Margin="0,0,0,10"
                Visibility="{Binding DuplicateHerbsWarningVisibility}">
            <StackPanel>
                <TextBlock Text="重复药材提示" FontWeight="Bold" FontSize="12" Foreground="#F57C00"/>
                <TextBlock Text="{Binding DuplicateHerbsWarningText}" FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 4: 处方信息（价格计算 - 这是处方特有的，经验方不需要） -->
        <Border Grid.Row="4"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Background="White"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 剂数 -->
                <TextBlock Grid.Column="0" Text="剂数：" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding DosageCount, UpdateSourceTrigger=PropertyChanged}"
                         Padding="5,3"
                         FontSize="12"
                         Margin="0,0,15,0"/>

                <!-- 用法 -->
                <TextBlock Grid.Column="2" Text="用法：" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Column="3"
                         Text="{Binding Usage, UpdateSourceTrigger=PropertyChanged}"
                         Padding="5,3"
                         FontSize="12"
                         Margin="0,0,15,0"/>

                <!-- 单剂价格（处方特有） -->
                <TextBlock Grid.Column="4" Text="单剂：" Style="{StaticResource FieldLabelStyle}"/>
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="0,0,15,0">
                    <Run Text="￥" FontSize="12"/>
                    <Run Text="{Binding SingleDosagePrice, Mode=OneWay, StringFormat=F2}" FontWeight="Bold" Foreground="#4CAF50" FontSize="13"/>
                </TextBlock>

                <!-- 总价格（处方特有） -->
                <TextBlock Grid.Column="6" Text="总计：" Style="{StaticResource FieldLabelStyle}"/>
                <TextBlock Grid.Column="7" VerticalAlignment="Center">
                    <Run Text="￥" FontSize="12"/>
                    <Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat=F2}" FontWeight="Bold" Foreground="#2E86AB" FontSize="15"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
