<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.PrescriptionEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sharedControls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="False">

    <!--
    Epic #2210 Phase 4: 处方面板UserControl
    OpenSpec: unify-medicalcase-view-edit-pattern - Task 2.4 使用HerbListEditor
    用于MedicalCaseWorkspaceView的右侧60%区域

    设计变更:
    - 使用HerbListEditor控件（4列UniformGrid）
    - 顶部保留统计信息 + 快速导入按钮
    - 底部保留价格信息区（外部于HerbListEditor）
    -->

    <!-- OpenSpec: cleanup-ui-layer - 使用全局样式系统，移除MedicalCaseStyles.xaml引用 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- Row 0: 药材卡片区域 -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 重复药材警告 -->
            <RowDefinition Height="Auto"/> <!-- Row 2: 处方信息（价格计算） -->
        </Grid.RowDefinitions>

        <!-- Row 0: 药材卡片区域 -->
        <Grid Grid.Row="0" Margin="8,4,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 统计信息 + 导入按钮 -->
                <RowDefinition Height="*"/>    <!-- 卡片列表 -->
            </Grid.RowDefinitions>

            <!-- 统计信息与操作提示 -->
            <!-- 注: 导入按钮已在MedicalCaseWorkspaceView处方区标题栏中 -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,2"
                    Margin="0,0,0,4">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="药材总数："
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ItemCount}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" 味"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="输入药材名或拼音码，Enter选择后自动跳转"
                               FontSize="12"
                               Foreground="{StaticResource TextHintBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- OpenSpec: unify-medicalcase-view-edit-pattern - Task 2.4 使用HerbListEditor -->
            <!-- 药材卡片列表 - ScrollViewer仅在内容超出时显示滚动条 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">
                <sharedControls:HerbListEditor
                    HerbItems="{Binding HerbItems}"
                    IsEditMode="True"
                    DeleteHerbCommand="{Binding DeleteHerbCommand}"
                    DosageCompletedCommand="{Binding DosageCompletedCommand}"
                    AddNewRowCommand="{Binding AddNewRowCommand}"
                    VerticalAlignment="Top"/>
            </ScrollViewer>
        </Grid>

        <!-- Row 1: 重复药材警告 -->
        <Border Grid.Row="1"
                Background="{StaticResource WarningLightBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,6"
                Margin="12,6,12,0"
                Visibility="{Binding IsDuplicateHerbsWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="重复药材提示："
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{StaticResource WarningDarkBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DuplicateHerbsWarningText}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 2: 处方信息（价格计算卡片） -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundBrush}"
                CornerRadius="4"
                Padding="8,6"
                Margin="8,4,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 剂数 -->
                <TextBlock Grid.Column="0"
                           Text="剂数："
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding DosageCount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MinHeight="32"
                         Margin="0,0,24,0"/>

                <!-- 用法 -->
                <TextBlock Grid.Column="2"
                           Text="用法："
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="3"
                         Text="{Binding Usage, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MinHeight="32"
                         Margin="0,0,24,0"/>

                <!-- 价格信息 -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <TextBlock Text="单剂："
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="4,0,0,0">
                        <Run Text="￥" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding SingleDosagePrice, Mode=OneWay, StringFormat=F2}"
                             FontWeight="Bold"
                             FontSize="15"
                             Foreground="{StaticResource SuccessBrush}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="总计："
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="4,0,0,0">
                        <Run Text="￥" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat=F2}"
                             FontWeight="Bold"
                             FontSize="18"
                             Foreground="{StaticResource PrimaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
