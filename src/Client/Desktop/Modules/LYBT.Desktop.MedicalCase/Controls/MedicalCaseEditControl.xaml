<!--
    MedicalCaseEditControl - 医案编辑控件
    OpenSpec: refactor-medicalcase-workspace V2
    OpenSpec: refactor-medicalcase-management
    OpenSpec: unify-herb-controls-to-herbs-module

    支持两种显示模式:
    - Full (默认): MasterDetail右侧详情显示，包含信息卡片、诊疗、处方、备注、系统信息
    - Compact: Workspace紧凑型显示，诊断+四诊+处方编辑

    V2布局:
    - 诊断区3行: 现病史 / 舌诊+脉诊 / 中医诊断*
    - 处方区: 工具条 + HerbListControl + 底部信息栏
-->
<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.MedicalCaseEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:herbList="clr-namespace:LYBT.Desktop.Infrastructure.Controls.HerbList;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 本地资源 CompactSectionBorderStyle 保留，仅供此控件使用
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Compact模式区域边框样式 -->
            <Style x:Key="CompactSectionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>

            <!-- 舌诊选项列表 -->
            <x:Array x:Key="TongueDiagnosisOptions" Type="sys:String"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">
                <sys:String>淡红舌</sys:String>
                <sys:String>红舌</sys:String>
                <sys:String>暗红舌</sys:String>
                <sys:String>紫暗舌</sys:String>
                <sys:String>胖大舌</sys:String>
                <sys:String>瘦薄舌</sys:String>
                <sys:String>裂纹舌</sys:String>
                <sys:String>齿痕舌</sys:String>
                <sys:String>薄白苔</sys:String>
                <sys:String>白厚苔</sys:String>
                <sys:String>黄苔</sys:String>
                <sys:String>黄腻苔</sys:String>
            </x:Array>

            <!-- 脉诊选项列表 -->
            <x:Array x:Key="PulseDiagnosisOptions" Type="sys:String"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">
                <sys:String>浮脉</sys:String>
                <sys:String>沉脉</sys:String>
                <sys:String>迟脉</sys:String>
                <sys:String>数脉</sys:String>
                <sys:String>滑脉</sys:String>
                <sys:String>涩脉</sys:String>
                <sys:String>弦脉</sys:String>
                <sys:String>紧脉</sys:String>
                <sys:String>虚脉</sys:String>
                <sys:String>实脉</sys:String>
                <sys:String>弱脉</sys:String>
                <sys:String>细脉</sys:String>
            </x:Array>

            <!-- 中医证型选项列表 -->
            <x:Array x:Key="SyndromeOptions" Type="sys:String"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">
                <sys:String>风寒束表证</sys:String>
                <sys:String>风热犯肺证</sys:String>
                <sys:String>暑湿感冒证</sys:String>
                <sys:String>脾胃虚弱证</sys:String>
                <sys:String>脾胃湿热证</sys:String>
                <sys:String>胃阴不足证</sys:String>
                <sys:String>肝郁气滞证</sys:String>
                <sys:String>肝胆湿热证</sys:String>
                <sys:String>肝阳上亢证</sys:String>
                <sys:String>心脾两虚证</sys:String>
                <sys:String>心肺气虚证</sys:String>
                <sys:String>痰热壅肺证</sys:String>
                <sys:String>肾阴亏虚证</sys:String>
                <sys:String>肾阳不足证</sys:String>
                <sys:String>肾精不足证</sys:String>
            </x:Array>

            <!-- 处方用法选项列表 -->
            <x:Array x:Key="PrescriptionUsageOptions" Type="sys:String"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">
                <sys:String>水煎服</sys:String>
                <sys:String>开水冲服</sys:String>
                <sys:String>研末服</sys:String>
                <sys:String>泡服</sys:String>
            </x:Array>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=Root}">
        <!-- Full模式: MasterDetail布局 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsCompactMode, Converter={x:Static converters:Cvt.InverseBoolToVis}}">
            <StackPanel>
                <!-- ========================================
                     患者信息卡片（只读）- 仅Full模式
                     ======================================== -->
                <controls:InfoCard Title="患者信息" ShowTitle="True">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 患者姓名 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="患者姓名" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatientName}" Style="{DynamicResource DetailValueStyle}" FontWeight="SemiBold"/>

                            <!-- 就诊日期 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="就诊日期" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ConsultationDate, StringFormat=yyyy-MM-dd}" Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 接诊医生 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="接诊医生" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DoctorName, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 状态 -->
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" Style="{DynamicResource DetailLabelStyle}"/>
                            <controls:StatusBadge Grid.Row="1" Grid.Column="3"
                                                  Status="{Binding Status}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,4,0,4"/>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     诊疗信息卡片（可编辑）- Full模式
                     ======================================== -->
                <controls:InfoCard Title="诊疗信息" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：现病史（整行）- OpenSpec: unify-control-data-binding -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="现病史" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBox TabIndex="1" Text="{Binding Consultation.PresentIllness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="80"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第二行：舌诊、脉诊 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="舌诊" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBox TabIndex="2" Text="{Binding Consultation.TongueDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                                <ComboBox Margin="0,4,0,0"
                                          SelectedItem="{Binding Consultation.TongueDiagnosis, Mode=TwoWay}"
                                          ItemsSource="{StaticResource TongueDiagnosisOptions}"
                                          Style="{DynamicResource FilterComboBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="脉诊" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBox TabIndex="3" Text="{Binding Consultation.PulseDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                                <ComboBox Margin="0,4,0,0"
                                          SelectedItem="{Binding Consultation.PulseDiagnosis, Mode=TwoWay}"
                                          ItemsSource="{StaticResource PulseDiagnosisOptions}"
                                          Style="{DynamicResource FilterComboBox}"/>
                            </StackPanel>

                            <!-- 第三行：中医诊断（整行） -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Style="{DynamicResource FormLabelStyle}">
                                    <Run Text="中医诊断"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                                </TextBlock>
                                <TextBox TabIndex="4" Text="{Binding Consultation.TcmDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource ValidatingTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                                <TextBlock Text="{Binding Consultation.ValidationMessage}"
                                           Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                                <ComboBox Margin="0,4,0,0"
                                          SelectedItem="{Binding Consultation.TcmDiagnosis, Mode=TwoWay}"
                                          ItemsSource="{StaticResource SyndromeOptions}"
                                          Style="{DynamicResource FilterComboBox}"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     处方信息卡片（可编辑）- Full模式
                     OpenSpec: unify-control-data-binding
                     ======================================== -->
                <controls:InfoCard Title="{Binding Prescription.ItemCount, StringFormat=处方药材 (共{0}味), Mode=OneWay}" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <!-- 处方统计信息 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="剂数" Style="{DynamicResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Style="{DynamicResource DetailValueStyle}">
                                    <Run Text="{Binding Prescription.DosageCount, Mode=OneWay}"/>
                                    <Run Text="剂"/>
                                </TextBlock>

                                <TextBlock Grid.Column="2" Text="方源" Style="{DynamicResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="3" Text="{Binding FormulaSource, TargetNullValue='无'}"
                                           Style="{DynamicResource DetailValueStyle}"/>
                            </Grid>

                            <!-- 药材编辑 - 使用HerbListControl统一编辑控件 -->
                            <herbList:HerbListControl
                                AllHerbs="{Binding AllHerbs}"
                                HerbItems="{Binding Prescription.Items, Mode=TwoWay}"
                                IsEditMode="True"
                                Columns="4"/>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     备注卡片（可编辑）- Full模式
                     OpenSpec: unify-control-data-binding
                     ======================================== -->
                <controls:InfoCard Title="备注" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <TextBlock Text="备注" Style="{DynamicResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Remark, RelativeSource={RelativeSource AncestorType=local:MedicalCaseEditControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource EditableTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60"
                                     Padding="12,10"/>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     系统信息卡片（只读）- Full模式
                     ======================================== -->
                <controls:InfoCard Title="系统信息" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 创建时间 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="创建时间" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Style="{DynamicResource ValueDisplayStyle}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <!-- 更新时间 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="更新时间" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                           Style="{DynamicResource ValueDisplayStyle}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================
             Compact模式: Workspace布局 (V2布局)
             工具条 + 诊断区3行 + 处方区
             ======================================== -->
        <Grid Visibility="{Binding IsCompactMode, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 患者信息 -->
                <RowDefinition Height="Auto"/>  <!-- 工具条 -->
                <RowDefinition Height="Auto"/>  <!-- 诊断区 -->
                <RowDefinition Height="Auto"/>  <!-- 处方决策 -->
                <RowDefinition Height="*"/>     <!-- 处方区 -->
                <RowDefinition Height="Auto"/>  <!-- 完整性检查 -->
            </Grid.RowDefinitions>

            <!-- 患者信息行 (Compact模式) -->
            <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="患者:" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding PatientName, TargetNullValue='-'}"
                               FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding ConsultationDate, StringFormat=yyyy-MM-dd, TargetNullValue='-'}"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding DoctorName, TargetNullValue='-'}"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,16,0"/>
                </Grid>
            </Border>

            <!-- 右上角工具条 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button TabIndex="5" Content="套验方"
                        Command="{Binding ImportFormulaCommand}"
                        Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0"/>
                <Button TabIndex="6" Content="历史处方"
                        Command="{Binding ImportHistoryCommand}"
                        Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0"/>
                <Button TabIndex="7" Content="清空"
                        Command="{Binding ClearAllCommand}"
                        Style="{DynamicResource LinkButtonStyle}"
                         Foreground="{StaticResource ValidationErrorBrush}"/>
            </StackPanel>

            <!-- 诊断区 - 分为四诊采集与中医辨证 -->
            <StackPanel Grid.Row="2">
                <!-- 四诊采集区 -->
                <Border Style="{StaticResource CompactSectionBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="四诊采集" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        
                        <!-- 现病史 (问) -->
                        <TextBlock Text="现病史 (问)" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox TabIndex="8"
                                 Text="{Binding Consultation.PresentIllness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12" AcceptsReturn="True"/>
                        
                        <!-- 舌诊 (望) + 脉诊 (切) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="舌诊 (望)" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBox TabIndex="9"
                                         Text="{Binding Consultation.TongueDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="36"/>
                                <ComboBox Margin="0,4,0,0"
                                          SelectedItem="{Binding Consultation.TongueDiagnosis, Mode=TwoWay}"
                                          ItemsSource="{StaticResource TongueDiagnosisOptions}"
                                          Style="{DynamicResource FilterComboBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="脉诊 (切)" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBox TabIndex="10"
                                         Text="{Binding Consultation.PulseDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="36"/>
                                <ComboBox Margin="0,4,0,0"
                                          SelectedItem="{Binding Consultation.PulseDiagnosis, Mode=TwoWay}"
                                          ItemsSource="{StaticResource PulseDiagnosisOptions}"
                                          Style="{DynamicResource FilterComboBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 中医辨证区 (必填) -->
                <Border Style="{StaticResource CompactSectionBorderStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource PrimaryTextBrush}">
                            <Run Text="中医辨证"/>
                            <Run Text="*" Foreground="{StaticResource ValidationErrorBrush}"/>
                        </TextBlock>
                        
                        <TextBox TabIndex="11"
                                 Text="{Binding Consultation.TcmDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="36"/>
                        <TextBlock Text="{Binding Consultation.ValidationMessage}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"
                                   Margin="0,4,0,0"/>
                        <ComboBox Margin="0,4,0,0"
                                  SelectedItem="{Binding Consultation.TcmDiagnosis, Mode=TwoWay}"
                                  ItemsSource="{StaticResource SyndromeOptions}"
                                  Style="{DynamicResource FilterComboBox}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 处方决策引导 -->
            <Border Grid.Row="3" Style="{StaticResource CompactSectionBorderStyle}" Margin="0,0,0,12"
                    Background="{DynamicResource SecondaryRegionBrush}">
                <StackPanel>
                    <TextBlock Text="处方决策" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="是否需要开具处方？" Margin="0,0,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="需要处方" GroupName="PrescriptionNeed"
                                     IsChecked="{Binding NeedsPrescription}" Margin="0,0,16,0"/>
                        <RadioButton Content="不需要处方" GroupName="PrescriptionNeed"
                                     IsChecked="{Binding NeedsPrescription, Converter={x:Static converters:InverseBooleanConverter.Instance}}" Margin="0,0,16,0"/>
                        <RadioButton Content="稍后决定" GroupName="PrescriptionNeed" IsEnabled="False" Opacity="0.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 处方区 -->
            <Border Grid.Row="4" Style="{StaticResource CompactSectionBorderStyle}"
                    IsEnabled="{Binding IsPrescriptionEnabled}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>     <!-- 药材列表 -->
                        <RowDefinition Height="Auto"/>  <!-- 底部信息栏 -->
                    </Grid.RowDefinitions>

                    <!-- 药材列表 - OpenSpec: unify-control-data-binding -->
                    <herbList:HerbListControl Grid.Row="0"
                        AllHerbs="{Binding AllHerbs}"
                        HerbItems="{Binding Prescription.Items, Mode=TwoWay}"
                        IsEditMode="True"
                        Columns="4"/>

                    <!-- 底部信息栏 -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource RegionBrush}"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- 药材数 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 剂数 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 用法 -->
                                <ColumnDefinition Width="*"/>     <!-- 总价 -->
                            </Grid.ColumnDefinitions>

                            <!-- 药材数 - OpenSpec: unify-control-data-binding -->
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <Run Text="共"/>
                                <Run Text="{Binding Prescription.ItemCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                <Run Text="味药材"/>
                            </TextBlock>

                            <!-- 剂数 - OpenSpec: unify-control-data-binding -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="剂数:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" TabIndex="12"
                                         Text="{Binding Prescription.DosageCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="28"
                                         Padding="8,4"/>
                                <TextBlock Text="剂" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- 用法 - OpenSpec: unify-control-data-binding -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="用法:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="120" TabIndex="13"
                                          SelectedItem="{Binding Prescription.Usage, Mode=TwoWay}"
                                          ItemsSource="{StaticResource PrescriptionUsageOptions}"
                                          Style="{DynamicResource FilterComboBox}"/>
                            </StackPanel>

                            <!-- 总价 - OpenSpec: unify-control-data-binding -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="单剂价:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,16,0">
                                    <Run Text="¥"/>
                                    <Run Text="{Binding Prescription.SingleDosePrice, StringFormat='{}{0:F2}', Mode=OneWay}"/>
                                </TextBlock>
                                
                                <TextBlock Text="总价:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SuccessBrush}">
                                    <Run Text="¥"/>
                                    <Run Text="{Binding Prescription.TotalPrice, StringFormat='{}{0:F2}', Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Completeness Check Indicator -->
            <Border Grid.Row="5" Style="{StaticResource CompactSectionBorderStyle}" Margin="0,12,0,0"
                    Background="{DynamicResource SecondaryRegionBrush}">
                <StackPanel>
                    <TextBlock Text="完整性检查" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Margin="0,0,4,0">
                            <Run Text="●" Foreground="Green" FontWeight="Bold"/>
