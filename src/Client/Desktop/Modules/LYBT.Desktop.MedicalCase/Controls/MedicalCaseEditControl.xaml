<!--
    MedicalCaseEditControl - 医案编辑控件
    OpenSpec: refactor-medicalcase-workspace V2
    OpenSpec: refactor-medicalcase-management
    OpenSpec: unify-herb-controls-to-herbs-module

    支持两种显示模式:
    - Full (默认): MasterDetail右侧详情显示，包含信息卡片、诊疗、处方、备注、系统信息
    - Compact: Workspace紧凑型显示，诊断+四诊+处方编辑

    V2布局:
    - 诊断区3行: 现病史 / 舌诊+脉诊 / 中医诊断*
    - 处方区: 工具条 + HerbListControl + 底部信息栏
-->
<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.MedicalCaseEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:herbList="clr-namespace:LYBT.Desktop.Infrastructure.Controls.HerbList;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 本地资源 CompactSectionBorderStyle 保留，仅供此控件使用
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Compact模式区域边框样式 -->
            <Style x:Key="CompactSectionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=Root}">
        <!-- Full模式: MasterDetail布局 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsCompactMode, Converter={x:Static converters:Cvt.InverseBoolToVis}}">
            <StackPanel>
                <!-- ========================================
                     患者信息卡片（只读）- 仅Full模式
                     ======================================== -->
                <controls:InfoCard Title="患者信息" ShowTitle="True">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 患者姓名 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="患者姓名" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatientName}" Style="{DynamicResource DetailValueStyle}" FontWeight="SemiBold"/>

                            <!-- 就诊日期 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="就诊日期" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ConsultationDate, StringFormat=yyyy-MM-dd}" Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 接诊医生 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="接诊医生" Style="{DynamicResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DoctorName, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}"/>

                            <!-- 状态 -->
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" Style="{DynamicResource DetailLabelStyle}"/>
                            <controls:StatusBadge Grid.Row="1" Grid.Column="3"
                                                  Status="{Binding Status}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,4,0,4"/>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     诊疗信息卡片（可编辑）- Full模式
                     ======================================== -->
                <controls:InfoCard Title="诊疗信息" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：现病史（整行）- OpenSpec: unify-control-data-binding -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="现病史" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBox TabIndex="1" Text="{Binding Consultation.PresentIllness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="80"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第二行：舌诊、脉诊 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="舌诊" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBox TabIndex="2" Text="{Binding Consultation.TongueDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="脉诊" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBox TabIndex="3" Text="{Binding Consultation.PulseDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第三行：中医诊断（整行） -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="中医诊断" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBox TabIndex="4" Text="{Binding Consultation.TcmDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     处方信息卡片（可编辑）- Full模式
                     OpenSpec: unify-control-data-binding
                     ======================================== -->
                <controls:InfoCard Title="{Binding Prescription.ItemCount, StringFormat=处方药材 (共{0}味), Mode=OneWay}" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <!-- 处方统计信息 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="剂数" Style="{DynamicResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Style="{DynamicResource DetailValueStyle}">
                                    <Run Text="{Binding Prescription.DosageCount, Mode=OneWay}"/>
                                    <Run Text="剂"/>
                                </TextBlock>

                                <TextBlock Grid.Column="2" Text="方源" Style="{DynamicResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="3" Text="{Binding FormulaSource, TargetNullValue='无'}"
                                           Style="{DynamicResource DetailValueStyle}"/>
                            </Grid>

                            <!-- 药材编辑 - 使用HerbListControl统一编辑控件 -->
                            <herbList:HerbListControl
                                AllHerbs="{Binding AllHerbs}"
                                HerbItems="{Binding Prescription.Items, Mode=TwoWay}"
                                IsEditMode="True"
                                Columns="4"/>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     备注卡片（可编辑）- Full模式
                     OpenSpec: unify-control-data-binding
                     ======================================== -->
                <controls:InfoCard Title="备注" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <TextBlock Text="备注" Style="{DynamicResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Prescription.Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource EditableTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60"
                                     Padding="12,10"/>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     系统信息卡片（只读）- Full模式
                     ======================================== -->
                <controls:InfoCard Title="系统信息" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 创建时间 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="创建时间" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Style="{DynamicResource ValueDisplayStyle}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <!-- 更新时间 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="更新时间" Style="{DynamicResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                           Style="{DynamicResource ValueDisplayStyle}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================
             Compact模式: Workspace布局 (V2布局)
             工具条 + 诊断区3行 + 处方区
             ======================================== -->
        <Grid Visibility="{Binding IsCompactMode, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 右上角工具条 -->
                <RowDefinition Height="Auto"/>  <!-- 诊断区 -->
                <RowDefinition Height="*"/>     <!-- 处方区 -->
            </Grid.RowDefinitions>

            <!-- 右上角工具条 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button TabIndex="5" Content="套验方"
                        Command="{Binding ImportFormulaCommand}"
                        Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0"/>
                <Button TabIndex="6" Content="历史处方"
                        Command="{Binding ImportHistoryCommand}"
                        Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0"/>
                <Button TabIndex="7" Content="清空"
                        Command="{Binding ClearAllCommand}"
                        Style="{DynamicResource LinkButtonStyle}"
                         Foreground="{StaticResource ValidationErrorBrush}"/>
            </StackPanel>

            <!-- 诊断区 - OpenSpec: unify-control-data-binding -->
            <Border Grid.Row="1" Style="{StaticResource CompactSectionBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Row1: 现病史 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="现病史" VerticalAlignment="Center" FontWeight="Medium"/>
                        <TextBox Grid.Column="1" TabIndex="8"
                                 Text="{Binding Consultation.PresentIllness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="36"/>
                    </Grid>

                    <!-- Row2: 舌诊 + 脉诊 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="舌诊" VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBox Grid.Column="1" TabIndex="9"
                                     Text="{Binding Consultation.TongueDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource EditableTextBoxStyle}"
                                     MinHeight="36"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="脉诊" VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBox Grid.Column="1" TabIndex="10"
                                     Text="{Binding Consultation.PulseDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource EditableTextBoxStyle}"
                                     MinHeight="36"/>
                        </Grid>
                    </Grid>

                    <!-- Row3: 中医诊断(必填) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="Medium">
                            <Run Text="中医诊断"/><Run Text="*" Foreground="{StaticResource ValidationErrorBrush}"/>
                        </TextBlock>
                        <TextBox Grid.Column="1" TabIndex="11"
                                 Text="{Binding Consultation.TcmDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="36"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 处方区 -->
            <Border Grid.Row="2" Style="{StaticResource CompactSectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>     <!-- 药材列表 -->
                        <RowDefinition Height="Auto"/>  <!-- 底部信息栏 -->
                    </Grid.RowDefinitions>

                    <!-- 药材列表 - OpenSpec: unify-control-data-binding -->
                    <herbList:HerbListControl Grid.Row="0"
                        AllHerbs="{Binding AllHerbs}"
                        HerbItems="{Binding Prescription.Items, Mode=TwoWay}"
                        IsEditMode="True"
                        Columns="4"/>

                    <!-- 底部信息栏 -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource RegionBrush}"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- 药材数 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 剂数 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 用法 -->
                                <ColumnDefinition Width="*"/>     <!-- 总价 -->
                            </Grid.ColumnDefinitions>

                            <!-- 药材数 - OpenSpec: unify-control-data-binding -->
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <Run Text="共"/>
                                <Run Text="{Binding Prescription.ItemCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                <Run Text="味药材"/>
                            </TextBlock>

                            <!-- 剂数 - OpenSpec: unify-control-data-binding -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="剂数:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" TabIndex="12"
                                         Text="{Binding Prescription.DosageCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource EditableTextBoxStyle}"
                                         MinHeight="28"
                                         Padding="8,4"/>
                                <TextBlock Text="剂" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- 用法 - OpenSpec: unify-control-data-binding -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="用法:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="120" TabIndex="13"
                                          SelectedItem="{Binding Prescription.Usage, Mode=TwoWay}"
                                          ItemsSource="{Binding UsageOptions}"
                                          Style="{DynamicResource FilterComboBox}"/>
                            </StackPanel>

                            <!-- 总价 - OpenSpec: unify-control-data-binding -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="总价:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}">
                                    <Run Text="{Binding Prescription.TotalPrice, StringFormat='{}{0:F2}', Mode=OneWay}"/>
                                    <Run Text="元"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
