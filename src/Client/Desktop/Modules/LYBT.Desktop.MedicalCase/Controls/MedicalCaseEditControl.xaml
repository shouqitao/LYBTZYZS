<!--
    MedicalCaseEditControl - 医案编辑控件
    OpenSpec: refactor-medicalcase-workspace V2
    OpenSpec: refactor-medicalcase-management
    OpenSpec: unify-herb-controls-to-herbs-module

    支持两种显示模式:
    - Full (默认): MasterDetail场景，显示患者信息、诊断、处方、备注、系统信息
    - Compact: Workspace场景，仅显示诊断+处方+工具栏

    V2布局:
    - 诊断区3行: 现病史 / 舌诊+脉诊 / 中医诊断*
    - 处方区: 工具栏 + HerbListControl + 底部信息栏
-->
<UserControl x:Class="LYBT.Desktop.MedicalCase.Controls.MedicalCaseEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:herbList="clr-namespace:LYBT.Desktop.Herbs.Controls.HerbList;assembly=LYBT.Desktop.Herbs"
             xmlns:converters="clr-namespace:LYBT.Desktop.MedicalCase.Converters"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- OpenSpec: simplify-workspace-event-architecture - PanelStatus Converters -->
            <converters:PanelStatusToTextConverter x:Key="PanelStatusToText"/>
            <converters:PanelStatusToColorConverter x:Key="PanelStatusToColor"/>

            <!-- Compact模式区域边框样式 -->
            <Style x:Key="CompactSectionBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ElementName=Root}">
        <!-- Full模式: MasterDetail场景 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsCompactMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <!-- ========================================
                     患者信息卡片（只读）- 仅Full模式
                     ======================================== -->
                <controls:InfoCard Title="患者信息" ShowTitle="True">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 患者姓名 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="患者姓名" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatientName}" Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold"/>

                            <!-- 就诊日期 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="就诊日期" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ConsultationDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource DetailValueStyle}"/>

                            <!-- 主治医生 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="主治医生" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DoctorName, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}"/>

                            <!-- 状态 -->
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" Style="{StaticResource DetailLabelStyle}"/>
                            <controls:StatusBadge Grid.Row="1" Grid.Column="3"
                                                  Status="{Binding Status}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,4,0,4"/>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     诊断信息卡片（可编辑）- Full模式
                     ======================================== -->
                <controls:InfoCard Title="诊断信息" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：现病史（跨两列） -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="现病史" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding PresentIllness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="80"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第二行：舌诊、脉诊 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="舌诊" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding TongueDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="脉诊" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding PulseDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第三行：中医诊断（跨两列） -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="中医诊断" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding TcmDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     处方信息卡片（可编辑）- Full模式
                     ======================================== -->
                <controls:InfoCard Title="{Binding HerbCount, StringFormat=处方药材 (共{0}味)}" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <!-- 处方统计信息 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="剂数" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValueStyle}">
                                    <Run Text="{Binding DoseCount, TargetNullValue=0, Mode=OneWay}"/>
                                    <Run Text="剂"/>
                                </TextBlock>

                                <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Grid.Column="3" Text="{Binding FormulaSource, TargetNullValue='无'}"
                                           Style="{StaticResource DetailValueStyle}"/>
                            </Grid>

                            <!-- 药材组成 - 使用HerbListControl统一编辑控件 -->
                            <herbList:HerbListControl
                                AllHerbs="{Binding AllHerbs}"
                                HerbItems="{Binding HerbItems, Mode=TwoWay}"
                                IsEditMode="True"
                                Columns="4"/>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     备注卡片（可编辑）- Full模式
                     ======================================== -->
                <controls:InfoCard Title="备注" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60"
                                     Padding="12,10"/>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- ========================================
                     系统信息卡片（只读）- Full模式
                     ======================================== -->
                <controls:InfoCard Title="系统信息" ShowTitle="True" Margin="0,12,0,0">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 创建时间 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="创建时间" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Style="{StaticResource ValueDisplayStyle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <!-- 更新时间 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="更新时间" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                           Style="{StaticResource ValueDisplayStyle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================
             Compact模式: Workspace场景 (V2布局)
             工具栏 + 诊断区3行 + 处方区
             ======================================== -->
        <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 右上角工具栏 -->
                <RowDefinition Height="Auto"/>  <!-- 诊断区 -->
                <RowDefinition Height="*"/>     <!-- 处方区 -->
            </Grid.RowDefinitions>

            <!-- 右上角工具栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button Content="经验方"
                        Command="{Binding ImportFormulaCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"/>
                <Button Content="历史处方"
                        Command="{Binding ImportHistoryCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"/>
                <Button Content="清空"
                        Command="{Binding ClearAllCommand}"
                        Style="{StaticResource LinkButton}"
                        Foreground="#DC3545"/>
            </StackPanel>

            <!-- 诊断区 -->
            <Border Grid.Row="1" Style="{StaticResource CompactSectionBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Row1: 现病史 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="现病史" VerticalAlignment="Center" FontWeight="Medium"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding PresentIllness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 MinHeight="36"/>
                    </Grid>

                    <!-- Row2: 舌诊 + 脉诊 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="舌诊" VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding TongueDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     MinHeight="36"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="脉诊" VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding PulseDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     MinHeight="36"/>
                        </Grid>
                    </Grid>

                    <!-- Row3: 中医诊断(必填) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="Medium">
                            <Run Text="中医诊断"/><Run Text="*" Foreground="#DC3545"/>
                        </TextBlock>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TcmDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValidatingTextBoxStyle}"
                                 MinHeight="36"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 处方区 -->
            <Border Grid.Row="2" Style="{StaticResource CompactSectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>     <!-- 药材列表 -->
                        <RowDefinition Height="Auto"/>  <!-- 底部信息栏 -->
                    </Grid.RowDefinitions>

                    <!-- 药材列表 -->
                    <herbList:HerbListControl Grid.Row="0"
                        AllHerbs="{Binding AllHerbs}"
                        HerbItems="{Binding HerbItems, Mode=TwoWay}"
                        IsEditMode="True"
                        Columns="4"/>

                    <!-- 底部信息栏 -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- 药材数 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 付数 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 用法 -->
                                <ColumnDefinition Width="*"/>     <!-- 单价 -->
                            </Grid.ColumnDefinitions>

                            <!-- 药材数 -->
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <Run Text="共"/>
                                <Run Text="{Binding HerbCount}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                <Run Text="味药材"/>
                            </TextBlock>

                            <!-- 付数 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="付数:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60"
                                         Text="{Binding DoseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="28"
                                         Padding="8,4"/>
                                <TextBlock Text="付" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- 用法 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="用法:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="120"
                                          SelectedItem="{Binding Usage, Mode=TwoWay}"
                                          ItemsSource="{Binding UsageOptions}"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>

                            <!-- 单价 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="单价:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}">
                                    <Run Text="{Binding TotalPrice, StringFormat='{}{0:F2}'}"/>
                                    <Run Text="元"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
