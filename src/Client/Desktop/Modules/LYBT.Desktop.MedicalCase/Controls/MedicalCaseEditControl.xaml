                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" FontWeight="Medium" Foreground="Green">
                        可以完成看诊
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
