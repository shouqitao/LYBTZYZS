<!--
    MedicalCaseMasterDetailView - 医案Master-Detail视图
    OpenSpec: refactor-medicalcase-management
    
    设计决策：
    - 左侧40%显示医案列表，右侧60%显示详情
    - 工具栏仅有刷新按钮（无新建按钮）
    - 详情区域支持诊断字段编辑（现病史、舌诊、脉诊、中医诊断、备注）
    - 空状态提示选择医案，不显示新建按钮
    - 使用独立的ViewControl和EditControl组件
-->
<UserControl
    x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseMasterDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:local="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- 转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <controls:MasterDetailLayout HasSelection="{Binding HasSelection}">
        <!--
            ========================================
            Master区域: 医案列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  工具栏  -->
                    <RowDefinition Height="Auto" />
                    <!--  搜索  -->
                    <RowDefinition Height="*" />
                    <!--  列表  -->
                    <RowDefinition Height="Auto" />
                    <!--  分页  -->
                </Grid.RowDefinitions>

                <!--  工具栏 - 刷新按钮和批量删除按钮  -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    BatchDeleteCommand="{Binding BatchDeleteCommand}"
                    RefreshCommand="{Binding RefreshCommand}" />

                <!--  搜索框  -->
                <controls:SearchBox
                    Grid.Row="1"
                    Margin="12,8"
                    Placeholder="搜索患者姓名/诊断..."
                    SearchCommand="{Binding SearchCommand}"
                    SearchText="{Binding SearchText, Mode=TwoWay}" />

                <!--  医案列表 - 使用统一DataGrid样式，支持批量选择  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Style="{StaticResource MasterDetailDataGridStyle}">
                    <DataGrid.Columns>
                        <!--  患者姓名  -->
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding PatientName}"
                            Header="患者">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!--  就诊日期  -->
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}"
                            Header="日期">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!--  中医诊断  -->
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Diagnosis}"
                            Header="诊断">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!--  状态 - 使用StatusBadge组件  -->
                        <DataGridTemplateColumn Width="70" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!--  行右键菜单  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding EditCommand}" Header="查看详情" />
                            <Separator />
                            <MenuItem Command="{Binding DeleteCurrentCommand}" Header="删除" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件 - 使用统一样式  -->
                <Border Grid.Row="3" Style="{StaticResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  统计信息  -->
                        <TextBlock Grid.Column="0" Style="{StaticResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共" />
                            <Run FontWeight="Medium" Text="{Binding TotalCount, Mode=OneWay}" />
                            <Run Text="条记录" />
                        </TextBlock>

                        <!--  每页条数选择  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="每页" />
                            <ComboBox
                                Width="60"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding PageSizes}"
                                SelectedItem="{Binding PageSize, Mode=TwoWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="条" />
                        </StackPanel>

                        <!--  分页按钮  -->
                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding FirstPageCommand}"
                                Content="首页"
                                Style="{StaticResource MasterDetailPaginationButtonStyle}" />
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding PreviousPageCommand}"
                                Content="上一页"
                                Style="{StaticResource MasterDetailPaginationButtonStyle}" />
                            <TextBlock Style="{StaticResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding TotalPages, Mode=OneWay}" />
                            </TextBlock>
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding NextPageCommand}"
                                Content="下一页"
                                Style="{StaticResource MasterDetailPaginationButtonStyle}" />
                            <Button
                                Command="{Binding LastPageCommand}"
                                Content="末页"
                                Style="{StaticResource MasterDetailPaginationButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 医案详情
            使用独立的ViewControl和EditControl组件
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  工具栏  -->
                    <RowDefinition Height="*" />
                    <!--  内容  -->
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCurrentCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  详情内容 - 查看模式  -->
                <local:MedicalCaseViewControl
                    Grid.Row="1"
                    Margin="16"
                    Detail="{Binding CurrentDetail}"
                    ShowAuditInfo="True"
                    Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <!--  详情内容 - 编辑模式  -->
                <!--  OpenSpec: unify-herb-list-controls - 统一使用HerbListEditor编辑处方  -->
                <local:MedicalCaseEditControl
                    Grid.Row="1"
                    Margin="16"
                    AddNewRowCommand="{Binding AddNewRowCommand}"
                    ConsultationDate="{Binding CurrentDetail.ConsultationDate}"
                    CreatedAt="{Binding CurrentDetail.CreatedAt}"
                    DeleteHerbCommand="{Binding DeleteHerbCommand}"
                    DoctorName="{Binding CurrentDetail.DoctorName}"
                    DosageCompletedCommand="{Binding DosageCompletedCommand}"
                    DoseCount="{Binding CurrentDetail.DoseCount}"
                    FormulaSource="{Binding CurrentDetail.FormulaSource}"
                    HerbCount="{Binding HerbCount}"
                    HerbItems="{Binding HerbItems}"
                    PatientName="{Binding CurrentDetail.PatientName}"
                    PresentIllness="{Binding CurrentDetail.PresentIllness, Mode=TwoWay}"
                    PulseDiagnosis="{Binding CurrentDetail.PulseDiagnosis, Mode=TwoWay}"
                    Remark="{Binding CurrentDetail.Remark, Mode=TwoWay}"
                    Status="{Binding CurrentDetail.Status}"
                    TCMDiagnosis="{Binding CurrentDetail.TCMDiagnosis, Mode=TwoWay}"
                    TongueDiagnosis="{Binding CurrentDetail.TongueDiagnosis, Mode=TwoWay}"
                    UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="2"
                    IsLoading="{Binding IsLoadingDetail}"
                    LoadingText="加载详情中..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选中医案时显示
            OpenSpec: UI-LAYOUT-011 - 不显示新建按钮
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState Title="请选择医案" Subtitle="从左侧列表中选择一个医案查看详情" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</UserControl>
