<!--
    MedicalCaseMasterDetailView - 医案Master-Detail视图
    包装MedicalCaseMasterDetailControl，供导航使用
    注意：医案不支持新建，新建通过挂号入口创建
-->
<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseMasterDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <controls:MedicalCaseMasterDetailControl DataContext="{Binding}" />
    </Grid>
</UserControl>
