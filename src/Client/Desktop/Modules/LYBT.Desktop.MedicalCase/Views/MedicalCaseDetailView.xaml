<!--
    MedicalCaseDetailView - 医疗案例详情视图
    OpenSpec: extract-detail-controls Task 5.2

    重构说明：
    - 使用 BaseDetailContainer 容器，ShowEditButton=False（无标准编辑模式）
    - 通过 ActionButtons 放置自定义操作按钮（编辑、开始诊疗、打印处方）
    - ViewContent: 使用 MedicalCaseViewControl 预览控件
    - 此页面主要为只读展示，编辑通过独立流程处理
-->
<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:medicalCaseControls="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <views:BaseDetailContainer
        Title="医疗案例详情"
        IsEditMode="False"
        ShowEditButton="False"
        GoBackCommand="{Binding BackCommand}"
        IsLoading="{Binding IsLoading}"
        LoadingMessage="正在加载...">

        <!-- 自定义操作按钮 -->
        <views:BaseDetailContainer.ActionButtons>
            <StackPanel Orientation="Horizontal">
                <!-- 编辑按钮 -->
                <Button Command="{Binding EditCommand}"
                        Style="{StaticResource SuccessButton}"
                        Content="编辑"
                        Padding="20,10"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding MedicalCaseDetail.CanEdit}"/>

                <!-- 开始诊疗按钮 -->
                <Button Command="{Binding StartConsultationCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Content="开始诊疗"
                        Padding="20,10"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>

                <!-- 打印处方按钮 -->
                <Button Command="{Binding PrintPrescriptionCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Content="打印处方"
                        Padding="20,10"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasPrescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 刷新按钮 -->
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Content="刷新"
                        Padding="20,10"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </views:BaseDetailContainer.ActionButtons>

        <!-- ========================================
             查看模式内容 (ViewContent)
             使用 MedicalCaseViewControl 预览控件
             ======================================== -->
        <views:BaseDetailContainer.ViewContent>
            <medicalCaseControls:MedicalCaseViewControl
                MedicalCaseDetail="{Binding MedicalCaseDetail}"
                HasConsultation="{Binding HasConsultation}"
                HasPrescription="{Binding HasPrescription}"/>
        </views:BaseDetailContainer.ViewContent>
    </views:BaseDetailContainer>
</UserControl>
