<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Background="Transparent" BorderThickness="0" Padding="8"
                        Foreground="White"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" VerticalAlignment="Center" FontSize="16" />
                        <TextBlock Text="返回" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="医疗案例详情"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding StartConsultationCommand}"
                            Background="Transparent" BorderThickness="0" Padding="8"
                            Foreground="White"
                            Margin="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🩺" VerticalAlignment="Center" FontSize="16" />
                            <TextBlock Text="开始诊疗" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PrintCommand}"
                            Background="Transparent" BorderThickness="0" Padding="8"
                            Foreground="White"
                            Margin="4">
                        <TextBlock Text="🖨" FontSize="16" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 医疗案例基本信息卡片 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 标题栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="18" FontWeight="Bold">
                                <Run Text="医疗案例：" />
                                <Run Text="{Binding MedicalCaseDetail.CaseNumber}" />
                            </TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Background="{DynamicResource SuccessBrush}"
                                        CornerRadius="3"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Visibility="{Binding HasConsultation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="已诊疗" Foreground="White" FontSize="12" />
                                </Border>
                                
                                <Border Background="{DynamicResource InfoBrush}"
                                        CornerRadius="3"
                                        Padding="8,4"
                                        Visibility="{Binding HasPrescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="已开方" Foreground="White" FontSize="12" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 基本信息 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="患者" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.PatientName}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="医生" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.DoctorName}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="创建时间" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="状态" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.Status}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 备注 -->
                        <StackPanel Grid.Row="2" Margin="0,12,0,0"
                                    Visibility="{Binding MedicalCaseDetail.Remark, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="备注" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding MedicalCaseDetail.Remark}" 
                                       FontSize="14" 
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 诊疗信息 -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                        Visibility="{Binding HasConsultation, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander Header="诊疗信息" IsExpanded="True">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 主诉 -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12"
                                        Visibility="{Binding MedicalCaseDetail.ChiefComplaint, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="主诉" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.ChiefComplaint}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- 现病史 -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,12"
                                        Visibility="{Binding MedicalCaseDetail.PresentIllness, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="现病史" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.PresentIllness}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- 既往史 -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,12"
                                        Visibility="{Binding MedicalCaseDetail.PastHistory, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="既往史" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.PastHistory}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- 诊断 -->
                            <StackPanel Grid.Row="3" Margin="0,0,0,12"
                                        Visibility="{Binding MedicalCaseDetail.Diagnosis, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="诊断" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.Diagnosis}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- 治疗方案 -->
                            <StackPanel Grid.Row="4" Margin="0,0,0,12"
                                        Visibility="{Binding MedicalCaseDetail.TreatmentPlan, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="治疗方案" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.TreatmentPlan}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- 诊疗时间 -->
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" 
                                           Text="诊疗时间：" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding MedicalCaseDetail.ConsultationDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                           FontSize="14" />
                            </Grid>
                        </Grid>
                    </Expander>
                </Border>

                <!-- 处方信息 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                        Visibility="{Binding HasPrescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander Header="处方信息" IsExpanded="True">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 处方基本信息 -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="处方编号" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding MedicalCaseDetail.PrescriptionNumber}" FontSize="14" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="处方类型" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding MedicalCaseDetail.PrescriptionType}" FontSize="14" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                    <TextBlock Text="剂数" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding MedicalCaseDetail.PrescriptionQuantity}" FontSize="14" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="总价" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding MedicalCaseDetail.TotalAmount, StringFormat='￥{0:F2}'}" FontSize="14" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 用法用量 -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,12"
                                        Visibility="{Binding MedicalCaseDetail.PrescriptionUsage, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="用法用量" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding MedicalCaseDetail.PrescriptionUsage}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- 处方明细（如果有） -->
                            <StackPanel Grid.Row="2"
                                        Visibility="{Binding MedicalCaseDetail.PrescriptionItems, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="处方明细" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                
                                <DataGrid ItemsSource="{Binding MedicalCaseDetail.PrescriptionItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="药材名称"
                                                            Binding="{Binding HerbName}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="剂量"
                                                            Binding="{Binding Dosage}"
                                                            Width="80" />
                                        <DataGridTextColumn Header="单位"
                                                            Binding="{Binding Unit}"
                                                            Width="60" />
                                        <DataGridTextColumn Header="单价"
                                                            Binding="{Binding UnitPrice, StringFormat='￥{0:F2}'}"
                                                            Width="80" />
                                        <DataGridTextColumn Header="小计"
                                                            Binding="{Binding SubTotal, StringFormat='￥{0:F2}'}"
                                                            Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>

                <!-- 操作按钮栏 -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding MedicalCaseDetail.UpdatedAt, StringFormat='最后更新：{0:yyyy-MM-dd HH:mm}'}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding RefreshCommand}"
                                    Content="刷新"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,8,0"
                                    Width="80" />

                            <Button Command="{Binding EditCommand}"
                                    Content="编辑"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Width="80"
                                    IsEnabled="{Binding MedicalCaseDetail.CanEdit}" />

                            <Button Command="{Binding PrintPrescriptionCommand}"
                                    Content="打印处方"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Width="100"
                                    Visibility="{Binding HasPrescription, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Button Command="{Binding CloseCommand}"
                                    Content="关闭"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Background="{StaticResource SecondaryBrush}"
                                    Foreground="White"
                                    Margin="8,0,0,0"
                                    Width="80" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <ProgressBar Width="50" Height="50"
                         IsIndeterminate="True"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
