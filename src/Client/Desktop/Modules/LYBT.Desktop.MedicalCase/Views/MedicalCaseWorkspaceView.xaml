<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
    Epic #2210 Phase 4: 4:6统一看诊界面
    设计文档: docs/explanation/architecture/patient-medicalcase-integration/patient-selection-workspace-integration.md
    布局: 左侧40%诊断(Consultation) + 右侧60%处方(Prescription)
    替代: MedicalCaseFlowView (已标记为Deprecated)
    -->

    <UserControl.Resources>
        <!-- 操作按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 面板标题样式 -->
        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>  <!-- Row 0: 患者信息条 -->
            <RowDefinition Height="*"/>   <!-- Row 1: 主内容区 (4:6分栏) -->
            <RowDefinition Height="70"/>  <!-- Row 2: 底部操作栏 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 患者信息条 -->
        <Border Grid.Row="0"
                Background="#E3F2FD"
                BorderBrush="#90CAF9"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 返回按钮 -->
                <Button Grid.Column="0"
                        Command="{Binding BackToPatientSelectionCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontSize="18" Foreground="#2E86AB" VerticalAlignment="Center" />
                        <TextBlock Text=" 返回患者选择" FontSize="14" Foreground="#2E86AB" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 中间: 患者信息 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="看诊中 | 患者：" FontSize="14" Foreground="#333" FontWeight="Bold" />
                    <TextBlock Text="{Binding PatientName}" FontSize="14" Foreground="#2E86AB" FontWeight="Bold" Margin="5,0" />
                    <TextBlock Text="{Binding PatientInfo}" FontSize="13" Foreground="#666" Margin="20,0,0,0" />
                    <TextBlock Text=" | 医案ID：" FontSize="13" Foreground="#666" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding MedicalCaseId, StringFormat={}{0:N}}" FontSize="12" Foreground="#999" />
                </StackPanel>

                <!-- 右侧: 取消看诊按钮 -->
                <Button Grid.Column="2"
                        Content="取消看诊"
                        Command="{Binding CancelConsultationCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#F44336"
                        Foreground="White" />
            </Grid>
        </Border>

        <!-- Row 1: 主内容区 (4:6分栏) -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />  <!-- 左侧40% 诊断 -->
                <ColumnDefinition Width="15" />  <!-- 间隔 -->
                <ColumnDefinition Width="3*" />  <!-- 右侧60% 处方 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧: 诊断面板 (40%) -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0"
                            Background="#F8F9FA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="15,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="诊断录入" Style="{StaticResource PanelTitleStyle}" Margin="0" />
                            <TextBlock Text=" (Consultation)" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 诊断内容区 -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <controls:ConsultationPanel
                            DataContext="{Binding ConsultationPanelViewModel}"
                            Margin="15" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧: 处方面板 (60%) -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0"
                            Background="#F8F9FA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="15,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="处方编辑" Style="{StaticResource PanelTitleStyle}" Margin="0" />
                            <TextBlock Text=" (Prescription)" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="5,0,0,0" />
                            <!-- 处方状态指示 -->
                            <Border Background="{Binding PrescriptionStatusBackground}"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    Margin="15,0,0,0"
                                    Visibility="{Binding ShowPrescriptionStatus, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PrescriptionStatusText}"
                                           FontSize="12"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 处方内容区 -->
                    <controls:PrescriptionEditorPanel
                        Grid.Row="1"
                        DataContext="{Binding PrescriptionPanelViewModel}"
                        IsEnabled="{Binding DataContext.IsPrescriptionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: 底部操作栏 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 暂停看诊 -->
                <Button Grid.Column="0"
                        Content="暂停看诊"
                        Command="{Binding SaveDraftCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#FF9800"
                        Foreground="White"
                        ToolTip="保存当前进度，稍后继续" />

                <!-- 中间: 状态提示 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="诊断状态: " FontSize="13" Foreground="#666" />
                    <TextBlock Text="{Binding ConsultationStatusText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{Binding ConsultationStatusColor}" />
                    <TextBlock Text=" | 处方状态: " FontSize="13" Foreground="#666" Margin="20,0,0,0" />
                    <TextBlock Text="{Binding PrescriptionStatusSummary}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{Binding PrescriptionStatusSummaryColor}" />
                </StackPanel>

                <!-- 右侧: 主要操作按钮 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- 打印处方笺 -->
                    <Button Content="打印处方笺"
                            Command="{Binding PrintPrescriptionCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#2196F3"
                            Foreground="White"
                            IsEnabled="{Binding CanPrintPrescription}"
                            ToolTip="打印当前处方" />

                    <!-- 完成看诊 -->
                    <Button Content="完成看诊"
                            Command="{Binding CompleteConsultationCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#4CAF50"
                            Foreground="White"
                            IsEnabled="{Binding CanComplete}"
                            ToolTip="完成本次看诊，关闭医案" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
