<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
    Epic #2210 Phase 4: 5:5统一看诊界面
    设计文档: docs/explanation/architecture/patient-medicalcase-integration/patient-selection-workspace-integration.md
    布局: 左侧50%诊断(Consultation) + 右侧50%处方(Prescription)
    替代: MedicalCaseFlowView (已标记为Deprecated)
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- OpenSpec: refactor-medicalcase-ui - 引用共享样式资源 -->
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Presentation;component/Theming/MedicalCaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- BooleanToVisibilityConverter -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- 兼容性：保留ActionButtonStyle引用，使用新的基础样式 -->
            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MedicalCaseButtonBaseStyle}">
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="Margin" Value="5,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>  <!-- Row 0: 患者信息条 -->
            <RowDefinition Height="*"/>   <!-- Row 1: 主内容区 (4:6分栏) -->
            <RowDefinition Height="64"/>  <!-- Row 2: 底部操作栏 (OpenSpec: 64px) -->
        </Grid.RowDefinitions>

        <!-- Row 0: 患者信息条 (OpenSpec: refactor-medicalcase-ui) -->
        <Border Grid.Row="0"
                Style="{StaticResource InfoBarStyle}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 返回按钮 -->
                <Button Grid.Column="0"
                        Command="{Binding BackToPatientSelectionCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontSize="18" Foreground="#2E86AB" VerticalAlignment="Center" />
                        <TextBlock Text=" 返回患者选择" FontSize="14" Foreground="#2E86AB" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 中间: 患者信息 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="看诊中 | 患者：" FontSize="14" Foreground="#333" FontWeight="Bold" />
                    <TextBlock Text="{Binding PatientName}" FontSize="14" Foreground="#2E86AB" FontWeight="Bold" Margin="5,0" />
                    <TextBlock Text="{Binding PatientInfo}" FontSize="13" Foreground="#666" Margin="20,0,0,0" />
                    <TextBlock Text=" | 医案ID：" FontSize="13" Foreground="#666" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding MedicalCaseId, StringFormat={}{0:N}}" FontSize="12" Foreground="#999" />
                </StackPanel>

                <!-- 右侧: 取消看诊按钮 (保持此位置防止误点) -->
                <Button Grid.Column="2"
                        Content="取消看诊"
                        Command="{Binding CancelConsultationCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTip="放弃本次看诊" />
            </Grid>
        </Border>

        <!-- Row 1: 主内容区 (5:5分栏) (OpenSpec: refactor-medicalcase-ui) -->
        <Grid Grid.Row="1" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />   <!-- 左侧50% 诊断 -->
                <ColumnDefinition Width="16" />  <!-- 间隔 (OpenSpec: 16px) -->
                <ColumnDefinition Width="*" />   <!-- 右侧50% 处方 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧: 诊断面板 (50%) -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0"
                            Style="{StaticResource PanelHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="诊断录入" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text=" (Consultation)"
                                       Style="{StaticResource HintTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 诊断内容区 -->
                    <controls:ConsultationPanel
                        Grid.Row="1"
                        DataContext="{Binding ConsultationPanelViewModel}"
                        Margin="12,8" />
                </Grid>
            </Border>

            <!-- 右侧: 处方面板 (50%) -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0"
                            Style="{StaticResource PanelHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="处方编辑" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text=" (Prescription)"
                                       Style="{StaticResource HintTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <!-- 处方状态指示 -->
                            <Border Background="{Binding PrescriptionStatusBackground}"
                                    CornerRadius="12"
                                    Padding="12,4"
                                    Margin="16,0,0,0"
                                    Visibility="{Binding ShowPrescriptionStatus, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PrescriptionStatusText}"
                                           FontSize="12"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 处方内容区 -->
                    <controls:PrescriptionEditorPanel
                        Grid.Row="1"
                        DataContext="{Binding PrescriptionPanelViewModel}"
                        IsEnabled="{Binding DataContext.IsPrescriptionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: 底部操作栏 (OpenSpec: refactor-medicalcase-ui) -->
        <Border Grid.Row="2"
                Style="{StaticResource ActionBarStyle}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 简化状态指示器 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <!-- 诊断状态 -->
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding ConsultationStatusColor}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ConsultationStatusText}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0" />
                    <!-- 处方状态 -->
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding PrescriptionStatusSummaryColor}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                    <TextBlock Text="{Binding PrescriptionStatusSummary}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右侧: 操作按钮 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- 暂停看诊 -->
                    <Button Content="暂停看诊"
                            Command="{Binding SaveDraftCommand}"
                            Style="{StaticResource WarningButtonStyle}"
                            ToolTip="保存当前进度，稍后继续"
                            Margin="0,0,8,0" />

                    <!-- 打印处方笺 -->
                    <Button Content="打印处方笺"
                            Command="{Binding PrintPrescriptionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanPrintPrescription}"
                            ToolTip="打印当前处方"
                            Margin="0,0,8,0" />

                    <!-- 完成看诊 -->
                    <Button Content="完成看诊"
                            Command="{Binding CompleteConsultationCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanComplete}"
                            ToolTip="完成本次看诊，关闭医案" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
