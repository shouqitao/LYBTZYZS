<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
    Epic #2210 Phase 4: 5:5统一看诊界面
    设计文档: docs/explanation/architecture/patient-medicalcase-integration/patient-selection-workspace-integration.md
    布局: 左侧50%诊断(Consultation) + 右侧50%处方(Prescription)
    替代: MedicalCaseFlowView (已标记为Deprecated)
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- OpenSpec: refactor-medicalcase-ui - 引用共享样式资源 -->
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Presentation;component/Theming/MedicalCaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- BooleanToVisibilityConverter -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- 兼容性：保留ActionButtonStyle引用，使用新的基础样式 -->
            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MedicalCaseButtonBaseStyle}">
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="Margin" Value="5,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>  <!-- Row 0: 患者信息条 -->
            <RowDefinition Height="*"/>   <!-- Row 1: 主内容区 (4:6分栏) -->
            <RowDefinition Height="64"/>  <!-- Row 2: 底部操作栏 (OpenSpec: 64px) -->
        </Grid.RowDefinitions>

        <!-- Row 0: 患者信息条 (OpenSpec: refactor-medicalcase-ui) -->
        <Border Grid.Row="0"
                Style="{StaticResource InfoBarStyle}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 返回按钮 -->
                <Button Grid.Column="0"
                        Command="{Binding BackToPatientSelectionCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontSize="18" Foreground="#2E86AB" VerticalAlignment="Center" />
                        <TextBlock Text=" 返回患者选择" FontSize="14" Foreground="#2E86AB" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 中间: 患者信息 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="看诊中 | 患者：" FontSize="14" Foreground="#333" FontWeight="Bold" />
                    <TextBlock Text="{Binding PatientName}" FontSize="14" Foreground="#2E86AB" FontWeight="Bold" Margin="5,0" />
                    <TextBlock Text="{Binding PatientInfo}" FontSize="13" Foreground="#666" Margin="20,0,0,0" />
                    <TextBlock Text=" | 医案ID：" FontSize="13" Foreground="#666" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding MedicalCaseId, StringFormat={}{0:N}}" FontSize="12" Foreground="#999" />
                </StackPanel>

                <!-- 右侧: 取消看诊按钮 (保持此位置防止误点) -->
                <!-- OpenSpec LIFECYCLE-004: 明确的Tooltip说明 -->
                <Button Grid.Column="2"
                        Content="取消看诊"
                        Command="{Binding CancelConsultationCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        FontSize="12"
                        Padding="12,4"
                        Margin="0,8"
                        VerticalAlignment="Center"
                        ToolTip="作废本次就诊。数据保留供审计查看，但无法继续编辑。" />
            </Grid>
        </Border>

        <!-- Row 1: 主内容区 (5:5分栏) (OpenSpec: refactor-medicalcase-ui) -->
        <Grid Grid.Row="1" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />   <!-- 左侧50% 诊断 -->
                <ColumnDefinition Width="16" />  <!-- 间隔 (OpenSpec: 16px) -->
                <ColumnDefinition Width="*" />   <!-- 右侧50% 处方 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧: 诊断面板 (50%) -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0"
                            Style="{StaticResource PanelHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="诊断录入" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text=" (Consultation)"
                                       Style="{StaticResource HintTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 诊断内容区 -->
                    <controls:ConsultationPanel
                        Grid.Row="1"
                        DataContext="{Binding ConsultationPanelViewModel}"
                        Margin="12,8" />
                </Grid>
            </Border>

            <!-- 右侧: 处方面板 (50%) -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0"
                            Style="{StaticResource PanelHeaderStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="处方编辑" Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="(Prescription)"
                                           Style="{StaticResource HintTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <!-- 查询按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="经验方查询"
                                        Command="{Binding PrescriptionPanelViewModel.OpenFormulaImportDialogCommand}"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="历史处方查询"
                                        Command="{Binding PrescriptionPanelViewModel.OpenHistoryCopyDialogCommand}"
                                        Style="{StaticResource OutlineButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 处方内容区 -->
                    <controls:PrescriptionEditorPanel
                        Grid.Row="1"
                        DataContext="{Binding PrescriptionPanelViewModel}"
                        IsEnabled="{Binding DataContext.IsPrescriptionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: 底部操作栏 (OpenSpec: refactor-medicalcase-ui) -->
        <!--
        布局优化参考: SAP Fiori Footer Toolbar / Carbon Design System
        - Fluid输入框自适应填充可用空间
        - 按钮层级: 次要(左) → 主要(右)
        - 三区布局: 标签 | 输入框(stretch) | 操作按钮
        -->
        <Border Grid.Row="2"
                Style="{StaticResource ActionBarStyle}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- 标签 -->
                    <ColumnDefinition Width="*" />     <!-- 备注输入框(自适应) -->
                    <ColumnDefinition Width="24" />    <!-- 间隔 -->
                    <ColumnDefinition Width="Auto" />  <!-- 操作按钮 -->
                </Grid.ColumnDefinitions>

                <!-- 备注标签 -->
                <TextBlock Grid.Column="0"
                           Text="备注："
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- 备注输入框（Fluid - 自适应宽度） -->
                <TextBox Grid.Column="1"
                         Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MinHeight="36"
                         MaxLength="500"
                         ToolTip="医案备注信息（最多500字）"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Stretch" />

                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- 暂停看诊 (OpenSpec LIFECYCLE-004: 明确的Tooltip说明) -->
                    <Button Content="暂停看诊"
                            Command="{Binding SaveDraftCommand}"
                            Style="{StaticResource WarningButtonStyle}"
                            ToolTip="保存当前进度并暂时离开。下次选择该患者时可继续看诊。"
                            Margin="0,0,8,0" />

                    <!-- 打印处方笺 -->
                    <Button Content="打印处方笺"
                            Command="{Binding PrintPrescriptionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanPrintPrescription}"
                            ToolTip="打印当前处方"
                            Margin="0,0,8,0" />

                    <!-- 完成看诊 -->
                    <Button Content="完成看诊"
                            Command="{Binding CompleteConsultationCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanComplete}"
                            ToolTip="完成本次看诊，关闭医案" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
