<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
    Epic #2210 Phase 4: 5:5统一看诊界面
    设计文档: docs/explanation/architecture/patient-medicalcase-integration/patient-selection-workspace-integration.md
    布局: 左侧50%诊断(Consultation) + 右侧50%处方(Prescription)
    替代: MedicalCaseFlowView (已标记为Deprecated)
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- BooleanToVisibilityConverter -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- OpenSpec: cleanup-ui-layer - 使用全局样式系统，移除MedicalCaseStyles.xaml引用 -->
            <!-- ActionButtonStyle基于全局SuccessButton样式 -->
            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="Margin" Value="5,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>  <!-- Row 0: 患者信息条 -->
            <RowDefinition Height="*"/>   <!-- Row 1: 主内容区 (4:6分栏) -->
            <RowDefinition Height="64"/>  <!-- Row 2: 底部操作栏 (OpenSpec: 64px) -->
        </Grid.RowDefinitions>

        <!-- Row 0: 患者信息条 (OpenSpec: refactor-medicalcase-ui) -->
        <Border Grid.Row="0"
                Style="{StaticResource InfoBarStyle}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 返回按钮 (OpenSpec: refine-medicalcase-edit-modes - 动态文案) -->
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontSize="18" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BackButtonText, StringFormat=' {0}'}" FontSize="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 中间: 患者信息 (OpenSpec: refine-medicalcase-edit-modes - 动态标题) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                    <TextBlock Text=" | 患者：" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                    <TextBlock Text="{Binding PatientName}" FontSize="14" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Margin="5,0" />
                    <TextBlock Text="{Binding PatientInfo}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,0" />
                    <TextBlock Text=" | 医案ID：" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding MedicalCaseId, StringFormat={}{0:N}}" FontSize="12" Foreground="{StaticResource TextHintBrush}" />
                </StackPanel>

                <!-- OpenSpec: clarify-cancel-consultation-logic - 取消按钮已移除 -->
                <!-- 取消操作集成到返回/退出流程的离开确认对话框中 -->

                <!-- OpenSpec: medicalcase-management-ui-refactor TASK-001 - 右上角编辑医案按钮(Management只读模式) -->
                <Button Grid.Column="2"
                        Content="编辑医案"
                        Command="{Binding EnterEditModeCommand}"
                        Style="{StaticResource SuccessButtonStyle}"
                        ToolTip="进入编辑模式，可修改诊断和处方内容"
                        Visibility="{Binding ShowEditButtonTopRight, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="16,8"
                        Margin="0,0,10,0" />
            </Grid>
        </Border>

        <!-- Row 1: 主内容区 (5:5分栏) (OpenSpec: refactor-medicalcase-ui) -->
        <Grid Grid.Row="1" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />   <!-- 左侧50% 诊断 -->
                <ColumnDefinition Width="16" />  <!-- 间隔 (OpenSpec: 16px) -->
                <ColumnDefinition Width="*" />   <!-- 右侧50% 处方 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧: 诊断面板 (50%) -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0"
                            Style="{StaticResource PanelHeaderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="诊断录入" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text=" (Consultation)"
                                       Style="{StaticResource HintTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 诊断内容区 -->
                    <controls:ConsultationPanel
                        Grid.Row="1"
                        DataContext="{Binding ConsultationPanelViewModel}"
                        Margin="12,8" />
                </Grid>
            </Border>

            <!-- 右侧: 处方面板 (50%) -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0"
                            Style="{StaticResource PanelHeaderStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="处方编辑" Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="(Prescription)"
                                           Style="{StaticResource HintTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <!-- 查询按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="经验方查询"
                                        Command="{Binding PrescriptionPanelViewModel.OpenFormulaImportDialogCommand}"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="历史处方查询"
                                        Command="{Binding PrescriptionPanelViewModel.OpenHistoryCopyDialogCommand}"
                                        Style="{StaticResource OutlineButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 处方内容区 -->
                    <controls:PrescriptionEditorPanel
                        Grid.Row="1"
                        DataContext="{Binding PrescriptionPanelViewModel}"
                        IsEnabled="{Binding DataContext.IsPrescriptionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: 底部操作栏 (OpenSpec: refactor-medicalcase-ui, refactor-medicalcase-management) -->
        <!--
        布局优化参考: SAP Fiori Footer Toolbar / Carbon Design System
        - Fluid输入框自适应填充可用空间
        - 按钮层级: 次要(左) → 主要(右)
        - 四区布局: 备注 | 修改原因(历史模式) | 操作按钮

        refactor-medicalcase-management: 新增按钮状态机
        - 编辑模式: [保存] [暂停看诊] [打印] [完成看诊]
        - 只读模式: [编辑] (有权限时)
        -->
        <Border Grid.Row="2"
                Style="{StaticResource ActionBarStyle}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- 备注标签 -->
                    <ColumnDefinition Width="*" />     <!-- 备注输入框(自适应) -->
                    <ColumnDefinition Width="Auto" />  <!-- 修改原因区域(历史模式) -->
                    <ColumnDefinition Width="24" />    <!-- 间隔 -->
                    <ColumnDefinition Width="Auto" />  <!-- 操作按钮 -->
                </Grid.ColumnDefinitions>

                <!-- 备注标签 -->
                <TextBlock Grid.Column="0"
                           Text="备注："
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <!-- 备注输入框（Fluid - 自适应宽度） -->
                <TextBox Grid.Column="1"
                         Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}"
                         MinHeight="36"
                         MaxLength="500"
                         ToolTip="医案备注信息（最多500字）"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Stretch"
                         IsReadOnly="{Binding IsReadOnly}" />

                <!-- refactor-medicalcase-management: 修改原因输入区域（历史修改模式显示） -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsHistoricalEditMode, Converter={StaticResource BoolToVisibility}}"
                            Margin="16,0,0,0">
                    <TextBlock Text="修改原因："
                               FontSize="13"
                               Foreground="{StaticResource WarningBrush}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Text="{Binding EditReason, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Width="200"
                             MinHeight="36"
                             MaxLength="200"
                             ToolTip="请输入修改原因（必填）"
                             VerticalAlignment="Center" />
                </StackPanel>

                <!-- 操作按钮组 (OpenSpec: medicalcase-management-ui-refactor TASK-002) -->
                <!--
                按钮可见性规则:
                  Management 只读: [打印处方笺]
                  Management 编辑: [打印处方笺] [保存医案]
                  Clinical   只读: [修改医案] [打印处方笺]
                  Clinical   编辑: [暂存医案] [打印处方笺] [完成看诊]
                -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Clinical只读模式: 修改医案按钮 -->
                    <Button Content="修改医案"
                            Command="{Binding EnterEditModeCommand}"
                            Style="{StaticResource SuccessButtonStyle}"
                            ToolTip="进入编辑模式，可修改诊断和处方内容"
                            Visibility="{Binding ShowEditButton, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,8,0" />

                    <!-- Clinical编辑模式: 暂存医案按钮 -->
                    <Button Content="暂存医案"
                            Command="{Binding SaveAndStayCommand}"
                            Style="{StaticResource WarningButtonStyle}"
                            ToolTip="保存当前进度，可随时点击'修改医案'继续编辑"
                            Visibility="{Binding ShowDraftButton, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,8,0" />

                    <!-- 所有模式: 打印处方笺按钮 -->
                    <Button Content="打印处方笺"
                            Command="{Binding PrintPrescriptionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanPrintPrescription}"
                            ToolTip="打印当前处方"
                            Margin="0,0,8,0" />

                    <!-- Clinical编辑模式: 完成看诊按钮 (绿色-完成确认操作) -->
                    <Button Content="完成看诊"
                            Command="{Binding CompleteConsultationCommand}"
                            Style="{StaticResource SuccessButtonStyle}"
                            IsEnabled="{Binding CanComplete}"
                            ToolTip="完成本次看诊，关闭医案"
                            Visibility="{Binding ShowCompleteButton, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Management编辑模式: 保存医案按钮(绿色-保存确认操作) -->
                    <Button Content="保存医案"
                            Command="{Binding SaveAndStayCommand}"
                            Style="{StaticResource SuccessButtonStyle}"
                            ToolTip="保存修改并留在当前界面"
                            Visibility="{Binding ShowSaveButton, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
