<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.ConsultationFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 标签样式 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <!-- 必填标签样式 -->
        <Style x:Key="RequiredFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 文本框样式 -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题 -->
                <RowDefinition Height="Auto"/> <!-- 基本诊断信息 -->
                <RowDefinition Height="Auto"/> <!-- 四诊合参 -->
                <RowDefinition Height="Auto"/> <!-- 备注 -->
                <RowDefinition Height="Auto"/> <!-- 操作按钮 -->
                <RowDefinition Height="Auto"/> <!-- 提示信息 -->
            </Grid.RowDefinitions>

            <!-- Row 0: 标题 -->
            <TextBlock Grid.Row="0"
                      Text="诊断录入（Consultation）"
                      FontSize="18"
                      FontWeight="Bold"
                      Foreground="#2E86AB"
                      Margin="0,0,0,20"/>

            <!-- Row 1: 基本诊断信息（2列布局） -->
            <Border Grid.Row="1"
                   BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   CornerRadius="5"
                   Background="White"
                   Padding="15"
                   Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="0"
                              Text="基本诊断信息"
                              FontSize="16"
                              FontWeight="Bold"
                              Foreground="#333"
                              Margin="0,0,0,15"/>

                    <!-- 主诉 + 现病史 -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：主诉（必填） -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="主诉" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                <TextBlock Text="（必填）" Foreground="Red" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBox Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource TextBoxStyle}"
                                    Height="60"
                                    Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- 右列：现病史 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="现病史" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource TextBoxStyle}"
                                    Height="60"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 中医诊断 + 治疗原则 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：中医诊断（必填） -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="中医诊断" Style="{StaticResource RequiredFieldLabelStyle}"/>
                                <TextBlock Text="（必填）" Foreground="Red" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBox Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource TextBoxStyle}"
                                    Height="60"
                                    Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- 右列：治疗原则 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="治疗原则" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource TextBoxStyle}"
                                    Height="60"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: 四诊合参（2列布局） -->
            <Border Grid.Row="2"
                   BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   CornerRadius="5"
                   Background="White"
                   Padding="15"
                   Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="0"
                              Text="四诊合参"
                              FontSize="16"
                              FontWeight="Bold"
                              Foreground="#333"
                              Margin="0,0,0,15"/>

                    <!-- 望诊 + 闻诊 -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：望诊 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="望诊（神色、形体、舌象）" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Inspection, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource TextBoxStyle}"
                                    Height="60"
                                    Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- 右列：闻诊 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="闻诊（语声、呼吸、口气）" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding AuscultationOlfaction, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource TextBoxStyle}"
                                    Height="60"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 问诊 + 切诊 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：问诊 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="问诊（主诉、病史等）" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource TextBoxStyle}"
                                    Height="60"
                                    Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- 右列：切诊 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="切诊（脉象、腹诊）" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Palpation, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource TextBoxStyle}"
                                    Height="60"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 3: 备注 -->
            <Border Grid.Row="3"
                   BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   CornerRadius="5"
                   Background="White"
                   Padding="15"
                   Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="备注" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource TextBoxStyle}"
                            Height="60"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Row 4: 操作按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="从历史导入"
                       Command="{Binding ImportFromHistoryCommand}"
                       Style="{StaticResource ActionButtonStyle}"
                       Background="#2196F3"
                       Foreground="White"
                       BorderThickness="0"/>

                <Button Content="清空表单"
                       Command="{Binding ClearFormCommand}"
                       Style="{StaticResource ActionButtonStyle}"
                       Background="#9E9E9E"
                       Foreground="White"
                       BorderThickness="0"/>
            </StackPanel>

            <!-- Row 5: 提示信息 -->
            <Border Grid.Row="5"
                   Background="#FFF3E0"
                   BorderBrush="#FFB74D"
                   BorderThickness="1"
                   CornerRadius="3"
                   Padding="10">
                <StackPanel>
                    <TextBlock Text="提示：" FontWeight="Bold" FontSize="13" Foreground="#F57C00"/>
                    <TextBlock Text="• 填写完成后点击【下一步】进入处方录入"
                              FontSize="12"
                              Foreground="#666"
                              Margin="0,5,0,0"/>
                    <TextBlock Text="• 保存时将创建Consultation实体并关联到MedicalCase.ConsultationId"
                              FontSize="12"
                              Foreground="#666"
                              Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
