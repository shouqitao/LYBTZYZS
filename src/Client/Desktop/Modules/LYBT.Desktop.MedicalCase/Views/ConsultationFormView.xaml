<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.ConsultationFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
    Epic #1494 - Task #1498: Step 2 - 诊断表单视图
    2列布局：基本诊断信息 + 四诊合参
    全页显示，最大化利用主内容区域
    -->

    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
            <RowDefinition Height="*"/>     <!-- 主内容区（2列） -->
            <RowDefinition Height="Auto"/>  <!-- 备注 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 工具栏 -->
        <Border Grid.Row="0"
                Padding="0,0,0,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="从历史导入"
                        Command="{Binding ImportHistoryCommand}"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="清空表单"
                        Command="{Binding ClearCommand}"
                        Width="100"
                        Height="32"
                        Background="#F44336"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Row 1: 主内容区（2列布局） -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- 左列：基本诊断信息 -->
                <ColumnDefinition Width="20"/>     <!-- 中间间距 -->
                <ColumnDefinition Width="*"/>      <!-- 右列：四诊合参 -->
            </Grid.ColumnDefinitions>

            <!-- 左列：基本诊断信息 -->
            <ScrollViewer Grid.Column="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 主诉（必填） -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="* 主诉（必填）"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                Padding="8"/>
                    </StackPanel>

                    <!-- 现病史 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="现病史"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                Padding="8"/>
                    </StackPanel>

                    <!-- 中医诊断（必填） -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="* 中医诊断（必填）"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                Padding="8"/>
                    </StackPanel>

                    <!-- 治疗原则 -->
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="治疗原则"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                Padding="8"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 右列：四诊合参 -->
            <ScrollViewer Grid.Column="2"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 望诊 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="望诊（神色、形体、舌象等）"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Inspection, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                Padding="8"/>
                    </StackPanel>

                    <!-- 闻诊 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="闻诊（语声、呼吸、咳嗽、口气等）"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  Margin="0,0,0,5"/>
                        <TextBox Text="{Binding AuscultationOlfaction, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                Padding="8"/>
                    </StackPanel>

                    <!-- 问诊 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="问诊（主诉、现病史、既往史等）"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                Padding="8"/>
                    </StackPanel>

                    <!-- 切诊 -->
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="切诊（脉象、腹诊等）"
                                  FontWeight="Bold"
                                  Foreground="#333333"
                                  Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Palpation, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                Padding="8"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Row 2: 备注（全宽） -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="备注"
                      FontWeight="Bold"
                      Foreground="#333333"
                      Margin="0,0,0,5"/>
            <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                    Height="60"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    Padding="8"/>
        </StackPanel>
    </Grid>
</UserControl>
