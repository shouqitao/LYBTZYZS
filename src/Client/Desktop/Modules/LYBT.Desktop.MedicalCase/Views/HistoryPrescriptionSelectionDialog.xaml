<UserControl
    x:Class="LYBT.Desktop.MedicalCase.Views.HistoryPrescriptionSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    Width="800"
    Height="600"
    prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <!--
        Epic #2175 BF-002 Task 3.9: 历史处方选择对话框
        转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters)
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  标题栏  -->
            <RowDefinition Height="*" />
            <!--  列表区  -->
            <RowDefinition Height="Auto" />
            <!--  按钮栏  -->
        </Grid.RowDefinitions>

        <!--  Row 0: 标题栏  -->
        <Border
            Grid.Row="0"
            Padding="20,12"
            Background="#2E86AB">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Text="选择历史处方" />
        </Border>

        <!--  Row 1: 列表区  -->
        <Border
            Grid.Row="1"
            Padding="20"
            Background="White">
            <Grid>
                <!--  加载中提示  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="48"
                        Text="⏳" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="#666"
                        Text="加载中..." />
                </StackPanel>

                <!--  历史处方列表  -->
                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    FontSize="13"
                    GridLinesVisibility="Horizontal"
                    IsReadOnly="True"
                    ItemsSource="{Binding Prescriptions}"
                    RowHeight="40"
                    SelectedItem="{Binding SelectedPrescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="1.5*"
                            Binding="{Binding PrescriptionNumber}"
                            Header="处方编号" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"
                            Header="日期" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Items.Count, StringFormat={}{0} 味}"
                            Header="药材数量" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding DosageCount, StringFormat={}{0} 剂}"
                            Header="剂数" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding TotalPrice, StringFormat=¥{0:F2}}"
                            Header="总价" />
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Indication}"
                            Header="主治" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!--  Row 2: 按钮栏  -->
        <Border
            Grid.Row="2"
            Padding="20,12"
            Background="#F5F5F5">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#666"
                    Text="{Binding Prescriptions.Count, StringFormat=共 {0} 个历史处方}" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="0,0,12,0"
                        Padding="0,10"
                        Background="#4CAF50"
                        Command="{Binding ConfirmCommand}"
                        Content="确定"
                        FontSize="14"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}" />

                    <Button
                        Width="100"
                        Padding="0,10"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        FontSize="14"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
