<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.HistoryPrescriptionSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
             Width="800" Height="600">
    <!--
    Epic #2175 BF-002 Task 3.9: 历史处方选择对话框
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题栏 -->
            <RowDefinition Height="*" />      <!-- 列表区 -->
            <RowDefinition Height="Auto" />   <!-- 按钮栏 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 标题栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="20,12">
            <TextBlock Text="选择历史处方"
                      Foreground="White"
                      FontSize="18"
                      FontWeight="Bold" />
        </Border>

        <!-- Row 1: 列表区 -->
        <Border Grid.Row="1" Background="White" Padding="20">
            <Grid>
                <!-- 加载中提示 -->
                <StackPanel VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="⏳"
                              FontSize="48"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="加载中..."
                              FontSize="14"
                              Foreground="#666"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 历史处方列表 -->
                <DataGrid ItemsSource="{Binding Prescriptions}"
                         SelectedItem="{Binding SelectedPrescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         GridLinesVisibility="Horizontal"
                         RowHeight="40"
                         FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="处方编号"
                                          Binding="{Binding PrescriptionNumber}"
                                          Width="1.5*" />
                        <DataGridTextColumn Header="日期"
                                          Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"
                                          Width="*" />
                        <DataGridTextColumn Header="药材数量"
                                          Binding="{Binding Items.Count, StringFormat={}{0} 味}"
                                          Width="*" />
                        <DataGridTextColumn Header="剂数"
                                          Binding="{Binding DosageCount, StringFormat={}{0} 剂}"
                                          Width="*" />
                        <DataGridTextColumn Header="总价"
                                          Binding="{Binding TotalPrice, StringFormat=¥{0:F2}}"
                                          Width="*" />
                        <DataGridTextColumn Header="主治"
                                          Binding="{Binding Indication}"
                                          Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Row 2: 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,12">
            <Grid>
                <TextBlock Text="{Binding Prescriptions.Count, StringFormat=共 {0} 个历史处方}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Foreground="#666" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定"
                           Command="{Binding ConfirmCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="#4CAF50"
                           Foreground="White"
                           Width="100"
                           Padding="0,10"
                           Margin="0,0,12,0"
                           FontSize="14" />

                    <Button Content="取消"
                           Command="{Binding CancelCommand}"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Width="100"
                           Padding="0,10"
                           FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
