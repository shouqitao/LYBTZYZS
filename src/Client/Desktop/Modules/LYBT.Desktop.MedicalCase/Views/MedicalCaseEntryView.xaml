<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 通用样式 -->
        <Style x:Key="SectionHeaderTextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>

        <Style x:Key="LabelTextBlock" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,10,0"/>
            <Setter Property="Foreground" Value="#666666"/>
        </Style>

        <Style x:Key="SingleLineTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="MultiLineTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Height" Value="80"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 顶部信息栏 -->
            <RowDefinition Height="*"/>    <!-- 主内容区 -->
            <RowDefinition Height="Auto"/> <!-- 底部操作按钮 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 顶部信息栏 -->
        <Border Grid.Row="0"
                Background="#F5F5F5"
                Padding="15"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="当前患者: "
                           FontSize="14"
                           Foreground="#666666"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PatientName}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 1: 主内容区 (四诊数据 + 诊断信息) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20">
            <StackPanel>
                <!-- ========== 四诊数据 ========== -->
                <TextBlock Text="四诊数据" Style="{StaticResource SectionHeaderTextBlock}"/>

                <!-- 望诊 -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="望诊:" Style="{StaticResource LabelTextBlock}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Inspection, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineTextBox}"
                             ToolTip="记录神色、形体、舌象等"/>
                </Grid>

                <!-- 闻诊 -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="闻诊:" Style="{StaticResource LabelTextBlock}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding AuscultationOlfaction, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineTextBox}"
                             ToolTip="记录语声、呼吸、咳嗽、口气、体气等"/>
                </Grid>

                <!-- 问诊 -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="问诊:" Style="{StaticResource LabelTextBlock}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineTextBox}"
                             Height="100"
                             ToolTip="记录主诉、现病史、既往史等"/>
                </Grid>

                <!-- 切诊 -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="切诊:" Style="{StaticResource LabelTextBlock}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Palpation, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineTextBox}"
                             ToolTip="记录脉象、腹诊等"/>
                </Grid>

                <!-- ========== 诊断信息 ========== -->
                <TextBlock Text="诊断信息"
                           Style="{StaticResource SectionHeaderTextBlock}"
                           Margin="0,20,0,10"/>

                <!-- 主诉 (必填) -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="主诉:" Style="{StaticResource LabelTextBlock}"/>
                        <TextBlock Text="*" Foreground="Red" FontSize="14" Margin="2,8,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource SingleLineTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChiefComplaint.Length}" Value="0">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 现病史 -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="现病史:" Style="{StaticResource LabelTextBlock}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineTextBox}"
                             Height="100"/>
                </Grid>

                <!-- 中医诊断 (必填) -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="中医诊断:" Style="{StaticResource LabelTextBlock}"/>
                        <TextBlock Text="*" Foreground="Red" FontSize="14" Margin="2,8,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MultiLineTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TCMDiagnosis.Length}" Value="0">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 治疗原则 -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="治疗原则:" Style="{StaticResource LabelTextBlock}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineTextBox}"/>
                </Grid>

                <!-- 备注 -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="备注:" Style="{StaticResource LabelTextBlock}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MultiLineTextBox}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: 底部操作按钮 -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="15"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导入历史"
                        Command="{Binding ImportHistoryCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#E0E0E0"/>
                <Button Content="清空"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#FFC107"
                        Foreground="White"/>
                <Button Content="保存病案"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#4CAF50"
                        Foreground="White"/>
                <Button Content="开处方"
                        Command="{Binding PrescribeCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#007ACC"
                        Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
