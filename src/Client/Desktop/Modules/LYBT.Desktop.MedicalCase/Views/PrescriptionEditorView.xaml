<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.PrescriptionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 标签样式 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: 标题 -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Step2完成时间提示（新增，Issue #1591） -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Tab切换 -->
                <RowDefinition Height="Auto"/> <!-- Row 3: 治法方案/治疗原则（新增，Issue #1591） -->
                <RowDefinition Height="*"/>    <!-- Row 4: DataGrid -->
                <RowDefinition Height="Auto"/> <!-- Row 5: 重复药材警告（新增，Issue #1591） -->
                <RowDefinition Height="Auto"/> <!-- Row 6: 处方信息 -->
                <RowDefinition Height="Auto"/> <!-- Row 7: 提示信息 -->
            </Grid.RowDefinitions>

            <!-- Row 0: 标题 -->
            <TextBlock Grid.Row="0"
                      Text="处方录入（Prescription）"
                      FontSize="18"
                      FontWeight="Bold"
                      Foreground="#2E86AB"
                      Margin="0,0,0,10"/>

            <!-- Row 1: 步骤完成时间提示（新增，Issue #1591）-->
            <TextBlock Grid.Row="1"
                      Text="{Binding Step2CompletedAtText}"
                      Visibility="{Binding Step2CompletedAtVisibility}"
                      Foreground="Green"
                      FontSize="14"
                      FontWeight="SemiBold"
                      Margin="0,0,0,10" />

            <!-- Row 2: Tab切换（手工录入/验方导入/历史复制） -->
            <Border Grid.Row="2"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,0,0,1"
                   Margin="0,0,0,15">
                <TabControl Height="40" SelectedIndex="0" BorderThickness="0">
                    <TabItem Header="手工录入" FontSize="14">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="手工录入" Padding="10,5"/>
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                    </TabItem>
                    <TabItem Header="验方导入" FontSize="14">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="验方导入" Padding="10,5"/>
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                    </TabItem>
                    <TabItem Header="历史复制" FontSize="14">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="历史复制" Padding="10,5"/>
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Row 3: 治法方案/治疗原则（新增，Issue #1591） -->
            <Border Grid.Row="3"
                   BorderBrush="#E3F2FD"
                   BorderThickness="1"
                   CornerRadius="5"
                   Background="White"
                   Padding="15"
                   Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>  <!-- 间距 -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左列：治法方案 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="治法方案" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding TreatmentMethod, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                Padding="5"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1" />
                    </StackPanel>

                    <!-- 右列：治疗原则 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="治疗原则" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}"
                                Height="60"
                                Padding="5"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 4: 8列DataGrid（核心区域） -->
            <Border Grid.Row="4"
                   BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   CornerRadius="5"
                   Background="White"
                   Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 操作按钮 -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- 统计信息 -->
                    </Grid.RowDefinitions>

                    <!-- 操作按钮区（Issue #1594：新增保存草稿按钮 + Issue #1593：新增删除处方按钮） -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Button Content="添加行"
                               Command="{Binding AddRowCommand}"
                               Style="{StaticResource ActionButtonStyle}"
                               Background="#4CAF50"
                               Foreground="White"
                               BorderThickness="0"
                               Margin="0,0,10,0"/>
                        <!-- Issue #1594: 新增保存草稿按钮 -->
                        <Button Content="保存草稿"
                               Command="{Binding SaveDraftCommand}"
                               Style="{StaticResource ActionButtonStyle}"
                               Background="#2196F3"
                               Foreground="White"
                               BorderThickness="0"
                               Margin="0,0,10,0"/>
                        <!-- Issue #1593 - Phase 4: 新增删除处方按钮 -->
                        <Button Content="删除处方"
                               Command="{Binding DeletePrescriptionCommand}"
                               Style="{StaticResource ActionButtonStyle}"
                               Background="#D32F2F"
                               Foreground="White"
                               BorderThickness="0"/>
                        <TextBlock Text="提示：双击药材列可选择，Tab键切换到用量列"
                                  FontSize="12"
                                  Foreground="#666"
                                  VerticalAlignment="Center"
                                  Margin="20,0,0,0"/>
                    </StackPanel>

                    <!-- DataGrid 8列布局 -->
                    <DataGrid Grid.Row="1"
                             ItemsSource="{Binding ItemRows}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MinHeight="300"
                             MaxHeight="500"
                             Margin="10">
                        <DataGrid.Columns>
                            <!-- 药材1 - Epic #1540: ComboBox + 拼音码过滤 -->
                            <DataGridTemplateColumn Header="药材1" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.FilteredHerbs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 DisplayMemberPath="Name"
                                                 SelectedValue="{Binding Item1.HerbId, UpdateSourceTrigger=PropertyChanged}"
                                                 SelectedValuePath="Id"
                                                 IsEditable="True"
                                                 Text="{Binding Item1.HerbName, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Herb1"
                                                 TextSearch.TextPath="Name"
                                                 Padding="5,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 用量1 -->
                            <DataGridTextColumn Header="用量1" Binding="{Binding Item1.Dosage, UpdateSourceTrigger=PropertyChanged}" Width="60"/>

                            <!-- 药材2 - Epic #1540: ComboBox + 拼音码过滤 -->
                            <DataGridTemplateColumn Header="药材2" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.FilteredHerbs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 DisplayMemberPath="Name"
                                                 SelectedValue="{Binding Item2.HerbId, UpdateSourceTrigger=PropertyChanged}"
                                                 SelectedValuePath="Id"
                                                 IsEditable="True"
                                                 Text="{Binding Item2.HerbName, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Herb2"
                                                 TextSearch.TextPath="Name"
                                                 Padding="5,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 用量2 -->
                            <DataGridTextColumn Header="用量2" Binding="{Binding Item2.Dosage, UpdateSourceTrigger=PropertyChanged}" Width="60"/>

                            <!-- 药材3 - Epic #1540: ComboBox + 拼音码过滤 -->
                            <DataGridTemplateColumn Header="药材3" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.FilteredHerbs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 DisplayMemberPath="Name"
                                                 SelectedValue="{Binding Item3.HerbId, UpdateSourceTrigger=PropertyChanged}"
                                                 SelectedValuePath="Id"
                                                 IsEditable="True"
                                                 Text="{Binding Item3.HerbName, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Herb3"
                                                 TextSearch.TextPath="Name"
                                                 Padding="5,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 用量3 -->
                            <DataGridTextColumn Header="用量3" Binding="{Binding Item3.Dosage, UpdateSourceTrigger=PropertyChanged}" Width="60"/>

                            <!-- 药材4 - Epic #1540: ComboBox + 拼音码过滤 -->
                            <DataGridTemplateColumn Header="药材4" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.FilteredHerbs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 DisplayMemberPath="Name"
                                                 SelectedValue="{Binding Item4.HerbId, UpdateSourceTrigger=PropertyChanged}"
                                                 SelectedValuePath="Id"
                                                 IsEditable="True"
                                                 Text="{Binding Item4.HerbName, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Herb4"
                                                 TextSearch.TextPath="Name"
                                                 Padding="5,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 用量4 -->
                            <DataGridTextColumn Header="用量4" Binding="{Binding Item4.Dosage, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 统计信息 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="药材总数：" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Text="{Binding ItemCount}" FontWeight="Bold" Foreground="#2E86AB" VerticalAlignment="Center"/>
                        <TextBlock Text="味" Margin="5,0,20,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 5: 重复药材警告（新增，Issue #1591） -->
            <Border Grid.Row="5"
                   Background="#FFF3E0"
                   BorderBrush="#FFB74D"
                   BorderThickness="1"
                   CornerRadius="3"
                   Padding="10"
                   Margin="0,0,0,15"
                   Visibility="{Binding DuplicateHerbsWarningVisibility}">
                <StackPanel>
                    <TextBlock Text="⚠️ 重复药材提示"
                              FontWeight="Bold"
                              FontSize="13"
                              Foreground="#F57C00"/>
                    <TextBlock Text="{Binding DuplicateHerbsWarningText}"
                              FontSize="12"
                              Foreground="#666"
                              TextWrapping="Wrap"
                              Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Row 6: 处方信息 -->
            <Border Grid.Row="6"
                   BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   CornerRadius="5"
                   Background="White"
                   Padding="15"
                   Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 第一行：剂数 + 用法 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="剂数：" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                            Text="{Binding DosageCount, UpdateSourceTrigger=PropertyChanged}"
                            Padding="5"
                            VerticalContentAlignment="Center"
                            Margin="0,0,20,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="用法：" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="3"
                            Text="{Binding Usage, UpdateSourceTrigger=PropertyChanged}"
                            Padding="5"
                            VerticalContentAlignment="Center"/>

                    <!-- 第二行：价格信息 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="单剂价格：" Style="{StaticResource FieldLabelStyle}" Margin="0,10,10,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="0,10,20,0">
                        <Run Text="¥" FontSize="14"/>
                        <Run Text="{Binding SingleDosagePrice, Mode=OneWay, StringFormat=F2}" FontWeight="Bold" Foreground="#4CAF50" FontSize="16"/>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="总价格：" Style="{StaticResource FieldLabelStyle}" Margin="0,10,10,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="3"
                              VerticalAlignment="Center"
                              Margin="0,10,0,0">
                        <Run Text="¥" FontSize="14"/>
                        <Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat=F2}" FontWeight="Bold" Foreground="#2E86AB" FontSize="18"/>
                        <Run Text="（自动计算）" FontSize="12" Foreground="#666"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Row 7: 提示信息 -->
            <Border Grid.Row="7"
                   Background="#FFF3E0"
                   BorderBrush="#FFB74D"
                   BorderThickness="1"
                   CornerRadius="3"
                   Padding="10">
                <StackPanel>
                    <TextBlock Text="提示：" FontWeight="Bold" FontSize="13" Foreground="#F57C00"/>
                    <TextBlock Text="• 填写完成后点击【下一步】完成看诊"
                              FontSize="12"
                              Foreground="#666"
                              Margin="0,5,0,0"/>
                    <TextBlock Text="• 保存时将创建Prescription实体并关联到MedicalCase.PrescriptionId"
                              FontSize="12"
                              Foreground="#666"
                              Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- 浮动查询菜单按钮（右下角，Issue #1591）-->
            <Button Grid.Row="0"
                   Grid.RowSpan="8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="56"
                   Height="56"
                   Margin="0,0,20,20"
                   Command="{Binding ShowOtherCasesQueryCommand}"
                   ToolTip="查询其他病案"
                   Background="#2196F3"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Content="?"
                   BorderThickness="0"
                   Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="28"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </ScrollViewer>
</UserControl>
