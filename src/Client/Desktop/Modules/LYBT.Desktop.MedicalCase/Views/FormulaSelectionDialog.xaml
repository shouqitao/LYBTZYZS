<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.FormulaSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             prism:Dialog.WindowStyle="{StaticResource CustomDialogWindowStyle}"
             Width="700" Height="600">
    <!--
    Epic #2175 BF-002 Task 3.8: 经验方选择对话框
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题栏 -->
            <RowDefinition Height="Auto" />   <!-- 搜索栏 -->
            <RowDefinition Height="*" />      <!-- 列表区 -->
            <RowDefinition Height="Auto" />   <!-- 按钮栏 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 标题栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="20,12">
            <TextBlock Text="选择经验方"
                      Foreground="White"
                      FontSize="18"
                      FontWeight="Bold" />
        </Border>

        <!-- Row 1: 搜索栏 -->
        <Border Grid.Row="1" Background="White" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          Text="搜索："
                          VerticalAlignment="Center"
                          FontSize="14"
                          Margin="0,0,8,0" />

                <TextBox Grid.Column="1"
                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14"
                        Padding="8,6"
                        Margin="0,0,12,0"
                        VerticalContentAlignment="Center" />

                <Button Grid.Column="2"
                       Content="搜索"
                       Command="{Binding SearchCommand}"
                       Background="#2E86AB"
                       Foreground="White"
                       Padding="20,8"
                       FontSize="14"
                       Cursor="Hand" />
            </Grid>
        </Border>

        <!-- Row 2: 列表区 -->
        <Border Grid.Row="2" Background="White" Padding="20">
            <Grid>
                <!-- 加载中提示 -->
                <StackPanel VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="⏳"
                              FontSize="48"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="加载中..."
                              FontSize="14"
                              Foreground="#666"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 经验方列表 -->
                <DataGrid ItemsSource="{Binding Formulas}"
                         SelectedItem="{Binding SelectedFormula}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         GridLinesVisibility="Horizontal"
                         RowHeight="40"
                         FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="经验方名称"
                                          Binding="{Binding Name}"
                                          Width="2*" />
                        <DataGridTextColumn Header="分类"
                                          Binding="{Binding Category}"
                                          Width="*" />
                        <DataGridTextColumn Header="来源"
                                          Binding="{Binding Source}"
                                          Width="1.5*" />
                        <DataGridTextColumn Header="适应症"
                                          Binding="{Binding Indications}"
                                          Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Row 3: 按钮栏 -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="20,12">
            <Grid>
                <TextBlock Text="{Binding Formulas.Count, StringFormat=共 {0} 个经验方}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Foreground="#666" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定"
                           Command="{Binding ConfirmCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="#4CAF50"
                           Foreground="White"
                           Width="100"
                           Padding="0,10"
                           Margin="0,0,12,0"
                           FontSize="14" />

                    <Button Content="取消"
                           Command="{Binding CancelCommand}"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Width="100"
                           Padding="0,10"
                           FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
