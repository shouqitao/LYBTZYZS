<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:LYBT.Desktop.MedicalCase.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- InverseBooleanToVisibilityConverter -->
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- 操作按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Height" Value="40" />
        </Style>

        <!-- 区域标题样式 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2E86AB" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 输入框标签样式 -->
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>   <!-- Row 0: 主内容区（左右分栏） -->
            <RowDefinition Height="80"/>  <!-- Row 1: 底部操作栏 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 主内容区 - 左右分栏布局 (40% + 60%) -->
        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>  <!-- 左侧: 诊断区 (40%) -->
                <ColumnDefinition Width="16"/>  <!-- 中间: 间隔 -->
                <ColumnDefinition Width="6*"/>  <!-- 右侧: 处方区 (60%) -->
            </Grid.ColumnDefinitions>

            <!-- 左侧: 诊断区 -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="辨证信息" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- 主诉 -->
                        <TextBlock Text="主诉" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="500"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,16" />

                        <!-- 中医诊断 -->
                        <TextBlock Text="中医诊断" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="200"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="60"
                                Margin="0,0,0,16" />

                        <!-- 望闻问切区域（可选，简化版可留空） -->
                        <Expander Header="望闻问切详情（可选）"
                                 IsExpanded="False"
                                 Margin="0,0,0,16">
                            <StackPanel Margin="0,12,0,0">
                                <!-- 望 -->
                                <TextBlock Text="望诊" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Inspection, UpdateSourceTrigger=PropertyChanged}"
                                        MaxLength="200"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="50"
                                        Margin="0,0,0,12" />

                                <!-- 闻 -->
                                <TextBlock Text="闻诊" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Auscultation, UpdateSourceTrigger=PropertyChanged}"
                                        MaxLength="200"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="50"
                                        Margin="0,0,0,12" />

                                <!-- 问 -->
                                <TextBlock Text="问诊" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}"
                                        MaxLength="500"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="80"
                                        Margin="0,0,0,12" />

                                <!-- 切 -->
                                <TextBlock Text="切诊" Style="{StaticResource InputLabelStyle}" />
                                <TextBox Text="{Binding PulseDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                        MaxLength="200"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="50"
                                        Margin="0,0,0,0" />
                            </StackPanel>
                        </Expander>

                        <!-- 处方选择（Epic #2175 BF-002 Step 2） -->
                        <Border BorderBrush="#E0E0E0"
                               BorderThickness="1"
                               CornerRadius="4"
                               Padding="12"
                               Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="是否需要开具处方？"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,8" />
                                <RadioButton Content="需要开处方"
                                           GroupName="PrescriptionChoice"
                                           IsChecked="{Binding NeedsPrescriptionTrue}"
                                           Margin="0,4" />
                                <RadioButton Content="不需要处方"
                                           GroupName="PrescriptionChoice"
                                           IsChecked="{Binding NeedsPrescriptionFalse}"
                                           Margin="0,4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧: 处方区 -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <!-- 处方内容区 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="处方详情" Style="{StaticResource SectionHeaderStyle}"
                                          HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                    <Button Content="导入经验方"
                                           Command="{Binding ImportFormulaCommand}"
                                           IsEnabled="{Binding CanEditPrescription}"
                                           Style="{StaticResource MaterialDesignOutlinedButton}"
                                           Padding="12,6"
                                           Margin="0,0,8,0" />
                                    <Button Content="导入历史处方"
                                           Command="{Binding ImportHistoryCommand}"
                                           IsEnabled="{Binding CanEditPrescription}"
                                           Style="{StaticResource MaterialDesignOutlinedButton}"
                                           Padding="12,6" />
                                </StackPanel>
                            </Grid>

                            <!-- 药材列表（Epic #2175 BF-002 Task 3.4 & Task 3.7 - 使用HerbCardControl + 键盘导航） -->
                            <ItemsControl x:Name="HerbItemsControl" ItemsSource="{Binding PrescriptionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:HerbCardControl
                                            DeleteCommand="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            DosageCompletedCommand="{Binding DataContext.DosageCompletedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            AddNewRowCommand="{Binding DataContext.AddHerbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 添加药材按钮 -->
                            <Button Content="+ 添加药材"
                                   Command="{Binding AddHerbCommand}"
                                   IsEnabled="{Binding CanEditPrescription}"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   HorizontalAlignment="Left"
                                   Margin="0,16,0,0"
                                   Padding="16,8" />

                            <!-- 价格汇总区 -->
                            <Border BorderBrush="#E0E0E0"
                                   BorderThickness="0,1,0,0"
                                   Padding="0,16,0,0"
                                   Margin="0,24,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="剂数:"
                                              FontSize="14" Margin="0,4" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                            Text="{Binding DosageCount, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CanEditPrescription}"
                                            HorizontalAlignment="Right"
                                            Width="120"
                                            />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="折扣:"
                                              FontSize="14" Margin="0,12,0,4" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                            Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CanEditPrescription}"
                                            HorizontalAlignment="Right"
                                            Width="120"
                                            />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="小计:"
                                              FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                              Text="{Binding SubTotal, StringFormat=¥{0:N2}}"
                                              HorizontalAlignment="Right"
                                              FontSize="15"
                                              FontWeight="SemiBold"
                                              Foreground="#4CAF50" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="总计:"
                                              FontSize="18" FontWeight="Bold" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                              Text="{Binding TotalAmount, StringFormat=¥{0:N2}}"
                                              HorizontalAlignment="Right"
                                              FontSize="18"
                                              FontWeight="Bold"
                                              Foreground="#2E86AB" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Overlay提示层（Epic #2175 BF-002: 未完成Step1和Step2时锁定处方区） -->
                    <Border Background="#F0FFFFFF"
                           Visibility="{Binding CanEditPrescription, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔒"
                                      FontSize="48"
                                      Foreground="#BDBDBD"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,16" />
                            <TextBlock Text="请先完成辨证信息并选择是否需要开处方"
                                      FontSize="16"
                                      Foreground="#757575"
                                      HorizontalAlignment="Center"
                                      Margin="0,16,0,0" />
                            <TextBlock Text="保存后即可编辑处方"
                                      FontSize="13"
                                      Foreground="#9E9E9E"
                                      HorizontalAlignment="Center"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: 底部操作栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="保存草稿"
                           Command="{Binding SaveDraftCommand}"
                           Style="{StaticResource ActionButtonStyle}"
                           />
                    <Button Content="保存并完成"
                           Command="{Binding SaveAndCompleteCommand}"
                           Style="{StaticResource ActionButtonStyle}"
                           Background="#4CAF50"
                           />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
