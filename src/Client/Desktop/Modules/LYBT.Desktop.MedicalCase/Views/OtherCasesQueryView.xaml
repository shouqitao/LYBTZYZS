<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.OtherCasesQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索条件区域 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="查询条件" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                <!-- 查询条件输入 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 患者姓名 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Text="患者姓名" FontSize="14" Margin="0,0,0,8" />
                        <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="8"
                                 BorderBrush="#BDBDBD" BorderThickness="1" />
                    </StackPanel>

                    <!-- 诊断关键词 -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Text="诊断关键词" FontSize="14" Margin="0,0,0,8" />
                        <TextBox Text="{Binding DiagnosisKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="8"
                                 BorderBrush="#BDBDBD" BorderThickness="1" />
                    </StackPanel>

                    <!-- 开始日期 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="开始日期" FontSize="14" Margin="0,0,0,8" />
                        <DatePicker SelectedDate="{Binding StartDate}"
                                    FontSize="14" Padding="8"
                                    BorderBrush="#BDBDBD" BorderThickness="1" />
                    </StackPanel>

                    <!-- 结束日期 -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="结束日期" FontSize="14" Margin="0,0,0,8" />
                        <DatePicker SelectedDate="{Binding EndDate}"
                                    FontSize="14" Padding="8"
                                    BorderBrush="#BDBDBD" BorderThickness="1" />
                    </StackPanel>
                </Grid>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="清空" Command="{Binding ClearCommand}"
                            Width="100" Height="36" FontSize="14" Margin="0,0,8,0"
                            Background="White" BorderBrush="#BDBDBD" BorderThickness="1" />
                    <Button Content="查询" Command="{Binding QueryCommand}"
                            Width="100" Height="36" FontSize="14"
                            Background="#1976D2" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 查询结果区域 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 结果标题 -->
                <TextBlock Grid.Row="0" Text="查询结果" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                <!-- 加载中提示 -->
                <StackPanel Grid.Row="1" Visibility="{Binding IsQuerying, Converter={StaticResource BooleanToVisibilityConverter}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                    <TextBlock Text="查询中..." FontSize="14" Foreground="#757575" Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 无结果提示 -->
                <TextBlock Grid.Row="1" Text="没有查询到符合条件的病案"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="14" Foreground="#757575" VerticalAlignment="Center" HorizontalAlignment="Center" />

                <!-- 查询结果列表 -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding QueryResults}"
                          SelectedItem="{Binding SelectedCase}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F5F5F5"
                          BorderThickness="0" HeadersVisibility="Column"
                          Visibility="{Binding QueryResults.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="120" />
                        <DataGridTextColumn Header="日期" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="120" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                        <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="100" />
                        <DataGridTemplateColumn Header="操作" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="查看详情" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Width="80" Height="28" FontSize="12"
                                            Background="#1976D2" Foreground="White" BorderThickness="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
