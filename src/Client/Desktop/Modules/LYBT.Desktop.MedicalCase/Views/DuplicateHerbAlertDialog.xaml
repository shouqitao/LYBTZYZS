<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.DuplicateHerbAlertDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
             Width="600" Height="400">
    <!--
    Epic #2175 BF-002 Task 3.10: 重复药材聚合提醒对话框
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题栏 -->
            <RowDefinition Height="*" />      <!-- 列表区 -->
            <RowDefinition Height="Auto" />   <!-- 按钮栏 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 标题栏 -->
        <Border Grid.Row="0" Background="#FF9800" Padding="20,12">
            <TextBlock Text="⚠️ 检测到重复药材"
                      Foreground="White"
                      FontSize="18"
                      FontWeight="Bold" />
        </Border>

        <!-- Row 1: 列表区 -->
        <Border Grid.Row="1" Background="White" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 说明文字 -->
                <TextBlock Grid.Row="0"
                          Text="以下药材在处方中已存在，系统将使用最大剂量进行合并："
                          FontSize="13"
                          Foreground="#666"
                          Margin="0,0,0,12"
                          TextWrapping="Wrap" />

                <!-- 重复药材列表 -->
                <ListBox Grid.Row="1"
                        ItemsSource="{Binding DuplicateHerbs}"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8"
                                   Background="#FFF3E0"
                                   BorderBrush="#FFB74D"
                                   BorderThickness="1"
                                   CornerRadius="4"
                                   Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                              Text="⚠️"
                                              FontSize="16"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="1"
                                              Text="{Binding DisplayText}"
                                              FontSize="13"
                                              VerticalAlignment="Center"
                                              TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Row 2: 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,12">
            <Grid>
                <TextBlock Text="{Binding DuplicateHerbs.Count, StringFormat=共 {0} 个重复药材}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Foreground="#666" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确认合并"
                           Command="{Binding ConfirmCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="#FF9800"
                           Foreground="White"
                           Width="100"
                           Padding="0,10"
                           Margin="0,0,12,0"
                           FontSize="14" />

                    <Button Content="取消"
                           Command="{Binding CancelCommand}"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Width="100"
                           Padding="0,10"
                           FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
