<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.DuplicateHerbAlertDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
             Width="300" Height="180">
    <!--
    OpenSpec: enhance-duplicate-herb-dialog
    重构为单药材确认对话框，逐个提醒重复药材
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题栏 -->
            <RowDefinition Height="*" />      <!-- 内容区 -->
            <RowDefinition Height="Auto" />   <!-- 按钮栏 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 标题栏 -->
        <Border Grid.Row="0" Background="#FF9800" Padding="16,10">
            <TextBlock Text="重复药材提醒"
                      Foreground="White"
                      FontSize="16"
                      FontWeight="Bold" />
        </Border>

        <!-- Row 1: 内容区 -->
        <Border Grid.Row="1" Background="White" Padding="20">
            <TextBlock HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="16"
                      TextWrapping="Wrap">
                <Run Text="{Binding HerbName, Mode=OneWay}" FontWeight="Bold"/>
                <Run Text=" 重复"/>
            </TextBlock>
        </Border>

        <!-- Row 2: 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="16,12">
            <Button Content="确定"
                   Command="{Binding ConfirmCommand}"
                   IsDefault="True"
                   HorizontalAlignment="Center"
                   Style="{DynamicResource WarningButton}"
                   Width="100"
                   Cursor="Hand" />
        </Border>
    </Grid>
</UserControl>
