<UserControl
    x:Class="LYBT.Desktop.MedicalCase.Views.DuplicateHerbAlertDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    Width="300"
    Height="180"
    prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <!--
        OpenSpec: enhance-duplicate-herb-dialog
        重构为单药材确认对话框，逐个提醒重复药材
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  标题栏  -->
            <RowDefinition Height="*" />
            <!--  内容区  -->
            <RowDefinition Height="Auto" />
            <!--  按钮栏  -->
        </Grid.RowDefinitions>

        <!--  Row 0: 标题栏  -->
        <Border
            Grid.Row="0"
            Padding="16,10"
            Background="#FF9800">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                Text="重复药材提醒" />
        </Border>

        <!--  Row 1: 内容区  -->
        <Border
            Grid.Row="1"
            Padding="20"
            Background="White">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                TextWrapping="Wrap">
                <Run FontWeight="Bold" Text="{Binding HerbName, Mode=OneWay}" />
                <Run Text=" 重复" />
            </TextBlock>
        </Border>

        <!--  Row 2: 按钮栏  -->
        <Border
            Grid.Row="2"
            Padding="16,12"
            Background="#F5F5F5">
            <Button
                Width="100"
                HorizontalAlignment="Center"
                Command="{Binding ConfirmCommand}"
                Content="确定"
                Cursor="Hand"
                IsDefault="True"
                Style="{DynamicResource WarningButton}" />
        </Border>
    </Grid>
</UserControl>
