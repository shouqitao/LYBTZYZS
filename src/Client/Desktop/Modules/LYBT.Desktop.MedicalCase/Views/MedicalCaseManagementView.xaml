<!--
    MedicalCaseManagementView - 医案管理视图
    Issue #1999 - Task 2.6: 应用BaseMasterDataListView模板
    
    重构说明：
    - 使用 BaseMasterDataListView 替代原有的三行布局
    - 移除重复的工具栏、数据表格、分页控件代码
    - 通过 Columns 和 ActionButtons 属性定义医案特定内容
-->
<UserControl
    x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
    xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!--  转换器资源  -->
        <infrastructure:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>

    <!--  Issue #1999: 应用 BaseMasterDataListView 模板  -->
    <!-- OpenSpec: optimize-module-list-ui - 添加多选支持 -->
    <views:BaseMasterDataListView
        BusyMessage="{Binding BusyMessage}"
        CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
        EmptyStateText="暂无病案数据"
        FirstPageCommand="{Binding FirstPageCommand}"
        IsBusy="{Binding IsBusy}"
        ItemsSource="{Binding Items}"
        LastPageCommand="{Binding LastPageCommand}"
        NextPageCommand="{Binding NextPageCommand}"
        PageSize="{Binding PageSize, Mode=TwoWay}"
        PreviousPageCommand="{Binding PreviousPageCommand}"
        SearchCommand="{Binding SearchCommand}"
        SearchText="{Binding SearchText, Mode=TwoWay}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
        ShowCheckBoxColumn="True"
        TotalCount="{Binding TotalCount}"
        TotalPages="{Binding TotalPages}">

        <!--  定义医案特定的 DataGrid 列  -->
        <views:BaseMasterDataListView.Columns>
            <!--  案例编号  -->
            <DataGridTextColumn
                Width="120"
                Binding="{Binding CaseNumber}"
                Header="案例编号" />

            <!--  创建时间  -->
            <DataGridTextColumn
                Width="150"
                Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                Header="创建时间" />

            <!--  患者信息  -->
            <DataGridTextColumn
                Width="100"
                Binding="{Binding PatientName}"
                Header="患者姓名" />

            <DataGridTextColumn
                Width="60"
                Binding="{Binding PatientGender}"
                Header="性别" />

            <DataGridTextColumn
                Width="60"
                Binding="{Binding PatientAge}"
                Header="年龄" />

            <!--  接诊医生  -->
            <DataGridTextColumn
                Width="100"
                Binding="{Binding DoctorName}"
                Header="接诊医生" />

            <!--  主诉  -->
            <DataGridTextColumn
                Width="*"
                Binding="{Binding ChiefComplaint}"
                Header="主诉症状" />

            <!--  诊断  -->
            <DataGridTextColumn
                Width="150"
                Binding="{Binding Diagnosis}"
                Header="诊断结果" />

            <!--  状态 - 使用UnifiedStatusBadge  -->
            <DataGridTemplateColumn Width="80" Header="状态">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:UnifiedStatusBadge Text="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}" Type="Success" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!--  操作  -->
            <DataGridTemplateColumn Width="Auto" Header="操作">
                <DataGridTemplateColumn.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                    </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,12,0">
                            <Button
                                Margin="4,0"
                                Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=views:BaseMasterDataListView}}"
                                CommandParameter="{Binding}"
                                Content="查看"
                                Style="{StaticResource InfoButton}" />
                            <!-- OpenSpec: unify-detail-view-style - 编辑按钮移至DetailView顶部 -->
                            <Button
                                Margin="4,0"
                                Command="{Binding DataContext.ViewConsultationCommand, RelativeSource={RelativeSource AncestorType=views:BaseMasterDataListView}}"
                                CommandParameter="{Binding}"
                                Content="诊疗"
                                Style="{StaticResource PrimaryButton}" />
                            <Button
                                Margin="4,0"
                                Command="{Binding DataContext.CreatePrescriptionCommand, RelativeSource={RelativeSource AncestorType=views:BaseMasterDataListView}}"
                                CommandParameter="{Binding}"
                                Content="处方"
                                Style="{StaticResource WarningButton}" />
                            <!--  OpenSpec: refactor-medicalcase-management (LIFECYCLE-008) - 变更记录按钮  -->
                            <Button
                                Margin="4,0"
                                Command="{Binding DataContext.ShowAuditLogCommand, RelativeSource={RelativeSource AncestorType=views:BaseMasterDataListView}}"
                                CommandParameter="{Binding}"
                                Content="记录"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="查看医案变更历史" />
                            <Button
                                Margin="4,0"
                                Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=views:BaseMasterDataListView}}"
                                CommandParameter="{Binding}"
                                Content="打印"
                                Style="{StaticResource SecondaryButton}" />
                            <!-- OpenSpec: optimize-module-list-ui - 删除按钮移至工具栏批量删除，减少误操作 -->
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </views:BaseMasterDataListView.Columns>

        <!--  筛选内容区域  -->
        <views:BaseMasterDataListView.FilterContent>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="{StaticResource SpacingMedium}"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelText}"
                    Text="状态：" />
                <ComboBox
                    Width="120"
                    Margin="{StaticResource SpacingSmall}"
                    SelectedItem="{Binding FilterStatus}"
                    Style="{StaticResource FilterComboBox}">
                    <ComboBoxItem Content="全部状态" />
                    <ComboBoxItem Content="已登记" />
                    <ComboBoxItem Content="进行中" />
                    <ComboBoxItem Content="已完成" />
                    <ComboBoxItem Content="已取消" />
                </ComboBox>

                <TextBlock
                    Margin="{StaticResource SpacingMedium}"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelText}"
                    Text="日期：" />
                <DatePicker
                    Width="120"
                    Margin="{StaticResource SpacingSmall}"
                    SelectedDate="{Binding StartDate}" />
                <TextBlock
                    Margin="{StaticResource SpacingSmall}"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelText}"
                    Text="至" />
                <DatePicker
                    Width="120"
                    Margin="{StaticResource SpacingSmall}"
                    SelectedDate="{Binding EndDate}" />
            </StackPanel>
        </views:BaseMasterDataListView.FilterContent>

        <!--  操作按钮区域  -->
        <!--  refactor-medicalcase-management: 移除"新建案例"按钮，创建入口仅限临床工作流  -->
        <!--  使用 RelativeSource 绑定确保 DataContext 正确传递  -->
        <views:BaseMasterDataListView.ActionButtons>
            <StackPanel Orientation="Horizontal">
                <!-- OpenSpec: optimize-module-list-ui - 批量删除移至工具栏 -->
                <Button
                    Margin="{StaticResource SpacingSmall}"
                    Command="{Binding BatchDeleteCommand}"
                    Content="批量删除"
                    Style="{StaticResource DangerButton}"
                    ToolTip="删除选中的病案" />
                <Button
                    Margin="{StaticResource SpacingSmall}"
                    Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=views:BaseMasterDataListView}}"
                    Content="刷新"
                    Style="{StaticResource SecondaryButton}" />
                <Button
                    Margin="{StaticResource SpacingSmall}"
                    Command="{Binding DataContext.NavigateToHomeCommand, RelativeSource={RelativeSource AncestorType=views:BaseMasterDataListView}}"
                    Content="返回主页"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="返回管理员主页" />
            </StackPanel>
        </views:BaseMasterDataListView.ActionButtons>
    </views:BaseMasterDataListView>
</UserControl>
