<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.MedicalCase</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 医疗案例模块 | 诊疗流程容器 | 状态跟踪管理</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-medicalcase-enterprise</InformationalVersion>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.MedicalCase</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT医疗案例模块 - 诊疗流程容器、状态跟踪、医案管理 | UltraThink双层架构标准</PackageDescription>
    <PackageTags>WPF;医疗案例;诊疗流程;状态跟踪;医案;中医;诊所;UltraThink</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
    <Page Remove="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="LYBT.Desktop.MedicalCase.csproj.Backup.tmp" />
    <None Remove="LYBT.Desktop.MedicalCase.xml" />
  </ItemGroup>

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Prism.Wpf" />
  </ItemGroup>

  <!-- Logging -->
  <ItemGroup Label="Logging">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Infrastructure Dependencies - 简化三层架构">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Foundation\LYBT.Desktop.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Models\LYBT.Desktop.Models.csproj" />
    <!-- Issue: unify-herb-card-control - 引用共享HerbCardControl控件 -->
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Presentation\LYBT.Desktop.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup Label="Desktop Core">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Contracts\LYBT.Desktop.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
  </ItemGroup>

  <ItemGroup Label="Module Dependencies - Epic #2175">
    <!-- Task 3.7: MedicalCase需要Herbs模块以支持药材拼音码过滤 -->
    <ProjectReference Include="..\LYBT.Desktop.Herbs\LYBT.Desktop.Herbs.csproj" />
    <!-- Task 3.8: MedicalCase需要Formula模块以支持经验方导入 -->
    <ProjectReference Include="..\LYBT.Desktop.Formula\LYBT.Desktop.Formula.csproj" />
    <!-- OpenSpec: refactor-prescription-module-consolidation - 使用统一验方选择对话框和处方计算器 -->
    <ProjectReference Include="..\LYBT.Desktop.Prescriptions\LYBT.Desktop.Prescriptions.csproj" />
  </ItemGroup>

  <!-- Epic #1676 Phase 4 Task 4.5: 移除循环依赖 - MedicalCase不需要引用Patients -->
  <!-- Prism [ModuleDependency] 只需要运行时加载顺序，不需要编译时项目引用 -->

</Project>