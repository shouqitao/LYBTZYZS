<UserControl x:Class="LYBT.Desktop.MedicalCase.Dialogs.FormulaImportDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.MedicalCase.Dialogs"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:formulaControls="clr-namespace:LYBT.Desktop.Infrastructure.Controls.FormulaView;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             mc:Ignorable="d"
             prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
             d:DesignHeight="650" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=viewmodels:FormulaImportDialogViewModel}">

    <!--
    OpenSpec: redesign-formula-import-ui
    重新设计的验方导入弹窗 - 左右双栏布局
    左栏: 搜索筛选 + 验方卡片列表
    右栏: 验方详情 + 药材卡片预览
    -->

    <!-- 转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters) -->
    <UserControl.Resources>
        <!-- 验方卡片样式 -->
        <Style x:Key="FormulaCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F9FF" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- OpenSpec: extract-detail-controls Task 1.4 - HerbPreviewCardTemplate已移除，改用FormulaViewControl -->
    </UserControl.Resources>

    <Grid Width="1100" Height="680">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题栏 -->
            <RowDefinition Height="*" />      <!-- 内容区域 -->
            <RowDefinition Height="Auto" />   <!-- 按钮栏 -->
        </Grid.RowDefinitions>

        <!-- Row 0: 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="20,12">
            <TextBlock Text="从经验方导入" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <!-- Row 1: 内容区域 - 左右双栏布局 -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />  <!-- 左栏: 验方列表 -->
                <ColumnDefinition Width="*" />    <!-- 右栏: 详情预览 -->
            </Grid.ColumnDefinitions>

            <!-- 左栏: 搜索 + 分类筛选 + 验方列表 -->
            <Border Grid.Column="0"
                    Background="#F8F9FA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,1,0">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- 搜索框 -->
                        <RowDefinition Height="Auto" />  <!-- 分类筛选 -->
                        <RowDefinition Height="*" />     <!-- 验方列表 -->
                        <RowDefinition Height="Auto" />  <!-- 统计信息 -->
                    </Grid.RowDefinitions>

                    <!-- 搜索框 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 FontSize="13"
                                 BorderBrush="#D0D0D0"
                                 BorderThickness="1" />
                        <TextBlock Text="搜索验方名称、拼音码..."
                                   IsHitTestVisible="False"
                                   Foreground="#999"
                                   Padding="12,10"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 分类筛选 -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="分类:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  FontSize="13"
                                  Padding="8,6" />
                    </Grid>

                    <!-- 验方列表 -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredFormulas}"
                             SelectedItem="{Binding SelectedFormula}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FormulaCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 第一行: 名称 + 药材数量 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Background="#E8F5E9"
                                                    CornerRadius="10"
                                                    Padding="8,2">
                                                <TextBlock Text="{Binding HerbCount, StringFormat={}{0}味}"
                                                           FontSize="11"
                                                           Foreground="#4CAF50" />
                                            </Border>
                                        </Grid>

                                        <!-- 第二行: 适应症摘要 -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Indications, TargetNullValue=暂无适应症}"
                                                   FontSize="12"
                                                   Foreground="#666"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="36"
                                                   Margin="0,6,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 统计信息 -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#666"
                               Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- 右栏: 验方详情预览 - OpenSpec: extract-detail-controls Task 1.4 复用FormulaViewControl -->
            <Grid Grid.Column="1" Margin="10,10">
                <!-- 无选中时的提示 -->
                <TextBlock Text="请从左侧选择一个经验方"
                           FontSize="14"
                           Foreground="#999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedFormulaDetail}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 有选中时显示详情 - 使用FormulaViewControl -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding SelectedFormulaDetail, Converter={x:Static converters:Cvt.NullToVis}}">
                    <formulaControls:FormulaViewControl
                        Formula="{Binding SelectedFormulaDetail}"
                        ShowAuditInfo="False"/>
                </ScrollViewer>

                <!-- 加载状态提示 -->
                <TextBlock Text="{Binding LoadingMessage}"
                           FontSize="12"
                           Foreground="#999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,10"
                           Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}" />
            </Grid>
        </Grid>

        <!-- Row 2: 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确认导入"
                            Command="{Binding ConfirmCommand}"
                            Width="100"
                            Padding="12,8"
                            FontSize="14"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            Margin="0,0,12,0" />
                    <Button Content="取消"
                            Command="{Binding CancelCommand}"
                            Width="80"
                            Padding="12,8"
                            FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
