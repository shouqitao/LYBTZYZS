<UserControl x:Class="LYBT.Desktop.MedicalCase.Dialogs.AuditLogDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.MedicalCase.Dialogs"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             prism:Dialog.WindowStyle="{StaticResource CustomDialogWindowStyle}"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=viewmodels:AuditLogDialogViewModel}">

    <!--
    OpenSpec: refactor-medicalcase-management (LIFECYCLE-008)
    审计日志对话框 - 显示医案的变更历史记录
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColorBrush}" Padding="15,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="变更记录" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text=" - " Foreground="White" FontSize="18" Opacity="0.8" />
                    <TextBlock Text="{Binding CaseNumber}" Foreground="White" FontSize="18" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="患者: " Foreground="White" FontSize="14" Opacity="0.8" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PatientName}" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="15">
            <!-- 加载遮罩 -->
            <Border Background="White" Opacity="0.8" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="正在加载..." FontSize="14" Foreground="#666" />
                </StackPanel>
            </Border>

            <!-- 审计日志列表 -->
            <DataGrid ItemsSource="{Binding AuditLogs}"
                      SelectedItem="{Binding SelectedLog}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#E0E0E0"
                      BorderThickness="1"
                      RowHeight="40"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- 操作时间 -->
                    <DataGridTextColumn Header="操作时间" Width="150"
                                        Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" />

                    <!-- 操作类型 -->
                    <DataGridTemplateColumn Header="操作类型" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="6,3" CornerRadius="3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E3F2FD" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OperationTypeName}" Value="创建">
                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OperationTypeName}" Value="更新">
                                                    <Setter Property="Background" Value="#FFF3E0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OperationTypeName}" Value="状态变更">
                                                    <Setter Property="Background" Value="#E3F2FD" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OperationTypeName}" Value="软删除">
                                                    <Setter Property="Background" Value="#FFEBEE" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding OperationTypeName}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1976D2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OperationTypeName}" Value="创建">
                                                        <Setter Property="Foreground" Value="#388E3C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OperationTypeName}" Value="更新">
                                                        <Setter Property="Foreground" Value="#F57C00" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OperationTypeName}" Value="状态变更">
                                                        <Setter Property="Foreground" Value="#1976D2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OperationTypeName}" Value="软删除">
                                                        <Setter Property="Foreground" Value="#D32F2F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 操作者 -->
                    <DataGridTextColumn Header="操作者" Width="100"
                                        Binding="{Binding OperatorName}" />

                    <!-- 操作者角色 -->
                    <DataGridTextColumn Header="角色" Width="80"
                                        Binding="{Binding OperatorRole}" />

                    <!-- 变更字段 -->
                    <DataGridTextColumn Header="变更字段" Width="180"
                                        Binding="{Binding ChangedFields}" />

                    <!-- 修改原因 -->
                    <DataGridTextColumn Header="修改原因" Width="*"
                                        Binding="{Binding Reason}" />
                </DataGrid.Columns>

                <!-- 空状态提示 -->
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AuditLogs.Count}" Value="0">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1">
                                                <TextBlock Text="暂无变更记录"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Foreground="#999" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
            </DataGrid>
        </Grid>

        <!-- 分页控制 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#666" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="上一页"
                            Command="{Binding PreviousPageCommand}"
                            Padding="10,4"
                            Margin="0,0,5,0"
                            FontSize="12" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0" FontSize="12">
                        <Run Text="第 " />
                        <Run Text="{Binding CurrentPage}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalPages}" />
                        <Run Text=" 页" />
                    </TextBlock>
                    <Button Content="下一页"
                            Command="{Binding NextPageCommand}"
                            Padding="10,4"
                            Margin="5,0,0,0"
                            FontSize="12" />
                    <Button Content="刷新"
                            Command="{Binding RefreshCommand}"
                            Padding="10,4"
                            Margin="15,0,0,0"
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 按钮栏 -->
        <Border Grid.Row="3" Background="#FAFAFA" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭"
                        Command="{Binding CloseCommand}"
                        Width="80"
                        Padding="8,6"
                        Background="{DynamicResource PrimaryColorBrush}"
                        Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
