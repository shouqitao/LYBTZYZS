<UserControl x:Class="LYBT.Desktop.MedicalCase.Dialogs.AuditReasonDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.MedicalCase.Dialogs"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
             d:DesignHeight="380" d:DesignWidth="420"
             d:DataContext="{d:DesignInstance Type=viewmodels:AuditReasonDialogViewModel}">

    <!--
    OpenSpec: medicalcase-management-ui-refactor (EDITMODE-011)
    审计理由对话框 - 修改医案时填写修改原因
    -->

    <Grid Background="White" MinWidth="400" MinHeight="350">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#E65100" Padding="15,12">
            <TextBlock Text="修改原因（必填）" Foreground="White" FontSize="16" FontWeight="Bold" />
        </Border>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 说明文字 -->
            <TextBlock Grid.Row="0"
                       Text="您正在修改历史医案，请说明修改原因："
                       FontSize="13"
                       Foreground="#333"
                       Margin="0,0,0,12" />

            <!-- 常用原因选项 -->
            <GroupBox Grid.Row="1" Header="常用原因（可选）" Margin="0,0,0,12" Padding="10,8">
                <StackPanel>
                    <RadioButton Content="补充遗漏信息"
                                 GroupName="CommonReason"
                                 IsChecked="{Binding IsReason1Selected}"
                                 Margin="0,4" />
                    <RadioButton Content="更正录入错误"
                                 GroupName="CommonReason"
                                 IsChecked="{Binding IsReason2Selected}"
                                 Margin="0,4" />
                    <RadioButton Content="患者要求修改"
                                 GroupName="CommonReason"
                                 IsChecked="{Binding IsReason3Selected}"
                                 Margin="0,4" />
                    <RadioButton Content="医嘱调整"
                                 GroupName="CommonReason"
                                 IsChecked="{Binding IsReason4Selected}"
                                 Margin="0,4" />
                </StackPanel>
            </GroupBox>

            <!-- 修改原因输入框 -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="详细说明："
                           FontSize="13"
                           Foreground="#333"
                           Margin="0,0,0,6" />

                <TextBox Grid.Row="1"
                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="200"
                         MinHeight="80"
                         Padding="8"
                         BorderBrush="#BDBDBD"
                         BorderThickness="1" />
            </Grid>
        </Grid>

        <!-- 按钮区域 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 字数统计 -->
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#999">
                    <Run Text="{Binding ReasonLength, Mode=OneWay}" />
                    <Run Text="/200" />
                </TextBlock>

                <!-- 按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="取消"
                            Command="{Binding CancelCommand}"
                            MinWidth="80"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Background="#F5F5F5"
                            BorderBrush="#BDBDBD" />

                    <Button Content="确认保存"
                            Command="{Binding ConfirmCommand}"
                            MinWidth="100"
                            Padding="16,8"
                            Background="#E65100"
                            Foreground="White"
                            BorderBrush="#E65100"
                            IsEnabled="{Binding CanConfirm}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
