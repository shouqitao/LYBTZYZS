<UserControl x:Class="LYBT.Desktop.MedicalCase.Dialogs.HistoryCopyDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.MedicalCase.Dialogs"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
             d:DesignHeight="550" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=viewmodels:HistoryCopyDialogViewModel}">

    <!--
    Issue #2246: 历史处方复制弹窗
    用于从当前患者历史处方中选择复制药材到当前处方
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColorBrush}" Padding="15,10">
            <TextBlock Text="从历史处方复制" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 患者信息 -->
                <RowDefinition Height="Auto"/>  <!-- 搜索框 -->
                <RowDefinition Height="*"/>      <!-- 历史处方列表 -->
                <RowDefinition Height="Auto"/>  <!-- 预览区域 -->
            </Grid.RowDefinitions>

            <!-- 患者信息 -->
            <Border Grid.Row="0" Background="#E3F2FD" Padding="10" Margin="0,0,0,10" CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前患者: " FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock Text="{Binding PatientName}" Foreground="#1976D2"/>
                </StackPanel>
            </Border>

            <!-- 搜索框 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         FontSize="13"/>
                <TextBlock Text="输入诊断关键词或日期搜索..."
                           IsHitTestVisible="False"
                           Foreground="#999"
                           Padding="10,8"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- 历史处方列表 -->
            <ListView Grid.Row="2"
                      ItemsSource="{Binding FilteredCases}"
                      SelectedItem="{Binding SelectedCase}"
                      BorderBrush="#E0E0E0"
                      BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="就诊日期" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ConsultationDate, StringFormat=yyyy-MM-dd}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="诊断" Width="200" DisplayMemberBinding="{Binding Diagnosis}"/>
                        <GridViewColumn Header="主诉" Width="180" DisplayMemberBinding="{Binding ChiefComplaint}"/>
                        <GridViewColumn Header="状态" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CaseStatus}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 预览区域 -->
            <Border Grid.Row="3"
                    Background="#F5F5F5"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10"
                    Margin="0,10,0,0"
                    MinHeight="80">
                <StackPanel>
                    <TextBlock Text="处方药材预览:" FontWeight="Bold" FontSize="12" Foreground="#666"/>
                    <TextBlock Text="{Binding PreviewText}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#333"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="#666" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Command="{Binding CancelCommand}"
                            Width="80"
                            Margin="0,0,10,0"
                            Padding="8,6"/>
                    <Button Content="确认复制"
                            Command="{Binding ConfirmCommand}"
                            Width="90"
                            Padding="8,6"
                            Background="{DynamicResource PrimaryColorBrush}"
                            Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
