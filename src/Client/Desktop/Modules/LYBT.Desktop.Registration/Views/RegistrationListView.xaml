<UserControl
    x:Class="LYBT.Desktop.Registration.Views.RegistrationListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:LYBT.Desktop.Registration.ViewModels"
    d:DataContext="{d:DesignInstance vm:RegistrationListViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!--  标题栏  -->
            <RowDefinition Height="Auto" />
            <!--  工具栏  -->
            <RowDefinition Height="Auto" />
            <!--  队列列表  -->
            <RowDefinition Height="*" />
            <!--  状态栏  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="24"
            FontWeight="Bold"
            Text="{Binding PageTitle}" />

        <!--  工具栏  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Padding="12,6"
                Command="{Binding RefreshCommand}"
                Content="刷新队列" />

            <Button
                Margin="0,0,8,0"
                Padding="12,6"
                Command="{Binding StartVisitCommand}"
                Content="接诊"
                Visibility="{Binding IsDoctor, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Button
                Padding="12,6"
                Command="{Binding CancelRegistrationCommand}"
                Content="取消挂号"
                Visibility="{Binding IsReceptionist, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!--  队列列表  -->
        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding WaitingQueue}"
            SelectedItem="{Binding SelectedRegistration, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding PatientName}"
                    Header="患者姓名" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding DoctorName}"
                    Header="指派医生" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Source}"
                    Header="挂号来源" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Status}"
                    Header="挂号状态" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                    Header="挂号时间" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  空状态提示  -->
        <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Text="暂无等待中的挂号记录"
            Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!--  状态栏  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,8,0,0"
            Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding QueueCount, StringFormat='共 {0} 条等待记录'}" />

            <TextBlock
                Margin="20,0,0,0"
                Foreground="{DynamicResource DangerBrush}"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!--  加载遮罩  -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#80FFFFFF"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="200"
                    Height="4"
                    Margin="0,0,0,8"
                    IsIndeterminate="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding StatusMessage}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
