<UserControl x:Class="LYBT.Desktop.Registration.Dialogs.RegistrationCreateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.Registration.Dialogs"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             mc:Ignorable="d"
             prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
             d:DesignHeight="500" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance Type=viewmodels:RegistrationCreateDialogViewModel}">

    <Grid Width="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="20,12">
            <TextBlock Text="新建挂号" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,16">
            <StackPanel>
                <!-- 患者选择 -->
                <TextBlock Text="选择患者 *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding PatientSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8"
                             FontSize="13"
                             VerticalContentAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="搜索"
                            Command="{Binding SearchPatientsCommand}"
                            Padding="12,8"
                            Margin="8,0,0,0" />
                </Grid>

                <!-- 搜索中提示 -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#666"
                           Margin="0,0,0,4"
                           Visibility="{Binding IsSearchingPatients, Converter={x:Static converters:Cvt.BoolToVis}}" />

                <!-- 搜索结果下拉 -->
                <Border Margin="0,0,0,12"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="4"
                        MaxHeight="150"
                        Visibility="{Binding ShowPatientResults, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <ListBox ItemsSource="{Binding PatientSearchResults}"
                             BorderThickness="0"
                             Background="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,8"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PhoneNumber}" FontSize="12" Foreground="#666" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Gender, StringFormat=性别: {0}}"
                                                   FontSize="12"
                                                   Foreground="#888"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 已选择的患者 -->
                <Border Margin="0,0,0,16"
                        Background="#E8F5E9"
                        CornerRadius="4"
                        Padding="10,8"
                        Visibility="{Binding SelectedPatient, Converter={x:Static converters:Cvt.NullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="已选: " FontSize="13" Foreground="#388E3C" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedPatient.Name, StringFormat={}{0} ({1}), FallbackValue=''}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#2E7D32"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="更换"
                                Command="{Binding ClearPatientSelectionCommand}"
                                FontSize="12"
                                Padding="6,2"
                                Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- 医生选择 -->
                <TextBlock Text="指派医生 *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding DoctorList}"
                          SelectedItem="{Binding SelectedDoctor}"
                          FontSize="13"
                          Padding="10,8"
                          Margin="0,0,0,16"
                          DisplayMemberPath="RealName"
                          IsEnabled="{Binding IsNotLoading}" />

                <!-- 备注 -->
                <TextBlock Text="备注" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         FontSize="13"
                         MinHeight="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,0,0,12" />

                <!-- 状态消息 -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#D32F2F"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsBusy, Converter={x:Static converters:Cvt.InverseBoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="1"
              Background="#80FFFFFF"
              Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="200" Height="4" Margin="0,0,0,8" IsIndeterminate="True" />
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding StatusMessage}" />
            </StackPanel>
        </Grid>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确认挂号"
                        Command="{Binding ConfirmCommand}"
                        Width="100"
                        Padding="12,8"
                        FontSize="14"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        Margin="0,0,12,0" />
                <Button Content="取消"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        Padding="12,8"
                        FontSize="14" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
