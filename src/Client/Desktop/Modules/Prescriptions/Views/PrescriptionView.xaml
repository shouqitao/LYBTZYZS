<UserControl x:Class="LYBT.Desktop.Prescriptions.Views.PrescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="处方开具" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="处方编号：" FontSize="14" Foreground="#666" Margin="20,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PrescriptionNo}" FontSize="14" FontWeight="SemiBold" Foreground="#2196F3" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding AddHerbCommand}"
                            Background="#4CAF50" Foreground="White" Padding="12,6" Margin="0,0,10,0" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="添加药材" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding ImportFormulaCommand}"
                            Background="#2196F3" Foreground="White" Padding="12,6" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="导入验方" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧：药材列表 -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 列表标题 -->
                    <Border Grid.Row="0" Background="#FAFAFA" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="药材名称" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="剂量" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="单价" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="小计" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="操作" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- 药材列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding PrescriptionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="15,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- 药材名称 -->
                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                    <TextBlock Text="{Binding HerbName}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#999" Margin="0,2,0,0"
                                                              Visibility="{Binding Source, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                </StackPanel>
                                                
                                                <!-- 剂量输入 -->
                                                <Grid Grid.Column="1" HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                                            HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                                            FontSize="14" Padding="5,3"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center" 
                                                              Margin="5,0,0,0" FontSize="13"/>
                                                </Grid>
                                                
                                                <!-- 单价 -->
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Run Text="￥" FontSize="12"/>
                                                    <Run Text="{Binding UnitPrice, StringFormat=F2}" FontSize="14"/>
                                                </TextBlock>
                                                
                                                <!-- 小计 -->
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <Run Text="￥" FontSize="12" Foreground="#FF5722"/>
                                                    <Run Text="{Binding Subtotal, StringFormat=F2}" FontSize="14" Foreground="#FF5722"/>
                                                </TextBlock>
                                                
                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="4" 
                                                        Command="{Binding DataContext.RemoveHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Padding="5"
                                                        HorizontalAlignment="Center" Cursor="Hand">
                                                    <TextBlock Text="🗑️" FontSize="16" Foreground="#F44336"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- 空状态提示 -->
                            <TextBlock Text="暂无药材，请添加药材或导入验方" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      FontSize="14" Foreground="#999" Margin="0,50"
                                      Visibility="{Binding PrescriptionItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- 右侧：设置和价格 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 剂数设置 -->
                <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="剂数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DosageCount, UpdateSourceTrigger=PropertyChanged}"
                                    HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" Padding="5"/>
                            <TextBlock Grid.Column="1" Text="剂" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
                        </Grid>
                        
                        <!-- 快捷剂数 -->
                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding CommonDosageCounts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SetDosageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}" ContentStringFormat="{}{0}剂"
                                                Margin="0,0,5,5" Padding="8,3" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </Grid>
                </Border>
                
                <!-- 价格计算 -->
                <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="价格计算" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <!-- 单剂价格 -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="单剂价格：" FontSize="13"/>
                            <TextBlock Grid.Column="1" FontSize="13">
                                <Run Text="￥"/>
                                <Run Text="{Binding SingleDosagePrice, StringFormat=F2}"/>
                            </TextBlock>
                        </Grid>
                        
                        <!-- 总价格 -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="总价格：" FontSize="13"/>
                            <TextBlock Grid.Column="1" FontSize="13">
                                <Run Text="￥"/>
                                <Run Text="{Binding TotalPrice, StringFormat=F2}"/>
                            </TextBlock>
                        </Grid>
                        
                        <!-- 折扣 -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="折扣：" FontSize="13" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                    HorizontalContentAlignment="Center" Margin="5,0" Padding="3"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding SetDiscountCommand}" CommandParameter="0.8"
                                        Content="8折" Padding="6,2" Margin="0,0,3,0" FontSize="11"/>
                                <Button Command="{Binding SetDiscountCommand}" CommandParameter="0.9"
                                        Content="9折" Padding="6,2" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                        
                        <Rectangle Grid.Row="4" Fill="#DDD" Height="1" Margin="0,5"/>
                        
                        <!-- 应付金额 -->
                        <Grid Grid.Row="5" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="应付金额：" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#FF5722">
                                <Run Text="￥"/>
                                <Run Text="{Binding DiscountedPrice, StringFormat=F2}"/>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
                
                <!-- 用法用量 -->
                <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="用法用量" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <ComboBox Grid.Row="1" 
                                 Text="{Binding Usage}"
                                 ItemsSource="{Binding CommonUsages}"
                                 IsEditable="True"
                                 FontSize="13" Padding="5"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- 医嘱和备注 -->
        <Grid Grid.Row="2" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 医嘱 -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="医嘱" FontSize="13" FontWeight="SemiBold" Margin="10,8,0,5"/>
                    
                    <Grid Grid.Row="1">
                        <TextBox x:Name="MedicalAdviceTextBox"
                                Text="{Binding MedicalAdvice, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" AcceptsReturn="True"
                                MinHeight="60" MaxHeight="80"
                                Padding="10,5" FontSize="13"
                                BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                        
                        <TextBlock Text="{Binding MedicalAdviceHint}"
                                  Foreground="#AAA" FontStyle="Italic"
                                  Margin="10,5,0,0"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ElementName=MedicalAdviceTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
            
            <!-- 备注 -->
            <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="备注" FontSize="13" FontWeight="SemiBold" Margin="10,8,0,5"/>
                    
                    <Grid Grid.Row="1">
                        <TextBox x:Name="RemarkTextBox"
                                Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" AcceptsReturn="True"
                                MinHeight="60" MaxHeight="80"
                                Padding="10,5" FontSize="13"
                                BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                        
                        <TextBlock Text="{Binding RemarkHint}"
                                  Foreground="#AAA" FontStyle="Italic"
                                  Margin="10,5,0,0"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding ElementName=RemarkTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- 操作按钮栏 -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧功能按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding ImportHistoryCommand}"
                            Padding="12,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="导入历史" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding PrintPreviewCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="打印预览" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <!-- 中间状态指示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="14" Foreground="#FF9800" Margin="0,0,5,0"
                              Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="有未保存的更改" FontSize="12" Foreground="#FF9800"
                              Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                
                <!-- 右侧操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding ClearCommand}"
                            Background="#FFF" BorderBrush="#DDD"
                            Padding="15,8" Margin="0,0,10,0">
                        <TextBlock Text="清空" FontSize="14"/>
                    </Button>
                    
                    <Button Command="{Binding SaveCommand}"
                            Background="#4CAF50" Foreground="White"
                            BorderThickness="0" Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="保存处方" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 加载遮罩 -->
        <Border Grid.RowSpan="4" Background="#88000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="正在处理..." Foreground="White" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>