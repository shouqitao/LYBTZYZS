<UserControl x:Class="LYBT.Desktop.Prescriptions.Views.PrescriptionsMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部导航栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔧 处方管理" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="医疗案例ID:" Foreground="White" FontSize="14" Margin="30,0,5,0" VerticalAlignment="Center"
                              Visibility="{Binding HasMedicalCase, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding CurrentMedicalCaseId}" Foreground="#FFF59D" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                              Visibility="{Binding HasMedicalCase, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding SwitchToManagementCommand}"
                            Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1"
                            Padding="15,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="历史管理" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding ReturnToSourceCommand}"
                            Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1"
                            Padding="15,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↩️" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="返回看诊" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <!-- 当前工作模式显示 -->
            <ContentControl Content="{Binding CurrentWorkflowContent}"/>
            
            <!-- 无医疗案例时的引导界面 -->
            <Border Background="#F5F5F5" 
                   Visibility="{Binding HasMedicalCase, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="64" HorizontalAlignment="Center" Foreground="#BDBDBD"/>
                    <TextBlock Text="处方模块" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,10" Foreground="#424242"/>
                    <TextBlock Text="当前没有关联的医疗案例" FontSize="16" HorizontalAlignment="Center" Foreground="#757575" Margin="0,0,0,30"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding SwitchToManagementCommand}"
                                Background="#2196F3" Foreground="White" BorderThickness="0"
                                Padding="20,10" Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="查看历史处方" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Command="{Binding CreateNewPrescriptionCommand}"
                                Background="#4CAF50" Foreground="White" BorderThickness="0"
                                Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="新建处方" FontSize="16"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- 加载状态 -->
            <Border Background="#88000000" 
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="{Binding LoadingMessage}" Foreground="White" FontSize="14" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>