<UserControl x:Class="LYBT.Desktop.Prescriptions.Views.FormulaTemplateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700"
             MinWidth="600" MinHeight="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <materialDesign:ColorZone Mode="PrimaryMid" Grid.Row="0" Padding="16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Foreground="White" />
        </materialDesign:ColorZone>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="分类：" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Margin="0,0,16,0" />

            <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="搜索验方名称、适应症..."
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <Button Grid.Column="3" Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="刷新" Margin="8,0,0,0">
                <materialDesign:PackIcon Kind="Refresh" />
            </Button>
        </Grid>

        <!-- 验方列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredFormulas}"
                  SelectedItem="{Binding SelectedFormula}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" Margin="16,0,16,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
                <DataGridTextColumn Header="适应症" Binding="{Binding Indications}" Width="200" />
                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Content="详情" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <!-- 验方详情提示 -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource MaterialDesignBackground}"
                            Padding="16" Margin="8">
                        <StackPanel>
                            <TextBlock Text="组成：" FontWeight="Bold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="16,2,0,2">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}{2}">
                                                    <Binding Path="HerbName" />
                                                    <Binding Path="Quantity" />
                                                    <Binding Path="Unit" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="用法用量：" FontWeight="Bold" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding Usage}" Margin="16,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- 按钮栏 -->
        <Grid Grid.Row="3" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" IsIndeterminate="{Binding IsLoading}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Margin="0,0,8,0" />

            <Button Grid.Column="1" Command="{Binding SelectCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="选择" Margin="0,0,8,0" MinWidth="80" />

            <Button Grid.Column="2" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Content="取消" MinWidth="80" />
        </Grid>
    </Grid>
</UserControl>
