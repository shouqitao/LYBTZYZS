<UserControl x:Class="LYBT.Desktop.Prescriptions.Views.PrescriptionEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             MinWidth="800" MinHeight="600">
    <materialDesign:DialogHost DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <materialDesign:ColorZone Mode="PrimaryMid" Grid.Row="0" Padding="16">
                <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Foreground="White"/>
            </materialDesign:ColorZone>

            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 基本信息 -->
                    <GroupBox Grid.Row="0" Header="基本信息" Margin="0,0,0,16">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 第一行 -->
                            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Prescription.PrescriptionNo}"
                                     materialDesign:HintAssist.Hint="处方号" IsReadOnly="True"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,8,8"/>

                            <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Prescription.PrescriptionDate}"
                                        materialDesign:HintAssist.Hint="处方日期" IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"
                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="0,0,8,8"/>

                            <ComboBox Grid.Row="0" Grid.Column="2" SelectedValue="{Binding Prescription.Status}"
                                      materialDesign:HintAssist.Hint="状态" IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,8">
                                <ComboBoxItem Content="草稿" Tag="0"/>
                                <ComboBoxItem Content="已确认" Tag="1"/>
                                <ComboBoxItem Content="已发药" Tag="2"/>
                                <ComboBoxItem Content="已完成" Tag="3"/>
                                <ComboBoxItem Content="已取消" Tag="4"/>
                            </ComboBox>

                            <!-- 第二行 - 患者选择区域 -->
                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- 上下文模式：显示患者信息（只读） -->
                                <Grid Grid.Row="0" Visibility="{Binding IsContextMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBox Text="{Binding Prescription.PatientName}"
                                             materialDesign:HintAssist.Hint="患者姓名（来自医案）" 
                                             IsReadOnly="True"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                             Margin="0,0,0,8"
                                             Background="#F5F5F5"/>
                                </Grid>
                                
                                <!-- 常规模式：患者搜索和操作 -->
                                <Grid Grid.Row="1" Visibility="{Binding IsContextMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0" Text="{Binding PatientSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="搜索患者 (姓名/手机号)" 
                                             IsReadOnly="{Binding IsViewMode}"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,4,4">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchPatientsCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    
                                    <Button Grid.Column="1" Command="{Binding SearchPatientsCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"
                                            Content="搜索" Margin="4,0,4,4"/>
                                            
                                    <Button Grid.Column="2" Command="{Binding CreateNewPatientCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"
                                            Content="新建患者" Margin="4,0,0,4"/>
                                </Grid>
                                
                                <!-- 常规模式：患者选择下拉列表 -->
                                <ComboBox Grid.Row="2" ItemsSource="{Binding AvailablePatients}"
                                          SelectedItem="{Binding SelectedPatientFromList}"
                                          materialDesign:HintAssist.Hint="选择患者" 
                                          IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"
                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                          Visibility="{Binding IsContextMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                          Margin="0,0,0,8" MinHeight="56">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding PhoneNumber}" FontSize="12" Opacity="0.7"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Prescription.DoctorName}"
                                     materialDesign:HintAssist.Hint="医生" IsReadOnly="True"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,8"/>

                            <!-- 第三行 -->
                            <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Prescription.Diagnosis}"
                                     materialDesign:HintAssist.Hint="诊断" IsReadOnly="{Binding IsViewMode}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- 处方项目工具栏 -->
                    <ToolBar Grid.Row="1" Margin="0,0,0,8">
                        <Button Command="{Binding AddHerbCommand}" IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0"/>
                                <TextBlock Text="添加药材"/>
                            </StackPanel>
                        </Button>
                        <Separator/>
                        <Button Command="{Binding LoadFormulaTemplateCommand}" IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" Margin="0,0,5,0"/>
                                <TextBlock Text="加载验方模板"/>
                            </StackPanel>
                        </Button>
                        <Separator/>
                        <TextBlock Text="剂数：" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Text="{Binding TotalDoses}" Width="50" IsReadOnly="{Binding IsViewMode}"
                                 materialDesign:HintAssist.Hint="剂数" VerticalAlignment="Center"/>
                    </ToolBar>

                    <!-- 处方项目列表 -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding PrescriptionItems}" 
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="{Binding IsViewMode}" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="药材名称" Binding="{Binding HerbName}" Width="150"/>
                            <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="100"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat='￥{0:F2}'}" Width="100"/>
                            <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat='￥{0:F2}'}" Width="100"/>
                            <DataGridTextColumn Header="用法" Binding="{Binding Usage}" Width="*"/>
                            <DataGridTemplateColumn Header="操作" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.EditHerbCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    IsEnabled="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Content="编辑" Margin="2"/>
                                            <Button Command="{Binding DataContext.RemoveHerbCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    IsEnabled="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBooleanConverter}}"
                                                    Foreground="Red" Content="删除" Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 总计 -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                                   VerticalAlignment="Center" Foreground="Gray"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="总金额：" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat='￥{0:F2}'}" 
                                       VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- 按钮栏 -->
            <Grid Grid.Row="2" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding PreviewCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Content="预览" Margin="0,0,8,0"/>

                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsLoading}" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Margin="8,0"/>

                <Button Grid.Column="2" Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding IsViewMode, Converter={StaticResource InverseBooleanConverter}}"
                        Content="保存" Margin="0,0,8,0" MinWidth="80"/>

                <Button Grid.Column="3" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Content="取消" MinWidth="80"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>