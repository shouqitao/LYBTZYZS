<UserControl x:Class="LYBT.Desktop.AdminWorkstation.Views.AdminWorkstationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <!-- 顶部工具栏 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2E86AB">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 系统标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="管理工作台" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text=" - 凌隐宝堂中医诊所" FontSize="16" Foreground="#E0E0E0" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                </StackPanel>

                <!-- 用户信息 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="当前用户：" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="[管理员]" Foreground="#FFD700" VerticalAlignment="Center" Margin="5,0"/>
                    <Button Content="退出登录"
                            Command="{Binding LogoutCommand}"
                            Margin="20,0,0,0"
                            Padding="10,5"
                            Background="#FF6B6B"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航菜单 -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="管理菜单" FontSize="16" FontWeight="Bold"
                                   Foreground="#333" Margin="15,15,15,10"/>

                        <!-- 用户管理 -->
                        <RadioButton GroupName="AdminMenu"
                                     IsChecked="{Binding IsUserManagementSelected}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="UserManagement"
                                     Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="用户管理" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 药材管理 -->
                        <RadioButton GroupName="AdminMenu"
                                     IsChecked="{Binding IsHerbManagementSelected}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="HerbManagement"
                                     Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌿" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="药材管理" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 患者管理 -->
                        <RadioButton GroupName="AdminMenu"
                                     IsChecked="{Binding IsPatientManagementSelected}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="PatientManagement"
                                     Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏥" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="患者管理" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 验方管理 -->
                        <RadioButton GroupName="AdminMenu"
                                     IsChecked="{Binding IsFormulaManagementSelected}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="FormulaManagement"
                                     Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="验方管理" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 病历管理 -->
                        <RadioButton GroupName="AdminMenu"
                                     IsChecked="{Binding IsMedicalCaseManagementSelected}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="MedicalCaseManagement"
                                     Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="病历管理" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 系统设置 -->
                        <Separator Margin="10,20,10,10"/>
                        <RadioButton GroupName="AdminMenu"
                                     IsChecked="{Binding IsSystemSettingsSelected}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="SystemSettings"
                                     Style="{StaticResource MenuRadioButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="系统设置" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧内容区 -->
            <Border Grid.Column="1" Background="White">
                <ContentControl prism:RegionManager.RegionName="AdminContentRegion"
                                Margin="20"/>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Resources>
        <!-- 菜单按钮样式 -->
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F4F8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E86AB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
</UserControl>