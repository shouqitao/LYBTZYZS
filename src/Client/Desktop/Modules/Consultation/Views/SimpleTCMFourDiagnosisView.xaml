<UserControl x:Class="LYBT.Desktop.Consultation.Views.SimpleTCMFourDiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="中医四诊信息采集" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="（纯文本录入模式）" FontSize="14" Foreground="#666" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 导入来源标记 -->
                <Border Grid.Column="1" Background="#E3F2FD" Padding="10,5" CornerRadius="3"
                        Visibility="{Binding HasImportedData, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ImportSource}" FontSize="12" Foreground="#1976D2"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 望诊 -->
                <Border Grid.Row="0" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="望诊" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="*" Foreground="Red" FontSize="14" Margin="2,0,0,0"/>
                            <TextBlock Text="观察患者面色、神态、形体、舌象等" FontSize="12" Foreground="#888" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="InspectionTextBox" 
                                        Text="{Binding Inspection, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        MinHeight="120" MaxHeight="200"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0"/>
                                
                                <!-- 占位提示文本 -->
                                <TextBlock Text="{Binding InspectionHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,10,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=InspectionTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- 闻诊 -->
                <Border Grid.Row="1" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="闻诊" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="听声音、闻气味等" FontSize="12" Foreground="#888" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="AuscultationTextBox"
                                        Text="{Binding Auscultation, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        MinHeight="120" MaxHeight="200"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0"/>
                                
                                <TextBlock Text="{Binding AuscultationHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,10,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=AuscultationTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- 问诊 -->
                <Border Grid.Row="2" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="问诊" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="*" Foreground="Red" FontSize="14" Margin="2,0,0,0"/>
                            <TextBlock Text="询问主诉、病史、症状等" FontSize="12" Foreground="#888" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="InquiryTextBox"
                                        Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        MinHeight="150" MaxHeight="250"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0"/>
                                
                                <TextBlock Text="{Binding InquiryHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,10,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=InquiryTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- 切诊 -->
                <Border Grid.Row="3" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="切诊" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="脉象、腹诊、按压等" FontSize="12" Foreground="#888" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="PalpationTextBox"
                                        Text="{Binding Palpation, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        MinHeight="120" MaxHeight="200"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0"/>
                                
                                <TextBlock Text="{Binding PalpationHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,10,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=PalpationTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- 操作按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧功能按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding ImportTemplateCommand}" 
                            Padding="12,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="导入模板" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding SaveAsTemplateCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="存为模板" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <!-- 中间状态指示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="14" Foreground="#FF9800" Margin="0,0,5,0"
                              Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="有未保存的更改" FontSize="12" Foreground="#FF9800"
                              Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                
                <!-- 右侧操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding ClearCommand}"
                            Background="#FFF" BorderBrush="#DDD"
                            Padding="15,8" Margin="0,0,10,0">
                        <TextBlock Text="清空" FontSize="14"/>
                    </Button>
                    
                    <Button Command="{Binding SaveCommand}"
                            Background="#4CAF50" Foreground="White"
                            BorderThickness="0" Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="保存四诊信息" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 加载遮罩 -->
        <Border Grid.RowSpan="3" Background="#88000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="正在处理..." Foreground="White" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>