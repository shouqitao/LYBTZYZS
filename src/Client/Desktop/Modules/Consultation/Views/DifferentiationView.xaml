<UserControl x:Class="LYBT.Desktop.Consultation.Views.DifferentiationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="辨证分析" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="（确定证型与治法）" FontSize="14" Foreground="#666" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 智能分析按钮 -->
                <Button Grid.Column="1" Command="{Binding AnalyzeFromFourDiagnosisCommand}"
                        Background="#2196F3" Foreground="White" Padding="12,6" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖" FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="智能分析" FontSize="14"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 中医证型 -->
                <Border Grid.Row="0" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="中医证型" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="*" Foreground="Red" FontSize="14" Margin="2,0,0,0"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="TCMSyndromeTextBox"
                                        Text="{Binding TCMSyndrome, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" 
                                        MinHeight="40"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0" VerticalContentAlignment="Center"/>
                                
                                <TextBlock Text="{Binding TCMSyndromeHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=TCMSyndromeTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                        
                        <!-- 常用证型快速选择 -->
                        <Expander Grid.Row="2" Header="常用证型" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding CommonSyndromes}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectSyndromeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,8" Padding="10,5">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#DDD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#E3F2FD"/>
                                                            <Setter Property="BorderBrush" Value="#2196F3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </Grid>
                </Border>
                
                <!-- 辨证分析过程 -->
                <Border Grid.Row="1" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="辨证分析" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="病因病机、证候特点" FontSize="12" Foreground="#888" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="DifferentiationTextBox"
                                        Text="{Binding DifferentiationAnalysis, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto"
                                        MinHeight="120" MaxHeight="200"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0"/>
                                
                                <TextBlock Text="{Binding DifferentiationHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,10,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=DifferentiationTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- 治法治则 -->
                <Border Grid.Row="2" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="治法治则" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="*" Foreground="Red" FontSize="14" Margin="2,0,0,0"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="TreatmentTextBox"
                                        Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        MinHeight="60" MaxHeight="100"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                                
                                <TextBlock Text="{Binding TreatmentPrincipleHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,10,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=TreatmentTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                        
                        <!-- 常用治法快速添加 -->
                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="常用治法：" FontSize="13" Foreground="#666" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ItemsControl ItemsSource="{Binding CommonTreatmentPrinciples}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.AddTreatmentPrincipleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderBrush="#DDD"
                                                Margin="0,0,6,6" Padding="8,3">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#666"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </Grid>
                </Border>
                
                <!-- 西医诊断（可选） -->
                <Border Grid.Row="3" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="西医诊断" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="（可选）" FontSize="12" Foreground="#888" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="WesternDiagnosisTextBox"
                                        Text="{Binding WesternDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        MinHeight="40"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0" VerticalContentAlignment="Center"/>
                                
                                <TextBlock Text="{Binding WesternDiagnosisHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=WesternDiagnosisTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- 备注说明 -->
                <Border Grid.Row="4" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="备注说明" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock Text="（可选）" FontSize="12" Foreground="#888" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="RemarkTextBox"
                                        Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" AcceptsReturn="True"
                                        MinHeight="60" MaxHeight="120"
                                        Padding="10" FontSize="14"
                                        BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                                
                                <TextBlock Text="{Binding RemarkHint}"
                                          Foreground="#AAA" FontStyle="Italic"
                                          Margin="12,10,0,0"
                                          IsHitTestVisible="False"
                                          Visibility="{Binding ElementName=RemarkTextBox, Path=Text, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- 操作按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧功能按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding ImportFromHistoryCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="导入历史" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <!-- 中间状态指示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="14" Foreground="#FF9800" Margin="0,0,5,0"
                              Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="有未保存的更改" FontSize="12" Foreground="#FF9800"
                              Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                
                <!-- 右侧操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding ClearCommand}"
                            Background="#FFF" BorderBrush="#DDD"
                            Padding="15,8" Margin="0,0,10,0">
                        <TextBlock Text="清空" FontSize="14"/>
                    </Button>
                    
                    <Button Command="{Binding SaveCommand}"
                            Background="#4CAF50" Foreground="White"
                            BorderThickness="0" Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="保存辨证分析" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 加载遮罩 -->
        <Border Grid.RowSpan="3" Background="#88000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="正在处理..." Foreground="White" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>