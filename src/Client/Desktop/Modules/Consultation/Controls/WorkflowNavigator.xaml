<UserControl x:Class="LYBT.Desktop.Consultation.Controls.WorkflowNavigator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="800">
    
    <UserControl.Resources>
        <!-- 步骤完成状态转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- 步骤项样式 -->
        <Style x:Key="StepItemStyle" TargetType="Border">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource White}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <!-- 当前步骤高亮 -->
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource Primary100}" Offset="0"/>
                                <GradientStop Color="{DynamicResource Primary50}" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <!-- 已完成步骤 -->
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </DataTrigger>
                <!-- 未解锁步骤 -->
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="No"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- 连接线样式 -->
        <Style x:Key="ConnectorStyle" TargetType="Line">
            <Setter Property="Stroke" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="4,2"/>
            <Setter Property="Y1" Value="40"/>
            <Setter Property="Y2" Value="40"/>
            <Setter Property="Margin" Value="-8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource SecondaryHueMidBrush}"/>
                    <Setter Property="StrokeDashArray" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 进度条 -->
        <ProgressBar Grid.Row="0" 
                     Height="4"
                     Value="{Binding Progress}"
                     Maximum="100"
                     Foreground="{DynamicResource SecondaryHueMidBrush}"
                     Background="{DynamicResource MaterialDesignDivider}"/>
        
        <!-- 步骤导航器 -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="16,8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- 步骤卡片 -->
                            <Border Style="{StaticResource StepItemStyle}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.NavigateToStepCommand, 
                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- 图标和标题 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="●" 
                                                   Width="24" Height="24"
                                                   Foreground="{Binding IconColor}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"/>
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- 描述 -->
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               TextWrapping="Wrap"
                                               Margin="0,4"/>
                                    
                                    <!-- 状态指示器 -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <!-- 完成标记 -->
                                        <TextBlock Text="✓" 
                                                   Width="16" Height="16"
                                                   Foreground="Green"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsCompleted, 
                                                               Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ToolTip="已完成"/>
                                        
                                        <!-- 进行中标记 -->
                                        <TextBlock Text="◯" 
                                                   Width="16" Height="16"
                                                   Foreground="Blue"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsCurrent, 
                                                               Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ToolTip="当前步骤"/>
                                        
                                        <!-- 锁定标记 -->
                                        <TextBlock Text="🔒" 
                                                   Width="16" Height="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsLocked, 
                                                               Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ToolTip="需完成前置步骤"/>
                                        
                                        <!-- 快捷键提示 -->
                                        <TextBlock Text="{Binding ShortcutKey}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- 连接线（最后一个步骤不显示） -->
                            <Line x:Name="Connector"
                                  Style="{StaticResource ConnectorStyle}"
                                  X1="188" X2="196"
                                  Visibility="{Binding ShowConnector, 
                                              Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- 快捷键提示浮层 -->
        <Border Grid.Row="1" 
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="16"
                Background="{DynamicResource MaterialDesignToolTipBackground}"
                CornerRadius="4"
                Padding="8,4"
                Opacity="0.8">
            <TextBlock FontSize="10" Foreground="White">
                <Run Text="快捷键："/>
                <Run Text="Alt+1~4" FontWeight="Bold"/>
                <Run Text=" 切换步骤 | "/>
                <Run Text="Enter" FontWeight="Bold"/>
                <Run Text=" 下一步 | "/>
                <Run Text="Esc" FontWeight="Bold"/>
                <Run Text=" 上一步"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>