<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- P/Invoke需要允许不安全代码 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.CardReader</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 身份证读卡器模块 | 支持多厂商读卡器 | 患者快速查询</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright (c) 凌隐宝堂中医诊所 2026</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-cardreader-initial</InformationalVersion>

    <!-- Package Information -->
    <PackageId>LYBT.Desktop.CardReader</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT身份证读卡器模块 - 多厂商适配器模式 | 华大HD100 | 患者快速查询创建</PackageDescription>
    <PackageTags>WPF;身份证;读卡器;华大;HD100;P/Invoke;患者管理</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Naming Configuration -->
    <AssemblyName>LYBT.Desktop.CardReader</AssemblyName>
    <RootNamespace>LYBT.Desktop.CardReader</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
    <Page Remove="bin\**" />
  </ItemGroup>

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Prism.Wpf" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Infrastructure Dependencies">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
  </ItemGroup>

  <!-- 原生DLL文件 - 部署时需要确保DLL在输出目录 -->
  <ItemGroup Label="Native DLL Files">
    <!--
      注意：HDstdapi.dll等读卡器原生DLL需要：
      1. 放置在Native目录下
      2. 设置为"始终复制"到输出目录
      3. 根据目标平台(x86/x64)选择正确版本
    -->
    <None Update="Native\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
