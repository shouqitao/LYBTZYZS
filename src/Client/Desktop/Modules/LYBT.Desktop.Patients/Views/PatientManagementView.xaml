<!--
    PatientManagementView - 患者管理视图
    Issue #2000 - Task 2.7: 应用BaseMasterDataListView模板

    重构说明：
    - 使用 BaseMasterDataListView 替代原有的三行布局
    - 移除重复的工具栏、数据表格、分页控件代码
    - 通过 Columns 和 ActionButtons 属性定义患者特定内容
-->
<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- Issue #2000: 应用 BaseMasterDataListView 模板 -->
    <views:BaseMasterDataListView
        ItemsSource="{Binding Items}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
        ShowCheckBoxColumn="True"
        SearchText="{Binding SearchText, Mode=TwoWay}"
        SearchCommand="{Binding SearchCommand}"
        CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
        TotalPages="{Binding TotalPages}"
        PageSize="{Binding PageSize, Mode=TwoWay}"
        TotalCount="{Binding TotalCount}"
        FirstPageCommand="{Binding FirstPageCommand}"
        PreviousPageCommand="{Binding PreviousPageCommand}"
        NextPageCommand="{Binding NextPageCommand}"
        LastPageCommand="{Binding LastPageCommand}"
        IsBusy="{Binding IsBusy}"
        BusyMessage="{Binding BusyMessage}"
        EmptyStateText="暂无患者数据">

        <!-- 定义患者特定的 DataGrid 列 -->
        <views:BaseMasterDataListView.Columns>
            <!-- 姓名 -->
            <DataGridTextColumn Header="姓名"
                                Binding="{Binding Name}"
                                Width="120" />

            <!-- 性别 -->
            <DataGridTextColumn Header="性别"
                                Binding="{Binding Gender}"
                                Width="80" />

            <!-- 年龄 -->
            <DataGridTextColumn Header="年龄"
                                Binding="{Binding Age}"
                                Width="80" />

            <!-- 手机号 -->
            <DataGridTextColumn Header="手机号"
                                Binding="{Binding PhoneNumber}"
                                Width="140" />

            <!-- 身份证号 -->
            <DataGridTextColumn Header="身份证号"
                                Binding="{Binding IdNumber}"
                                Width="180" />

            <!-- 就诊次数 -->
            <DataGridTextColumn Header="就诊次数"
                                Binding="{Binding VisitCount}"
                                Width="100" />

            <!-- 操作列 - OpenSpec: add-global-audit-system 增加审计按钮 -->
            <DataGridTemplateColumn Header="操作" Width="280">
                <DataGridTemplateColumn.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                    </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                            <Button Content="查看"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="4,0"
                                    ToolTip="查看患者详情"
                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="编辑"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="4,0"
                                    ToolTip="编辑患者信息"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <!-- OpenSpec: add-global-audit-system -->
                            <Button Content="记录"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="4,0"
                                    ToolTip="查看变更记录"
                                    Command="{Binding DataContext.ShowAuditLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="删除"
                                    Style="{StaticResource DangerButton}"
                                    Margin="4,0"
                                    ToolTip="删除患者（软删除）"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </views:BaseMasterDataListView.Columns>

        <!-- 定义操作按钮区域 -->
        <views:BaseMasterDataListView.ActionButtons>
            <StackPanel Orientation="Horizontal">
                <Button Content="批量删除"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding BatchDeleteCommand}"
                        ToolTip="删除选中的患者"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Command="{Binding AddCommand}"
                        Style="{StaticResource SuccessButton}"
                        Margin="{StaticResource SpacingSmall}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✚" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="新增患者" />
                    </StackPanel>
                </Button>

                <!-- Epic #1934: 批量导入/导出功能 -->
                <Button Command="{Binding ImportCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="{StaticResource SpacingSmall}"
                        ToolTip="批量导入患者数据（支持Excel .xlsx格式）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="导入患者" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExportCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="{StaticResource SpacingSmall}"
                        ToolTip="导出当前筛选的患者数据到Excel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="导出患者" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding DownloadTemplateCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource SpacingSmall}"
                        ToolTip="下载Excel导入模板（包含示例数据）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="下载模板" />
                    </StackPanel>
                </Button>

                <Button Content="刷新"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="🏠 返回主页"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NavigateToHomeCommand}"
                        ToolTip="返回管理员主页"
                        Margin="{StaticResource SpacingSmall}" />
            </StackPanel>
        </views:BaseMasterDataListView.ActionButtons>
    </views:BaseMasterDataListView>
</UserControl>
