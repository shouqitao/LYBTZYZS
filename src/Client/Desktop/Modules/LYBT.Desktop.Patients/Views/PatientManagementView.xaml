<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- Phase 1: 迁移到UnifiedDesignSystem - 删除所有Modern样式 -->
        <!-- 所有样式现在从UnifiedDesignSystem.xaml (应用级资源) 继承 -->
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                Background="White"
                Padding="40,24"
                Margin="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 搜索区域 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索患者姓名、手机号或身份证号">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索"
                            Margin="12,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}" />
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,12,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✚" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="新增患者"/>
                        </StackPanel>
                    </Button>                    <Button Content="刷新"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,12,0" />
                    <Button Content="🏠 返回主页"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToHomeCommand}"
                            ToolTip="返回管理员主页" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格区域 -->
        <Border Grid.Row="1"
                Background="White"
                Margin="0,0,0,2">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource BaseDataGrid}"
                      RowStyle="{StaticResource BaseDataGridRow}"
                      ColumnHeaderStyle="{StaticResource BaseDataGridColumnHeader}">
                <DataGrid.Columns>
                    <!-- 姓名 -->
                    <DataGridTextColumn Header="姓名"
                                        Binding="{Binding Name}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="20,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 性别 -->
                    <DataGridTextColumn Header="性别"
                                        Binding="{Binding Gender}"
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 年龄 -->
                    <DataGridTextColumn Header="年龄"
                                        Binding="{Binding Age}"
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 手机号 -->
                    <DataGridTextColumn Header="手机号"
                                        Binding="{Binding PhoneNumber}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 身份证号 -->
                    <DataGridTextColumn Header="身份证号"
                                        Binding="{Binding IdNumber}"
                                        Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 就诊次数 -->
                    <DataGridTextColumn Header="就诊次数"
                                        Binding="{Binding VisitCount}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 操作 -->
                    <DataGridTemplateColumn Header="操作" Width="280">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                                    <Button Content="查看"
                                            Style="{StaticResource SecondaryButton}"
                                            Background="#3B82F6"
                                            Foreground="White"
                                            Margin="4,0"
                                            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="编辑"
                                            Style="{StaticResource SecondaryButton}"
                                            Background="#10B981"
                                            Foreground="White"
                                            Margin="4,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="删除"
                                            Style="{StaticResource DangerButton}"
                                            Margin="4,0"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部状态栏和分页 -->
        <Border Grid.Row="2"
                Background="White"
                Padding="40,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF"
                            CornerRadius="8"
                            Padding="16,8">
                        <TextBlock FontSize="14"
                                   Foreground="#1E40AF"
                                   FontWeight="Medium"
                                   Text="{Binding StatusMessage}" />
                    </Border>
                </StackPanel>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="首页"
                            Style="{StaticResource SecondaryButton}"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            Margin="4,0"
                            Command="{Binding FirstPageCommand}" />

                    <Button Content="上一页"
                            Style="{StaticResource SecondaryButton}"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            Margin="4,0"
                            Command="{Binding PreviousPageCommand}" />

                    <Border Background="#3B82F6"
                            CornerRadius="8"
                            Padding="20,8"
                            Margin="8,0"
                            MinWidth="100">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage" />
                                    <Binding Path="TotalPages" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>

                    <Button Content="下一页"
                            Style="{StaticResource SecondaryButton}"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            Margin="4,0"
                            Command="{Binding NextPageCommand}" />

                    <Button Content="末页"
                            Style="{StaticResource SecondaryButton}"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            Margin="4,0"
                            Command="{Binding LastPageCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
