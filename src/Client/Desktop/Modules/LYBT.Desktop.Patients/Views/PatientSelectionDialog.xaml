<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="800" Height="600">

    <!-- Issue #1487: 移除自定义样式，使用全局样式系统 (Issue #1484) -->

    <Border Background="White" Padding="20" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题 -->
                <RowDefinition Height="Auto"/> <!-- 搜索栏 -->
                <RowDefinition Height="*"/>    <!-- 患者列表 -->
                <RowDefinition Height="Auto"/> <!-- 操作按钮 -->
            </Grid.RowDefinitions>

            <!-- Row 0: 标题 (Issue #1487: 使用全局样式) -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       Style="{StaticResource H1TextBlock}"/>

            <!-- Row 1: 搜索栏 (Issue #1487: 拼音码提示水印 + 全局样式) -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索框容器 (支持水印提示) -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             FontSize="14"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderBrush}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- 水印提示文字 (Issue #1487: 拼音码提示) -->
                    <TextBlock Text="姓名/拼音码/手机号"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Padding="12,10"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchKeyword}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1"
                        Content="搜索"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="80"
                        Margin="10,0,0,0"/>

                <Button Grid.Column="2"
                        Content="刷新"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="80"
                        Margin="10,0,0,0"/>
            </Grid>

            <!-- Row 2: 患者列表 (Issue #1487: 启用虚拟化) -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,15">
                <DataGrid ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          AlternatingRowBackground="{StaticResource AlternateRowBrush}"
                          RowHeight="40"
                          FontSize="14"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.InputBindings>
                        <!-- 双击选择 -->
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding DoubleClickSelectCommand}"
                                      CommandParameter="{Binding SelectedPatient}"/>
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <!-- 姓名 -->
                        <DataGridTextColumn Header="姓名"
                                            Binding="{Binding Name}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 性别 -->
                        <DataGridTextColumn Header="性别"
                                            Binding="{Binding Gender}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 年龄 -->
                        <DataGridTextColumn Header="年龄"
                                            Binding="{Binding Age}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 手机号 -->
                        <DataGridTextColumn Header="手机号码"
                                            Binding="{Binding PhoneNumber}"
                                            Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 最近就诊 -->
                        <DataGridTextColumn Header="最近就诊"
                                            Binding="{Binding LastVisitDate, StringFormat='yyyy-MM-dd'}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Row 3: 操作按钮 (Issue #1487: 使用全局样式) -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="新建患者"
                        Command="{Binding NewPatientCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Margin="0,0,10,0"/>
                <Button Content="确定"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="80"
                        Margin="0,0,10,0"/>
                <Button Content="取消"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="80"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
