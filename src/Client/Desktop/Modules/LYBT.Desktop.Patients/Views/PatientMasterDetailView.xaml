<!--
    PatientMasterDetailView - 患者Master-Detail视图
    OpenSpec: refactor-master-detail-layout

    重构说明：
    - 合并PatientManagementView和PatientDetailView为单一视图
    - 左侧40%显示患者列表，右侧60%显示详情/编辑
    - 复用PatientViewControl和PatientEditControl

    UI优化 (2025-12-16):
    - 应用统一DataGrid样式(MasterDetailDataGridStyle)
    - 应用统一分页样式
-->
<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientMasterDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
             xmlns:patientControls="clr-namespace:LYBT.Desktop.Patients.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- 转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <controls:MasterDetailLayout HasSelection="{Binding HasSelection}">
        <!-- ========================================
             Master区域: 患者列表
             ======================================== -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
                    <RowDefinition Height="Auto"/>  <!-- 搜索框 -->
                    <RowDefinition Height="*"/>     <!-- 列表 -->
                    <RowDefinition Height="Auto"/>  <!-- 分页 -->
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <controls:DataGridToolbar Grid.Row="0"
                                          CreateCommand="{Binding AddCommand}"
                                          RefreshCommand="{Binding RefreshCommand}"
                                          BatchDeleteCommand="{Binding BatchDeleteCommand}"/>

                <!-- 搜索框 -->
                <controls:SearchBox Grid.Row="1"
                                    SearchText="{Binding SearchText, Mode=TwoWay}"
                                    SearchCommand="{Binding SearchCommand}"
                                    Placeholder="搜索患者姓名/手机号..."
                                    Margin="12,8"/>

                <!-- 患者列表 - 使用统一DataGrid样式，支持批量选择 -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                          behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                          Style="{StaticResource MasterDetailDataGridStyle}"
                          RowHeaderWidth="0"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <!-- 姓名 -->
                        <DataGridTextColumn Header="姓名"
                                            Binding="{Binding Name}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 性别 - 使用EnumDescriptionConverter转换Gender枚举 -->
                        <DataGridTextColumn Header="性别"
                                            Binding="{Binding Gender, Converter={StaticResource EnumDescriptionConverter}}"
                                            Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 年龄 -->
                        <DataGridTextColumn Header="年龄"
                                            Width="50">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Age" StringFormat="{}{0}岁"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 手机号 -->
                        <DataGridTextColumn Header="手机号"
                                            Binding="{Binding PhoneNumber}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 地址 -->
                        <DataGridTextColumn Header="地址"
                                            Binding="{Binding Address}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <!-- 行右键菜单 -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑" Command="{Binding EditCommand}"/>
                            <Separator/>
                            <MenuItem Header="查看病历" Command="{Binding ViewMedicalRecordsCommand}"/>
                            <MenuItem Header="新建问诊" Command="{Binding NewConsultationCommand}"/>
                            <Separator/>
                            <MenuItem Header="审计日志" Command="{Binding ShowAuditLogCommand}"/>
                            <Separator/>
                            <MenuItem Header="删除" Command="{Binding DeleteCurrentCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- 分页控件 - 使用统一样式 -->
                <Border Grid.Row="3" Style="{StaticResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 统计信息 -->
                        <TextBlock Grid.Column="0" Style="{StaticResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                            <Run Text="条记录"/>
                        </TextBlock>

                        <!-- 每页条数选择 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="每页" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding PageSizes}"
                                      SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                      Width="60"
                                      Margin="6,0"
                                      VerticalAlignment="Center"
                                      IsEditable="False"/>
                            <TextBlock Text="条" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        </StackPanel>

                        <!-- 分页按钮 -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="首页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding FirstPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="上一页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding PreviousPageCommand}"
                                    Margin="0,0,4,0"/>
                            <TextBlock Style="{StaticResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="下一页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding NextPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="末页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding LastPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="4"
                                         IsLoading="{Binding IsLoading}"
                                         LoadingText="{Binding BusyMessage}"/>
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!-- ========================================
             Detail区域: 患者详情/编辑
             ======================================== -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
                    <RowDefinition Height="*"/>     <!-- 内容 -->
                </Grid.RowDefinitions>

                <!-- 详情工具栏 -->
                <controls:DetailToolbar Grid.Row="0"
                                        Title="{Binding DetailTitle}"
                                        IsEditMode="{Binding IsEditMode}"
                                        EditCommand="{Binding EditCommand}"
                                        SaveCommand="{Binding SaveCommand}"
                                        CancelCommand="{Binding CancelCommand}"
                                        DeleteCommand="{Binding DeleteCurrentCommand}"/>

                <!-- 查看模式内容 -->
                <patientControls:PatientViewControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    PatientName="{Binding CurrentDetail.Name}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode}"
                    Gender="{Binding CurrentDetail.Gender}"
                    BirthDate="{Binding CurrentDetail.BirthDate}"
                    Age="{Binding CurrentDetail.Age}"
                    IdNumber="{Binding CurrentDetail.IdNumber}"
                    MaritalStatus="{Binding CurrentDetail.MaritalStatus}"
                    BloodType="{Binding CurrentDetail.BloodType}"
                    PhoneNumber="{Binding CurrentDetail.PhoneNumber}"
                    Address="{Binding CurrentDetail.Address}"
                    EmergencyContactName="{Binding CurrentDetail.EmergencyContactName}"
                    EmergencyContactPhone="{Binding CurrentDetail.EmergencyContactPhone}"
                    EmergencyContactRelation="{Binding CurrentDetail.EmergencyContactRelation}"
                    AllergyHistory="{Binding CurrentDetail.AllergyHistory}"
                    MedicalHistory="{Binding CurrentDetail.MedicalHistory}"
                    LastVisitTime="{Binding CurrentDetail.LastVisitTime}"
                    VisitCount="{Binding CurrentDetail.VisitCount}"
                    Status="{Binding CurrentDetail.Status}"
                    CreatedAt="{Binding CurrentDetail.CreatedAt}"
                    UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                    ShowStatus="True"
                    Margin="16"/>

                <!-- 编辑模式内容 - OpenSpec: refactor-masterdetail-editmode 直接绑定CurrentDetail -->
                <patientControls:PatientEditControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    PatientName="{Binding CurrentDetail.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Gender="{Binding CurrentDetail.Gender, Mode=TwoWay}"
                    GenderOptions="{Binding GenderOptions}"
                    BirthDate="{Binding CurrentDetail.BirthDate, Mode=TwoWay}"
                    Age="{Binding CurrentDetail.Age}"
                    IdNumber="{Binding CurrentDetail.IdNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PhoneNumber="{Binding CurrentDetail.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Address="{Binding CurrentDetail.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Status="{Binding CurrentDetail.Status, Mode=TwoWay}"
                    StatusOptions="{Binding StatusOptions}"
                    ShowStatus="True"
                    Margin="16"/>

                <!-- 详情加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="2"
                                         IsLoading="{Binding IsLoadingDetail}"
                                         LoadingText="加载详情中..."/>
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!-- ========================================
             空状态: 未选中患者时显示
             ======================================== -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择患者"
                Subtitle="从左侧列表中选择一位患者查看详情，或点击新增按钮创建新患者"
                ActionText="新增患者"
                ActionCommand="{Binding AddCommand}"/>
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</UserControl>
