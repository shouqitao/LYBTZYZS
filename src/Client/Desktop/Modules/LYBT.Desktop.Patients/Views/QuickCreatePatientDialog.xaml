<UserControl x:Class="LYBT.Desktop.Patients.Views.QuickCreatePatientDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="300" Height="400">

    <Border Background="White" Padding="20" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题 -->
                <RowDefinition Height="*"/>    <!-- 表单 -->
                <RowDefinition Height="Auto"/> <!-- 操作按钮 -->
            </Grid.RowDefinitions>

            <!-- Row 0: 标题 -->
            <TextBlock Grid.Row="0"
                       Text="新建患者"
                       Style="{StaticResource H2TextBlock}"/>

            <!-- Row 1: 表单 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
                <StackPanel>
                    <!-- 姓名 (必填) -->
                    <TextBlock Text="姓名 *" Style="{StaticResource LabelTextBlock}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             FontSize="14"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderBrush}"
                             Margin="0,0,0,15"/>

                    <!-- 性别 (必填) -->
                    <TextBlock Text="性别 *" Style="{StaticResource LabelTextBlock}" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton Content="男"
                                     IsChecked="{Binding IsMale}"
                                     GroupName="Gender"
                                     FontSize="14"
                                     Margin="0,0,20,0"
                                     VerticalContentAlignment="Center"/>
                        <RadioButton Content="女"
                                     IsChecked="{Binding IsFemale}"
                                     GroupName="Gender"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- 年龄 (必填) -->
                    <TextBlock Text="年龄 *" Style="{StaticResource LabelTextBlock}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             FontSize="14"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderBrush}"
                             Margin="0,0,0,15"/>

                    <!-- 手机号码 (必填) -->
                    <TextBlock Text="手机号码 *" Style="{StaticResource LabelTextBlock}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             FontSize="14"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderBrush}"
                             Margin="0,0,0,15"
                             MaxLength="11"/>

                    <!-- 拼音码 (自动生成，可编辑) -->
                    <TextBlock Text="拼音码" Style="{StaticResource LabelTextBlock}" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,5">
                        <TextBox Text="{Binding PinyinCode, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 FontSize="14"
                                 Padding="10,8"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource BorderBrush}"/>

                        <!-- 水印提示 (自动生成) -->
                        <TextBlock Text="自动生成"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Padding="12,10"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PinyinCode}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- 提示信息 -->
                    <TextBlock Text="* 为必填项"
                               Style="{StaticResource CaptionTextBlock}"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Row 2: 操作按钮 -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="保存"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="80"
                        Margin="0,0,10,0"/>
                <Button Content="取消"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Width="80"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
