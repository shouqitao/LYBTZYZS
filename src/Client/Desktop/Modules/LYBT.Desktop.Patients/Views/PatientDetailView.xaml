<!--
    PatientDetailView - 患者详情视图
    OpenSpec: refactor-detail-view-container

    重构说明：
    - 使用 BaseDetailContainer 容器实现查看/编辑模式分离
    - ViewContent: 纯展示模式，使用 TextBlock 显示只读值
    - EditContent: 表单编辑模式，使用 TextBox/ComboBox/DatePicker 输入
-->
<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <views:BaseDetailContainer
        Title="{Binding PageTitle}"
        IsEditMode="{Binding IsEditMode, Mode=OneWay}"
        GoBackCommand="{Binding GoBackCommand}"
        SwitchToEditCommand="{Binding SwitchToEditModeCommand}"
        SaveCommand="{Binding SubmitCommand}"
        CancelCommand="{Binding CancelCommand}"
        SaveButtonText="{Binding SaveButtonText}"
        IsLoading="{Binding IsLoading}"
        LoadingMessage="{Binding StatusMessage}">

        <!-- ========================================
             查看模式内容 (ViewContent)
             使用纯展示控件，无输入框边框
             ======================================== -->
        <views:BaseDetailContainer.ViewContent>
            <StackPanel>
                <!-- 基本信息卡片 -->
                <controls:InfoCard Title="基本信息">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：患者姓名、拼音码 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="患者姓名" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="拼音码" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding PinYinCode}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <!-- 第二行：性别、出生日期 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="性别" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedGender}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="出生日期" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding BirthDate, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <!-- 第三行：年龄、身份证号 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="年龄" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Age, StringFormat={}{0} 岁}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="身份证号" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding IdNumber}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <!-- 第四行：手机号码、地址 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="手机号码" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding PhoneNumber}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="地址" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Address}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <!-- 第五行：状态 -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelValueStyle}"
                                        Visibility="{Binding IsEditOrViewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="状态" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </views:BaseDetailContainer.ViewContent>

        <!-- ========================================
             编辑模式内容 (EditContent)
             使用表单输入控件
             ======================================== -->
        <views:BaseDetailContainer.EditContent>
            <StackPanel>
                <!-- 基本信息卡片 -->
                <controls:InfoCard Title="基本信息">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：患者姓名、拼音码 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="患者姓名 *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="拼音码（自动生成）" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding PinYinCode, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="{StaticResource BackgroundBrush}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第二行：性别、出生日期 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="性别" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox SelectedItem="{Binding SelectedGender}"
                                          ItemsSource="{Binding GenderOptions}"
                                          MinHeight="44"
                                          Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="出生日期" Style="{StaticResource FormLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding BirthDate}"
                                            MinHeight="44"/>
                            </StackPanel>

                            <!-- 第三行：年龄（只读）、身份证号 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="年龄" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox IsReadOnly="True"
                                         Background="{StaticResource BackgroundBrush}"
                                         MinHeight="44"
                                         Padding="12,10">
                                    <TextBox.Text>
                                        <MultiBinding StringFormat="{}{0} 岁">
                                            <Binding Path="Age" Mode="OneWay"/>
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="身份证号 *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第四行：手机号码、地址 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="手机号码" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="地址" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第五行：状态 -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,20"
                                        Visibility="{Binding IsEditOrViewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="状态" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox SelectedItem="{Binding Status}"
                                          ItemsSource="{Binding StatusOptions}"
                                          MinHeight="44"
                                          Padding="12,10"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </views:BaseDetailContainer.EditContent>
    </views:BaseDetailContainer>
</UserControl>
