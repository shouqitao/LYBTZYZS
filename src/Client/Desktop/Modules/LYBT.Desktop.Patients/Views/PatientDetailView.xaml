<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 卡片阴影 -->
            <DropShadowEffect x:Key="CardShadow"
                              BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.08"
                              Color="#000000"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <Grid Grid.Row="0" Margin="40,28,40,0">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="32,24"
                    Effect="{StaticResource CardShadow}">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 返回按钮 -->
                    <Button Grid.Column="0"
                            Command="{Binding BackCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#64748B"
                            FontSize="15"
                            FontWeight="Medium"
                            Cursor="Hand"
                            Padding="14,10"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text=""
                                                               FontSize="14"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="返回"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="Foreground" Value="#475569" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 标题 -->
                    <TextBlock Grid.Column="1"
                               Text="患者详情"
                               FontSize="26"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#1E293B"
                               Margin="20,0,0,0" />

                                    </Grid>
            </Border>
        </Grid>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,28,40,28" Background="#F8FAFC">
                                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                                                <!-- 详细信息 -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="16"
                        Padding="32,24"
                        Effect="{StaticResource CardShadow}"
                        Margin="0,0,0,28">
                    <Expander Header="详细信息" IsExpanded="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 第一行 -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="证件号码:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Patient.IdNumber, Mode=TwoWay}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     FontSize="15"
                                     MinHeight="44"
                                     Padding="12,10"
                                     VerticalContentAlignment="Center"
                                     Margin="0,12,16,12" />

                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="联系电话:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding Patient.PhoneNumber, Mode=TwoWay}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     FontSize="15"
                                     MinHeight="44"
                                     Padding="12,10"
                                     VerticalContentAlignment="Center"
                                     Margin="0,12" />

                            <!-- 第二行 -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="家庭住址:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Top"
                                       Margin="0,12" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                     Text="{Binding Patient.Address, Mode=TwoWay}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     FontSize="15"
                                     TextWrapping="Wrap"
                                     MinHeight="60"
                                     Padding="12,10"
                                     VerticalContentAlignment="Top"
                                     Margin="0,12" />

                            <!-- 第三行 -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="紧急联系人:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Patient.EmergencyContactName, Mode=TwoWay}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     FontSize="15"
                                     MinHeight="44"
                                     Padding="12,10"
                                     VerticalContentAlignment="Center"
                                     Margin="0,12,16,12" />

                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Text="联系电话:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />
                            <TextBox Grid.Row="2" Grid.Column="3"
                                     Text="{Binding Patient.EmergencyContactPhone, Mode=TwoWay}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     FontSize="15"
                                     MinHeight="44"
                                     Padding="12,10"
                                     VerticalContentAlignment="Center"
                                     Margin="0,12" />

                            <!-- 第四行 -->
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="创建时间:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,12,16,12" />

                            <TextBlock Grid.Row="3" Grid.Column="2"
                                       Text="更新时间:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />
                            <TextBlock Grid.Row="3" Grid.Column="3"
                                       Text="{Binding UpdatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />

                            <!-- 第五行：拼音码和年龄 -->
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="拼音码:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding Patient.PinYinCode}"
                                       FontSize="15"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       Margin="0,12,16,12" />

                            <TextBlock Grid.Row="4" Grid.Column="2"
                                       Text="年龄:"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,12" />
                            <TextBlock Grid.Row="4" Grid.Column="3"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,12">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} 岁">
                                        <Binding Path="Patient.Age" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Expander>
                </Border>

                                <!-- 就诊历史快速预览 -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="16"
                        Padding="32,24"
                        Effect="{StaticResource CardShadow}"
                        Margin="0,0,0,28">
                    <Expander Header="就诊记录" IsExpanded="False">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="最近就诊记录将在此显示"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center"
                                           Margin="20" />
                                <Button Content="查看完整病历"
                                        Command="{Binding ViewMedicalHistoryCommand}"
                                        HorizontalAlignment="Center"
                                        Padding="16,8"
                                        Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="50" Height="50"
                             IsIndeterminate="True"
                             Margin="0,0,0,16" />
                <TextBlock Text="正在加载患者信息..."
                           Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
