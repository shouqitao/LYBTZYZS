<!--
    PatientDetailView - 患者详情视图
    OpenSpec: extract-detail-controls Task 3.3

    重构说明：
    - 使用 BaseDetailContainer 容器实现查看/编辑模式分离
    - ViewContent: 使用 PatientViewControl 预览控件
    - EditContent: 使用 PatientEditControl 编辑控件
-->
<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:patientControls="clr-namespace:LYBT.Desktop.Patients.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <views:BaseDetailContainer
        Title="{Binding PageTitle}"
        IsEditMode="{Binding IsEditMode, Mode=OneWay}"
        GoBackCommand="{Binding GoBackCommand}"
        SwitchToEditCommand="{Binding SwitchToEditModeCommand}"
        SaveCommand="{Binding SubmitCommand}"
        CancelCommand="{Binding CancelCommand}"
        SaveButtonText="{Binding SaveButtonText}"
        IsLoading="{Binding IsLoading}"
        LoadingMessage="{Binding StatusMessage}">

        <!-- ========================================
             查看模式内容 (ViewContent)
             使用 PatientViewControl 预览控件
             ======================================== -->
        <views:BaseDetailContainer.ViewContent>
            <patientControls:PatientViewControl
                PatientName="{Binding Name}"
                PinYinCode="{Binding PinYinCode}"
                Gender="{Binding SelectedGender}"
                BirthDate="{Binding BirthDate}"
                Age="{Binding Age}"
                IdNumber="{Binding IdNumber}"
                PhoneNumber="{Binding PhoneNumber}"
                Address="{Binding Address}"
                Status="{Binding Status}"
                ShowStatus="{Binding IsEditOrViewMode}"/>
        </views:BaseDetailContainer.ViewContent>

        <!-- ========================================
             编辑模式内容 (EditContent)
             使用 PatientEditControl 编辑控件
             ======================================== -->
        <views:BaseDetailContainer.EditContent>
            <patientControls:PatientEditControl
                PatientName="{Binding Name, Mode=TwoWay}"
                PinYinCode="{Binding PinYinCode}"
                Gender="{Binding SelectedGender, Mode=TwoWay}"
                GenderOptions="{Binding GenderOptions}"
                BirthDate="{Binding BirthDate, Mode=TwoWay}"
                Age="{Binding Age}"
                IdNumber="{Binding IdNumber, Mode=TwoWay}"
                PhoneNumber="{Binding PhoneNumber, Mode=TwoWay}"
                Address="{Binding Address, Mode=TwoWay}"
                Status="{Binding Status, Mode=TwoWay}"
                StatusOptions="{Binding StatusOptions}"
                ShowStatus="{Binding IsEditOrViewMode}"/>
        </views:BaseDetailContainer.EditContent>
    </views:BaseDetailContainer>
</UserControl>
