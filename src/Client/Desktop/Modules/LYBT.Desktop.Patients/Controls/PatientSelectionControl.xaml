<UserControl x:Class="LYBT.Desktop.Patients.Controls.PatientSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:local="clr-namespace:LYBT.Desktop.Patients.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="600" d:DesignWidth="1000">

    <!-- 患者选择控件
         OpenSpec: refactor-clinical-workflow
         可复用的患者选择控件，使用Master-Detail布局
         左侧：患者列表（工具栏+搜索+列表）
         右侧：患者详情（使用PatientViewControl）

         修复: 使用ElementName=Root替代RelativeSource，
               确保绑定在任何视觉树场景下都能正确工作 -->

    <controls:MasterDetailLayout
        HasSelection="{Binding HasSelection, ElementName=Root}"
        MasterWidth="2*"
        DetailWidth="3*">

        <!-- Master: 患者列表区域 -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
                    <RowDefinition Height="Auto"/>  <!-- 搜索框 -->
                    <RowDefinition Height="*"/>     <!-- 列表 -->
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <controls:DataGridToolbar Grid.Row="0"
                    CreateCommand="{Binding CreateNewCommand, ElementName=Root}"
                    RefreshCommand="{Binding RefreshCommand, ElementName=Root}"/>

                <!-- 搜索框 -->
                <controls:SearchBox Grid.Row="1"
                    SearchText="{Binding SearchText, Mode=TwoWay, ElementName=Root}"
                    SearchCommand="{Binding SearchCommand, ElementName=Root}"
                    Placeholder="搜索患者姓名或拼音码..."/>

                <!-- 患者列表 -->
                <DataGrid Grid.Row="2"
                    ItemsSource="{Binding Patients, ElementName=Root}"
                    SelectedItem="{Binding SelectedPatient, ElementName=Root, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="True"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    MouseDoubleClick="PatientDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="80"/>
                        <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="50"/>
                        <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="50"/>
                        <DataGridTextColumn Header="电话" Binding="{Binding PhoneNumber}" Width="120"/>
                        <DataGridTextColumn Header="最近就诊" Binding="{Binding LastVisitTime, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="就诊次数" Binding="{Binding VisitCount}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!-- Detail: 患者详情区域 -->
        <controls:MasterDetailLayout.DetailContent>
            <local:PatientViewControl
                PatientName="{Binding PatientDetail.Name, ElementName=Root}"
                PinYinCode="{Binding PatientDetail.PinYinCode, ElementName=Root}"
                Gender="{Binding PatientDetail.Gender, ElementName=Root}"
                BirthDate="{Binding PatientDetail.BirthDate, ElementName=Root}"
                Age="{Binding PatientDetail.Age, ElementName=Root}"
                IdNumber="{Binding PatientDetail.IdNumber, ElementName=Root}"
                IdType="{Binding PatientDetail.IdType, ElementName=Root}"
                MaritalStatus="{Binding PatientDetail.MaritalStatus, ElementName=Root}"
                BloodType="{Binding PatientDetail.BloodType, ElementName=Root}"
                PhoneNumber="{Binding PatientDetail.PhoneNumber, ElementName=Root}"
                Address="{Binding PatientDetail.Address, ElementName=Root}"
                EmergencyContactName="{Binding PatientDetail.EmergencyContactName, ElementName=Root}"
                EmergencyContactPhone="{Binding PatientDetail.EmergencyContactPhone, ElementName=Root}"
                EmergencyContactRelation="{Binding PatientDetail.EmergencyContactRelation, ElementName=Root}"
                AllergyHistory="{Binding PatientDetail.AllergyHistory, ElementName=Root}"
                MedicalHistory="{Binding PatientDetail.MedicalHistory, ElementName=Root}"
                LastVisitTime="{Binding PatientDetail.LastVisitTime, ElementName=Root}"
                VisitCount="{Binding PatientDetail.VisitCount, ElementName=Root}"
                Status="{Binding PatientDetail.Status, ElementName=Root}"
                ShowStatus="False"
                DisableReason="{Binding PatientDetail.DisableReason, ElementName=Root}"
                CreatedAt="{Binding PatientDetail.CreatedAt, ElementName=Root}"
                UpdatedAt="{Binding PatientDetail.UpdatedAt, ElementName=Root}"/>
        </controls:MasterDetailLayout.DetailContent>

        <!-- Empty: 空状态 -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择患者"
                Subtitle="从左侧列表选择患者，或点击新建创建新患者"
                ActionText="新建患者"
                ActionCommand="{Binding CreateNewCommand, ElementName=Root}"/>
        </controls:MasterDetailLayout.EmptyContent>

    </controls:MasterDetailLayout>
</UserControl>
