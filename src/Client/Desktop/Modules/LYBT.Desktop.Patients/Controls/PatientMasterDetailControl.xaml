<!--
    PatientMasterDetailControl - 患者Master-Detail控件
    
    可复用业务控件，供Admin和Clinical角色台使用
    从PatientMasterDetailView重构而来
-->
<controls:MasterDetailControlBase
    x:Class="LYBT.Desktop.Patients.Controls.PatientMasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:patientControls="clr-namespace:LYBT.Desktop.Patients.Controls"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        资源加载说明:
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <!-- 视觉基线 v1：按 desktop-layout-framework + patient-list.pen 对齐：主内容 $bg-warm gap16 padding16，工具栏 56h white 12圆角 描边#E9DFD7，文字居中，输入描边可见，铺满 -->
    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}" Background="{DynamicResource SurfaceLevel0Brush}">
        <!--
            ========================================
            面包屑导航 - Phase 2.1: Navigation Improvements
            ========================================
        -->
        <controls:MasterDetailLayout.HeaderContent>
            <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="16,12,16,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:MasterDetailLayout.HeaderContent>
        <!--
            ========================================
            Master区域: 患者列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  工具栏  -->
                    <RowDefinition Height="Auto" />
                    <!--  搜索框  -->
                    <RowDefinition Height="*" />
                    <!--  列表  -->
                    <RowDefinition Height="Auto" />
                    <!--  分页  -->
                </Grid.RowDefinitions>

                <!--  工具栏：56h white 12圆角 描边（对齐 pen 工具栏） -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    MinHeight="56" Padding="0,0,16,0"
                    BatchDeleteCommand="{Binding DeleteCommand}"
                    BatchEnableCommand="{Binding BatchEnableCommand}"
                    BatchDisableCommand="{Binding BatchDisableCommand}"
                    CreateCommand="{Binding CreateNewCommand}"
                    ExportCommand="{Binding ExportPatientsCommand}"
                    RefreshCommand="{Binding RefreshCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <!--  重复处理策略（US-SHELL-021 AC②：跳过/更新/报错）  -->
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="重复策略" />
                            <ComboBox
                                Width="130"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding ImportDuplicateStrategyOptions}"
                                SelectedValue="{Binding ImportDuplicateStrategy, Mode=TwoWay}"
                                SelectedValuePath="Value"
                                ToolTip="导入时遇到重复数据的处理方式" />
                            <!--  批量导入操作（US-PAT-011/012）  -->
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding DownloadImportTemplateCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="下载导入模板">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="模板" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding ImportPatientsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="批量导入患者">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="导入" />
                                </StackPanel>
                            </Button>
                            <!--  主操作  -->
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding EditCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="编辑">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="编辑" />
                                </StackPanel>
                            </Button>
                            <!--  次要操作溢出菜单  -->
                            <Menu Margin="8,0,0,0" Background="Transparent">
                                <MenuItem>
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DotsHorizontal" VerticalAlignment="Center" />
                                            <TextBlock Margin="8,0,0,0" Text="更多" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem Command="{Binding RestoreCommand}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="Undo" />
                                        </MenuItem.Icon>
                                        <MenuItem.Header>恢复</MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding ReadCardCommand}"
                                        IsEnabled="{Binding IsCardReaderConnected}"
                                        ToolTip="使用身份证读卡器快速录入患者信息">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="CreditCardReader" />
                                        </MenuItem.Icon>
                                        <MenuItem.Header>刷卡录入</MenuItem.Header>
                                    </MenuItem>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!--  搜索框：描边可见，铺满工具栏区 -->
                <controls:SearchBox
                    Grid.Row="1"
                    Margin="16,12" Height="40"
                    Placeholder="搜索患者姓名/手机号..."
                    SearchCommand="{Binding SearchCommand}"
                    SearchText="{Binding SearchText, Mode=TwoWay}" />

                <!--  患者列表  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="16,0,16,8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    BorderThickness="0"
                    Background="Transparent"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!--  姓名  -->
                        <DataGridTextColumn
                            Width="*" MinWidth="80"
                            Binding="{Binding Name}"
                            Header="姓名"
                            ElementStyle="{StaticResource DataGridEmphasisCellStyle}" />

                        <!--  性别  -->
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Gender, Converter={x:Static converters:Cvt.EnumDesc}}"
                            Header="性别"
                            ElementStyle="{StaticResource DataGridSecondaryCellStyle}" />

                        <!--  年龄  -->
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Age, StringFormat={}{0}岁}"
                            Header="年龄"
                            ElementStyle="{StaticResource DataGridSecondaryCellStyle}" />

                        <!--  手机号  -->
                        <DataGridTextColumn
                            Width="*" MinWidth="100"
                            Binding="{Binding PhoneNumber}"
                            Header="手机号"
                            ElementStyle="{StaticResource DataGridMonoCellStyle}" />

                        <!--  状态（设计稿对齐：StatusBadge 中文映射 启用/禁用；复诊中/新患者/已治愈 为
                              3 态就诊标签，数据模型仅 CommonStatus 2 态，暂以启用/禁用呈现）  -->
                        <DataGridTemplateColumn Width="Auto" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!--  右键菜单 - 分组优化：查看/编辑 | 医案 | 危险操作  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <!--  查看与编辑组  -->
                            <MenuItem Command="{Binding EditCommand}" Header="编辑">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Pencil" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  医案操作组  -->
                            <MenuItem Command="{Binding ViewMedicalRecordsCommand}" Header="查看医案">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FileSearch" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding NewConsultationCommand}" Header="新建医案">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="PlusBox" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding RestoreCommand}" Header="恢复">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Undo" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  危险操作组  -->
                            <MenuItem Command="{Binding DeleteCommand}" Header="删除">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件  -->
                <controls:UnifiedPaginationBar
                    Grid.Row="3"
                    CurrentPage="{Binding CurrentPage}"
                    TotalPages="{Binding TotalPages}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageSizes="{Binding PageSizes}"
                    FirstPageCommand="{Binding GoToFirstPageCommand}"
                    PreviousPageCommand="{Binding GoToPreviousPageCommand}"
                    NextPageCommand="{Binding GoToNextPageCommand}"
                    LastPageCommand="{Binding GoToLastPageCommand}" />

                <!--
                    导入报告（US-SHELL-021 AC⑤：总数/成功/失败/跳过 + 失败明细行号）
                    进度（AC③）：导入进行中由遮罩显示「已导入 X/Y 行」，此处保留最后一次进度
                -->
                <Border
                    Grid.RowSpan="4"
                    Margin="16"
                    Padding="16"
                    Background="#FFFFFF"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasImportReport, Converter={x:Static converters:Cvt.BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="导入报告" />
                            <Button
                                Margin="16,0,0,0"
                                Padding="12,4"
                                Command="{Binding CloseImportReportCommand}"
                                Content="关闭"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Margin="0,8,0,0"
                            Text="{Binding ImportReport.Summary}"
                            TextWrapping="Wrap" />
                        <ProgressBar
                            DockPanel.Dock="Top"
                            Height="6"
                            Margin="0,8,0,0"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ImportProgress.PercentComplete}" />
                        <TextBlock
                            DockPanel.Dock="Top"
                            Margin="0,8,0,0"
                            Foreground="#757575"
                            Text="{Binding ImportProgress.Message}" />
                        <DataGrid
                            Margin="0,12,0,0"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding ImportReport.Failures}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="Auto" MinWidth="60"
                                    Binding="{Binding RowNumberText}"
                                    Header="行号" />
                                <DataGridTextColumn
                                    Width="Auto" MinWidth="90"
                                    Binding="{Binding Identifier}"
                                    Header="记录" />
                                <DataGridTextColumn
                                    Width="*" MinWidth="160"
                                    Binding="{Binding Reason}"
                                    Header="失败原因" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 患者详情/编辑
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  详情内容（Transitioner 切换查看/编辑）  -->
                <materialDesign:Transitioner
                    Grid.Row="1"
                    SelectedIndex="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToInt}}">
                    <materialDesign:TransitionerSlide>
                        <patientControls:PatientViewControl
                            Margin="16"
                            Age="{Binding CurrentDetail.Age}"
                            BirthDate="{Binding CurrentDetail.BirthDate}"
                            CreatedAt="{Binding CurrentDetail.CreatedAt}"
                            Gender="{Binding CurrentDetail.Gender}"
                            IdNumber="{Binding CurrentDetail.IdNumber}"
                            PatientName="{Binding CurrentDetail.Name}"
                            PhoneNumber="{Binding CurrentDetail.PhoneNumber}"
                            PinYinCode="{Binding CurrentDetail.PinYinCode}"
                            ShowStatus="True"
                            Status="{Binding CurrentDetail.Status}"
                            UpdatedAt="{Binding CurrentDetail.UpdatedAt}" />
                    </materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide>
                        <patientControls:PatientEditControl
                            Margin="16"
                            Patient="{Binding PatientEditor.Patient}"
                            ErrorsSource="{Binding PatientEditor.Patient.Errors}"
                            GenderOptions="{Binding GenderOptions}"
                            ShowStatus="True"
                            StatusOptions="{Binding StatusOptions}" />
                    </materialDesign:TransitionerSlide>
                </materialDesign:Transitioner>

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="2"
                    IsLoading="{Binding IsBusy}"
                    LoadingText="正在处理..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选择患者时显示
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择患者"
                ActionCommand="{Binding CreateNewCommand}"
                ActionText="新增患者"
                Subtitle="在左侧列表中选择一位患者查看详情，或点击新增按钮新建患者" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
