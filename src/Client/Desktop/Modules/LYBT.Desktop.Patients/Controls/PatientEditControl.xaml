<!--
    PatientEditControl - 患者编辑控件
    OpenSpec: extract-detail-controls Task 3.2

    可复用的患者编辑控件，从PatientDetailView中复用
    通过DependencyProperty传递数据，支持双向绑定
-->
<UserControl x:Class="LYBT.Desktop.Patients.Controls.PatientEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 基本信息卡片 -->
        <controls:InfoCard Title="基本信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：姓名（必填）、拼音码 -->
                    <!-- OpenSpec: ui-validation-framework - 表单验证 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Style="{DynamicResource FormLabelStyle}">
                            <Run Text="姓名（必填）"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                        </TextBlock>
                        <TextBox TabIndex="1" Text="{Binding PatientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[Name]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="拼音码（自动生成）" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="2" Text="{Binding PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"
                                 ToolTip="自动从姓名生成，如有多音字请手动调整"/>
                    </StackPanel>

                    <!-- 第二行：性别、出生日期 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="性别" Style="{DynamicResource FormLabelStyle}"/>
                        <ComboBox TabIndex="3" SelectedItem="{Binding Gender, Mode=TwoWay}"
                                  ItemsSource="{Binding GenderOptions}"
                                  MinHeight="44"
                                  Padding="12,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="出生日期" Style="{DynamicResource FormLabelStyle}"/>
                        <DatePicker TabIndex="4" SelectedDate="{Binding BirthDate, Mode=TwoWay}"
                                    MinHeight="44"/>
                    </StackPanel>

                    <!-- 第三行：年龄（只读）、身份证号 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="年龄" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox IsReadOnly="True"
                                 Background="{DynamicResource RegionBrush}"
                                 MinHeight="44"
                                 Padding="12,10">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}{0} 岁">
                                    <Binding Path="Age" Mode="OneWay"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="身份证号" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="5" Text="{Binding IdNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[IdNumber]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <!-- 第四行：手机号码、地址 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="手机号码" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="6" Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[PhoneNumber]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="地址" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="7" Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[Address]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <!-- 第五行：状态 -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,20"
                                Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}">
                        <TextBlock Text="状态" Style="{DynamicResource FormLabelStyle}"/>
                        <ComboBox TabIndex="8" SelectedItem="{Binding Status, Mode=TwoWay}"
                                  ItemsSource="{Binding StatusOptions}"
                                  MinHeight="44"
                                  Padding="12,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- 第六行：婚姻状况、血型 -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="婚姻状况" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="9" Text="{Binding MaritalStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="血型" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="10" Text="{Binding BloodType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第七行：紧急联系人姓名、电话 -->
                    <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="紧急联系人" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="11" Text="{Binding EmergencyContactName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="联系人电话" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="12" Text="{Binding EmergencyContactPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>

        <!-- 紧急联系人关系 -->
        <controls:InfoCard Title="联系人关系">
            <controls:InfoCard.Content>
                <TextBox TabIndex="13" Text="{Binding EmergencyContactRelation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource EditableTextBoxStyle}"
                         MinHeight="44"
                         Padding="12,10"/>
            </controls:InfoCard.Content>
        </controls:InfoCard>

        <!-- 健康信息卡片 -->
        <controls:InfoCard Title="健康信息">
            <controls:InfoCard.Content>
                <StackPanel>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="过敏史" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding AllergyHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="既往病史" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding MedicalHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
    </ScrollViewer>
</UserControl>
