<!--
    PatientEditControl - 患者编辑控件
    OpenSpec: extract-detail-controls Task 3.2

    独立的患者编辑控件，可在PatientDetailView中复用
    通过DependencyProperty接收数据，支持双向绑定
-->
<UserControl x:Class="LYBT.Desktop.Patients.Controls.PatientEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!-- 转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 基本信息卡片 -->
        <controls:InfoCard Title="基本信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：患者姓名、拼音码 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="患者姓名 *" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding PatientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="拼音码（可修正）" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"
                                 ToolTip="自动根据姓名生成，如有多音字错误可手动修正"/>
                    </StackPanel>

                    <!-- 第二行：性别、出生日期 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="性别" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox SelectedItem="{Binding Gender, Mode=TwoWay}"
                                  ItemsSource="{Binding GenderOptions}"
                                  MinHeight="44"
                                  Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="出生日期" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding BirthDate, Mode=TwoWay}"
                                    MinHeight="44"/>
                    </StackPanel>

                    <!-- 第三行：年龄（只读）、身份证号 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="年龄" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox IsReadOnly="True"
                                 Background="{StaticResource BackgroundBrush}"
                                 MinHeight="44"
                                 Padding="12,10">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}{0} 岁">
                                    <Binding Path="Age" Mode="OneWay"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="身份证号 *" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding IdNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第四行：手机号码、地址 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="手机号码" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="地址" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第五行：状态 -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,20"
                                Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="状态" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox SelectedItem="{Binding Status, Mode=TwoWay}"
                                  ItemsSource="{Binding StatusOptions}"
                                  MinHeight="44"
                                  Padding="12,10"/>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
