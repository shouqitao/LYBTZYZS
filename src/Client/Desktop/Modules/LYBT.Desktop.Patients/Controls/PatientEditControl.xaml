<!--
    PatientEditControl - 患者编辑控件

    可复用的患者编辑控件，从PatientDetailView中复用
    通过DependencyProperty传递数据，支持双向绑定
-->
<UserControl x:Class="LYBT.Desktop.Patients.Controls.PatientEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             x:Name="Root">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 基本信息卡片 -->
        <controls:InfoCard Title="基本信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：姓名（必填）、拼音码 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Style="{DynamicResource FormLabelStyle}">
                            <Run Text="姓名（必填）"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                        </TextBlock>
                        <TextBox TabIndex="1" Text="{Binding Patient.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[Name]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="拼音码（自动生成）" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="2" Text="{Binding Patient.PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 MinHeight="44"
                                 Padding="12,10"
                                 ToolTip="自动从姓名生成，如有多音字请手动调整"/>
                    </StackPanel>

                    <!-- 第二行：性别、出生日期 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="性别" Style="{DynamicResource FormLabelStyle}"/>
                        <ComboBox TabIndex="3" SelectedItem="{Binding Patient.Gender, Mode=TwoWay}"
                                  ItemsSource="{Binding GenderOptions}"
                                  MinHeight="44"
                                  Padding="12,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="出生日期" Style="{DynamicResource FormLabelStyle}"/>
                        <DatePicker TabIndex="4" SelectedDate="{Binding Patient.BirthDate, Mode=TwoWay}"
                                    MinHeight="44"/>
                    </StackPanel>

                    <!-- 第三行：年龄（只读）、身份证号 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="年龄" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox IsReadOnly="True"
                                 Background="{DynamicResource MaterialDesignPaper}"
                                 MinHeight="44"
                                 Padding="12,10">
                            <TextBox.Text>
                                <MultiBinding StringFormat="{}{0} 岁">
                                    <Binding Path="Patient.Age" Mode="OneWay"/>
                                </MultiBinding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="身份证号" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="5" Text="{Binding Patient.IdNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[IdNumber]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <!-- 第四行：手机号码 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="手机号码" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="6" Text="{Binding Patient.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[PhoneNumber]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <!-- 第五行：状态 -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,20"
                                Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}">
                        <TextBlock Text="状态" Style="{DynamicResource FormLabelStyle}"/>
                        <ComboBox TabIndex="7" SelectedItem="{Binding Patient.Status, Mode=TwoWay}"
                                  ItemsSource="{Binding StatusOptions}"
                                  MinHeight="44"
                                  Padding="12,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
    </ScrollViewer>
</UserControl>
