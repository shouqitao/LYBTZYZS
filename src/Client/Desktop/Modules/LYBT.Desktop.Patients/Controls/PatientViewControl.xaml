<!--
    PatientViewControl - 患者预览控件
    OpenSpec: extract-detail-controls Task 3.1
    OpenSpec: optimize-preview-layout - 优化布局和视觉层次
    OpenSpec: refactor-master-detail-layout - 详情区域UI优化

    独立的患者预览控件，可在PatientDetailView和其他需要展示患者信息的地方复用
    通过DependencyProperty接收数据，支持只读展示

    UI优化 (2025-12-16):
    - 采用多卡片分组布局，充分利用详情区域空间
    - 分为：基本信息、联系信息、紧急联系人、病史信息、就诊信息、系统信息六个逻辑区域
    - 添加：婚姻状态、血型、紧急联系人、病史、就诊统计等完整字段
-->
<UserControl x:Class="LYBT.Desktop.Patients.Controls.PatientViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ElementName=Root}">
        <StackPanel>
            <!-- ========================================
                 基本信息卡片
                 ======================================== -->
            <controls:InfoCard Title="基本信息" ShowTitle="True">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 患者姓名 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="患者姓名" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatientName}" Style="{DynamicResource DetailValueStyle}" FontWeight="SemiBold"/>

                        <!-- 拼音码 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="拼音码" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PinYinCode, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}" FontFamily="Consolas"/>

                        <!-- 性别 - OpenSpec: fix-elementname-binding-architecture - 使用EnumDescriptionConverter替代GenderDisplay -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="性别" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gender, Converter={x:Static converters:Cvt.EnumDesc}}" Style="{DynamicResource DetailValueStyle}"/>

                        <!-- 年龄 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="年龄" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{DynamicResource DetailValueStyle}">
                            <TextBlock.Text>
                                <Binding Path="Age" StringFormat="{}{0}岁" TargetNullValue="-"/>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 出生日期 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="出生日期" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding BirthDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='-'}"
                                   Style="{DynamicResource DetailValueStyle}"/>

                        <!-- 状态 -->
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="状态" Style="{DynamicResource DetailLabelStyle}"
                                   Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}"/>
                        <controls:StatusBadge Grid.Row="2" Grid.Column="3"
                                              Status="{Binding Status}"
                                              HorizontalAlignment="Left"
                                              Margin="0,4,0,4"
                                              Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 身份信息卡片
                 ======================================== -->
            <controls:InfoCard Title="身份信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 身份证号 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="身份证号" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IdNumber, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}" FontFamily="Consolas"/>

                        <!-- 婚姻状态 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="婚姻状态" Style="{DynamicResource DetailLabelStyle}"/>
                        <controls:StatusBadge Grid.Row="0" Grid.Column="3"
                                              Status="{Binding MaritalStatus}"
                                              HorizontalAlignment="Left"
                                              Margin="0,4,0,4"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 健康信息卡片
                 ======================================== -->
            <controls:InfoCard Title="健康信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 血型 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="血型" Style="{DynamicResource DetailLabelStyle}"/>
                        <controls:StatusBadge Grid.Row="0" Grid.Column="1"
                                              Status="{Binding BloodType}"
                                              HorizontalAlignment="Left"
                                              Margin="0,4,0,4"/>

                        <!-- 过敏史 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="过敏史" Style="{DynamicResource DetailLabelStyle}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AllergyHistory, TargetNullValue='无'}"
                                   Style="{DynamicResource DetailValueStyle}" TextWrapping="Wrap"/>

                        <!-- 既往病史 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="既往病史" Style="{DynamicResource DetailLabelStyle}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MedicalHistory, TargetNullValue='无'}"
                                   Style="{DynamicResource DetailValueStyle}" TextWrapping="Wrap"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 联系信息卡片
                 ======================================== -->
            <controls:InfoCard Title="联系信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 手机号码 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="手机号码" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PhoneNumber, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}" FontFamily="Consolas"/>

                        <!-- 地址 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="地址" Style="{DynamicResource DetailLabelStyle}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Address, TargetNullValue='-'}"
                                   Style="{DynamicResource DetailValueStyle}" TextWrapping="Wrap"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 紧急联系人卡片
                 ======================================== -->
            <controls:InfoCard Title="紧急联系人" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 联系人姓名 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EmergencyContactName, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}"/>

                        <!-- 联系人关系 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="关系" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding EmergencyContactRelation, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}"/>

                        <!-- 联系人电话 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="电话" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EmergencyContactPhone, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}" FontFamily="Consolas"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 就诊信息卡片
                 ======================================== -->
            <controls:InfoCard Title="就诊统计" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 就诊次数 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="就诊次数" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{DynamicResource DetailValueStyle}">
                            <TextBlock.Text>
                                <Binding Path="VisitCount" StringFormat="{}{0}次"/>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 最后就诊时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="最后就诊" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding LastVisitTime, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='从未就诊'}"
                                   Style="{DynamicResource DetailValueStyle}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 系统信息卡片
                 ======================================== -->
            <controls:InfoCard Title="系统信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 创建时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="创建时间" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                   Style="{DynamicResource DetailValueStyle}"/>

                        <!-- 更新时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="更新时间" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                   Style="{DynamicResource DetailValueStyle}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
