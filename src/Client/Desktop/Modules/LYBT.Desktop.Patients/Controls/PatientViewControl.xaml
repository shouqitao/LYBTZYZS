<!--
    PatientViewControl - 患者预览控件
    OpenSpec: extract-detail-controls Task 3.1
    OpenSpec: optimize-preview-layout - 优化布局和视觉层次

    独立的患者预览控件，可在PatientDetailView和其他需要展示患者信息的地方复用
    通过DependencyProperty接收数据，支持只读展示
-->
<UserControl x:Class="LYBT.Desktop.Patients.Controls.PatientViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 患者信息卡片 - 紧凑布局 -->
        <controls:InfoCard ShowTitle="False">
            <controls:InfoCard.Content>
                <StackPanel>
                    <!-- 头部: 患者姓名 + 拼音码 + 状态Badge -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding PatientName}" Style="{StaticResource PreviewTitleStyle}"/>
                            <TextBlock Text="{Binding PinYinCode, StringFormat=({0})}"
                                       Style="{StaticResource PreviewSubtitleStyle}"
                                       Visibility="{Binding PinYinCode, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Style="{StaticResource PreviewBadgeSuccessStyle}"
                                Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource PreviewBadgeTextStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 紧凑信息区：基本信息 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="性别：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="1" Text="{Binding Gender}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="年龄：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="3" Text="{Binding Age, StringFormat={}{0}岁}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="4" Text="出生：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="5" Text="{Binding BirthDate, StringFormat={}{0:yyyy-MM-dd}}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="手机：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="1" Text="{Binding PhoneNumber}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="身份证：" FontSize="13" Foreground="#605E5C"
                                   Visibility="{Binding IdNumber, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="3" Text="{Binding IdNumber}" FontSize="13"
                                   Visibility="{Binding IdNumber, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6"
                          Visibility="{Binding Address, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="地址：" FontSize="13" Foreground="#605E5C" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Address}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
