<!--
    PatientViewControl - 患者预览控件（v2 单卡片布局 2026-06-27）
    单卡片 + 分区隔线 + 概要头，替代原 4 张独立卡片
-->
<UserControl x:Class="LYBT.Desktop.Patients.Controls.PatientViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">

    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ElementName=Root}">
        <controls:InfoCard>
            <controls:InfoCard.Content>
                <StackPanel>
                    <!-- 概要头 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="AccountHeart"
                            Width="28" Height="28" VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Grid.Column="1" Text="{Binding PatientName}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                            Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <controls:StatusBadge Grid.Column="2" Status="{Binding Status}" VerticalAlignment="Center"
                            Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}" />
                    </Grid>

                    <Border Height="1" Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.2" />

                    <!-- 基本信息 -->
                    <TextBlock Text="基本信息" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Margin="0,0,0,8" Opacity="0.6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="拼音码"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PinYinCode, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center"
                            FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="性别"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="3"
                            Text="{Binding Gender, Converter={x:Static converters:Cvt.EnumDesc}}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="年龄"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <Binding Path="Age" StringFormat="{}{0}岁" TargetNullValue="-"/>
                            </TextBlock.Text>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="出生日期"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="3"
                            Text="{Binding BirthDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.12" />

                    <!-- 身份与联系方式 -->
                    <TextBlock Text="身份与联系方式" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Margin="0,0,0,8" Opacity="0.6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="身份证号"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IdNumber, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center"
                            FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="手机号码"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PhoneNumber, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center"
                            FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI" />
                    </Grid>

                    <Border Height="1" Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.12" />

                    <!-- 系统信息 -->
                    <TextBlock Text="系统信息" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Margin="0,0,0,8" Opacity="0.6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="创建时间"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                            Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="更新时间"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="3"
                            Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </ScrollViewer>
</UserControl>
