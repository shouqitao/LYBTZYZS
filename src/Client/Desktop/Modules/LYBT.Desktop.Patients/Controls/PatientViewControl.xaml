<!--
    PatientViewControl - 患者预览控件

    独立的患者预览控件，可在PatientDetailView和其他需要展示患者信息的地方复用
    通过DependencyProperty接收数据，支持只读展示
-->
<UserControl x:Class="LYBT.Desktop.Patients.Controls.PatientViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ElementName=Root}">
        <StackPanel>
            <!-- ========================================
                 基本信息卡片
                 ======================================== -->
            <controls:InfoCard Title="基本信息" ShowTitle="True">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 患者姓名 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="患者姓名" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatientName}" Style="{DynamicResource DetailValueStyle}" FontWeight="SemiBold"/>

                        <!-- 拼音码 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="拼音码" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PinYinCode, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}" FontFamily="Consolas"/>

                        <!-- 性别 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="性别" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gender, Converter={x:Static converters:Cvt.EnumDesc}}" Style="{DynamicResource DetailValueStyle}"/>

                        <!-- 年龄 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="年龄" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{DynamicResource DetailValueStyle}">
                            <TextBlock.Text>
                                <Binding Path="Age" StringFormat="{}{0}岁" TargetNullValue="-"/>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 出生日期 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="出生日期" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding BirthDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='-'}"
                                   Style="{DynamicResource DetailValueStyle}"/>

                        <!-- 状态 -->
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="状态" Style="{DynamicResource DetailLabelStyle}"
                                   Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}"/>
                        <controls:StatusBadge Grid.Row="2" Grid.Column="3"
                                               Status="{Binding Status}"
                                               HorizontalAlignment="Left"
                                               Margin="0,4,0,4"
                                               Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 身份信息卡片
                 ======================================== -->
            <controls:InfoCard Title="身份信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 身份证号 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="身份证号" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IdNumber, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}" FontFamily="Consolas"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 联系信息卡片
                 ======================================== -->
            <controls:InfoCard Title="联系信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 手机号码 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="手机号码" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PhoneNumber, TargetNullValue='-'}" Style="{DynamicResource DetailValueStyle}" FontFamily="Consolas"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 系统信息卡片
                 ======================================== -->
            <controls:InfoCard Title="系统信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 创建时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="创建时间" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                   Style="{DynamicResource DetailValueStyle}"/>

                        <!-- 更新时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="更新时间" Style="{DynamicResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                   Style="{DynamicResource DetailValueStyle}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
