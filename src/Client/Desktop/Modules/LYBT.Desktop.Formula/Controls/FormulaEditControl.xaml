<!--
    FormulaEditControl - 验方编辑控件
    OpenSpec: extract-detail-controls Task 1.2
    OpenSpec: unify-herb-controls-to-herbs-module - 统一使用HerbListControl编辑处方
    OpenSpec: frontend-architecture-unification - 对象DP模式

    可复用的验方编辑控件，从FormulaDetailView中复用
    通过DependencyProperty传递数据，支持双向绑定
-->
<UserControl x:Class="LYBT.Desktop.Formula.Controls.FormulaEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:herbList="clr-namespace:LYBT.Desktop.Infrastructure.Controls.HerbList;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 基本信息卡片 -->
        <controls:InfoCard Title="基本信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：名称（必填）、分类 -->
                    <!-- OpenSpec: ui-validation-framework - 添加验证框 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Style="{DynamicResource FormLabelStyle}">
                            <Run Text="名称"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                        </TextBlock>
                        <TextBox TabIndex="1" Text="{Binding Formula.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[Name]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="分类" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="2" Text="{Binding Formula.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第二行：性味归经 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="性味归经" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="3" Text="{Binding Formula.Property, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第三行：功效 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="功效" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="4" Text="{Binding Formula.Effect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第四行：用法 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="用法" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="5" Text="{Binding Formula.Usage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第五行：备注 -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="备注" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="6" Text="{Binding Formula.Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 MinHeight="50"
                                 Padding="12,10"/>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>

        <!-- 药材组成卡片 - 编辑模式 -->
        <!-- OpenSpec: unify-herb-controls-to-herbs-module - 使用HerbListControl替代HerbListEditor -->
        <controls:InfoCard Title="{Binding HerbCount, StringFormat=药材组成 (共{0}味)}">
            <controls:InfoCard.Content>
                <herbList:HerbListControl
                    AllHerbs="{Binding AllHerbs}"
                    HerbItems="{Binding HerbItems, Mode=TwoWay}"
                    IsEditMode="True"
                    Columns="4"/>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
    </ScrollViewer>
</UserControl>
