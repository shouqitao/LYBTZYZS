<!--
    FormulaEditControl - 验方编辑控件
    OpenSpec: extract-detail-controls Task 1.2

    独立的验方编辑控件，可在FormulaDetailView中复用
    通过DependencyProperty接收数据，支持双向绑定
-->
<UserControl x:Class="LYBT.Desktop.Formula.Controls.FormulaEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:sharedControls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 基本信息卡片 -->
        <controls:InfoCard Title="基本信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：名称、分类 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="名称" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding FormulaName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="分类" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第二行：性味归经 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="性味归经" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Property, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第三行：功效 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="功效" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding FormulaEffect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第四行：用法 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="用法" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Usage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第五行：备注 -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                        <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 MinHeight="50"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第六行：创建时间、更新时间（只读显示） -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="创建时间" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                   Style="{StaticResource ValueDisplayStyle}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="更新时间" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                   Style="{StaticResource ValueDisplayStyle}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>

        <!-- 药材组成卡片 - 编辑模式 -->
        <controls:InfoCard Title="{Binding HerbCount, StringFormat=药材组成 (共{0}味)}">
            <controls:InfoCard.Content>
                <sharedControls:HerbListEditor
                    HerbItems="{Binding HerbItems}"
                    IsEditMode="True"
                    DeleteHerbCommand="{Binding DeleteHerbCommand}"
                    DosageCompletedCommand="{Binding DosageCompletedCommand}"
                    AddNewRowCommand="{Binding AddNewRowCommand}"/>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
