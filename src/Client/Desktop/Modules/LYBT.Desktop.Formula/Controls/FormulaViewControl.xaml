<!--
    FormulaViewControl - 验方预览控件
    OpenSpec: extract-detail-controls Task 1.1

    独立的验方预览控件，可在FormulaDetailView和FormulaImportDialog中复用
    通过DependencyProperty接收FormulaDetailDto数据
-->
<UserControl x:Class="LYBT.Desktop.Formula.Controls.FormulaViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:sharedControls="clr-namespace:LYBT.Desktop.Presentation.Components;assembly=LYBT.Desktop.Presentation"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 基本信息卡片 -->
        <controls:InfoCard Title="基本信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：名称、分类 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="名称" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Formula.Name}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="分类" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Formula.Category}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <!-- 第二行：性味归经 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="性味归经" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Formula.Property}" Style="{StaticResource ValueDisplayStyle}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 第三行：功效 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="功效" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Formula.Effect}" Style="{StaticResource ValueDisplayStyle}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 第四行：用法 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="用法" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Formula.Usage}" Style="{StaticResource ValueDisplayStyle}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 第五行：备注 -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Formula.Remark}" Style="{StaticResource ValueDisplayStyle}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 第六行：创建时间、更新时间 -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelValueStyle}"
                                Visibility="{Binding ShowAuditInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="创建时间" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Formula.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                   Style="{StaticResource ValueDisplayStyle}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="2" Style="{StaticResource LabelValueStyle}"
                                Visibility="{Binding ShowAuditInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="更新时间" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Formula.UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                   Style="{StaticResource ValueDisplayStyle}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>

        <!-- 药材组成卡片 -->
        <controls:InfoCard Title="{Binding Formula.HerbCount, StringFormat=药材组成 (共{0}味)}">
            <controls:InfoCard.Content>
                <sharedControls:HerbListEditor
                    HerbItems="{Binding Formula.Herbs}"
                    IsEditMode="False"/>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
