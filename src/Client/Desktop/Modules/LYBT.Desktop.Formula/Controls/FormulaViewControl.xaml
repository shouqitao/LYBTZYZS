<!--
    FormulaViewControl - 验方预览控件
    OpenSpec: extract-detail-controls Task 1.1
    OpenSpec: optimize-preview-layout - 优化布局和视觉层次

    独立的验方预览控件，可在FormulaDetailView和FormulaImportDialog中复用
    通过DependencyProperty接收FormulaDetailDto数据
-->
<UserControl x:Class="LYBT.Desktop.Formula.Controls.FormulaViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 单一卡片：验方信息 + 药材组成 -->
        <controls:InfoCard ShowTitle="False">
            <controls:InfoCard.Content>
                <StackPanel>
                    <!-- 头部: 验方名称 + 分类Badge + 药材数量 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Formula.Name}" Style="{StaticResource PreviewTitleStyle}"/>

                        <Border Grid.Column="1"
                                Style="{StaticResource PreviewBadgeInfoStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding Formula.Category, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding Formula.Category}" Style="{StaticResource PreviewBadgeTextStyle}"/>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PreviewBadgePrimaryStyle}">
                            <TextBlock Text="{Binding Formula.HerbCount, StringFormat=共{0}味}" Style="{StaticResource PreviewBadgeTextStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 紧凑属性区：2列布局 -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding Formula.Property, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="性味归经：" FontSize="13" Foreground="#605E5C" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Formula.Property}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding Formula.Effect, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="功效：" FontSize="13" Foreground="#605E5C" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Formula.Effect}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding Formula.Usage, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="用法：" FontSize="13" Foreground="#605E5C" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Formula.Usage}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding Formula.Remark, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="备注：" FontSize="13" Foreground="#605E5C" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Formula.Remark}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- 分隔线 -->
                    <Border Height="1" Background="#E1DFDD" Margin="0,8,0,12"/>

                    <!-- 药材组成标题 -->
                    <TextBlock Text="药材组成" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- 药材列表 - 网格布局，一行4个 -->
                    <ItemsControl ItemsSource="{Binding Formula.Herbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HerbTagStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding HerbName}" Style="{StaticResource HerbTagNameStyle}"/>
                                        <TextBlock Text="{Binding Dosage, StringFormat={}{0}g}" Style="{StaticResource HerbTagDosageStyle}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 审计信息 - 底部小字 -->
                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="#A0A0A0"
                               Visibility="{Binding ShowAuditInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="创建: "/><Run Text="{Binding Formula.CreatedAt, StringFormat={}{0:yyyy-MM-dd}}"/>
                        <Run Text="  更新: "/><Run Text="{Binding Formula.UpdatedAt, StringFormat={}{0:yyyy-MM-dd}}"/>
                    </TextBlock>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
