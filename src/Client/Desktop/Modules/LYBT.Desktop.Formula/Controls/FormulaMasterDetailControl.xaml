<!--
    FormulaMasterDetailControl - 验方Master-Detail控件
    OpenSpec: refactor-admin-workspace
    
    可复用业务控件，供Admin和Clinical角色台使用
    从FormulaMasterDetailView重构而来
-->
<controls:MasterDetailControlBase
    x:Class="LYBT.Desktop.Formula.Controls.FormulaMasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:formulaControls="clr-namespace:LYBT.Desktop.Formula.Controls"
    xmlns:formulaView="clr-namespace:LYBT.Desktop.Infrastructure.Controls.FormulaView;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}">
        <!--
            ========================================
            Master区域: 验方列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  
                    <!--  工具栏  -->
                    <RowDefinition Height="Auto" />  
                    <!--  搜索  -->
                    <RowDefinition Height="*" />     
                    <!--  列表  -->
                    <RowDefinition Height="Auto" />  
                    <!--  分页  -->
                </Grid.RowDefinitions>

                <!--  工具栏  -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    BatchDeleteCommand="{Binding DeleteCommand}"
                    CreateCommand="{Binding CreateNewCommand}"
                    RefreshCommand="{Binding RefreshCommand}" />

                <!--  搜索框  -->
                <controls:SearchBox
                    Grid.Row="1"
                    Margin="12,8"
                    Placeholder="搜索验方名称..."
                    SearchCommand="{Binding SearchCommand}"
                    SearchText="{Binding SearchText, Mode=TwoWay}" />

                <!--  验方列表  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Style="{DynamicResource MasterDetailDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Name}"
                            Header="名称">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Category}"
                            Header="分类">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding HerbCount}"
                            Header="药味">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="50" Header="共享">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding IsShared}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!--  右键菜单 - ContextMenu需通过PlacementTarget获取DataContext  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding EditCommand}" Header="编辑" />
                            <MenuItem Command="{Binding CopyFormulaCommand}" Header="复制" />
                            <Separator />
                            <MenuItem Command="{Binding ToggleStatusCommand}" Header="切换状态" />
                            <MenuItem Command="{Binding RestoreCommand}" Header="恢复" />
                            <Separator />
                            <MenuItem Command="{Binding DeleteCommand}" Header="删除" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件  -->
                <Border Grid.Row="3" Style="{DynamicResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{DynamicResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共" />
                            <Run FontWeight="Medium" Text="{Binding TotalCount, Mode=OneWay}" />
                            <Run Text="条记录" />
                        </TextBlock>

                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="每页" />
                            <ComboBox
                                Width="60"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                IsEditable="False"
                                ItemsSource="{Binding PageSizes}"
                                SelectedItem="{Binding PageSize, Mode=TwoWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="条" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToFirstPageCommand}"
                                Content="首页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToPreviousPageCommand}"
                                Content="上一页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <TextBlock Style="{DynamicResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding TotalPages, Mode=OneWay}" />
                            </TextBlock>
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToNextPageCommand}"
                                Content="下一页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <Button
                                Command="{Binding GoToLastPageCommand}"
                                Content="末页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 验方详情/编辑
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  查看模式内容  -->
                <!--  OpenSpec: unify-vm-view-binding-patterns - 统一使用CurrentDetail  -->
                <formulaView:FormulaViewControl
                    Grid.Row="1"
                    Margin="16"
                    Formula="{Binding CurrentDetail}"
                    ShowAuditInfo="True"
                    Visibility="{Binding IsEditMode, Converter={x:Static converters:Cvt.InverseBoolToVis}}" />

                <!--  编辑模式内容  -->
                <!--  OpenSpec: unify-herb-controls-to-herbs-module - 使用HerbListControl替代HerbListEditor  -->
                <!--  OpenSpec: frontend-architecture-unification - 对象DP模式 -->
                <formulaControls:FormulaEditControl
                    Grid.Row="1"
                    Margin="16"
                    Formula="{Binding FormulaEditor.Formula}"
                    ErrorsSource="{Binding FormulaEditor.Formula.Errors}"
                    AllHerbs="{Binding AllHerbs}"
                    HerbItems="{Binding FormulaEditor.EditHerbItems, Mode=TwoWay}"
                    HerbCount="{Binding FormulaEditor.HerbCount}"
                    Visibility="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToVis}}" />

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="2"
                    IsLoading="{Binding IsBusy}"
                    LoadingText="正在处理..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选择验方时显示
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择验方"
                ActionCommand="{Binding CreateNewCommand}"
                ActionText="新增验方"
                Subtitle="在左侧列表中选择一个验方查看详情，或点击新增按钮创建验方" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
