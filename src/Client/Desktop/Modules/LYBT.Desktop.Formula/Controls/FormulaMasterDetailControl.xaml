<!--
    FormulaMasterDetailControl - 验方Master-Detail控件
    OpenSpec: refactor-admin-workspace

    可复用业务控件，供Admin和Clinical角色台使用
    从FormulaMasterDetailView重构而来
-->
<controls:MasterDetailControlBase x:Class="LYBT.Desktop.Formula.Controls.FormulaMasterDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
             xmlns:formulaControls="clr-namespace:LYBT.Desktop.Formula.Controls"
             xmlns:formulaView="clr-namespace:LYBT.Desktop.Infrastructure.Controls.FormulaView;assembly=LYBT.Desktop.Infrastructure">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}">
        <!-- ========================================
             Master区域: 验方列表
             ======================================== -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
                    <RowDefinition Height="Auto"/>  <!-- 搜索 -->
                    <RowDefinition Height="*"/>     <!-- 列表 -->
                    <RowDefinition Height="Auto"/>  <!-- 分页 -->
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <controls:DataGridToolbar Grid.Row="0"
                                          CreateCommand="{Binding CreateNewCommand}"
                                          RefreshCommand="{Binding RefreshCommand}"
                                          BatchDeleteCommand="{Binding DeleteCommand}"/>

                <!-- 搜索框 -->
                <controls:SearchBox Grid.Row="1"
                                    SearchText="{Binding SearchText, Mode=TwoWay}"
                                    SearchCommand="{Binding SearchCommand}"
                                    Placeholder="搜索验方名称..."
                                    Margin="12,8"/>

                <!-- 验方列表 -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                          behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                          Style="{DynamicResource MasterDetailDataGridStyle}"
                          RowHeaderWidth="0"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="分类"
                                            Binding="{Binding Category}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="药味"
                                            Binding="{Binding HerbCount}"
                                            Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="共享" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding IsShared}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="状态" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- 右键菜单 - ContextMenu需通过PlacementTarget获取DataContext -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="编辑" Command="{Binding EditCommand}"/>
                            <MenuItem Header="复制" Command="{Binding CopyFormulaCommand}"/>
                            <Separator/>
                            <MenuItem Header="切换状态" Command="{Binding ToggleStatusCommand}"/>
                            <MenuItem Header="恢复" Command="{Binding RestoreCommand}"/>
                            <Separator/>
                            <MenuItem Header="删除" Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- 分页控件 -->
                <Border Grid.Row="3" Style="{DynamicResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{DynamicResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                            <Run Text="条记录"/>
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="每页" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding PageSizes}"
                                      SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                      Width="60"
                                      Margin="6,0"
                                      VerticalAlignment="Center"
                                      IsEditable="False"/>
                            <TextBlock Text="条" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="首页"
                                    Style="{DynamicResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToFirstPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="上一页"
                                    Style="{DynamicResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToPreviousPageCommand}"
                                    Margin="0,0,4,0"/>
                            <TextBlock Style="{DynamicResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="下一页"
                                    Style="{DynamicResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToNextPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="末页"
                                    Style="{DynamicResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToLastPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="4"
                                         IsLoading="{Binding IsLoading}"
                                         LoadingText="{Binding BusyMessage}"/>
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!-- ========================================
             Detail区域: 验方详情/编辑
             ======================================== -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 详情工具栏 -->
                <controls:DetailToolbar Grid.Row="0"
                                        Title="{Binding DetailTitle}"
                                        IsEditMode="{Binding IsEditMode}"
                                        EditCommand="{Binding EditCommand}"
                                        SaveCommand="{Binding SaveCommand}"
                                        CancelCommand="{Binding CancelCommand}"
                                        DeleteCommand="{Binding DeleteCommand}"/>

                <!-- 查看模式内容 -->
                <!-- OpenSpec: unify-vm-view-binding-patterns - 统一使用CurrentDetail -->
                <formulaView:FormulaViewControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={x:Static converters:Cvt.InverseBoolToVis}}"
                    Formula="{Binding CurrentDetail}"
                    ShowAuditInfo="True"
                    Margin="16"/>

                <!-- 编辑模式内容 -->
                <!-- OpenSpec: unify-herb-controls-to-herbs-module - 使用HerbListControl替代HerbListEditor -->
                <!-- OpenSpec: unify-vm-view-binding-patterns - 统一使用CurrentDetail替代EditDetail -->
                <formulaControls:FormulaEditControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToVis}}"
                    FormulaName="{Binding CurrentDetail.Name, Mode=TwoWay}"
                    Category="{Binding CurrentDetail.Category, Mode=TwoWay}"
                    Property="{Binding CurrentDetail.Property, Mode=TwoWay}"
                    FormulaEffect="{Binding CurrentDetail.Effect, Mode=TwoWay}"
                    Usage="{Binding CurrentDetail.Usage, Mode=TwoWay}"
                    Remark="{Binding CurrentDetail.Remark, Mode=TwoWay}"
                    CreatedAt="{Binding CurrentDetail.CreatedAt}"
                    UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                    HerbCount="{Binding HerbCount}"
                    AllHerbs="{Binding AllHerbs}"
                    HerbItems="{Binding HerbItems, Mode=TwoWay}"
                    ErrorsSource="{Binding CurrentDetail.Errors}"
                    Margin="16"/>

                <!-- 详情加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="2"
                                         IsLoading="{Binding IsBusy}"
                                         LoadingText="正在处理..."/>
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!-- ========================================
             空状态: 未选择验方时显示
             ======================================== -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择验方"
                Subtitle="在左侧列表中选择一个验方查看详情，或点击新增按钮创建验方"
                ActionText="新增验方"
                ActionCommand="{Binding CreateNewCommand}"/>
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
