<UserControl x:Class="LYBT.Desktop.Formula.Views.FormulaManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.Formula.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance Type=viewmodels:FormulaManagementViewModel}">
    <UserControl.Resources>
        <!-- 枚举描述转换器 -->
        <infrastructure:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <!-- Bool到Visibility转换器 - OpenSpec: optimize-module-list-ui UI-022 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <!-- Issue #2002: 应用 BaseMasterDataListView 模板 -->
    <views:BaseMasterDataListView
        ItemsSource="{Binding Items}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
        ShowCheckBoxColumn="True"
        SearchText="{Binding SearchText, Mode=TwoWay}"
        SearchCommand="{Binding SearchCommand}"
        CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
        TotalPages="{Binding TotalPages}"
        PageSize="{Binding PageSize, Mode=TwoWay}"
        TotalCount="{Binding TotalCount}"
        FirstPageCommand="{Binding FirstPageCommand}"
        PreviousPageCommand="{Binding PreviousPageCommand}"
        NextPageCommand="{Binding NextPageCommand}"
        LastPageCommand="{Binding LastPageCommand}"
        IsBusy="{Binding IsBusy}"
        BusyMessage="{Binding BusyMessage}"
        EmptyStateText="暂无验方数据">

        <!-- 定义验方特定的 DataGrid 列 -->
        <views:BaseMasterDataListView.Columns>
            <!-- 验方名称 -->
            <DataGridTextColumn Header="验方名称"
                                Binding="{Binding Name}"
                                Width="150" />

            <!-- 分类 -->
            <DataGridTextColumn Header="分类"
                                Binding="{Binding Category}"
                                Width="100" />

            <!-- 功效 -->
            <DataGridTextColumn Header="功效"
                                Binding="{Binding Effect}"
                                Width="*" />

            <!-- 来源 -->
            <DataGridTextColumn Header="来源"
                                Binding="{Binding Source}"
                                Width="120" />

            <!-- 药材数量 -->
            <DataGridTextColumn Header="药材数"
                                Binding="{Binding HerbCount}"
                                Width="60" />

            <!-- OpenSpec: optimize-module-list-ui - UI-021 移除状态列，使用按钮切换 -->

            <!-- 操作列 - OpenSpec: optimize-module-list-ui UI-021/UI-022 -->
            <DataGridTemplateColumn Header="操作" Width="420">
                <DataGridTemplateColumn.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                    </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <Button Content="查看"
                                    Style="{StaticResource InfoButton}"
                                    Margin="4,0"
                                    ToolTip="查看验方详情"
                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <!-- OpenSpec: optimize-module-list-ui - UI-021 状态切换按钮 -->
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="4,0"
                                    Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Content>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="启用" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Enabled">
                                                        <Setter Property="Text" Value="禁用" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>
                            <!-- OpenSpec: unify-detail-view-style - 编辑按钮移至DetailView顶部 -->
                            <Button Content="复制"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="4,0"
                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <!-- OpenSpec: add-global-audit-system -->
                            <Button Content="记录"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="4,0"
                                    ToolTip="查看变更记录"
                                    Command="{Binding DataContext.ShowAuditLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <!-- OpenSpec: optimize-module-list-ui - UI-022 恢复按钮（仅管理员可见） -->
                            <Button Content="恢复"
                                    Style="{StaticResource WarningButton}"
                                    Margin="4,0"
                                    Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="删除"
                                    Style="{StaticResource DangerButton}"
                                    Margin="4,0"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </views:BaseMasterDataListView.Columns>

        <!-- 筛选内容区域(暂不添加筛选,保持简洁) -->
        <views:BaseMasterDataListView.FilterContent>
            <StackPanel Orientation="Horizontal" />
        </views:BaseMasterDataListView.FilterContent>

        <!-- 操作按钮区域 -->
        <views:BaseMasterDataListView.ActionButtons>
            <StackPanel Orientation="Horizontal">
                <Button Content="批量删除"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding BatchDeleteCommand}"
                        ToolTip="删除选中的验方"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="导入模板"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ImportFormulasCommand}"
                        ToolTip="从Excel/CSV文件导入验方模板"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="📄 导出模板"
                        Style="{StaticResource InfoButton}"
                        Command="{Binding ExportTemplateCommand}"
                        ToolTip="下载验方模板导入格式"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="📤 导出验方"
                        Style="{StaticResource WarningButton}"
                        Command="{Binding ExportFormulasCommand}"
                        ToolTip="导出验方数据到Excel文件"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="+ 新增验方"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding AddFormulaCommand}"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="刷新"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="🏠 返回主页"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NavigateToHomeCommand}"
                        ToolTip="返回管理员主页" />
            </StackPanel>
        </views:BaseMasterDataListView.ActionButtons>
    </views:BaseMasterDataListView>
</UserControl>
