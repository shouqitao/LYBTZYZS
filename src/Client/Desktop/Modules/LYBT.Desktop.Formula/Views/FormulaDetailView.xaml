<!--
    FormulaDetailView - 验方详情视图
    OpenSpec: refactor-detail-view-container

    重构说明：
    - 使用 BaseDetailContainer 容器实现查看/编辑模式分离
    - ViewContent: 纯展示模式，使用 TextBlock 显示只读值
    - EditContent: 表单编辑模式，使用 TextBox 输入
    - 药材列表区域通过 HerbCardControl 的 IsEditMode 属性控制
-->
<UserControl x:Class="LYBT.Desktop.Formula.Views.FormulaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:sharedControls="clr-namespace:LYBT.Desktop.Presentation.Components;assembly=LYBT.Desktop.Presentation"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <views:BaseDetailContainer
        Title="验方详情"
        IsEditMode="{Binding IsEditMode, Mode=OneWay}"
        GoBackCommand="{Binding BackCommand}"
        SwitchToEditCommand="{Binding EditCommand}"
        SaveCommand="{Binding SaveCommand}"
        CancelCommand="{Binding CancelEditCommand}"
        SaveButtonText="保存修改"
        IsLoading="{Binding IsLoading}"
        LoadingMessage="正在加载验方信息...">

        <!-- OpenSpec: implement-formula-copy-flow - 复制为我的验方功能 -->
        <!-- 查看模式下可复制验方（自己的可微调，他人的可借鉴） -->
        <views:BaseDetailContainer.ActionButtons>
            <Button Content="复制为我的验方"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding CopyAsMyFormulaCommand}"
                    ToolTip="基于当前验方创建副本，可修改后保存为我的验方"
                    Visibility="{Binding CanCopy, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="20,10"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center" />
        </views:BaseDetailContainer.ActionButtons>

        <!-- ========================================
             查看模式内容 (ViewContent)
             使用纯展示控件，无输入框边框
             ======================================== -->
        <views:BaseDetailContainer.ViewContent>
            <StackPanel>
                <!-- 基本信息卡片 -->
                <controls:InfoCard Title="基本信息">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：名称、分类 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="名称" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding FormulaName}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="分类" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Category}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <!-- 第二行：性味归经 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="性味归经" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Property}" Style="{StaticResource ValueDisplayStyle}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 第三行：功效 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="功效" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Effect}" Style="{StaticResource ValueDisplayStyle}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 第四行：用法 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="用法" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Usage}" Style="{StaticResource ValueDisplayStyle}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 第五行：备注 -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Remark}" Style="{StaticResource ValueDisplayStyle}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 第六行：创建时间、更新时间 -->
                            <StackPanel Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="创建时间" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Formula.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Style="{StaticResource ValueDisplayStyle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="更新时间" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Formula.UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Style="{StaticResource ValueDisplayStyle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- 药材组成卡片 -->
                <controls:InfoCard Title="{Binding HerbCount, StringFormat=药材组成 (共{0}味)}">
                    <controls:InfoCard.Content>
                        <ItemsControl ItemsSource="{Binding HerbItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <sharedControls:HerbCardControl
                                        IsEditMode="False"
                                        ShowPrice="False"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </views:BaseDetailContainer.ViewContent>

        <!-- ========================================
             编辑模式内容 (EditContent)
             使用表单输入控件
             ======================================== -->
        <views:BaseDetailContainer.EditContent>
            <StackPanel>
                <!-- 基本信息卡片 -->
                <controls:InfoCard Title="基本信息">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：名称、分类 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="名称" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding FormulaName, Mode=TwoWay}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="分类" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Category, Mode=TwoWay}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第二行：性味归经 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="性味归经" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Property, Mode=TwoWay}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         MinHeight="60"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第三行：功效 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="功效" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Effect, Mode=TwoWay}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         MinHeight="60"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第四行：用法 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="用法" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Usage, Mode=TwoWay}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         MinHeight="60"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第五行：备注 -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Remark, Mode=TwoWay}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         MinHeight="50"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第六行：创建时间、更新时间（只读显示） -->
                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="创建时间" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Formula.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Style="{StaticResource ValueDisplayStyle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="更新时间" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Formula.UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Style="{StaticResource ValueDisplayStyle}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- 药材组成卡片 - 编辑模式 -->
                <controls:InfoCard Title="{Binding HerbCount, StringFormat=药材组成 (共{0}味)}">
                    <controls:InfoCard.Content>
                        <ItemsControl ItemsSource="{Binding HerbItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <sharedControls:HerbCardControl
                                        IsEditMode="True"
                                        ShowPrice="False"
                                        DeleteCommand="{Binding DataContext.DeleteHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        DosageCompletedCommand="{Binding DataContext.DosageCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        AddNewRowCommand="{Binding DataContext.AddNewRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </views:BaseDetailContainer.EditContent>
    </views:BaseDetailContainer>
</UserControl>
