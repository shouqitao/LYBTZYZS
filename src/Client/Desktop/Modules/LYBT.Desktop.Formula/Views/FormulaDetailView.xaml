<!--
    FormulaDetailView - 验方详情视图
    OpenSpec: extract-detail-controls Task 1.3

    重构说明：
    - 使用 BaseDetailContainer 容器实现查看/编辑模式分离
    - ViewContent: 使用 FormulaViewControl 预览控件
    - EditContent: 使用 FormulaEditControl 编辑控件
-->
<UserControl x:Class="LYBT.Desktop.Formula.Views.FormulaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:formulaControls="clr-namespace:LYBT.Desktop.Formula.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- 转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <views:BaseDetailContainer
        Title="验方详情"
        IsEditMode="{Binding IsEditMode, Mode=OneWay}"
        GoBackCommand="{Binding BackCommand}"
        SwitchToEditCommand="{Binding EditCommand}"
        SaveCommand="{Binding SaveCommand}"
        CancelCommand="{Binding CancelEditCommand}"
        SaveButtonText="保存修改"
        IsLoading="{Binding IsLoading}"
        LoadingMessage="正在加载验方信息...">

        <!-- OpenSpec: implement-formula-copy-flow - 复制为我的验方功能 -->
        <!-- 查看模式下可复制验方（自己的可微调，他人的可借鉴） -->
        <views:BaseDetailContainer.ActionButtons>
            <Button Content="复制为我的验方"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding CopyAsMyFormulaCommand}"
                    ToolTip="基于当前验方创建副本，可修改后保存为我的验方"
                    Visibility="{Binding CanCopy, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="20,10"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center" />
        </views:BaseDetailContainer.ActionButtons>

        <!-- ========================================
             查看模式内容 (ViewContent)
             使用 FormulaViewControl 预览控件
             ======================================== -->
        <views:BaseDetailContainer.ViewContent>
            <formulaControls:FormulaViewControl
                Formula="{Binding Formula}"
                ShowAuditInfo="True"/>
        </views:BaseDetailContainer.ViewContent>

        <!-- ========================================
             编辑模式内容 (EditContent)
             使用 FormulaEditControl 编辑控件
             ======================================== -->
        <views:BaseDetailContainer.EditContent>
            <formulaControls:FormulaEditControl
                FormulaName="{Binding FormulaName, Mode=TwoWay}"
                Category="{Binding Category, Mode=TwoWay}"
                Property="{Binding Property, Mode=TwoWay}"
                FormulaEffect="{Binding Effect, Mode=TwoWay}"
                Usage="{Binding Usage, Mode=TwoWay}"
                Remark="{Binding Remark, Mode=TwoWay}"
                CreatedAt="{Binding Formula.CreatedAt}"
                UpdatedAt="{Binding Formula.UpdatedAt}"
                HerbCount="{Binding HerbCount}"
                HerbItems="{Binding HerbItems}"
                DeleteHerbCommand="{Binding DeleteHerbCommand}"
                DosageCompletedCommand="{Binding DosageCompletedCommand}"
                AddNewRowCommand="{Binding AddNewRowCommand}"/>
        </views:BaseDetailContainer.EditContent>
    </views:BaseDetailContainer>
</UserControl>
