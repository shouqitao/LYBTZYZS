<UserControl x:Class="LYBT.Desktop.Formula.Views.FormulaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.Formula.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- 卡片阴影 -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="16"
                          ShadowDepth="2"
                          Opacity="0.08"
                          Color="#000000"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <Grid Grid.Row="0" Margin="40,28,40,0">
            <Border Background="White"
                    CornerRadius="8"
                    Padding="24,16">
                <Grid MinHeight="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 返回按钮 -->
                    <Button Grid.Column="0"
                            Command="{Binding BackCommand}"
                            Content="← 返回"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#64748B"
                            FontSize="14"
                            Cursor="Hand"
                            Padding="8,4"
                            VerticalAlignment="Center" />

                    <!-- 标题 -->
                    <TextBlock Grid.Column="1"
                               Text="验方详情"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#1E293B"
                               Margin="16,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- 内容区域 - 简化为两块布局 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="40,16,40,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 区块1: 字段区 -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="8"
                        Padding="24"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 第一行: 名称 + 分类 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="名称:"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Formula.Name, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 FontSize="14"
                                 Margin="0,8,12,8" />

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="分类:"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />
                        <TextBox Grid.Row="0" Grid.Column="3"
                                 Text="{Binding Formula.Category, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 FontSize="14"
                                 Margin="0,8" />

                        <!-- 第二行: 性味归经 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="性味归经:"
                                   FontSize="14"
                                   VerticalAlignment="Top"
                                   Margin="0,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Property, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 MinHeight="50"
                                 Margin="0,8" />

                        <!-- 第三行: 功效 -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="功效:"
                                   FontSize="14"
                                   VerticalAlignment="Top"
                                   Margin="0,8" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Effect, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 MinHeight="50"
                                 Margin="0,8" />

                        <!-- 第四行: 用法 -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="用法:"
                                   FontSize="14"
                                   VerticalAlignment="Top"
                                   Margin="0,8" />
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Usage, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 MinHeight="50"
                                 Margin="0,8" />

                        <!-- 第五行: 描述 -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="描述:"
                                   FontSize="14"
                                   VerticalAlignment="Top"
                                   Margin="0,8" />
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Description, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 MinHeight="50"
                                 Margin="0,8" />

                        <!-- 第六行: 备注 -->
                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="备注:"
                                   FontSize="14"
                                   VerticalAlignment="Top"
                                   Margin="0,8" />
                        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Remark, Mode=TwoWay}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 MinHeight="40"
                                 Margin="0,8" />

                        <!-- 第七行: 创建时间 + 更新时间 -->
                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Text="创建时间:"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />
                        <TextBlock Grid.Row="6" Grid.Column="1"
                                   Text="{Binding Formula.CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="0,8,12,8" />

                        <TextBlock Grid.Row="6" Grid.Column="2"
                                   Text="更新时间:"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />
                        <TextBlock Grid.Row="6" Grid.Column="3"
                                   Text="{Binding Formula.UpdatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />
                    </Grid>
                </Border>

                <!-- 区块2: 药材区 -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="8"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 药材区标题 -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding HerbCount, StringFormat='药材组成 (共{0}味)'}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,16" />

                        <!-- 药材列表 -->
                        <ItemsControl Grid.Row="1"
                                     ItemsSource="{Binding HerbItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:HerbCardControl
                                        IsEditMode="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        DeleteCommand="{Binding DataContext.DeleteHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        DosageCompletedCommand="{Binding DataContext.DosageCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        HerbSelectedCommand="{Binding DataContext.HerbSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="50" Height="50"
                             IsIndeterminate="True"
                             Margin="0,0,0,16" />
                <TextBlock Text="正在加载验方信息..."
                           Foreground="White"
                           FontSize="16"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
