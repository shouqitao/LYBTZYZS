<UserControl x:Class="LYBT.Desktop.Formula.Views.EditFormulaDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.Formula.ViewModels"
             xmlns:controls="clr-namespace:LYBT.Desktop.Formula.Controls"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             prism:Dialog.WindowStyle="{StaticResource CustomDialogWindowStyle}"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:EditFormulaDialogViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColorBrush}" Padding="15,10">
            <TextBlock Text="编辑验方模板" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 基本信息 -->
                <GroupBox Grid.Row="0" Header="基本信息" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 验方名称 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="验方名称：" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Name}" Margin="0,5" Padding="5" />

                        <!-- 分类 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分类：" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding Formula.Category}"
                                  Margin="0,5" />

                        <!-- 来源 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="来源：" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Text="{Binding Formula.Source}" Margin="0,5" Padding="5" />

                        <!-- 适应症 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="适应症：" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Indications}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="60" Margin="0,5" Padding="5"
                                 VerticalScrollBarVisibility="Auto" />

                        <!-- 用法用量 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="用法用量：" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.DosageInstruction}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="40" Margin="0,5" Padding="5"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </GroupBox>

                <!-- 药材组成 -->
                <GroupBox Grid.Row="1" Header="药材组成" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <!-- 药材卡片列表 - Issue #2149: 使用UniformGrid 4列布局 + HerbCardControl -->
                        <ItemsControl ItemsSource="{Binding HerbItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:HerbCardControl
                                        IsEditMode="True"
                                        DeleteCommand="{Binding DataContext.DeleteHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        DosageCompletedCommand="{Binding DataContext.DosageCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        AddNewRowCommand="{Binding DataContext.AddNewRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </GroupBox>

                <!-- 备注 -->
                <GroupBox Grid.Row="2" Header="备注" Margin="0,0,0,15">
                    <TextBox Text="{Binding Formula.Remark}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Height="60" Margin="10" Padding="5"
                             VerticalScrollBarVisibility="Auto" />
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存" Command="{Binding SaveCommand}"
                            Width="80" Margin="0,0,10,0"
                            Background="{DynamicResource PrimaryColorBrush}"
                            Foreground="White" />
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            Width="80" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
