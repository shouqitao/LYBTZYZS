<UserControl
    x:Class="LYBT.Desktop.Reports.Views.ReportsHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,24,24,0" HorizontalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="28"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryBrush}"
                Text="统计报表" />
            <TextBlock
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="凌隐宝堂中医诊所 - 每日数据概览" />
        </StackPanel>

        <!-- Loading -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                FontSize="16"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="正在加载数据..." />
        </StackPanel>

        <!-- Error -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Collapsed}">
            <TextBlock
                FontSize="16"
                Foreground="{DynamicResource DangerBrush}"
                Text="{Binding ErrorMessage}" />
            <Button
                Margin="0,12,0,0"
                Command="{Binding LoadDataCommand}"
                Content="重试" />
        </StackPanel>

        <!-- Content Cards -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding IsLoading, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MaxWidth="900">

                <UniformGrid
                    Columns="3"
                    Margin="0,0,0,24">

                    <!-- Card 1: Daily Income -->
                    <Border Margin="12" Padding="20" Background="{DynamicResource MaterialDesignBody}" CornerRadius="8" MinHeight="180">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="当日收入" />
                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding DailyIncome.TotalIncome, StringFormat='¥{0:N2}'}" />
                            <Separator Margin="0,8" Background="{DynamicResource BorderBrush}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="挂号费: " />
                                <Run FontWeight="SemiBold" Text="{Binding DailyIncome.RegistrationFeeTotal, StringFormat='¥{0:N2}'}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="药品费: " />
                                <Run FontWeight="SemiBold" Text="{Binding DailyIncome.MedicineFeeTotal, StringFormat='¥{0:N2}'}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Daily Consultations -->
                    <Border Margin="12" Padding="20" Background="{DynamicResource MaterialDesignBody}" CornerRadius="8" MinHeight="180">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="当日看诊量" />
                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding DailyConsultations.TotalCount}" />
                            <Separator Margin="0,8" Background="{DynamicResource BorderBrush}" />
                            <ItemsControl ItemsSource="{Binding DailyConsultations.ByDoctor}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="{Binding DoctorName}" />
                                            <Run Text=": " />
                                            <Run FontWeight="SemiBold" Text="{Binding Count, StringFormat='{}{0}次'}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Daily Herb Usage -->
                    <Border Margin="12" Padding="20" Background="{DynamicResource MaterialDesignBody}" CornerRadius="8" MinHeight="180">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="当日药材频次" />
                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding DailyHerbUsage.Items.Count}" />
                            <Separator Margin="0,8" Background="{DynamicResource BorderBrush}" />
                            <ItemsControl MaxHeight="120" ItemsSource="{Binding DailyHerbUsage.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                            <Run Text="{Binding HerbName}" />
                                            <Run Text=" - " />
                                            <Run FontWeight="SemiBold" Text="{Binding UsageCount, StringFormat='{}{0}次'}" />
                                            <Run Text=" (" />
                                            <Run Text="{Binding TotalDosage, StringFormat='{}{0}g'}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
