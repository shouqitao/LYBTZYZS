<!--
    HerbViewControl - 药材预览控件（v2 单卡片布局 2026-06-27）
    单卡片 + 分区隔线 + 概要头，替代原 5 张独立卡片
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Controls.HerbViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
             xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">

    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ElementName=Root}">
        <controls:InfoCard>
            <controls:InfoCard.Content>
                <StackPanel>
                    <!-- 概要头 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Leaf"
                            Width="28" Height="28" VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock Grid.Column="1" Text="{Binding HerbName}"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                            Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <controls:StatusBadge Grid.Column="2" Status="{Binding Status}" VerticalAlignment="Center"
                            Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}" />
                    </Grid>

                    <Border Height="1" Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.2" />

                    <!-- 基本信息 -->
                    <TextBlock Text="基本信息" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Margin="0,0,0,8" Opacity="0.6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="拼音码"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PinYinCode, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center"
                            FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="分类"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Category, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="性味"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Properties, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="产地"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Origin, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="规格"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Spec, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="单位"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Unit, TargetNullValue='克'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.12" />

                    <!-- 价格信息 -->
                    <TextBlock Text="价格信息" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Margin="0,0,0,8" Opacity="0.6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="零售价"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                            Text="{Binding Price, StringFormat={}{0:F2}元}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}" FontWeight="Medium" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="成本价"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="3"
                            Text="{Binding CostPrice, StringFormat={}{0:F2}元, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.12" />

                    <!-- 功效用法 -->
                    <TextBlock Text="功效用法" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Margin="0,0,0,8" Opacity="0.6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="功效"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Top" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HerbEffect, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,0,8" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="用法"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Top" Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Usage, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,0,8" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="备注"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Top" Opacity="0.6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Remark, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,0,8" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>

                    <Border Height="1" Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.12" />

                    <!-- 系统信息 -->
                    <TextBlock Text="系统信息" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Margin="0,0,0,8" Opacity="0.6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="创建时间"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                            Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="更新时间"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="3"
                            Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                            Style="{StaticResource MaterialDesignBody2TextBlock}" Margin="0,8,16,8" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </ScrollViewer>
</UserControl>
