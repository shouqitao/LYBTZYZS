<!--
    HerbViewControl - 药材预览控件
    OpenSpec: extract-detail-controls Task 2.1

    独立的药材预览控件，可在HerbDetailView和其他需要展示药材信息的地方复用
    通过DependencyProperty接收数据，支持只读展示
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Controls.HerbViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 基本信息卡片 -->
        <controls:InfoCard Title="基本信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：药材名称、拼音码 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="药材名称" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding HerbName}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="拼音码" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding PinYinCode}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <!-- 第二行：产地、规格 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="产地" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Origin}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="规格" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Spec}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <!-- 第三行：单位、零售价 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="单位" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="零售价" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:F2} 元}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <!-- 第四行：成本价、状态 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="成本价" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding CostPrice, StringFormat={}{0:F2} 元}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelValueStyle}"
                                Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="状态" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>

        <!-- 功效用法卡片 -->
        <controls:InfoCard Title="功效用法">
            <controls:InfoCard.Content>
                <StackPanel>
                    <StackPanel Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="功效" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding HerbEffect}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="用法用量" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Usage}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>

                    <StackPanel Style="{StaticResource LabelValueStyle}">
                        <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding Remark}" Style="{StaticResource ValueDisplayStyle}"/>
                    </StackPanel>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
