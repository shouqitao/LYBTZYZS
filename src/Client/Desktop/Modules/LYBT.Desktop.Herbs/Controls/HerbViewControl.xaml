<!--
    HerbViewControl - 药材预览控件
    OpenSpec: extract-detail-controls Task 2.1
    OpenSpec: optimize-preview-layout - 优化布局和视觉层次

    独立的药材预览控件，可在HerbDetailView和其他需要展示药材信息的地方复用
    通过DependencyProperty接收数据，支持只读展示
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Controls.HerbViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 药材信息卡片 - 紧凑布局 -->
        <controls:InfoCard ShowTitle="False">
            <controls:InfoCard.Content>
                <StackPanel>
                    <!-- 头部: 药材名称 + 拼音码 + 状态Badge -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding HerbName}" Style="{StaticResource PreviewTitleStyle}"/>
                            <TextBlock Text="{Binding PinYinCode, StringFormat=({0})}"
                                       Style="{StaticResource PreviewSubtitleStyle}"
                                       Visibility="{Binding PinYinCode, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Style="{StaticResource PreviewBadgeSuccessStyle}"
                                Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource PreviewBadgeTextStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 紧凑信息区：基本信息 + 价格 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="产地：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="1" Text="{Binding Origin}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="规格：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="3" Text="{Binding Spec}" FontSize="13" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="4" Text="单位：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="5" Text="{Binding Unit}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="零售价：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:F2}元}" FontSize="13" Foreground="#0078D4" FontWeight="Medium" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="成本价：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="3" Text="{Binding CostPrice, StringFormat={}{0:F2}元}" FontSize="13"/>
                    </Grid>

                    <!-- 功效用法区域 - 仅当有内容时显示 -->
                    <Border Height="1" Background="#E1DFDD" Margin="0,8,0,8"
                            Visibility="{Binding HerbEffect, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <Grid Margin="0,0,0,6"
                          Visibility="{Binding HerbEffect, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="功效：" FontSize="13" Foreground="#605E5C" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding HerbEffect}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,6"
                          Visibility="{Binding Usage, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="用法：" FontSize="13" Foreground="#605E5C" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Usage}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,6"
                          Visibility="{Binding Remark, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="备注：" FontSize="13" Foreground="#605E5C" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{Binding Remark}" FontSize="13" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
