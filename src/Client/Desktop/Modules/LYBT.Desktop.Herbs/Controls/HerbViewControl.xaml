<!--
    HerbViewControl - 药材预览控件
    OpenSpec: extract-detail-controls Task 2.1
    OpenSpec: optimize-preview-layout - 优化布局和视觉层次
    OpenSpec: refactor-master-detail-layout - 详情区域UI优化

    独立的药材预览控件，可在HerbDetailView和其他需要展示药材信息的地方复用
    通过DependencyProperty接收数据，支持只读展示

    UI优化 (2025-12-16):
    - 采用多卡片分组布局，充分利用详情区域空间
    - 分为：基本信息、规格信息、价格信息、功效用法、系统信息五个逻辑区域
    - 添加：分类、性味、创建/更新时间等完整字段
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Controls.HerbViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ElementName=Root}">
        <StackPanel>
            <!-- ========================================
                 基本信息卡片
                 ======================================== -->
            <controls:InfoCard Title="基本信息" ShowTitle="True">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 药材名称 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="药材名称" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HerbName}" Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold"/>

                        <!-- 拼音码 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="拼音码" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PinYinCode, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}" FontFamily="Consolas"/>

                        <!-- 分类 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分类" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Category, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}"/>

                        <!-- 性味 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="性味" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Properties, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}"/>

                        <!-- 产地 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="产地" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Origin, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}"/>

                        <!-- 状态 -->
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="状态" Style="{StaticResource DetailLabelStyle}"
                                   Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <controls:StatusBadge Grid.Row="2" Grid.Column="3"
                                              Status="{Binding Status}"
                                              HorizontalAlignment="Left"
                                              Margin="0,4,0,4"
                                              Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 规格信息卡片
                 ======================================== -->
            <controls:InfoCard Title="规格信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 规格 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="规格" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Spec, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}"/>

                        <!-- 单位 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="单位" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Unit, TargetNullValue='克'}" Style="{StaticResource DetailValueStyle}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 价格信息卡片
                 ======================================== -->
            <controls:InfoCard Title="价格信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 零售价 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="零售价" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Price, StringFormat={}{0:F2}元}"
                                   Style="{StaticResource DetailValueStyle}"
                                   Foreground="#0078D4"
                                   FontWeight="Medium"/>

                        <!-- 成本价 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="成本价" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding CostPrice, StringFormat={}{0:F2}元, TargetNullValue='-'}"
                                   Style="{StaticResource DetailValueStyle}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 功效用法卡片
                 ======================================== -->
            <controls:InfoCard Title="功效用法" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 功效 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="功效" Style="{StaticResource DetailLabelStyle}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HerbEffect, TargetNullValue='-'}"
                                   Style="{StaticResource DetailValueStyle}" TextWrapping="Wrap"/>

                        <!-- 用法 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="用法" Style="{StaticResource DetailLabelStyle}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Usage, TargetNullValue='-'}"
                                   Style="{StaticResource DetailValueStyle}" TextWrapping="Wrap"/>

                        <!-- 备注 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="备注" Style="{StaticResource DetailLabelStyle}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Remark, TargetNullValue='-'}"
                                   Style="{StaticResource DetailValueStyle}" TextWrapping="Wrap"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 系统信息卡片
                 ======================================== -->
            <controls:InfoCard Title="系统信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 创建时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="创建时间" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <!-- 更新时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="更新时间" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                   Style="{StaticResource DetailValueStyle}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
