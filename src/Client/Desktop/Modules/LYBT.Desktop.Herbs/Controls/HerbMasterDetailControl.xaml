<!--
    HerbMasterDetailControl - 药材Master-Detail控件
    
    可复用业务控件，供Admin和Clinical角色台使用
    从HerbMasterDetailView重构而来
-->
<controls:MasterDetailControlBase
    x:Class="LYBT.Desktop.Herbs.Controls.HerbMasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:herbControls="clr-namespace:LYBT.Desktop.Herbs.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        资源加载说明:
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - ContextMenu通过PlacementTarget.DataContext获取ViewModel
    -->

    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}">
        <!--
            ========================================
            Master区域: 药材列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  
                    <!--  工具栏  -->
                    <RowDefinition Height="Auto" />  
                    <!--  搜索  -->
                    <RowDefinition Height="*" />     
                    <!--  列表  -->
                    <RowDefinition Height="Auto" />  
                    <!--  分页  -->
                </Grid.RowDefinitions>

                <!--  工具栏  -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    BatchDeleteCommand="{Binding DeleteCommand}"
                    CreateCommand="{Binding CreateNewCommand}"
                    ExportCommand="{Binding ExportHerbsCommand}"
                    RefreshCommand="{Binding RefreshCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <!--  导入（单一次要操作，平铺为Outlined按钮）  -->
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding ImportHerbsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="导入药材">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="导入" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!--  搜索框  -->
                <controls:SearchBox
                    Grid.Row="1"
                    Margin="12,8"
                    Placeholder="搜索药材名称/拼音码..."
                    SearchCommand="{Binding SearchCommand}"
                    SearchText="{Binding SearchText, Mode=TwoWay}" />

                <!--  药材列表  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    BorderThickness="0"
                    Background="Transparent"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <!--  名称  -->
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Name}"
                            Header="名称"
                            ElementStyle="{StaticResource DataGridEmphasisCellStyle}" />

                        <!--  拼音码  -->
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding PinYinCode}"
                            Header="拼音码"
                            ElementStyle="{StaticResource DataGridMonoCellStyle}" />

                        <!--  规格  -->
                        <DataGridTextColumn
                            Width="60"
                            Binding="{Binding Spec}"
                            Header="规格"
                            ElementStyle="{StaticResource DataGridSecondaryCellStyle}" />

                        <!--  单位  -->
                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding Unit}"
                            Header="单位"
                            ElementStyle="{StaticResource DataGridSecondaryCellStyle}" />

                        <!--  零售价  -->
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Price, StringFormat=N2}"
                            Header="零售价"
                            ElementStyle="{StaticResource DataGridNumericCellStyle}" />

                        <!--  状态  -->
                        <DataGridTemplateColumn Width="*" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!--  右键菜单 - 分组：编辑 | 管理 | 危险操作  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <!--  编辑操作组  -->
                            <MenuItem Command="{Binding EditCommand}" Header="编辑">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Pencil" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding CopyHerbCommand}" Header="复制">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  管理操作组  -->
                            <MenuItem Command="{Binding ToggleStatusCommand}" Header="切换状态">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ToggleSwitchOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding RestoreCommand}" Header="恢复">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Undo" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  危险操作组  -->
                            <MenuItem Command="{Binding DeleteCommand}" Header="删除">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件  -->
                <controls:UnifiedPaginationBar
                    Grid.Row="3"
                    CurrentPage="{Binding CurrentPage}"
                    TotalPages="{Binding TotalPages}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageSizes="{Binding PageSizes}"
                    FirstPageCommand="{Binding GoToFirstPageCommand}"
                    PreviousPageCommand="{Binding GoToPreviousPageCommand}"
                    NextPageCommand="{Binding GoToNextPageCommand}"
                    LastPageCommand="{Binding GoToLastPageCommand}" />

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 药材详情/编辑
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  详情内容（Transitioner 切换查看/编辑）  -->
                <materialDesign:Transitioner
                    Grid.Row="1"
                    SelectedIndex="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToInt}}">
                    <materialDesign:TransitionerSlide>
                        <herbControls:HerbViewControl
                            Margin="16"
                            Category="{Binding CurrentDetail.Category}"
                            CostPrice="{Binding CurrentDetail.CostPrice}"
                            CreatedAt="{Binding CurrentDetail.CreatedAt}"
                            HerbEffect="{Binding CurrentDetail.Effect}"
                            HerbName="{Binding CurrentDetail.Name}"
                            Origin="{Binding CurrentDetail.Origin}"
                            PinYinCode="{Binding CurrentDetail.PinYinCode}"
                            Price="{Binding CurrentDetail.Price}"
                            Properties="{Binding CurrentDetail.Properties}"
                            Remark="{Binding CurrentDetail.Remark}"
                            ShowStatus="True"
                            Spec="{Binding CurrentDetail.Spec}"
                            Status="{Binding CurrentDetail.Status}"
                            Unit="{Binding CurrentDetail.Unit}"
                            UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                            Usage="{Binding CurrentDetail.Usage}" />
                    </materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide>
                        <herbControls:HerbEditControl
                            Margin="16"
                            Herb="{Binding HerbEditor.Herb}"
                            ErrorsSource="{Binding HerbEditor.Herb.Errors}"
                            IsNameEditable="{Binding IsNameEditable}"
                            ShowStatus="True"
                            StatusOptions="{Binding StatusOptions}" />
                    </materialDesign:TransitionerSlide>
                </materialDesign:Transitioner>

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="2"
                    IsLoading="{Binding IsBusy}"
                    LoadingText="正在处理..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选择药材时显示
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择药材"
                ActionCommand="{Binding CreateNewCommand}"
                ActionText="新增药材"
                Subtitle="在左侧列表中选择一个药材查看详情，或点击新增按钮创建药材" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
