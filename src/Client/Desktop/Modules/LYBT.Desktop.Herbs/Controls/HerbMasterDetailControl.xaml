<!--
    HerbMasterDetailControl - 药材Master-Detail控件
    OpenSpec: refactor-admin-workspace
    
    可复用业务控件，供Admin和Clinical角色台使用
    从HerbMasterDetailView重构而来
-->
<controls:MasterDetailControlBase
    x:Class="LYBT.Desktop.Herbs.Controls.HerbMasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:herbControls="clr-namespace:LYBT.Desktop.Herbs.Controls"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - ContextMenu通过PlacementTarget.DataContext获取ViewModel
    -->

    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}">
        <!--
            ========================================
            Master区域: 药材列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  
                    <!--  工具栏  -->
                    <RowDefinition Height="Auto" />  
                    <!--  搜索  -->
                    <RowDefinition Height="*" />     
                    <!--  列表  -->
                    <RowDefinition Height="Auto" />  
                    <!--  分页  -->
                </Grid.RowDefinitions>

                <!--  工具栏  -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    BatchDeleteCommand="{Binding DeleteCommand}"
                    CreateCommand="{Binding CreateNewCommand}"
                    ExportCommand="{Binding ExportHerbsCommand}"
                    RefreshCommand="{Binding RefreshCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Margin="4,0,0,0"
                                Padding="12,6"
                                Command="{Binding ImportHerbsCommand}"
                                Content="导入"
                                Style="{DynamicResource SecondaryButton}" />
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!--  搜索框  -->
                <controls:SearchBox
                    Grid.Row="1"
                    Margin="12,8"
                    Placeholder="搜索药材名称/拼音码..."
                    SearchCommand="{Binding SearchCommand}"
                    SearchText="{Binding SearchText, Mode=TwoWay}" />

                <!--  药材列表  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Style="{DynamicResource MasterDetailDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Name}"
                            Header="名称">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding PinYinCode}"
                            Header="拼音码">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="60"
                            Binding="{Binding Spec}"
                            Header="规格">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding Unit}"
                            Header="单位">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Price, StringFormat=N2}"
                            Header="零售价">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="*" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!--  右键菜单 - ContextMenu需通过PlacementTarget获取DataContext  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding EditCommand}" Header="编辑" />
                            <MenuItem Command="{Binding CopyHerbCommand}" Header="复制" />
                            <Separator />
                            <MenuItem Command="{Binding ToggleStatusCommand}" Header="切换状态" />
                            <MenuItem Command="{Binding RestoreCommand}" Header="恢复" />
                            <Separator />
                            <MenuItem Command="{Binding DeleteCommand}" Header="删除" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件  -->
                <Border Grid.Row="3" Style="{DynamicResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{DynamicResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共" />
                            <Run FontWeight="Medium" Text="{Binding TotalCount, Mode=OneWay}" />
                            <Run Text="条记录" />
                        </TextBlock>

                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="每页" />
                            <ComboBox
                                Width="60"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                IsEditable="False"
                                ItemsSource="{Binding PageSizes}"
                                SelectedItem="{Binding PageSize, Mode=TwoWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="条" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToFirstPageCommand}"
                                Content="首页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToPreviousPageCommand}"
                                Content="上一页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <TextBlock Style="{DynamicResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding TotalPages, Mode=OneWay}" />
                            </TextBlock>
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToNextPageCommand}"
                                Content="下一页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <Button
                                Command="{Binding GoToLastPageCommand}"
                                Content="末页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 药材详情/编辑
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  查看模式内容  -->
                <herbControls:HerbViewControl
                    Grid.Row="1"
                    Margin="16"
                    Category="{Binding CurrentDetail.Category}"
                    CostPrice="{Binding CurrentDetail.CostPrice}"
                    CreatedAt="{Binding CurrentDetail.CreatedAt}"
                    HerbEffect="{Binding CurrentDetail.Effect}"
                    HerbName="{Binding CurrentDetail.Name}"
                    Origin="{Binding CurrentDetail.Origin}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode}"
                    Price="{Binding CurrentDetail.Price}"
                    Properties="{Binding CurrentDetail.Properties}"
                    Remark="{Binding CurrentDetail.Remark}"
                    ShowStatus="True"
                    Spec="{Binding CurrentDetail.Spec}"
                    Status="{Binding CurrentDetail.Status}"
                    Unit="{Binding CurrentDetail.Unit}"
                    UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                    Usage="{Binding CurrentDetail.Usage}"
                    Visibility="{Binding IsEditMode, Converter={x:Static converters:Cvt.InverseBoolToVis}}" />

                <!--  编辑模式内容  -->
                <!--  OpenSpec: frontend-architecture-unification - 对象DP模式 -->
                <herbControls:HerbEditControl
                    Grid.Row="1"
                    Margin="16"
                    Herb="{Binding HerbEditor.Herb}"
                    ErrorsSource="{Binding HerbEditor.Herb.Errors}"
                    IsNameEditable="{Binding IsNameEditable}"
                    ShowStatus="True"
                    StatusOptions="{Binding StatusOptions}"
                    Visibility="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToVis}}" />

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="2"
                    IsLoading="{Binding IsBusy}"
                    LoadingText="正在处理..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选择药材时显示
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择药材"
                ActionCommand="{Binding CreateNewCommand}"
                ActionText="新增药材"
                Subtitle="在左侧列表中选择一个药材查看详情，或点击新增按钮创建药材" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
