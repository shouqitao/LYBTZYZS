<!--
    HerbEditControl - 药材编辑控件
    OpenSpec: extract-detail-controls Task 2.2

    独立的药材编辑控件，可在HerbDetailView中复用
    通过DependencyProperty接收数据，支持双向绑定
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Controls.HerbEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 基本信息卡片 -->
        <controls:InfoCard Title="基本信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：药材名称、拼音码 -->
                    <!-- OpenSpec: ui-validation-framework - 添加验证绑定 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Style="{DynamicResource FormLabelStyle}">
                            <Run Text="药材名称"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                        </TextBlock>
                        <TextBox Text="{Binding HerbName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 IsReadOnly="{Binding IsNameEditable, Converter={x:Static converters:Cvt.InverseBool}}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[Name]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="拼音码（可修正）" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"
                                 ToolTip="自动根据名称生成，如有多音字错误可手动修正"/>
                    </StackPanel>

                    <!-- 第二行：产地、规格 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="产地" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Origin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="规格" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Spec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- 第三行：单位、零售价 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Style="{DynamicResource FormLabelStyle}">
                            <Run Text="单位"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                        </TextBlock>
                        <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[Unit]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="零售价" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Price, Mode=TwoWay, StringFormat={}{0:0.##}, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[Price]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <!-- 第四行：成本价、状态 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="成本价" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding CostPrice, Mode=TwoWay, StringFormat={}{0:0.##}, TargetNullValue=''}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20"
                                Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}">
                        <TextBlock Text="状态" Style="{DynamicResource FormLabelStyle}"/>
                        <ComboBox SelectedItem="{Binding Status, Mode=TwoWay}"
                                  ItemsSource="{Binding StatusOptions}"
                                  IsEnabled="False"
                                  MinHeight="44"
                                  Padding="12,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>

        <!-- 功效用法卡片 -->
        <controls:InfoCard Title="功效用法">
            <controls:InfoCard.Content>
                <StackPanel>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="功效" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding HerbEffect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="用法用量" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Usage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 Padding="12,10"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="备注" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 Padding="12,10"/>
                    </StackPanel>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
