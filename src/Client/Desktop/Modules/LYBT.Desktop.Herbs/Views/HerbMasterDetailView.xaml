<!--
    HerbMasterDetailView - 药材Master-Detail视图V2（组合模式）
    OpenSpec: refactor-viewmodel-composition

    使用组合模式ViewModel (HerbMasterDetailViewModelV2)
    命令名称已适配新基类
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Views.HerbMasterDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
             xmlns:herbControls="clr-namespace:LYBT.Desktop.Herbs.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <controls:MasterDetailLayout HasSelection="{Binding HasSelection}">
        <!-- ========================================
             Master区域: 药材列表
             ======================================== -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
                    <RowDefinition Height="Auto"/>  <!-- 搜索 -->
                    <RowDefinition Height="*"/>     <!-- 列表 -->
                    <RowDefinition Height="Auto"/>  <!-- 分页 -->
                </Grid.RowDefinitions>

                <!-- 工具栏 - 适配V2命令 -->
                <controls:DataGridToolbar Grid.Row="0"
                                          CreateCommand="{Binding CreateNewCommand}"
                                          RefreshCommand="{Binding RefreshCommand}"
                                          ExportCommand="{Binding ExportHerbsCommand}"
                                          BatchDeleteCommand="{Binding DeleteCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="导入"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ImportHerbsCommand}"
                                    Padding="12,6"
                                    Margin="4,0,0,0"/>
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!-- 搜索框 -->
                <controls:SearchBox Grid.Row="1"
                                    SearchText="{Binding SearchText, Mode=TwoWay}"
                                    SearchCommand="{Binding SearchCommand}"
                                    Placeholder="搜索药材名称/拼音码..."
                                    Margin="12,8"/>

                <!-- 药材列表 -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                          behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
                          Style="{StaticResource MasterDetailDataGridStyle}"
                          RowHeaderWidth="0"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="拼音码"
                                            Binding="{Binding PinYinCode}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="规格"
                                            Binding="{Binding Spec}"
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="单位"
                                            Binding="{Binding Unit}"
                                            Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="零售价"
                                            Binding="{Binding Price, StringFormat=N2}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="状态" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- 行右键菜单 - 适配V2命令 -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑" Command="{Binding EditCommand}"/>
                            <MenuItem Header="复制" Command="{Binding CopyHerbCommand}"/>
                            <Separator/>
                            <MenuItem Header="切换状态" Command="{Binding ToggleStatusCommand}"/>
                            <MenuItem Header="恢复" Command="{Binding RestoreCommand}"/>
                            <Separator/>
                            <MenuItem Header="审计日志" Command="{Binding ShowAuditLogCommand}"/>
                            <Separator/>
                            <MenuItem Header="删除" Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- 分页控件 - 适配V2命令 -->
                <Border Grid.Row="3" Style="{StaticResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                            <Run Text="条记录"/>
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="每页" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding PageSizes}"
                                      SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                      Width="60"
                                      Margin="6,0"
                                      VerticalAlignment="Center"
                                      IsEditable="False"/>
                            <TextBlock Text="条" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="首页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToFirstPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="上一页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToPreviousPageCommand}"
                                    Margin="0,0,4,0"/>
                            <TextBlock Style="{StaticResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="下一页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToNextPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="末页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToLastPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="4"
                                         IsLoading="{Binding IsLoading}"
                                         LoadingText="{Binding BusyMessage}"/>
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!-- ========================================
             Detail区域: 药材详情/编辑
             ======================================== -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 详情工具栏 - 适配V2命令 -->
                <controls:DetailToolbar Grid.Row="0"
                                        Title="{Binding DetailTitle}"
                                        IsEditMode="{Binding IsEditMode}"
                                        EditCommand="{Binding EditCommand}"
                                        SaveCommand="{Binding SaveCommand}"
                                        CancelCommand="{Binding CancelCommand}"
                                        DeleteCommand="{Binding DeleteCommand}"/>

                <!-- 查看模式内容 -->
                <herbControls:HerbViewControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    HerbName="{Binding CurrentDetail.Name}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode}"
                    Category="{Binding CurrentDetail.Category}"
                    Properties="{Binding CurrentDetail.Properties}"
                    Origin="{Binding CurrentDetail.Origin}"
                    Spec="{Binding CurrentDetail.Spec}"
                    Unit="{Binding CurrentDetail.Unit}"
                    Price="{Binding CurrentDetail.Price}"
                    CostPrice="{Binding CurrentDetail.CostPrice}"
                    Status="{Binding CurrentDetail.Status}"
                    HerbEffect="{Binding CurrentDetail.Effect}"
                    Usage="{Binding CurrentDetail.Usage}"
                    Remark="{Binding CurrentDetail.Remark}"
                    CreatedAt="{Binding CurrentDetail.CreatedAt}"
                    UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                    ShowStatus="True"
                    Margin="16"/>

                <!-- 编辑模式内容 -->
                <herbControls:HerbEditControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HerbName="{Binding CurrentDetail.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsNameEditable="{Binding IsNameEditable}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Origin="{Binding CurrentDetail.Origin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Spec="{Binding CurrentDetail.Spec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Unit="{Binding CurrentDetail.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Price="{Binding CurrentDetail.Price, Mode=TwoWay}"
                    CostPrice="{Binding CurrentDetail.CostPrice, Mode=TwoWay}"
                    Status="{Binding CurrentDetail.Status, Mode=TwoWay}"
                    StatusOptions="{Binding StatusOptions}"
                    HerbEffect="{Binding CurrentDetail.Effect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Usage="{Binding CurrentDetail.Usage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Remark="{Binding CurrentDetail.Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ErrorsSource="{Binding CurrentDetail.Errors}"
                    ShowStatus="True"
                    Margin="16"/>

                <!-- 详情加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="2"
                                         IsLoading="{Binding IsBusy}"
                                         LoadingText="加载详情中..."/>
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!-- ========================================
             空状态: 未选中药材时显示
             ======================================== -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择药材"
                Subtitle="从左侧列表中选择一种药材查看详情，或点击新增按钮创建新药材"
                ActionText="新增药材"
                ActionCommand="{Binding CreateNewCommand}"/>
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</UserControl>
