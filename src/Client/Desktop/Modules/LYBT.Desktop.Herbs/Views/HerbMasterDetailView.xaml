<!--
    HerbMasterDetailView - 药材Master-Detail视图
    OpenSpec: refactor-master-detail-layout

    重构说明：
    - 合并HerbManagementView和HerbDetailView为单一视图
    - 左侧40%显示药材列表，右侧60%显示详情/编辑
    - 复用HerbViewControl和HerbEditControl

    UI优化 (2025-12-16):
    - 应用统一DataGrid样式(MasterDetailDataGridStyle)
    - 使用StatusBadge组件显示状态
    - 应用统一分页样式
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Views.HerbMasterDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:herbControls="clr-namespace:LYBT.Desktop.Herbs.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <controls:MasterDetailLayout HasSelection="{Binding HasSelection}">
        <!-- ========================================
             Master区域: 药材列表
             ======================================== -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
                    <RowDefinition Height="Auto"/>  <!-- 搜索 -->
                    <RowDefinition Height="*"/>     <!-- 列表 -->
                    <RowDefinition Height="Auto"/>  <!-- 分页 -->
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <controls:DataGridToolbar Grid.Row="0"
                                          CreateCommand="{Binding AddCommand}"
                                          RefreshCommand="{Binding RefreshCommand}"
                                          ExportCommand="{Binding ExportCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="导入"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ImportCommand}"
                                    Padding="12,6"
                                    Margin="4,0,0,0"/>
                            <Button Content="模板"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DownloadTemplateCommand}"
                                    Padding="12,6"
                                    Margin="4,0,0,0"/>
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!-- 搜索框 -->
                <controls:SearchBox Grid.Row="1"
                                    SearchText="{Binding SearchText, Mode=TwoWay}"
                                    SearchCommand="{Binding SearchCommand}"
                                    Placeholder="搜索药材名称/拼音码..."
                                    Margin="12,8"/>

                <!-- 药材列表 - 使用统一DataGrid样式 -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          Style="{StaticResource MasterDetailDataGridStyle}"
                          RowHeaderWidth="0"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <!-- 药材名称 -->
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 拼音码 -->
                        <DataGridTextColumn Header="拼音码"
                                            Binding="{Binding PinYinCode}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 规格 -->
                        <DataGridTextColumn Header="规格"
                                            Binding="{Binding Spec}"
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 单位 -->
                        <DataGridTextColumn Header="单位"
                                            Binding="{Binding Unit}"
                                            Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 零售价 -->
                        <DataGridTextColumn Header="零售价"
                                            Binding="{Binding Price, StringFormat=N2}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 状态 - 使用StatusBadge组件 -->
                        <DataGridTemplateColumn Header="状态" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- 行右键菜单 -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑" Command="{Binding EditCommand}"/>
                            <MenuItem Header="复制" Command="{Binding CopyHerbCommand}"/>
                            <Separator/>
                            <MenuItem Header="切换状态" Command="{Binding ToggleStatusCommand}"/>
                            <MenuItem Header="恢复" Command="{Binding RestoreCommand}"/>
                            <Separator/>
                            <MenuItem Header="审计日志" Command="{Binding ShowAuditLogCommand}"/>
                            <Separator/>
                            <MenuItem Header="删除" Command="{Binding DeleteCurrentCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- 分页控件 - 使用统一样式 -->
                <Border Grid.Row="3" Style="{StaticResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 统计信息 -->
                        <TextBlock Grid.Column="0" Style="{StaticResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                            <Run Text="条记录"/>
                        </TextBlock>

                        <!-- 分页按钮 -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="首页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding FirstPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="上一页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding PreviousPageCommand}"
                                    Margin="0,0,4,0"/>
                            <TextBlock Style="{StaticResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="下一页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding NextPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="末页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding LastPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="4"
                                         IsLoading="{Binding IsLoading}"
                                         LoadingText="{Binding BusyMessage}"/>
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!-- ========================================
             Detail区域: 药材详情/编辑
             ======================================== -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 工具栏 -->
                    <RowDefinition Height="*"/>     <!-- 内容 -->
                </Grid.RowDefinitions>

                <!-- 详情工具栏 -->
                <controls:DetailToolbar Grid.Row="0"
                                        Title="{Binding DetailTitle}"
                                        IsEditMode="{Binding IsEditMode}"
                                        EditCommand="{Binding EditCommand}"
                                        SaveCommand="{Binding SaveCommand}"
                                        CancelCommand="{Binding CancelCommand}"
                                        DeleteCommand="{Binding DeleteCurrentCommand}"/>

                <!-- 查看模式内容 -->
                <herbControls:HerbViewControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    HerbName="{Binding CurrentDetail.Name}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode}"
                    Category="{Binding CurrentDetail.Category}"
                    Properties="{Binding CurrentDetail.Properties}"
                    Origin="{Binding CurrentDetail.Origin}"
                    Spec="{Binding CurrentDetail.Spec}"
                    Unit="{Binding CurrentDetail.Unit}"
                    Price="{Binding CurrentDetail.Price}"
                    CostPrice="{Binding CurrentDetail.CostPrice}"
                    Status="{Binding CurrentDetail.Status}"
                    HerbEffect="{Binding CurrentDetail.Effect}"
                    Usage="{Binding CurrentDetail.Usage}"
                    Remark="{Binding CurrentDetail.Remark}"
                    CreatedAt="{Binding CurrentDetail.CreatedAt}"
                    UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                    ShowStatus="True"
                    Margin="16"/>

                <!-- 编辑模式内容 -->
                <herbControls:HerbEditControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HerbName="{Binding EditName, Mode=TwoWay}"
                    IsNameEditable="{Binding IsNameEditable}"
                    PinYinCode="{Binding EditPinYinCode, Mode=TwoWay}"
                    Origin="{Binding EditOrigin, Mode=TwoWay}"
                    Spec="{Binding EditSpec, Mode=TwoWay}"
                    Unit="{Binding EditUnit, Mode=TwoWay}"
                    Price="{Binding EditPrice, Mode=TwoWay}"
                    CostPrice="{Binding EditCostPrice, Mode=TwoWay}"
                    Status="{Binding EditStatus, Mode=TwoWay}"
                    StatusOptions="{Binding StatusOptions}"
                    HerbEffect="{Binding EditEffect, Mode=TwoWay}"
                    Usage="{Binding EditUsage, Mode=TwoWay}"
                    Remark="{Binding EditRemark, Mode=TwoWay}"
                    ShowStatus="True"
                    Margin="16"/>

                <!-- 详情加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="2"
                                         IsLoading="{Binding IsLoadingDetail}"
                                         LoadingText="加载详情中..."/>
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!-- ========================================
             空状态: 未选中药材时显示
             ======================================== -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择药材"
                Subtitle="从左侧列表中选择一种药材查看详情，或点击新增按钮创建新药材"
                ActionText="新增药材"
                ActionCommand="{Binding AddCommand}"/>
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</UserControl>
