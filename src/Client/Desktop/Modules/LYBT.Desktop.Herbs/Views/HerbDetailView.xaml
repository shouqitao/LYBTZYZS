<UserControl x:Class="LYBT.Desktop.Herbs.Views.HerbDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 布尔值反转转换器 -->
            <infrastructure:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <!-- 布尔值转可见性转换器 -->
            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- 表单标签样式 -->
            <Style x:Key="FormLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- 可编辑TextBox样式 -->
            <Style x:Key="EditableTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                </Trigger>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 主按钮样式 -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3B82F6"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#9CA3AF"/>
                                    <Setter Property="Foreground" Value="#D1D5DB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 次要按钮样式 -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 卡片阴影 -->
            <DropShadowEffect x:Key="CardShadow"
                              BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.08"
                              Color="#000000"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <Grid Grid.Row="0" Margin="40,28,40,0">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="32,24"
                    Effect="{StaticResource CardShadow}">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 返回按钮 -->
                    <Button Grid.Column="0"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="← 返回"
                            Padding="16,10"
                            FontSize="15"
                            VerticalAlignment="Center"/>

                    <!-- 页面标题 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding PageTitle}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#1E293B"
                               Margin="20,0,0,0" />

                    <!-- View模式：切换到编辑按钮 -->
                    <Button Grid.Column="2"
                            Command="{Binding SwitchToEditModeCommand}"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="✏️ 编辑"
                            Padding="20,10"
                            FontSize="15"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 表单内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="40,28,40,0">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="40,32"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <!-- 基本信息区 -->
                    <TextBlock Text="基本信息"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 第一行：药材名称、拼音码 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="药材名称 *" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsNameEditable, Converter={StaticResource InverseBooleanConverter}}"
                                     MinHeight="44"
                                     Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="拼音码（自动生成）" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding PinYinCode}"
                                     IsReadOnly="True"
                                     Background="#F9FAFB"
                                     MinHeight="44"
                                     Padding="12,10"/>
                        </StackPanel>

                        <!-- 第二行：产地、规格 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="产地" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Origin, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     MinHeight="44"
                                     Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="规格" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Spec, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     MinHeight="44"
                                     Padding="12,10"/>
                        </StackPanel>

                        <!-- 第三行：单位、零售价 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="单位 *" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     MinHeight="44"
                                     Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="零售价" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     MinHeight="44"
                                     Padding="12,10"/>
                        </StackPanel>

                        <!-- 第四行：成本价、Status (仅Detail模式显示) -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="成本价" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     MinHeight="44"
                                     Padding="12,10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20"
                                    Visibility="{Binding IsDetailMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="状态" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox SelectedItem="{Binding Status}"
                                      ItemsSource="{Binding StatusOptions}"
                                      IsEnabled="False"
                                      MinHeight="44"
                                      Padding="12,10"/>
                        </StackPanel>
                    </Grid>

                    <!-- 功效用法区 -->
                    <TextBlock Text="功效用法"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,24,0,24"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 功效 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="功效" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Effect, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="80"
                                     Padding="12,10"/>
                        </StackPanel>

                        <!-- 用法用量 -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="用法用量" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Usage, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="80"
                                     Padding="12,10"/>
                        </StackPanel>

                        <!-- 备注 -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,0">
                            <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableTextBoxStyle}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60"
                                     Padding="12,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 底部操作按钮区 - Edit/Create模式显示（View模式只读，无按钮） -->
        <Grid Grid.Row="2" Margin="40,28,40,28"
              Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="32,24"
                    Effect="{StaticResource CardShadow}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 取消按钮 -->
                    <Button Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="取消"
                            Padding="32,12"
                            FontSize="15"
                            MinWidth="120"/>

                    <!-- 提交按钮 (动态文本：创建/保存) -->
                    <Button Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="32,12"
                            FontSize="15"
                            MinWidth="120"
                            Margin="16,0,0,0">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="保存"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                                                <Setter Property="Text" Value="创建"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCreateMode}" Value="False">
                                                <Setter Property="Text" Value="保存"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Loading遮罩 -->
        <Grid Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
