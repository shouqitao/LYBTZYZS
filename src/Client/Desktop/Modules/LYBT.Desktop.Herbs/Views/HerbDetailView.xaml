<!--
    HerbDetailView - 药材详情视图
    OpenSpec: refactor-detail-view-container

    重构说明：
    - 使用 BaseDetailContainer 容器实现查看/编辑模式分离
    - ViewContent: 纯展示模式，使用 TextBlock 显示只读值
    - EditContent: 表单编辑模式，使用 TextBox 输入
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Views.HerbDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infrastructure:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <views:BaseDetailContainer
        Title="{Binding PageTitle}"
        IsEditMode="{Binding IsEditMode, Mode=OneWay}"
        GoBackCommand="{Binding GoBackCommand}"
        SwitchToEditCommand="{Binding SwitchToEditModeCommand}"
        SaveCommand="{Binding SubmitCommand}"
        CancelCommand="{Binding CancelCommand}"
        SaveButtonText="{Binding SaveButtonText}"
        IsLoading="{Binding IsLoading}"
        LoadingMessage="{Binding StatusMessage}">

        <!-- ========================================
             查看模式内容 (ViewContent)
             使用纯展示控件，无输入框边框
             ======================================== -->
        <views:BaseDetailContainer.ViewContent>
            <StackPanel>
                <!-- 基本信息卡片 -->
                <controls:InfoCard Title="基本信息">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：药材名称、拼音码 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="药材名称" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="拼音码" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding PinYinCode}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <!-- 第二行：产地、规格 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="产地" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Origin}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="规格" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Spec}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <!-- 第三行：单位、零售价 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="单位" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Unit}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="零售价" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:F2} 元}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <!-- 第四行：成本价、状态 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="成本价" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding CostPrice, StringFormat={}{0:F2} 元}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelValueStyle}"
                                        Visibility="{Binding IsEditOrViewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="状态" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- 功效用法卡片 -->
                <controls:InfoCard Title="功效用法">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <StackPanel Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="功效" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Effect}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="用法用量" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Usage}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource LabelValueStyle}">
                                <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Remark}" Style="{StaticResource ValueDisplayStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </views:BaseDetailContainer.ViewContent>

        <!-- ========================================
             编辑模式内容 (EditContent)
             使用表单输入控件
             ======================================== -->
        <views:BaseDetailContainer.EditContent>
            <StackPanel>
                <!-- 基本信息卡片 -->
                <controls:InfoCard Title="基本信息">
                    <controls:InfoCard.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：药材名称、拼音码 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="药材名称 *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         IsReadOnly="{Binding IsNameEditable, Converter={StaticResource InverseBooleanConverter}}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="拼音码（自动生成）" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding PinYinCode, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="{StaticResource BackgroundBrush}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第二行：产地、规格 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="产地" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Origin, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="规格" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Spec, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第三行：单位、零售价 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="单位 *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                                <TextBlock Text="零售价" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- 第四行：成本价、状态 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20">
                                <TextBlock Text="成本价" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         MinHeight="44"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,20"
                                        Visibility="{Binding IsEditOrViewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="状态" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox SelectedItem="{Binding Status}"
                                          ItemsSource="{Binding StatusOptions}"
                                          IsEnabled="False"
                                          MinHeight="44"
                                          Padding="12,10"/>
                            </StackPanel>
                        </Grid>
                    </controls:InfoCard.Content>
                </controls:InfoCard>

                <!-- 功效用法卡片 -->
                <controls:InfoCard Title="功效用法">
                    <controls:InfoCard.Content>
                        <StackPanel>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="功效" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Effect, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="80"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="用法用量" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Usage, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="80"
                                         Padding="12,10"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="备注" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditableTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="60"
                                         Padding="12,10"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:InfoCard.Content>
                </controls:InfoCard>
            </StackPanel>
        </views:BaseDetailContainer.EditContent>
    </views:BaseDetailContainer>
</UserControl>
