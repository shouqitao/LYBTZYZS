<!--
    HerbManagementView - 药材管理视图
    Issue #2001 - Task 2.8: 应用BaseMasterDataListView模板

    重构说明：
    - 使用 BaseMasterDataListView 替代原有的三行布局
    - 移除重复的工具栏、数据表格、分页控件代码
    - 通过 Columns 和 ActionButtons 属性定义药材特定内容
-->
<UserControl x:Class="LYBT.Desktop.Herbs.Views.HerbManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- 枚举描述转换器 -->
        <infrastructure:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>

    <!-- Issue #2001: 应用 BaseMasterDataListView 模板 -->
    <views:BaseMasterDataListView
        ItemsSource="{Binding Items}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        SearchText="{Binding SearchText, Mode=TwoWay}"
        CurrentPage="{Binding PageIndex, Mode=TwoWay}"
        TotalPages="{Binding TotalPages}"
        PageSize="{Binding PageSize, Mode=TwoWay}"
        TotalCount="{Binding TotalCount}"
        FirstPageCommand="{Binding FirstPageCommand}"
        PreviousPageCommand="{Binding PreviousPageCommand}"
        NextPageCommand="{Binding NextPageCommand}"
        LastPageCommand="{Binding LastPageCommand}"
        IsBusy="{Binding IsBusy}"
        BusyMessage="{Binding BusyMessage}"
        EmptyStateText="暂无中药材数据">

        <!-- 定义药材特定的 DataGrid 列 -->
        <views:BaseMasterDataListView.Columns>
            <!-- 药材名称 -->
            <DataGridTextColumn Header="药材名称"
                                Binding="{Binding Name}"
                                Width="150" />

            <!-- 拼音码 -->
            <DataGridTextColumn Header="拼音码"
                                Binding="{Binding PinYinCode}"
                                Width="80" />

            <!-- 产地 -->
            <DataGridTextColumn Header="产地"
                                Binding="{Binding Origin}"
                                Width="100" />

            <!-- 规格 -->
            <DataGridTextColumn Header="规格"
                                Binding="{Binding Spec}"
                                Width="80" />

            <!-- 单位 -->
            <DataGridTextColumn Header="单位"
                                Binding="{Binding Unit}"
                                Width="60" />

            <!-- 单价 -->
            <DataGridTextColumn Header="单价(元)"
                                Binding="{Binding Price, StringFormat='{}{0:F2}'}"
                                Width="80" />

            <!-- 功效 -->
            <DataGridTextColumn Header="功效"
                                Binding="{Binding Effect}"
                                Width="200" />

            <!-- 状态 - 使用UnifiedStatusBadge -->
            <DataGridTemplateColumn Header="状态" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:UnifiedStatusBadge
                            Text="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}"
                            Type="Success" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- 操作列 -->
            <DataGridTemplateColumn Header="操作" Width="320">
                <DataGridTemplateColumn.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="查看"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="8,4"
                                    FontSize="12"
                                    Margin="2"
                                    ToolTip="查看药材详情"
                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="编辑"
                                    Style="{StaticResource SuccessButton}"
                                    Padding="8,4"
                                    FontSize="12"
                                    Margin="2"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="状态"
                                    Style="{StaticResource InfoButton}"
                                    Padding="8,4"
                                    FontSize="12"
                                    Margin="2"
                                    Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="删除"
                                    Style="{StaticResource DangerButton}"
                                    Padding="8,4"
                                    FontSize="12"
                                    Margin="2"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </views:BaseMasterDataListView.Columns>

        <!-- 定义操作按钮区域 -->
        <views:BaseMasterDataListView.ActionButtons>
            <StackPanel Orientation="Horizontal">
                <Button Content="📥 导入药材"
                        Style="{StaticResource InfoButton}"
                        Command="{Binding ImportHerbsCommand}"
                        ToolTip="从Excel文件批量导入中药材信息"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="📄 导出模板"
                        Style="{StaticResource InfoButton}"
                        Command="{Binding ExportTemplateCommand}"
                        ToolTip="下载药材导入Excel模板"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="📤 导出药材"
                        Style="{StaticResource WarningButton}"
                        Command="{Binding ExportHerbsCommand}"
                        ToolTip="导出药材数据到Excel文件"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="+ 新增中药材"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding AddCommand}"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="刷新"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="🏠 返回主页"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NavigateToHomeCommand}"
                        ToolTip="返回管理员主页"
                        Margin="{StaticResource SpacingSmall}" />
            </StackPanel>
        </views:BaseMasterDataListView.ActionButtons>
    </views:BaseMasterDataListView>
</UserControl>
