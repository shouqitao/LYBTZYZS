<UserControl x:Class="LYBT.Desktop.Herbs.Views.HerbManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- UltraThink UI/UX优化 Phase 1: 使用统一设计系统样式 -->
        <!-- 所有样式现在从UnifiedDesignSystem.xaml继承，只保留页面特定配置 -->

        <!-- 中药材管理专用DataGrid样式（带特殊要求的列宽度和输出按钮） -->
        <Style x:Key="HerbManagementDataGrid" TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 搜索区域 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="搜索：" Style="{StaticResource LabelText}" />
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}" />
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- 导入导出功能 - UltraThink Phase 3.3 迁移 -->
                    <Button Content="📥 导入药材"
                            Margin="0,0,10,0"
                            Style="{StaticResource InfoButton}"
                            Command="{Binding ImportHerbsCommand}"
                            ToolTip="从Excel文件批量导入中药材信息" />
                    <Button Content="📄 导出模板"
                            Margin="0,0,10,0"
                            Style="{StaticResource InfoButton}"
                            Command="{Binding ExportTemplateCommand}"
                            ToolTip="下载药材导入Excel模板" />
                    <Button Content="📤 导出药材"
                            Margin="0,0,10,0"
                            Style="{StaticResource WarningButton}"
                            Command="{Binding ExportHerbsCommand}"
                            ToolTip="导出药材数据到Excel文件" />
                    <Button Content="+ 新增中药材"
                            Margin="0,0,10,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}" />
                    <Button Content="刷新"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="🏠 返回主页"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToHomeCommand}"
                            ToolTip="返回管理员主页" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource HerbManagementDataGrid}"
                  RowStyle="{StaticResource BaseDataGridRow}"
                  ColumnHeaderStyle="{StaticResource BaseDataGridColumnHeader}">
            <DataGrid.Columns>
                <!-- 药材名称 -->
                <DataGridTextColumn Header="药材名称"
                                    Binding="{Binding Name}"
                                    Width="150" />

                <!-- 拼音码 -->
                <DataGridTextColumn Header="拼音码"
                                    Binding="{Binding PinYinCode}"
                                    Width="80" />

                <!-- 产地 -->
                <DataGridTextColumn Header="产地"
                                    Binding="{Binding Origin}"
                                    Width="100" />

                <!-- 规格 -->
                <DataGridTextColumn Header="规格"
                                    Binding="{Binding Spec}"
                                    Width="80" />

                <!-- 单位 -->
                <DataGridTextColumn Header="单位"
                                    Binding="{Binding Unit}"
                                    Width="60" />

                <!-- 单价 -->
                <DataGridTextColumn Header="单价(元)"
                                    Binding="{Binding Price, StringFormat='{}{0:F2}'}"
                                    Width="80" />

                <!-- 功效 -->
                <DataGridTextColumn Header="功效"
                                    Binding="{Binding Effect}"
                                    Width="200" />

                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="White"
                                           FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="编辑"
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="状态"
                                        Style="{StaticResource InfoButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="删除"
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusLabel}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="首页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding FirstPageCommand}" />

                    <Button Content="上一页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding PreviousPageCommand}" />

                    <Border Style="{StaticResource PaginationCurrentPage}">
                        <TextBlock Style="{StaticResource PaginationPageNumber}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage" />
                                    <Binding Path="TotalPages" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>

                    <Button Content="下一页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding NextPageCommand}" />

                    <Button Content="末页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding LastPageCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
