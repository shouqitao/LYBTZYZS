<!--
    FormulaMasterDetailControl - 验方Master-Detail控件
    
    可复用业务控件，供Admin和Clinical角色台使用
    从FormulaMasterDetailView重构而来
-->
<controls:MasterDetailControlBase
    x:Class="LYBT.Desktop.Catalog.Controls.FormulaMasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:formulaControls="clr-namespace:LYBT.Desktop.Catalog.Controls"
    xmlns:formulaView="clr-namespace:LYBT.Desktop.Controls.Controls.FormulaView;assembly=LYBT.Desktop.Controls"
    xmlns:enums="clr-namespace:LYBT.Shared.Models.Enums;assembly=LYBT.Shared.Models"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        资源加载说明:
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}">
        <!--
            ========================================
            Master区域: 验方列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <!-- 视觉基线 v1 -->
    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  
                    <!--  工具栏  -->
                    <RowDefinition Height="Auto" />  
                    <!--  搜索  -->
                    <RowDefinition Height="*" />     
                    <!--  列表  -->
                    <RowDefinition Height="Auto" />  
                    <!--  分页  -->
                </Grid.RowDefinitions>

                <!--  工具栏  -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    MinHeight="56" Padding="0,0,16,0"
                    BatchDeleteCommand="{Binding DeleteCommand}"
                    BatchEnableCommand="{Binding BatchEnableCommand}"
                    BatchDisableCommand="{Binding BatchDisableCommand}"
                    CreateCommand="{Binding CreateNewCommand}"
                    ExportCommand="{Binding ExportFormulasCommand}"
                    RefreshCommand="{Binding RefreshCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <!--  批量导入操作（US-FORM-006/013）  -->
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding DownloadImportTemplateCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="下载导入模板">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="模板" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding ImportFormulasCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="批量导入验方">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="导入" />
                                </StackPanel>
                            </Button>
                            <!--  校验待办（US-FORM-007/008——待校验验方列表 + 药材绑定）  -->
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding ToggleValidationModeCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="仅显示含未绑定药材的验方，并在详情中绑定系统药材（待校验列表）">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="待校验" />
                                </StackPanel>
                            </Button>
                            <!--  主操作  -->
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding EditCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="编辑">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="编辑" />
                                </StackPanel>
                            </Button>
                            <materialDesign:PopupBox
                                Margin="8,0,0,0"
                                ToolTip="更多操作">
                                <StackPanel>
                                    <Button Command="{Binding CopyFormulaCommand}" Content="复制" Padding="16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Command="{Binding ToggleStatusCommand}" Content="切换状态" Padding="16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Command="{Binding RestoreCommand}" Content="恢复" Padding="16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!--  搜索框（校验模式隐藏，提示条替代）  -->
                <controls:SearchBox
                    Grid.Row="1"
                    Margin="16,12" Height="40"
                    Visibility="{Binding IsNormalMode}"
                    Placeholder="搜索验方名称..."
                    SearchCommand="{Binding SearchCommand}"
                    SearchText="{Binding SearchText, Mode=TwoWay}" />

                <!--  校验模式提示条  -->
                <Border
                    Grid.Row="1"
                    Margin="16,12"
                    Padding="12,8"
                    Background="#FFF3E0"
                    CornerRadius="6"
                    Visibility="{Binding IsValidationMode}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldAlertOutline" Foreground="#E65100" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="待校验模式：仅显示含未绑定药材的验方——选择后在下方面板把原药材名绑定到系统药材库" />
                        <Button
                            Margin="16,0,0,0"
                            Padding="8,2"
                            Command="{Binding ToggleValidationModeCommand}"
                            Content="返回全部验方"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    </StackPanel>
                </Border>

                <!--  验方列表  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="16,0,16,8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    BorderThickness="0"
                    Background="Transparent"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <!--  名称  -->
                        <DataGridTextColumn
                            Width="*" MinWidth="100"
                            Binding="{Binding Name}"
                            Header="名称"
                            ElementStyle="{StaticResource DataGridEmphasisCellStyle}" />

                        <!--  分类  -->
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Category}"
                            Header="分类"
                            ElementStyle="{StaticResource DataGridSecondaryCellStyle}" />

                        <!--  药味数  -->
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding HerbCount}"
                            Header="药味"
                            ElementStyle="{StaticResource DataGridSecondaryCellStyle}" />

                        <DataGridTemplateColumn Width="Auto" Header="共享">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding IsShared}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  校验状态（Draft 待校验 / Validated 已验证——US-FORM-007）  -->
                        <DataGridTemplateColumn Width="Auto" Header="校验">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="已验证" />
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ValidationStatus}" Value="{x:Static enums:FormulaValidationStatus.Draft}">
                                                        <Setter Property="Text" Value="待校验" />
                                                        <Setter Property="Foreground" Value="#E65100" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!--  右键菜单 - 分组优化：查看/编辑 | 验方管理 | 危险操作  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <!--  查看与编辑组  -->
                            <MenuItem Command="{Binding EditCommand}" Header="编辑">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Pencil" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding CopyFormulaCommand}" Header="复制">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  验方管理操作组  -->
                            <MenuItem Command="{Binding ToggleStatusCommand}" Header="切换状态">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ToggleSwitchOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding RestoreCommand}" Header="恢复">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Undo" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  危险操作组  -->
                            <MenuItem Command="{Binding DeleteCommand}" Header="删除">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件  -->
                <controls:UnifiedPaginationBar
                    Grid.Row="3"
                    CurrentPage="{Binding CurrentPage}"
                    TotalPages="{Binding TotalPages}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageSizes="{Binding PageSizes}"
                    FirstPageCommand="{Binding GoToFirstPageCommand}"
                    PreviousPageCommand="{Binding GoToPreviousPageCommand}"
                    NextPageCommand="{Binding GoToNextPageCommand}"
                    LastPageCommand="{Binding GoToLastPageCommand}" />

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 验方详情/编辑
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  验方校验面板（US-FORM-008——待绑定药材选择 + 绑定，仅校验模式可见）  -->
                <Border
                    Grid.Row="1"
                    Margin="16,12,16,0"
                    Padding="12"
                    Background="#FFF8E1"
                    BorderBrush="#FFE0B2"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsValidationDetail}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldAlertOutline" Foreground="#E65100" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{Binding ValidationFormulaName, StringFormat=验方「{0}」药材校验}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding ValidationPendingCount, StringFormat=待绑定 {0} 味 —— 将原药材名绑定到系统药材库，全部绑定后自动晋升为“已验证”}" />
                        </StackPanel>

                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ValidationRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       ToolTip="{Binding OriginalHerbName}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                                                   Text="{Binding Dosage, StringFormat={}{0}g}" />

                                        <!--  已绑定  -->
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="✓ 已绑定系统药材">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!--  待绑定：选择系统药材 + 校验绑定  -->
                                        <Grid Grid.Column="2">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="220" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                MinHeight="32"
                                                VerticalContentAlignment="Center"
                                                ItemsSource="{Binding DataContext.AllHerbs, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                SelectedValue="{Binding SelectedHerbId, Mode=TwoWay}"
                                                SelectedValuePath="Id"
                                                TextSearch.TextPath="Name"
                                                ToolTip="选择要绑定的系统药材（可按名称/拼音过滤）">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Margin="6,0,0,0" Foreground="#757575" Text="{Binding PinYinCode}" />
                                                            <TextBlock Margin="6,0,0,0" Foreground="#9E9E9E" Text="{Binding Category}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button
                                                Grid.Column="1"
                                                Padding="12,4"
                                                Command="{Binding DataContext.ValidateHerbCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="校验绑定"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  详情内容（Transitioner 切换查看/编辑）  -->
                <materialDesign:Transitioner
                    Grid.Row="2"
                    SelectedIndex="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToInt}}">
                    <materialDesign:TransitionerSlide>
                        <formulaView:FormulaViewControl
                            Margin="16"
                            Formula="{Binding CurrentDetail}"
                            ShowSystemInfo="True" />
                    </materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide>
                        <formulaControls:FormulaEditControl
                            Margin="16"
                            Formula="{Binding FormulaEditor.Formula}"
                            ErrorsSource="{Binding FormulaEditor.Formula.Errors}"
                            AllHerbs="{Binding AllHerbs}"
                            HerbItems="{Binding FormulaEditor.EditHerbItems, Mode=OneWay}"
                            HerbCount="{Binding FormulaEditor.HerbCount}" />
                    </materialDesign:TransitionerSlide>
                </materialDesign:Transitioner>

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="3"
                    IsLoading="{Binding IsBusy}"
                    LoadingText="正在处理..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选择验方时显示
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择验方"
                ActionCommand="{Binding CreateNewCommand}"
                ActionText="新增验方"
                Subtitle="在左侧列表中选择一个验方查看详情，或点击新增按钮创建验方" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
