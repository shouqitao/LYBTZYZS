<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Catalog</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 药房目录管理模块（Herbs+Formula 合并） | 药材信息 | 验方管理 | 单价管理</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Catalog</PackageId>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT药房目录管理模块 - 药材信息维护、单价管理、经典验方模板、个人验方、智能推荐 | UltraThink双层架构标准</PackageDescription>
    <PackageTags>WPF;中药材;药材管理;验方管理;单价;中医;诊所;UltraThink</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Naming Configuration -->
    <AssemblyName>LYBT.Desktop.Catalog</AssemblyName>
    <RootNamespace>LYBT.Desktop.Catalog</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
    <Page Remove="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="LYBT.Desktop.Catalog.xml" />
  </ItemGroup>

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Prism.Wpf" />
    <!-- OpenSpec: adopt-mapperly-unified-mapping - 替换AutoMapper为Mapperly -->
    <PackageReference Include="Riok.Mapperly" />
  </ItemGroup>

  <!-- Logging -->
  <ItemGroup Label="Logging">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Infrastructure Dependencies - UltraThink三层架构">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Foundation\LYBT.Desktop.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Desktop Core">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Contracts\LYBT.Desktop.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
  </ItemGroup>

  <!-- A-31-C3c: Herbs+Formula 合并为 Catalog（命名空间统一 LYBT.Desktop.Catalog，路由不变） -->

</Project>
