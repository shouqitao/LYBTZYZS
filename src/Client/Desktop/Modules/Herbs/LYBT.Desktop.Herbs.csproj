<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Herbs</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 中药材管理模块 | 药材信息 | 单价管理</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-herbs-enterprise</InformationalVersion>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Herbs</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT中药材管理模块 - 药材信息维护、单价管理、用法指导 | UltraThink双层架构标准</PackageDescription>
    <PackageTags>WPF;中药材;药材管理;单价;中医;诊所;UltraThink</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- Naming Configuration -->
    <AssemblyName>LYBT.Desktop.Herbs</AssemblyName>
    <RootNamespace>LYBT.Desktop.Herbs</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>bin\Debug\net8.0-windows\LYBT.Desktop.Herbs.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>bin\Release\net8.0-windows\LYBT.Desktop.Herbs.xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core"  />
    <PackageReference Include="Prism.DryIoc"  />
    <PackageReference Include="Prism.Wpf"  />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Infrastructure Dependencies">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Core.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Services\LYBT.Desktop.Services.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Interfaces\LYBT.Shared.Interfaces.csproj" />
  </ItemGroup>

</Project>