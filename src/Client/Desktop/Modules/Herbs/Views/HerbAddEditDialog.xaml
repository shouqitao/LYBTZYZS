<Window x:Class="LYBT.Desktop.Herbs.Views.HerbAddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}" Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 药材名称 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="药材名称 *" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding HerbName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" Padding="5"/>
                    <TextBlock Text="拼音码和五笔码将在保存时自动生成" 
                               Foreground="Gray" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 产地 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="产地" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Origin}" Height="30" Padding="5"/>
                </StackPanel>

                <!-- 规格 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="规格" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Spec}" Height="30" Padding="5"/>
                </StackPanel>

                <!-- 单位 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="单位 *" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox Text="{Binding Unit}" Height="30" Padding="5" IsEditable="True">
                        <ComboBoxItem>克</ComboBoxItem>
                        <ComboBoxItem>千克</ComboBoxItem>
                        <ComboBoxItem>个</ComboBoxItem>
                        <ComboBoxItem>片</ComboBoxItem>
                        <ComboBoxItem>支</ComboBoxItem>
                        <ComboBoxItem>盒</ComboBoxItem>
                        <ComboBoxItem>瓶</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- 单价 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="单价（元）*" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Price, StringFormat=F2}" Height="30" Padding="5"/>
                </StackPanel>

                <!-- 功效说明 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="功效说明" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Effect}" Height="60" Padding="5" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- 用法 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="用法" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Usage}" Height="40" Padding="5" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- 备注 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="备注" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Remark}" Height="60" Padding="5" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="保存" Width="100" Height="35" Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"
                    Background="#28A745" Foreground="White" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E7E34"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="取消" Width="100" Height="35"
                    Command="{Binding CancelCommand}"
                    Background="#6C757D" Foreground="White" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#545B62"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>