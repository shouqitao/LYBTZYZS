<UserControl
    x:Class="LYBT.Desktop.Auth.Views.FirstRunSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:LYBT.Desktop.Auth.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:FirstRunSetupViewModel}"
    d:DesignHeight="460"
    d:DesignWidth="480"
    prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
    mc:Ignorable="d">

    <Grid Width="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  0: 标题栏  -->
            <RowDefinition Height="*" />
            <!--  1: 内容  -->
            <RowDefinition Height="Auto" />
            <!--  2: 按钮栏  -->
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Padding="20,14"
            Background="{DynamicResource MaterialDesign.Brush.Primary}">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Background}"
                    Text="欢迎使用凌隐宝堂系统" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource MaterialDesign.Brush.Background}"
                    Opacity="0.85"
                    Text="首次使用，请配置服务器连接" />
            </StackPanel>
        </Border>

        <!--  内容  -->
        <StackPanel
            Grid.Row="1"
            Margin="24,18"
            VerticalAlignment="Top">

            <!--  欢迎说明  -->
            <TextBlock
                Margin="0,0,0,14"
                FontSize="13"
                Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                Text="请输入远程服务器地址以启用远程模式；若暂不配置，可直接跳过使用本地模式。"
                TextWrapping="Wrap" />

            <!--  步骤 1：服务器地址输入  -->
            <TextBlock
                Margin="0,0,0,6"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                Text="① 服务器地址" />
            <TextBox
                Height="42"
                Margin="0,0,0,8"
                Padding="12,0"
                VerticalContentAlignment="Center"
                FontSize="14"
                Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="例如：https://clinic-api.example.com 或 http://192.168.1.10:5000" />

            <!--  测试连接按钮 + 状态指示  -->
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    MinWidth="96"
                    Padding="16,8"
                    HorizontalAlignment="Left"
                    Command="{Binding TestConnectionCommand}"
                    Content="测试连接"
                    Cursor="Hand"
                    FontSize="13"
                    IsEnabled="{Binding IsNotTesting}" />

                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Medium"
                    Text="{Binding TestStatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestStatus}" Value="Testing">
                                    <Setter Property="Foreground" Value="#5B8FA8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestStatus}" Value="Success">
                                    <Setter Property="Foreground" Value="#228B22" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestStatus}" Value="Failed">
                                    <Setter Property="Foreground" Value="#E65100" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!--  步骤 2：回退提示 (仅测试失败时显示)  -->
            <Border
                Margin="0,2,0,0"
                Padding="14,10"
                Background="#FFF8E1"
                BorderBrush="{DynamicResource TcmOrangeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ShouldShowFallbackHint, Converter={x:Static converters:Cvt.BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TcmOrangeBrush}"
                        Text="⚠" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="远程服务器不可达，将使用本地模式"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  本地模式说明  -->
            <Border
                Margin="0,10,0,0"
                Padding="14,10"
                Background="#E0F7FA"
                BorderBrush="#5B8FA8"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#5B8FA8"
                        Text="ℹ" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="本地模式使用单机内置数据库，无需服务器；可稍后从登录页设置中重新配置。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  按钮栏  -->
        <Border
            Grid.Row="2"
            Padding="20,12"
            Background="{DynamicResource MaterialDesign.Brush.Paper}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  跳过 - 本地模式 (左对齐，链接样式)  -->
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Command="{Binding UseLocalModeCommand}"
                    Content="跳过，使用本地模式"
                    Cursor="Hand"
                    FontSize="13">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#5B8FA8" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!--  取消  -->
                <Button
                    Grid.Column="1"
                    MinWidth="80"
                    Padding="16,8"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Cursor="Hand"
                    FontSize="14" />

                <!--  完成 (主按钮)  -->
                <Button
                    Grid.Column="2"
                    MinWidth="80"
                    Margin="12,0,0,0"
                    Padding="16,8"
                    Command="{Binding ConfirmCommand}"
                    Content="完成"
                    Cursor="Hand"
                    FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Dark}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!--  保存中遮罩  -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#20000000"
            Visibility="{Binding IsBusy, Converter={x:Static converters:Cvt.BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="180"
                    Height="4"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                    Text="{Binding StatusMessage}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
