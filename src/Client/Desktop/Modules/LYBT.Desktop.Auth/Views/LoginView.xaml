<UserControl
    x:Class="LYBT.Desktop.Auth.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--  Issue #1826: 全屏中医风格背景 + 左右布局  -->
    <Grid>
        <!--  背景层：中医风格渐变  -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#3E2723" />
                <GradientStop Offset="0.5" Color="#5D4037" />
                <GradientStop Offset="1" Color="#6D4C41" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--  半透明遮罩层  -->
        <Border Background="#50000000" />

        <!--  主内容区：左右布局  -->
        <Grid Margin="80,60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />      
                <!--  左侧：品牌文字区  -->
                <ColumnDefinition Width="560" />    
                <!--  右侧：登录框（1080P最佳宽度，长宽比1.21）  -->
            </Grid.ColumnDefinitions>

            <!--  左侧：品牌文字区 - Issue #1826: 调整左边距向中间靠拢  -->
            <StackPanel
                x:Name="LeftBrandPanel"
                Grid.Column="0"
                Margin="120,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <!--  系统名称 - Issue #1826: 直接显示中文名称  -->
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="56"
                    FontWeight="Bold"
                    Foreground="#FFD54F"
                    Text="凌隐宝堂">
                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="10"
                            Opacity="0.5"
                            ShadowDepth="2"
                            Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock
                    Margin="0,0,0,32"
                    FontSize="42"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="中医诊疗管理系统">
                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Opacity="0.4"
                            ShadowDepth="2"
                            Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <!--  Slogan  -->
                <TextBlock
                    Margin="0,0,0,60"
                    FontSize="22"
                    Foreground="#BCAAA4"
                    Text="传承经典 · 数字化诊疗">
                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="6"
                            Opacity="0.3"
                            ShadowDepth="1"
                            Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <!--  版本号  -->
                <TextBlock
                    FontSize="14"
                    Foreground="#8D6E63"
                    Opacity="0.7"
                    Text="Version 1.0.0.0" />
            </StackPanel>

            <!--  右侧：登录框 - Issue #1826: 调整右边距向中间靠拢  -->
            <Border
                x:Name="RightLoginBox"
                Grid.Column="1"
                Margin="0,0,120,0"
                Padding="48,40"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="20">
                <Border.Effect>
                    <!--  Issue #1826: 优化阴影效果 - 更柔和的扩散阴影  -->
                    <DropShadowEffect
                        BlurRadius="40"
                        Opacity="0.15"
                        ShadowDepth="0"
                        Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!--  Issue #1826: 优化间距 - 统一使用4的倍数  -->
                        <RowDefinition Height="Auto" />   
                        <!--  0: 标题  -->
                        <RowDefinition Height="36" />     
                        <!--  1: 间距（优化：32→36）  -->
                        <RowDefinition Height="Auto" />   
                        <!--  2: 用户名输入  -->
                        <RowDefinition Height="24" />     
                        <!--  3: 间距（优化：20→24）  -->
                        <RowDefinition Height="Auto" />   
                        <!--  4: 密码输入  -->
                        <RowDefinition Height="24" />     
                        <!--  5: 间距（优化：20→24）  -->
                        <RowDefinition Height="Auto" />   
                        <!--  6: 记住用户名  -->
                        <RowDefinition Height="12" />     
                        <!--  7: 间距（优化：10→12）  -->
                        <RowDefinition Height="Auto" />   
                        <!--  8: 记住密码  -->
                        <RowDefinition Height="20" />     
                        <!--  9: 间距  -->
                        <RowDefinition Height="Auto" />   
                        <!--  10: 连接模式  -->
                        <RowDefinition Height="28" />     
                        <!--  11: 间距（优化：24→28）  -->
                        <RowDefinition Height="Auto" />   
                        <!--  12: 登录按钮  -->
                        <RowDefinition Height="16" />     
                        <!--  13: 间距  -->
                        <RowDefinition Height="Auto" />   
                        <!--  14: 状态消息  -->
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#3E2723"
                            Text="凌隐宝堂中医诊所" />
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="#6D4C41"
                            Text="用户登录" />
                    </StackPanel>

                    <!--  用户名输入  -->
                    <StackPanel Grid.Row="2">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="用户名" />
                        <TextBox
                            Height="48"
                            Padding="16,0"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="用户名"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1.5"
                            FontSize="14"
                            Foreground="#1E293B"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                    <ScrollViewer
                                                        x:Name="PART_ContentHost"
                                                        Margin="{TemplateBinding Padding}"
                                                        VerticalAlignment="Center"
                                                        Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5D4037" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#6D4C41" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <!--  密码输入  -->
                    <StackPanel Grid.Row="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="#475569"
                                Text="密码" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="#6D4C41"
                                Text="（已保存）"
                                Visibility="{Binding HasSavedPassword, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <PasswordBox
                            x:Name="PasswordBox"
                            Height="48"
                            Padding="16,0"
                            AutomationProperties.Name="密码"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1.5"
                            FontSize="14"
                            Foreground="#1E293B"
                            PasswordChanged="PasswordBox_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                    <ScrollViewer
                                                        x:Name="PART_ContentHost"
                                                        Margin="{TemplateBinding Padding}"
                                                        VerticalAlignment="Center"
                                                        Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5D4037" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#6D4C41" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                    </StackPanel>

                    <!--  记住用户名  -->
                    <CheckBox
                        Grid.Row="6"
                        Content="记住用户名"
                        FontSize="13"
                        Foreground="#64748B"
                        IsChecked="{Binding RememberMe}" />

                    <!--  记住密码  -->
                    <StackPanel Grid.Row="8" Orientation="Horizontal">
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="记住密码"
                            FontSize="13"
                            Foreground="#64748B"
                            IsChecked="{Binding RememberPassword}" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#D97706"
                            Text=" 仅在可信设备使用" />
                    </StackPanel>

                    <!--  连接模式选择  -->
                    <Border
                        Grid.Row="10"
                        Padding="16,12"
                        Background="#F8F5F3"
                        BorderBrush="#D7CCC8"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#5D4037"
                                Text="连接模式" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Margin="0,0,16,0"
                                    Content="远程模式"
                                    FontSize="12"
                                    Foreground="#6D4C41"
                                    IsChecked="{Binding IsRemoteModeSelected}" />
                                <RadioButton
                                    Content="本地模式（v2.0）"
                                    FontSize="12"
                                    Foreground="#6D4C41"
                                    IsChecked="{Binding IsLocalModeSelected}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                FontStyle="Italic"
                                Foreground="#8D6E63"
                                Text="{Binding ConnectionModeDisplay}" />
                        </StackPanel>
                    </Border>

                    <!--  登录按钮 - Issue #1826: 优化高度  -->
                    <Button
                        Grid.Row="12"
                        Height="52"
                        Background="#5D4037"
                        BorderThickness="0"
                        Command="{Binding LoginCommand}"
                        Content="登录"
                        Cursor="Hand"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4E342E" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#3E2723" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#BCAAA4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--  状态和错误消息区域  -->
                    <Border
                        Grid.Row="15"
                        Padding="14,10"
                        Background="#F8F5F3"
                        CornerRadius="8"
                        Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!--  状态消息  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#059669"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                            <!--  错误消息  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#DC2626"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  加载遮罩  -->
        <Grid Background="#B0000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Padding="40,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.2"
                        ShadowDepth="4"
                        Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <ProgressBar
                        Width="200"
                        Height="6"
                        Background="#E5E7EB"
                        BorderThickness="0"
                        Foreground="#5D4037"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="#475569"
                        Text="正在登录..." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
