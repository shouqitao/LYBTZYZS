<UserControl x:Class="LYBT.Desktop.Auth.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <!-- 登录内容，移除外层边框，因为主窗口已经有了 -->
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: 标题 -->
            <RowDefinition Height="25" />     <!-- 1: 间距 -->
            <RowDefinition Height="Auto" />   <!-- 2: 用户名输入 -->
            <RowDefinition Height="12" />     <!-- 3: 间距 -->
            <RowDefinition Height="Auto" />   <!-- 4: 密码输入 -->
            <RowDefinition Height="12" />     <!-- 5: 间距 -->
            <RowDefinition Height="Auto" />   <!-- 6: 记住用户名 -->
            <RowDefinition Height="8" />      <!-- 7: 间距（缩小） -->
            <RowDefinition Height="Auto" />   <!-- 8: 记住密码 -->
            <RowDefinition Height="15" />     <!-- 9: 间距 -->
            <RowDefinition Height="Auto" />   <!-- 10: 登录按钮 -->
            <RowDefinition Height="12" />     <!-- 11: 间距 -->
            <RowDefinition Height="Auto" />   <!-- 12: 状态消息 -->
            <RowDefinition Height="*" />      <!-- 13: 剩余空间 -->
        </Grid.RowDefinitions>

        <!-- 标题Logo -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="凌隐宝堂中医诊所"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#2E86AB"
                       HorizontalAlignment="Center" />
            <TextBlock Text="管理系统"
                       FontSize="14"
                       Foreground="#666"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- 用户名输入 -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="用户名" FontSize="14" Foreground="#333" Margin="0,0,0,5" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="40"
                     FontSize="13"
                     Padding="12,6"
                     BorderBrush="#DDD"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     Background="White"
                     Foreground="#333"
                     AutomationProperties.Name="用户名">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#2E86AB" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#2E86AB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </StackPanel>

        <!-- 密码输入 -->
        <StackPanel Grid.Row="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="密码" FontSize="14" Foreground="#333" Margin="0,0,0,5" />
                <TextBlock Grid.Column="1"
                           Text="（已保存）"
                           FontSize="12"
                           Foreground="#2E86AB"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,5"
                           Visibility="{Binding HasSavedPassword, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
            <PasswordBox x:Name="PasswordBox"
                         Height="40"
                         FontSize="13"
                         Padding="12,6"
                         BorderBrush="#DDD"
                         BorderThickness="1"
                         Background="White"
                         Foreground="#333"
                         AutomationProperties.Name="密码"
                         PasswordChanged="PasswordBox_PasswordChanged">
                <PasswordBox.Style>
                    <Style TargetType="PasswordBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="PasswordBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#2E86AB" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#2E86AB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </PasswordBox.Style>
                <PasswordBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                </PasswordBox.InputBindings>
            </PasswordBox>
        </StackPanel>

        <!-- 记住用户名 -->
        <CheckBox Grid.Row="6"
                  Content="记住用户名"
                  IsChecked="{Binding RememberMe}"
                  FontSize="12"
                  Foreground="#666" />

        <!-- 记住密码 (Issue #1246) -->
        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <CheckBox Content="记住密码"
                      IsChecked="{Binding RememberPassword}"
                      FontSize="12"
                      Foreground="#666"
                      VerticalAlignment="Center" />
            <TextBlock Text="⚠️ 仅在可信设备使用"
                       FontSize="11"
                       Foreground="#FF6B35"
                       VerticalAlignment="Center"
                       Margin="5,0,0,0" />
        </StackPanel>

        <!-- 登录按钮 -->
        <Button Grid.Row="10"
                Content="登录"
                Height="40"
                FontSize="15"
                FontWeight="Bold"
                Background="#2E86AB"
                Foreground="White"
                BorderThickness="0"
                Command="{Binding LoginCommand}"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1F5F99" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#164A7B" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- 状态和错误消息区域 -->
        <Border Grid.Row="12" Background="#F8F9FA" CornerRadius="4" Padding="10,5" Margin="0,5,0,0"
                Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <!-- 状态消息 -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Green"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <!-- 错误消息 -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- 加载遮罩 -->
        <Grid Grid.RowSpan="14"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Background="Transparent"
                             Foreground="White" />
                <TextBlock Text="正在登录..."
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
