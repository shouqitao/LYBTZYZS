<UserControl
    x:Class="LYBT.Desktop.Auth.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--  Issue #1826: 全屏中医风格背景 + 左右布局  -->
    <!--  remove-titlebar-add-close-button: 使用背景图替代渐变，FHD优化  -->
    <Grid>
        <!--  背景层：中医风格背景图  -->
        <Grid.Background>
            <ImageBrush
                ImageSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Images/Backgrounds/img-login-background.jpg"
                Stretch="UniformToFill" />
        </Grid.Background>

        <!--  半透明遮罩层：降低透明度以突显背景图  -->
        <Border Background="#20000000" />

        <!--  主内容区：左右布局 - FHD(1920x1080)优化  -->
        <Grid Margin="60,40">
            <Grid.ColumnDefinitions>
                <!--  左右对称分屏：左侧品牌区 / 右侧登录区  -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：品牌文字区 - 在左半边区域的中心  -->
            <StackPanel
                x:Name="LeftBrandPanel"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <!--  系统名称 - 深棕色配合背景  -->
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="72"
                    FontWeight="Bold"
                    Foreground="#5D4037"
                    Text="凌隐宝堂">
                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Opacity="0.2"
                            ShadowDepth="1"
                            Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock
                    Margin="0,0,0,32"
                    FontSize="54"
                    FontWeight="SemiBold"
                    Foreground="#6D4C41"
                    Text="中医诊疗管理系统">
                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="6"
                            Opacity="0.15"
                            ShadowDepth="1"
                            Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <!--  Slogan  -->
                <TextBlock
                    Margin="0,0,0,48"
                    FontSize="24"
                    Foreground="#8D6E63"
                    Text="传承经典 · 数字化诊疗" />

                <!--  版本号  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#A1887F"
                    Text="Version 1.0.0.0" />
            </StackPanel>

            <!--  右侧：登录框 - 在右半边区域的中心  -->
            <Border
                x:Name="RightLoginBox"
                Grid.Column="1"
                Width="460"
                Padding="44,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#FAFAFA"
                CornerRadius="16">
                <Border.Effect>
                    <!--  Issue #1826: 优化阴影效果 - 更柔和的扩散阴影  -->
                    <DropShadowEffect
                        BlurRadius="40"
                        Opacity="0.15"
                        ShadowDepth="0"
                        Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!--  Issue #1826: 优化间距 - 统一使用4的倍数  -->
                        <RowDefinition Height="Auto" />
                        <!--  0: 标题  -->
                        <RowDefinition Height="36" />
                        <!--  1: 间距（优化：32→36）  -->
                        <RowDefinition Height="Auto" />
                        <!--  2: 用户名输入  -->
                        <RowDefinition Height="24" />
                        <!--  3: 间距（优化：20→24）  -->
                        <RowDefinition Height="Auto" />
                        <!--  4: 密码输入  -->
                        <RowDefinition Height="24" />
                        <!--  5: 间距（优化：20→24）  -->
                        <RowDefinition Height="Auto" />
                        <!--  6: 记住用户名  -->
                        <RowDefinition Height="12" />
                        <!--  7: 间距（优化：10→12）  -->
                        <RowDefinition Height="Auto" />
                        <!--  8: 记住密码  -->
                        <RowDefinition Height="20" />
                        <!--  9: 间距  -->
                        <RowDefinition Height="Auto" />
                        <!--  10: 连接模式  -->
                        <RowDefinition Height="28" />
                        <!--  11: 间距（优化：24→28）  -->
                        <RowDefinition Height="Auto" />
                        <!--  12: 登录按钮  -->
                        <RowDefinition Height="16" />
                        <!--  13: 间距  -->
                        <RowDefinition Height="Auto" />
                        <!--  14: 状态消息  -->
                    </Grid.RowDefinitions>

                    <!--  remove-titlebar-add-close-button: 关闭按钮（右上角）  -->
                    <Button
                        Grid.Row="0"
                        Width="28"
                        Height="28"
                        Margin="0,-28,-36,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding CloseApplicationCommand}"
                        Content="X"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="Bold"
                        ToolTip="关闭程序">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#6D4C41" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="14">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E53935" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#C62828" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--  标题  -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="#3E2723"
                            Text="凌隐宝堂中医诊所" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Foreground="#6D4C41"
                            Text="用户登录" />
                    </StackPanel>

                    <!--  用户名输入  -->
                    <StackPanel Grid.Row="2">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="15"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="用户名" />
                        <TextBox
                            Height="54"
                            Padding="18,0"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="用户名"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1.5"
                            FontSize="15"
                            Foreground="#1E293B"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="12">
                                                    <ScrollViewer
                                                        x:Name="PART_ContentHost"
                                                        Margin="{TemplateBinding Padding}"
                                                        VerticalAlignment="Center"
                                                        Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5D4037" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#6D4C41" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <!--  密码输入  -->
                    <StackPanel Grid.Row="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,10"
                                FontSize="15"
                                FontWeight="Medium"
                                Foreground="#475569"
                                Text="密码" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Right"
                                FontSize="13"
                                Foreground="#6D4C41"
                                Text="（已保存）"
                                Visibility="{Binding HasSavedPassword, Converter={x:Static converters:Cvt.BoolToVis}}" />
                        </Grid>
                        <PasswordBox
                            x:Name="PasswordBox"
                            Height="54"
                            Padding="18,0"
                            AutomationProperties.Name="密码"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1.5"
                            FontSize="15"
                            Foreground="#1E293B"
                            PasswordChanged="PasswordBox_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="12">
                                                    <ScrollViewer
                                                        x:Name="PART_ContentHost"
                                                        Margin="{TemplateBinding Padding}"
                                                        VerticalAlignment="Center"
                                                        Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5D4037" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#6D4C41" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                    </StackPanel>

                    <!--  登录选项（OpenSpec: simplify-login-options）  -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                        <!--  记住账号  -->
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="记住账号"
                            FontSize="14"
                            Foreground="#64748B"
                            IsChecked="{Binding RememberUsername}" />
                        <!--  记住密码  -->
                        <CheckBox
                            Margin="24,0,0,0"
                            VerticalAlignment="Center"
                            Content="记住密码"
                            FontSize="14"
                            Foreground="#64748B"
                            IsChecked="{Binding RememberPassword}" />
                    </StackPanel>

                    <!--  Row 8: 保留为空行，保持后续行号不变  -->

                    <!--  连接模式选择 + API状态（remove-statusbar-relocate-status）  -->
                    <Border
                        Grid.Row="10"
                        Padding="18,14"
                        Background="#F8F5F3"
                        BorderBrush="#D7CCC8"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel>
                            <!--  标题行：连接模式 + API状态指示器  -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#5D4037"
                                    Text="连接模式" />
                                <!--  API状态（仅远程模式显示）  -->
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsRemoteModeSelected, Converter={x:Static converters:Cvt.BoolToVis}}">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip="{Binding ApiStatusMessage}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FFC107" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApiStatus}" Value="Healthy">
                                                        <Setter Property="Fill" Value="#4CAF50" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ApiStatus}" Value="Unhealthy">
                                                        <Setter Property="Fill" Value="#F44336" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ApiStatus}" Value="Checking">
                                                        <Setter Property="Fill" Value="#FFC107" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                        <Ellipse.InputBindings>
                                            <MouseBinding Command="{Binding RetryApiCheckCommand}" MouseAction="LeftClick" />
                                        </Ellipse.InputBindings>
                                    </Ellipse>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        ToolTip="{Binding ApiStatusMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="检查中" />
                                                <Setter Property="Foreground" Value="#FFC107" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApiStatus}" Value="Healthy">
                                                        <Setter Property="Text" Value="已连接" />
                                                        <Setter Property="Foreground" Value="#4CAF50" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ApiStatus}" Value="Unhealthy">
                                                        <Setter Property="Text" Value="连接失败" />
                                                        <Setter Property="Foreground" Value="#F44336" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!--  重试按钮（仅连接失败时显示）  -->
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApiStatus}" Value="Unhealthy">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Hyperlink
                                            Command="{Binding RetryApiCheckCommand}"
                                            Foreground="#5D4037"
                                            TextDecorations="Underline">
                                            <Run Text="重试" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <!--  模式选择  -->
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Margin="0,0,20,0"
                                    Content="远程模式"
                                    FontSize="13"
                                    Foreground="#6D4C41"
                                    IsChecked="{Binding IsRemoteModeSelected}" />
                                <RadioButton
                                    Content="本地模式（v2.0）"
                                    FontSize="13"
                                    Foreground="#6D4C41"
                                    IsChecked="{Binding IsLocalModeSelected}" />
                            </StackPanel>
                            <!--  模式说明  -->
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                FontStyle="Italic"
                                Foreground="#8D6E63"
                                Text="{Binding ConnectionModeDisplay}" />
                        </StackPanel>
                    </Border>

                    <!--  登录按钮 - 增大尺寸优化  -->
                    <Button
                        Grid.Row="12"
                        Height="58"
                        Background="#5D4037"
                        BorderThickness="0"
                        Command="{Binding LoginCommand}"
                        Content="登录"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4E342E" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#3E2723" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#BCAAA4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--  状态和错误消息区域  -->
                    <Border
                        Grid.Row="15"
                        Padding="14,10"
                        Background="#F8F5F3"
                        CornerRadius="8"
                        Visibility="{Binding HasMessage, Converter={x:Static converters:Cvt.BoolToVis}}">
                        <StackPanel>
                            <!--  状态消息  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#059669"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap"
                                Visibility="{Binding StatusMessage, Converter={x:Static converters:Cvt.StringToVis}}" />

                            <!--  错误消息  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#DC2626"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap"
                                Visibility="{Binding ErrorMessage, Converter={x:Static converters:Cvt.StringToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  加载遮罩  -->
        <Grid Background="#B0000000" Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Border
                Padding="40,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Opacity="0.2"
                        ShadowDepth="4"
                        Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <ProgressBar
                        Width="200"
                        Height="6"
                        Background="#E5E7EB"
                        BorderThickness="0"
                        Foreground="#5D4037"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="#475569"
                        Text="正在登录..." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
