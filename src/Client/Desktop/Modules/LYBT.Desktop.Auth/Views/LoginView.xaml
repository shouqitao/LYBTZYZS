<UserControl
    x:Class="LYBT.Desktop.Auth.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <Grid.Background>
            <ImageBrush
                ImageSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Images/Backgrounds/img-login-background.jpg"
                Stretch="UniformToFill" />
        </Grid.Background>

        <Border Background="#40000000" />

        <Grid Margin="60,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="凌隐宝堂" FontSize="72" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="2" Color="Black" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="中医诊疗管理系统" FontSize="36" FontWeight="SemiBold" Foreground="#D7CCC8" Margin="0,0,0,32">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" Opacity="0.2" ShadowDepth="1" Color="Black" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="传承经典 · 数字化诊疗" FontSize="20" Foreground="#BCAAA4" />
            </StackPanel>

            <Border Grid.Column="1" MaxWidth="440" Padding="36,36" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.2" ShadowDepth="0" Color="Black" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="凌隐宝堂中医诊所" FontSize="24" FontWeight="SemiBold" Foreground="#5D4037" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="用户登录" FontSize="14" Foreground="#8D6E63" HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <Border Padding="12,4" HorizontalAlignment="Center" CornerRadius="10" Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#DAA520" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                        <Setter Property="Background" Value="#2E8B57" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentModeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>

                    <TextBlock Text="用户名" FontSize="13" Foreground="#757575" Margin="0,0,0,6" />
                    <TextBox Height="44" Padding="12,0" VerticalContentAlignment="Center"
                             FontSize="14" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <TextBlock Text="密码" FontSize="13" Foreground="#757575" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordBox" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                 FontSize="14" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                                 behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox Content="记住账号" FontSize="13" VerticalAlignment="Center"
                                  IsChecked="{Binding RememberUsername}" />
                        <CheckBox Content="记住密码" FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding RememberPassword}" />
                    </StackPanel>

                    <Border Padding="12,8" CornerRadius="6" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E0F7FA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ApiStatus}" Value="Healthy">
                                        <Setter Property="Background" Value="#E8F5E9" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ApiStatus}" Value="Unhealthy">
                                        <Setter Property="Background" Value="#FFF8E1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ApiStatusMessage}" FontSize="12" HorizontalAlignment="Center" />
                    </Border>

                    <Button Height="46" Command="{Binding LoginCommand}" Content="登 录"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Cursor="Hand" Margin="0,0,0,12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#5D4037" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4E342E" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#3E2723" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#C75050"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={x:Static converters:Cvt.StringToVis}}" />

                    <Button Command="{Binding OpenSettingsCommand}" Content="⚙ 服务器配置"
                            FontSize="13" Foreground="#8D6E63" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="12,6" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#80000000" Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Border Padding="32,24" Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="正在登录..." Margin="0,12,0,0" FontSize="13" HorizontalAlignment="Center" Foreground="#757575" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
