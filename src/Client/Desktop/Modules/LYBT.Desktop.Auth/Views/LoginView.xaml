<UserControl
    x:Class="LYBT.Desktop.Auth.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <Grid.Background>
            <ImageBrush
                ImageSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Images/Backgrounds/img-login-background.jpg"
                Stretch="UniformToFill" />
        </Grid.Background>

        <Border Background="#40000000" />

        <Grid Margin="60,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="大医精诚" FontFamily="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Fonts/#LiSu" FontSize="210" FontWeight="Bold" Foreground="#F5E6C8" Margin="0,0,0,12">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="3" Color="Black" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="中医药是中华民族的瑰宝" FontSize="24" FontWeight="SemiBold" Foreground="#D7CCC8" Margin="0,0,0,24">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" Opacity="0.2" ShadowDepth="1" Color="Black" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="传承经典 · 守正创新" FontSize="14" Foreground="#BCAAA4" />
            </StackPanel>

            <Border Grid.Column="1" Width="440" Padding="40,36" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.2" ShadowDepth="0" Color="Black" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="凌隐宝堂中医诊所" FontSize="24" FontWeight="SemiBold" Foreground="#5D4037" HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <Border Padding="12,4" HorizontalAlignment="Center" CornerRadius="10" Margin="0,0,0,24">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#DAA520" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                        <Setter Property="Background" Value="#2E8B57" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentModeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>

                    <TextBlock Text="用户名" FontSize="13" Foreground="#999999" Margin="0,0,0,6" />

                    <TextBox Height="50" Padding="14,0" VerticalContentAlignment="Center"
                             FontSize="15" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1.5"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" AutomationProperties.Name="用户名" />

                    <TextBlock Text="密码" FontSize="13" Foreground="#999999" Margin="0,0,0,6" />

                    <PasswordBox x:Name="PasswordBox" Height="50" Padding="14,0" VerticalContentAlignment="Center"
                                 FontSize="15" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1.5"
                                 behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox Content="记住账号" FontSize="13" VerticalAlignment="Center"
                                  IsChecked="{Binding RememberUsername}" />
                        <CheckBox Content="记住密码" FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding RememberPassword}" />
                    </StackPanel>

                    <Button Height="52" Command="{Binding LoginCommand}" Content="登 录"
                            FontSize="16" FontWeight="SemiBold" Foreground="White" Cursor="Hand" Margin="0,0,0,12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#5D4037" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4E342E" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#3E2723" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#C75050"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={x:Static converters:Cvt.StringToVis}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding SwitchToLocalCommand}" Content="📱 切换到本地"
                                    FontSize="12" Foreground="#8D6E63" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Command="{Binding SwitchToRemoteCommand}" Content="🌐 切换到远程"
                                    FontSize="12" Foreground="#8D6E63" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Foreground" Value="#AAAAAA" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRemoteMode}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRemoteAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="#8D6E63" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding OpenSettingsCommand}" Content="⚙ 配置"
                                FontSize="12" Foreground="#AAAAAA" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="8,4" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#80000000" Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Border Padding="32,24" Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="正在登录..." Margin="0,12,0,0" FontSize="13" HorizontalAlignment="Center" Foreground="#757575" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
