<UserControl
    x:Class="LYBT.Desktop.Auth.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <Style x:Key="LoginInputStyle" TargetType="Control">
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Images/Backgrounds/img-login-background.jpg"
                        Stretch="UniformToFill" />
        </Grid.Background>
        <Border Background="#40000000" />

        <!-- 顶部标题 -->
        <TextBlock Text="凌隐宝堂中医诊所" FontSize="36" FontWeight="Bold" Foreground="#FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
            <TextBlock.Effect><DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="2" Color="Black" /></TextBlock.Effect>
        </TextBlock>

        <!-- 主内容区：品牌 + 登录卡片 -->
        <Grid Margin="60,100,60,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧品牌区 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="大医精诚" FontFamily="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Fonts/#LiSu"
                           FontSize="210" FontWeight="Bold" Foreground="#F5E6C8" Margin="0,0,80,12">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="3" Color="Black" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="中医药是中华民族的瑰宝" FontSize="24" FontWeight="SemiBold" Foreground="#D7CCC8">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" Opacity="0.2" ShadowDepth="1" Color="Black" /></TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- 右侧登录卡片 -->
            <Border Grid.Column="1" Width="440" Padding="40,36" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.2" ShadowDepth="0" Color="Black" />
                </Border.Effect>

                <Grid>
                    <StackPanel>
                        <!-- 标语 -->
                        <TextBlock Text="传承经典 · 守正创新" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#8D6E63" HorizontalAlignment="Center" Margin="0,0,0,16" />

                        <!-- 模式徽章 -->
                        <Border Padding="12,4" HorizontalAlignment="Center" CornerRadius="10" Margin="0,0,0,24"
                                Background="#DAA520">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                            <Setter Property="Background" Value="#2E8B57" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentModeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>

                        <!-- 用户名 -->
                        <TextBlock Text="用户名" FontSize="13" Foreground="#999999" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource LoginInputStyle}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" AutomationProperties.Name="用户名" />

                        <!-- 密码 -->
                        <TextBlock Text="密码" FontSize="13" Foreground="#999999" Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource LoginInputStyle}"
                                     behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>

                        <!-- 记住选项 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <CheckBox Content="记住账号" FontSize="13" VerticalAlignment="Center"
                                      IsChecked="{Binding RememberUsername}" />
                            <CheckBox Content="记住密码" FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding RememberPassword}" />
                        </StackPanel>

                        <!-- 登录按钮 -->
                        <Button Height="52" Command="{Binding LoginCommand}" Content="登 录"
                                FontSize="16" FontWeight="SemiBold" Foreground="White" Cursor="Hand" Margin="0,0,0,12">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#5D4037" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4E342E" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#3E2723" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 错误消息 -->
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#C75050"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={x:Static converters:Cvt.StringToVis}}" />

                        <!-- 底部按钮栏 -->
                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Command="{Binding SwitchToLocalCommand}" Content="📱 切换到本地" Foreground="#8D6E63">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding SwitchToRemoteCommand}" Content="🌐 切换到远程" Foreground="#8D6E63">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Foreground" Value="#AAAAAA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoteMode}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRemoteAvailable}" Value="True">
                                                    <Setter Property="Foreground" Value="#8D6E63" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}" Content="⚙ 配置"
                                    Foreground="#AAAAAA" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- 关闭按钮（退出程序） -->
                    <Button Command="{Binding CloseApplicationCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="退出程序"
                            Foreground="#999999" FontSize="12" Padding="8,4"
                            Content="X" />
                </Grid>
            </Border>
        </Grid>

        <!-- 加载遮罩 -->
        <Grid Background="#80000000" Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Border Padding="32,24" Background="White" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="正在登录..." Margin="0,12,0,0" FontSize="13"
                               HorizontalAlignment="Center" Foreground="#757575" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
