<UserControl
    x:Class="LYBT.Desktop.Auth.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/LYBT.Desktop.Shell;component/Assets/Images/Backgrounds/img-login-background.jpg"
                        Stretch="UniformToFill" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
            <!--  底部状态栏高度统一 48  -->
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="#40000000" />

        <!-- 主内容区：品牌 + 登录卡片 -->
        <Grid Grid.Row="0" Margin="60,40,60,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧品牌区 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ClinicName, FallbackValue=凌隐宝堂中医诊所}" FontSize="36" FontWeight="Bold" Foreground="#FFFFFF"
                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="2" Color="Black" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="中医诊所管理系统" FontSize="22" FontWeight="SemiBold" Foreground="#F5E6C8" Margin="0,0,0,12">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" Opacity="0.3" ShadowDepth="2" Color="Black" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="传承国医精髓 · 守护万家健康" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="6" Opacity="0.2" ShadowDepth="1" Color="Black" /></TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- 右侧登录卡片 -->
            <Border Grid.Column="1" Width="440" Padding="40,36" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceLevel1Brush}" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Opacity="0.2" ShadowDepth="0" Color="Black" />
                </Border.Effect>

                <Grid>
                    <StackPanel>
                        <!-- 标语 -->
                        <TextBlock Text="传承经典 · 守正创新" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" HorizontalAlignment="Center" Margin="0,0,0,16" />

                        <!-- 模式徽章 -->
                        <Border Padding="12,4" HorizontalAlignment="Center" CornerRadius="10" Margin="0,0,0,24"
                                Background="{DynamicResource TcmGoldBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                            <Setter Property="Background" Value="#2E8B57" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentModeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </Border>

                        <!-- 用户名 -->
                        <TextBlock Text="用户名" FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="50" Padding="14,0" FontSize="15" BorderThickness="1.5"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" AutomationProperties.Name="用户名" />

                        <!-- 密码 -->
                        <TextBlock Text="密码" FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" Margin="0,0,0,6" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     Height="50" Padding="14,0" FontSize="15" BorderThickness="1.5"
                                     behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>

                        <!-- 记住选项：记住密码 / 自动登录 两端对齐 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="记住密码" FontSize="13" HorizontalAlignment="Left"
                                      VerticalAlignment="Center" IsChecked="{Binding RememberPassword}" />
                            <CheckBox Grid.Column="1" Content="自动登录" FontSize="13" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding IsAutoLogin}" />
                        </Grid>

                        <!-- 登录按钮 -->
                        <Button Height="52" Command="{Binding LoginCommand}" Content="登 录"
                                FontSize="16" FontWeight="SemiBold" Foreground="White" Cursor="Hand" Margin="0,0,0,12"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}" BorderThickness="0" />

                        <!-- 错误消息 -->
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource ValidationErrorBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={x:Static converters:Cvt.StringToVis}}" />


                    </StackPanel>

                    <!-- 关闭按钮（退出程序） -->
                    <Button Command="{Binding CloseApplicationCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="退出程序"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.4" FontSize="12" Padding="8,4"
                            Content="X" />
                </Grid>
            </Border>   
        </Grid>

        <!-- 底部状态栏（高度 48） -->
        <Border
            Grid.Row="1"
            Padding="28,0"
            Background="{DynamicResource SurfaceLevel1Brush}"
            BorderBrush="#E7DFD7"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：连接模式切换 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="连接模式" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7" Margin="0,0,14,0" />

                    <!-- 切换到本地 -->
                    <Button Command="{Binding SwitchToLocalCommand}" Content="切换到本地" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 切换到远程 -->
                    <Button Command="{Binding SwitchToRemoteCommand}" Content="切换到远程" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteMode}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRemoteAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding CurrentModeDisplay}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.7" />
                </StackPanel>

                <!-- 右：API配置按钮（打开 ServerConfigView） -->
                <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0">
                    <Border CornerRadius="16" Background="{DynamicResource MaterialDesign.Brush.Paper}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" BorderThickness="1" Padding="16,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Text="API配置" FontSize="13" FontWeight="Medium" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- 加载遮罩 -->
        <Grid Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={x:Static converters:Cvt.BoolToVis}}">
            <Border Padding="32,24" Background="{DynamicResource MaterialDesignBody}" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="正在登录..." Margin="0,12,0,0" FontSize="13"
                               HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Opacity="0.6" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
