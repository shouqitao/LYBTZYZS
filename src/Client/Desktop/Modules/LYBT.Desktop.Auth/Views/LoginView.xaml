<UserControl x:Class="LYBT.Desktop.Auth.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- Issue #1826: 全屏中医风格背景 + 左右布局 -->
    <Grid>
        <!-- 背景层：中医风格渐变 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3E2723" Offset="0"/>
                <GradientStop Color="#5D4037" Offset="0.5"/>
                <GradientStop Color="#6D4C41" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 半透明遮罩层 -->
        <Border Background="#50000000" />

        <!-- 主内容区：左右布局 -->
        <Grid Margin="80,60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />      <!-- 左侧：品牌文字区 -->
                <ColumnDefinition Width="560" />    <!-- 右侧：登录框（1080P最佳宽度，长宽比1.21） -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：品牌文字区 - Issue #1826: 调整左边距向中间靠拢 -->
        <StackPanel x:Name="LeftBrandPanel"
                    Grid.Column="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="120,0,0,0">
                <!-- 系统名称 - Issue #1826: 直接显示中文名称 -->
                <TextBlock Text="灵隐宝堂"
                           FontSize="56"
                           FontWeight="Bold"
                           Foreground="#FFD54F"
                           Margin="0,0,0,16">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="中医诊疗管理系统"
                           FontSize="42"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,32">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Slogan -->
                <TextBlock Text="传承经典 · 数字化诊疗"
                           FontSize="22"
                           Foreground="#BCAAA4"
                           Margin="0,0,0,60">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- 版本号 -->
                <TextBlock Text="Version 1.0.0.0"
                           FontSize="14"
                           Foreground="#8D6E63"
                           Opacity="0.7"/>
            </StackPanel>

            <!-- 右侧：登录框 - Issue #1826: 调整右边距向中间靠拢 -->
        <Border x:Name="RightLoginBox"
                Grid.Column="1"
                Background="White"
                CornerRadius="20"
                Padding="48,40"
                Margin="0,0,120,0"
                VerticalAlignment="Center">
                <Border.Effect>
                    <!-- Issue #1826: 优化阴影效果 - 更柔和的扩散阴影 -->
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Issue #1826: 优化间距 - 统一使用4的倍数 -->
                        <RowDefinition Height="Auto" />   <!-- 0: 标题 -->
                        <RowDefinition Height="36" />     <!-- 1: 间距（优化：32→36） -->
                        <RowDefinition Height="Auto" />   <!-- 2: 用户名输入 -->
                        <RowDefinition Height="24" />     <!-- 3: 间距（优化：20→24） -->
                        <RowDefinition Height="Auto" />   <!-- 4: 密码输入 -->
                        <RowDefinition Height="24" />     <!-- 5: 间距（优化：20→24） -->
                        <RowDefinition Height="Auto" />   <!-- 6: 记住用户名 -->
                        <RowDefinition Height="12" />     <!-- 7: 间距（优化：10→12） -->
                        <RowDefinition Height="Auto" />   <!-- 8: 记住密码 -->
                        <RowDefinition Height="20" />     <!-- 9: 间距 -->
                        <RowDefinition Height="Auto" />   <!-- 10: 连接模式 -->
                        <RowDefinition Height="28" />     <!-- 11: 间距（优化：24→28） -->
                        <RowDefinition Height="Auto" />   <!-- 12: 登录按钮 -->
                        <RowDefinition Height="16" />     <!-- 13: 间距 -->
                        <RowDefinition Height="Auto" />   <!-- 14: 状态消息 -->
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <TextBlock Text="凌隐宝堂中医诊所"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#3E2723"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="用户登录"
                                   FontSize="14"
                                   Foreground="#6D4C41"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- 用户名输入 -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="用户名"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#475569"
                                   Margin="0,0,0,8" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 FontSize="14"
                                 Padding="16,0"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1.5"
                                 VerticalContentAlignment="Center"
                                 Background="White"
                                 Foreground="#1E293B"
                                 AutomationProperties.Name="用户名">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5D4037" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#6D4C41" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <!-- 密码输入 -->
                    <StackPanel Grid.Row="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="密码"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#475569"
                                       Margin="0,0,0,8" />
                            <TextBlock Grid.Column="1"
                                       Text="（已保存）"
                                       FontSize="12"
                                       Foreground="#6D4C41"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasSavedPassword, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="48"
                                     FontSize="14"
                                     Padding="16,0"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1.5"
                                     Background="White"
                                     Foreground="#1E293B"
                                     AutomationProperties.Name="密码"
                                     PasswordChanged="PasswordBox_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5D4037" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#6D4C41" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                    </StackPanel>

                    <!-- 记住用户名 -->
                    <CheckBox Grid.Row="6"
                              Content="记住用户名"
                              IsChecked="{Binding RememberMe}"
                              FontSize="13"
                              Foreground="#64748B" />

                    <!-- 记住密码 -->
                    <StackPanel Grid.Row="8" Orientation="Horizontal">
                        <CheckBox Content="记住密码"
                                  IsChecked="{Binding RememberPassword}"
                                  FontSize="13"
                                  Foreground="#64748B"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="⚠️ 仅在可信设备使用"
                                   FontSize="11"
                                   Foreground="#D97706"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>

                    <!-- 连接模式选择 -->
                    <Border Grid.Row="10"
                            Background="#F8F5F3"
                            BorderBrush="#D7CCC8"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="连接模式"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#5D4037"
                                       Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="远程模式"
                                             IsChecked="{Binding IsRemoteModeSelected}"
                                             FontSize="12"
                                             Foreground="#6D4C41"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="本地模式（v2.0）"
                                             IsChecked="{Binding IsLocalModeSelected}"
                                             FontSize="12"
                                             Foreground="#6D4C41" />
                            </StackPanel>
                            <TextBlock Text="{Binding ConnectionModeDisplay}"
                                       FontSize="11"
                                       Foreground="#8D6E63"
                                       Margin="0,6,0,0"
                                       FontStyle="Italic" />
                        </StackPanel>
                    </Border>

                                        <!-- 登录按钮 - Issue #1826: 优化高度 -->
                    <Button Grid.Row="12"
                            Content="登录"
                            Height="52"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#5D4037"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding LoginCommand}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4E342E" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#3E2723" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#BCAAA4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 状态和错误消息区域 -->
                    <Border Grid.Row="15"
                            Background="#F8F5F3"
                            CornerRadius="8"
                            Padding="14,10"
                            Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!-- 状态消息 -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#059669"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                            <!-- 错误消息 -->
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#DC2626"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 加载遮罩 -->
        <Grid Background="#B0000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="40,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 Height="6"
                                 Background="#E5E7EB"
                                 Foreground="#5D4037"
                                 BorderThickness="0" />
                    <TextBlock Text="正在登录..."
                               Foreground="#475569"
                               FontSize="14"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
