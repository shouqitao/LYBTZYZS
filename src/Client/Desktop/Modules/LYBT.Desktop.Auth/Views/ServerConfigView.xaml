<UserControl
    x:Class="LYBT.Desktop.Auth.Views.ServerConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:LYBT.Desktop.Auth.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ServerConfigViewModel}"
    d:DesignHeight="360"
    d:DesignWidth="460"
    prism:Dialog.WindowStyle="{DynamicResource CustomDialogWindowStyle}"
    mc:Ignorable="d">

    <Grid Width="440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  0: 标题栏  -->
            <RowDefinition Height="*" />
            <!--  1: 内容  -->
            <RowDefinition Height="Auto" />
            <!--  2: 按钮栏  -->
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Padding="20,12"
            Background="{DynamicResource MaterialDesign.Brush.Primary}">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Foreground="{DynamicResource MaterialDesign.Brush.Background}"
                Text="服务器配置" />
        </Border>

        <!--  表单内容  -->
        <StackPanel
            Grid.Row="1"
            Margin="24,20"
            VerticalAlignment="Top">

            <!--  服务器地址输入  -->
            <TextBlock
                Margin="0,0,0,6"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                Text="服务器地址" />
            <TextBox
                Height="42"
                Margin="0,0,0,8"
                Padding="12,0"
                VerticalContentAlignment="Center"
                FontSize="14"
                Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="例如：https://clinic-api.example.com 或 http://192.168.1.10:5000" />

            <!--  测试连接按钮 + 状态指示  -->
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    MinWidth="96"
                    Padding="16,8"
                    HorizontalAlignment="Left"
                    Command="{Binding TestConnectionCommand}"
                    Content="测试连接"
                    Cursor="Hand"
                    FontSize="13"
                    IsEnabled="{Binding IsNotTesting}" />

                <!--  状态文本 (✓ 可用 / ✗ 不可用 / ⏳ 测试中)  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Medium"
                    Text="{Binding TestStatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestStatus}" Value="Testing">
                                    <Setter Property="Foreground" Value="#5B8FA8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestStatus}" Value="Success">
                                    <Setter Property="Foreground" Value="#228B22" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestStatus}" Value="Failed">
                                    <Setter Property="Foreground" Value="#E65100" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!--  本地模式说明  -->
            <Border
                Margin="0,4,0,0"
                Padding="14,10"
                Background="#E0F7FA"
                BorderBrush="#5B8FA8"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#5B8FA8"
                        Text="ℹ" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="本地模式无需配置，直接使用"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  按钮栏  -->
        <Border
            Grid.Row="2"
            Padding="20,12"
            Background="{DynamicResource MaterialDesign.Brush.Paper}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Padding="16,8"
                    Command="{Binding SaveOnlyCommand}"
                    Content="保存"
                    Cursor="Hand"
                    FontSize="14"
                    ToolTip="仅保存远程地址，不切换当前模式">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Paper}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.BodyLight}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    MinWidth="96"
                    Margin="12,0,0,0"
                    Padding="16,8"
                    Command="{Binding ConfirmCommand}"
                    Content="保存并启用"
                    Cursor="Hand"
                    FontSize="14"
                    ToolTip="保存远程地址并切换到远程模式 (需先通过测试)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Dark}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    MinWidth="80"
                    Margin="12,0,0,0"
                    Padding="16,8"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Cursor="Hand"
                    FontSize="14" />
            </StackPanel>
        </Border>

        <!--  保存中遮罩  -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#20000000"
            Visibility="{Binding IsBusy, Converter={x:Static converters:Cvt.BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="180"
                    Height="4"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource MaterialDesign.Brush.BodyLight}"
                    Text="{Binding StatusMessage}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
