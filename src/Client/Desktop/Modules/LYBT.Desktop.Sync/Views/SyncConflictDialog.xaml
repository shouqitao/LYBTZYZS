<UserControl
    x:Class="LYBT.Desktop.Sync.Views.SyncConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"
    Width="700"
    Height="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource LYBTTcmSurfaceBrush}">

    <UserControl.Resources>
        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LYBTTcmPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource LYBTTcmSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource LYBTTcmDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource LYBTTcmLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource LYBTTcmPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderBrush" Value="{StaticResource LYBTTcmPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource LYBTTcmHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource LYBTTcmLightBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource LYBTTcmLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选择按钮样式 -->
        <Style x:Key="ChoiceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="24,16" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 标题 -->
            <RowDefinition Height="Auto" /> <!-- 进度 -->
            <RowDefinition Height="*" />    <!-- 冲突详情 -->
            <RowDefinition Height="Auto" /> <!-- 操作按钮 -->
            <RowDefinition Height="Auto" /> <!-- 底部按钮 -->
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Foreground="{StaticResource LYBTTcmDarkBrush}"
                Text="处理数据冲突" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="14"
                Foreground="{StaticResource LYBTTcmSecondaryBrush}">
                <Run Text="请选择保留哪个版本的数据" />
            </TextBlock>
        </StackPanel>

        <!-- 进度指示 -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,16"
            Padding="16"
            Background="{StaticResource LightWarningBrush}"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{StaticResource AccentOrangeBrush}">
                        <Run Text="冲突处理进度: " />
                        <Run
                            FontWeight="SemiBold"
                            Text="{Binding ResolvedCount}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalCount}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding PreviousCommand}"
                        Content="上一个"
                        FontSize="12"
                        Padding="12,6"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Command="{Binding NextCommand}"
                        Content="下一个"
                        FontSize="12"
                        Padding="12,6"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 冲突详情 -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,16"
            Padding="20"
            Background="White"
            CornerRadius="12">
            <Grid DataContext="{Binding SelectedConflict}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 实体名称 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                Foreground="{StaticResource LYBTTextPrimaryBrush}"
                        Text="{Binding EntityName}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{StaticResource LYBTTextSecondaryBrush}"
                        Text="{Binding EntityType, StringFormat='类型: {0}'}" />
                </StackPanel>

                <!-- 版本对比 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 本地版本 -->
                    <Border
                        Grid.Column="0"
                        Padding="16"
                        Background="{StaticResource LightInfoBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="2"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource LYBTInfoBrush}"
                                Text="本地版本" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{StaticResource LYBTTextSecondaryBrush}"
                                Text="{Binding LocalChangedAt, StringFormat='修改时间: {0:yyyy-MM-dd HH:mm}'}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource LYBTTextDisabledBrush}"
                                Text="{Binding LocalChecksum, StringFormat='Checksum: {0}'}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Margin="0,16,0,0"
                                Background="{StaticResource LightInfoBrush}"
                                BorderBrush="{StaticResource LYBTInfoBrush}"
                                Command="{Binding DataContext.UseLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="使用本地版本"
                                Foreground="{StaticResource LYBTInfoBrush}"
                                Style="{StaticResource ChoiceButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- 服务器版本 -->
                    <Border
                        Grid.Column="2"
                        Padding="16"
                        Background="{StaticResource LightSuccessBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="2"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DarkSuccessBrush}"
                                Text="服务器版本" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{StaticResource LYBTTextSecondaryBrush}"
                                Text="{Binding ServerChangedAt, StringFormat='修改时间: {0:yyyy-MM-dd HH:mm}'}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource LYBTTextDisabledBrush}"
                                Text="{Binding ServerChecksum, StringFormat='Checksum: {0}'}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Margin="0,16,0,0"
                                Background="{StaticResource LightSuccessBrush}"
                                BorderBrush="{StaticResource DarkSuccessBrush}"
                                Command="{Binding DataContext.UseServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="使用服务器版本"
                                Foreground="{StaticResource DarkSuccessBrush}"
                                Style="{StaticResource ChoiceButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 快捷操作 -->
        <StackPanel
            Grid.Row="3"
            Margin="0,0,0,16"
            Orientation="Horizontal"
            HorizontalAlignment="Center">
            <Button
                Margin="0,0,12,0"
                Command="{Binding UseAllLocalCommand}"
                Content="全部使用本地"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Margin="0,0,12,0"
                Command="{Binding UseAllServerCommand}"
                Content="全部使用服务器"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Command="{Binding SkipCommand}"
                Content="跳过当前"
                Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>

        <!-- 底部按钮 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{StaticResource LYBTTextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="处理完成后点击确定继续同步" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllResolved}" Value="True">
                                <Setter Property="Text" Value="所有冲突已处理完成" />
                                <Setter Property="Foreground" Value="{StaticResource DarkSuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,12,0"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <Button
                    Command="{Binding CompleteCommand}"
                    Content="确定"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
