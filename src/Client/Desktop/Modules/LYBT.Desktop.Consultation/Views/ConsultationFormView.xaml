<UserControl x:Class="LYBT.Desktop.Consultation.Views.ConsultationFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 分组标题样式 -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>

        <!-- 字段标签样式 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,5,10,0" />
        </Style>

        <!-- 必填标记样式 -->
        <Style x:Key="RequiredMarkStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#F44336" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="2,5,0,0" />
        </Style>

        <!-- 多行文本框样式 -->
        <Style x:Key="MultiLineTextBoxStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- 操作按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Row 0: 标题 -->
                <RowDefinition Height="Auto"/>  <!-- Row 1: 步骤完成时间提示（新增） -->
                <RowDefinition Height="Auto"/>  <!-- Row 2: 基本诊断信息 -->
                <RowDefinition Height="Auto"/>  <!-- Row 3: 处方单选框（新增） -->
                <RowDefinition Height="Auto"/>  <!-- Row 4: 四诊合参 -->
                <RowDefinition Height="Auto"/>  <!-- Row 5: 备注 -->
                <RowDefinition Height="Auto"/>  <!-- Row 6: 辅助操作 -->
                <RowDefinition Height="Auto"/>  <!-- Row 7: 提示信息 -->
            </Grid.RowDefinitions>

            <!-- Row 0: 标题 -->
            <TextBlock Grid.Row="0"
                      Text="诊断录入（Consultation）"
                      FontSize="20"
                      FontWeight="Bold"
                      Foreground="#2E86AB"
                      Margin="0,0,0,10" />

            <!-- Row 1: 步骤完成时间提示（新增，Issue #1590）-->
            <TextBlock Grid.Row="1"
                      Text="{Binding Step1CompletedAtText, Mode=OneWay}"
                      Visibility="{Binding Step1CompletedAtVisibility, Mode=OneWay}"
                      Foreground="Green"
                      FontSize="14"
                      FontWeight="SemiBold"
                      Margin="0,0,0,10" />

            <!-- Row 2: 基本诊断信息（2列布局） -->
            <Border Grid.Row="2"
                   BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   CornerRadius="5"
                   Padding="15"
                   Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 分组标题 -->
                        <RowDefinition Height="Auto"/>  <!-- 主诉 + 现病史 -->
                        <RowDefinition Height="Auto"/>  <!-- 中医诊断 + 治疗原则 -->
                    </Grid.RowDefinitions>

                    <!-- 分组标题 -->
                    <TextBlock Grid.Row="0"
                              Text="基本诊断信息"
                              Style="{StaticResource GroupHeaderStyle}" />

                    <!-- Row 1: 主诉 + 现病史（2列） -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>  <!-- 间距 -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：主诉（必填） -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="主诉" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="*" Style="{StaticResource RequiredMarkStyle}" />
                            </StackPanel>
                            <TextBox Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MultiLineTextBoxStyle}"
                                    Height="80" />
                        </StackPanel>

                        <!-- 右列：现病史 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="现病史" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MultiLineTextBoxStyle}"
                                    Height="80" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: 中医诊断 + 治疗原则（2列） -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>  <!-- 间距 -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：中医诊断（必填） -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="中医诊断" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="*" Style="{StaticResource RequiredMarkStyle}" />
                            </StackPanel>
                            <TextBox Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MultiLineTextBoxStyle}"
                                    Height="80" />
                        </StackPanel>

                        <!-- 右列：治疗原则 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="治疗原则" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MultiLineTextBoxStyle}"
                                    Height="80" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 3: 处方单选框（新增，Issue #1590）-->
            <Border Grid.Row="3"
                   BorderBrush="#E3F2FD"
                   BorderThickness="1"
                   CornerRadius="5"
                   Padding="15"
                   Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="是否开处方："
                              VerticalAlignment="Center"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Margin="0,0,15,0"/>
                    <RadioButton Content="开处方"
                                IsChecked="{Binding PrescriptionEnabled}"
                                GroupName="PrescriptionGroup"
                                FontSize="14"
                                Margin="0,0,30,0"/>
                    <RadioButton Content="不开处方"
                                IsChecked="{Binding PrescriptionDisabled, Mode=OneWay}"
                                GroupName="PrescriptionGroup"
                                FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Row 4: 四诊合参（2列布局） -->
            <Border Grid.Row="4"
                   BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   CornerRadius="5"
                   Padding="15"
                   Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 分组标题 -->
                        <RowDefinition Height="Auto"/>  <!-- 望诊 + 闻诊 -->
                        <RowDefinition Height="Auto"/>  <!-- 问诊 + 切诊 -->
                    </Grid.RowDefinitions>

                    <!-- 分组标题 -->
                    <TextBlock Grid.Row="0"
                              Text="四诊合参"
                              Style="{StaticResource GroupHeaderStyle}" />

                    <!-- Row 1: 望诊 + 闻诊（2列） -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>  <!-- 间距 -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：望诊 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="望诊（神色、形体、舌象）" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Inspection, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MultiLineTextBoxStyle}"
                                    Height="70" />
                        </StackPanel>

                        <!-- 右列：闻诊 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="闻诊（语声、呼吸、口气）" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding AuscultationOlfaction, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MultiLineTextBoxStyle}"
                                    Height="70" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: 问诊 + 切诊（2列） -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>  <!-- 间距 -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：问诊 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="问诊（主诉、病史等）" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MultiLineTextBoxStyle}"
                                    Height="70" />
                        </StackPanel>

                        <!-- 右列：切诊 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="切诊（脉象、腹诊）" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Palpation, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MultiLineTextBoxStyle}"
                                    Height="70" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 5: 备注 -->
            <StackPanel Grid.Row="5" Margin="0,0,0,20">
                <TextBlock Text="备注" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MultiLineTextBoxStyle}"
                        Height="60" />
            </StackPanel>

            <!-- Row 6: 辅助操作（新增完成Step1按钮，Issue #1590；新增保存草稿按钮，Issue #1594）-->
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,20">
                <!-- Issue #1562: ImportFromHistoryCommand已删除（未实现的扩展功能）-->
                <Button Content="完成Step1"
                       Command="{Binding CompleteStep1Command}"
                       Style="{StaticResource ActionButtonStyle}"
                       Background="#4CAF50"
                       Margin="0,0,10,0"/>
                <!-- Issue #1594: 新增保存草稿按钮 -->
                <Button Content="保存草稿"
                       Command="{Binding SaveDraftCommand}"
                       Style="{StaticResource ActionButtonStyle}"
                       Background="#2196F3"
                       Margin="0,0,10,0"/>
                <Button Content="清空表单"
                       Command="{Binding ClearFormCommand}"
                       Style="{StaticResource ActionButtonStyle}"
                       Background="#FF9800" />
            </StackPanel>

            <!-- Row 7: 提示信息 -->
            <Border Grid.Row="7"
                   Background="#E3F2FD"
                   BorderBrush="#90CAF9"
                   BorderThickness="1"
                   CornerRadius="5"
                   Padding="10">
                <TextBlock TextWrapping="Wrap"
                          Foreground="#1976D2"
                          FontSize="12">
                    <Run Text="提示：" FontWeight="Bold" />
                    <Run Text="填写完成后点击【完成Step1】按钮，根据处方选择跳转到处方录入或汇总页。" />
                </TextBlock>
            </Border>

            <!-- 浮动查询菜单按钮（右下角，Issue #1590）-->
            <Button Grid.Row="0"
                   Grid.RowSpan="8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="56"
                   Height="56"
                   Margin="0,0,20,20"
                   Command="{Binding ShowOtherCasesQueryCommand}"
                   ToolTip="查询其他病案"
                   Background="#2196F3"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Content="?"
                   BorderThickness="0"
                   Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="28"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </ScrollViewer>
</UserControl>
