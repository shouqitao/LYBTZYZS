<UserControl
    x:Class="LYBT.Desktop.Consultation.Views.ConsultationFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- OpenSpec: refactor-diagnosis-fields - 移除ChiefComplaint, TreatmentPrinciple, FourDiagnosis字段 -->
    <!-- 保留4个核心字段: PresentIllness, TongueDiagnosis, PulseDiagnosis, TCMDiagnosis -->

    <UserControl.Resources>
        <!--  分组标题样式  -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>

        <!--  字段标签样式  -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,5,10,0" />
        </Style>

        <!--  必填标记样式  -->
        <Style x:Key="RequiredMarkStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#F44336" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="2,5,0,0" />
        </Style>

        <!--  多行文本框样式  -->
        <Style x:Key="MultiLineTextBoxStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!--  操作按钮样式  -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Row 0: 标题  -->
                <RowDefinition Height="Auto" />
                <!--  Row 1: 步骤完成时间提示  -->
                <RowDefinition Height="Auto" />
                <!--  Row 2: 基本诊断信息  -->
                <RowDefinition Height="Auto" />
                <!--  Row 3: 处方单选框  -->
                <RowDefinition Height="Auto" />
                <!--  Row 4: 舌诊脉诊  -->
                <RowDefinition Height="Auto" />
                <!--  Row 5: 备注  -->
                <RowDefinition Height="Auto" />
                <!--  Row 6: 辅助操作  -->
                <RowDefinition Height="Auto" />
                <!--  Row 7: 提示信息  -->
            </Grid.RowDefinitions>

            <!--  Row 0: 标题  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#2E86AB"
                Text="诊断录入（Consultation）" />

            <!--  Row 1: 步骤完成时间提示（Issue #1590）  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,10"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="Green"
                Text="{Binding Step1CompletedAtText, Mode=OneWay}"
                Visibility="{Binding IsStep1CompletedAtVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Row 2: 基本诊断信息（2列布局）  -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  分组标题  -->
                        <RowDefinition Height="Auto" />
                        <!--  现病史 + 中医诊断  -->
                    </Grid.RowDefinitions>

                    <!--  分组标题  -->
                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource GroupHeaderStyle}"
                        Text="基本诊断信息" />

                    <!--  Row 1: 现病史 + 中医诊断（2列）  -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <!--  间距  -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  左列：现病史  -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="现病史" />
                            <TextBox
                                Height="100"
                                Style="{StaticResource MultiLineTextBoxStyle}"
                                Text="{Binding PresentIllness, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  右列：中医诊断（必填）  -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="中医诊断" />
                                <TextBlock Style="{StaticResource RequiredMarkStyle}" Text="*" />
                            </StackPanel>
                            <TextBox
                                Height="100"
                                Style="{StaticResource MultiLineTextBoxStyle}"
                                Text="{Binding TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!--  Row 3: 处方单选框（Issue #1590）  -->
            <Border
                Grid.Row="3"
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#E3F2FD"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="是否开处方：" />
                    <RadioButton
                        Margin="0,0,30,0"
                        Content="开处方"
                        FontSize="14"
                        GroupName="PrescriptionGroup"
                        IsChecked="{Binding PrescriptionEnabled}" />
                    <RadioButton
                        Content="不开处方"
                        FontSize="14"
                        GroupName="PrescriptionGroup"
                        IsChecked="{Binding PrescriptionDisabled, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!--  Row 4: 舌诊脉诊（2列布局）  -->
            <Border
                Grid.Row="4"
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  分组标题  -->
                        <RowDefinition Height="Auto" />
                        <!--  舌诊 + 脉诊  -->
                    </Grid.RowDefinitions>

                    <!--  分组标题  -->
                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource GroupHeaderStyle}"
                        Text="望闻问切" />

                    <!--  舌诊 + 脉诊（2列）  -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <!--  间距  -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  左列：舌诊  -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="舌诊（舌质、舌苔）" />
                            <TextBox
                                Height="80"
                                Style="{StaticResource MultiLineTextBoxStyle}"
                                Text="{Binding TongueDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  右列：脉诊  -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="脉诊（脉象描述）" />
                            <TextBox
                                Height="80"
                                Style="{StaticResource MultiLineTextBoxStyle}"
                                Text="{Binding PulseDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!--  Row 5: 备注  -->
            <StackPanel Grid.Row="5" Margin="0,0,0,20">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="备注" />
                <TextBox
                    Height="60"
                    Style="{StaticResource MultiLineTextBoxStyle}"
                    Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Row 6: 辅助操作（Issue #1590, Issue #1594）  -->
            <StackPanel
                Grid.Row="6"
                Margin="0,0,0,20"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Background="#4CAF50"
                    Command="{Binding CompleteStep1Command}"
                    Content="完成Step1"
                    Style="{StaticResource ActionButtonStyle}" />
                <Button
                    Margin="0,0,10,0"
                    Background="#2196F3"
                    Command="{Binding SaveDraftCommand}"
                    Content="保存草稿"
                    Style="{StaticResource ActionButtonStyle}" />
                <Button
                    Background="#FF9800"
                    Command="{Binding ClearFormCommand}"
                    Content="清空表单"
                    Style="{StaticResource ActionButtonStyle}" />
            </StackPanel>

            <!--  Row 7: 提示信息  -->
            <Border
                Grid.Row="7"
                Padding="10"
                Background="#E3F2FD"
                BorderBrush="#90CAF9"
                BorderThickness="1"
                CornerRadius="5">
                <TextBlock
                    FontSize="12"
                    Foreground="#1976D2"
                    TextWrapping="Wrap">
                    <Run FontWeight="Bold" Text="提示：" />
                    <Run Text="填写完成后点击【完成Step1】按钮，根据处方选择跳转到处方录入或汇总页。" />
                </TextBlock>
            </Border>

            <!--  浮动查询菜单按钮（右下角，Issue #1590）  -->
            <Button
                Grid.Row="0"
                Grid.RowSpan="8"
                Width="56"
                Height="56"
                Margin="0,0,20,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#2196F3"
                BorderThickness="0"
                Command="{Binding ShowOtherCasesQueryCommand}"
                Content="?"
                Cursor="Hand"
                FontSize="24"
                FontWeight="Bold"
                Foreground="White"
                ToolTip="查询其他病案">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="28" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </ScrollViewer>
</UserControl>
