<UserControl x:Class="LYBT.Desktop.Consultation.Views.ConsultationMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:LYBT.Desktop.Consultation.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1366">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Height="50">
            <Grid>
                <TextBlock Text="{Binding Title}"
                          Foreground="White"
                          FontSize="20"
                          VerticalAlignment="Center"
                          Margin="20,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0">
                    <Button Content="刷新"
                           Command="{Binding RefreshCommand}"
                                                      Foreground="White"
                           Margin="5,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：患者列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 搜索框 -->
                <Border Grid.Row="0" Background="White" Padding="10">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Tag="搜索患者..." />
                </Border>

                <!-- 患者列表 -->
                <ListBox Grid.Row="1"
                        ItemsSource="{Binding Patients}"
                        SelectedItem="{Binding SelectedPatient}"
                        Background="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding GenderText}" Opacity="0.7" />
                                    <TextBlock Text="{Binding PhoneNumber}" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 中间：诊疗信息 -->
            <Grid Grid.Column="1" Margin="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- 患者基本信息 -->
                        <Border Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="当前患者" FontSize="14" Opacity="0.7" />
                                    <TextBlock Text="{Binding SelectedPatient.Name}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>

                                <!-- P0-02优化：添加患者历史查询功能 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="诊疗历史"
                                           Command="{Binding ViewPatientHistoryCommand}"
                                           Padding="10,5"
                                           Margin="5,5,5,5"
                                           Background="#4CAF50"
                                           Foreground="White"
                                           ToolTip="查看该患者的历史诊疗记录" />
                                    <Button Content="开始诊疗"
                                           Command="{Binding NewConsultationCommand}"
                                           Padding="10,5"
                                           Margin="5" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 中医四诊信息（实用化简版） -->
                        <Border Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="诊疗记录" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" />

                                <!-- 主诉 -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="主诉" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Consultation.ChiefComplaint}" 
                                             Height="40" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Padding="8"
                                             BorderBrush="#E0E0E0"
                                             Background="#FAFAFA" />
                                </StackPanel>

                                <!-- P0-04优化：四诊录入界面简化 -->
                                <StackPanel Margin="0,0,0,15">
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock Text="四诊合参" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                            <Button Content="常用模板" 
                                                    Command="{Binding ShowTemplateMenuCommand}"
                                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                                    Height="24" 
                                                    Padding="8,2" 
                                                    FontSize="11"
                                                    Margin="5,0,0,0"
                                                    ToolTip="选择常用四诊录入模板" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="📋 望闻问切综合记录 | 💡 提示：可使用常用模板快速录入，支持自由描述症状、体征、脉象等" 
                                               FontSize="11" 
                                               Foreground="Gray" 
                                               Margin="0,0,0,8" />
                                    
                                    <!-- 改进的四诊录入区域 -->
                                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            
                                            <TextBox Grid.Row="0"
                                                     Text="{Binding Consultation.Palpation, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="120" 
                                                     AcceptsReturn="True" 
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Padding="10,8"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     TextOptions.TextRenderingMode="ClearType"
                                                     FontSize="13"
                                                     ToolTip="四诊录入：望-外观体征，闻-声音气味，问-症状询问，切-脉象触诊" />
                                            
                                            <!-- 底部提示栏 -->
                                            <Border Grid.Row="1" 
                                                    Background="#F5F5F5" 
                                                    BorderThickness="0,1,0,0" 
                                                    BorderBrush="#E0E0E0"
                                                    Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📝 快捷提示：" FontSize="10" Foreground="#666" Margin="0,0,5,0" />
                                                    <TextBlock Text="面色 | 舌质舌苔 | 脉象 | 声音 | 症状表现" 
                                                               FontSize="10" 
                                                               Foreground="#888"
                                                               ToolTip="常见录入内容提示" />
                                                    <TextBlock Text="{Binding Consultation.Palpation.Length, StringFormat='字数: {0}'}" 
                                                               FontSize="10" 
                                                               Foreground="#999" 
                                                               HorizontalAlignment="Right"
                                                               Margin="20,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- 中医诊断 -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="中医诊断" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Consultation.Diagnosis}" 
                                             Height="80" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Padding="8"
                                             BorderBrush="#E0E0E0"
                                             Background="#FAFAFA"
                                             ToolTip="中医病症诊断" />
                                </StackPanel>

                                <!-- 诊疗备注 -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="诊疗备注" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBlock Text="治疗方案、医嘱、注意事项等" 
                                               FontSize="11" 
                                               Foreground="Gray" 
                                               Margin="0,0,0,5" />
                                    <TextBox Text="{Binding Consultation.Remark}" 
                                             Height="60" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Padding="8"
                                             BorderBrush="#E0E0E0"
                                             Background="#FAFAFA"
                                             ToolTip="可记录治疗方案、用药建议、生活调护等" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 操作按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                            <Button Content="保存"
                                   Command="{Binding SaveConsultationCommand}"
                                                                      Margin="5,0" />
                            <Button Content="打印处方"
                                   Command="{Binding PrintPrescriptionCommand}"
                                                                      Margin="5,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 右侧：处方开具 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Grid.Row="0" Background="White" Padding="10">
                    <TextBlock Text="处方开具" FontSize="16" FontWeight="Bold" />
                </Border>

                <!-- 处方项列表 -->
                <DataGrid Grid.Row="1"
                         ItemsSource="{Binding PrescriptionItems}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="药材" Binding="{Binding HerbName}" Width="*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="数量" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="-" Width="20" Height="20"
                                               Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                Width="30" Height="20" TextAlignment="Center"
                                                Margin="2,0" />
                                        <Button Content="+" Width="20" Height="20"
                                               Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="40" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="操作" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="删"
                                           Command="{Binding DataContext.RemovePrescriptionItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Width="30" Height="20"
                                           Padding="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 处方组成操作 -->
                <Border Grid.Row="2" Background="White" Padding="10">
                    <StackPanel>
                        <!-- 验方快速应用 -->
                        <TextBlock Text="验方快速应用" FontWeight="Bold" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding AvailableFormulas}"
                                 DisplayMemberPath="Name"
                                 Tag="选择验方一键应用..."
                                 Margin="0,0,0,10">
                            <!-- 验方选择功能已简化，暂时移除事件处理 -->
                        </ComboBox>

                        <!-- 分割线 -->
                        <Separator Margin="0,5" />

                        <!-- 手动添加药材 -->
                        <TextBlock Text="手动添加药材" FontWeight="Bold" Margin="0,5,0,5" />
                        <!-- 药材搜索框 -->
                        <TextBox x:Name="HerbSearchBox"
                                Tag="搜索药材名称..."
                                Text="{Binding HerbSearchText, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,5" />
                        <!-- 药材选择列表 -->
                        <ComboBox x:Name="HerbComboBox"
                                 ItemsSource="{Binding AvailableHerbs}"
                                 DisplayMemberPath="Name"
                                 Tag="选择药材添加到处方..."
                                 MaxDropDownHeight="150">
                            <!-- 药材选择功能已简化，暂时移除事件处理 -->
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 加载指示器 -->
        <Grid Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#80000000">
                <ProgressBar                             IsIndeterminate="True"
                            Width="50" Height="50"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
