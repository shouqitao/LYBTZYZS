<UserControl x:Class="LYBT.Desktop.Consultation.Views.ConsultationManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- UltraThink UI/UX优化 Phase 1: 使用统一设计系统样式 -->
        <!-- 所有样式现在从UnifiedDesignSystem.xaml继承，只保留页面特定配置 -->

        <!-- 诊疗管理专用DataGrid样式（支持行选择高亮和鼠标悬停效果） -->
        <Style x:Key="ConsultationManagementDataGrid" TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Margin" Value="20" />
        </Style>

        <!-- 诊疗管理专用行样式（增强的交互效果） -->
        <Style x:Key="ConsultationDataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource BaseDataGridRow}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E8" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E6C9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 搜索和筛选区域 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="搜索：" Style="{StaticResource LabelText}" />
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Text="日期：" Style="{StaticResource LabelText}" Margin="20,0,10,0" />
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="32" Margin="0,0,5,0" />
                    <TextBlock Text="至" Style="{StaticResource LabelText}" Margin="5,0" />
                    <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="32" Margin="5,0,10,0" />

                    <Button Content="搜索"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}" />
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📊 统计报告"
                            Margin="0,0,10,0"
                            Style="{StaticResource InfoButton}"
                            Command="{Binding StatisticsCommand}"
                            ToolTip="查诊疗疗记录统计报告" />
                    <Button Content="刷新"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource ConsultationManagementDataGrid}"
                  RowStyle="{StaticResource ConsultationDataGridRow}"
                  ColumnHeaderStyle="{StaticResource BaseDataGridColumnHeader}">
            <DataGrid.Columns>
                <!-- 诊疗日期 -->
                <DataGridTextColumn Header="诊疗日期"
                                    Binding="{Binding ConsultationDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                    Width="140" />

                <!-- 患者信息 -->
                <DataGridTextColumn Header="患者姓名"
                                    Binding="{Binding PatientName}"
                                    Width="100" />

                <DataGridTextColumn Header="性别"
                                    Binding="{Binding PatientGender}"
                                    Width="60" />

                <DataGridTextColumn Header="年龄"
                                    Binding="{Binding PatientAge}"
                                    Width="60" />

                <!-- 医生 -->
                <DataGridTextColumn Header="接诊医生"
                                    Binding="{Binding DoctorName}"
                                    Width="100" />

                <!-- 主诉症状 -->
                <DataGridTextColumn Header="主诉症状"
                                    Binding="{Binding ChiefComplaint}"
                                    Width="200" />

                <!-- 诊断结果 -->
                <DataGridTextColumn Header="中医诊断"
                                    Binding="{Binding TCMDiagnosis}"
                                    Width="200" />

                <!-- 处方 -->
                <DataGridTemplateColumn Header="处方" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding HasPrescription, Converter={StaticResource BoolToBrushConverter}}"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PrescriptionStatus}"
                                           Foreground="White"
                                           FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="White"
                                           FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="查看详情"
                                        Style="{StaticResource InfoButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="查看处方"
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ViewPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding HasPrescription}" />
                                <Button Content="打印"
                                        Style="{StaticResource InfoButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="复制病历"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.CopyRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusLabel}"
                               Text="{Binding StatusText}" />
                </StackPanel>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="首页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding FirstPageCommand}" />

                    <Button Content="上一页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding PreviousPageCommand}" />

                    <Border Style="{StaticResource PaginationCurrentPage}">
                        <TextBlock Style="{StaticResource PaginationPageNumber}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage" />
                                    <Binding Path="TotalPages" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>

                    <Button Content="下一页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding NextPageCommand}" />

                    <Button Content="末页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding LastPageCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
