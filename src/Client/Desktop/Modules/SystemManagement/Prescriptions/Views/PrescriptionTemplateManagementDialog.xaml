<Window x:Class="LYBT.Desktop.Admin.Prescriptions.Views.PrescriptionTemplateManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="处方模板管理" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style x:Key="CategoryButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="Transparent" 
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="15,10"
                                Margin="0,0,10,0">
                            <TextBlock Text="{TemplateBinding Content}" 
                                      FontSize="14"
                                      Foreground="#666"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="#2196F3"/>
                                <Setter TargetName="border" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TemplateItemTemplate">
            <Border Background="White" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="5"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 模板标题 -->
                    <DockPanel Grid.Row="0">
                        <CheckBox x:Name="SelectCheckBox" 
                                  IsChecked="{Binding IsSelected}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding Name}" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#333"/>
                        <TextBlock Text="{Binding UsageCount, StringFormat='使用{0}次'}"
                                   HorizontalAlignment="Right"
                                   Foreground="#999"
                                   FontSize="11"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>
                    
                    <!-- 模板信息 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="#E3F2FD" CornerRadius="3" Padding="5,2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#1976D2"/>
                        </Border>
                        <TextBlock Text="{Binding Syndrome}" FontSize="12" Foreground="#666" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding TreatmentPrinciple}" FontSize="12" Foreground="#666"/>
                    </StackPanel>
                    
                    <!-- 药材列表预览 -->
                    <TextBlock Grid.Row="2" 
                               Text="{Binding HerbPreview}" 
                               FontSize="12" 
                               Foreground="#999"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0"/>
                    
                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="应用" 
                                Style="{StaticResource ActionButton}"
                                Background="#4CAF50" Foreground="White"
                                Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="编辑" 
                                Style="{StaticResource ActionButton}"
                                Command="{Binding DataContext.EditTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="复制" 
                                Style="{StaticResource ActionButton}"
                                Command="{Binding DataContext.DuplicateTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="删除" 
                                Style="{StaticResource ActionButton}"
                                Foreground="#F44336"
                                Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="处方模板库" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="管理常用处方模板，提高开方效率" FontSize="12" Foreground="#999" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="➕ 新建模板" 
                            Padding="15,8" 
                            Background="#2196F3" 
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="CreateTemplate_Click"/>
                    <Button Content="📥 导入" 
                            Padding="15,8" 
                            Margin="10,0,0,0"
                            Style="{StaticResource ActionButton}"
                            Click="ImportTemplates_Click"/>
                    <Button Content="📤 导出" 
                            Padding="15,8" 
                            Style="{StaticResource ActionButton}"
                            Click="ExportTemplates_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 筛选栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 分类选择 -->
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="全部" Style="{StaticResource CategoryButton}" IsChecked="True" 
                                    Checked="CategoryFilter_Changed" Tag="全部"/>
                        <RadioButton Content="感冒类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="感冒类"/>
                        <RadioButton Content="咳嗽类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="咳嗽类"/>
                        <RadioButton Content="脾胃类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="脾胃类"/>
                        <RadioButton Content="肝胆类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="肝胆类"/>
                        <RadioButton Content="心脑类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="心脑类"/>
                        <RadioButton Content="肾系类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="肾系类"/>
                        <RadioButton Content="妇科类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="妇科类"/>
                        <RadioButton Content="儿科类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="儿科类"/>
                        <RadioButton Content="皮肤类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="皮肤类"/>
                        <RadioButton Content="骨伤类" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="骨伤类"/>
                        <RadioButton Content="个人模板" Style="{StaticResource CategoryButton}" 
                                    Checked="CategoryFilter_Changed" Tag="个人"/>
                    </StackPanel>
                </ScrollViewer>
                
                <!-- 搜索和筛选 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 搜索框 -->
                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <TextBox x:Name="SearchTextBox" 
                                     Padding="30,8,10,8" 
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="🔍" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#999"/>
                            <TextBlock Text="搜索模板名称、诊断、药材..." 
                                      Margin="35,0,0,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="#999" 
                                      IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    
                    <!-- 筛选选项 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                        <CheckBox Content="仅显示常用" 
                                  IsChecked="{Binding ShowFrequentOnly}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0"/>
                        <CheckBox Content="仅显示公开" 
                                  IsChecked="{Binding ShowPublicOnly}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- 排序 -->
                    <ComboBox Grid.Column="2" Width="150" SelectedIndex="0">
                        <ComboBoxItem>按使用次数排序</ComboBoxItem>
                        <ComboBoxItem>按创建时间排序</ComboBoxItem>
                        <ComboBoxItem>按名称排序</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>
        
        <!-- 模板列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="15">
            <ItemsControl x:Name="TemplateList" ItemsSource="{Binding FilteredTemplates}" ItemTemplate="{StaticResource TemplateItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="共 {0} 个模板，已选择 {1} 个">
                            <Binding Path="TotalTemplateCount"/>
                            <Binding Path="SelectedTemplateCount"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="批量删除" 
                            Style="{StaticResource ActionButton}"
                            Visibility="{Binding HasSelectedTemplates, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding BatchDeleteCommand}"/>
                    <Button Content="关闭" 
                            Padding="20,8" 
                            Style="{StaticResource ActionButton}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>