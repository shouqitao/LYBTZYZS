<Window x:Class="LYBT.Desktop.Admin.Prescriptions.Views.PatientSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="选择患者" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="搜索患者：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="SearchTextBox" 
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding SearchTypes}"
                          SelectedItem="{Binding SelectedSearchType}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          Width="100" Margin="10,0,5,0"/>
                          
                <Button Grid.Column="3" Content="搜索" Command="{Binding SearchCommand}" 
                        Margin="5,0,5,0" Padding="15,5"/>
                <Button Grid.Column="4" Content="清空" Command="{Binding ClearSearchCommand}" 
                        Margin="5,0,0,0" Padding="15,5"/>
            </Grid>
        </Border>

        <!-- 患者列表 -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding FilteredPatients}"
                  SelectedItem="{Binding SelectedPatient}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="10">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" 
                              Command="{Binding SelectPatientCommand}"
                              CommandParameter="{Binding SelectedPatient}"/>
            </DataGrid.InputBindings>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="患者ID" Binding="{Binding Id}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="性别" Binding="{Binding GenderDisplay}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="手机号" Binding="{Binding PhoneNumber}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="证件号" Binding="{Binding IdNumber}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="最后就诊" Binding="{Binding LastVisitTime, StringFormat={}{0:yyyy-MM-dd}}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 选中患者信息 -->
        <Border Grid.Row="2" Background="#F9F9F9" Padding="10" Margin="10,0,10,10"
                Visibility="{Binding HasSelectedPatient, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="已选择患者：" FontWeight="Bold" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="姓名：" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.Name}" Margin="5,0"/>
                        <TextBlock Text="性别：" Margin="20,0,5,0" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.GenderDisplay}"/>
                        <TextBlock Text="年龄：" Margin="20,0,5,0" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.Age}"/>
                        <TextBlock Text="岁" Margin="2,0"/>
                        <TextBlock Text="患者ID：" Margin="20,0,5,0" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.Id}" Foreground="Blue"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="过敏史：" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.AllergyHistory}" Margin="5,0" Foreground="Red"/>
                        <TextBlock Text="地址：" Margin="20,0,5,0" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.Address}" Margin="5,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 按钮栏 -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="新建患者" Command="{Binding CreateNewPatientCommand}" 
                        Padding="15,5" HorizontalAlignment="Left"/>
                        
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定" Command="{Binding ConfirmCommand}" 
                            IsDefault="True" Padding="20,5" Margin="0,0,10,0"
                            IsEnabled="{Binding HasSelectedPatient}"/>
                    <Button Content="取消" Command="{Binding CancelCommand}" 
                            IsCancel="True" Padding="20,5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>