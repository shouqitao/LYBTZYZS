<Window x:Class="LYBT.Desktop.Admin.Prescriptions.Views.HerbSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="选择药材" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="搜索药材：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="SearchTextBox" 
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2" Content="搜索" Command="{Binding SearchCommand}" 
                        Margin="10,0,5,0" Padding="15,5"/>
                <Button Grid.Column="3" Content="清空" Command="{Binding ClearSearchCommand}" 
                        Margin="5,0,0,0" Padding="15,5"/>
            </Grid>
        </Border>

        <!-- 药材列表 -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding FilteredHerbs}"
                  SelectedItem="{Binding SelectedHerb}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="10">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" 
                              Command="{Binding SelectHerbCommand}"
                              CommandParameter="{Binding SelectedHerb}"/>
            </DataGrid.InputBindings>
            
            <DataGrid.Columns>
                                <DataGridTextColumn Header="药材名称" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="拼音码" Binding="{Binding PinYinCode}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="单价(元)" Binding="{Binding Price, StringFormat={}{0:F2}}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="库存" Binding="{Binding Stock, StringFormat={}{0:F2}}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="产地" Binding="{Binding Origin}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="功效" Binding="{Binding Effect}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 选中药材信息 -->
        <Border Grid.Row="2" Background="#F9F9F9" Padding="10" Margin="10,0,10,10"
                Visibility="{Binding HasSelectedHerb, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="已选择：" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedHerb.Name}" Margin="5,0"/>
                <TextBlock Text="单价：" Margin="20,0,5,0"/>
                <TextBlock Text="{Binding SelectedHerb.Price, StringFormat={}{0:F2}元}" FontWeight="Bold" Foreground="Red"/>
                <TextBlock Text="库存：" Margin="20,0,5,0"/>
                <TextBlock Text="{Binding SelectedHerb.Stock, StringFormat={}{0:F2}}" />
                <TextBlock Text="{Binding SelectedHerb.Unit}" Margin="5,0"/>
            </StackPanel>
        </Border>

        <!-- 按钮栏 -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Command="{Binding ConfirmCommand}" 
                        IsDefault="True" Padding="20,5" Margin="0,0,10,0"
                        IsEnabled="{Binding HasSelectedHerb}"/>
                <Button Content="取消" Command="{Binding CancelCommand}" 
                        IsCancel="True" Padding="20,5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>