<Window x:Class="LYBT.Desktop.Admin.Prescriptions.Views.AddPrescriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        Height="750" Width="1100" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="600" MinWidth="900"
        Title="新增处方" Background="White">
    
    <Window.Resources>
        <!-- 圆角边框样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="2" BlurRadius="5" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题样式 -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 标签样式 -->
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 数字输入框样式 -->
        <Style x:Key="NumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004085"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小按钮样式 -->
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 加载指示器 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="正在加载..." FontSize="14" Foreground="#666666" HorizontalAlignment="Center"/>
            <ProgressBar Width="200" Height="4" Margin="0,10,0,0" IsIndeterminate="True"/>
        </StackPanel>

        <!-- 主要内容 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel Margin="20">
                
                <!-- 标题栏 -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="新增处方" FontSize="24" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource ActionButtonStyle}" Background="#28A745"/>
                        <Button Content="保存并继续" Command="{Binding SaveAndContinueCommand}" Style="{StaticResource ActionButtonStyle}" Background="#17A2B8"/>
                        <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource ActionButtonStyle}" Background="#6C757D"/>
                    </StackPanel>
                </Grid>

                <!-- 基本信息 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="基本信息" Style="{StaticResource TitleTextStyle}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 第一行 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="患者姓名：" Style="{StaticResource LabelTextStyle}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,10">
                                <TextBox Text="{Binding PatientName}" Style="{StaticResource InputTextBoxStyle}" Width="150"/>
                                <Button Content="选择" Style="{StaticResource SmallButtonStyle}" Background="#FFC107" Foreground="#333333" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="医生姓名：" Style="{StaticResource LabelTextStyle}"/>
                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Text="{Binding DoctorName}" Style="{StaticResource InputTextBoxStyle}" Width="150"/>
                                <Button Content="选择" Style="{StaticResource SmallButtonStyle}" Background="#FFC107" Foreground="#333333" Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- 第二行 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="诊断信息：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Diagnosis}" 
                                     Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                            <!-- 第三行 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="剂数：" Style="{StaticResource LabelTextStyle}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,10">
                                <TextBox Text="{Binding DosageCount}" Style="{StaticResource NumericTextBoxStyle}" Width="80"/>
                                <TextBlock Text="帖" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- 第四行 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="服用方法：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Usage}" 
                                     Style="{StaticResource InputTextBoxStyle}" Height="60" TextWrapping="Wrap" 
                                     VerticalContentAlignment="Top" AcceptsReturn="True" Margin="0,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 药材清单 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="药材清单" Style="{StaticResource TitleTextStyle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="使用模板" Command="{Binding UseTemplateCommand}" Style="{StaticResource ActionButtonStyle}" Background="#9C27B0" Margin="0,0,5,0"/>
                                <Button Content="添加药材" Command="{Binding AddItemCommand}" Style="{StaticResource ActionButtonStyle}" Background="#28A745"/>
                            </StackPanel>
                        </Grid>

                        <!-- 药材列表表头 -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4,4,0,0">
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="药材名称" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="用量" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="单位" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="单价" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="小计" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="操作" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 药材列表内容 -->
                        <ItemsControl ItemsSource="{Binding Items}" AlternationCount="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DEE2E6" BorderThickness="1,0,1,1" Background="White">
                                        <Grid Height="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToNumberConverter}}" 
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666"/>
                                            
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                <TextBox Text="{Binding HerbName}" Width="120" Height="26" IsReadOnly="True" Background="#F8F9FA"/>
                                                <Button Content="选择" Command="{Binding DataContext.SelectHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}" 
                                                        Background="#FFC107" Foreground="#333333" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            
                                            <TextBox Grid.Column="2" Text="{Binding Quantity}" Style="{StaticResource NumericTextBoxStyle}" 
                                                     Width="70" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            
                                            <TextBox Grid.Column="3" Text="{Binding Unit}" Style="{StaticResource InputTextBoxStyle}" 
                                                     Width="60" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            
                                            <TextBox Grid.Column="4" Text="{Binding Price}" Style="{StaticResource NumericTextBoxStyle}" 
                                                     Width="70" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="5" Text="{Binding Subtotal, StringFormat={}￥{0:F2}}" 
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#28A745"/>
                                            
                                            <Button Grid.Column="6" Content="移除" 
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Style="{StaticResource SmallButtonStyle}" 
                                                    Background="#DC3545" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 总计信息 -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" Padding="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="总价：" FontSize="14" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}￥{0:F2}}" FontSize="16" FontWeight="Bold" Foreground="#DC3545"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 空数据提示 -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" 
                                Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}" Padding="20">
                            <TextBlock Text="请添加药材" HorizontalAlignment="Center" Foreground="#999999" FontStyle="Italic"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 备注信息 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="备注信息" Style="{StaticResource TitleTextStyle}"/>
                        <TextBox Text="{Binding Remark}" Style="{StaticResource InputTextBoxStyle}" 
                                 Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top" AcceptsReturn="True"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 保存指示器 -->
        <Grid Background="#80000000" Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" 
                        Width="200" Height="100" Opacity="0.95">
                <TextBlock Text="正在保存处方..." FontSize="14" Foreground="#333333" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                <ProgressBar Width="150" Height="4" IsIndeterminate="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>