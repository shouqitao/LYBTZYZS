<UserControl x:Class="LYBT.Desktop.Admin.Views.MedicalCaseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📂" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="医疗案例管理" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Medical Case Management" FontSize="12" Foreground="#B3D9F2" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ 新建案例" 
                        Command="{Binding AddCommand}"
                        Background="#28A745" Foreground="White"
                        Padding="10,5" Margin="0,0,5,0"/>
                
                <Button Content="✏️ 编辑" 
                        Command="{Binding EditCommand}"
                        Background="#FFC107" Foreground="White"
                        Padding="10,5" Margin="0,0,5,0"/>
                
                <Button Content="🗑️ 删除" 
                        Command="{Binding DeleteCommand}"
                        Background="#DC3545" Foreground="White"
                        Padding="10,5" Margin="0,0,5,0"/>
                
                <Button Content="🔄 刷新" 
                        Command="{Binding RefreshCommand}"
                        Background="#007BFF" Foreground="White"
                        Padding="10,5" Margin="0,0,20,0"/>
                
                <!-- 搜索框 -->
                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" 
                         Padding="5"
                         VerticalAlignment="Center"/>
                <Button Content="🔍 搜索" 
                        Command="{Binding SearchCommand}"
                        Background="#6C757D" Foreground="White"
                        Padding="10,5" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 数据列表 -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding MedicalCases}"
                  SelectedItem="{Binding SelectedMedicalCase}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F8F9FA"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="案例编号" Binding="{Binding CaseNumber}" Width="100"/>
                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                <DataGridTextColumn Header="患者性别" Binding="{Binding PatientGender}" Width="80"/>
                <DataGridTextColumn Header="患者年龄" Binding="{Binding PatientAge}" Width="80"/>
                <DataGridTextColumn Header="主诉" Binding="{Binding ChiefComplaint}" Width="200"/>
                <DataGridTextColumn Header="诊断" Binding="{Binding Diagnosis}" Width="150"/>
                <DataGridTextColumn Header="主治医生" Binding="{Binding DoctorName}" Width="100"/>
                <DataGridTextColumn Header="就诊时间" Binding="{Binding ConsultationTime, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页控件 -->
        <Border Grid.Row="3" Background="#F8F9FA" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="共 " VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" 条记录" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="首页" Command="{Binding FirstPageCommand}" Margin="2,0"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="2,0"/>
                    <TextBlock Text="第 " VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center"/>
                    <TextBlock Text=" / " VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center"/>
                    <TextBlock Text=" 页" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="2,0"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" Margin="2,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>