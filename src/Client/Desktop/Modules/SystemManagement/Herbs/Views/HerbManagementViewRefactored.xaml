<UserControl x:Class="LYBT.Desktop.Admin.Herbs.Views.HerbManagementViewRefactored"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:base="clr-namespace:LYBT.Desktop.Core.Views.Base;assembly=LYBT.Desktop.Core"
             xmlns:controls="clr-namespace:LYBT.WPF.Client.Controls.Herbs;assembly=LYBT.Desktop.Core"
             prism:ViewModelLocator.AutoWireViewModel="True">

<UserControl.Resources>
    <!-- 优化的中药材项目模板 -->
    <DataTemplate x:Key="OptimizedHerbItemTemplate">
        <Border Background="White" 
                BorderBrush="#E0E6ED" 
                BorderThickness="0"
                Padding="0"
                MinHeight="68">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 状态指示器 -->
                    <ColumnDefinition Width="180"/> <!-- 药材名称 -->
                    <ColumnDefinition Width="120"/> <!-- 规格 -->
                    <ColumnDefinition Width="100"/> <!-- 价格 -->
                    <ColumnDefinition Width="100"/> <!-- 库存 -->
                    <ColumnDefinition Width="60"/>  <!-- 单位 -->
                    <ColumnDefinition Width="*"/>   <!-- 描述/备注 -->
                    <ColumnDefinition Width="Auto"/> <!-- 操作按钮 -->
                </Grid.ColumnDefinitions>

                <!-- 状态指示器 -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="16,0,12,0">
                    <Ellipse Width="8" Height="8" 
                             Fill="{Binding IsEnabled, Converter={StaticResource BooleanToBrushConverter}}"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 药材名称 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" 
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding PinyinCode}" 
                               FontSize="11"
                               Foreground="#7F8C8D"
                               Margin="0,2,0,0"
                               Visibility="{Binding PinyinCode, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>

                <!-- 规格 -->
                <TextBlock Grid.Column="2" 
                           Text="{Binding Specification}" 
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#34495E"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Specification}"/>

                <!-- 价格 -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#E74C3C">
                        <Run Text="￥"/>
                        <Run Text="{Binding Price, StringFormat='{}{0:F2}'}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Unit, StringFormat='/ {0}'}" 
                               FontSize="11"
                               Foreground="#7F8C8D"/>
                </StackPanel>

                <!-- 库存 -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#27AE60">
                        <Run Text="{Binding CurrentStock, StringFormat='{}{0:F1}'}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Unit}" 
                               FontSize="11"
                               Foreground="#7F8C8D"/>
                </StackPanel>

                <!-- 单位 -->
                <TextBlock Grid.Column="5" 
                           Text="{Binding Unit}" 
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#7F8C8D"
                           HorizontalAlignment="Center"/>

                <!-- 描述/备注 -->
                <StackPanel Grid.Column="6" 
                            VerticalAlignment="Center" 
                            Margin="12,0">
                    <TextBlock Text="{Binding Description}" 
                               FontSize="12"
                               Foreground="#5D6D7E"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200"
                               ToolTip="{Binding Description}"
                               Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="7" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button Content="详情" 
                            Padding="8,4"
                            Margin="2"
                            FontSize="12"
                            BorderThickness="0"
                            Background="#3498DB"
                            Foreground="White"
                            Cursor="Hand"
                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="编辑" 
                            Padding="8,4"
                            Margin="2"
                            FontSize="12"
                            BorderThickness="0"
                            Background="#2ECC71"
                            Foreground="White"
                            Cursor="Hand"
                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</UserControl.Resources>
    
<base:BaseListView>
    
    <!-- 筛选内容 -->
    <base:BaseListView.FilterContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 状态筛选 -->
            <TextBlock Grid.Column="0" 
                       Text="状态："
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      Margin="0,0,20,0"/>
            
            <!-- 价格范围 -->
            <TextBlock Grid.Column="2"
                       Text="价格："
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <Grid Grid.Column="3" Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding MinPrice}"
                         VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="1" 
                           Text=" - "
                           VerticalAlignment="Center"
                           Margin="5,0"/>
                <TextBox Grid.Column="2"
                         Text="{Binding MaxPrice}"
                         VerticalContentAlignment="Center"/>
            </Grid>
            
            <!-- 库存状态 -->
            <TextBlock Grid.Column="4"
                       Text="库存："
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox Grid.Column="5"
                      ItemsSource="{Binding StockStatusOptions}"
                      SelectedItem="{Binding SelectedStockStatus}"/>
            
            <!-- 批量操作 -->
            <StackPanel Grid.Column="7" 
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <CheckBox Content="全选"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          IsChecked="{Binding IsAllSelected}"/>
                <Button Content="批量启用"
                        Padding="10,5"
                        Margin="0,0,5,0"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding BatchEnableCommand}"
                        Visibility="{Binding HasSelectedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="批量禁用"
                        Padding="10,5"
                        Background="#F44336"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding BatchDisableCommand}"
                        Visibility="{Binding HasSelectedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </base:BaseListView.FilterContent>
    
    <!-- 列表内容 -->
    <base:BaseListView.ListContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 列表标题栏 -->
            <Border Grid.Row="0" 
                    Background="#F0F7FF" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" 
                              IsChecked="{Binding IsAllSelected}"
                              VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="" Width="52"/>
                    <TextBlock Grid.Column="2" Text="药材名称" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="3" Text="规格" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="4" Text="价格" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="5" Text="库存" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="6" Text="单位" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="7" Text="" />
                    <TextBlock Grid.Column="8" Text="操作" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Width="150"/>
                </Grid>
            </Border>

            <!-- 高性能虚拟化中药材列表 -->
            <Border Grid.Row="1" Background="White">
                <!-- 使用虚拟化ListBox替代低性能ItemsControl -->
                <ListBox ItemsSource="{Binding Herbs}"
                         SelectedItem="{Binding SelectedHerb}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item"
                         VirtualizingPanel.CacheLengthUnit="Item"
                         VirtualizingPanel.CacheLength="20,20">
                    
                    <!-- 虚拟化面板配置 -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True"
                                                   VirtualizationMode="Recycling"
                                                   IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    
                    <!-- 列表项容器样式 -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8F9FA"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    
                    <!-- 优化的数据模板 -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- 选择框 -->
                                <CheckBox Grid.Column="0" 
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0"
                                          IsChecked="{Binding IsSelected}"/>
                                
                                <!-- 使用优化的中药材列表项控件 -->
                                <ContentPresenter Grid.Column="1" 
                                                  Content="{Binding}"
                                                  ContentTemplate="{StaticResource OptimizedHerbItemTemplate}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </base:BaseListView.ListContent>
</base:BaseListView>
</UserControl>