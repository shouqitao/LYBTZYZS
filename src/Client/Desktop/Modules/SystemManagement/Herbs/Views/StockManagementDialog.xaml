<Window x:Class="LYBT.Desktop.Admin.Herbs.Views.StockManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="库存管理" 
        Height="500" 
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        
        <Style TargetType="TextBox" x:Key="TextBoxStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        
        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="35"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="库存管理" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- 主要内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 药材基本信息 -->
                <GroupBox Header="药材信息" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="药材名称：" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Herb.Name}" 
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="规格：" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Herb.Specification}" 
                                   VerticalAlignment="Center" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="单位：" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Herb.Unit}" 
                                   VerticalAlignment="Center" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="单价：" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="5">
                            <Run Text="{Binding Herb.Price, StringFormat=F2}"/>
                            <Run Text="元"/>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="供应商：" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Herb.Supplier}" 
                                   VerticalAlignment="Center" Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="存储位置：" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Herb.StorageLocation}" 
                                   VerticalAlignment="Center" Margin="5"/>
                    </Grid>
                </GroupBox>

                <!-- 库存调整 -->
                <GroupBox Header="库存调整" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="当前库存：" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" 
                                    VerticalAlignment="Center" Margin="5">
                            <TextBlock Text="{Binding CurrentStock}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding Herb.Unit}" Margin="5,0"/>
                            <TextBlock Text="(预警阈值: " Foreground="Gray"/>
                            <TextBlock Text="{Binding Herb.LowStockThreshold}" Foreground="Gray"/>
                            <TextBlock Text="{Binding Herb.Unit}" Foreground="Gray"/>
                            <TextBlock Text=")" Foreground="Gray"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="调整数量：" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource TextBoxStyle}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="+10" 
                                Command="{Binding QuickAddCommand}" Style="{StaticResource ButtonStyle}"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="-10" 
                                Command="{Binding QuickReduceCommand}" Style="{StaticResource ButtonStyle}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="调整原因：" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource TextBoxStyle}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                    </Grid>
                </GroupBox>

                <!-- 调整预览 -->
                <GroupBox Header="调整预览">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="调整类型：" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AdjustmentType}" 
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AdjustmentType}" Value="入库">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AdjustmentType}" Value="出库">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="调整后库存：" Style="{StaticResource LabelStyle}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" 
                                    VerticalAlignment="Center" Margin="5">
                            <TextBlock Text="{Binding NewStock}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding Herb.Unit}" Margin="5,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="库存状态：" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StockStatusDescription}" 
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StockStatusDescription}" Value="库存不足">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StockStatusDescription}" Value="库存预警">
                                            <Setter Property="Foreground" Value="Orange"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StockStatusDescription}" Value="库存正常">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="保存调整" 
                    Command="{Binding SaveCommand}" 
                    Style="{StaticResource ButtonStyle}"
                    Background="#4CAF50" 
                    Foreground="White"/>
            <Button Content="取消" 
                    Command="{Binding CancelCommand}" 
                    Style="{StaticResource ButtonStyle}"
                    Background="#f44336" 
                    Foreground="White"/>
        </StackPanel>

        <!-- 加载指示器 -->
        <Grid Grid.Row="0" Grid.RowSpan="3" 
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,10"/>
                <TextBlock Text="正在处理..." Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>