<!--
    UserMasterDetailControl - 用户Master-Detail控件
    OpenSpec: refactor-admin-workspace

    可复用业务控件，供Admin角色台使用
    从UserMasterDetailView重构而来
    为保持架构一致性，采用Control模式
-->
<controls:MasterDetailControlBase x:Class="LYBT.Desktop.Users.Controls.UserMasterDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
             xmlns:userControls="clr-namespace:LYBT.Desktop.Users.Controls">

    <controls:MasterDetailControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:MasterDetailControlBase.Resources>

    <controls:MasterDetailLayout HasSelection="{Binding HasSelection}">
        <!-- ========================================
             Master区域: 用户列表
             ======================================== -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <controls:DataGridToolbar Grid.Row="0"
                                          CreateCommand="{Binding CreateNewCommand}"
                                          RefreshCommand="{Binding RefreshCommand}"
                                          ExportCommand="{Binding ExportCommand}"
                                          BatchDeleteCommand="{Binding DeleteCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="导入"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ImportCommand}"
                                    Padding="12,6"
                                    Margin="4,0,0,0"/>
                            <Button Content="模板"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DownloadTemplateCommand}"
                                    Padding="12,6"
                                    Margin="4,0,0,0"/>
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!-- 搜索和筛选 -->
                <Grid Grid.Row="1" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索框 -->
                    <controls:SearchBox Grid.Row="0"
                                        SearchText="{Binding SearchText, Mode=TwoWay}"
                                        SearchCommand="{Binding SearchCommand}"
                                        Placeholder="搜索用户名/姓名..."/>

                    <!-- 筛选条件 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding SelectedRoleFilter}"
                                  Width="100"
                                  Margin="0,0,8,0"
                                  Text="全部角色"
                                  IsEditable="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Width="100"
                                  Margin="0,0,8,0"
                                  Text="全部状态"
                                  IsEditable="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="显示已禁用"
                                  IsChecked="{Binding ShowInactiveUsers}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <Button Content="清除筛选"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearFiltersCommand}"
                                Padding="8,2"/>
                    </StackPanel>
                </Grid>

                <!-- 用户列表 -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                          behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                          Style="{StaticResource MasterDetailDataGridStyle}"
                          RowHeaderWidth="0"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <!-- 用户名 -->
                        <DataGridTextColumn Header="用户名"
                                            Binding="{Binding UserName}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 真实姓名 -->
                        <DataGridTextColumn Header="姓名"
                                            Binding="{Binding RealName}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 角色 -->
                        <DataGridTextColumn Header="角色"
                                            Binding="{Binding Role, Converter={StaticResource EnumDescriptionConverter}}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 状态 -->
                        <DataGridTemplateColumn Header="状态" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 手机号 -->
                        <DataGridTextColumn Header="手机号"
                                            Binding="{Binding PhoneNumber}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <!-- 行右键菜单 -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑" Command="{Binding EditCommand}"/>
                            <Separator/>
                            <MenuItem Header="重置密码" Command="{Binding ResetPasswordCommand}"/>
                            <MenuItem Header="切换状态" Command="{Binding ToggleUserStatusCommand}"/>
                            <MenuItem Header="恢复" Command="{Binding RestoreCommand}"/>
                            <Separator/>
                            <MenuItem Header="审计日志" Command="{Binding ShowAuditLogCommand}"/>
                            <Separator/>
                            <MenuItem Header="删除" Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- 分页控件 -->
                <Border Grid.Row="3" Style="{StaticResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Medium"/>
                            <Run Text="条记录"/>
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="每页" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding PageSizes}"
                                      SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                      Width="60"
                                      Margin="6,0"
                                      VerticalAlignment="Center"
                                      IsEditable="False"/>
                            <TextBlock Text="条" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="首页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToFirstPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="上一页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToPreviousPageCommand}"
                                    Margin="0,0,4,0"/>
                            <TextBlock Style="{StaticResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="下一页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToNextPageCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="末页"
                                    Style="{StaticResource MasterDetailPaginationButtonStyle}"
                                    Command="{Binding GoToLastPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="4"
                                         IsLoading="{Binding IsLoading}"
                                         LoadingText="{Binding BusyMessage}"/>
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!-- ========================================
             Detail区域: 用户详情/编辑
             ======================================== -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 详情工具栏 -->
                <controls:DetailToolbar Grid.Row="0"
                                        Title="{Binding DetailTitle}"
                                        IsEditMode="{Binding IsEditMode}"
                                        EditCommand="{Binding EditCommand}"
                                        SaveCommand="{Binding SaveCommand}"
                                        CancelCommand="{Binding CancelCommand}"
                                        DeleteCommand="{Binding DeleteCommand}"/>

                <!-- 查看模式内容 -->
                <userControls:UserViewControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    UserName="{Binding CurrentDetail.UserName}"
                    RealName="{Binding CurrentDetail.RealName}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode}"
                    PhoneNumber="{Binding CurrentDetail.PhoneNumber}"
                    Email="{Binding CurrentDetail.Email}"
                    Role="{Binding CurrentDetail.Role}"
                    Status="{Binding CurrentDetail.Status}"
                    LastLoginTime="{Binding CurrentDetail.LastLoginTime}"
                    CreatedAt="{Binding CurrentDetail.CreatedAt}"
                    UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                    ShowStatus="True"
                    Margin="16"/>

                <!-- 编辑模式内容 -->
                <userControls:UserEditControl
                    Grid.Row="1"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    UserName="{Binding CurrentDetail.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsUserNameReadOnly="{Binding IsUserNameReadOnly}"
                    RealName="{Binding CurrentDetail.RealName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PhoneNumber="{Binding CurrentDetail.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Email="{Binding CurrentDetail.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Role="{Binding CurrentDetail.Role, Mode=TwoWay}"
                    RoleOptions="{Binding RoleOptions}"
                    Status="{Binding CurrentDetail.Status, Mode=TwoWay}"
                    StatusOptions="{Binding StatusOptions}"
                    ErrorsSource="{Binding CurrentDetail.Errors}"
                    ShowStatus="True"
                    Margin="16"/>

                <!-- 详情加载遮罩 -->
                <controls:LoadingOverlay Grid.RowSpan="2"
                                         IsLoading="{Binding IsBusy}"
                                         LoadingText="加载详情中..."/>
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!-- ========================================
             空状态: 未选中用户时显示
             ======================================== -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择用户"
                Subtitle="从左侧列表中选择一位用户查看详情，或点击新增按钮创建新用户"
                ActionText="新增用户"
                ActionCommand="{Binding CreateNewCommand}"/>
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
