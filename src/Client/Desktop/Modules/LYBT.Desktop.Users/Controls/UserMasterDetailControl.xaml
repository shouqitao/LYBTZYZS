<!--
    UserMasterDetailControl - 用户Master-Detail控件
    
    可复用业务控件，供Admin角色台使用
    从UserMasterDetailView重构而来
    为保持架构一致性，采用Control模式
-->
<controls:MasterDetailControlBase
    x:Class="LYBT.Desktop.Users.Controls.UserMasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Controls.Controls;assembly=LYBT.Desktop.Controls"
    xmlns:converters="clr-namespace:LYBT.Desktop.Controls.Converters;assembly=LYBT.Desktop.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:userControls="clr-namespace:LYBT.Desktop.Users.Controls"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        资源加载说明:
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}">
        <!--
            ========================================
            Master区域: 用户列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  工具栏  -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    BatchDeleteCommand="{Binding DeleteCommand}"
                    BatchEnableCommand="{Binding BatchEnableCommand}"
                    BatchDisableCommand="{Binding BatchDisableCommand}"
                    CreateCommand="{Binding CreateNewCommand}"
                    ExportCommand="{Binding ExportCommand}"
                    RefreshCommand="{Binding RefreshCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <!--  主操作  -->
                            <Button
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Command="{Binding EditCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="编辑">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="编辑" />
                                </StackPanel>
                            </Button>
                            <materialDesign:PopupBox
                                Margin="8,0,0,0"
                                ToolTip="更多操作">
                                <StackPanel>
                                    <Button Command="{Binding ResetPasswordCommand}" Content="重置密码" Padding="16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Command="{Binding ToggleUserStatusCommand}" Content="切换状态" Padding="16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Command="{Binding RestoreCommand}" Content="恢复" Padding="16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Separator />
                                    <Button Command="{Binding ImportCommand}" Content="导入" Padding="16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Command="{Binding DownloadTemplateCommand}" Content="下载模板" Padding="16,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!--  搜索和筛选  -->
                <Grid Grid.Row="1" Margin="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  搜索框  -->
                    <controls:SearchBox
                        Grid.Row="0"
                        Placeholder="搜索用户名/姓名..."
                        SearchCommand="{Binding SearchCommand}"
                        SearchText="{Binding SearchText, Mode=TwoWay}" />

                    <!--  筛选条件  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
                        <ComboBox
                            MinWidth="120"
                            Margin="8,0,0,0"
                            IsEditable="False"
                            ItemsSource="{Binding RoleOptions}"
                            SelectedItem="{Binding SelectedRoleFilter}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="全部角色">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox
                            MinWidth="120"
                            Margin="8,0,0,0"
                            IsEditable="False"
                            ItemsSource="{Binding StatusOptions}"
                            SelectedItem="{Binding SelectedStatusFilter}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            Text="全部状态">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Content="显示已禁用"
                            IsChecked="{Binding ShowInactiveUsers}"
                            Style="{StaticResource MaterialDesignCheckBox}" />
                        <Button
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Command="{Binding ClearFiltersCommand}"
                            Content="清除筛选"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                    <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,0" Background="{DynamicResource MaterialDesign.Brush.Outline}" Opacity="0.2" />
                </Grid>

                <!--  用户列表  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    BorderThickness="0"
                    Background="Transparent"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <!--  用户名  -->
                        <DataGridTextColumn
                            Width="*" MinWidth="80"
                            Binding="{Binding UserName}"
                            Header="用户名"
                            ElementStyle="{StaticResource DataGridEmphasisCellStyle}" />

                        <!--  真实姓名  -->
                        <DataGridTextColumn
                            Width="*" MinWidth="60"
                            Binding="{Binding RealName}"
                            Header="姓名"
                            ElementStyle="{StaticResource DataGridTextCellStyle}" />

                        <!--  角色  -->
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Role, Converter={x:Static converters:Cvt.EnumDesc}}"
                            Header="角色"
                            ElementStyle="{StaticResource DataGridSecondaryCellStyle}" />

                        <!--  状态  -->
                        <DataGridTemplateColumn Width="Auto" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  手机号  -->
                        <DataGridTextColumn
                            Width="*" MinWidth="100"
                            Binding="{Binding PhoneNumber}"
                            Header="手机号"
                            ElementStyle="{StaticResource DataGridMonoCellStyle}" />
                    </DataGrid.Columns>

                    <!--  右键菜单 - 分组优化：查看/编辑 | 用户管理 | 危险操作  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <!--  查看与编辑组  -->
                            <MenuItem Command="{Binding EditCommand}" Header="编辑">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Pencil" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  用户管理操作组  -->
                            <MenuItem Command="{Binding ResetPasswordCommand}" Header="重置密码">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Key" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding ToggleUserStatusCommand}" Header="切换状态">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ToggleSwitchOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding RestoreCommand}" Header="恢复用户">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Undo" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  危险操作组  -->
                            <MenuItem Command="{Binding DeleteCommand}" Header="删除">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete" Foreground="{DynamicResource MaterialDesign.Brush.Error}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件  -->
                <controls:UnifiedPaginationBar
                    Grid.Row="3"
                    CurrentPage="{Binding CurrentPage}"
                    TotalPages="{Binding TotalPages}"
                    PageSize="{Binding PageSize}"
                    TotalCount="{Binding TotalCount}"
                    PageSizes="{Binding PageSizes}"
                    FirstPageCommand="{Binding GoToFirstPageCommand}"
                    PreviousPageCommand="{Binding GoToPreviousPageCommand}"
                    NextPageCommand="{Binding GoToNextPageCommand}"
                    LastPageCommand="{Binding GoToLastPageCommand}" />

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 用户详情/编辑
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  详情内容（Transitioner 切换查看/编辑）  -->
                <materialDesign:Transitioner
                    Grid.Row="1"
                    SelectedIndex="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToInt}}">
                    <materialDesign:TransitionerSlide>
                        <userControls:UserViewControl
                            Margin="20"
                            CreatedAt="{Binding CurrentDetail.CreatedAt}"
                            Email="{Binding CurrentDetail.Email}"
                            LastLoginTime="{Binding CurrentDetail.LastLoginTime}"
                            PhoneNumber="{Binding CurrentDetail.PhoneNumber}"
                            PinYinCode="{Binding CurrentDetail.PinYinCode}"
                            RealName="{Binding CurrentDetail.RealName}"
                            Role="{Binding CurrentDetail.Role}"
                            ShowStatus="True"
                            Status="{Binding CurrentDetail.Status}"
                            UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                            UserName="{Binding CurrentDetail.UserName}" />
                    </materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide>
                        <userControls:UserEditControl
                            Margin="20"
                            User="{Binding UserEditor.User}"
                            ErrorsSource="{Binding UserEditor.User.Errors}"
                            IsUserNameReadOnly="{Binding IsUserNameReadOnly}"
                            ShowStatus="True"
                            RoleOptions="{Binding RoleOptions}"
                            StatusOptions="{Binding StatusOptions}" />
                    </materialDesign:TransitionerSlide>
                </materialDesign:Transitioner>

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="2"
                    IsLoading="{Binding IsBusy}"
                    LoadingText="正在处理..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选择用户时显示
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择用户"
                ActionCommand="{Binding CreateNewCommand}"
                ActionText="新增用户"
                Subtitle="在左侧列表中选择一位用户查看详情，或点击新增按钮创建用户" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
