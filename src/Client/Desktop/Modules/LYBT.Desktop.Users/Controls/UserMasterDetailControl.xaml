<!--
    UserMasterDetailControl - 用户Master-Detail控件
    OpenSpec: refactor-admin-workspace
    
    可复用业务控件，供Admin角色台使用
    从UserMasterDetailView重构而来
    为保持架构一致性，采用Control模式
-->
<controls:MasterDetailControlBase
    x:Class="LYBT.Desktop.Users.Controls.UserMasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LYBT.Desktop.Infrastructure.Behaviors;assembly=LYBT.Desktop.Infrastructure"
    xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
    xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:userControls="clr-namespace:LYBT.Desktop.Users.Controls">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <controls:MasterDetailLayout HasSelection="{Binding ShowDetailPanel}">
        <!--
            ========================================
            Master区域: 用户列表
            ========================================
        -->
        <controls:MasterDetailLayout.MasterContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  工具栏  -->
                <controls:DataGridToolbar
                    Grid.Row="0"
                    BatchDeleteCommand="{Binding DeleteCommand}"
                    CreateCommand="{Binding CreateNewCommand}"
                    ExportCommand="{Binding ExportCommand}"
                    RefreshCommand="{Binding RefreshCommand}">
                    <controls:DataGridToolbar.AdditionalContent>
                        <StackPanel Orientation="Horizontal">
                            <!--  常用操作组  -->
                            <Button
                                Margin="4,0,0,0"
                                Padding="12,6"
                                Command="{Binding EditCommand}"
                                Content="编辑"
                                Style="{DynamicResource SecondaryButton}" />
                            <Button
                                Margin="4,0,0,0"
                                Padding="12,6"
                                Command="{Binding ResetPasswordCommand}"
                                Content="重置密码"
                                Style="{DynamicResource SecondaryButton}" />
                            <Button
                                Margin="4,0,0,0"
                                Padding="12,6"
                                Command="{Binding ToggleUserStatusCommand}"
                                Content="切换状态"
                                Style="{DynamicResource SecondaryButton}" />
                            <Button
                                Margin="4,0,0,0"
                                Padding="12,6"
                                Command="{Binding RestoreCommand}"
                                Content="恢复"
                                Style="{DynamicResource SecondaryButton}" />
                            <!--  分隔  -->
                            <Separator Margin="8,0" Style="{DynamicResource {x:Static ToolBar.SeparatorStyleKey}}" />
                            <!--  批量操作组  -->
                            <Button
                                Margin="4,0,0,0"
                                Padding="12,6"
                                Command="{Binding ImportCommand}"
                                Content="导入"
                                Style="{DynamicResource SecondaryButton}" />
                            <Button
                                Margin="4,0,0,0"
                                Padding="12,6"
                                Command="{Binding DownloadTemplateCommand}"
                                Content="模板"
                                Style="{DynamicResource SecondaryButton}" />
                        </StackPanel>
                    </controls:DataGridToolbar.AdditionalContent>
                </controls:DataGridToolbar>

                <!--  搜索和筛选  -->
                <Grid Grid.Row="1" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  搜索框  -->
                    <controls:SearchBox
                        Grid.Row="0"
                        Placeholder="搜索用户名/姓名..."
                        SearchCommand="{Binding SearchCommand}"
                        SearchText="{Binding SearchText, Mode=TwoWay}" />

                    <!--  筛选条件  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
                        <ComboBox
                            Width="100"
                            Margin="0,0,8,0"
                            IsEditable="False"
                            ItemsSource="{Binding RoleOptions}"
                            SelectedItem="{Binding SelectedRoleFilter}"
                            Text="全部角色">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox
                            Width="100"
                            Margin="0,0,8,0"
                            IsEditable="False"
                            ItemsSource="{Binding StatusOptions}"
                            SelectedItem="{Binding SelectedStatusFilter}"
                            Text="全部状态">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Content="显示已禁用"
                            IsChecked="{Binding ShowInactiveUsers}" />
                        <Button
                            Padding="8,2"
                            Command="{Binding ClearFiltersCommand}"
                            Content="清除筛选"
                            Style="{DynamicResource SecondaryButton}" />
                    </StackPanel>
                </Grid>

                <!--  用户列表  -->
                <DataGrid
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    behaviors:DataGridSelectionBehavior.SelectedItems="{Binding SelectedItems, Mode=OneWay}"
                    behaviors:DataGridSelectionBehavior.ShowCheckBoxColumn="True"
                    ItemsSource="{Binding Items}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Style="{DynamicResource MasterDetailDataGridStyle}">
                    <DataGrid.Columns>
                        <!--  用户名  -->
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding UserName}"
                            Header="用户名">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!--  真实姓名  -->
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding RealName}"
                            Header="姓名">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!--  角色  -->
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Role, Converter={x:Static converters:Cvt.EnumDesc}}"
                            Header="角色">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!--  状态  -->
                        <DataGridTemplateColumn Width="70" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusBadge Status="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  手机号  -->
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding PhoneNumber}"
                            Header="手机号">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <!--  右键菜单 - 分组优化：查看/编辑 | 用户管理 | 危险操作  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <!--  查看与编辑组  -->
                            <MenuItem Command="{Binding EditCommand}" Header="编辑">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70F;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  用户管理操作组  -->
                            <MenuItem Command="{Binding ResetPasswordCommand}" Header="重置密码">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72E;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding ToggleUserStatusCommand}" Header="切换状态">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8FB;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding RestoreCommand}" Header="恢复用户">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7A7;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--  危险操作组  -->
                            <MenuItem Command="{Binding DeleteCommand}" Header="删除">
                                <MenuItem.Icon>
                                    <TextBlock
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        Foreground="{DynamicResource ErrorBrush}"
                                        Text="&#xE74D;" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!--  分页控件  -->
                <Border Grid.Row="3" Style="{DynamicResource MasterDetailPaginationPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{DynamicResource MasterDetailPaginationInfoStyle}">
                            <Run Text="共" />
                            <Run FontWeight="Medium" Text="{Binding TotalCount, Mode=OneWay}" />
                            <Run Text="条记录" />
                        </TextBlock>

                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="每页" />
                            <ComboBox
                                Width="60"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                IsEditable="False"
                                ItemsSource="{Binding PageSizes}"
                                SelectedItem="{Binding PageSize, Mode=TwoWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="条" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToFirstPageCommand}"
                                Content="首页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToPreviousPageCommand}"
                                Content="上一页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <TextBlock Style="{DynamicResource MasterDetailPaginationPageStyle}">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding TotalPages, Mode=OneWay}" />
                            </TextBlock>
                            <Button
                                Margin="0,0,4,0"
                                Command="{Binding GoToNextPageCommand}"
                                Content="下一页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                            <Button
                                Command="{Binding GoToLastPageCommand}"
                                Content="末页"
                                Style="{DynamicResource MasterDetailPaginationButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="4"
                    IsLoading="{Binding IsLoading}"
                    LoadingText="{Binding BusyMessage}" />
            </Grid>
        </controls:MasterDetailLayout.MasterContent>

        <!--
            ========================================
            Detail区域: 用户详情/编辑
            ========================================
        -->
        <controls:MasterDetailLayout.DetailContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  详情工具栏  -->
                <controls:DetailToolbar
                    Title="{Binding DetailTitle}"
                    Grid.Row="0"
                    CancelCommand="{Binding CancelCommand}"
                    DeleteCommand="{Binding DeleteCommand}"
                    EditCommand="{Binding EditCommand}"
                    IsEditMode="{Binding IsEditMode}"
                    SaveCommand="{Binding SaveCommand}" />

                <!--  查看模式内容  -->
                <userControls:UserViewControl
                    Grid.Row="1"
                    Margin="16"
                    CreatedAt="{Binding CurrentDetail.CreatedAt}"
                    Email="{Binding CurrentDetail.Email}"
                    LastLoginTime="{Binding CurrentDetail.LastLoginTime}"
                    PhoneNumber="{Binding CurrentDetail.PhoneNumber}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode}"
                    RealName="{Binding CurrentDetail.RealName}"
                    Role="{Binding CurrentDetail.Role}"
                    ShowStatus="True"
                    Status="{Binding CurrentDetail.Status}"
                    UpdatedAt="{Binding CurrentDetail.UpdatedAt}"
                    UserName="{Binding CurrentDetail.UserName}"
                    Visibility="{Binding IsEditMode, Converter={x:Static converters:Cvt.InverseBoolToVis}}" />

                <!--  编辑模式内容  -->
                <userControls:UserEditControl
                    Grid.Row="1"
                    Margin="16"
                    Email="{Binding CurrentDetail.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ErrorsSource="{Binding CurrentDetail.Errors}"
                    IsUserNameReadOnly="{Binding IsUserNameReadOnly}"
                    PhoneNumber="{Binding CurrentDetail.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PinYinCode="{Binding CurrentDetail.PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    RealName="{Binding CurrentDetail.RealName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Role="{Binding CurrentDetail.Role, Mode=TwoWay}"
                    RoleOptions="{Binding RoleOptions}"
                    ShowStatus="True"
                    Status="{Binding CurrentDetail.Status, Mode=TwoWay}"
                    StatusOptions="{Binding StatusOptions}"
                    UserName="{Binding CurrentDetail.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Remark="{Binding CurrentDetail.Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding IsEditMode, Converter={x:Static converters:Cvt.BoolToVis}}" />

                <!--  详情加载遮罩  -->
                <controls:LoadingOverlay
                    Grid.RowSpan="2"
                    IsLoading="{Binding IsBusy}"
                    LoadingText="正在处理..." />
            </Grid>
        </controls:MasterDetailLayout.DetailContent>

        <!--
            ========================================
            空状态: 未选择用户时显示
            ========================================
        -->
        <controls:MasterDetailLayout.EmptyContent>
            <controls:EmptyState
                Title="请选择用户"
                ActionCommand="{Binding CreateNewCommand}"
                ActionText="新增用户"
                Subtitle="在左侧列表中选择一位用户查看详情，或点击新增按钮创建用户" />
        </controls:MasterDetailLayout.EmptyContent>
    </controls:MasterDetailLayout>
</controls:MasterDetailControlBase>
