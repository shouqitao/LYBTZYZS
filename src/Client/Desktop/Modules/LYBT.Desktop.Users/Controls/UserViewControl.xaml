<!--
    UserViewControl - 用户预览控件
    OpenSpec: extract-detail-controls Task 4.1
    OpenSpec: optimize-preview-layout - 优化布局和视觉层次

    独立的用户预览控件，可在UserDetailView和其他需要展示用户信息的地方复用
    通过DependencyProperty接收数据，支持只读展示
-->
<UserControl x:Class="LYBT.Desktop.Users.Controls.UserViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <infrastructure:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 用户信息卡片 - 紧凑布局 -->
        <controls:InfoCard ShowTitle="False">
            <controls:InfoCard.Content>
                <StackPanel>
                    <!-- 头部: 用户名 + 真实姓名 + 状态Badge -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding UserName}" Style="{StaticResource PreviewTitleStyle}"/>
                            <TextBlock Text="{Binding RealName, StringFormat=({0})}"
                                       Style="{StaticResource PreviewSubtitleStyle}"
                                       Visibility="{Binding RealName, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Style="{StaticResource PreviewBadgeSuccessStyle}"
                                Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource PreviewBadgeTextStyle}"/>
                        </Border>
                    </Grid>

                    <!-- 紧凑信息区 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="角色：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="1" Text="{Binding Role}" FontSize="13" Margin="0,0,20,0"/>
                        <TextBlock Grid.Column="2" Text="手机：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="3" Text="{Binding PhoneNumber}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,0,0,6"
                          Visibility="{Binding Email, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="邮箱：" FontSize="13" Foreground="#605E5C"/>
                        <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
