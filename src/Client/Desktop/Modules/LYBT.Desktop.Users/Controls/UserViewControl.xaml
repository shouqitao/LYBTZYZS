<!--
    UserViewControl - 用户预览控件
    OpenSpec: extract-detail-controls Task 4.1
    OpenSpec: optimize-preview-layout - 优化布局和视觉层次
    OpenSpec: refactor-master-detail-layout - 详情区域UI优化

    独立的用户预览控件，可在UserDetailView和其他需要展示用户信息的地方复用
    通过DependencyProperty接收数据，支持只读展示

    UI优化 (2025-12-16):
    - 采用多卡片分组布局，充分利用详情区域空间
    - 分为：基本信息、联系信息、系统信息三个逻辑区域
    - 添加：拼音码、最后登录时间、创建/更新时间字段
-->
<UserControl x:Class="LYBT.Desktop.Users.Controls.UserViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!-- 转换器已统一到Infrastructure/Converters.xaml (OpenSpec: consolidate-wpf-converters) -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LYBT.Desktop.Infrastructure;component/Themes/UnifiedComponents.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding ElementName=Root}">
        <StackPanel>
            <!-- ========================================
                 基本信息卡片
                 ======================================== -->
            <controls:InfoCard Title="基本信息" ShowTitle="True">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 用户名 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="用户名" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserName}" Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold"/>

                        <!-- 真实姓名 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="真实姓名" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding RealName}" Style="{StaticResource DetailValueStyle}"/>

                        <!-- 拼音码 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="拼音码" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PinYinCode, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}" FontFamily="Consolas"/>

                        <!-- 用户角色 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="用户角色" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="{Binding Role, Converter={StaticResource EnumDescriptionConverter}}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <!-- 账户状态 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="账户状态" Style="{StaticResource DetailLabelStyle}"
                                   Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <controls:StatusBadge Grid.Row="2" Grid.Column="1"
                                              Status="{Binding Status}"
                                              HorizontalAlignment="Left"
                                              Margin="0,4,0,4"
                                              Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 联系信息卡片
                 ======================================== -->
            <controls:InfoCard Title="联系信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 手机号码 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="手机号码" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PhoneNumber, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}" FontFamily="Consolas"/>

                        <!-- 邮箱地址 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="邮箱地址" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" Text="{Binding Email, TargetNullValue='-'}" Style="{StaticResource DetailValueStyle}" TextWrapping="Wrap"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>

            <!-- ========================================
                 系统信息卡片
                 ======================================== -->
            <controls:InfoCard Title="系统信息" ShowTitle="True" Margin="0,12,0,0">
                <controls:InfoCard.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 最后登录时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最后登录" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding LastLoginTime, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='从未登录'}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <!-- 创建时间 -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="创建时间" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                   Style="{StaticResource DetailValueStyle}"/>

                        <!-- 更新时间 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="更新时间" Style="{StaticResource DetailLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='-'}"
                                   Style="{StaticResource DetailValueStyle}"/>
                    </Grid>
                </controls:InfoCard.Content>
            </controls:InfoCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
