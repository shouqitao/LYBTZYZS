<!--
    UserEditControl - 用户编辑控件
    OpenSpec: extract-detail-controls Task 4.2

    独立的用户编辑控件，可在UserDetailView中复用
    通过DependencyProperty接收数据，支持双向绑定
-->
<UserControl x:Class="LYBT.Desktop.Users.Controls.UserEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:converters="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             x:Name="Root">

    <!--
        资源加载说明 (OpenSpec: cleanup-control-resource-merging):
        - 不要在控件级别合并 UnifiedComponents.xaml，避免资源重复加载
        - 样式/转换器通过 DynamicResource 引用 App 级别已加载的资源
        - 此控件无本地资源，所有样式来自全局
    -->

    <StackPanel DataContext="{Binding ElementName=Root}">
        <!-- 用户信息卡片 -->
        <controls:InfoCard Title="用户信息">
            <controls:InfoCard.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：用户名、真实姓名 -->
                    <!-- OpenSpec: ui-validation-framework - 添加验证绑定 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Style="{DynamicResource FormLabelStyle}">
                            <Run Text="用户名"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                        </TextBlock>
                        <TextBox TabIndex="1" Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 IsReadOnly="{Binding IsUserNameReadOnly}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[UserName]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Style="{DynamicResource FormLabelStyle}">
                            <Run Text="真实姓名"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                        </TextBlock>
                        <TextBox TabIndex="2" Text="{Binding RealName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[RealName]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <!-- 第二行：拼音码、手机号码 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="拼音码（可修正）" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="3" Text="{Binding PinYinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource EditableTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"
                                 ToolTip="自动根据真实姓名生成，如有多音字错误可手动修正"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Text="手机号码" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="4" Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[PhoneNumber]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <!-- 第三行：邮箱地址、用户角色 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                        <TextBlock Text="邮箱地址" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox TabIndex="5" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{DynamicResource ValidatingTextBoxStyle}"
                                 MinHeight="44"
                                 Padding="12,10"/>
                        <TextBlock Text="{Binding ErrorsSource[Email]}"
                                   Style="{DynamicResource ValidationErrorMessageVisibleStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                        <TextBlock Style="{DynamicResource FormLabelStyle}">
                            <Run Text="用户角色"/><Run Text=" *" Style="{DynamicResource RequiredIndicatorStyle}"/>
                        </TextBlock>
                        <ComboBox TabIndex="6" SelectedItem="{Binding Role, Mode=TwoWay}"
                                  ItemsSource="{Binding RoleOptions}"
                                  MinHeight="44"
                                  Padding="12,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- 第四行：账户状态 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,20"
                                Visibility="{Binding ShowStatus, Converter={x:Static converters:Cvt.BoolToVis}}">
                        <TextBlock Text="账户状态" Style="{DynamicResource FormLabelStyle}"/>
                        <ComboBox TabIndex="7" SelectedItem="{Binding Status, Mode=TwoWay}"
                                  ItemsSource="{Binding StatusOptions}"
                                  MinHeight="44"
                                  Padding="12,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:Cvt.EnumDesc}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </controls:InfoCard.Content>
        </controls:InfoCard>

        <!-- 备注卡片 -->
        <controls:InfoCard Title="备注">
            <controls:InfoCard.Content>
                <TextBox TabIndex="8" Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource EditableTextBoxStyle}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MinHeight="60"
                         Padding="12,10"/>
            </controls:InfoCard.Content>
        </controls:InfoCard>
    </StackPanel>
</UserControl>
