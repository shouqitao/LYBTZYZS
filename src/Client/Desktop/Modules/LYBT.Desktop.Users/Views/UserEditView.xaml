<UserControl x:Class="LYBT.Desktop.Users.Views.UserEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- 使用统一设计系统样式 -->
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarContainer}">
            <TextBlock Text="编辑用户" Style="{StaticResource TitleText}" />
        </Border>

        <!-- 表单区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" MaxWidth="600" Margin="20">
                <StackPanel>
                    <!-- 用户名（只读） -->
                    <TextBlock Text="用户名" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding UserName, Mode=OneWay}"
                             Style="{StaticResource InputTextBox}"
                             IsReadOnly="True"
                             Background="#F5F5F5"
                             Margin="0,5,0,5" />

                    <!-- 真实姓名 -->
                    <TextBlock Text="真实姓名 *" Style="{StaticResource LabelText}" Margin="0,15,0,0" />
                    <TextBox Text="{Binding RealName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             Margin="0,5,0,5" />
                    <TextBlock Text="{Binding Errors[RealName]}"
                               Style="{StaticResource ValidationErrorText}"
                               Visibility="{Binding HasErrors[RealName], Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- 手机号码 -->
                    <TextBlock Text="手机号码" Style="{StaticResource LabelText}" Margin="0,15,0,0" />
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             Margin="0,5,0,5" />
                    <TextBlock Text="{Binding Errors[PhoneNumber]}"
                               Style="{StaticResource ValidationErrorText}"
                               Visibility="{Binding HasErrors[PhoneNumber], Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- 邮箱地址 -->
                    <TextBlock Text="邮箱地址" Style="{StaticResource LabelText}" Margin="0,15,0,0" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             Margin="0,5,0,5" />
                    <TextBlock Text="{Binding Errors[Email]}"
                               Style="{StaticResource ValidationErrorText}"
                               Visibility="{Binding HasErrors[Email], Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- 用户角色 -->
                    <TextBlock Text="用户角色 *" Style="{StaticResource LabelText}" Margin="0,15,0,0" />
                    <ComboBox ItemsSource="{Binding RoleOptions}"
                              SelectedValue="{Binding SelectedRole}"
                              Style="{StaticResource InputComboBox}"
                              Margin="0,5,0,5" />

                    <!-- 用户状态 -->
                    <TextBlock Text="用户状态 *" Style="{StaticResource LabelText}" Margin="0,15,0,0" />
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedValue="{Binding Status}"
                              Style="{StaticResource InputComboBox}"
                              Margin="0,5,0,5" />

                    <!-- 重置密码按钮 -->
                    <Border BorderBrush="#FFC107" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="⚠️ 密码管理" FontWeight="Bold" Foreground="#FFC107" />
                            <TextBlock Text="如需重置用户密码，请点击下方按钮"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="0,5,0,10" />
                            <Button Content="重置密码"
                                    Style="{StaticResource WarningButton}"
                                    Command="{Binding ResetPasswordCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- 变更提示 -->
                    <Border Background="#E3F2FD"
                            BorderBrush="#2196F3"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,15,0,0"
                            Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="您有未保存的更改"
                                       Foreground="#1976D2"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <Border Grid.Row="2" Style="{StaticResource ToolBarContainer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="重置表单"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Command="{Binding ResetCommand}" />
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="保存修改"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>

        <!-- 加载遮罩 -->
        <Grid Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Background="Transparent"
                             Foreground="White" />
                <TextBlock Text="正在保存..."
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
