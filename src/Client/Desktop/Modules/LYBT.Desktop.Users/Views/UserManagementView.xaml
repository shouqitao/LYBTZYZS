<!--
    UserManagementView - 用户管理视图
    Issue #1999 - Task 2.6: 应用BaseMasterDataListView模板

    重构说明：
    - 使用 BaseMasterDataListView 替代原有的三行布局
    - 移除重复的工具栏、数据表格、分页控件代码
    - 通过 Columns 和 ActionButtons 属性定义用户特定内容
-->
<UserControl x:Class="LYBT.Desktop.Users.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:LYBT.Desktop.Infrastructure.Views;assembly=LYBT.Desktop.Infrastructure"
             xmlns:controls="clr-namespace:LYBT.Desktop.Infrastructure.Controls;assembly=LYBT.Desktop.Infrastructure"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- 转换器资源 -->
        <infrastructure:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>

    <!-- Issue #1999: 应用 BaseMasterDataListView 模板 -->
    <views:BaseMasterDataListView
        ItemsSource="{Binding Items}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        SelectedItems="{Binding SelectedItems, Mode=TwoWay}"
        ShowCheckBoxColumn="True"
        SearchText="{Binding SearchText, Mode=TwoWay}"
        SearchCommand="{Binding SearchCommand}"
        CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
        TotalPages="{Binding TotalPages}"
        PageSize="{Binding PageSize, Mode=TwoWay}"
        TotalCount="{Binding TotalCount}"
        FirstPageCommand="{Binding FirstPageCommand}"
        PreviousPageCommand="{Binding PreviousPageCommand}"
        NextPageCommand="{Binding NextPageCommand}"
        LastPageCommand="{Binding LastPageCommand}"
        IsBusy="{Binding IsBusy}"
        BusyMessage="{Binding BusyMessage}"
        EmptyStateText="暂无用户数据">

        <!-- 定义用户特定的 DataGrid 列 -->
        <views:BaseMasterDataListView.Columns>
            <!-- 用户名 -->
            <DataGridTextColumn Header="用户名"
                                Binding="{Binding UserName}"
                                Width="150" />

            <!-- 真实姓名 -->
            <DataGridTextColumn Header="真实姓名"
                                Binding="{Binding RealName}"
                                Width="150" />

            <!-- 角色 - 使用UnifiedStatusBadge -->
            <DataGridTemplateColumn Header="角色" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:UnifiedStatusBadge
                            Text="{Binding Role, Converter={StaticResource EnumDescriptionConverter}}"
                            Type="Info" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- 手机号 -->
            <DataGridTextColumn Header="手机号"
                                Binding="{Binding PhoneNumber}"
                                Width="130" />

            <!-- 邮箱 -->
            <DataGridTextColumn Header="邮箱"
                                Binding="{Binding Email}"
                                Width="220" />

            <!-- 操作列 - OpenSpec: add-global-audit-system 增加审计按钮 -->
            <DataGridTemplateColumn Header="操作" Width="510">
                <DataGridTemplateColumn.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                    </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                            <Button Content="查看"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="4,0"
                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="编辑"
                                    Style="{StaticResource SuccessButton}"
                                    Margin="4,0"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="重置密码"
                                    Style="{StaticResource WarningButton}"
                                    Margin="4,0"
                                    Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="4,0"
                                    Command="{Binding DataContext.ToggleUserStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Content>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="启用" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Enabled">
                                                        <Setter Property="Text" Value="禁用" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>
                            <!-- OpenSpec: add-global-audit-system -->
                            <Button Content="记录"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="4,0"
                                    ToolTip="查看变更记录"
                                    Command="{Binding DataContext.ShowAuditLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="删除"
                                    Style="{StaticResource DangerButton}"
                                    Margin="4,0"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </views:BaseMasterDataListView.Columns>

        <!-- 定义操作按钮区域 -->
        <views:BaseMasterDataListView.ActionButtons>
            <StackPanel Orientation="Horizontal">
                <Button Content="批量删除"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding BatchDeleteCommand}"
                        ToolTip="删除选中的用户"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Command="{Binding AddCommand}"
                        Style="{StaticResource SuccessButton}"
                        Margin="{StaticResource SpacingSmall}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✚" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="新增用户" />
                    </StackPanel>
                </Button>
                <Button Content="刷新"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="{StaticResource SpacingSmall}" />
                <Button Content="🏠 返回主页"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NavigateToHomeCommand}"
                        ToolTip="返回管理员主页"
                        Margin="{StaticResource SpacingSmall}" />
            </StackPanel>
        </views:BaseMasterDataListView.ActionButtons>
    </views:BaseMasterDataListView>
</UserControl>
