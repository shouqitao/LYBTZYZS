<UserControl x:Class="LYBT.Desktop.Users.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!-- Epic #1832 Phase 1: 已完全迁移到UnifiedDesignSystem -->

        <!-- 所有样式从UnifiedDesignSystem.xaml (应用级资源) 继承 -->
        <infrastructure:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                Padding="{StaticResource ToolBarPadding}"
                Margin="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 搜索区域 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索用户名、姓名、手机号或邮箱">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索"
                            Margin="12,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}" />
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,12,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✚" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="新增用户"/>
                        </StackPanel>
                    </Button>                    <Button Content="刷新"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,12,0" />
                    <Button Content="🏠 返回主页"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToHomeCommand}"
                            ToolTip="返回管理员主页" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格区域 -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                Margin="0,0,0,2">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource BaseDataGrid}"
                      RowStyle="{StaticResource BaseDataGridRow}"
                      ColumnHeaderStyle="{StaticResource BaseDataGridColumnHeader}">
                <DataGrid.Columns>
                    <!-- 用户名 -->
                    <DataGridTextColumn Header="用户名"
                                        Binding="{Binding UserName}"
                                        Width="150" />

                    <!-- 真实姓名 -->
                    <DataGridTextColumn Header="真实姓名"
                                        Binding="{Binding RealName}"
                                        Width="150" />

                    <!-- 角色 -->
                    <DataGridTemplateColumn Header="角色" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD"
                                        CornerRadius="{StaticResource CornerRadiusSmall}"
                                        Padding="12,6"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Role, Converter={StaticResource EnumDescriptionConverter}}"
                                               Foreground="{StaticResource InfoBrush}"
                                               FontSize="{StaticResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 手机号 -->
                    <DataGridTextColumn Header="手机号"
                                        Binding="{Binding PhoneNumber}"
                                        Width="130" />

                    <!-- 邮箱 -->
                    <DataGridTextColumn Header="邮箱"
                                        Binding="{Binding Email}"
                                        Width="220" />

                    <!-- 操作 -->
                    <DataGridTemplateColumn Header="操作" Width="280">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                                    <Button Content="查看"
                                            Style="{StaticResource SecondaryButton}"                                            Margin="4,0"
                                            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="编辑"
                                            Style="{StaticResource SecondaryButton}"
                                            Background="#10B981"                                            Margin="4,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="删除"
                                            Style="{StaticResource DangerButton}"
                                            Margin="4,0"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部状态栏和分页 -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                Padding="{StaticResource ToolBarPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StatusLabel}"
                               Text="{Binding StatusMessage}" />
                </StackPanel>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="首页"
                            Style="{StaticResource SecondaryButton}"                            Margin="4,0"
                            Command="{Binding FirstPageCommand}" />

                    <Button Content="上一页"
                            Style="{StaticResource SecondaryButton}"                            Margin="4,0"
                            Command="{Binding PreviousPageCommand}" />

                    <Border

                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="20,8"
                            Margin="8,0"
                            MinWidth="100">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"                                   FontSize="{StaticResource FontSizeNormal}"
                                   FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage" />
                                    <Binding Path="TotalPages" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>

                    <Button Content="下一页"
                            Style="{StaticResource SecondaryButton}"                            Margin="4,0"
                            Command="{Binding NextPageCommand}" />

                    <Button Content="末页"
                            Style="{StaticResource SecondaryButton}"                            Margin="4,0"
                            Command="{Binding LastPageCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
