<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="LYBT.Desktop.Users.Views.UserProfileDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.Users.ViewModels"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="580"
             d:DataContext="{d:DesignInstance Type=viewmodels:UserProfileDialogViewModel}">

    <UserControl.Resources>
        <!-- 现代文本框样式 -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="border" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F9FAFB" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代主按钮样式 -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#D1D5DB" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代次要按钮样式 -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代图片按钮样式 -->
        <Style x:Key="ModernImageButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代删除按钮样式 -->
        <Style x:Key="ModernDeleteButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片阴影效果 -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000"
                          Direction="270"
                          ShadowDepth="2"
                          BlurRadius="16"
                          Opacity="0.05" />
    </UserControl.Resources>

    <Border Background="White"
            CornerRadius="16"
            Padding="40">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Direction="270"
                              ShadowDepth="4"
                              BlurRadius="32"
                              Opacity="0.1" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       Text="👤 编辑个人资料"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#111827"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32" />

            <!-- 表单内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 头像部分 - 卡片样式 -->
                    <Border Background="#F9FAFB"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,0,24">
                        <Border.Effect>
                            <StaticResource ResourceKey="CardShadow" />
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 当前头像 - 更大尺寸 -->
                            <Border Grid.Column="0"
                                    Width="120" Height="120"
                                    CornerRadius="60"
                                    Background="#E5E7EB"
                                    Margin="0,0,24,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                <Setter Property="Background" Value="#3B82F6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect Color="#3B82F6"
                                                      Direction="270"
                                                      ShadowDepth="2"
                                                      BlurRadius="20"
                                                      Opacity="0.3" />
                                </Border.Effect>
                                <Grid>
                                    <!-- 默认头像 -->
                                    <TextBlock Text="{Binding AvatarInitial}"
                                               FontSize="48"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasAvatar, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <!-- 用户头像 -->
                                    <Image Source="{Binding AvatarSource}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Image.Clip>
                                            <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <!-- 头像操作 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="个人头像"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📷 选择图片"
                                            Command="{Binding SelectAvatarCommand}"
                                            Style="{StaticResource ModernImageButton}"
                                            Margin="0,0,12,0" />
                                    <Button Content="🗑️ 删除头像"
                                            Command="{Binding RemoveAvatarCommand}"
                                            Style="{StaticResource ModernDeleteButton}"
                                            Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Text="支持 JPG、PNG 格式，大小不超过 2MB"
                                           FontSize="13"
                                           Foreground="#9CA3AF"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 基本信息 - 卡片样式 -->
                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,0,24">
                        <Border.Effect>
                            <StaticResource ResourceKey="CardShadow" />
                        </Border.Effect>

                        <StackPanel>
                            <!-- 分组标题 -->
                            <TextBlock Text="📋 基本信息"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,20" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 用户名（只读） -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="用户名"
                                           FontSize="15"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,16" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding UserName}"
                                         IsReadOnly="True"
                                         Style="{StaticResource ModernTextBox}"
                                         Background="#F9FAFB"
                                         Margin="0,0,0,16" />

                                <!-- 真实姓名 -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="真实姓名"
                                           FontSize="15"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,16" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding RealName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,16" />

                                <!-- 邮箱 -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="邮箱"
                                           FontSize="15"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,16" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,16" />

                                <!-- 电话 -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="电话"
                                           FontSize="15"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 工作信息 - 卡片样式 -->
                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <StaticResource ResourceKey="CardShadow" />
                        </Border.Effect>

                        <StackPanel>
                            <!-- 分组标题 -->
                            <TextBlock Text="💼 工作信息"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,20" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 部门 -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="部门"
                                           FontSize="15"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,16" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,16" />

                                <!-- 职位 -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="职位"
                                           FontSize="15"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 错误提示 - 现代样式 -->
                    <Border Background="#FEE2E2"
                            BorderBrush="#EF4444"
                            BorderThickness="2"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28"
                                    CornerRadius="14"
                                    Background="#EF4444"
                                    VerticalAlignment="Top"
                                    Margin="0,0,12,0">
                                <TextBlock Text="⚠"
                                           FontSize="16"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#991B1B"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 - 现代样式 -->
            <Grid Grid.Row="2" Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="✓ 保存修改"
                        Style="{StaticResource ModernPrimaryButton}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"
                        Margin="0,0,12,0" />

                <Button Grid.Column="1"
                        Content="✗ 取消"
                        Style="{StaticResource ModernSecondaryButton}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Margin="12,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
