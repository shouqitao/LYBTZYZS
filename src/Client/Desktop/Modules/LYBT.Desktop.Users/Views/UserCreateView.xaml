<!--
    用户创建视图 - 现代化原生 WPF 设计
    设计原则：
    - 大字号：提高可读性
    - 大间距：更好的视觉呼吸
    - 圆角：现代化视觉
    - 流畅交互：悬停和聚焦效果
    - 统一配色：专业的色彩系统
-->
<UserControl x:Class="LYBT.Desktop.Users.Views.UserCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- 现代化输入框样式 -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化下拉框样式 -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ToggleButton x:Name="toggleButton"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="false"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#6B7280"
                                                  Margin="0,0,12,0"/>
                                        </Grid>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="contentPresenter"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.08" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化阴影效果 -->
        <DropShadowEffect x:Key="ModernShadow"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Opacity="0.08"
                          Color="#000000"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="16"
                          ShadowDepth="2"
                          Opacity="0.05"
                          Color="#000000"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 表单区域 -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="40,32">
            <StackPanel>

                <!-- 页面标题 -->
                <Border Background="White"
                        CornerRadius="16"
                        Padding="32,28"
                        Margin="0,0,0,28"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 返回按钮 -->
                        <Button Grid.Column="0"
                                Command="{Binding CancelCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="12,10"
                                Margin="0,0,24,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◀"
                                           FontSize="14"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="返回"
                                           FontSize="15"
                                           FontWeight="Medium"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 标题 -->
                        <TextBlock Grid.Column="1"
                                   Text="新增用户"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#0F172A" />
                    </Grid>
                </Border>

                <!-- 基本信息卡片 -->
                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,0,28"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 卡片标题 -->
                        <Border Grid.Row="0"
                                Background="#FAFBFC"
                                CornerRadius="16,16,0,0"
                                Padding="32,24"
                                BorderBrush="#F1F3F5"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="基本信息"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B" />
                        </Border>

                        <!-- 表单内容 -->
                        <Grid Grid.Row="1" Margin="32,32,32,36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 头像区域 -->
                            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                    Width="136" Height="136"
                                    CornerRadius="68"
                                    Background="#3B82F6"
                                    Margin="0,8,40,0"
                                    VerticalAlignment="Top">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="2"
                                                      Opacity="0.15"
                                                      Color="#3B82F6"/>
                                </Border.Effect>
                                <TextBlock Text="?"
                                           FontSize="52"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- 表单字段 -->
                            <Grid Grid.Column="1" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 第一行：用户名 和 真实姓名 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,24">
                                    <TextBlock Text="用户名 *"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#475569"
                                               Margin="0,0,0,10" />
                                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" />
                                    <TextBlock Text="{Binding Errors[UserName]}"
                                               Foreground="#EF4444"
                                               FontSize="13"
                                               Margin="4,6,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,24">
                                    <TextBlock Text="真实姓名 *"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#475569"
                                               Margin="0,0,0,10" />
                                    <TextBox Text="{Binding RealName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" />
                                    <TextBlock Text="{Binding Errors[RealName]}"
                                               Foreground="#EF4444"
                                               FontSize="13"
                                               Margin="4,6,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- 第二行：手机号码 和 邮箱地址 -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,24">
                                    <TextBlock Text="手机号码"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#475569"
                                               Margin="0,0,0,10" />
                                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" />
                                    <TextBlock Text="{Binding Errors[PhoneNumber]}"
                                               Foreground="#EF4444"
                                               FontSize="13"
                                               Margin="4,6,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,24">
                                    <TextBlock Text="邮箱地址"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#475569"
                                               Margin="0,0,0,10" />
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" />
                                    <TextBlock Text="{Binding Errors[Email]}"
                                               Foreground="#EF4444"
                                               FontSize="13"
                                               Margin="4,6,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- 第三行：用户角色 和 用户状态 -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="用户角色 *"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#475569"
                                               Margin="0,0,0,10" />
                                    <ComboBox ItemsSource="{Binding RoleOptions}"
                                              SelectedValue="{Binding SelectedRole}"
                                              Style="{StaticResource ModernComboBox}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="用户状态 *"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#475569"
                                               Margin="0,0,0,10" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedValue="{Binding Status}"
                                              Style="{StaticResource ModernComboBox}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 温馨提示卡片 -->
                <Border Background="White"
                        CornerRadius="16"
                        Padding="32,28"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="📋 创建说明"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,18" />

                        <Border Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20,16">
                            <StackPanel>
                                <TextBlock FontSize="14" Foreground="#1E40AF" Margin="0,0,0,8">
                                    <Run Text="•" FontWeight="Bold" />
                                    <Run Text="  所有标记" />
                                    <Run Text=" * " FontWeight="Bold" Foreground="#EF4444" />
                                    <Run Text="的字段为必填项" />
                                </TextBlock>
                                <TextBlock FontSize="14" Foreground="#1E40AF">
                                    <Run Text="•" FontWeight="Bold" />
                                    <Run Text="  新用户密码将使用系统默认配置" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 - 两端对齐 -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="40,24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="重置表单"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,16,0"
                        Height="48"
                        MinWidth="130"
                        FontSize="15"
                        FontWeight="Medium"
                        Command="{Binding ResetFormCommand}" />
                <Button Content="创建用户"
                        Style="{StaticResource SuccessButton}"
                        Height="48"
                        MinWidth="130"
                        FontSize="15"
                        FontWeight="Medium"
                        Command="{Binding CreateUserCommand}" />
            </StackPanel>
        </Border>

        <!-- 加载遮罩 -->
        <Grid Grid.RowSpan="2"
              Background="#90000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="48,40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource ModernShadow}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Width="240"
                                 Height="6"
                                 Background="#E5E7EB"
                                 Foreground="#3B82F6"
                                 BorderThickness="0" />
                    <TextBlock Text="正在创建用户..."
                               Foreground="#475569"
                               FontSize="15"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
