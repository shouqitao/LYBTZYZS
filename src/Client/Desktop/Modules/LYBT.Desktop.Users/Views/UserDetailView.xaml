<UserControl x:Class="LYBT.Desktop.Users.Views.UserDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 引入基础设施转换器 -->
            </ResourceDictionary.MergedDictionaries>

            <!-- 首字符转换器（用于头像显示） -->
            <infrastructure:FirstCharacterConverter x:Key="FirstCharacterConverter"
                                                     xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure" />

            <!-- 卡片阴影 -->
            <DropShadowEffect x:Key="CardShadow"
                              BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.08"
                              Color="#000000"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,28" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部操作栏 -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="32,24"
                    Margin="0,0,0,28"
                    Effect="{StaticResource CardShadow}">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 返回按钮 -->
                    <Button Grid.Column="0"
                            Command="{Binding GoBackCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#64748B"
                            FontSize="15"
                            FontWeight="Medium"
                            Cursor="Hand"
                            Padding="14,10"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="◀"
                                                               FontSize="14"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="返回"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               FontWeight="{TemplateBinding FontWeight}"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="Foreground" Value="#475569" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 标题 -->
                    <TextBlock Grid.Column="1"
                               Text="用户详情"
                               FontSize="26"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#1E293B"
                               Margin="20,0,0,0" />

                </Grid>
            </Border>

            <!-- 基本信息 -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="16"
                    Margin="0,0,0,28"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0"
                            Background="#F9FAFB"
                            CornerRadius="16,16,0,0"
                            Padding="32,20">
                        <TextBlock Text="基本信息"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                    </Border>

                    <!-- 内容 -->
                    <Grid Grid.Row="1" Margin="40,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 头像 -->
                        <Border Grid.Column="0"
                                Width="136" Height="136"
                                CornerRadius="68"
                                Background="#3B82F6"
                                Margin="0,8,48,0"
                                VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.15"
                                                  Color="#3B82F6"/>
                            </Border.Effect>
                            <TextBlock Text="{Binding User.UserName, Converter={StaticResource FirstCharacterConverter}}"
                                       FontSize="52"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- 信息表格 -->
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 第一行 -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="用户名："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding User.UserName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1E293B"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="拼音码："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="4"
                                       Text="{Binding User.PinYinCode, TargetNullValue='--'}"
                                       FontSize="15"
                                       Foreground="#475569"
                                       VerticalAlignment="Center" />

                            <!-- 第二行 -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="真实姓名："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding User.RealName}"
                                       FontSize="15"
                                       Foreground="#475569"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="3"
                                       Text="失败登录次数："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <Border Grid.Row="2" Grid.Column="4"
                                    Background="#FEF3C7"
                                    CornerRadius="8"
                                    Padding="12,6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding User.FailedLoginCount}"
                                           Foreground="#92400E"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                            </Border>

                            <!-- 第三行 -->
                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="用户角色："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <Border Grid.Row="4" Grid.Column="1"
                                    Background="#DBEAFE"
                                    CornerRadius="10"
                                    Padding="16,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding User.Role}"
                                           Foreground="#1E40AF"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Grid.Row="4" Grid.Column="3"
                                       Text="邮箱地址："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="4"
                                       Text="{Binding User.Email, TargetNullValue='--'}"
                                       FontSize="15"
                                       Foreground="#475569"
                                       VerticalAlignment="Center" />

                            <!-- 第四行 - Issue #1263: 添加启用/禁用开关 -->
                            <TextBlock Grid.Row="6" Grid.Column="0"
                                       Text="账户状态："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Row="6" Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- 状态开关 -->
                                <ToggleButton IsChecked="{Binding User.IsActive, Mode=OneWay}"
                                              Command="{Binding ToggleStatusCommand}"
                                              Width="56" Height="32"
                                              Cursor="Hand"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Grid>
                                                            <!-- 背景轨道 -->
                                                            <Border x:Name="Track"
                                                                    Width="56" Height="32"
                                                                    CornerRadius="16"
                                                                    Background="#D1D5DB">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="8"
                                                                                      ShadowDepth="1"
                                                                                      Opacity="0.1"
                                                                                      Color="#000000"/>
                                                                </Border.Effect>
                                                            </Border>
                                                            <!-- 滑动按钮 -->
                                                            <Border x:Name="Thumb"
                                                                    Width="28" Height="28"
                                                                    CornerRadius="14"
                                                                    Background="White"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="2,0,0,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="4"
                                                                                      ShadowDepth="2"
                                                                                      Opacity="0.2"
                                                                                      Color="#000000"/>
                                                                </Border.Effect>
                                                            </Border>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <!-- 开启状态 -->
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Track" Property="Background" Value="#10B981"/>
                                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                                            </Trigger>
                                                            <!-- 鼠标悬停 -->
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <!-- 状态文本 -->
                                <TextBlock FontSize="15" FontWeight="Medium" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding User.IsActive}" Value="True">
                                                    <Setter Property="Text" Value="已启用" />
                                                    <Setter Property="Foreground" Value="#059669" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding User.IsActive}" Value="False">
                                                    <Setter Property="Text" Value="已禁用" />
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Row="6" Grid.Column="3"
                                       Text="联系电话："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="6" Grid.Column="4"
                                       Text="{Binding User.PhoneNumber, TargetNullValue='--'}"
                                       FontSize="15"
                                       Foreground="#475569"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- 登录信息 -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="16"
                    Margin="0,0,0,28"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0"
                            Background="#F9FAFB"
                            CornerRadius="16,16,0,0"
                            Padding="32,20">
                        <TextBlock Text="登录信息"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                    </Border>

                    <!-- 内容 -->
                    <Grid Grid.Row="1" Margin="40,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40"
                                    CornerRadius="20"
                                    Background="#EFF6FF"
                                    Margin="0,0,16,0">
                                <TextBlock Text="🕐"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="最后登录时间："
                                       Foreground="#6B7280"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding User.LastLoginTime, StringFormat='yyyy-MM-dd HH:mm:ss', TargetNullValue='从未登录'}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="#475569"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
