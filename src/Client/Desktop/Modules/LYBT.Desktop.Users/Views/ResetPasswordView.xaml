<UserControl x:Class="LYBT.Desktop.Users.Views.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 卡片阴影 -->
            <DropShadowEffect x:Key="CardShadow"
                              BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.05"
                              Color="#000000"/>

            <!-- 布尔转可见性转换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,28" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部操作栏 -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="32,24"
                    Margin="0,0,0,28"
                    Effect="{StaticResource CardShadow}">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 返回按钮 -->
                    <Button Grid.Column="0"
                            Command="{Binding GoBackCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#64748B"
                            FontSize="15"
                            FontWeight="Medium"
                            Cursor="Hand"
                            Padding="16,8,20,8"
                            VerticalAlignment="Center">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="← " FontSize="18" FontWeight="Bold" Margin="0,0,6,0"/>
                                <TextBlock Text="返回" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 页面标题 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="{Binding PageTitle, FallbackValue='重置密码'}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 用户信息卡片 -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="16"
                    Padding="32,24"
                    Margin="0,0,0,28"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="用户信息"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 用户名 -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="用户名"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <TextBox Text="{Binding User.UserName, Mode=OneWay}"
                                     Background="#F9FAFB"
                                     IsReadOnly="True"
                                     FontSize="15"
                                     Padding="14,12"
                                     BorderBrush="#E2E8F0"
                                     BorderThickness="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- 真实姓名 -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="真实姓名"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <TextBox Text="{Binding User.RealName, Mode=OneWay}"
                                     Background="#F9FAFB"
                                     IsReadOnly="True"
                                     FontSize="15"
                                     Padding="14,12"
                                     BorderBrush="#E2E8F0"
                                     BorderThickness="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 密码设置卡片 -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="16"
                    Padding="32,24"
                    Margin="0,0,0,28"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="密码设置"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,0,0,20"/>

                    <!-- 验证错误提示 -->
                    <Border Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,20"
                            Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ValidationError}"
                                   Foreground="#DC2626"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 新密码 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="新密码"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <PasswordBox x:Name="NewPasswordBox"
                                         PasswordChanged="NewPasswordBox_PasswordChanged"
                                         FontSize="15"
                                         Padding="14,12"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="PasswordBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                            <TextBlock Text="密码长度至少8个字符"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- 确认密码 -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="确认密码"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Margin="0,0,0,8"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                         FontSize="15"
                                         Padding="14,12"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="PasswordBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                        </StackPanel>

                        <!-- 生成随机密码按钮 -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,20">
                            <Button Command="{Binding GeneratePasswordCommand}"
                                    Background="#F1F5F9"
                                    BorderThickness="0"
                                    Foreground="#475569"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Padding="20,10"
                                    HorizontalAlignment="Left">
                                <Button.Content>
                                    <TextBlock Text="生成随机密码"/>
                                </Button.Content>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- 选项 -->
                        <StackPanel Grid.Row="3">
                            <CheckBox IsChecked="{Binding RequirePasswordChange}"
                                      Content="要求用户下次登录时修改密码"
                                      FontSize="14"
                                      Foreground="#475569"
                                      Margin="0,0,0,12"/>
                            <CheckBox IsChecked="{Binding SendNotification}"
                                      Content="发送通知给用户"
                                      FontSize="14"
                                      Foreground="#475569"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作按钮卡片 -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="16"
                    Padding="32,20"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 错误提示 -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               FontSize="14"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <!-- 按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 取消按钮 -->
                        <Button Command="{Binding GoBackCommand}"
                                Background="Transparent"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Foreground="#475569"
                                FontSize="15"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Padding="32,12"
                                Margin="0,0,12,0"
                                MinWidth="120">
                            <Button.Content>
                                <TextBlock Text="取消"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#94A3B8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 重置密码按钮 -->
                        <Button Command="{Binding ResetPasswordCommand}"
                                Background="#3B82F6"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Medium"
                                Cursor="Hand"
                                Padding="32,12"
                                MinWidth="120">
                            <Button.Content>
                                <TextBlock Text="重置密码"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#CBD5E1"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
