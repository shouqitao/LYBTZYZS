<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientImportWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinWidth="800" MinHeight="600">

    <UserControl.Resources>
        <!-- 向导样式定义 -->
        <Style x:Key="WizardStep" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA" />
            <Setter Property="BorderBrush" Value="#DEE2E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="30" />
            <Setter Property="Margin" Value="20" />
        </Style>

        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#495057" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="StepDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#6C757D" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5,0" />
        </Style>

        <Style x:Key="PrimaryWizardButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="#007BFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#007BFF" />
        </Style>

        <Style x:Key="SecondaryWizardButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="#6C757D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#6C757D" />
        </Style>

        <Style x:Key="ProgressIndicator" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CompletedStep" TargetType="Border" BasedOn="{StaticResource ProgressIndicator}">
            <Setter Property="Background" Value="#28A745" />
            <Setter Property="BorderBrush" Value="#28A745" />
        </Style>

        <Style x:Key="ActiveStep" TargetType="Border" BasedOn="{StaticResource ProgressIndicator}">
            <Setter Property="Background" Value="#007BFF" />
            <Setter Property="BorderBrush" Value="#007BFF" />
        </Style>

        <Style x:Key="PendingStep" TargetType="Border" BasedOn="{StaticResource ProgressIndicator}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DEE2E6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 标题和进度指示器 -->
            <RowDefinition Height="Auto" />
            <!-- 步骤导航条 -->
            <RowDefinition Height="*" />
            <!-- 内容区域 -->
            <RowDefinition Height="Auto" />
            <!-- 操作按钮区域 -->
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="30,20">
            <StackPanel>
                <TextBlock Text="患者数据Excel导入向导" FontSize="24" FontWeight="Bold" Foreground="#212529" />
                <TextBlock Text="通过4个简单步骤完成患者数据的批量导入" FontSize="14" Foreground="#6C757D" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- 步骤进度指示器 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 步骤1：模板下载 -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Border Style="{Binding Step1Style}">
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="模板下载" FontSize="12" Foreground="#6C757D" Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 步骤2：文件选择 -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Border Style="{Binding Step2Style}">
                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="文件选择" FontSize="12" Foreground="#6C757D" Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 步骤3：数据预览 -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Border Style="{Binding Step3Style}">
                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="数据预览" FontSize="12" Foreground="#6C757D" Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 步骤4：导入执行 -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <Border Style="{Binding Step4Style}">
                        <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="导入执行" FontSize="12" Foreground="#6C757D" Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 步骤内容区域 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding CurrentStepContent}" />
        </ScrollViewer>

        <!-- 操作按钮区域 -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StepDescription}" FontSize="12" Foreground="#6C757D" />
                </StackPanel>

                <!-- 右侧操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消"
                            Style="{StaticResource SecondaryWizardButton}"
                            Command="{Binding CancelCommand}" />
                    <Button Content="上一步"
                            Style="{StaticResource SecondaryWizardButton}"
                            Command="{Binding PreviousCommand}"
                            IsEnabled="{Binding CanGoPrevious}" />
                    <Button Content="{Binding NextButtonText}"
                            Style="{StaticResource PrimaryWizardButton}"
                            Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
