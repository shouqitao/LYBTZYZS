<UserControl x:Class="LYBT.Desktop.Patients.Views.PatientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Loaded="PatientManagementView_Loaded">
    <UserControl.Resources>
        <!-- UltraThink UI/UX优化 Phase 1: 使用统一设计系统样式 -->
        <!-- 所有样式现在从UnifiedDesignSystem.xaml继承，只保留页面特定的DataGrid配置 -->

        <!-- 患者管理专用DataGrid样式 -->
        <Style x:Key="PatientManagementDataGrid" TargetType="DataGrid" BasedOn="{StaticResource BaseDataGrid}">
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 响应式工具栏 - Phase 2: 响应式布局优化 -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarContainer}">
            <DockPanel LastChildFill="True">
                <!-- 操作按钮区域 - 右侧停靠 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="+ 新增患者"
                            Margin="0,0,10,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}" />
                    <Button Content="导入患者"
                            Margin="0,0,10,0"
                            Style="{StaticResource InfoButton}"
                            Command="{Binding ImportWizardCommand}" />
                    <Button Content="刷新"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>

                <!-- 搜索区域 - 左侧填充剩余空间 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="搜索：" Style="{StaticResource LabelText}" />
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedPatient}"
                  Style="{StaticResource PatientManagementDataGrid}"
                  RowStyle="{StaticResource BaseDataGridRow}"
                  ColumnHeaderStyle="{StaticResource BaseDataGridColumnHeader}">
            <DataGrid.Columns>
                <!-- 患者姓名 -->
                <DataGridTextColumn Header="姓名"
                                    Binding="{Binding Name}"
                                    Width="{StaticResource DataGridColumnWidthNormal}" />

                <!-- 性别 -->
                <DataGridTextColumn Header="性别"
                                    Binding="{Binding GenderText}"
                                    Width="{StaticResource DataGridColumnWidthSmall}" />

                <!-- 年龄 -->
                <DataGridTextColumn Header="年龄"
                                    Binding="{Binding AgeDescription}"
                                    Width="{StaticResource DataGridStatusColumnWidth}" />

                <!-- 手机号 -->
                <DataGridTextColumn Header="手机号"
                                    Binding="{Binding Phone}"
                                    Width="{StaticResource DataGridPhoneColumnWidth}" />

                <!-- 地址 -->
                <DataGridTextColumn Header="地址"
                                    Binding="{Binding Address}"
                                    Width="{StaticResource DataGridColumnWidthXLarge}" />

                <!-- 就诊次数 -->
                <DataGridTextColumn Header="就诊次数"
                                    Binding="{Binding VisitCount}"
                                    Width="{StaticResource DataGridStatusColumnWidth}" />

                <!-- 最后就诊时间 -->
                <DataGridTextColumn Header="最后就诊"
                                    Binding="{Binding LastVisitTime, StringFormat='yyyy-MM-dd'}"
                                    Width="{StaticResource DataGridDateColumnWidth}" />

                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="{StaticResource DataGridStatusColumnWidth}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="White"
                                           FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="{StaticResource DataGridActionColumnWidth}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="详情"
                                        Style="{StaticResource InfoButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="编辑"
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="状态"
                                        Style="{StaticResource WarningButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="删除"
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusLabel}"
                               Text="{Binding StatusText}" />
                </StackPanel>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="首页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding FirstPageCommand}" />

                    <Button Content="上一页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding PreviousPageCommand}" />

                    <Border Style="{StaticResource PaginationCurrentPage}">
                        <TextBlock Style="{StaticResource PaginationPageNumber}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage" />
                                    <Binding Path="TotalPages" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>

                    <Button Content="下一页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding NextPageCommand}" />

                    <Button Content="末页"
                            Style="{StaticResource PaginationControlButton}"
                            Command="{Binding LastPageCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
