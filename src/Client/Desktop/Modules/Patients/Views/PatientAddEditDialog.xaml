<Window x:Class="LYBT.Desktop.Patients.Views.PatientAddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}" Height="650" Width="500"
        MinHeight="500" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" />

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 基本信息分组 -->
                <GroupBox Header="基本信息" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <!-- 姓名 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="姓名 *" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Padding="5" />
                        </Grid>

                        <!-- 性别和年龄 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="性别 *" FontWeight="Bold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedValue="{Binding Gender}" SelectedValuePath="Tag" Height="30" Padding="5" Margin="0,0,10,0">
                                <ComboBoxItem Tag="0" Content="未知" />
                                <ComboBoxItem Tag="1" Content="男" />
                                <ComboBoxItem Tag="2" Content="女" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="年龄" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" Text="{Binding Age}" Height="30" Padding="5" />
                        </Grid>

                        <!-- 出生日期 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="出生日期" FontWeight="Bold" VerticalAlignment="Center" />
                            <DatePicker Grid.Column="1" SelectedDate="{Binding BirthDate}" Height="30" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 联系信息分组 -->
                <GroupBox Header="联系信息" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <!-- 手机号 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="手机号 *" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PhoneNumber}" Height="30" Padding="5" />
                        </Grid>

                        <!-- 地址 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="地址" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Address}" Height="30" Padding="5" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 证件信息分组 -->
                <GroupBox Header="证件信息" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <!-- 证件类型 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="证件类型" FontWeight="Bold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Text="{Binding IdType}" Height="30" Padding="5" IsEditable="True">
                                <ComboBoxItem>身份证</ComboBoxItem>
                                <ComboBoxItem>护照</ComboBoxItem>
                                <ComboBoxItem>军官证</ComboBoxItem>
                                <ComboBoxItem>其他</ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <!-- 证件号码 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="证件号码" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding IdNumber}" Height="30" Padding="5" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 紧急联系人分组 -->
                <GroupBox Header="紧急联系人" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <!-- 紧急联系人姓名 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="联系人" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding EmergencyContact}" Height="30" Padding="5" />
                        </Grid>

                        <!-- 紧急联系电话 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="联系电话" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding EmergencyPhone}" Height="30" Padding="5" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 医疗信息分组 -->
                <GroupBox Header="医疗信息" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <!-- 过敏史 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="过敏史" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5,0,0" />
                            <TextBox Grid.Column="1" Text="{Binding AllergyHistory}" Height="60" Padding="5"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="保存" Width="100" Height="35" Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"
                    Background="#28A745" Foreground="White" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E7E34" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="取消" Width="100" Height="35"
                    Command="{Binding CancelCommand}"
                    Background="#6C757D" Foreground="White" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#545B62" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
