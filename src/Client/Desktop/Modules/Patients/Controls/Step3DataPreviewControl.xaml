<UserControl x:Class="LYBT.Desktop.Patients.Controls.Step3DataPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style x:Key="WizardStep" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="20"/>
        </Style>
        
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        
        <Style x:Key="StepDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ValidationStatus" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,15,0,15"/>
        </Style>

        <Style x:Key="SuccessStatus" TargetType="Border" BasedOn="{StaticResource ValidationStatus}">
            <Setter Property="Background" Value="#D4EDDA"/>
            <Setter Property="BorderBrush" Value="#C3E6CB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ErrorStatus" TargetType="Border" BasedOn="{StaticResource ValidationStatus}">
            <Setter Property="Background" Value="#F8D7DA"/>
            <Setter Property="BorderBrush" Value="#F5C6CB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="WarningStatus" TargetType="Border" BasedOn="{StaticResource ValidationStatus}">
            <Setter Property="Background" Value="#FFF3CD"/>
            <Setter Property="BorderBrush" Value="#FFEAA7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F3F4"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeaderWidth" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxHeight" Value="300"/>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource WizardStep}">
        <StackPanel>
            <!-- 步骤标题 -->
            <TextBlock Text="数据预览和验证" Style="{StaticResource StepHeader}"/>
            
            <!-- 步骤说明 -->
            <TextBlock Style="{StaticResource StepDescription}">
                系统已读取您的Excel文件，请查看数据预览和验证结果。确认无误后即可开始导入。
            </TextBlock>

            <!-- 加载状态 -->
            <Border Background="#E7F3FF" BorderBrush="#B3D9FF" BorderThickness="1" 
                    CornerRadius="4" Padding="15" Margin="0,0,0,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="正在读取和验证Excel文件，请稍候..." FontSize="12" Foreground="#0056B3"/>
                </StackPanel>
            </Border>

            <!-- 验证结果摘要 -->
            <Grid Margin="0,0,0,15">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 总记录数 -->
                <Border Grid.Column="0" Style="{StaticResource SummaryCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="总记录数" FontSize="12" Foreground="#6C757D" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DataContext.PreviewData.Rows.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                   FontSize="18" FontWeight="Bold" Foreground="#495057" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 有效记录数 -->
                <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✅" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="有效记录" FontSize="12" Foreground="#6C757D" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DataContext.ValidationResult.ValidRowCount, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                   FontSize="18" FontWeight="Bold" Foreground="#28A745" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 错误记录数 -->
                <Border Grid.Column="2" Style="{StaticResource SummaryCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="❌" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="错误记录" FontSize="12" Foreground="#6C757D" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DataContext.ValidationResult.InvalidRowCount, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                   FontSize="18" FontWeight="Bold" Foreground="#DC3545" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 验证状态 -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- 验证成功 -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SuccessStatus}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ValidationResult.IsValid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="验证通过！所有数据格式正确，可以开始导入。" FontSize="12" Foreground="#155724"/>
                    </StackPanel>
                </Border>

                <!-- 验证失败 -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ErrorStatus}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ValidationResult.IsValid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="❌" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="验证失败！请修复以下问题后重新上传文件：" FontSize="12" Foreground="#721C24" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DataContext.ValidationResult.Errors, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="20,2">
                                        <TextBlock Text="•" Foreground="#721C24" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#721C24"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 数据预览 -->
            <StackPanel Margin="0,15,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="数据预览（前10行）：" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#495057"/>
                
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid ItemsSource="{Binding DataContext.PreviewData, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Style="{StaticResource DataGrid}"/>
                </ScrollViewer>

                <!-- 预览说明 -->
                <TextBlock Text="注：此处仅显示前10行数据作为预览，实际导入将处理文件中的所有有效数据行。" 
                           FontSize="11" Foreground="#6C757D" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>