<UserControl x:Class="LYBT.Desktop.Patients.Controls.Step1TemplateDownloadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style x:Key="WizardStep" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="20"/>
        </Style>
        
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        
        <Style x:Key="StepDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="DownloadButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <Style x:Key="InstructionItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <Style x:Key="BulletPoint" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="#007BFF"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource WizardStep}">
        <StackPanel>
            <!-- 步骤标题 -->
            <TextBlock Text="下载患者数据导入模板" Style="{StaticResource StepHeader}"/>
            
            <!-- 步骤说明 -->
            <TextBlock Style="{StaticResource StepDescription}">
                首先下载Excel导入模板，该模板包含了正确的列格式和示例数据，确保您的数据能够正确导入系统。
            </TextBlock>

            <!-- 下载按钮 -->
            <Button Content="📥 下载Excel模板" 
                    Style="{StaticResource DownloadButton}"
                    Command="{Binding DataContext.DownloadTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- 操作说明 -->
            <TextBlock Text="模板说明：" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,10" Foreground="#495057"/>
            
            <StackPanel>
                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="模板包含患者基本信息的标准格式" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>

                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="必填字段：姓名、性别、年龄" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>

                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="可选字段：电话、证件号、地址、过敏史" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>

                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="性别只能填写：男 或 女" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>

                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="年龄必须为1-150之间的数字" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>
            </StackPanel>

            <!-- 提示信息 -->
            <Border Background="#E7F3FF" BorderBrush="#B3D9FF" BorderThickness="1" 
                    CornerRadius="4" Padding="15" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#0056B3">
                        <Run Text="提示："/>
                        <Run Text="下载模板后，请使用Excel或WPS等软件打开，按照模板格式填写您的患者数据。填写完成后保存为.xlsx格式，然后在下一步中选择该文件进行导入。"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>