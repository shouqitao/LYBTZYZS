<UserControl x:Class="LYBT.Desktop.Patients.Controls.Step4ImportExecutionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style x:Key="WizardStep" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="20"/>
        </Style>
        
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        
        <Style x:Key="StepDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10,10,0"/>
        </Style>

        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#28A745"/>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
        </Style>

        <Style x:Key="ProgressCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,15,0,15"/>
        </Style>

        <Style x:Key="ProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="Foreground" Value="#007BFF"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <Style x:Key="StatusIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource WizardStep}">
        <StackPanel>
            <!-- 步骤标题 -->
            <TextBlock Text="执行数据导入" Style="{StaticResource StepHeader}"/>
            
            <!-- 步骤说明 -->
            <TextBlock Style="{StaticResource StepDescription}">
                数据验证通过，准备开始导入患者数据。导入过程中请勿关闭窗口或断开网络连接。
            </TextBlock>

            <!-- 开始导入按钮 -->
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsImporting, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Content="🚀 开始导入" 
                        Style="{StaticResource StartButton}"
                        Command="{Binding DataContext.StartImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <TextBlock Text="点击开始导入患者数据到系统中" 
                           FontSize="12" Foreground="#6C757D" 
                           VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>

            <!-- 导入进度显示 -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ProgressCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsImporting, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- 导入状态 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="⏳" Style="{StaticResource StatusIcon}"/>
                        <StackPanel>
                            <TextBlock Text="正在导入患者数据..." FontSize="16" FontWeight="SemiBold" Foreground="#495057"/>
                            <TextBlock Text="{Binding DataContext.ProgressInfo.Message, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                       FontSize="12" Foreground="#6C757D"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 进度条 -->
                    <ProgressBar Style="{StaticResource ProgressBar}"
                                 Value="{Binding DataContext.ProgressInfo.PercentComplete, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Maximum="100"/>

                    <!-- 进度详情 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="{Binding DataContext.ProgressInfo.CurrentItem, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="12" Foreground="#495057" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" 
                                   FontSize="12" Foreground="#6C757D" VerticalAlignment="Center" Margin="10,0">
                            <Run Text="{Binding DataContext.ProgressInfo.ProcessedCount, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding DataContext.ProgressInfo.TotalCount, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </TextBlock>

                        <TextBlock Grid.Column="2" 
                                   FontSize="12" Foreground="#007BFF" FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="{Binding DataContext.ProgressInfo.PercentComplete, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </Grid>

                    <!-- 取消导入按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="❌ 取消导入" 
                                Style="{StaticResource CancelButton}"
                                Command="{Binding DataContext.CancelImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 导入完成状态 -->
            <Border Background="#D4EDDA" BorderBrush="#C3E6CB">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ProgressCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsImporting, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                    <Condition Binding="{Binding DataContext.ProgressInfo.PercentComplete, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="100"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅" Style="{StaticResource StatusIcon}"/>
                    <StackPanel>
                        <TextBlock Text="导入完成！" FontSize="16" FontWeight="SemiBold" Foreground="#155724"/>
                        <TextBlock Text="患者数据已成功导入到系统中，您可以关闭向导返回患者管理页面查看。" 
                                   FontSize="12" Foreground="#155724" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 重要提示 -->
            <Border Background="#E7F3FF" BorderBrush="#B3D9FF" BorderThickness="1" 
                    CornerRadius="4" Padding="15" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#0056B3">
                        <Run Text="提示："/>
                        <Run Text="导入过程中如果出现网络错误或系统异常，已成功导入的数据不会丢失。您可以重新选择文件，系统会自动跳过已存在的重复数据。"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>