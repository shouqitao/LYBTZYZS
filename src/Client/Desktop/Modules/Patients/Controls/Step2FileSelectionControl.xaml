<UserControl x:Class="LYBT.Desktop.Patients.Controls.Step2FileSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style x:Key="WizardStep" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="20"/>
        </Style>
        
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        
        <Style x:Key="StepDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="SelectButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007BFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <Style x:Key="FilePath" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="InstructionItem" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <Style x:Key="BulletPoint" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="#007BFF"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource WizardStep}">
        <StackPanel>
            <!-- 步骤标题 -->
            <TextBlock Text="选择Excel文件" Style="{StaticResource StepHeader}"/>
            
            <!-- 步骤说明 -->
            <TextBlock Style="{StaticResource StepDescription}">
                请选择您已填写完成的患者数据Excel文件。确保文件格式正确，数据完整无误。
            </TextBlock>

            <!-- 文件选择区域 -->
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Style="{StaticResource FilePath}"
                         Text="{Binding DataContext.SelectedFilePath, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <Button Grid.Column="1" 
                        Content="📂 浏览文件" 
                        Style="{StaticResource SelectButton}"
                        Margin="10,5,0,5"
                        Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>

            <!-- 文件信息显示 -->
            <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" 
                    CornerRadius="4" Padding="15" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="选中的文件：" FontWeight="SemiBold" FontSize="12" Foreground="#495057" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding DataContext.SelectedFilePath, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                               FontSize="11" Foreground="#6C757D" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 文件要求说明 -->
            <TextBlock Text="文件要求：" FontWeight="SemiBold" FontSize="14" Margin="0,25,0,10" Foreground="#495057"/>
            
            <StackPanel>
                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="文件格式必须为 .xlsx（Excel 2007及以上版本）" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>

                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="文件大小不超过 10MB" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>

                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="必须包含模板中的标准列格式" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>

                <StackPanel Style="{StaticResource InstructionItem}">
                    <Ellipse Style="{StaticResource BulletPoint}"/>
                    <TextBlock Text="建议数据行数不超过 1000 条（提高导入速度）" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>
            </StackPanel>

            <!-- 注意事项 -->
            <Border Background="#FFF3CD" BorderBrush="#FFEAA7" BorderThickness="1" 
                    CornerRadius="4" Padding="15" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#856404">
                        <Run Text="注意："/>
                        <Run Text="请确保Excel文件没有被其他程序打开，否则可能导致读取失败。选择文件后，系统将在下一步中验证数据的完整性和正确性。"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>