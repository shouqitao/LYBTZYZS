<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.MedicalCase</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 医疗案例模块 | 诊疗流程容器 | 状态跟踪管理</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-medicalcase-enterprise</InformationalVersion>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.MedicalCase</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT医疗案例模块 - 诊疗流程容器、状态跟踪、医案管理 | UltraThink双层架构标准</PackageDescription>
    <PackageTags>WPF;医疗案例;诊疗流程;状态跟踪;医案;中医;诊所;UltraThink</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>bin\Debug\net8.0-windows\LYBT.Desktop.MedicalCase.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>bin\Release\net8.0-windows\LYBT.Desktop.MedicalCase.xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core" Version="8.1.97" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
    <PackageReference Include="Prism.Wpf" Version="8.1.97" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Infrastructure Dependencies">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Core.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Services\LYBT.Desktop.Services.csproj" />
  </ItemGroup>

</Project>