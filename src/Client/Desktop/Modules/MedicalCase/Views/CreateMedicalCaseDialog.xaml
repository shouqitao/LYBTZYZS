<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.CreateMedicalCaseDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             Width="600" Height="500">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="White" />
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 基本信息 -->
                <GroupBox Grid.Row="0" Header="基本信息" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 患者选择 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="患者 *" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Patients}"
                                      SelectedValue="{Binding MedicalCase.PatientId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBoxStyle}" />
                        </StackPanel>

                        <!-- 医生选择 -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="医生 *" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Doctors}"
                                      SelectedValue="{Binding MedicalCase.DoctorId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBoxStyle}" />
                        </StackPanel>

                        <!-- 备注 -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <TextBlock Text="备注" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding MedicalCase.Remark, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="40" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 诊疗信息 -->
                <GroupBox Grid.Row="1" Header="诊疗信息" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 主诉 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="主诉" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Consultation.ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60" />
                        </StackPanel>

                        <!-- 现病史 -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="现病史" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Consultation.PresentIllness, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="80" />
                        </StackPanel>

                        <!-- 诊断 -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="诊断" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Consultation.Diagnosis, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60" />
                        </StackPanel>

                        <!-- 治疗方案 -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="治疗方案" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Consultation.TreatmentPlan, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 处方信息（可选） -->
                <GroupBox Grid.Row="2" Header="处方信息（可选）" Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 是否包含处方 -->
                        <CheckBox Grid.Row="0"
                                  IsChecked="{Binding IncludePrescription}"
                                  Content="包含处方"
                                  Margin="0,0,0,8"
                                  FontWeight="SemiBold" />

                        <!-- 处方详情 -->
                        <Grid Grid.Row="1"
                              Visibility="{Binding IncludePrescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 处方类型 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="处方类型" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding Prescription.Type}"
                                          Style="{StaticResource ModernComboBoxStyle}">
                                    <ComboBoxItem>中药饮片</ComboBoxItem>
                                    <ComboBoxItem>中成药</ComboBoxItem>
                                    <ComboBoxItem>配方颗粒</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- 剂数 -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,8">
                                <TextBlock Text="剂数" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Prescription.Quantity, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" />
                            </StackPanel>

                            <!-- 用法 -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,8">
                                <TextBlock Text="用法" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Prescription.Usage, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" />
                            </StackPanel>

                            <!-- 处方备注 -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                                <TextBlock Text="处方备注" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Prescription.Remark, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="40" />
                            </StackPanel>

                            <!-- 处方明细（简化显示） -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                <TextBlock Text="处方明细" Margin="0,0,0,4" />
                                <Border Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8"
                                        MinHeight="60">
                                    <TextBlock Text="（处方明细将在后续步骤中编辑）"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="请选择患者以创建医疗案例"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Command="{Binding SaveCommand}"
                        Content="创建"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Width="100" />

                <Button Grid.Column="2"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource SecondaryBrush}"
                        Foreground="White"
                        Width="100" />
            </Grid>
        </Border>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="5"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="20" Height="20"
                                 IsIndeterminate="True"
                                 Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
