<UserControl x:Class="LYBT.Desktop.MedicalCase.Views.MedicalCaseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Background="Transparent" BorderThickness="0" Padding="8"
                        Foreground="White"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" VerticalAlignment="Center" FontSize="16" />
                        <TextBlock Text="返回" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="医疗案例详情"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding StartConsultationCommand}"
                            Background="Transparent" BorderThickness="0" Padding="8"
                            Foreground="White"
                            Margin="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🩺" VerticalAlignment="Center" FontSize="16" />
                            <TextBlock Text="开始看诊" Margin="4,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PrintCommand}"
                            Background="Transparent" BorderThickness="0" Padding="8"
                            Foreground="White"
                            Margin="4">
                        <TextBlock Text="🖨" FontSize="16" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 患者基本信息卡片 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="👤"
                                   FontSize="32"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Width="48"
                                   Height="48"
                                   Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="18" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} - {1} - {2}岁">
                                        <Binding Path="PatientName" />
                                        <Binding Path="PatientGender" />
                                        <Binding Path="PatientAge" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <TextBlock Text="{Binding MedicalCase.CaseNumber}"
                                       Foreground="Gray"
                                       Margin="0,4,0,0" />

                            <TextBlock Text="{Binding MedicalCase.StatusText}"
                                       Margin="0,4,0,0"
                                       Foreground="Gray" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 病历信息 -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Expander Header="病历信息" IsExpanded="True">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="主诉:" FontWeight="Bold" />
                                <TextBlock Text="{Binding MedicalCase.ChiefComplaint}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="现病史:" FontWeight="Bold" />
                                <TextBlock Text="{Binding MedicalCase.PresentIllness}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock Text="既往史:" FontWeight="Bold" />
                                <TextBlock Text="{Binding MedicalCase.PastHistory}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                <TextBlock Text="过敏史:" FontWeight="Bold" />
                                <TextBlock Text="{Binding MedicalCase.AllergyHistory}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="家族史:" FontWeight="Bold" />
                                <TextBlock Text="{Binding MedicalCase.FamilyHistory}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>

                <!-- 诊疗记录时间线 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Expander Header="诊疗记录" IsExpanded="True">
                        <Grid Margin="16">
                            <TabControl>
                                <!-- 看诊记录 -->
                                <TabItem Header="看诊记录">
                                    <DataGrid ItemsSource="{Binding ConsultationHistory}"
                                              SelectedItem="{Binding SelectedConsultation}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="看诊时间"
                                                                Binding="{Binding ConsultationTime}"
                                                                Width="150" />
                                            <DataGridTextColumn Header="医生"
                                                                Binding="{Binding DoctorName}"
                                                                Width="100" />
                                            <DataGridTextColumn Header="诊断"
                                                                Binding="{Binding Diagnosis}"
                                                                Width="*" />
                                            <DataGridTemplateColumn Header="操作" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.ViewConsultationCommand,
                                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Content="查看"
                                                                Background="Transparent" BorderThickness="0" Padding="8" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <!-- 处方记录 -->
                                <TabItem Header="处方记录">
                                    <DataGrid ItemsSource="{Binding PrescriptionHistory}"
                                              SelectedItem="{Binding SelectedPrescription}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="处方编号"
                                                                Binding="{Binding PrescriptionNo}"
                                                                Width="150" />
                                            <DataGridTextColumn Header="剂数"
                                                                Binding="{Binding DosageCount}"
                                                                Width="80" />
                                            <DataGridTextColumn Header="应付金额"
                                                                Binding="{Binding PayableAmount, StringFormat='￥{0:F2}'}"
                                                                Width="100" />
                                            <DataGridTemplateColumn Header="操作" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.ViewPrescriptionCommand,
                                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Content="查看"
                                                                Background="Transparent" BorderThickness="0" Padding="8" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Expander>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <ProgressBar Width="50" Height="50"
                         IsIndeterminate="True"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
