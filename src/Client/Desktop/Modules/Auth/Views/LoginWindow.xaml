<Window x:Class="LYBT.Desktop.Auth.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LYBT.Desktop.Core.Converters;assembly=LYBT.Desktop.Core"
        Title="凌隐宝堂中医诊所 - 管理系统"
        Height="580" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <!-- 窗口资源 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/Controls/LoginControls.xaml" />
                <ResourceDictionary Source="../../Themes/Design/HighContrastTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器 -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

            <!-- 窗口级动画资源 -->
            <Storyboard x:Key="FadeInAnimation">
                <DoubleAnimation Storyboard.TargetName="MainContainer"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3" />
                <DoubleAnimation Storyboard.TargetName="MainContainer"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 From="20" To="0" Duration="0:0:0.3" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 窗口加载时触发动画 -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}" />
        </EventTrigger>
    </Window.Triggers>

    <!-- 主网格布局 -->
    <Grid>
        <!-- 主容器 -->
        <Border x:Name="MainContainer"
                Background="{DynamicResource CardBrush}"
                CornerRadius="12"
                Margin="24"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                Style="{DynamicResource HighContrastBorderStyle}"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="20" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#40000000"
                                  Direction="270"
                                  ShadowDepth="8"
                                  Opacity="0.12"
                                  BlurRadius="24" />
            </Border.Effect>

            <!-- 内容区域 -->
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 品牌标识 -->
                    <RowDefinition Height="32" />
                    <!-- 间距 -->
                    <RowDefinition Height="Auto" />
                    <!-- 登录表单 -->
                    <RowDefinition Height="24" />
                    <!-- 间距 -->
                    <RowDefinition Height="Auto" />
                    <!-- API状态 -->
                    <RowDefinition Height="24" />
                    <!-- 间距 -->
                    <RowDefinition Height="Auto" />
                    <!-- 登录按钮 -->
                    <RowDefinition Height="16" />
                    <!-- 间距 -->
                    <RowDefinition Height="Auto" />
                    <!-- 状态消息 -->
                    <RowDefinition Height="*" />
                    <!-- 弹性空间 -->
                </Grid.RowDefinitions>

                <!-- 品牌标识区域 -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="BrandHeader"
                            AutomationProperties.Name="凌隐宝堂中医诊所管理系统标题">
                    <TextBlock Text="凌隐宝堂中医诊所"
                               Style="{DynamicResource TitleTextStyle}"
                               HorizontalAlignment="Center"
                               AutomationProperties.AutomationId="MainTitle" />
                    <TextBlock Text="管理系统"
                               Style="{DynamicResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               AutomationProperties.AutomationId="Subtitle" />
                </StackPanel>

                <!-- 登录表单 -->
                <StackPanel Grid.Row="2"
                            AutomationProperties.AutomationId="LoginForm"
                            AutomationProperties.Name="登录表单">

                    <!-- 用户名输入组 -->
                    <StackPanel Margin="0,0,0,16">
                        <Label Content="用户名"
                               Style="{DynamicResource LabelTextStyle}"
                               Margin="0,0,0,6"
                               Target="{Binding ElementName=UsernameTextBox}"
                               AutomationProperties.AutomationId="UsernameLabel" />
                        <TextBox x:Name="UsernameTextBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 TabIndex="1"
                                 AutomationProperties.AutomationId="UsernameInput"
                                 AutomationProperties.Name="用户名输入框"
                                 AutomationProperties.HelpText="请输入您的用户名">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- 密码输入组 -->
                    <StackPanel Margin="0,0,0,16">
                        <Label Content="密码"
                               Style="{DynamicResource LabelTextStyle}"
                               Margin="0,0,0,6"
                               Target="{Binding ElementName=PasswordBox}"
                               AutomationProperties.AutomationId="PasswordLabel" />
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{DynamicResource ModernPasswordBoxStyle}"
                                     TabIndex="2"
                                     AutomationProperties.AutomationId="PasswordInput"
                                     AutomationProperties.Name="密码输入框"
                                     AutomationProperties.HelpText="请输入您的密码">
                            <PasswordBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                            </PasswordBox.InputBindings>
                        </PasswordBox>
                    </StackPanel>

                    <!-- 记住我选项 -->
                    <CheckBox Content="记住我"
                              IsChecked="{Binding RememberMe}"
                              Style="{DynamicResource ModernCheckBoxStyle}"
                              TabIndex="3"
                              AutomationProperties.AutomationId="RememberMeCheckbox"
                              AutomationProperties.Name="记住我选项"
                              AutomationProperties.HelpText="勾选后将保存登录信息" />
                </StackPanel>

                <!-- API状态指示器 -->
                <Border Grid.Row="4"
                        Style="{DynamicResource ApiStatusStyle}"
                        AutomationProperties.AutomationId="ApiStatusIndicator"
                        AutomationProperties.Name="API连接状态">
                    <TextBlock Text="{Binding ApiStatus}"
                               FontSize="12"
                               FontFamily="{DynamicResource PrimaryFontFamily}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               UseLayoutRounding="True"
                               AutomationProperties.AutomationId="ApiStatusText">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApiOnline}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- 登录按钮 -->
                <Button Grid.Row="6"
                        Content="登录系统"
                        Command="{Binding LoginCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        IsDefault="True"
                        TabIndex="4"
                        AutomationProperties.AutomationId="LoginButton"
                        AutomationProperties.Name="登录系统按钮"
                        AutomationProperties.HelpText="点击登录到管理系统" />

                <!-- 状态消息区域 -->
                <StackPanel Grid.Row="8"
                            AutomationProperties.AutomationId="StatusMessages">

                    <!-- 成功消息 -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{DynamicResource SuccessTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                               AutomationProperties.AutomationId="SuccessMessage"
                               AutomationProperties.Name="成功状态消息" />

                    <!-- 错误消息 -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{DynamicResource ErrorTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                               AutomationProperties.AutomationId="ErrorMessage"
                               AutomationProperties.Name="错误状态消息" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载遮罩层 -->
        <Grid Style="{DynamicResource LoadingOverlayStyle}"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.AutomationId="LoadingOverlay"
              AutomationProperties.Name="正在加载">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 现代化进度条 -->
                <ProgressBar IsIndeterminate="True"
                             Width="240"
                             Style="{DynamicResource ModernProgressBarStyle}"
                             AutomationProperties.AutomationId="LoadingProgressBar"
                             AutomationProperties.Name="登录进度指示器" />

                <!-- 加载文本 -->
                <TextBlock Text="正在验证身份..."
                           Foreground="White"
                           FontSize="14"
                           FontFamily="{DynamicResource PrimaryFontFamily}"
                           HorizontalAlignment="Center"
                           UseLayoutRounding="True"
                           Margin="0,16,0,0"
                           AutomationProperties.AutomationId="LoadingText" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
