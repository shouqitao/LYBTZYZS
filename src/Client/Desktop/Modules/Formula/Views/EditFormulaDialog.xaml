<Window x:Class="LYBT.Desktop.Formula.Views.EditFormulaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:LYBT.Desktop.Formula.ViewModels"
        mc:Ignorable="d"
        Title="编辑验方模板" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=viewmodels:EditFormulaDialogViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColorBrush}" Padding="15,10">
            <TextBlock Text="编辑验方模板" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 基本信息 -->
                <GroupBox Grid.Row="0" Header="基本信息" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 验方名称 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="验方名称：" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Name}" Margin="0,5" Padding="5" />

                        <!-- 分类 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分类：" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding Formula.Category}"
                                  Margin="0,5" />

                        <!-- 来源 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="来源：" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Text="{Binding Formula.Source}" Margin="0,5" Padding="5" />

                        <!-- 适应症 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="适应症：" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.Indications}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="60" Margin="0,5" Padding="5"
                                 VerticalScrollBarVisibility="Auto" />

                        <!-- 用法用量 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="用法用量：" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                 Text="{Binding Formula.DosageInstruction}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="40" Margin="0,5" Padding="5"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </GroupBox>

                <!-- 药材组成 -->
                <GroupBox Grid.Row="1" Header="药材组成" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="添加药材" Command="{Binding AddHerbCommand}"
                                    Padding="10,5" Margin="0,0,5,0"
                                    Background="{DynamicResource SuccessColorBrush}"
                                    Foreground="White" />
                        </StackPanel>

                        <!-- 药材列表 -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding HerbItems}"
                                  SelectedItem="{Binding SelectedHerbItem}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="药材名称" Binding="{Binding HerbName}" Width="150" />
                                <DataGridTextColumn Header="用量" Binding="{Binding Quantity}" Width="80" />
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" />
                                <DataGridTextColumn Header="处理方法" Binding="{Binding Preparation}" Width="100" />
                                <DataGridTextColumn Header="特殊说明" Binding="{Binding Usage}" Width="*" />
                                <DataGridTemplateColumn Header="操作" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="编辑"
                                                        Command="{Binding DataContext.EditHerbCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="5,2" Margin="2,0" />
                                                <Button Content="删除"
                                                        Command="{Binding DataContext.RemoveHerbCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="5,2"
                                                        Background="{DynamicResource DangerColorBrush}"
                                                        Foreground="White" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <!-- 备注 -->
                <GroupBox Grid.Row="2" Header="备注" Margin="0,0,0,15">
                    <TextBox Text="{Binding Formula.Remark}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Height="60" Margin="10" Padding="5"
                             VerticalScrollBarVisibility="Auto" />
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存" Command="{Binding SaveCommand}"
                            Width="80" Margin="0,0,10,0"
                            Background="{DynamicResource PrimaryColorBrush}"
                            Foreground="White" />
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            Width="80" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>