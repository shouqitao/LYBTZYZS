<UserControl x:Class="LYBT.Desktop.Formula.Views.FormulaManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:LYBT.Desktop.Formula.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance Type=viewmodels:FormulaManagementViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColorBrush}" Padding="20,15">
            <TextBlock Text="验方模板管理" Foreground="White" FontSize="20" FontWeight="Bold" />
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="White" Padding="20,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderColorBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 分类选择 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBlock Text="分类：" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              Width="120" />
                </StackPanel>

                <!-- 搜索框 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                    <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Padding="5" />
                </StackPanel>

                <!-- 清空筛选 -->
                <Button Grid.Column="2" Content="清空筛选" Command="{Binding ClearFiltersCommand}"
                        Padding="10,5" Margin="0,0,10,0" />

                <!-- 操作按钮 - UltraThink Phase 3.4: 增强功能集成 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="📥导入模板" Command="{Binding ImportTemplatesCommand}"
                            Padding="8,5" Margin="0,0,5,0"
                            Background="#6C757D" Foreground="White"
                            ToolTip="从Excel/CSV文件导入验方模板" />
                    <Button Content="📄导出模板" Command="{Binding ExportTemplateCommand}"
                            Padding="8,5" Margin="0,0,5,0"
                            Background="#17A2B8" Foreground="White"
                            ToolTip="下载验方模板导入格式" />
                    <Button Content="新增验方" Command="{Binding AddFormulaCommand}"
                            Padding="10,5" Margin="0,0,5,0"
                            Background="{DynamicResource SuccessColorBrush}"
                            Foreground="White" />
                    <Button Content="刷新" Command="{Binding RefreshCommand}"
                            Padding="10,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Formulas}"
                  SelectedItem="{Binding SelectedFormula}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F9F9F9"
                  RowHeight="40">
            <DataGrid.Columns>
                <!-- 验方名称 -->
                <DataGridTextColumn Header="验方名称" Binding="{Binding Name}" Width="150" />
                
                <!-- 分类 -->
                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
                
                <!-- 功效 -->
                <DataGridTextColumn Header="功效" Binding="{Binding Effect}" Width="*" />
                
                <!-- 来源 -->
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="120" />
                
                <!-- 价格信息 -->
                <DataGridTextColumn Header="总价(元)" Binding="{Binding TotalPrice, StringFormat='{}{0:F2}'}" Width="80" />
                
                <!-- 药材数量 -->
                <DataGridTextColumn Header="药材数" Binding="{Binding HerbCount}" Width="60" />
                
                <!-- 操作列 -->
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- UltraThink Phase 3.4: 增强操作功能 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="📋查看" 
                                        Command="{Binding DataContext.ViewTemplateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="2" Padding="5,2"
                                        ToolTip="查看验方模板详情" />
                                <Button Content="编辑"
                                        Command="{Binding DataContext.EditFormulaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="2" Padding="5,2" />
                                <Button Content="📋复制"
                                        Command="{Binding DataContext.CopyTemplateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="2" Padding="5,2"
                                        Background="#28A745" Foreground="White"
                                        ToolTip="复制验方模板" />
                                <Button Content="删除"
                                        Command="{Binding DataContext.DeleteFormulaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="2" Padding="5,2"
                                        Background="{DynamicResource DangerColorBrush}"
                                        Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="10,5">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Left" />
                <ProgressBar IsIndeterminate="True" Width="100" Height="15"
                             HorizontalAlignment="Right"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>