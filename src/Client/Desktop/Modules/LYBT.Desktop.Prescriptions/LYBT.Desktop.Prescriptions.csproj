<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Desktop.Prescriptions</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 处方管理模块 | 药材组合 | 配伍检查</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-prescriptions-enterprise</InformationalVersion>
    
    <!-- Package Information -->
    <PackageId>LYBT.Desktop.Prescriptions</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT处方管理模块 - 药材配合、价格计算、配伍检查、处方打印 | UltraThink双层架构标准</PackageDescription>
    <PackageTags>WPF;处方管理;药材组合;配伍检查;中医;诊所;UltraThink</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
    <Page Remove="bin\**" />
  </ItemGroup>

  <!-- Issue #1606 Phase 3: 临时排除待重构的ViewModel和View（Issue #1608） -->
  <ItemGroup>
    <!-- 所有ViewModel已重构完成 (Issue #1608 Phase 3) -->
    <!-- 仍保留View排除，因为对应ViewModel需要进一步测试 -->    <Compile Remove="Repositories\**" />  </ItemGroup>

  <ItemGroup>
    <None Remove="LYBT.Desktop.Prescriptions.csproj.Backup.tmp" />
    <None Remove="LYBT.Desktop.Prescriptions.xml" />
  </ItemGroup>

  <!-- Prism and WPF Framework -->
  <ItemGroup Label="WPF and MVVM Framework">
    <PackageReference Include="Prism.Core" />
    <PackageReference Include="Prism.DryIoc" />
    <PackageReference Include="Prism.Wpf" />
  </ItemGroup>

  <!-- Logging -->
  <ItemGroup Label="Logging">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Infrastructure Dependencies - 简化三层架构">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Foundation\LYBT.Desktop.Foundation.csproj" />
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Infrastructure\LYBT.Desktop.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Models\LYBT.Desktop.Models.csproj" />
  </ItemGroup>

  <!-- OpenSpec: refactor-prescription-module-consolidation - 消除循环依赖 -->
  <!-- MedicalCase依赖Prescriptions，而非反向。处方是医案的组成部分 -->
  <ItemGroup Label="Cross-Module Dependencies">
    <ProjectReference Include="..\LYBT.Desktop.Formula\LYBT.Desktop.Formula.csproj" />
    <ProjectReference Include="..\LYBT.Desktop.Herbs\LYBT.Desktop.Herbs.csproj" />
    <!-- [已删除] MedicalCase引用 - 循环依赖根源 -->
  </ItemGroup>

  <ItemGroup Label="Desktop Core">
    <ProjectReference Include="..\..\Core\LYBT.Desktop.Contracts\LYBT.Desktop.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Label="Shared Libraries">
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\LYBT.Shared.Components\LYBT.Shared.Components.csproj" />
  </ItemGroup>

</Project>