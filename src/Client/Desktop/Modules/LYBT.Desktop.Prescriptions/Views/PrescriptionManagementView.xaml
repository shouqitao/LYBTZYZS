<UserControl x:Class="LYBT.Desktop.Prescriptions.Views.PrescriptionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- 枚举描述转换器 -->
        <infrastructure:EnumDescriptionConverter x:Key="EnumDescriptionConverter"
            xmlns:infrastructure="clr-namespace:LYBT.Desktop.Infrastructure.Converters;assembly=LYBT.Desktop.Infrastructure" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Command="{Binding AddPrescriptionCommand}" ToolTip="新建处方">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontWeight="Bold" Margin="0,0,5,0" />
                        <TextBlock Text="新建处方" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding ExportPrescriptionsCommand}" ToolTip="导出处方数据">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontWeight="Bold" Margin="0,0,5,0" />
                        <TextBlock Text="导出数据" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding RefreshCommand}" ToolTip="刷新">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" FontWeight="Bold" Margin="0,0,5,0" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="搜索患者姓名、处方号、诊断..."
                     Height="32" Padding="8" FontSize="14"
                     Margin="0,0,10,0" />

            <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}"
                        ToolTip="开始日期"
                        Height="32" FontSize="14"
                        Margin="0,0,10,0" Width="120" />

            <TextBlock Grid.Column="2" Text="至" VerticalAlignment="Center" Margin="5" />

            <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}"
                        ToolTip="结束日期"
                        Height="32" FontSize="14"
                        Margin="0,0,10,0" Width="120" />

            <Button Grid.Column="4" Command="{Binding ClearFiltersCommand}"
                    Height="32" FontSize="14" Padding="12,6"
                    Content="清除筛选" Margin="0,0,10,0" />
        </Grid>

        <!-- 处方列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Prescriptions}"
                  SelectedItem="{Binding SelectedPrescription}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <!-- Issue #1551: 处方自动编号功能 - 显示服务端生成的正式编号 -->
                <DataGridTextColumn Header="处方编号" Binding="{Binding PrescriptionNumber}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2C3E50" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PrescriptionNumber}" Value="{x:Null}">
                                    <Setter Property="Text" Value="（未保存）" />
                                    <Setter Property="Foreground" Value="#95A5A6" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PrescriptionNumber}" Value="">
                                    <Setter Property="Text" Value="（未保存）" />
                                    <Setter Property="Foreground" Value="#95A5A6" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100" />
                <DataGridTextColumn Header="处方日期" Binding="{Binding PrescriptionDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100" />
                <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="100" />
                <DataGridTextColumn Header="诊断" Binding="{Binding Diagnosis}" Width="*" />
                <DataGridTextColumn Header="剂数" Binding="{Binding DosageCount}" Width="60" />
                <DataGridTextColumn Header="原价" Binding="{Binding TotalPrice, StringFormat='￥{0:F2}'}" Width="80" />
                <DataGridTextColumn Header="折扣" Binding="{Binding DiscountAmount, StringFormat='￥{0:F2}'}" Width="80" />
                <DataGridTextColumn Header="应付" Binding="{Binding PayableAmount, StringFormat='￥{0:F2}'}" Width="80" />
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#10B981"
                                    CornerRadius="{StaticResource CornerRadiusSmall}"
                                    Padding="12,6"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}"
                                           Foreground="White"
                                           FontSize="{StaticResource FontSizeNormal}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.ViewPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="查看" Margin="2" />
                                <Button Command="{Binding DataContext.EditPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="编辑" Margin="2" />
                                <!-- P0-02新增：患者处方历史查询 -->
                                <Button Command="{Binding DataContext.ViewPatientHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="患者历史" Margin="2"
                                        ToolTip="查看该患者的历史处方记录" />
                                <Button Command="{Binding DataContext.CopyPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="复制" Margin="2" />
                                <Button Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="打印" Margin="2" />
                                <Button Command="{Binding DataContext.DeletePrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="Red" Content="删除" Margin="2" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="100" Height="15" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
