<UserControl x:Class="LYBT.Desktop.Prescriptions.Views.PrescriptionDeleteConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="450"
             MinWidth="450" MinHeight="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#D32F2F" Padding="16">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Medium" Foreground="White" />
        </Border>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 警告信息 -->
            <Border Grid.Row="0" Background="#FFEBEE" BorderBrush="#E57373" BorderThickness="2"
                    CornerRadius="4" Padding="16" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⚠" FontSize="20" Foreground="#D32F2F" Margin="0,0,8,0" />
                        <TextBlock Text="警告" FontSize="16" FontWeight="Bold" Foreground="#D32F2F" />
                    </StackPanel>
                    <TextBlock Text="此操作不可恢复，请谨慎选择删除方式。" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 删除方式选择 -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="删除方式：" FontSize="14" FontWeight="Medium" Margin="0,0,0,12" />

                <RadioButton IsChecked="{Binding IsSoftDelete}" GroupName="DeleteType" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="软删除（标记为已删除，保留数据）" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="数据保留在数据库中，可用于历史追溯" FontSize="12" Foreground="#757575" Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>

                <RadioButton IsChecked="{Binding IsPhysicalDelete}" GroupName="DeleteType">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="Medium" Foreground="#D32F2F">
                            <Run Text="物理删除（永久删除，不可恢复）" />
                        </TextBlock>
                        <TextBlock Text="数据将从数据库中永久删除，无法恢复" FontSize="12" Foreground="#D32F2F" Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- 操作按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Command="{Binding CancelCommand}"
                        Width="100" Height="36" FontSize="14" Margin="0,0,8,0"
                        Background="White" BorderBrush="#BDBDBD" BorderThickness="1" />
                <Button Content="确认删除" Command="{Binding ConfirmCommand}"
                        Width="120" Height="36" FontSize="14"
                        Background="#D32F2F" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
