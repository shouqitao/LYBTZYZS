<UserControl x:Class="LYBT.WPF.Client.BusinessModules.Patients.Views.PatientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../../Themes/Design/SystemManagement/ManagementViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- �������� -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="������" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="����" 
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>

                <!-- ������ť���� -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+ ��������" 
                            Margin="0,0,10,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}"/>
                    <Button Content="ˢ��" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ���ݱ��� -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource ManagementDataGrid}"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <!-- �������� -->
                <DataGridTextColumn Header="����" 
                                    Binding="{Binding Name}" 
                                    Width="100"/>
                
                <!-- �Ա� -->
                <DataGridTextColumn Header="�Ա�" 
                                    Binding="{Binding GenderText}" 
                                    Width="60"/>
                
                <!-- ���� -->
                <DataGridTextColumn Header="����" 
                                    Binding="{Binding AgeDescription}" 
                                    Width="80"/>
                
                <!-- �ֻ��� -->
                <DataGridTextColumn Header="�ֻ���" 
                                    Binding="{Binding Phone}" 
                                    Width="120"/>
                
                <!-- ��ַ -->
                <DataGridTextColumn Header="��ַ" 
                                    Binding="{Binding Address}" 
                                    Width="200"/>
                
                <!-- ������� -->
                <DataGridTextColumn Header="�������" 
                                    Binding="{Binding VisitCount}" 
                                    Width="80"/>
                
                <!-- ������ʱ�� -->
                <DataGridTextColumn Header="������" 
                                    Binding="{Binding LastVisitTime, StringFormat='yyyy-MM-dd'}" 
                                    Width="100"/>
                
                <!-- ״̬ -->
                <DataGridTemplateColumn Header="״̬" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}" 
                                    CornerRadius="3" 
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" 
                                           Foreground="White" 
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- ���� -->
                <DataGridTemplateColumn Header="����" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="����" 
                                        Style="{StaticResource InfoButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="�༭" 
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="״̬" 
                                        Style="{StaticResource WarningButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="ɾ��" 
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ״̬���ͷ�ҳ -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ͳ����Ϣ -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusText}"
                               Text="{Binding StatusText}"/>
                </StackPanel>

                <!-- ��ҳ�ؼ� -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <Button Content="��ҳ" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding FirstPageCommand}"/>
                    
                    <Button Content="��һҳ" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding PreviousPageCommand}"/>
                    
                    <Border Style="{StaticResource PageNumberBorder}">
                        <TextBlock FontWeight="Bold" FontSize="13">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    
                    <Button Content="��һҳ" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding NextPageCommand}"/>
                    
                    <Button Content="ĩҳ" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding LastPageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>