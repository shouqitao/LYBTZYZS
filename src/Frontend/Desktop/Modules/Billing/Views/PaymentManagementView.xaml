&lt;UserControl x:Class="LYBT.WPF.Client.Modules.Payment.Views.PaymentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#FF5722" Padding="20,15">
            <Grid>
                <TextBlock Text="付费管理" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="今日收费：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TodayIncome, StringFormat={}{0:C}}" Foreground="#FFEB3B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="待收费：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PendingCount}" Foreground="#FFEB3B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="笔" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索和筛选栏 -->
        <Border Grid.Row="1" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- 搜索框 -->
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                             Width="250" Height="35" Padding="10,8"
                             BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5"
                             Tag="搜索患者姓名或单号">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding Border.CornerRadius}">
                                                <Grid>
                                                    <TextBlock Text="{TemplateBinding Tag}" 
                                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Foreground="#999999"
                                                               Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, 
                                                                            Converter={StaticResource StringToVisibilityConverter}}"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 状态筛选 -->
                    <ComboBox SelectedItem="{Binding SelectedStatus}" Width="120" Height="35" 
                              Margin="15,0,0,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="全部状态"/>
                        <ComboBoxItem Content="待收费"/>
                        <ComboBoxItem Content="已收费"/>
                        <ComboBoxItem Content="已退费"/>
                    </ComboBox>

                    <!-- 日期筛选 -->
                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Height="35" 
                                Margin="15,0,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="搜索" Command="{Binding SearchCommand}"
                            Width="80" Height="35" Margin="0,0,10,0"
                            Background="#FF5722" Foreground="White" BorderThickness="0"
                            FontSize="14" CornerRadius="5"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}"
                            Width="80" Height="35" Margin="0,0,10,0"
                            Background="#2196F3" Foreground="White" BorderThickness="0"
                            FontSize="14" CornerRadius="5"/>
                    <Button Content="导出" Command="{Binding ExportCommand}"
                            Width="80" Height="35"
                            Background="#4CAF50" Foreground="White" BorderThickness="0"
                            FontSize="14" CornerRadius="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 付费列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding PaymentList}"
                  SelectedItem="{Binding SelectedPayment}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" IsReadOnly="True" Margin="20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Width="60" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                 Path="Header"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="收费单号" Binding="{Binding PaymentNumber}" Width="120"/>
                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="60"/>
                <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="60"/>
                <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="100"/>
                <DataGridTextColumn Header="费用类型" Binding="{Binding PaymentType}" Width="100"/>
                <DataGridTextColumn Header="应收金额" Binding="{Binding TotalAmount, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="实收金额" Binding="{Binding ActualAmount, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="支付方式" Binding="{Binding PaymentMethod}" Width="100"/>
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}" Padding="5,2" CornerRadius="3">
                                <TextBlock Text="{Binding StatusText}" Foreground="White" 
                                           HorizontalAlignment="Center" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="收费" 
                                        Command="{Binding DataContext.ChargeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                                        Padding="5,2" Margin="2"
                                        Visibility="{Binding CanCharge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Content="退费" 
                                        Command="{Binding DataContext.RefundCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#F44336" Foreground="White" BorderThickness="0"
                                        Padding="5,2" Margin="2"
                                        Visibility="{Binding CanRefund, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Content="详情" 
                                        Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#9C27B0" Foreground="White" BorderThickness="0"
                                        Padding="5,2" Margin="2"/>
                                <Button Content="打印" 
                                        Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#FF9800" Foreground="White" BorderThickness="0"
                                        Padding="5,2" Margin="2"
                                        Visibility="{Binding CanPrint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F5F5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>