&lt;Window x:Class="LYBT.WPF.Client.Modules.Payment.Dialogs.ChargeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="收费" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#FF5722" Padding="20">
            <TextBlock Text="收费确认" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- 患者信息 -->
                <GroupBox Header="患者信息" Margin="0,0,0,20">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="患者姓名：" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PatientName}" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="收费单号：" FontWeight="Bold" VerticalAlignment="Center" Margin="15,5,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PaymentNumber}" VerticalAlignment="Center" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="医生：" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DoctorName}" VerticalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="费用类型：" FontWeight="Bold" VerticalAlignment="Center" Margin="15,5,0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PaymentType}" VerticalAlignment="Center" Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="应收金额：" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:C}}" 
                                   VerticalAlignment="Center" Margin="5" FontWeight="Bold" FontSize="16" Foreground="#F44336"/>
                    </Grid>
                </GroupBox>

                <!-- 收费信息 -->
                <GroupBox Header="收费信息" Margin="0,0,0,20">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="实收金额：" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ActualAmount}" Height="35" 
                                 Margin="10" Padding="10,8" FontSize="14" BorderBrush="#DDDDDD" BorderThickness="1"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="支付方式：" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding PaymentMethod}" Height="35" 
                                  Margin="10" Padding="10,8" FontSize="14">
                            <ComboBoxItem Content="现金"/>
                            <ComboBoxItem Content="银行卡"/>
                            <ComboBoxItem Content="微信"/>
                            <ComboBoxItem Content="支付宝"/>
                            <ComboBoxItem Content="医保"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="备注：" FontWeight="Bold" VerticalAlignment="Top" Margin="0,10"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Remark}" Height="60" 
                                 Margin="10" Padding="10,8" FontSize="14" BorderBrush="#DDDDDD" BorderThickness="1"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </GroupBox>

                <!-- 找零信息 -->
                <Border Background="#E8F5E8" Padding="15" CornerRadius="5" 
                        Visibility="{Binding ShowChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="找零：" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ChangeAmount, StringFormat={}{0:C}}" 
                                   FontWeight="Bold" FontSize="18" Foreground="#4CAF50" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#F8F9FA" Padding="20" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确认收费" Command="{Binding ConfirmCommand}"
                        Width="120" Height="40" Margin="0,0,10,0"
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="Bold" CornerRadius="5"/>
                <Button Content="取消" Command="{Binding CancelCommand}"
                        Width="100" Height="40"
                        Background="#6C757D" Foreground="White" BorderThickness="0"
                        FontSize="14" CornerRadius="5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>