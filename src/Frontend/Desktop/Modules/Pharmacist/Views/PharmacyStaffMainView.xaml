<UserControl x:Class="LYBT.WPF.Client.Modules.Pharmacist.Views.PharmacyStaffMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#4CAF50" Padding="20,15">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="药房管理系统" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Pharmacy Management System" FontSize="14" Foreground="#C8E6C9" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="待配药：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PendingPrescriptionCount}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" 张" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧功能区 -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 快捷功能 -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="快捷功能" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Button Grid.Row="0" Grid.Column="0" Height="80"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DispenseCommand}">
                                <StackPanel>
                                    <TextBlock Text="💊" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="处方配药" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Grid.Row="0" Grid.Column="2" Height="80"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DrugInventoryCommand}">
                                <StackPanel>
                                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="药品入库" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Grid.Row="2" Grid.Column="0" Height="80"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding InventoryQueryCommand}">
                                <StackPanel>
                                    <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="库存查询" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Grid.Row="2" Grid.Column="2" Height="80"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DrugManagementCommand}">
                                <StackPanel>
                                    <TextBlock Text="⚙️" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="药品管理" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 库存预警 -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="库存预警" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LowStockCount}" FontSize="14" Foreground="Red" HorizontalAlignment="Right"/>
                        </Grid>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LowStockItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#EEEEEE" Padding="0,10">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DrugName}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding StockInfo}" FontSize="12" Foreground="#666666"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CurrentStock}" FontWeight="Bold" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                
                <!-- 今日统计 -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="今日统计" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="已配处方：" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TodayDispensedCount}" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="入库数量：" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TodayInventoryCount}" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="出库金额：" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TodayOutputAmount, StringFormat=¥{0:F2}}" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="库存盘点："/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastInventoryCheckTime}" FontWeight="Bold" Foreground="#666666"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- 右侧内容区 -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <ContentControl prism:RegionManager.RegionName="PharmacyContentRegion">
                    <!-- 默认显示待配药列表 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="待配药处方列表" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding PendingPrescriptions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="处方号" Binding="{Binding PrescriptionNo}" Width="120"/>
                                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                                <DataGridTextColumn Header="开方医生" Binding="{Binding DoctorName}" Width="100"/>
                                <DataGridTextColumn Header="药品数" Binding="{Binding DrugCount}" Width="80"/>
                                <DataGridTextColumn Header="开方时间" Binding="{Binding CreateTime, StringFormat={}{0:HH:mm}}" Width="80"/>
                                <DataGridTemplateColumn Header="操作" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="配药" 
                                                        Command="{Binding DataContext.DispensePrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        Margin="0,0,10,0"/>
                                                <Button Content="查看" 
                                                        Command="{Binding DataContext.ViewPrescriptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource LinkButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>