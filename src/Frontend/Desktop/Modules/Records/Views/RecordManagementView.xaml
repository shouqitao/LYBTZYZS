&lt;UserControl x:Class="LYBT.WPF.Client.Modules.Records.Views.RecordManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#607D8B" Padding="20,15">
            <Grid>
                <TextBlock Text="病历管理" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="总病历数：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalRecordCount}" Foreground="#FFEB3B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="份" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="今日新增：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TodayNewCount}" Foreground="#FFEB3B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="份" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索和筛选栏 -->
        <Border Grid.Row="1" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- 搜索框 -->
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                             Width="250" Height="35" Padding="10,8"
                             BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5"
                             Tag="搜索患者姓名、病历号或诊断">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding Border.CornerRadius}">
                                                <Grid>
                                                    <TextBlock Text="{TemplateBinding Tag}" 
                                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Foreground="#999999"
                                                               Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, 
                                                                            Converter={StaticResource StringToVisibilityConverter}}"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 医生筛选 -->
                    <ComboBox SelectedItem="{Binding SelectedDoctor}" Width="120" Height="35" 
                              Margin="15,0,0,0" VerticalContentAlignment="Center"
                              DisplayMemberPath="Name" SelectedValuePath="Id">
                        <ComboBoxItem Content="全部医生"/>
                    </ComboBox>

                    <!-- 日期范围筛选 -->
                    <TextBlock Text="日期：" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="35" 
                                VerticalContentAlignment="Center"/>
                    <TextBlock Text="至" VerticalAlignment="Center" Margin="5"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="35" 
                                VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="搜索" Command="{Binding SearchCommand}"
                            Width="80" Height="35" Margin="0,0,10,0"
                            Background="#607D8B" Foreground="White" BorderThickness="0"
                            FontSize="14" CornerRadius="5"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}"
                            Width="80" Height="35" Margin="0,0,10,0"
                            Background="#2196F3" Foreground="White" BorderThickness="0"
                            FontSize="14" CornerRadius="5"/>
                    <Button Content="导出" Command="{Binding ExportCommand}"
                            Width="80" Height="35"
                            Background="#4CAF50" Foreground="White" BorderThickness="0"
                            FontSize="14" CornerRadius="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 病历列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding RecordList}"
                  SelectedItem="{Binding SelectedRecord}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" IsReadOnly="True" Margin="20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Width="60" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                 Path="Header"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="病历号" Binding="{Binding RecordNumber}" Width="120"/>
                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                <DataGridTextColumn Header="性别/年龄" Width="80">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0}/{1}岁">
                            <Binding Path="Gender"/>
                            <Binding Path="Age"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="主诉" Binding="{Binding ChiefComplaint}" Width="200"/>
                <DataGridTextColumn Header="诊断" Binding="{Binding Diagnosis}" Width="200"/>
                <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="100"/>
                <DataGridTextColumn Header="就诊时间" Binding="{Binding VisitDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="查看" 
                                        Command="{Binding DataContext.ViewRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#2196F3" Foreground="White" BorderThickness="0"
                                        Padding="5,2" Margin="2"/>
                                <Button Content="编辑" 
                                        Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#FF9800" Foreground="White" BorderThickness="0"
                                        Padding="5,2" Margin="2"/>
                                <Button Content="打印" 
                                        Command="{Binding DataContext.PrintRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                                        Padding="5,2" Margin="2"/>
                                <Button Content="删除" 
                                        Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#F44336" Foreground="White" BorderThickness="0"
                                        Padding="5,2" Margin="2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F5F5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>