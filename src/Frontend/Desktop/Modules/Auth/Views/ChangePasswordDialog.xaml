<Window x:Class="LYBT.WPF.Client.Modules.Auth.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}" 
        Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="修改密码" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="为了您的账户安全，请定期修改密码" 
                       FontSize="12" Foreground="#7F8C8D" 
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 表单内容 -->
        <StackPanel Grid.Row="1">
            <!-- 当前密码 -->
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="当前密码 *" FontWeight="Bold" Margin="0,0,0,5"/>
                <PasswordBox Grid.Row="1" 
                             x:Name="CurrentPasswordBox"
                             Height="35" 
                             Padding="8,5"
                             FontSize="14"/>
            </Grid>

            <!-- 新密码 -->
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="新密码 *" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Column="1" Text="{Binding PasswordStrength}" 
                               Margin="0,0,0,5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PasswordStrength}" Value="弱">
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PasswordStrength}" Value="中">
                                        <Setter Property="Foreground" Value="#F39C12"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PasswordStrength}" Value="强">
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <PasswordBox Grid.Row="1" 
                             x:Name="NewPasswordBox"
                             Height="35" 
                             Padding="8,5"
                             FontSize="14"/>
                <TextBlock Grid.Row="2" 
                           Text="密码必须包含大小写字母、数字和特殊字符，长度至少6位" 
                           FontSize="11" 
                           Foreground="#7F8C8D"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </Grid>

            <!-- 确认新密码 -->
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="确认新密码 *" FontWeight="Bold" Margin="0,0,0,5"/>
                <PasswordBox Grid.Row="1" 
                             x:Name="ConfirmPasswordBox"
                             Height="35" 
                             Padding="8,5"
                             FontSize="14"/>
            </Grid>

            <!-- 错误消息 -->
            <TextBlock Text="{Binding ErrorMessage}" 
                       Foreground="#E74C3C"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                       Margin="0,0,0,10"/>

            <!-- 加载指示器 -->
            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Margin="0,0,0,10"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="保存" 
                    Width="100" Height="35" 
                    Margin="0,0,10,0"
                    Command="{Binding SaveCommand}"
                    Background="#27AE60" 
                    Foreground="White" 
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#229954"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#BDC3C7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="取消" 
                    Width="100" Height="35"
                    Command="{Binding CancelCommand}"
                    Background="#95A5A6" 
                    Foreground="White" 
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#7F8C8D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>