<Window x:Class="LYBT.WPF.Client.Modules.Auth.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="凌隐宝堂中医诊所 - 用户登录" 
        Height="550" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Border CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10,10,0,0" Height="40">
                <Grid>
                    <TextBlock Text="凌隐宝堂中医诊所管理系统" 
                               Foreground="White" 
                               FontSize="14" 
                               VerticalAlignment="Center" 
                               Margin="15,0,0,0"/>
                    <Button HorizontalAlignment="Right" 
                            Width="40" Height="40" 
                            Background="Transparent" 
                            BorderThickness="0"
                            Command="{Binding ExitCommand}"
                            Cursor="Hand">
                        <TextBlock Text="✕" Foreground="White" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 主内容区 -->
            <Grid Grid.Row="1" Margin="40,30,40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo和标题 -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="🏥" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="凌隐宝堂" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Foreground="#2C3E50"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="中医诊所管理系统" 
                               FontSize="14" 
                               HorizontalAlignment="Center" 
                               Foreground="#7F8C8D"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 服务器状态 -->
                <Border Grid.Row="1" 
                        Background="#F0F0F0" 
                        CornerRadius="5" 
                        Padding="10,8" 
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="服务器状态：" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ServerStatus}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <Button Grid.Column="2" 
                                Content="刷新" 
                                Command="{Binding CheckServerCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#3498DB"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- 用户名输入 -->
                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👤" FontSize="16" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="用户名"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             FontSize="14"/>
                </Grid>

                <!-- 密码输入 -->
                <Grid Grid.Row="3" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔒" FontSize="16" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Column="1" 
                                 x:Name="PasswordBox"
                                 materialDesign:HintAssist.Hint="密码"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 FontSize="14">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding LoginCommand}"/>
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                </Grid>

                <!-- 记住我复选框 -->
                <CheckBox Grid.Row="4" 
                          Content="记住我" 
                          IsChecked="{Binding RememberMe}"
                          Margin="30,0,0,20"/>

                <!-- 错误消息 -->
                <TextBlock Grid.Row="5" 
                           Text="{Binding ErrorMessage}" 
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,0,0,10"/>

                <!-- 登录按钮 -->
                <Button Grid.Row="6" 
                        Content="登 录" 
                        Command="{Binding LoginCommand}"
                        Height="45"
                        FontSize="16"
                        Background="#27AE60"
                        BorderThickness="0"
                        Foreground="White"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#229954"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDC3C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 加载指示器 -->
                <ProgressBar Grid.Row="7" 
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Margin="0,10,0,0"/>
            </Grid>

            <!-- 底部版权信息 -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,10,10" Height="40">
                <TextBlock Text="© 2025 凌隐宝堂中医诊所 版权所有" 
                           Foreground="#7F8C8D"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>