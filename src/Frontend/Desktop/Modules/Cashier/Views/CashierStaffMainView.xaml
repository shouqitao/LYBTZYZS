<UserControl x:Class="LYBT.WPF.Client.Modules.Cashier.Views.CashierStaffMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#FF9800" Padding="20,15">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="收银管理系统" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Cashier Management System" FontSize="14" Foreground="#FFE0B2" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="今日收款：¥" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TodayTotalAmount}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 快捷功能按钮 -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <WrapPanel>
                    <Button Width="150" Height="100" Margin="0,0,20,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewPaymentCommand}">
                        <StackPanel>
                            <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="收费结算" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Width="150" Height="100" Margin="0,0,20,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefundCommand}">
                        <StackPanel>
                            <TextBlock Text="💸" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="退费处理" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Width="150" Height="100" Margin="0,0,20,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding InvoiceCommand}">
                        <StackPanel>
                            <TextBlock Text="📄" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="发票管理" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Width="150" Height="100"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DailyReportCommand}">
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="日结报表" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>
            
            <!-- 主要内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧：待收费列表 -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="待收费列表" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding PendingPayments}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                                <DataGridTextColumn Header="就诊科室" Binding="{Binding Department}" Width="100"/>
                                <DataGridTextColumn Header="费用类型" Binding="{Binding FeeType}" Width="100"/>
                                <DataGridTextColumn Header="金额(元)" Binding="{Binding Amount, StringFormat={}{0:F2}}" Width="100"/>
                                <DataGridTemplateColumn Header="操作" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="收费" 
                                                    Command="{Binding DataContext.ProcessPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource LinkButtonStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                
                <!-- 右侧：今日统计 -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="今日统计" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="收费笔数：" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TodayTransactionCount}" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="现金收款：" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TodayCashAmount, StringFormat=¥{0:F2}}" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="支付宝：" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TodayAlipayAmount, StringFormat=¥{0:F2}}" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="微信支付：" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TodayWechatAmount, StringFormat=¥{0:F2}}" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                            
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="退费金额：" Margin="0,0,0,15"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TodayRefundAmount, StringFormat=¥{0:F2}}" FontWeight="Bold" FontSize="16" Foreground="Red" Margin="0,0,0,15"/>
                            
                            <Border Grid.Row="5" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="#DDDDDD" Padding="0,15,0,0">
                                <Grid>
                                    <TextBlock Text="合计：" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding TodayNetAmount, StringFormat=¥{0:F2}}" FontWeight="Bold" FontSize="20" Foreground="#4CAF50" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>