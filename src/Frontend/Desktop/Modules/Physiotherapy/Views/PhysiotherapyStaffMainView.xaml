<UserControl x:Class="LYBT.WPF.Client.Modules.Physiotherapy.Views.PhysiotherapyStaffMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="20,15">
            <TextBlock Text="理疗管理系统" FontSize="24" FontWeight="Bold" Foreground="#333333"/>
        </Border>
        
        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 功能按钮区 -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,20">
                <Button Content="今日预约" Width="120" Height="40" Margin="0,0,10,0" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding TodayAppointmentsCommand}"/>
                <Button Content="开始理疗" Width="120" Height="40" Margin="0,0,10,0" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StartTherapyCommand}"/>
                <Button Content="理疗记录" Width="120" Height="40" Margin="0,0,10,0" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding TherapyRecordsCommand}"/>
                <Button Content="项目管理" Width="120" Height="40" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ProjectManagementCommand}"/>
            </WrapPanel>
            
            <!-- 内容展示区 -->
            <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <TextBlock Text="欢迎使用理疗管理系统" 
                               FontSize="20" 
                               Foreground="#999999"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>