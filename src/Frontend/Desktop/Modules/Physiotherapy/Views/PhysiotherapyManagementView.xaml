<UserControl x:Class="LYBT.WPF.Client.Modules.Physiotherapy.Views.PhysiotherapyManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#795548" Padding="20,15">
            <Grid>
                <TextBlock Text="理疗管理" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="待理疗：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PendingCount}" Foreground="#FFEB3B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="人" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="今日理疗：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TodayTreatmentCount}" Foreground="#FFEB3B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="人" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- 理疗预约 -->
            <TabItem Header="理疗预约">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- 搜索框 -->
                                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="250" Height="35" Padding="10,8"
                                         BorderBrush="#DDDDDD" BorderThickness="1"
                                         Tag="搜索患者姓名或预约号">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="5">
                                                            <Grid>
                                                                <TextBlock Text="{TemplateBinding Tag}" 
                                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="#999999"
                                                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, 
                                                                                        Converter={StaticResource StringToVisibilityConverter}}"/>
                                                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- 状态筛选 -->
                                <ComboBox SelectedItem="{Binding SelectedStatus}" Width="120" Height="35" 
                                          Margin="15,0,0,0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="全部状态"/>
                                    <ComboBoxItem Content="已预约"/>
                                    <ComboBoxItem Content="理疗中"/>
                                    <ComboBoxItem Content="已完成"/>
                                    <ComboBoxItem Content="已取消"/>
                                </ComboBox>

                                <!-- 日期筛选 -->
                                <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Height="35" 
                                            Margin="15,0,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="新增预约" Command="{Binding AddAppointmentCommand}"
                                        Width="100" Height="35" Margin="0,0,10,0"
                                        Background="#795548" Foreground="White" BorderThickness="0"
                                        FontSize="14"/>
                                <Button Content="搜索" Command="{Binding SearchCommand}"
                                        Width="80" Height="35" Margin="0,0,10,0"
                                        Background="#2196F3" Foreground="White" BorderThickness="0"
                                        FontSize="14"/>
                                <Button Content="刷新" Command="{Binding RefreshCommand}"
                                        Width="80" Height="35"
                                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                                        FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 预约列表 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AppointmentList}"
                              SelectedItem="{Binding SelectedAppointment}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Width="60" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                             Path="Header"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="预约号" Binding="{Binding AppointmentNumber}" Width="120"/>
                            <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                            <DataGridTextColumn Header="性别/年龄" Width="80">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}/{1}岁">
                                        <Binding Path="Gender"/>
                                        <Binding Path="Age"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="理疗项目" Binding="{Binding TreatmentType}" Width="120"/>
                            <DataGridTextColumn Header="理疗师" Binding="{Binding TherapistName}" Width="100"/>
                            <DataGridTextColumn Header="预约时间" Binding="{Binding AppointmentTime, StringFormat={}{0:MM-dd HH:mm}}" Width="120"/>
                            <DataGridTextColumn Header="预计时长" Binding="{Binding EstimatedDuration}" Width="80"/>
                            <DataGridTextColumn Header="费用" Binding="{Binding Cost, StringFormat={}{0:C}}" Width="80"/>
                            <DataGridTemplateColumn Header="状态" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" Padding="5,2" CornerRadius="3">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" 
                                                       HorizontalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="开始理疗" 
                                                    Command="{Binding DataContext.StartTreatmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                                                    Padding="5,2" Margin="2"
                                                    Visibility="{Binding CanStartTreatment, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="完成理疗" 
                                                    Command="{Binding DataContext.CompleteTreatmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#FF9800" Foreground="White" BorderThickness="0"
                                                    Padding="5,2" Margin="2"
                                                    Visibility="{Binding CanCompleteTreatment, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="编辑" 
                                                    Command="{Binding DataContext.EditAppointmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#9C27B0" Foreground="White" BorderThickness="0"
                                                    Padding="5,2" Margin="2"/>
                                            <Button Content="取消" 
                                                    Command="{Binding DataContext.CancelAppointmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#F44336" Foreground="White" BorderThickness="0"
                                                    Padding="5,2" Margin="2"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 理疗项目管理 -->
            <TabItem Header="项目管理">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新增项目" Command="{Binding AddTreatmentTypeCommand}"
                                    Width="100" Height="35" Margin="0,0,10,0"
                                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                                    FontSize="14"/>
                            <Button Content="编辑项目" Command="{Binding EditTreatmentTypeCommand}"
                                    Width="100" Height="35" Margin="0,0,10,0"
                                    Background="#FF9800" Foreground="White" BorderThickness="0"
                                    FontSize="14"/>
                            <Button Content="删除项目" Command="{Binding DeleteTreatmentTypeCommand}"
                                    Width="100" Height="35"
                                    Background="#F44336" Foreground="White" BorderThickness="0"
                                    FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- 项目列表 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TreatmentTypeList}"
                              SelectedItem="{Binding SelectedTreatmentType}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="项目描述" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="标准价格" Binding="{Binding StandardPrice, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="标准时长" Binding="{Binding StandardDuration}" Width="100"/>
                            <DataGridTextColumn Header="适用部位" Binding="{Binding ApplicableParts}" Width="150"/>
                            <DataGridTemplateColumn Header="状态" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsActive, Converter={StaticResource BooleanToColorConverter}}" 
                                                Padding="5,2" CornerRadius="3">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToActiveTextConverter}}" 
                                                       Foreground="White" HorizontalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>