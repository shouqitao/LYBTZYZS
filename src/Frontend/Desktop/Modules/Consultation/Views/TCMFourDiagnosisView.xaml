<UserControl x:Class="LYBT.WPF.Client.Modules.Consultation.Views.TCMFourDiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- 标题 -->
                <TextBlock Text="中医四诊记录" 
                           Style="{StaticResource PageTitleStyle}"/>
                
                <!-- 望诊 -->
                <GroupBox Header="望诊（观察患者外观、舌象等）" 
                          Style="{StaticResource ModernGroupBoxStyle}"
                          Margin="0,0,0,16">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBox Grid.Row="0"
                                 Text="{Binding CurrentConsultation.Inspection, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="请输入望诊内容（如：面色、神态、形体、舌质、舌苔等）"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 MaxLength="500"/>
                        
                        <!-- 舌诊单独记录 -->
                        <TextBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Text="{Binding CurrentConsultation.TongueInspection, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="舌诊详细描述（舌质、舌苔）"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40"
                                 MaxLength="200"/>
                    </Grid>
                </GroupBox>
                
                <!-- 闻诊 -->
                <GroupBox Header="闻诊（听声音、嗅气味）" 
                          Style="{StaticResource ModernGroupBoxStyle}"
                          Margin="0,0,0,16">
                    <TextBox Text="{Binding CurrentConsultation.AuscultationOlfaction, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="请输入闻诊内容（如：声音、呼吸、咳嗽、气味等）"
                             Style="{StaticResource ModernTextBoxStyle}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="80"
                             MaxLength="500"
                             Margin="8"/>
                </GroupBox>
                
                <!-- 问诊 -->
                <GroupBox Header="问诊（询问症状、病史）" 
                          Style="{StaticResource ModernGroupBoxStyle}"
                          Margin="0,0,0,16">
                    <TextBox Text="{Binding CurrentConsultation.Inquiry, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="请输入问诊内容（如：主诉、现病史、寒热、汗、头身、胸腹、饮食、二便、睡眠等）"
                             Style="{StaticResource ModernTextBoxStyle}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="120"
                             MaxLength="1000"
                             Margin="8"/>
                </GroupBox>
                
                <!-- 切诊 -->
                <GroupBox Header="切诊（脉诊、按诊）" 
                          Style="{StaticResource ModernGroupBoxStyle}"
                          Margin="0,0,0,16">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBox Grid.Row="0"
                                 Text="{Binding CurrentConsultation.Palpation, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="请输入切诊内容（如：脉象、按诊等）"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 MaxLength="500"/>
                        
                        <!-- 脉诊单独记录 -->
                        <TextBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Text="{Binding CurrentConsultation.PulseCondition, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="脉诊详细描述（左右脉、脉率、脉律、脉力、脉形）"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40"
                                 MaxLength="200"/>
                    </Grid>
                </GroupBox>
                
                <!-- 辨证论治 -->
                <GroupBox Header="辨证论治" 
                          Style="{StaticResource ModernGroupBoxStyle}"
                          Margin="0,0,0,16">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 中医诊断 -->
                        <TextBox Grid.Row="0"
                                 Text="{Binding CurrentConsultation.TCMDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="中医诊断（证型）"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 MaxLength="500"/>
                        
                        <!-- 治疗原则 -->
                        <TextBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Text="{Binding CurrentConsultation.TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="治疗原则（治法）"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40"
                                 MaxLength="200"/>
                        
                        <!-- 医嘱 -->
                        <TextBox Grid.Row="2"
                                 Margin="0,8,0,0"
                                 Text="{Binding CurrentConsultation.MedicalAdvice, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="医嘱建议"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 MaxLength="500"/>
                        
                        <!-- 备注 -->
                        <TextBox Grid.Row="3"
                                 Margin="0,8,0,0"
                                 Text="{Binding CurrentConsultation.Remark, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="备注信息"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40"
                                 MaxLength="1000"/>
                    </Grid>
                </GroupBox>
                
                <!-- 常用模板快捷输入 -->
                <Expander Header="常用模板" Margin="0,0,0,16">
                    <WrapPanel Margin="8">
                        <!-- 望诊模板 -->
                        <Button Content="面色红润" 
                                Command="{Binding QuickInputCommand}"
                                CommandParameter="Inspection:面色红润，精神尚可"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource SecondaryBrush}"
                                Foreground="White"
                                Margin="4"/>
                        <Button Content="面色苍白" 
                                Command="{Binding QuickInputCommand}"
                                CommandParameter="Inspection:面色苍白，神疲乏力"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource SecondaryBrush}"
                                Foreground="White"
                                Margin="4"/>
                        
                        <!-- 舌诊模板 -->
                        <Button Content="舌淡苔白" 
                                Command="{Binding QuickInputCommand}"
                                CommandParameter="TongueInspection:舌质淡红，苔薄白"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource SecondaryBrush}"
                                Foreground="White"
                                Margin="4"/>
                        <Button Content="舌红苔黄" 
                                Command="{Binding QuickInputCommand}"
                                CommandParameter="TongueInspection:舌质红，苔黄腻"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource SecondaryBrush}"
                                Foreground="White"
                                Margin="4"/>
                        
                        <!-- 脉诊模板 -->
                        <Button Content="脉浮数" 
                                Command="{Binding QuickInputCommand}"
                                CommandParameter="PulseCondition:脉浮数有力"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource SecondaryBrush}"
                                Foreground="White"
                                Margin="4"/>
                        <Button Content="脉沉细" 
                                Command="{Binding QuickInputCommand}"
                                CommandParameter="PulseCondition:脉沉细无力"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource SecondaryBrush}"
                                Foreground="White"
                                Margin="4"/>
                        <Button Content="脉弦滑" 
                                Command="{Binding QuickInputCommand}"
                                CommandParameter="PulseCondition:脉弦滑"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource SecondaryBrush}"
                                Foreground="White"
                                Margin="4"/>
                    </WrapPanel>
                </Expander>
                
                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,16,0,0">
                    <Button Content="清空" 
                            Command="{Binding ClearFourDiagnosisCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource WarningBrush}"
                            Foreground="White"
                            Margin="0,0,8,0"
                            Width="100"/>
                    <Button Content="保存四诊" 
                            Command="{Binding SaveConsultationCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="120"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>