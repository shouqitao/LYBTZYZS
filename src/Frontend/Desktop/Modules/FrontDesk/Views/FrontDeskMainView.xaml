<UserControl x:Class="LYBT.WPF.Client.Modules.FrontDesk.Views.FrontDeskMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.WPF.Client.Modules.FrontDesk.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏥" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="前台接待工作台" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="Front Desk Reception" FontSize="14" Foreground="#B3D9F2" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Background="#F8F9FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：患者管理和挂号 -->
            <Grid Grid.Column="0" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 患者搜索和快速操作 -->
                <GroupBox Grid.Row="0" Header="患者搜索" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="200" Height="25" Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="输入患者姓名、电话或身份证号"/>
                            <Button Content="搜索患者" Command="{Binding SearchPatientCommand}" 
                                   Width="80" Height="25" Background="#2196F3" Foreground="White" Margin="0,0,10,0"/>
                            <Button Content="刷新" Command="{Binding RefreshCommand}" 
                                   Width="60" Height="25" Background="#607D8B" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding TodayRegistrationCount}" 
                                     FontWeight="Bold" Foreground="#2196F3" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="{Binding WaitingQueueCount}" 
                                     FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 新患者注册 -->
                <GroupBox Grid.Row="1" Header="新患者注册" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名：" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewPatientName}" 
                                Height="25" Margin="0,0,10,5" VerticalContentAlignment="Center"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="性别：" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" SelectedValue="{Binding NewPatientGender}" 
                                 SelectedValuePath="Tag" Height="25" Margin="0,0,0,5">
                            <ComboBoxItem Content="未知" Tag="0"/>
                            <ComboBoxItem Content="男" Tag="1"/>
                            <ComboBoxItem Content="女" Tag="2"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="电话：" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewPatientPhone}" 
                                Height="25" Margin="0,0,10,5" VerticalContentAlignment="Center"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="年龄：" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding NewPatientAge}" 
                                Height="25" Margin="0,0,0,5" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="地址：" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewPatientAddress}" 
                                Height="25" Margin="0,0,10,10" VerticalContentAlignment="Center"/>
                        
                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" 
                                   HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="清空" Command="{Binding ClearNewPatientFormCommand}" 
                                   Width="60" Height="25" Background="#757575" Foreground="White" Margin="0,0,10,0"/>
                            <Button Content="注册患者" Command="{Binding RegisterNewPatientCommand}" 
                                   Width="80" Height="25" Background="#4CAF50" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 今日挂号患者列表 -->
                <GroupBox Grid.Row="2" Header="今日患者列表">
                    <DataGrid ItemsSource="{Binding TodayRegistrations}" SelectedItem="{Binding SelectedPatient}"
                             AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                             GridLinesVisibility="Horizontal" AlternatingRowBackground="#F9F9F9"
                             SelectionMode="Single" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="80"/>
                            <DataGridTextColumn Header="性别" Width="50">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Gender">
                                        <Binding.Converter>
                                            <converters:GenderToTextConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="50"/>
                            <DataGridTextColumn Header="电话" Binding="{Binding PhoneNumber}" Width="100"/>
                            <DataGridTemplateColumn Header="操作" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="加入队列" CommandParameter="{Binding}" 
                                                   Command="{Binding DataContext.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="60" Height="20" Background="#4CAF50" Foreground="White" Margin="2"/>
                                            <Button Content="详情" CommandParameter="{Binding}" 
                                                   Command="{Binding DataContext.ViewPatientInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="40" Height="20" Background="#2196F3" Foreground="White" Margin="2"/>
                                            <Button Content="病历" CommandParameter="{Binding}" 
                                                   Command="{Binding DataContext.ViewPatientHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="40" Height="20" Background="#FF9800" Foreground="White" Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- 右侧：等待队列和快速操作 -->
            <Grid Grid.Column="2" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 等待队列 -->
                <GroupBox Grid.Row="0" Header="等待就诊队列" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding WaitingQueueCount}" 
                                 FontSize="16" FontWeight="Bold" Foreground="#FF9800" 
                                 HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        
                        <ItemsControl ItemsSource="{Binding WaitingQueue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="5" Margin="0,2" Padding="10,5"
                                           BorderBrush="#E0E0E0" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="1" 
                                                             Opacity="0.1" BlurRadius="3"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding PhoneNumber}" FontSize="12" Foreground="#666"/>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="1" Content="×" CommandParameter="{Binding}"
                                                   Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="20" Height="20" Background="#F44336" Foreground="White"
                                                   ToolTip="从队列中移除"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <!-- 快速操作面板 -->
                <GroupBox Grid.Row="2" Header="快速操作">
                    <StackPanel Margin="10">
                        <Button Content="🔄 刷新数据" Command="{Binding RefreshCommand}" 
                               Height="35" Background="#607D8B" Foreground="White" Margin="0,5"/>
                        <Button Content="📋 今日统计" 
                               Height="35" Background="#9C27B0" Foreground="White" Margin="0,5"
                               ToolTip="查看今日挂号统计"/>
                        <Button Content="📞 呼叫下一位" 
                               Height="35" Background="#FF9800" Foreground="White" Margin="0,5"
                               ToolTip="呼叫队列中的下一位患者"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- 加载指示器 -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3" 
                  Background="#80000000" 
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,10"/>
                    <TextBlock Text="正在处理..." Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- 性别转换器 -->
        <converters:GenderToTextConverter x:Key="GenderToTextConverter"/>
    </UserControl.Resources>
</UserControl>