<UserControl x:Class="LYBT.WPF.Client.Modules.FrontDesk.Views.FrontDeskMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.WPF.Client.Modules.FrontDesk.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <UserControl.Resources>
        <converters:GenderToTextConverter x:Key="GenderConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="🏥" FontSize="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="前台接待工作台" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Front Desk Reception" FontSize="14" Foreground="#B3D9F2" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TodayRegistrationCount}" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding WaitingQueueCount}" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" 
                            Background="White" Foreground="#2196F3" 
                            BorderThickness="0" Padding="10,5" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Background="#F8F9FA">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：患者搜索、创建和挂号 -->
            <Grid Grid.Column="0" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 步骤1：患者搜索 -->
                <GroupBox Grid.Row="0" Header="步骤1：查找或创建患者" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 搜索栏 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="35" VerticalContentAlignment="Center" FontSize="14">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchPatientCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Grid.Column="0" Text="输入患者姓名、手机号或身份证号进行搜索..." 
                                       Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchKeyword}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <Button Grid.Column="1" Content="搜索患者" Command="{Binding SearchPatientCommand}" 
                                    Background="#4CAF50" Foreground="White" BorderThickness="0" 
                                    Padding="15,8" Margin="5,0" Cursor="Hand" FontSize="14"/>
                            <Button Grid.Column="2" Content="新建患者" Command="{Binding ShowCreatePatientCommand}" 
                                    Background="#FF9800" Foreground="White" BorderThickness="0" 
                                    Padding="15,8" Cursor="Hand" FontSize="14"/>
                        </Grid>

                        <!-- 搜索结果统计 -->
                        <TextBlock Grid.Row="1" Text="{Binding SearchResultsCount}" 
                                   Foreground="#666" Margin="0,10,0,5" FontSize="12"/>

                        <!-- 创建患者面板 -->
                        <Border Grid.Row="2" Background="#FFF3E0" Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding ShowCreatePatientPanel, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="快速创建新患者" FontWeight="Bold" Margin="0,0,0,10"/>
                                
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBox Grid.Column="0" Grid.Row="0" Text="{Binding NewPatientName}" 
                                             Tag="姓名*" Margin="0,0,5,5"/>
                                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding NewPatientPhone}" 
                                             Tag="手机号*" Margin="0,0,5,5"/>
                                    <TextBox Grid.Column="2" Grid.Row="0" Text="{Binding NewPatientAge}" 
                                             Tag="年龄" Margin="0,0,5,5"/>
                                    <ComboBox Grid.Column="3" Grid.Row="0" SelectedIndex="{Binding NewPatientGender}" 
                                              Margin="0,0,0,5">
                                        <ComboBoxItem>未知</ComboBoxItem>
                                        <ComboBoxItem>男</ComboBoxItem>
                                        <ComboBoxItem>女</ComboBoxItem>
                                    </ComboBox>
                                    
                                    <TextBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" 
                                             Text="{Binding NewPatientIDNumber}" 
                                             Tag="身份证号" Margin="0,0,5,5"/>
                                    <TextBox Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" 
                                             Text="{Binding NewPatientAddress}" 
                                             Tag="地址" Margin="0,0,0,5"/>
                                </Grid>
                                
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="保存并选中" Command="{Binding RegisterNewPatientCommand}" 
                                            Background="#4CAF50" Foreground="White" BorderThickness="0" 
                                            Padding="10,5" Margin="0,0,5,0" Cursor="Hand"/>
                                    <Button Content="取消" Command="{Binding CancelCreatePatientCommand}" 
                                            Background="#F44336" Foreground="White" BorderThickness="0" 
                                            Padding="10,5" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- 步骤2：患者列表（搜索结果） -->
                <GroupBox Grid.Row="1" Header="搜索结果 - 点击选择患者">
                    <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedPatient}"
                              AutoGenerateColumns="False" CanUserAddRows="False" 
                              SelectionMode="Single" GridLinesVisibility="None"
                              HeadersVisibility="Column" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="80"/>
                            <DataGridTextColumn Header="性别" Binding="{Binding Gender, Converter={StaticResource GenderConverter}}" Width="50"/>
                            <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="50"/>
                            <DataGridTextColumn Header="电话" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="身份证" Binding="{Binding IDNumber}" Width="180"/>
                            <DataGridTemplateColumn Header="操作" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="选择挂号" 
                                                Command="{Binding DataContext.SelectPatientForRegistrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#2196F3" Foreground="White" 
                                                BorderThickness="0" Padding="8,3" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- 步骤3：创建挂号 -->
                <GroupBox Grid.Row="2" Header="步骤2：创建挂号" 
                          Visibility="{Binding ShowRegistrationPanel, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="选中患者：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding RegistrationPatientName}" 
                                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Grid.Row="1" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="选择医生：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDoctors}" 
                                      SelectedItem="{Binding SelectedDoctor}"
                                      DisplayMemberPath="Name"/>
                        </Grid>
                        
                        <Grid Grid.Row="2" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="备注信息：" VerticalAlignment="Top" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding RegistrationRemark}" 
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                        </Grid>
                        
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="确认挂号" Command="{Binding CreateRegistrationCommand}" 
                                    Background="#4CAF50" Foreground="White" BorderThickness="0" 
                                    Padding="15,8" Margin="0,0,5,0" Cursor="Hand" FontSize="14" FontWeight="Bold"/>
                            <Button Content="取消" 
                                    Command="{Binding CancelCreatePatientCommand}"
                                    Background="#F44336" Foreground="White" BorderThickness="0" 
                                    Padding="15,8" Cursor="Hand" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="1" Background="#E0E0E0" 
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- 右侧：今日挂号列表和等待队列 -->
            <Grid Grid.Column="2" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 今日挂号列表 -->
                <GroupBox Grid.Row="0" Header="今日挂号列表" Margin="0,0,0,10">
                    <DataGrid ItemsSource="{Binding TodayRegistrations}" 
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="None" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding RegistrationTime, StringFormat='{}{0:HH:mm}'}" Width="60"/>
                            <DataGridTextColumn Header="患者" Binding="{Binding PatientName}" Width="80"/>
                            <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="80"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- 等待队列 -->
                <GroupBox Grid.Row="1" Header="等待就诊队列">
                    <DataGrid ItemsSource="{Binding WaitingQueue}" 
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="None" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding QueueNumber}" Width="50"/>
                            <DataGridTextColumn Header="患者" Binding="{Binding Name}" Width="80"/>
                            <DataGridTextColumn Header="等待时间" Binding="{Binding WaitingTime}" Width="80"/>
                            <DataGridTemplateColumn Header="操作" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="移除" 
                                                Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#F44336" Foreground="White" 
                                                BorderThickness="0" Padding="5,2" Cursor="Hand" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 加载指示器 -->
        <Border Grid.Row="1" Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="100" Height="4"/>
                <TextBlock Text="处理中..." Foreground="White" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>