<UserControl x:Class="LYBT.WPF.Client.Modules.Queueing.Views.QueueingMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题和操作栏 -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 科室选择 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="科室：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding Departments}"
                              SelectedItem="{Binding SelectedDepartment}"
                              MinWidth="120"
                              Style="{StaticResource MaterialDesignComboBox}"/>
                </StackPanel>
                
                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="刷新队列" 
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="呼叫下一位" 
                            Command="{Binding CallNextCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource PrimaryHueMidBrush}"
                            Margin="0,0,10,0"/>
                    <Button Content="重置队列" 
                            Command="{Binding ResetQueueCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource ValidationErrorBrush}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
        
        <!-- 排队状态显示 -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 等待队列 -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,5,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="{StaticResource PrimaryHueMidBrush}" Padding="15">
                        <TextBlock Text="等待队列" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    </Border>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding WaitingQueue}" 
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="LightYellow" Margin="5" Padding="10" CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Text="{Binding QueueNumber}" 
                                                 FontWeight="Bold" FontSize="18" Foreground="DarkBlue"/>
                                        <TextBlock Grid.Row="1" Text="{Binding PatientName}" 
                                                 FontSize="14" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Row="2" Text="{Binding DoctorName}" 
                                                 FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </materialDesign:Card>
            
            <!-- 就诊中队列 -->
            <materialDesign:Card Grid.Column="1" Margin="5,0,5,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="Orange" Padding="15">
                        <TextBlock Text="就诊中" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    </Border>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding ProcessingQueue}" 
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="LightGreen" Margin="5" Padding="10" CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Text="{Binding QueueNumber}" 
                                                 FontWeight="Bold" FontSize="18" Foreground="DarkGreen"/>
                                        <TextBlock Grid.Row="1" Text="{Binding PatientName}" 
                                                 FontSize="14" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Row="2" Text="{Binding DoctorName}" 
                                                 FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </materialDesign:Card>
            
            <!-- 已完成队列 -->
            <materialDesign:Card Grid.Column="2" Margin="5,0,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="Gray" Padding="15">
                        <TextBlock Text="已完成" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    </Border>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding CompletedQueue}" 
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="LightGray" Margin="5" Padding="10" CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Text="{Binding QueueNumber}" 
                                                 FontWeight="Bold" FontSize="18" Foreground="DarkGray"/>
                                        <TextBlock Grid.Row="1" Text="{Binding PatientName}" 
                                                 FontSize="14" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Row="2" Text="{Binding DoctorName}" 
                                                 FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </materialDesign:Card>
            
        </Grid>
        
        <!-- 加载指示器 -->
        <Grid Grid.Row="1" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80FFFFFF">
            <ProgressBar IsIndeterminate="True"
                       Style="{StaticResource MaterialDesignCircularProgressBar}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Width="50" Height="50"/>
        </Grid>
        
    </Grid>
</UserControl>