using System;
using System.Collections.ObjectModel;
using System.Linq;
using System.Threading.Tasks;
using LYBT.WPF.Client.Core.Interfaces.Services;
using LYBT.WPF.Client.Core.Models.MedicalCase;
using LYBT.WPF.Client.Core.Models.Patients;
using LYBT.WPF.Client.Core.ViewModels;
using Prism.Commands;
using Prism.Dialogs;
using LYBT.Shared.Models.Contracts.MedicalCase;
using LYBT.Shared.Models.Enums;

namespace LYBT.WPF.Client.Modules.MedicalCase.ViewModels
{
    /// <summary>
    /// 创建医疗案例对话框视图模型
    /// </summary>
    public class CreateMedicalCaseViewModel : DialogViewModelBase, IDialogAware
    {
        private readonly IMedicalCaseService _medicalCaseService;
        private readonly IPatientService _patientService;
        private readonly IUserSessionManager _userSessionManager;
        private readonly ICommonDialogService _commonDialogService;

        #region 属性

        private string _mode = "Add";
        public string Mode
        {
            get => _mode;
            set => SetProperty(ref _mode, value);
        }

        private MedicalCaseInfo _currentMedicalCase;
        public MedicalCaseInfo CurrentMedicalCase
        {
            get => _currentMedicalCase;
            set => SetProperty(ref _currentMedicalCase, value);
        }

        private ObservableCollection<PatientInfo> _patients;
        public ObservableCollection<PatientInfo> Patients
        {
            get => _patients;
            set => SetProperty(ref _patients, value);
        }

        private PatientInfo _selectedPatient;
        public PatientInfo SelectedPatient
        {
            get => _selectedPatient;
            set
            {
                SetProperty(ref _selectedPatient, value);
                if (value != null)
                {
                    PatientName = value.Name;
                    PatientAge = CalculateAge(value.BirthDate);
                    PatientGender = value.Gender;
                    PatientPhone = value.Phone;
                }
            }
        }

        private string _patientSearchKeyword;
        public string PatientSearchKeyword
        {
            get => _patientSearchKeyword;
            set => SetProperty(ref _patientSearchKeyword, value);
        }

        private string _patientName;
        public string PatientName
        {
            get => _patientName;
            set => SetProperty(ref _patientName, value);
        }

        private int? _patientAge;
        public int? PatientAge
        {
            get => _patientAge;
            set => SetProperty(ref _patientAge, value);
        }

        private string _patientGender;
        public string PatientGender
        {
            get => _patientGender;
            set => SetProperty(ref _patientGender, value);
        }

        private string _patientPhone;
        public string PatientPhone
        {
            get => _patientPhone;
            set => SetProperty(ref _patientPhone, value);
        }

        private string _chiefComplaint;
        public string ChiefComplaint
        {
            get => _chiefComplaint;
            set => SetProperty(ref _chiefComplaint, value);
        }

        private string _presentIllness;
        public string PresentIllness
        {
            get => _presentIllness;
            set => SetProperty(ref _presentIllness, value);
        }

        private string _pastHistory;
        public string PastHistory
        {
            get => _pastHistory;
            set => SetProperty(ref _pastHistory, value);
        }

        private string _allergyHistory;
        public string AllergyHistory
        {
            get => _allergyHistory;
            set => SetProperty(ref _allergyHistory, value);
        }

        private string _familyHistory;
        public string FamilyHistory
        {
            get => _familyHistory;
            set => SetProperty(ref _familyHistory, value);
        }

        private string _remarks;
        public string Remarks
        {
            get => _remarks;
            set => SetProperty(ref _remarks, value);
        }

        private bool _isLoading;
        public bool IsLoading
        {
            get => _isLoading;
            set => SetProperty(ref _isLoading, value);
        }

        #endregion

        #region 命令

        public DelegateCommand SaveCommand { get; }
        public DelegateCommand CancelCommand { get; }
        public DelegateCommand SearchPatientCommand { get; }
        public DelegateCommand CreateNewPatientCommand { get; }

        #endregion

        public CreateMedicalCaseViewModel(
            IMedicalCaseService medicalCaseService,
            IPatientService patientService,
            IUserSessionManager userSessionManager,
            ICommonDialogService commonDialogService)
        {
            _medicalCaseService = medicalCaseService;
            _patientService = patientService;
            _userSessionManager = userSessionManager;
            _commonDialogService = commonDialogService;

            Title = "新建医疗案例";
            
            // 初始化集合
            Patients = new ObservableCollection<PatientInfo>();

            // 初始化命令
            SaveCommand = new DelegateCommand(async () => await SaveAsync());
            CancelCommand = new DelegateCommand(Cancel);
            SearchPatientCommand = new DelegateCommand(async () => await SearchPatientAsync());
            CreateNewPatientCommand = new DelegateCommand(async () => await CreateNewPatientAsync());

            // 加载初始患者列表
            Task.Run(async () => await LoadPatientsAsync());
        }

        #region 对话框实现

        public event Action<IDialogResult> RequestClose;

        protected override void RaiseRequestClose(IDialogResult dialogResult)
        {
            RequestClose?.Invoke(dialogResult);
        }

        public bool CanCloseDialog()
        {
            return true;
        }

        public void OnDialogClosed()
        {
            // 清理资源
        }

        public void OnDialogOpened(IDialogParameters parameters)
        {
            if (parameters.ContainsKey("Mode"))
            {
                Mode = parameters.GetValue<string>("Mode");
            }

            if (parameters.ContainsKey("MedicalCase"))
            {
                CurrentMedicalCase = parameters.GetValue<MedicalCaseInfo>("MedicalCase");
                LoadMedicalCaseData();
                Title = "编辑医疗案例";
            }

            if (parameters.ContainsKey("PatientId"))
            {
                var patientId = parameters.GetValue<Guid>("PatientId");
                Task.Run(async () => await LoadPatientByIdAsync(patientId));
            }
        }

        #endregion

        #region 私有方法

        private async Task LoadPatientsAsync()
        {
            try
            {
                var query = new LYBT.Shared.Models.Contracts.Patients.PatientPagedQueryDto
                {
                    CurrentPage = 1,
                    PageSize = 100,
                    IsActive = true
                };

                var result = await _patientService.GetPagedAsync(query);
                if (result.IsSuccess && result.Data != null)
                {
                    await System.Windows.Application.Current.Dispatcher.InvokeAsync(() =>
                    {
                        Patients.Clear();
                        foreach (var patient in result.Data.Items)
                        {
                            Patients.Add(patient);
                        }
                    });
                }
            }
            catch (Exception ex)
            {
                await _commonDialogService.ShowErrorAsync($"加载患者列表失败: {ex.Message}", "错误");
            }
        }

        private async Task LoadPatientByIdAsync(Guid patientId)
        {
            try
            {
                var result = await _patientService.GetByIdAsync(patientId);
                if (result.IsSuccess && result.Data != null)
                {
                    await System.Windows.Application.Current.Dispatcher.InvokeAsync(() =>
                    {
                        SelectedPatient = result.Data;
                    });
                }
            }
            catch (Exception ex)
            {
                await _commonDialogService.ShowErrorAsync($"加载患者信息失败: {ex.Message}", "错误");
            }
        }

        private void LoadMedicalCaseData()
        {
            if (CurrentMedicalCase == null) return;

            ChiefComplaint = CurrentMedicalCase.ChiefComplaint;
            PresentIllness = CurrentMedicalCase.PresentIllness;
            PastHistory = CurrentMedicalCase.PastHistory;
            AllergyHistory = CurrentMedicalCase.AllergyHistory;
            FamilyHistory = CurrentMedicalCase.FamilyHistory;
            Remarks = CurrentMedicalCase.Remarks;
        }

        private async Task SearchPatientAsync()
        {
            if (string.IsNullOrWhiteSpace(PatientSearchKeyword))
            {
                await LoadPatientsAsync();
                return;
            }

            try
            {
                var query = new LYBT.Shared.Models.Contracts.Patients.PatientPagedQueryDto
                {
                    CurrentPage = 1,
                    PageSize = 100,
                    Name = PatientSearchKeyword,
                    IsActive = true
                };

                var result = await _patientService.GetPagedAsync(query);
                if (result.IsSuccess && result.Data != null)
                {
                    Patients.Clear();
                    foreach (var patient in result.Data.Items)
                    {
                        Patients.Add(patient);
                    }
                }
            }
            catch (Exception ex)
            {
                await _commonDialogService.ShowErrorAsync($"搜索患者失败: {ex.Message}", "错误");
            }
        }

        private async Task CreateNewPatientAsync()
        {
            // TODO: 打开新增患者对话框
            await _commonDialogService.ShowInformationAsync("新增患者功能待实现", "提示");
        }

        private async Task SaveAsync()
        {
            if (!ValidateInput())
            {
                return;
            }

            try
            {
                IsLoading = true;

                if (Mode == "Add")
                {
                    var createDto = new CreateMedicalCaseDto
                    {
                        PatientId = SelectedPatient.Id,
                        DoctorId = _userSessionManager.CurrentUserId,
                        ChiefComplaint = ChiefComplaint,
                        PresentIllness = PresentIllness,
                        PastHistory = PastHistory,
                        AllergyHistory = AllergyHistory,
                        FamilyHistory = FamilyHistory,
                        Remarks = Remarks,
                        Status = MedicalCaseStatus.Registered
                    };

                    var result = await _medicalCaseService.CreateAsync(createDto);
                    if (result.IsSuccess)
                    {
                        await _commonDialogService.ShowInformationAsync("医疗案例创建成功", "提示");
                        RaiseRequestClose(new DialogResult(ButtonResult.OK));
                    }
                    else
                    {
                        await _commonDialogService.ShowErrorAsync($"创建失败: {result.ErrorMessage}", "错误");
                    }
                }
                else
                {
                    var updateDto = new UpdateMedicalCaseDto
                    {
                        Id = CurrentMedicalCase.Id,
                        ChiefComplaint = ChiefComplaint,
                        PresentIllness = PresentIllness,
                        PastHistory = PastHistory,
                        AllergyHistory = AllergyHistory,
                        FamilyHistory = FamilyHistory,
                        Remarks = Remarks
                    };

                    var result = await _medicalCaseService.UpdateAsync(updateDto);
                    if (result.IsSuccess)
                    {
                        await _commonDialogService.ShowInformationAsync("医疗案例更新成功", "提示");
                        RaiseRequestClose(new DialogResult(ButtonResult.OK));
                    }
                    else
                    {
                        await _commonDialogService.ShowErrorAsync($"更新失败: {result.ErrorMessage}", "错误");
                    }
                }
            }
            catch (Exception ex)
            {
                await _commonDialogService.ShowErrorAsync($"保存失败: {ex.Message}", "错误");
            }
            finally
            {
                IsLoading = false;
            }
        }

        private bool ValidateInput()
        {
            if (Mode == "Add" && SelectedPatient == null)
            {
                _commonDialogService.ShowErrorAsync("请选择患者", "验证失败");
                return false;
            }

            if (string.IsNullOrWhiteSpace(ChiefComplaint))
            {
                _commonDialogService.ShowErrorAsync("请输入主诉", "验证失败");
                return false;
            }

            return true;
        }

        private void Cancel()
        {
            RaiseRequestClose(new DialogResult(ButtonResult.Cancel));
        }

        private int CalculateAge(DateTime? birthDate)
        {
            if (!birthDate.HasValue) return 0;
            
            var today = DateTime.Today;
            var age = today.Year - birthDate.Value.Year;
            if (birthDate.Value.Date > today.AddYears(-age)) age--;
            
            return age;
        }

        #endregion
    }
}