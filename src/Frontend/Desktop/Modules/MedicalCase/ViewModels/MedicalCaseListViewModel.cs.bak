using System;
using System.Collections.ObjectModel;
using System.Linq;
using System.Threading.Tasks;
using LYBT.WPF.Client.Core.Interfaces.Services;
using LYBT.WPF.Client.Core.Models.MedicalCase;
using LYBT.WPF.Client.Core.ViewModels;
using Prism.Commands;
using Prism.Regions;
using LYBT.Shared.Models.Enums;

namespace LYBT.WPF.Client.Modules.MedicalCase.ViewModels
{
    /// <summary>
    /// 医疗案例列表视图模型
    /// </summary>
    public class MedicalCaseListViewModel : BaseViewModel
    {
        private readonly IMedicalCaseService _medicalCaseService;
        private readonly ICommonDialogService _dialogService;
        private readonly IRegionManager _regionManager;

        #region 属性

        private ObservableCollection<MedicalCaseInfo> _medicalCases;
        public ObservableCollection<MedicalCaseInfo> MedicalCases
        {
            get => _medicalCases;
            set => SetProperty(ref _medicalCases, value);
        }

        private MedicalCaseInfo _selectedMedicalCase;
        public MedicalCaseInfo SelectedMedicalCase
        {
            get => _selectedMedicalCase;
            set => SetProperty(ref _selectedMedicalCase, value);
        }

        private string _searchKeyword;
        public string SearchKeyword
        {
            get => _searchKeyword;
            set => SetProperty(ref _searchKeyword, value);
        }

        private MedicalCaseStatus? _filterStatus;
        public MedicalCaseStatus? FilterStatus
        {
            get => _filterStatus;
            set
            {
                SetProperty(ref _filterStatus, value);
                LoadDataCommand.Execute();
            }
        }

        private bool _isLoading;
        public new bool IsLoading
        {
            get => _isLoading;
            set => SetProperty(ref _isLoading, value);
        }

        private int _totalCount;
        public int TotalCount
        {
            get => _totalCount;
            set => SetProperty(ref _totalCount, value);
        }

        private int _currentPage = 1;
        public int CurrentPage
        {
            get => _currentPage;
            set
            {
                SetProperty(ref _currentPage, value);
                LoadDataCommand.Execute();
            }
        }

        private int _pageSize = 20;
        public int PageSize
        {
            get => _pageSize;
            set
            {
                SetProperty(ref _pageSize, value);
                LoadDataCommand.Execute();
            }
        }

        #endregion

        #region 命令

        public DelegateCommand LoadDataCommand { get; }
        public DelegateCommand SearchCommand { get; }
        public DelegateCommand AddCommand { get; }
        public DelegateCommand<MedicalCaseInfo> EditCommand { get; }
        public DelegateCommand<MedicalCaseInfo> ViewDetailCommand { get; }
        public DelegateCommand<MedicalCaseInfo> DeleteCommand { get; }
        public DelegateCommand<MedicalCaseInfo> StartConsultationCommand { get; }
        public new DelegateCommand RefreshCommand { get; }

        #endregion

        public MedicalCaseListViewModel(
            IMedicalCaseService medicalCaseService,
            ICommonDialogService dialogService,
            IRegionManager regionManager)
        {
            _medicalCaseService = medicalCaseService;
            _dialogService = dialogService;
            _regionManager = regionManager;

            // 初始化集合
            MedicalCases = new ObservableCollection<MedicalCaseInfo>();

            // 初始化命令
            LoadDataCommand = new DelegateCommand(async () => await LoadDataAsync());
            SearchCommand = new DelegateCommand(async () => await SearchAsync());
            AddCommand = new DelegateCommand(async () => await AddMedicalCaseAsync());
            EditCommand = new DelegateCommand<MedicalCaseInfo>(async (item) => await EditMedicalCaseAsync(item));
            ViewDetailCommand = new DelegateCommand<MedicalCaseInfo>(ViewDetail);
            DeleteCommand = new DelegateCommand<MedicalCaseInfo>(async (item) => await DeleteMedicalCaseAsync(item));
            StartConsultationCommand = new DelegateCommand<MedicalCaseInfo>(StartConsultation);
            RefreshCommand = new DelegateCommand(async () => await RefreshAsync());

            // 加载初始数据
            LoadDataCommand.Execute();
        }

        #region 私有方法

        private async Task LoadDataAsync()
        {
            try
            {
                IsLoading = true;

                var query = new LYBT.Shared.Models.Contracts.MedicalCase.MedicalCasePagedQueryDto
                {
                    CurrentPage = CurrentPage,
                    PageSize = PageSize,
                    Keyword = SearchKeyword,
                    Status = FilterStatus
                };

                var result = await _medicalCaseService.GetPagedAsync(query);
                if (result.IsSuccess && result.Data != null)
                {
                    MedicalCases.Clear();
                    foreach (var item in result.Data.Items)
                    {
                        MedicalCases.Add(item);
                    }
                    TotalCount = result.Data.TotalCount;
                }
                else
                {
                    await _dialogService.ShowErrorAsync($"加载数据失败: {result.ErrorMessage}", "错误");
                }
            }
            catch (Exception ex)
            {
                await _dialogService.ShowErrorAsync($"加载数据时发生错误: {ex.Message}", "错误");
            }
            finally
            {
                IsLoading = false;
            }
        }

        private async Task SearchAsync()
        {
            CurrentPage = 1;
            await LoadDataAsync();
        }

        private async Task RefreshAsync()
        {
            SearchKeyword = string.Empty;
            FilterStatus = null;
            CurrentPage = 1;
            await LoadDataAsync();
        }

        private async Task AddMedicalCaseAsync()
        {
            try
            {
                var dialogParams = new Prism.Dialogs.DialogParameters
                {
                    { "Mode", "Add" }
                };

                _dialogService.ShowDialog("CreateMedicalCaseDialog", dialogParams, result =>
                {
                    if (result.Result == Prism.Dialogs.ButtonResult.OK)
                    {
                        LoadDataCommand.Execute();
                    }
                });
            }
            catch (Exception ex)
            {
                await _dialogService.ShowErrorAsync($"打开新增对话框失败: {ex.Message}", "错误");
            }
        }

        private async Task EditMedicalCaseAsync(MedicalCaseInfo medicalCase)
        {
            if (medicalCase == null) return;

            try
            {
                var dialogParams = new Prism.Dialogs.DialogParameters
                {
                    { "Mode", "Edit" },
                    { "MedicalCase", medicalCase }
                };

                _dialogService.ShowDialog("CreateMedicalCaseDialog", dialogParams, result =>
                {
                    if (result.Result == Prism.Dialogs.ButtonResult.OK)
                    {
                        LoadDataCommand.Execute();
                    }
                });
            }
            catch (Exception ex)
            {
                await _dialogService.ShowErrorAsync($"打开编辑对话框失败: {ex.Message}", "错误");
            }
        }

        private void ViewDetail(MedicalCaseInfo medicalCase)
        {
            if (medicalCase == null) return;

            var parameters = new NavigationParameters
            {
                { "MedicalCaseId", medicalCase.Id }
            };

            _regionManager.RequestNavigate("ContentRegion", "MedicalCaseDetailView", parameters);
        }

        private async Task DeleteMedicalCaseAsync(MedicalCaseInfo medicalCase)
        {
            if (medicalCase == null) return;

            var confirm = await _dialogService.ShowConfirmationAsync(
                $"确定要删除患者 [{medicalCase.PatientName}] 的医疗案例吗？",
                "确认删除");

            if (confirm)
            {
                try
                {
                    var result = await _medicalCaseService.DeleteAsync(medicalCase.Id);
                    if (result.IsSuccess)
                    {
                        await _dialogService.ShowInformationAsync("删除成功", "提示");
                        await LoadDataAsync();
                    }
                    else
                    {
                        await _dialogService.ShowErrorAsync($"删除失败: {result.ErrorMessage}", "错误");
                    }
                }
                catch (Exception ex)
                {
                    await _dialogService.ShowErrorAsync($"删除时发生错误: {ex.Message}", "错误");
                }
            }
        }

        private void StartConsultation(MedicalCaseInfo medicalCase)
        {
            if (medicalCase == null) return;

            if (medicalCase.Status != MedicalCaseStatus.Registered)
            {
                _dialogService.ShowInformationAsync("该案例不是待诊状态，无法开始看诊", "提示");
                return;
            }

            var parameters = new NavigationParameters
            {
                { "MedicalCaseId", medicalCase.Id },
                { "PatientId", medicalCase.PatientId }
            };

            _regionManager.RequestNavigate("ContentRegion", "ConsultationMainView", parameters);
        }

        #endregion
    }
}