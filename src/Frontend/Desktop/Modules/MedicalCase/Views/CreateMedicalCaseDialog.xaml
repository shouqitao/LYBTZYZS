<UserControl x:Class="LYBT.WPF.Client.Modules.MedicalCase.Views.CreateMedicalCaseDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             Width="700" Height="600">
    
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
        </Style>
    </prism:Dialog.WindowStyle>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 患者选择 -->
                <GroupBox Grid.Row="0" Header="患者信息" Margin="0,0,0,16">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 患者搜索 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0"
                                     Text="{Binding PatientSearchKeyword}"
                                     materialDesign:HintAssist.Hint="搜索患者姓名或电话..."
                                     Margin="0,0,8,0"/>
                            
                            <Button Grid.Column="1"
                                    Command="{Binding SearchPatientCommand}"
                                    Content="搜索"
                                    Margin="0,0,8,0"/>
                            
                            <Button Grid.Column="2"
                                    Command="{Binding CreateNewPatientCommand}"
                                    Content="新增患者"/>
                        </Grid>

                        <!-- 患者列表 -->
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding Patients}"
                                  SelectedItem="{Binding SelectedPatient}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="选择患者"
                                  Margin="0,0,0,8"/>

                        <!-- 患者信息显示 -->
                        <Grid Grid.Row="2" 
                              Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Margin="4">
                                <Run Text="姓名: " FontWeight="Bold"/>
                                <Run Text="{Binding PatientName}"/>
                            </TextBlock>
                            
                            <TextBlock Grid.Column="1" Margin="4">
                                <Run Text="性别: " FontWeight="Bold"/>
                                <Run Text="{Binding PatientGender}"/>
                            </TextBlock>
                            
                            <TextBlock Grid.Column="2" Margin="4">
                                <Run Text="年龄: " FontWeight="Bold"/>
                                <Run Text="{Binding PatientAge}"/>
                            </TextBlock>
                            
                            <TextBlock Grid.Column="3" Margin="4">
                                <Run Text="电话: " FontWeight="Bold"/>
                                <Run Text="{Binding PatientPhone}"/>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- 病历信息 -->
                <GroupBox Grid.Row="1" Header="病历信息" Margin="0,0,0,16">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 主诉 -->
                        <TextBox Grid.Row="0"
                                 Text="{Binding ChiefComplaint}"
                                 materialDesign:HintAssist.Hint="主诉 *"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 Margin="0,0,0,8"/>

                        <!-- 现病史 -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding PresentIllness}"
                                 materialDesign:HintAssist.Hint="现病史"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 Margin="0,0,0,8"/>

                        <!-- 既往史 -->
                        <TextBox Grid.Row="2"
                                 Text="{Binding PastHistory}"
                                 materialDesign:HintAssist.Hint="既往史"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40"
                                 Margin="0,0,0,8"/>

                        <!-- 过敏史 -->
                        <TextBox Grid.Row="3"
                                 Text="{Binding AllergyHistory}"
                                 materialDesign:HintAssist.Hint="过敏史"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40"
                                 Margin="0,0,0,8"/>

                        <!-- 家族史 -->
                        <TextBox Grid.Row="4"
                                 Text="{Binding FamilyHistory}"
                                 materialDesign:HintAssist.Hint="家族史"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40"
                                 Margin="0,0,0,8"/>

                        <!-- 备注 -->
                        <TextBox Grid.Row="5"
                                 Text="{Binding Remarks}"
                                 materialDesign:HintAssist.Hint="备注"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="40"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignPaper}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="* 为必填项" 
                           Foreground="Red"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Command="{Binding SaveCommand}"
                        Content="保存"
                        IsDefault="True"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        Width="100"/>

                <Button Grid.Column="2"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="100"/>
            </Grid>
        </Border>

        <!-- 加载遮罩 -->
        <Grid Grid.Row="0" Grid.RowSpan="3" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="50" Height="50"
                         IsIndeterminate="True"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>