<UserControl x:Class="LYBT.WPF.Client.Modules.Registration.Views.SimpleRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="20,15">
            <TextBlock Text="快速挂号" FontSize="24" FontWeight="Bold" Foreground="#333"/>
        </Border>

        <!-- 主要内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：患者选择/创建 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,10,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 患者搜索 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="搜索患者" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     Text="{Binding PatientSearchKeyword}" 
                                     Height="36" 
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     FontSize="14"/>
                            <Button Grid.Column="1" 
                                    Content="搜索" 
                                    Command="{Binding SearchPatientCommand}"
                                    Width="80" 
                                    Height="36" 
                                    Margin="10,0,0,0"
                                    Background="#2E86AB"
                                    Foreground="White"
                                    FontSize="14"/>
                        </Grid>
                    </StackPanel>

                    <!-- 搜索结果 -->
                    <GroupBox Grid.Row="1" Header="搜索结果" Margin="0,20,0,0">
                        <ListBox ItemsSource="{Binding SearchedPatients}"
                                 SelectedItem="{Binding SelectedPatient}"
                                 MaxHeight="200"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,5" BorderThickness="0,0,0,1" BorderBrush="#EEE">
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Name}" FontWeight="Bold"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding PhoneNumber}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#666" FontSize="12">
                                                <Run Text="{Binding Gender}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Age}"/>
                                                <Run Text="岁"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>

                    <!-- 新建患者 -->
                    <GroupBox Grid.Row="2" Header="新建患者" Margin="0,20,0,0">
                        <StackPanel Margin="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名：" VerticalAlignment="Center" Margin="0,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" 
                                         Text="{Binding NewPatientName}" 
                                         Height="30" 
                                         Margin="10,5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="手机：" VerticalAlignment="Center" Margin="0,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" 
                                         Text="{Binding NewPatientPhone}" 
                                         Height="30" 
                                         Margin="10,5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="性别：" VerticalAlignment="Center" Margin="0,5"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,5">
                                    <RadioButton Content="男" IsChecked="{Binding Path=NewPatientGender, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Male}" Margin="0,0,20,0"/>
                                    <RadioButton Content="女" IsChecked="{Binding Path=NewPatientGender, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Female}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="年龄：" VerticalAlignment="Center" Margin="0,5"/>
                                <TextBox Grid.Row="3" Grid.Column="1" 
                                         Text="{Binding NewPatientAge}" 
                                         Height="30" 
                                         Margin="10,5"/>
                            </Grid>
                            
                            <Button Content="创建患者档案" 
                                    Command="{Binding CreatePatientCommand}"
                                    Height="36"
                                    Margin="0,10,0,0"
                                    Background="#28A745"
                                    Foreground="White"
                                    FontSize="14"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 已选患者显示 -->
                    <Border Grid.Row="3" 
                            Background="#E8F4F8" 
                            Padding="10" 
                            CornerRadius="5"
                            Margin="0,10,0,0"
                            Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock FontSize="14">
                            <Run Text="已选患者：" FontWeight="Bold"/>
                            <Run Text="{Binding SelectedPatient.Name}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding SelectedPatient.PhoneNumber}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧：医生选择 -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="10,0,0,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 医生列表 -->
                    <TextBlock Grid.Row="0" Text="选择医生" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Doctors}"
                             SelectedItem="{Binding SelectedDoctor}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="15,10" 
                                        Margin="0,5"
                                        BorderThickness="1" 
                                        BorderBrush="#DDD"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="16" FontWeight="Bold">
                                                <Run Text="{Binding Name}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#666" FontSize="13" Margin="0,3,0,0">
                                                <Run Text="专长："/>
                                                <Run Text="{Binding Specialty}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="1" 
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#2E86AB">
                                            <Run Text="￥"/>
                                            <Run Text="{Binding RegistrationFee, StringFormat={}{0:F2}}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 已选医生显示 -->
                    <Border Grid.Row="2" 
                            Background="#E8F4F8" 
                            Padding="10" 
                            CornerRadius="5"
                            Margin="0,10,0,0"
                            Visibility="{Binding SelectedDoctor, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock FontSize="14">
                            <Run Text="已选医生：" FontWeight="Bold"/>
                            <Run Text="{Binding SelectedDoctor.Name}"/>
                            <Run Text=" - 挂号费：￥"/>
                            <Run Text="{Binding SelectedDoctor.RegistrationFee, StringFormat={}{0:F2}}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Background="White" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 状态消息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="14" 
                               Foreground="#666"
                               Margin="0,0,20,0"/>
                    
                    <TextBlock FontSize="16" 
                               FontWeight="Bold"
                               Foreground="#28A745"
                               Visibility="{Binding QueueNumber, Converter={StaticResource PositiveIntToVisibilityConverter}}">
                        <Run Text="排队号："/>
                        <Run Text="{Binding QueueNumber}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="清空" 
                            Command="{Binding ClearCommand}"
                            Width="100" 
                            Height="40"
                            Margin="0,0,10,0"
                            Background="#6C757D"
                            Foreground="White"
                            FontSize="16"/>
                    
                    <Button Content="确认挂号" 
                            Command="{Binding SubmitRegistrationCommand}"
                            Width="120" 
                            Height="40"
                            Background="#2E86AB"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载遮罩 -->
        <Grid Grid.RowSpan="3" 
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" 
                    CornerRadius="10" 
                    Padding="30,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="正在处理..." 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,0"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>