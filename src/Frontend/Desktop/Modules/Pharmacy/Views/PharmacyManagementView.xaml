&lt;UserControl x:Class="LYBT.WPF.Client.Modules.Pharmacy.Views.PharmacyManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#8BC34A" Padding="20,15">
            <Grid>
                <TextBlock Text="药房管理" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="待配药：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PendingCount}" Foreground="#FFEB3B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="笔" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="今日配药：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TodayDispensedCount}" Foreground="#FFEB3B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="笔" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- 配药管理 -->
            <TabItem Header="配药管理">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- 搜索框 -->
                                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="250" Height="35" Padding="10,8"
                                         BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5"
                                         Tag="搜索患者姓名或处方号">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="{TemplateBinding Border.CornerRadius}">
                                                            <Grid>
                                                                <TextBlock Text="{TemplateBinding Tag}" 
                                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="#999999"
                                                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, 
                                                                                        Converter={StaticResource StringToVisibilityConverter}}"/>
                                                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- 状态筛选 -->
                                <ComboBox SelectedItem="{Binding SelectedStatus}" Width="120" Height="35" 
                                          Margin="15,0,0,0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="全部状态"/>
                                    <ComboBoxItem Content="待配药"/>
                                    <ComboBoxItem Content="配药中"/>
                                    <ComboBoxItem Content="已配药"/>
                                    <ComboBoxItem Content="已发药"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="搜索" Command="{Binding SearchCommand}"
                                        Width="80" Height="35" Margin="0,0,10,0"
                                        Background="#8BC34A" Foreground="White" BorderThickness="0"
                                        FontSize="14" CornerRadius="5"/>
                                <Button Content="刷新" Command="{Binding RefreshCommand}"
                                        Width="80" Height="35"
                                        Background="#2196F3" Foreground="White" BorderThickness="0"
                                        FontSize="14" CornerRadius="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 处方列表 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PrescriptionList}"
                              SelectedItem="{Binding SelectedPrescription}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Width="60" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                             Path="Header"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="处方号" Binding="{Binding PrescriptionNumber}" Width="120"/>
                            <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                            <DataGridTextColumn Header="性别/年龄" Width="80">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}/{1}岁">
                                        <Binding Path="Gender"/>
                                        <Binding Path="Age"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="100"/>
                            <DataGridTextColumn Header="药材种类" Binding="{Binding HerbCount}" Width="80"/>
                            <DataGridTextColumn Header="总金额" Binding="{Binding TotalAmount, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTemplateColumn Header="状态" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" Padding="5,2" CornerRadius="3">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" 
                                                       HorizontalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="开方时间" Binding="{Binding CreateTime, StringFormat={}{0:MM-dd HH:mm}}" Width="100"/>
                            <DataGridTemplateColumn Header="操作" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="配药" 
                                                    Command="{Binding DataContext.StartDispensingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                                                    Padding="5,2" Margin="2"
                                                    Visibility="{Binding CanStartDispensing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="完成配药" 
                                                    Command="{Binding DataContext.CompleteDispensingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#FF9800" Foreground="White" BorderThickness="0"
                                                    Padding="5,2" Margin="2"
                                                    Visibility="{Binding CanCompleteDispensing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="发药" 
                                                    Command="{Binding DataContext.DispenseDrugCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#9C27B0" Foreground="White" BorderThickness="0"
                                                    Padding="5,2" Margin="2"
                                                    Visibility="{Binding CanDispense, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="详情" 
                                                    Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#607D8B" Foreground="White" BorderThickness="0"
                                                    Padding="5,2" Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 库存管理 -->
            <TabItem Header="库存管理">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="库存预警" Command="{Binding ShowStockAlertCommand}"
                                    Width="100" Height="35" Margin="0,0,10,0"
                                    Background="#F44336" Foreground="White" BorderThickness="0"
                                    FontSize="14" CornerRadius="5"/>
                            <Button Content="入库" Command="{Binding StockInCommand}"
                                    Width="80" Height="35" Margin="0,0,10,0"
                                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                                    FontSize="14" CornerRadius="5"/>
                            <Button Content="出库" Command="{Binding StockOutCommand}"
                                    Width="80" Height="35" Margin="0,0,10,0"
                                    Background="#FF9800" Foreground="White" BorderThickness="0"
                                    FontSize="14" CornerRadius="5"/>
                            <Button Content="盘点" Command="{Binding InventoryCommand}"
                                    Width="80" Height="35"
                                    Background="#9C27B0" Foreground="White" BorderThickness="0"
                                    FontSize="14" CornerRadius="5"/>
                        </StackPanel>
                    </Border>

                    <!-- 库存列表 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding StockList}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              IsReadOnly="True" Margin="20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="药材名称" Binding="{Binding HerbName}" Width="150"/>
                            <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="100"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="当前库存" Binding="{Binding CurrentStock}" Width="100"/>
                            <DataGridTextColumn Header="安全库存" Binding="{Binding SafeStock}" Width="100"/>
                            <DataGridTemplateColumn Header="库存状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StockStatusColor}" Padding="5,2" CornerRadius="3">
                                            <TextBlock Text="{Binding StockStatusText}" Foreground="White" 
                                                       HorizontalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat={}{0:F2}}" Width="80"/>
                            <DataGridTextColumn Header="库存金额" Binding="{Binding StockValue, StringFormat={}{0:F2}}" Width="100"/>
                            <DataGridTextColumn Header="最后入库" Binding="{Binding LastStockInDate, StringFormat={}{0:MM-dd}}" Width="100"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>