<Window x:Class="LYBT.WPF.Client.Modules.SystemManagement.Formulas.Views.AddFormulaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增验方模板" Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#8E24AA" Padding="20,15">
            <TextBlock Text="新增验方模板" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 主要内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">
                <!-- 基本信息 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 验方名称 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="验方名称 *" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Name="txtFormulaName" Height="35" Padding="8,5" FontSize="14"
                                 TabIndex="1"/>
                    </StackPanel>
                    
                    <!-- 分类 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="分类 *" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox Name="cboCategory" Height="35" Padding="8,5" FontSize="14"
                                  TabIndex="2" SelectedIndex="0">
                            <ComboBoxItem>内科方</ComboBoxItem>
                            <ComboBoxItem>外科方</ComboBoxItem>
                            <ComboBoxItem>妇科方</ComboBoxItem>
                            <ComboBoxItem>儿科方</ComboBoxItem>
                            <ComboBoxItem>皮肤科方</ComboBoxItem>
                            <ComboBoxItem>其他</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- 药材组成 -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="药材组成" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <!-- 快速输入区域 -->
                    <Border Background="#F5F5F5" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="药材名称" FontSize="12" Margin="0,0,0,5"/>
                                <ComboBox Name="cboHerbName" 
                                          Height="35" 
                                          IsEditable="True"
                                          TabIndex="3"
                                          SelectionChanged="cboHerbName_SelectionChanged"
                                          KeyDown="cboHerbName_KeyDown">
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                <TextBlock Text="数量" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox Name="txtQuantity" 
                                         Height="35" 
                                         TabIndex="4"
                                         HorizontalContentAlignment="Center"
                                         KeyDown="txtQuantity_KeyDown"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="单位" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox Name="txtUnit" 
                                         Height="35" 
                                         Text="g"
                                         IsReadOnly="True"
                                         Background="#F0F0F0"
                                         HorizontalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <Button Grid.Column="3" 
                                    Name="btnAddHerb"
                                    Content="添加" 
                                    Height="35" 
                                    VerticalAlignment="Bottom"
                                    Background="#4CAF50" 
                                    Foreground="White" 
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    TabIndex="5"
                                    Click="btnAddHerb_Click"/>
                        </Grid>
                    </Border>
                    
                    <!-- 批量输入提示 -->
                    <TextBlock Text="提示：也可以直接粘贴文本，格式如：白芍25 川芎50 郁李仁5" 
                               FontSize="12" 
                               Foreground="#666" 
                               Margin="0,0,0,10"/>
                    
                    <!-- 药材展示区域 -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" MinHeight="150" MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel Name="wpHerbs" Margin="10">
                                <!-- 药材项将动态添加到这里 -->
                            </WrapPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- 功效说明 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="功效说明" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="txtEffect" Height="60" Padding="8,5" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontSize="14"
                             TabIndex="6"/>
                </StackPanel>

                <!-- 用法用量 -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="用法用量" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="txtUsage" Height="35" Padding="8,5" FontSize="14"
                             TabIndex="7"/>
                </StackPanel>

                <!-- 备注 -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="备注" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="txtRemark" Height="60" Padding="8,5" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontSize="14"
                             TabIndex="8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnSave" Content="保存 (Ctrl+Enter)" Width="120" Height="35" Margin="0,0,10,0"
                        Background="#8E24AA" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="Bold" 
                        TabIndex="9"
                        Click="btnSave_Click"/>
                <Button Name="btnCancel" Content="取消 (Esc)" Width="100" Height="35"
                        Background="#6C757D" Foreground="White" BorderThickness="0"
                        FontSize="14"
                        TabIndex="10"
                        Click="btnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>