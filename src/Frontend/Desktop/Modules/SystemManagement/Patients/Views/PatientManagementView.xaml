<UserControl x:Class="LYBT.WPF.Client.Modules.SystemManagement.Patients.Views.PatientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:LYBT.WPF.Client.Modules.SystemManagement.Patients.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <TextBlock Text="患者信息管理" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 搜索和操作栏 -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索区域 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Name="SearchTextBox" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                             Width="200" Height="25" Margin="0,0,10,0"/>
                    <Button Content="搜索" Command="{Binding SearchCommand}" 
                           Width="60" Height="25" Background="#2196F3" Foreground="White" Margin="0,0,10,0"/>
                    <Button Content="重置" Command="{Binding ResetCommand}" 
                           Width="60" Height="25" Background="#757575" Foreground="White"/>
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新增患者" Command="{Binding AddPatientCommand}" 
                           Width="80" Height="30" Background="#4CAF50" Foreground="White" Margin="0,0,5,0"/>
                    <Button Content="编辑" Command="{Binding EditPatientCommand}" 
                           Width="60" Height="30" Background="#FF9800" Foreground="White" Margin="0,0,5,0"/>
                    <Button Content="禁用" Command="{Binding DisablePatientCommand}" 
                           Width="60" Height="30" Background="#F44336" Foreground="White" Margin="0,0,5,0"/>
                    <Button Content="启用" Command="{Binding EnablePatientCommand}" 
                           Width="60" Height="30" Background="#4CAF50" Foreground="White" Margin="0,0,5,0"/>
                    <Button Content="导出" Command="{Binding ExportCommand}" 
                           Width="60" Height="30" Background="#9C27B0" Foreground="White" Margin="0,0,5,0"/>
                    <Button Content="导入" Command="{Binding ImportCommand}" 
                           Width="60" Height="30" Background="#607D8B" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 患者列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}"
                 AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                 GridLinesVisibility="Horizontal" AlternatingRowBackground="#F9F9F9"
                 SelectionMode="Single" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="50"/>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="100"/>
                <DataGridTextColumn Header="性别" Width="60">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Gender" Converter="{StaticResource GenderConverter}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="60"/>
                <DataGridTextColumn Header="手机号" Binding="{Binding PhoneNumber}" Width="120"/>
                <DataGridTextColumn Header="证件号" Binding="{Binding IDNumber}" Width="160"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="200"/>
                <DataGridTextColumn Header="职业" Binding="{Binding Profession}" Width="100"/>
                <DataGridTextColumn Header="过敏史" Binding="{Binding AllergyHistory}" Width="150"/>
                <DataGridTemplateColumn Header="操作" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="查看" CommandParameter="{Binding}" 
                                       Command="{Binding DataContext.ViewPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Width="40" Height="20" Background="#2196F3" Foreground="White" Margin="2"/>
                                <Button Content="病历" CommandParameter="{Binding}" 
                                       Command="{Binding DataContext.ViewRecordsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Width="40" Height="20" Background="#FF9800" Foreground="White" Margin="2"/>
                                <Button Content="编辑" CommandParameter="{Binding}" 
                                       Command="{Binding DataContext.EditPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Width="40" Height="20" Background="#4CAF50" Foreground="White" Margin="2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="3" Background="#E9ECEF" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="首页" Command="{Binding FirstPageCommand}" Width="40" Height="25" Margin="2"/>
                    <Button Content="上页" Command="{Binding PreviousPageCommand}" Width="40" Height="25" Margin="2"/>
                    <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Content="下页" Command="{Binding NextPageCommand}" Width="40" Height="25" Margin="2"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" Width="40" Height="25" Margin="2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- 性别转换器 -->
        <converters:GenderConverter x:Key="GenderConverter"/>
    </UserControl.Resources>
</UserControl>