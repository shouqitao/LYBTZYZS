<Window x:Class="LYBT.WPF.Client.Modules.SystemManagement.Patients.Views.AddPatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d" 
        Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="新增患者">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="20,15">
            <TextBlock Text="新增患者" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- 基本信息 -->
                <TextBlock Text="基本信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                
                <!-- 姓名 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="*姓名：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding Name}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 性别 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="*性别：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Content="男" IsChecked="{Binding IsMale}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <RadioButton Content="女" IsChecked="{Binding IsFemale}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 出生日期 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="*出生日期：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding BirthDate}" Height="32" VerticalContentAlignment="Center"/>
                </Grid>

                <!-- 身份证号 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="身份证号：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding IdCard}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 联系信息 -->
                <TextBlock Text="联系信息" FontSize="16" FontWeight="Bold" Margin="0,20,0,15" Foreground="#333"/>

                <!-- 电话 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="*电话：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding Phone}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 地址 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="地址：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding Address}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 紧急联系人 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="紧急联系人：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding EmergencyContact}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 紧急联系电话 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="紧急联系电话：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding EmergencyPhone}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 医疗信息 -->
                <TextBlock Text="医疗信息" FontSize="16" FontWeight="Bold" Margin="0,20,0,15" Foreground="#333"/>

                <!-- 过敏史 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="过敏史：" VerticalAlignment="Top" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Allergies}" Height="60" 
                             TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalContentAlignment="Top" Padding="8,5"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- 既往病史 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="既往病史：" VerticalAlignment="Top" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBox Grid.Column="1" Text="{Binding MedicalHistory}" Height="80" 
                             TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalContentAlignment="Top" Padding="8,5"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- 备注 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="备注：" VerticalAlignment="Top" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Remark}" Height="60" 
                             TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalContentAlignment="Top" Padding="8,5"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Padding="20,15">
            <Grid>
                <TextBlock Text="* 为必填项" Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存" 
                            Command="{Binding SaveCommand}"
                            Width="100" Height="36"
                            Background="#28A745"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button Content="取消" 
                            Command="{Binding CancelCommand}"
                            Width="100" Height="36"
                            Background="#6C757D"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>