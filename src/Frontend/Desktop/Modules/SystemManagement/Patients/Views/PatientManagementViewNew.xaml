<UserControl x:Class="LYBT.WPF.Client.Modules.SystemManagement.Patients.Views.PatientManagementViewNew"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:base="clr-namespace:LYBT.WPF.Client.Core.Views.Base;assembly=LYBT.WPF.Client.Core"
             xmlns:controls="clr-namespace:LYBT.WPF.Client.Controls.Patients;assembly=LYBT.WPF.Client.Core"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
<base:BaseListView>
    
    <!-- 筛选内容 -->
    <base:BaseListView.FilterContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 性别筛选 -->
            <TextBlock Grid.Column="0" 
                       Text="性别："
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding GenderOptions}"
                      SelectedItem="{Binding SelectedGender}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Value"
                      Margin="0,0,20,0"/>
            
            <!-- 年龄范围 -->
            <TextBlock Grid.Column="2"
                       Text="年龄："
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <Grid Grid.Column="3" Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding MinAge}"
                         VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="1" 
                           Text=" - "
                           VerticalAlignment="Center"
                           Margin="5,0"/>
                <TextBox Grid.Column="2"
                         Text="{Binding MaxAge}"
                         VerticalContentAlignment="Center"/>
            </Grid>
            
            <!-- 过敏史筛选 -->
            <TextBlock Grid.Column="4"
                       Text="过敏史："
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox Grid.Column="5"
                      ItemsSource="{Binding AllergyOptions}"
                      SelectedItem="{Binding SelectedAllergy}"/>
        </Grid>
    </base:BaseListView.FilterContent>
    
    <!-- 列表内容 -->
    <base:BaseListView.ListContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 列表标题栏 -->
            <Border Grid.Row="0" 
                    Background="#F0F7FF" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="" Width="52"/>
                    <TextBlock Grid.Column="1" Text="患者姓名" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="性别" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="3" Text="年龄" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="4" Text="联系电话" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="5" Text="过敏史" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Grid.Column="6" Text="" />
                    <TextBlock Grid.Column="7" Text="操作" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Width="120"/>
                </Grid>
            </Border>

            <!-- 患者列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Patients}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:PatientListItemControl Data="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </base:BaseListView.ListContent>
</base:BaseListView>
</UserControl>