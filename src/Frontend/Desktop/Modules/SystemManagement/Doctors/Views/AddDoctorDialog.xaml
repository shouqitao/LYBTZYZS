<Window x:Class="LYBT.WPF.Client.Modules.SystemManagement.Doctors.Views.AddDoctorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:enums="clr-namespace:LYBT.Shared.Models.Enums;assembly=LYBT.Shared.Models"
        mc:Ignorable="d" 
        Title="新增医生" 
        Height="650" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="20,15">
            <TextBlock Text="新增医生" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 表单内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- 基本信息 -->
                <TextBlock Text="基本信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                
                <!-- 选择用户 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold">
                        <Run Text="选择用户："/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding DoctorRoleUsers}" 
                              SelectedItem="{Binding SelectedUser}"
                              Height="32" 
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="RealName"/>
                                            <Binding Path="Username"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                
                <!-- 姓名（只读，从选中的用户获取） -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold">
                        <Run Text="姓名："/>
                    </TextBlock>
                    <TextBox Grid.Column="1" Text="{Binding Name}" Height="32" VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="True" Background="#F5F5F5"/>
                </Grid>

                <!-- 工号 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold">
                        <Run Text="工号："/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <TextBox Grid.Column="1" Text="{Binding Code}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 性别 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="性别：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Content="男" IsChecked="{Binding IsMale}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <RadioButton Content="女" IsChecked="{Binding IsFemale}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 出生日期 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold">
                        <Run Text="出生日期："/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding BirthDate}" Height="32" VerticalContentAlignment="Center"/>
                </Grid>

                <!-- 职称 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold">
                        <Run Text="职称："/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding TitleOptions}" 
                              SelectedValue="{Binding Title}"
                              SelectedValuePath="Key"
                              DisplayMemberPath="Value"
                              Height="32" 
                              VerticalContentAlignment="Center"/>
                </Grid>

                <!-- 科室 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold">
                        <Run Text="科室："/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding DepartmentOptions}" 
                              Text="{Binding Department}"
                              IsEditable="True"
                              Height="32" 
                              VerticalContentAlignment="Center"/>
                </Grid>

                <!-- 专长 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="专长：" VerticalAlignment="Top" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Specialty}" Height="60" 
                             TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalContentAlignment="Top" Padding="8,5"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- 联系信息 -->
                <TextBlock Text="联系信息" FontSize="16" FontWeight="Bold" Margin="0,20,0,15" Foreground="#333"/>

                <!-- 手机号 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold">
                        <Run Text="手机号："/>
                        <Run Text="*" Foreground="Red"/>
                    </TextBlock>
                    <TextBox Grid.Column="1" Text="{Binding Phone}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 执业证书编号 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="执业证书号：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="{Binding LicenseNumber}" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>

                <!-- 备注 -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="备注：" VerticalAlignment="Top" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Remark}" Height="80" 
                             TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalContentAlignment="Top" Padding="8,5"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" 
                        Command="{Binding SaveCommand}"
                        Width="100" Height="36"
                        Background="#28A745"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button Content="取消" 
                        Command="{Binding CancelCommand}"
                        Width="100" Height="36"
                        Background="#6C757D"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>