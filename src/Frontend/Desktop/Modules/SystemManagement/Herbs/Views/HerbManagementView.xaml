<UserControl x:Class="LYBT.Desktop.Admin.Herbs.Views.HerbManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ManagementViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索区域 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="搜索：" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索" 
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+ 新增药材" 
                            Margin="0,0,10,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}"/>
                    <Button Content="导入药材" 
                            Margin="0,0,10,0"
                            Style="{StaticResource InfoButton}"
                            Command="{Binding ImportHerbsCommand}"/>
                    <Button Content="导出模板" 
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportTemplateCommand}"/>
                    <Button Content="刷新" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource ManagementDataGrid}"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <!-- 药材名称 -->
                <DataGridTextColumn Header="药材名称" 
                                    Binding="{Binding Name}" 
                                    Width="120"/>
                
                <!-- 拼音码 -->
                <DataGridTextColumn Header="拼音码" 
                                    Binding="{Binding PinYinCode}" 
                                    Width="80"/>
                
                <!-- 产地 -->
                <DataGridTextColumn Header="产地" 
                                    Binding="{Binding Origin}" 
                                    Width="100"/>
                
                <!-- 规格 -->
                <DataGridTextColumn Header="规格" 
                                    Binding="{Binding Spec}" 
                                    Width="80"/>
                
                <!-- 单位 -->
                <DataGridTextColumn Header="单位" 
                                    Binding="{Binding Unit}" 
                                    Width="60"/>
                
                <!-- 单价 -->
                <DataGridTextColumn Header="单价(元)" 
                                    Binding="{Binding Price, StringFormat='{}{0:F2}'}" 
                                    Width="80"/>
                
                <!-- 库存 -->
                <DataGridTemplateColumn Header="库存" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Stock}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="Foreground" Value="#DC3545"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 功效 -->
                <DataGridTextColumn Header="功效" 
                                    Binding="{Binding Effect}" 
                                    Width="200"/>
                
                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}" 
                                    CornerRadius="3" 
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" 
                                           Foreground="White" 
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="查看" 
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="编辑" 
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="库存" 
                                        Style="{StaticResource InfoButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ManageStockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="删除" 
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusText}"
                               Text="{Binding StatusText}"/>
                    <TextBlock Style="{StaticResource StatusText}"
                               Margin="20,0,0,0"
                               Foreground="#DC3545"
                               FontWeight="Bold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="库存不足：{0} 种">
                                <Binding Path="LowStockCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <Button Content="首页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding FirstPageCommand}"/>
                    
                    <Button Content="上一页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding PreviousPageCommand}"/>
                    
                    <Border Style="{StaticResource PageNumberBorder}">
                        <TextBlock FontWeight="Bold" FontSize="13">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    
                    <Button Content="下一页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding NextPageCommand}"/>
                    
                    <Button Content="末页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding LastPageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>