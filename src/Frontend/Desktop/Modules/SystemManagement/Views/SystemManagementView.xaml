<UserControl x:Class="LYBT.WPF.Client.Modules.SystemManagement.Views.SystemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 系统管理标题 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="系统管理" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="System Management" FontSize="14" Foreground="#B3D9F2" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航菜单 -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <!-- 用户管理 -->
                        <Button Command="{Binding NavigateToUserManagementCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="用户管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 角色权限管理 -->
                        <Button Command="{Binding NavigateToRoleManagementCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="角色权限" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 系统设置 -->
                        <Button Command="{Binding NavigateToSystemSettingsCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="系统设置" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 数据备份 -->
                        <Button Command="{Binding NavigateToBackupCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="数据备份" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 系统日志 -->
                        <Button Command="{Binding NavigateToSystemLogsCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="系统日志" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 中医药材管理 -->
                        <Button Command="{Binding NavigateToHerbManagementCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌿" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="中药材管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 处方模板管理 -->
                        <Button Command="{Binding NavigateToPrescriptionTemplatesCommand}" 
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,15"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E9ECEF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="处方模板" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧内容区域 -->
            <Grid Grid.Column="1">
                <ContentControl prism:RegionManager.RegionName="SystemManagementContentRegion"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>