<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 引入样式资源 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Styles/ManagementViewStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <!-- 基础管理页面模板 -->
    <ControlTemplate x:Key="BaseManagementViewTemplate" TargetType="ContentControl">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 工具栏 -->
            <Border Grid.Row="0" Style="{StaticResource ToolBarBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 搜索区域 -->
                    <ContentPresenter Grid.Column="0" 
                                      ContentSource="Header"
                                      x:Name="SearchArea"/>
                    
                    <!-- 操作按钮区域 -->
                    <ContentPresenter Grid.Column="1" 
                                      ContentSource="Tag"
                                      x:Name="ActionArea"/>
                </Grid>
            </Border>
            
            <!-- 主内容区域 -->
            <ContentPresenter Grid.Row="1" 
                              ContentSource="Content"/>
            
            <!-- 状态栏和分页 -->
            <Border Grid.Row="2" Style="{StaticResource StatusBarBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 状态信息 -->
                    <TextBlock Grid.Column="0" 
                               Style="{StaticResource StatusText}"
                               Text="{Binding StatusText}"/>
                    
                    <!-- 分页控件 -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center">
                        <Button Content="首页" 
                                Style="{StaticResource PaginationButton}"
                                Command="{Binding FirstPageCommand}"/>
                        
                        <Button Content="上一页" 
                                Style="{StaticResource PaginationButton}"
                                Command="{Binding PreviousPageCommand}"/>
                        
                        <Border Style="{StaticResource PageNumberBorder}">
                            <TextBlock FontWeight="Bold" FontSize="13">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} / {1}">
                                        <Binding Path="CurrentPage"/>
                                        <Binding Path="TotalPages"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        
                        <Button Content="下一页" 
                                Style="{StaticResource PaginationButton}"
                                Command="{Binding NextPageCommand}"/>
                        
                        <Button Content="末页" 
                                Style="{StaticResource PaginationButton}"
                                Command="{Binding LastPageCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>
    
    <!-- 标准搜索区域模板 -->
    <DataTemplate x:Key="StandardSearchTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="搜索：" Style="{StaticResource LabelText}"/>
            <TextBox Style="{StaticResource SearchTextBox}"
                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="搜索" 
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SearchCommand}"/>
        </StackPanel>
    </DataTemplate>
    
    <!-- 标准操作按钮模板 -->
    <DataTemplate x:Key="StandardActionTemplate">
        <StackPanel Orientation="Horizontal">
            <Button Content="+ 新增" 
                    Margin="0,0,10,0"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding AddCommand}"/>
            <Button Content="刷新" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>
    </DataTemplate>
    
    <!-- 操作列模板 -->
    <DataTemplate x:Key="OperationColumnTemplate">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="查看" 
                    Style="{StaticResource PrimaryButton}"
                    Padding="8,4"
                    FontSize="12"
                    Margin="2"
                    Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}"/>
            <Button Content="编辑" 
                    Style="{StaticResource SuccessButton}"
                    Padding="8,4"
                    FontSize="12"
                    Margin="2"
                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}"/>
            <Button Content="删除" 
                    Style="{StaticResource DangerButton}"
                    Padding="8,4"
                    FontSize="12"
                    Margin="2"
                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>