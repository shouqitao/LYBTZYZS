<Window x:Class="LYBT.WPF.Client.Modules.SystemManagement.FormulaTemplates.Views.ViewFormulaTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#8E24AA" Padding="20,15">
            <TextBlock Text="验方模板详情" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 主要内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：基本信息 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="基本信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <!-- 模板名称 -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="模板名称" FontWeight="Bold" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding TemplateName}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 分类 -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="分类" FontWeight="Bold" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding Category}" FontSize="14" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 适应症 -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="适应症" FontWeight="Bold" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding Indications}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 功效 -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="功效" FontWeight="Bold" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding Efficacy}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 用法用量 -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="用法用量" FontWeight="Bold" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding Usage}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 备注 -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="备注" FontWeight="Bold" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding Remark}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 创建信息 -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="创建时间" FontWeight="Bold" Foreground="#666" FontSize="12"/>
                            <TextBlock Text="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" 
                                       FontSize="14" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧：药材列表 -->
                <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="方剂组成" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- 药材列表 -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding TemplateHerbs}" 
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="White"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Width="40">
                                    <DataGridTextColumn.Binding>
                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                                 Path="Header"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="药材名称" Binding="{Binding HerbName}" Width="*"/>
                                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60"/>
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="100"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#F9F9F9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <!-- 统计信息 -->
                        <Border Grid.Row="2" Background="#F5F5F5" Padding="10" Margin="0,10,0,0" CornerRadius="5">
                            <TextBlock FontSize="14" TextAlignment="Center">
                                <Run Text="共 "/>
                                <Run Text="{Binding TemplateHerbs.Count}" FontWeight="Bold" Foreground="#8E24AA"/>
                                <Run Text=" 味药材"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制模板" 
                        Command="{Binding CopyCommand}"
                        Width="100" Height="35" Margin="0,0,10,0"
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="关闭" 
                        Command="{Binding CloseCommand}"
                        Width="100" Height="35"
                        Background="#6C757D" Foreground="White" BorderThickness="0"
                        FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#545B62"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>