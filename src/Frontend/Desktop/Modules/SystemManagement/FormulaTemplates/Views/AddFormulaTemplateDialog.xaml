<Window x:Class="LYBT.WPF.Client.Modules.SystemManagement.FormulaTemplates.Views.AddFormulaTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="新增验方模板" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#8E24AA" Padding="20,15">
            <TextBlock Text="新增验方模板" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 主要内容 -->
        <Grid Grid.Row="1" Margin="30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：基本信息 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="基本信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <!-- 模板名称 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="模板名称 *" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="35" Padding="8,5" FontSize="14"/>
                    </StackPanel>

                    <!-- 分类 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="分类 *" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox Text="{Binding Category}" Height="35" Padding="8,5" FontSize="14" IsEditable="True">
                            <ComboBoxItem>内科方</ComboBoxItem>
                            <ComboBoxItem>外科方</ComboBoxItem>
                            <ComboBoxItem>妇科方</ComboBoxItem>
                            <ComboBoxItem>儿科方</ComboBoxItem>
                            <ComboBoxItem>皮肤科方</ComboBoxItem>
                            <ComboBoxItem>五官科方</ComboBoxItem>
                            <ComboBoxItem>骨伤科方</ComboBoxItem>
                            <ComboBoxItem>经典方</ComboBoxItem>
                            <ComboBoxItem>时方</ComboBoxItem>
                            <ComboBoxItem>验方</ComboBoxItem>
                            <ComboBoxItem>其他</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- 适应症 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="适应症 *" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Indications}" Height="60" Padding="8,5" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    </StackPanel>

                    <!-- 功效 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="功效" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Efficacy}" Height="60" Padding="8,5" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    </StackPanel>

                    <!-- 用法用量 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="用法用量" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Usage}" Height="60" Padding="8,5" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    </StackPanel>

                    <!-- 备注 -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="备注" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Remark}" Height="60" Padding="8,5" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧：药材列表 -->
            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="方剂组成" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- 添加药材区域 -->
                    <Border Grid.Row="1" Background="#F5F5F5" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" 
                                      ItemsSource="{Binding AvailableHerbs}"
                                      SelectedItem="{Binding SelectedHerb}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      Text="{Binding SearchHerbText}"
                                      Height="30" Margin="0,0,5,0"/>
                            
                            <TextBox Grid.Column="1" 
                                     Text="{Binding HerbDosage}" 
                                     Height="30" Margin="0,0,5,0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"/>
                            
                            <ComboBox Grid.Column="2" 
                                      Text="{Binding HerbUnit}" 
                                      Height="30" Margin="0,0,5,0"
                                      IsEditable="True">
                                <ComboBoxItem>g</ComboBoxItem>
                                <ComboBoxItem>克</ComboBoxItem>
                                <ComboBoxItem>个</ComboBoxItem>
                                <ComboBoxItem>片</ComboBoxItem>
                            </ComboBox>
                            
                            <Button Grid.Column="3" 
                                    Content="添加" 
                                    Command="{Binding AddHerbCommand}"
                                    Height="30" 
                                    Background="#4CAF50" 
                                    Foreground="White" 
                                    BorderThickness="0"
                                    FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- 药材列表 -->
                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding TemplateHerbs}" 
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="药材名称" Binding="{Binding HerbName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="用量" Binding="{Binding Dosage}" Width="60"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                            <DataGridTemplateColumn Header="操作" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" 
                                                Command="{Binding DataContext.RemoveHerbCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#F44336" 
                                                Foreground="White" 
                                                BorderThickness="0"
                                                Padding="5,2"
                                                Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 统计信息 -->
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="14">
                        <Run Text="共 "/>
                        <Run Text="{Binding TemplateHerbs.Count}" FontWeight="Bold" Foreground="#8E24AA"/>
                        <Run Text=" 味药材"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" 
                        Command="{Binding SaveCommand}"
                        Width="100" Height="35" Margin="0,0,10,0"
                        Background="#8E24AA" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#7B1FA2"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCCCCC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="取消" 
                        Command="{Binding CancelCommand}"
                        Width="100" Height="35"
                        Background="#6C757D" Foreground="White" BorderThickness="0"
                        FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#545B62"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>