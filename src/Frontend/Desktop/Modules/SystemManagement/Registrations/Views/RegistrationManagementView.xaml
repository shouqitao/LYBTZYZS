<UserControl x:Class="LYBT.WPF.Client.Modules.SystemManagement.Registrations.Views.RegistrationManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ManagementViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 搜索区域 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="患者姓名：" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Width="150"
                             Text="{Binding SearchPatientName, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="就诊日期：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <DatePicker SelectedDate="{Binding SearchDate}" 
                                VerticalAlignment="Center"
                                Width="150"/>
                    
                    <TextBlock Text="挂号状态：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <ComboBox SelectedItem="{Binding SelectedStatus}" 
                              ItemsSource="{Binding StatusList}" 
                              VerticalAlignment="Center"
                              Width="120"/>
                    
                    <TextBlock Text="科室：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <ComboBox SelectedItem="{Binding SelectedDepartment}" 
                              ItemsSource="{Binding DepartmentList}" 
                              VerticalAlignment="Center"
                              Width="120"/>
                    
                    <Button Content="搜索" 
                            Margin="20,0,10,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}"/>
                    <Button Content="重置" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="+ 新增挂号" 
                            Margin="0,0,10,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}"/>
                    <Button Content="批量取消" 
                            Margin="0,0,10,0"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding BatchCancelCommand}"/>
                    <Button Content="导出列表" 
                            Margin="0,0,10,0"
                            Style="{StaticResource InfoButton}"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="刷新" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource ManagementDataGrid}"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <!-- 选择框 -->
                <DataGridCheckBoxColumn Header="" 
                                        Width="40" 
                                        Binding="{Binding IsSelected}"/>
                
                <!-- 挂号单号 -->
                <DataGridTextColumn Header="挂号单号" 
                                    Binding="{Binding RegistrationNumber}" 
                                    Width="120"/>
                
                <!-- 患者姓名 -->
                <DataGridTextColumn Header="患者姓名" 
                                    Binding="{Binding PatientName}" 
                                    Width="100"/>
                
                <!-- 患者电话 -->
                <DataGridTextColumn Header="患者电话" 
                                    Binding="{Binding PatientPhone}" 
                                    Width="110"/>
                
                <!-- 科室 -->
                <DataGridTextColumn Header="科室" 
                                    Binding="{Binding Department}" 
                                    Width="100"/>
                
                <!-- 医生 -->
                <DataGridTextColumn Header="医生" 
                                    Binding="{Binding DoctorName}" 
                                    Width="100"/>
                
                <!-- 挂号类型 -->
                <DataGridTextColumn Header="挂号类型" 
                                    Binding="{Binding RegistrationTypeName}" 
                                    Width="80"/>
                
                <!-- 预约日期 -->
                <DataGridTextColumn Header="预约日期" 
                                    Binding="{Binding AppointmentDate, StringFormat='{}{0:yyyy-MM-dd}'}" 
                                    Width="100"/>
                
                <!-- 时段 -->
                <DataGridTextColumn Header="时段" 
                                    Binding="{Binding AppointmentTimeSlot}" 
                                    Width="80"/>
                
                <!-- 挂号费 -->
                <DataGridTextColumn Header="挂号费" 
                                    Binding="{Binding RegistrationFee, StringFormat='¥{0:F2}'}" 
                                    Width="80"/>
                
                <!-- 支付状态 -->
                <DataGridTemplateColumn Header="支付状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding PaymentStatusColor}" 
                                    CornerRadius="3" 
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PaymentStatusName}" 
                                           Foreground="White" 
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}" 
                                    CornerRadius="3" 
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusName}" 
                                           Foreground="White" 
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 挂号时间 -->
                <DataGridTextColumn Header="挂号时间" 
                                    Binding="{Binding CreateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                    Width="140"/>
                
                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="查看" 
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="编辑" 
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Content="取消" 
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <TextBlock Grid.Column="0" 
                           Style="{StaticResource StatusText}"
                           Text="{Binding StatusText}"/>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <Button Content="首页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding FirstPageCommand}"/>
                    
                    <Button Content="上一页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding PreviousPageCommand}"/>
                    
                    <Border Style="{StaticResource PageNumberBorder}">
                        <TextBlock FontWeight="Bold" FontSize="13">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    
                    <Button Content="下一页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding NextPageCommand}"/>
                    
                    <Button Content="末页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding LastPageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>