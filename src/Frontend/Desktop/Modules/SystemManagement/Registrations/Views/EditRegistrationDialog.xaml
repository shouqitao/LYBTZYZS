<Window x:Class="LYBT.WPF.Client.Modules.SystemManagement.Registrations.Views.EditRegistrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="编辑挂号" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <TextBlock Text="编辑挂号" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 主要内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">
                <!-- 基本信息（只读） -->
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15"
                        Background="#F9F9F9">
                    <StackPanel>
                        <TextBlock Text="基本信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="挂号单号" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.RegistrationNumber}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="患者姓名" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.PatientName}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="挂号时间" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="14"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="当前状态" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.StatusName}" FontSize="14" FontWeight="Bold" Foreground="#2196F3"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 可编辑信息 -->
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="挂号信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <!-- 科室 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="科室 *" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox SelectedItem="{Binding SelectedDepartment}" 
                                      ItemsSource="{Binding DepartmentList}"
                                      Height="35" Padding="8,5" FontSize="14"/>
                        </StackPanel>

                        <!-- 医生 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="医生 *" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Doctors}"
                                      SelectedItem="{Binding SelectedDoctor}"
                                      DisplayMemberPath="Name"
                                      Height="35" Padding="8,5" FontSize="14"/>
                        </StackPanel>

                        <!-- 挂号类型 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="挂号类型 *" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox SelectedItem="{Binding SelectedRegistrationType}" 
                                      ItemsSource="{Binding RegistrationTypeList}"
                                      Height="35" Padding="8,5" FontSize="14"/>
                        </StackPanel>

                        <!-- 就诊日期 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="就诊日期 *" FontWeight="Bold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding AppointmentDate}" 
                                        Height="35" Padding="8,5" FontSize="14"/>
                        </StackPanel>

                        <!-- 时段 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="时段 *" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox SelectedItem="{Binding SelectedTimeSlot}" 
                                      ItemsSource="{Binding TimeSlotList}"
                                      Height="35" Padding="8,5" FontSize="14"/>
                        </StackPanel>

                        <!-- 挂号费 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="挂号费 *" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding RegistrationFee, StringFormat={}{0:F2}}" 
                                     Height="35" Padding="8,5" FontSize="14" IsReadOnly="True"
                                     Background="#F5F5F5"/>
                        </StackPanel>

                        <!-- 备注 -->
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="备注" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Remark}" Height="60" Padding="8,5" 
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" 
                        Command="{Binding SaveCommand}"
                        Width="100" Height="35" Margin="0,0,10,0"
                        Background="#2196F3" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCCCCC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="取消" 
                        Command="{Binding CancelCommand}"
                        Width="100" Height="35"
                        Background="#6C757D" Foreground="White" BorderThickness="0"
                        FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#545B62"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>