<Window x:Class="LYBT.WPF.Client.Modules.SystemManagement.Registrations.Views.ViewRegistrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="挂号详情" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <TextBlock Text="挂号详情" FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 主要内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">
                <!-- 基本信息 -->
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="基本信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 挂号单号 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="挂号单号" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.RegistrationNumber}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <!-- 状态 -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                                <TextBlock Text="状态" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.StatusName}" FontSize="14" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Registration.StatusName}" Value="已预约">
                                                    <Setter Property="Foreground" Value="#2196F3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Registration.StatusName}" Value="已完成">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Registration.StatusName}" Value="已取消">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- 挂号时间 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="挂号时间" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="14"/>
                            </StackPanel>
                            
                            <!-- 支付状态 -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
                                <TextBlock Text="支付状态" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.PaymentStatusName}" FontSize="14" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Registration.IsPaid}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Registration.IsPaid}" Value="False">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- 挂号类型 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="挂号类型" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.RegistrationTypeName}" FontSize="14"/>
                            </StackPanel>
                            
                            <!-- 挂号费 -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,15">
                                <TextBlock Text="挂号费" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.RegistrationFee, StringFormat={}{0:C}}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <!-- 队列号 -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" 
                                        Visibility="{Binding Registration.QueueNumber, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="队列号" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.QueueNumber}" FontSize="16" FontWeight="Bold" Foreground="#FF5722"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 患者信息 -->
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="患者信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="姓名" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.PatientName}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="联系电话" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.PatientPhone}" FontSize="14"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="患者ID" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.PatientId}" FontSize="12" Foreground="#999"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 就诊信息 -->
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="就诊信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="科室" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.Department}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="医生" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.DoctorName}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="预约日期" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.AppointmentDate, StringFormat={}{0:yyyy-MM-dd}}" FontSize="14"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <TextBlock Text="时段" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.AppointmentTimeSlot}" FontSize="14"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="备注" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Registration.Remark}" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打印" 
                        Command="{Binding PrintCommand}"
                        Width="100" Height="35" Margin="0,0,10,0"
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="关闭" 
                        Command="{Binding CloseCommand}"
                        Width="100" Height="35"
                        Background="#6C757D" Foreground="White" BorderThickness="0"
                        FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#545B62"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>