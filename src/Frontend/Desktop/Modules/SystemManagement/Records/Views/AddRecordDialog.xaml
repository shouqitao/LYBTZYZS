<Window x:Class="LYBT.WPF.Client.Modules.SystemManagement.Records.Views.AddRecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="新增病历" 
        Height="650" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1976D2" Padding="20,15">
            <TextBlock Text="新增病历记录" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 主要内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">
                
                <!-- 基本信息 -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="患者信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 患者姓名 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="患者姓名 *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding PatientName}" Height="35" Padding="8,5"/>
                            </StackPanel>
                            
                            <!-- 患者ID/病历号 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="病历号/ID" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding PatientId}" Height="35" Padding="8,5"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 就诊日期 -->
                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="就诊日期" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding RecordDate}" Height="35"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 病历内容 -->
                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="病历记录" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                        
                        <!-- 主诉 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="主诉 *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ChiefComplaint}" 
                                     Height="60" 
                                     Padding="8,5"
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- 现病史 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="现病史" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding PresentIllness}" 
                                     Height="80" 
                                     Padding="8,5"
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- 诊断 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="诊断 *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Diagnosis}" Height="35" Padding="8,5"/>
                        </StackPanel>

                        <!-- 治疗方案 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="治疗方案" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TreatmentPlan}" 
                                     Height="80" 
                                     Padding="8,5"
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- 备注 -->
                        <StackPanel>
                            <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Remark}" 
                                     Height="60" 
                                     Padding="8,5"
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,15">
                <Button Content="保存" 
                        Command="{Binding SaveCommand}"
                        Width="100" 
                        Height="35" 
                        Background="#1976D2" 
                        Foreground="White" 
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1565C0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="取消" 
                        Command="{Binding CancelCommand}"
                        Width="100" 
                        Height="35" 
                        Background="#757575" 
                        Foreground="White" 
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#616161"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>