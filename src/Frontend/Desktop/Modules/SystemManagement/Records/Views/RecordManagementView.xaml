<UserControl x:Class="LYBT.WPF.Client.Modules.SystemManagement.Records.Views.RecordManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <TextBlock Text="病历记录管理" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 搜索和操作栏 -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="15,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行搜索条件 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="SearchTextBox" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="150" Height="25" Margin="0,0,10,0" ToolTip="输入患者姓名、主诉或诊断"/>
                        
                        <TextBlock Text="患者：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailablePatients}" SelectedItem="{Binding SelectedPatient}"
                                 DisplayMemberPath="Name" Width="120" Height="25" Margin="0,0,10,0"/>
                        
                        <TextBlock Text="开始日期：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker SelectedDate="{Binding SearchStartDate}" Width="120" Height="25" Margin="0,0,10,0"/>
                        
                        <TextBlock Text="结束日期：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker SelectedDate="{Binding SearchEndDate}" Width="120" Height="25" Margin="0,0,10,0"/>
                        
                        <Button Content="搜索" Command="{Binding SearchCommand}" 
                               Width="60" Height="25" Background="#2196F3" Foreground="White" Margin="0,0,5,0"/>
                        <Button Content="重置" Command="{Binding ResetSearchCommand}" 
                               Width="60" Height="25" Background="#757575" Foreground="White"/>
                    </StackPanel>

                    <!-- 操作按钮区域 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="新增病历" Command="{Binding AddRecordCommand}" 
                               Width="80" Height="30" Background="#4CAF50" Foreground="White" Margin="0,0,5,0"/>
                        <Button Content="编辑" Command="{Binding EditRecordCommand}" 
                               Width="60" Height="30" Background="#FF9800" Foreground="White" Margin="0,0,5,0"/>
                        <Button Content="导出" Command="{Binding ExportCommand}" 
                               Width="60" Height="30" Background="#9C27B0" Foreground="White" Margin="0,0,5,0"/>
                        <Button Content="刷新" Command="{Binding RefreshCommand}" 
                               Width="60" Height="30" Background="#607D8B" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- 加载指示器 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="正在加载..." Foreground="#666" VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 病历列表 -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                 AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                 GridLinesVisibility="Horizontal" AlternatingRowBackground="#F9F9F9"
                 SelectionMode="Single" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="50"/>
                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                <DataGridTextColumn Header="就诊日期" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                <DataGridTextColumn Header="主诉" Binding="{Binding ChiefComplaint}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ChiefComplaint}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="诊断结果" Binding="{Binding Diagnosis}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Diagnosis}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="创建者" Binding="{Binding CreatedBy}" Width="100"/>
                <DataGridCheckBoxColumn Header="是否共享" Binding="{Binding IsShared}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="查看" CommandParameter="{Binding}" 
                                       Command="{Binding DataContext.ViewRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Width="40" Height="20" Background="#2196F3" Foreground="White" Margin="2"/>
                                <Button Content="编辑" CommandParameter="{Binding}" 
                                       Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Width="40" Height="20" Background="#FF9800" Foreground="White" Margin="2"/>
                                <Button Content="共享" CommandParameter="{Binding}" 
                                       Command="{Binding DataContext.ShareRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Width="40" Height="20" Background="#4CAF50" Foreground="White" Margin="2"/>
                                <Button Content="删除" CommandParameter="{Binding}" 
                                       Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Width="40" Height="20" Background="#F44336" Foreground="White" Margin="2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#E9ECEF" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="双击行可查看详情" Foreground="#666" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
</UserControl>