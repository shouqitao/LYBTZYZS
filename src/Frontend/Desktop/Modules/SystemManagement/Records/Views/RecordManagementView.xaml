<UserControl x:Class="LYBT.WPF.Client.Modules.SystemManagement.Records.Views.RecordManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ManagementViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolBarBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 搜索区域 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="搜索：" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Width="150"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入患者姓名、主诉或诊断">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    
                    <TextBlock Text="患者：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailablePatients}" 
                              SelectedItem="{Binding SelectedPatient}"
                              DisplayMemberPath="Name" 
                              Width="120" 
                              VerticalAlignment="Center"/>
                    
                    <TextBlock Text="开始日期：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <DatePicker SelectedDate="{Binding SearchStartDate}" 
                                Width="120" 
                                VerticalAlignment="Center"/>
                    
                    <TextBlock Text="结束日期：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <DatePicker SelectedDate="{Binding SearchEndDate}" 
                                Width="120" 
                                VerticalAlignment="Center"/>
                    
                    <Button Content="搜索" 
                            Margin="20,0,10,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}"/>
                    <Button Content="重置" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetSearchCommand}"/>
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="+ 新增病历" 
                            Margin="0,0,10,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddRecordCommand}"/>
                    <Button Content="导出" 
                            Margin="0,0,10,0"
                            Style="{StaticResource InfoButton}"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="刷新" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource ManagementDataGrid}"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <!-- 患者姓名 -->
                <DataGridTextColumn Header="患者姓名" 
                                    Binding="{Binding PatientName}" 
                                    Width="100"/>
                
                <!-- 就诊日期 -->
                <DataGridTextColumn Header="就诊日期" 
                                    Binding="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                    Width="140"/>
                
                <!-- 主诉 -->
                <DataGridTextColumn Header="主诉" 
                                    Binding="{Binding ChiefComplaint}" 
                                    Width="250">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ChiefComplaint}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- 诊断结果 -->
                <DataGridTextColumn Header="诊断结果" 
                                    Binding="{Binding Diagnosis}" 
                                    Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Diagnosis}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- 创建者 -->
                <DataGridTextColumn Header="创建者" 
                                    Binding="{Binding CreatedBy}" 
                                    Width="100"/>
                
                <!-- 是否共享 -->
                <DataGridTemplateColumn Header="共享状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding IsShared, Converter={StaticResource BooleanToBrushConverter}}" 
                                    CornerRadius="3" 
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding IsShared, Converter={StaticResource BooleanToShareTextConverter}}" 
                                           Foreground="White" 
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 创建时间 -->
                <DataGridTextColumn Header="创建时间" 
                                    Binding="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd}'}" 
                                    Width="100"/>
                
                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="查看" 
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="编辑" 
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="共享" 
                                        Style="{StaticResource InfoButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ShareCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="删除" 
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <TextBlock Grid.Column="0" 
                           Style="{StaticResource StatusText}"
                           Text="{Binding StatusText}"/>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <Button Content="首页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding FirstPageCommand}"/>
                    
                    <Button Content="上一页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding PreviousPageCommand}"/>
                    
                    <Border Style="{StaticResource PageNumberBorder}">
                        <TextBlock FontWeight="Bold" FontSize="13">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    
                    <Button Content="下一页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding NextPageCommand}"/>
                    
                    <Button Content="末页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding LastPageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>