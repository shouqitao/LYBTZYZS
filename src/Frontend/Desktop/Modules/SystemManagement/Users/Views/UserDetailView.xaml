<UserControl x:Class="LYBT.WPF.Client.Modules.SystemManagement.Users.Views.UserDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部操作栏 -->
            <Border Grid.Row="0" 
                    Background="#F8F9FA" 
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="← 返回"
                                Command="{Binding GoBackCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#666"
                                FontSize="14"
                                Cursor="Hand"
                                Padding="10,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="编辑信息"
                                Command="{Binding EditUserCommand}"
                                Background="#2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,8"
                                Margin="0,0,10,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="重置密码"
                                Command="{Binding ResetPasswordCommand}"
                                Background="#FF9800"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="15,8"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 基本信息 -->
            <Border Grid.Row="1" 
                    Background="White" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            CornerRadius="8,8,0,0"
                            Padding="20,15">
                        <TextBlock Text="基本信息"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </Border>

                    <!-- 内容 -->
                    <Grid Grid.Row="1" Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 头像 -->
                        <Border Grid.Column="0" Grid.Row="0"
                                Width="100" Height="100"
                                CornerRadius="50"
                                Background="#2E86AB"
                                Margin="0,0,30,0">
                            <TextBlock Text="{Binding User.Username, Converter={StaticResource FirstCharacterConverter}}"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 基本信息列表 -->
                        <Grid Grid.Column="1" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <!-- 第一列 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="用户名：" 
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding User.Username}" 
                                       FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="真实姓名：" 
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding User.RealName}" 
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="角色：" 
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <Border Grid.Row="2" Grid.Column="1"
                                    Background="#E3F2FD"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding User.Role}"
                                           Foreground="#1976D2"
                                           FontSize="12"/>
                            </Border>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="状态：" 
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" 
                                        Orientation="Horizontal" 
                                        VerticalAlignment="Center">
                                <Border CornerRadius="12"
                                        Padding="10,4"
                                        Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding User.IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding User.IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding User.IsActive}" Value="True">
                                                        <Setter Property="Text" Value="已启用"/>
                                                        <Setter Property="Foreground" Value="#388E3C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding User.IsActive}" Value="False">
                                                        <Setter Property="Text" Value="已禁用"/>
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="12"
                                        Padding="10,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding User.IsOnline}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding User.IsOnline}" Value="False">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding User.IsOnline}" Value="True">
                                                        <Setter Property="Text" Value="在线"/>
                                                        <Setter Property="Foreground" Value="#388E3C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding User.IsOnline}" Value="False">
                                                        <Setter Property="Text" Value="离线"/>
                                                        <Setter Property="Foreground" Value="#666"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- 第二列 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="部门：" 
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" 
                                       Text="{Binding User.Department, TargetNullValue='--'}" 
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="职位：" 
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" 
                                       Text="{Binding User.Position, TargetNullValue='--'}" 
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="邮箱：" 
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" 
                                       Text="{Binding User.Email, TargetNullValue='--'}" 
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="2" Text="电话：" 
                                       Foreground="#666" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" 
                                       Text="{Binding User.PhoneNumber, TargetNullValue='--'}" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- 登录信息 -->
            <Border Grid.Row="2" 
                    Background="White" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            CornerRadius="8,8,0,0"
                            Padding="20,15">
                        <TextBlock Text="登录信息"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </Border>

                    <!-- 内容 -->
                    <Grid Grid.Row="1" Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最后登录时间：" 
                                   Foreground="#666" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding User.LastLoginTime, StringFormat='yyyy-MM-dd HH:mm:ss', TargetNullValue='--'}" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最后登录IP：" 
                                   Foreground="#666" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                   Text="{Binding User.LastLoginIp, TargetNullValue='--'}" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="创建时间：" 
                                   Foreground="#666" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                   Text="{Binding User.CreateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="更新时间：" 
                                   Foreground="#666" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" 
                                   Text="{Binding User.UpdateTime, StringFormat='yyyy-MM-dd HH:mm:ss', TargetNullValue='--'}" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 备注信息 -->
            <Border Grid.Row="3" 
                    Background="White" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            CornerRadius="8,8,0,0"
                            Padding="20,15">
                        <TextBlock Text="备注信息"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </Border>

                    <!-- 内容 -->
                    <TextBlock Grid.Row="1" 
                               Margin="20"
                               Text="{Binding User.Remark, TargetNullValue='暂无备注'}"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Foreground="#666"/>
                </Grid>
            </Border>

            <!-- 操作历史（可选） -->
            <Border Grid.Row="4" 
                    Background="White" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            CornerRadius="8,8,0,0"
                            Padding="20,15">
                        <TextBlock Text="最近操作历史"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </Border>

                    <!-- 内容 -->
                    <ItemsControl Grid.Row="1" 
                                  ItemsSource="{Binding OperationHistory}"
                                  Margin="20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OperationTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                   Foreground="#666"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>