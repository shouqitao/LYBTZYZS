<UserControl x:Class="LYBT.Desktop.Admin.Prescriptions.Views.PrescriptionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ManagementViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- 动画样式 -->
            <Storyboard x:Key="LoadingAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                From="0.3" To="1" Duration="0:0:0.5"
                                AutoReverse="True" RepeatBehavior="Forever"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 统计卡片区域 -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 今日处方数 -->
                <Border Grid.Column="0" Margin="5" Background="White" CornerRadius="8">
                    <StackPanel Padding="15">
                        <TextBlock Text="今日处方" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding TodayPrescriptionCount}" 
                                  FontSize="28" FontWeight="Bold" Foreground="#2196F3"/>
                        <TextBlock FontSize="11" Foreground="#999">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}较昨日 {0:+#;-#;0} ({1:P0})">
                                    <Binding Path="TodayChange"/>
                                    <Binding Path="TodayChangePercent"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- 本周处方数 -->
                <Border Grid.Column="1" Margin="5" Background="White" CornerRadius="8">
                    <StackPanel Padding="15">
                        <TextBlock Text="本周处方" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding WeekPrescriptionCount}" 
                                  FontSize="28" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                </Border>
                
                <!-- 本月处方数 -->
                <Border Grid.Column="2" Margin="5" Background="White" CornerRadius="8">
                    <StackPanel Padding="15">
                        <TextBlock Text="本月处方" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding MonthPrescriptionCount}" 
                                  FontSize="28" FontWeight="Bold" Foreground="#FF9800"/>
                    </StackPanel>
                </Border>
                
                <!-- 待审核 -->
                <Border Grid.Column="3" Margin="5" Background="White" CornerRadius="8">
                    <StackPanel Padding="15">
                        <TextBlock Text="待审核" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding PendingCount}" 
                                  FontSize="28" FontWeight="Bold" Foreground="#FFC107"/>
                        <Button Content="立即处理" FontSize="11" Padding="5,2" Margin="0,5,0,0"
                                Background="#FFC107" Foreground="White" BorderThickness="0"
                                Command="{Binding ProcessPendingCommand}"/>
                    </StackPanel>
                </Border>
                
                <!-- 今日营收 -->
                <Border Grid.Column="4" Margin="5" Background="White" CornerRadius="8">
                    <StackPanel Padding="15">
                        <TextBlock Text="今日营收" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding TodayRevenue, StringFormat='¥{0:F2}'}" 
                                  FontSize="24" FontWeight="Bold" Foreground="#E91E63"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource ToolBarBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 搜索区域 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="关键词：" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Width="150"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    
                    <TextBlock Text="患者：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <TextBox Width="120"
                             Style="{StaticResource SearchTextBox}"
                             Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="医生：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <TextBox Width="120"
                             Style="{StaticResource SearchTextBox}"
                             Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Text="状态：" Style="{StaticResource LabelText}" Margin="20,0,10,0"/>
                    <ComboBox SelectedValue="{Binding SelectedStatus}" 
                              ItemsSource="{Binding StatusOptions}"
                              DisplayMemberPath="Display" 
                              SelectedValuePath="Value"
                              Width="100"
                              VerticalAlignment="Center"/>
                    
                    <Button Content="搜索" 
                            Margin="20,0,10,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}"/>
                    <Button Content="重置" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>

                <!-- 操作按钮区域 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="+ 新增处方" 
                            Margin="0,0,10,0"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddCommand}"/>
                    <Button Content="导出" 
                            Margin="0,0,10,0"
                            Style="{StaticResource InfoButton}"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="刷新" 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  Style="{StaticResource ManagementDataGrid}"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <!-- 处方编号 -->
                <DataGridTextColumn Header="处方编号" 
                                    Binding="{Binding PrescriptionNumber}" 
                                    Width="120"/>
                
                <!-- 患者姓名 -->
                <DataGridTextColumn Header="患者姓名" 
                                    Binding="{Binding PatientName}" 
                                    Width="100"/>
                
                <!-- 医生姓名 -->
                <DataGridTextColumn Header="医生姓名" 
                                    Binding="{Binding DoctorName}" 
                                    Width="100"/>
                
                <!-- 诊断 -->
                <DataGridTextColumn Header="诊断" 
                                    Binding="{Binding Diagnosis}" 
                                    Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Diagnosis}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- 剂数 -->
                <DataGridTextColumn Header="剂数" 
                                    Binding="{Binding DosageCount}" 
                                    Width="60"/>
                
                <!-- 总价 -->
                <DataGridTextColumn Header="总价(元)" 
                                    Binding="{Binding TotalPrice, StringFormat='{}{0:F2}'}" 
                                    Width="80"/>
                
                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}" 
                                    CornerRadius="3" 
                                    Padding="8,4"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StatusName}" 
                                           Foreground="White" 
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 创建时间 -->
                <DataGridTextColumn Header="创建时间" 
                                    Binding="{Binding CreateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                    Width="140"/>
                
                <!-- 操作 -->
                <DataGridTemplateColumn Header="操作" Width="320">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="查看" 
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="编辑" 
                                        Style="{StaticResource SuccessButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="打印" 
                                        Style="{StaticResource InfoButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="作废" 
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.VoidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanVoid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Content="删除" 
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,4"
                                        FontSize="12"
                                        Margin="2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="3" Style="{StaticResource StatusBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <TextBlock Grid.Column="0" 
                           Style="{StaticResource StatusText}"
                           Text="{Binding StatusText}"/>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <Button Content="首页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding FirstPageCommand}"/>
                    
                    <Button Content="上一页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding PreviousPageCommand}"/>
                    
                    <Border Style="{StaticResource PageNumberBorder}">
                        <TextBlock FontWeight="Bold" FontSize="13">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="CurrentPage"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    
                    <Button Content="下一页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding NextPageCommand}"/>
                    
                    <Button Content="末页" 
                            Style="{StaticResource PaginationButton}"
                            Command="{Binding LastPageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>