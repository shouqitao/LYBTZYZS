<Window x:Class="LYBT.Desktop.Admin.Prescriptions.Views.PrescriptionTemplateEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="编辑处方模板" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
        </Border>
        
        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧：基本信息 -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Border Background="White" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="基本信息" FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/>
                            
                            <!-- 模板名称 -->
                            <TextBlock Text="模板名称 *" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding TemplateName}" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,10"/>
                            
                            <!-- 分类 -->
                            <TextBlock Text="分类 *" Style="{StaticResource LabelStyle}"/>
                            <ComboBox SelectedItem="{Binding SelectedCategory}" 
                                      ItemsSource="{Binding Categories}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,0,0,10"/>
                            
                            <!-- 适用证型 -->
                            <TextBlock Text="适用证型" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Syndrome}" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,10"/>
                            
                            <!-- 治则治法 -->
                            <TextBlock Text="治则治法" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding TreatmentPrinciple}" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,10"/>
                            
                            <!-- 诊断 -->
                            <TextBlock Text="适用诊断" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Diagnosis}" 
                                     Style="{StaticResource TextBoxStyle}" 
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="60"
                                     Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="White" CornerRadius="4" Padding="15">
                        <StackPanel>
                            <TextBlock Text="用法设置" FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/>
                            
                            <!-- 默认剂数 -->
                            <TextBlock Text="默认剂数" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding DosageCount}" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,10"/>
                            
                            <!-- 用法用量 -->
                            <TextBlock Text="用法用量" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Usage}" 
                                     Style="{StaticResource TextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="60"
                                     Margin="0,0,0,10"/>
                            
                            <!-- 备注 -->
                            <TextBlock Text="备注说明" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Remark}" 
                                     Style="{StaticResource TextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="60"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- 右侧：药材列表 -->
                <Border Grid.Column="1" Background="White" CornerRadius="4" Padding="15" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 标题和操作 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="药材配方" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="➕ 添加药材" 
                                        Padding="10,5" 
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="AddHerb_Click"/>
                                <Button Content="🗑 清空" 
                                        Padding="10,5" 
                                        Margin="10,0,0,0"
                                        Background="#F44336"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ClearHerbs_Click"/>
                            </StackPanel>
                        </DockPanel>
                        
                        <!-- 药材列表 -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding HerbItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="True"
                                  GridLinesVisibility="None"
                                  BorderThickness="1"
                                  BorderBrush="#E0E0E0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="药材名称" 
                                                    Binding="{Binding HerbName}" 
                                                    Width="*"
                                                    IsReadOnly="True"/>
                                <DataGridTextColumn Header="数量" 
                                                    Binding="{Binding Quantity}" 
                                                    Width="60"/>
                                <DataGridTextColumn Header="单位" 
                                                    Binding="{Binding Unit}" 
                                                    Width="50"/>
                                <DataGridTextColumn Header="炮制" 
                                                    Binding="{Binding ProcessMethod}" 
                                                    Width="80"/>
                                <DataGridTextColumn Header="备注" 
                                                    Binding="{Binding Remark}" 
                                                    Width="100"/>
                                <DataGridTemplateColumn Header="操作" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="删除" 
                                                    Padding="5,2"
                                                    Background="#F44336"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveHerbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <!-- 统计信息 -->
                        <Border Grid.Row="2" Background="#F5F5F5" Padding="10" Margin="0,10,0,0" CornerRadius="4">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="共 {0} 味药材，预估单剂价格：¥{1:F2}">
                                        <Binding Path="HerbCount"/>
                                        <Binding Path="EstimatedPrice"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20,15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <CheckBox Content="设为公开模板" 
                              IsChecked="{Binding IsPublic}"
                              VerticalAlignment="Center"
                              FontSize="13"/>
                    <TextBlock Text="（公开模板所有医生可用）" 
                               Foreground="#999"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存" 
                            Padding="30,8" 
                            Background="#2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="Save_Click"/>
                    <Button Content="取消" 
                            Padding="30,8" 
                            Margin="10,0,0,0"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            FontSize="14"
                            Cursor="Hand"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>