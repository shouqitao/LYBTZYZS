<Window x:Class="LYBT.Desktop.Admin.Prescriptions.Views.PrescriptionPrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="处方打印预览" 
        Height="800" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="BorderBrush" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                <TextBlock Text="缩放：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="ZoomComboBox" Width="100" SelectedIndex="2" SelectionChanged="ZoomComboBox_SelectionChanged">
                    <ComboBoxItem>50%</ComboBoxItem>
                    <ComboBoxItem>75%</ComboBoxItem>
                    <ComboBoxItem>100%</ComboBoxItem>
                    <ComboBoxItem>125%</ComboBoxItem>
                    <ComboBoxItem>150%</ComboBoxItem>
                    <ComboBoxItem>200%</ComboBoxItem>
                    <ComboBoxItem>适应宽度</ComboBoxItem>
                    <ComboBoxItem>适应页面</ComboBoxItem>
                </ComboBox>
                
                <Separator Width="1" Height="20" Background="#E0E0E0" Margin="20,0"/>
                
                <Button Style="{StaticResource ToolButton}" Click="PageSetup_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="页面设置"/>
                    </StackPanel>
                </Button>
                
                <Button Style="{StaticResource ToolButton}" Click="ExportPdf_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="导出PDF"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- 预览区域 -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto"
                      Background="#F5F5F5">
            <Border Background="White" 
                    Margin="20" 
                    BorderBrush="#D0D0D0" 
                    BorderThickness="1"
                    Effect="{DynamicResource CardShadowEffect}">
                <FlowDocumentScrollViewer x:Name="DocumentViewer" 
                                         VerticalScrollBarVisibility="Hidden"
                                         HorizontalScrollBarVisibility="Hidden"
                                         Zoom="100"
                                         IsToolBarVisible="False"/>
            </Border>
        </ScrollViewer>
        
        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PrescriptionInfoText" 
                               Foreground="#666"
                               FontSize="12"/>
                </StackPanel>
                
                <!-- 右侧按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PrintButton" 
                            Style="{StaticResource PrimaryButton}"
                            Click="Print_Click"
                            Width="100">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock Text="打印"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="CancelButton" 
                            Style="{StaticResource ToolButton}"
                            Click="Cancel_Click"
                            Width="80">
                        取消
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>