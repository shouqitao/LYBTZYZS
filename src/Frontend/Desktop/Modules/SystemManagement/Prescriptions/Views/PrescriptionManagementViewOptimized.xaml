<UserControl x:Class="LYBT.Desktop.Admin.Prescriptions.Views.PrescriptionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ManagementViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- 动画样式 -->
            <Storyboard x:Key="LoadingAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                From="0.3" To="1" Duration="0:0:0.5"
                                AutoReverse="True" RepeatBehavior="Forever"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 统计卡片区域 -->
        <Border Grid.Row="0" Background="#F8F9FA" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 今日处方数 -->
                <Border Grid.Column="0" Margin="5" Background="White" CornerRadius="8" 
                        Effect="{StaticResource CardShadowEffect}">
                    <StackPanel Padding="15">
                        <TextBlock Text="今日处方" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding TodayPrescriptionCount}" 
                                  FontSize="28" FontWeight="Bold" Foreground="#2196F3"/>
                        <TextBlock FontSize="11" Foreground="#999">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}较昨日 {0:+#;-#;0} ({1:P0})">
                                    <Binding Path="TodayChange"/>
                                    <Binding Path="TodayChangePercent"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- 本周处方数 -->
                <Border Grid.Column="1" Margin="5" Background="White" CornerRadius="8"
                        Effect="{StaticResource CardShadowEffect}">
                    <StackPanel Padding="15">
                        <TextBlock Text="本周处方" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding WeekPrescriptionCount}" 
                                  FontSize="28" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                </Border>
                
                <!-- 本月处方数 -->
                <Border Grid.Column="2" Margin="5" Background="White" CornerRadius="8"
                        Effect="{StaticResource CardShadowEffect}">
                    <StackPanel Padding="15">
                        <TextBlock Text="本月处方" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding MonthPrescriptionCount}" 
                                  FontSize="28" FontWeight="Bold" Foreground="#FF9800"/>
                    </StackPanel>
                </Border>
                
                <!-- 待审核 -->
                <Border Grid.Column="3" Margin="5" Background="White" CornerRadius="8"
                        Effect="{StaticResource CardShadowEffect}">
                    <StackPanel Padding="15">
                        <TextBlock Text="待审核" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding PendingCount}" 
                                  FontSize="28" FontWeight="Bold" Foreground="#FFC107"/>
                        <Button Content="立即处理" FontSize="11" Padding="5,2" Margin="0,5,0,0"
                                Background="#FFC107" Foreground="White" BorderThickness="0"
                                Command="{Binding ProcessPendingCommand}"/>
                    </StackPanel>
                </Border>
                
                <!-- 今日营收 -->
                <Border Grid.Column="4" Margin="5" Background="White" CornerRadius="8"
                        Effect="{StaticResource CardShadowEffect}">
                    <StackPanel Padding="15">
                        <TextBlock Text="今日营收" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="{Binding TodayRevenue, StringFormat='¥{0:F2}'}" 
                                  FontSize="24" FontWeight="Bold" Foreground="#E91E63"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="White" Padding="15" Margin="0,0,0,10"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 快速操作按钮 -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,15">
                    <Button Style="{StaticResource ModernPrimaryButton}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock Text="新增处方" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Command>
                            <Binding Path="AddCommand"/>
                        </Button.Command>
                    </Button>
                    
                    <Button Style="{StaticResource ModernInfoButton}" Margin="0,0,10,0"
                            Command="{Binding BatchPrintCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock Text="批量打印" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource ModernSuccessButton}" Margin="0,0,10,0"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock Text="导出Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource ModernWarningButton}" Margin="0,0,10,0"
                            Command="{Binding StatisticsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock Text="统计分析" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Separator Width="1" Height="30" Background="#E0E0E0" Margin="10,0"/>
                    
                    <Button Style="{StaticResource ModernSecondaryButton}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 搜索区域 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <WrapPanel Grid.Column="0">
                        <!-- 关键词搜索 -->
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,10,5">
                            <Grid>
                                <TextBox Width="200" Padding="30,8,10,8" BorderThickness="0"
                                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                        Tag="搜索处方编号、患者、诊断...">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="🔍" FontSize="14" Margin="8,0,0,0" 
                                          VerticalAlignment="Center" Foreground="#999"/>
                            </Grid>
                        </Border>
                        
                        <!-- 时间范围选择 -->
                        <ComboBox Width="120" Margin="0,0,10,5" Padding="8,8"
                                 ItemsSource="{Binding TimeRangeOptions}"
                                 SelectedItem="{Binding SelectedTimeRange}"
                                 DisplayMemberPath="Display"/>
                        
                        <!-- 自定义日期范围 -->
                        <DatePicker Width="120" Margin="0,0,5,5"
                                   SelectedDate="{Binding StartDate}"
                                   DisplayDateEnd="{x:Static sys:DateTime.Today}"/>
                        <TextBlock Text="至" VerticalAlignment="Center" Margin="5,0"/>
                        <DatePicker Width="120" Margin="5,0,10,5"
                                   SelectedDate="{Binding EndDate}"
                                   DisplayDateEnd="{x:Static sys:DateTime.Today}"/>
                        
                        <!-- 状态筛选 -->
                        <ComboBox Width="100" Margin="0,0,10,5" Padding="8,8"
                                 ItemsSource="{Binding StatusOptions}"
                                 SelectedItem="{Binding SelectedStatus}"
                                 DisplayMemberPath="Display"/>
                        
                        <!-- 医生筛选 -->
                        <ComboBox Width="120" Margin="0,0,10,5" Padding="8,8"
                                 ItemsSource="{Binding DoctorOptions}"
                                 SelectedItem="{Binding SelectedDoctor}"
                                 DisplayMemberPath="Name"/>
                    </WrapPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="搜索" Padding="15,8" Margin="0,0,5,0"
                               Style="{StaticResource ModernPrimaryButton}"
                               Command="{Binding SearchCommand}"/>
                        <Button Content="重置" Padding="15,8"
                               Style="{StaticResource ModernSecondaryButton}"
                               Command="{Binding ClearFiltersCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- 批量操作栏（选中项时显示） -->
                <Border Grid.Row="2" Background="#E3F2FD" Padding="10" Margin="0,10,0,0" CornerRadius="4"
                       Visibility="{Binding HasSelectedItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedItemsCount, StringFormat='已选择 {0} 项'}"
                                  VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="Bold"/>
                        <Button Content="批量打印" Style="{StaticResource ModernInfoButton}" Margin="0,0,10,0"
                               Command="{Binding BatchPrintSelectedCommand}"/>
                        <Button Content="批量导出" Style="{StaticResource ModernSuccessButton}" Margin="0,0,10,0"
                               Command="{Binding BatchExportSelectedCommand}"/>
                        <Button Content="批量作废" Style="{StaticResource ModernDangerButton}" Margin="0,0,10,0"
                               Command="{Binding BatchVoidSelectedCommand}"/>
                        <Button Content="取消选择" Style="{StaticResource ModernSecondaryButton}"
                               Command="{Binding ClearSelectionCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <Border Grid.Row="2" Background="White" Margin="0,0,0,10">
            <Grid>
                <!-- 加载动画 -->
                <Border Background="White" Opacity="0.9" 
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Panel.ZIndex="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                        <TextBlock Text="正在加载数据..." Margin="0,10,0,0" FontSize="14" Foreground="#666"/>
                    </StackPanel>
                </Border>
                
                <!-- 数据网格 -->
                <DataGrid ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         SelectionMode="Extended"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         GridLinesVisibility="None"
                         HeadersVisibility="Column"
                         AlternatingRowBackground="#FAFAFA"
                         RowHeight="45">
                    
                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F0F0F0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    
                    <DataGrid.Columns>
                        <!-- 复选框列 -->
                        <DataGridCheckBoxColumn Header="✓" Width="40"
                                               Binding="{Binding IsSelected}"/>
                        
                        <!-- 处方编号 -->
                        <DataGridTemplateColumn Header="处方编号" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrescriptionNumber}"
                                              FontWeight="Bold" Foreground="#2196F3"
                                              VerticalAlignment="Center" Margin="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- 患者信息 -->
                        <DataGridTemplateColumn Header="患者信息" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,5">
                                        <TextBlock Text="{Binding PatientName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding PatientInfo}" FontSize="11" Foreground="#666"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- 医生 -->
                        <DataGridTextColumn Header="开方医生" Binding="{Binding DoctorName}" Width="100"/>
                        
                        <!-- 诊断 -->
                        <DataGridTemplateColumn Header="诊断" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Diagnosis}" 
                                              TextTrimming="CharacterEllipsis"
                                              ToolTip="{Binding Diagnosis}"
                                              VerticalAlignment="Center" Margin="10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- 处方详情 -->
                        <DataGridTemplateColumn Header="处方详情" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,5">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}味药 × {1}剂">
                                                    <Binding Path="HerbCount"/>
                                                    <Binding Path="DosageCount"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='¥{0:F2}'}"
                                                  FontWeight="Bold" Foreground="#E91E63"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- 状态 -->
                        <DataGridTemplateColumn Header="状态" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor}" 
                                           CornerRadius="12" Padding="12,4"
                                           HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatusName}" 
                                                  Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- 时间 -->
                        <DataGridTemplateColumn Header="开方时间" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="10,5">
                                        <TextBlock Text="{Binding CreateTime, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                  FontWeight="Bold"/>
                                        <TextBlock Text="{Binding CreateTime, StringFormat='{}{0:HH:mm:ss}'}"
                                                  FontSize="11" Foreground="#666"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- 操作 -->
                        <DataGridTemplateColumn Header="操作" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="👁 查看" Style="{StaticResource ModernLinkButton}"
                                               Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                        <Button Content="✏️ 编辑" Style="{StaticResource ModernLinkButton}"
                                               Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Button Content="🖨️ 打印" Style="{StaticResource ModernLinkButton}"
                                               Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                        <Button Content="❌ 作废" Style="{StaticResource ModernLinkButton}" Foreground="#F44336"
                                               Command="{Binding DataContext.VoidCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanVoid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 状态栏和分页 -->
        <Border Grid.Row="3" Background="White" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="显示" Margin="0,0,5,0" Foreground="#666"/>
                    <ComboBox Width="60" SelectedItem="{Binding PageSize}">
                        <ComboBoxItem>10</ComboBoxItem>
                        <ComboBoxItem>20</ComboBoxItem>
                        <ComboBoxItem>50</ComboBoxItem>
                        <ComboBoxItem>100</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="条/页" Margin="5,0,20,0" Foreground="#666"/>
                    <TextBlock Foreground="#666">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}共 {0} 条记录，当前第 {1}-{2} 条">
                                <Binding Path="TotalCount"/>
                                <Binding Path="CurrentPageStart"/>
                                <Binding Path="CurrentPageEnd"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 分页控件 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏮" ToolTip="首页" Padding="8,4" Margin="2"
                           Style="{StaticResource ModernPaginationButton}"
                           Command="{Binding FirstPageCommand}"/>
                    <Button Content="◀" ToolTip="上一页" Padding="8,4" Margin="2"
                           Style="{StaticResource ModernPaginationButton}"
                           Command="{Binding PreviousPageCommand}"/>
                    
                    <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="5,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Number}" Padding="8,4" Margin="2"
                                       Style="{StaticResource ModernPaginationButton}"
                                       Background="{Binding IsCurrentPage, Converter={StaticResource CurrentPageBackgroundConverter}}"
                                       Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding Number}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <Button Content="▶" ToolTip="下一页" Padding="8,4" Margin="2"
                           Style="{StaticResource ModernPaginationButton}"
                           Command="{Binding NextPageCommand}"/>
                    <Button Content="⏭" ToolTip="末页" Padding="8,4" Margin="2"
                           Style="{StaticResource ModernPaginationButton}"
                           Command="{Binding LastPageCommand}"/>
                    
                    <TextBox Width="50" Margin="10,0,5,0" Text="{Binding JumpToPage}"
                            VerticalContentAlignment="Center"/>
                    <Button Content="跳转" Padding="8,4"
                           Style="{StaticResource ModernSecondaryButton}"
                           Command="{Binding JumpToPageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>