<UserControl x:Class="LYBT.WPF.Client.Modules.SystemManagement.Prescriptions.Views.ViewPrescriptionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Height="700" Width="1000" Background="White">
    
    <UserControl.Resources>
        <!-- 圆角边框样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="2" BlurRadius="5" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题样式 -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 标签样式 -->
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 值样式 -->
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004085"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 加载指示器样式 -->
        <Style x:Key="LoadingStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 加载指示器 -->
        <StackPanel Style="{StaticResource LoadingStyle}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="正在加载处方详情..." FontSize="14" Foreground="#666666" HorizontalAlignment="Center"/>
            <ProgressBar Width="200" Height="4" Margin="0,10,0,0" IsIndeterminate="True"/>
        </StackPanel>

        <!-- 主要内容 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel Margin="20">
                
                <!-- 标题栏 -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="处方详情" FontSize="24" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="打印" Command="{Binding PrintCommand}" Style="{StaticResource ActionButtonStyle}" Background="#28A745"/>
                        <Button Content="编辑" Command="{Binding EditCommand}" Style="{StaticResource ActionButtonStyle}" Background="#FFC107" Foreground="#333333" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="作废" Command="{Binding VoidCommand}" Style="{StaticResource ActionButtonStyle}" Background="#DC3545" Visibility="{Binding CanVoid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="关闭" Command="{Binding CloseCommand}" Style="{StaticResource ActionButtonStyle}" Background="#6C757D"/>
                    </StackPanel>
                </Grid>

                <!-- 基本信息 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="基本信息" Style="{StaticResource TitleTextStyle}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 第一行 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="处方编号：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PrescriptionNumber}" Style="{StaticResource ValueTextStyle}" FontWeight="Bold" Margin="0,0,20,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="状态：" Style="{StaticResource LabelTextStyle}"/>
                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Background="{Binding StatusColor}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding StatusDescription}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <!-- 第二行 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="患者：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatientName}" Style="{StaticResource ValueTextStyle}" Margin="0,0,20,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="医生：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DoctorName}" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,5"/>

                            <!-- 第三行 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="诊断：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Prescription.Diagnosis}" Style="{StaticResource ValueTextStyle}" Margin="0,0,0,5"/>

                            <!-- 第四行 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="创建时间：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreateTimeDescription}" Style="{StaticResource ValueTextStyle}" Margin="0,0,20,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="剂数：" Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Prescription.DosageCount, StringFormat={}{0}帖}" Style="{StaticResource ValueTextStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 用药清单 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="用药清单" Style="{StaticResource TitleTextStyle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TotalItemCount, StringFormat={}共{0}味药}" Style="{StaticResource LabelTextStyle}" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding TotalWeight, StringFormat={}总重量：{0}g}" Style="{StaticResource LabelTextStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 药材列表表头 -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4,4,0,0">
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="药材名称" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="用量" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="单位" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="单价" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="小计" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 药材列表内容 -->
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DEE2E6" BorderThickness="1,0,1,1" Background="White">
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToNumberConverter}}" 
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666666"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HerbName}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#007BFF" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Unit}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Price, StringFormat={}￥{0:F2}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Subtotal, StringFormat={}￥{0:F2}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#28A745"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 总计信息 -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" Padding="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="总价：" FontSize="14" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Prescription.TotalPrice, StringFormat={}￥{0:F2}}" FontSize="16" FontWeight="Bold" Foreground="#DC3545"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 空数据提示 -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" 
                                Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}" Padding="20">
                            <TextBlock Text="暂无药材信息" HorizontalAlignment="Center" Foreground="#999999" FontStyle="Italic"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 服用方法和备注 -->
                <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding Prescription.Usage, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="服用方法" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="{Binding Prescription.Usage}" Style="{StaticResource ValueTextStyle}" 
                                   Background="#F8F9FA" Padding="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding Prescription.Remark, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="备注信息" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Text="{Binding Prescription.Remark}" Style="{StaticResource ValueTextStyle}" 
                                   Background="#FFF3CD" Padding="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>