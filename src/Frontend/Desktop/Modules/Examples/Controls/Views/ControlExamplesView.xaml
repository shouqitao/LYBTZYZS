<UserControl x:Class="LYBT.WPF.Client.Modules.Examples.Controls.Views.ControlExamplesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.WPF.Client.Controls.Users;assembly=LYBT.WPF.Client.Core"
             xmlns:herbControls="clr-namespace:LYBT.WPF.Client.Controls.Herbs;assembly=LYBT.WPF.Client.Core"
             xmlns:patientControls="clr-namespace:LYBT.WPF.Client.Controls.Patients;assembly=LYBT.WPF.Client.Core"
             xmlns:templateControls="clr-namespace:LYBT.WPF.Client.Controls.FormulaTemplates;assembly=LYBT.WPF.Client.Core"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="20">
            <TextBlock Text="控件使用示例" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"/>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- 1. 值转换器示例 -->
                <Border Background="White" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="1. 值转换器示例" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"/>
                        
                        <!-- BooleanToBackgroundConverter -->
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BooleanToBackgroundConverter:" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" 
                                    Height="30" 
                                    Background="{Binding IsActive, Converter={StaticResource BooleanToBackgroundConverter}}"
                                    CornerRadius="4">
                                <TextBlock Text="{Binding IsActive, StringFormat='IsActive: {0}'}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- FirstCharacterConverter -->
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FirstCharacterConverter:" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Width="40" Height="40" 
                                        CornerRadius="20" 
                                        Background="#2E86AB">
                                    <TextBlock Text="{Binding SampleName, Converter={StaticResource FirstCharacterConverter}}"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding SampleName, StringFormat=' (来自: {0})'}" 
                                           VerticalAlignment="Center" 
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- GenderToTextConverter -->
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GenderToTextConverter:" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding SampleGender, Converter={StaticResource GenderToTextConverter}}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- IDNumberMaskConverter -->
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IDNumberMaskConverter:" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding SampleIDNumber}" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" → " 
                                           VerticalAlignment="Center" 
                                           Margin="10,0"/>
                                <TextBlock Text="{Binding SampleIDNumber, Converter={StaticResource IDNumberMaskConverter}}"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- InvertBooleanConverter -->
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="InvertBooleanConverter:" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsActive}" Content="原始值" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding IsActive, Converter={StaticResource InvertBooleanConverter}}" 
                                          Content="反转后" 
                                          VerticalAlignment="Center" 
                                          Margin="20,0,0,0"
                                          IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- 切换按钮 -->
                        <Button Content="切换布尔值测试" 
                                Command="{Binding ToggleBooleanCommand}"
                                Padding="15,8" 
                                Margin="0,15,0,0"
                                HorizontalAlignment="Left"
                                Background="#2E86AB" 
                                Foreground="White" 
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1F5F99"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 2. 用户列表项控件示例 -->
                <Border Background="White" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="2. 用户列表项控件示例" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock Text="UserListItemControl - 用于显示用户列表中的单个用户" 
                                   Margin="0,0,0,10"
                                   Foreground="#666"/>
                        
                        <!-- 示例用户列表 -->
                        <Border Background="#F8F9FA" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ItemsControl ItemsSource="{Binding SampleUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:UserListItemControl Data="{Binding}" Margin="0,1,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. 控件状态切换示例 -->
                <Border Background="White" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="3. 状态切换按钮示例" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock Text="展示启用/禁用切换按钮的不同状态" 
                                   Margin="0,0,0,10"
                                   Foreground="#666"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 启用状态 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="启用状态：" VerticalAlignment="Center"/>
                            <Button Grid.Row="0" Grid.Column="1"
                                    Width="32" Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip="禁用"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="6">
                                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M7,10L17,10L17,14L7,14Z"
                                                  Fill="#F44336" 
                                                  Width="16" 
                                                  Height="16"
                                                  Stretch="Uniform"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="点击将禁用" VerticalAlignment="Center"/>
                            
                            <!-- 禁用状态 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="禁用状态：" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="1"
                                    Width="32" Height="32"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTip="启用"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="6">
                                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M10,16.5L16,12L10,7.5"
                                                  Fill="#4CAF50" 
                                                  Width="16" 
                                                  Height="16"
                                                  Stretch="Uniform"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="点击将启用" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. 草药列表项控件示例 -->
                <Border Background="White" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="4. 草药列表项控件示例" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock Text="展示草药信息，包括库存状态、价格等" 
                                   Margin="0,0,0,10"
                                   Foreground="#666"/>
                        
                        <ItemsControl ItemsSource="{Binding SampleHerbs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <herbControls:HerbListItemControl Data="{Binding}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 5. 患者列表项控件示例 -->
                <Border Background="White" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="5. 患者列表项控件示例" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock Text="展示患者基本信息，过敏史会特别标注" 
                                   Margin="0,0,0,10"
                                   Foreground="#666"/>
                        
                        <ItemsControl ItemsSource="{Binding SamplePatients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <patientControls:PatientListItemControl Data="{Binding}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 6. 验方模板列表项控件示例 -->
                <Border Background="White" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="6. 验方模板列表项控件示例" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock Text="展示验方模板，支持查看、编辑、应用和删除操作" 
                                   Margin="0,0,0,10"
                                   Foreground="#666"/>
                        
                        <ItemsControl ItemsSource="{Binding SampleTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <templateControls:FormulaTemplateListItemControl Data="{Binding}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 7. 使用说明 -->
                <Border Background="#F0F7FF" 
                        BorderBrush="#2196F3" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="使用说明" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#1976D2"
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock TextWrapping="Wrap" LineHeight="24">
                            <TextBlock.Text>
1. 值转换器已在 App.xaml 中全局注册，可在任何地方使用
2. 各模块列表项控件需要传入对应的 DTO 类型的 Data 属性
3. 状态切换按钮会根据 IsActive 属性自动变更图标和颜色
4. 草药控件会根据库存数量自动显示不同的库存状态
5. 患者控件会自动高亮显示过敏史信息
6. 所有控件都支持数据绑定和命令绑定，可与 MVVM 模式完美配合
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>