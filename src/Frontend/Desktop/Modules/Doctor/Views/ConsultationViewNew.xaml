<UserControl x:Class="LYBT.WPF.Client.Modules.Doctor.Views.ConsultationViewNew"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 患者信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="当前患者：" Foreground="White" FontSize="14" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PatientDisplayInfo}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <!-- 医生信息 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="医生：" Foreground="White" FontSize="14" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding DoctorName}" Foreground="White" FontSize="14"/>
                    <TextBlock Text=" | " Foreground="White" FontSize="14" Margin="5,0"/>
                    <TextBlock Text="{Binding ConsultationTime, StringFormat='yyyy-MM-dd HH:mm'}" 
                              Foreground="White" FontSize="14"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="选择患者" Command="{Binding LoadPatientCommand}" 
                           Style="{StaticResource SecondaryButtonStyle}" Margin="2"/>
                    <Button Content="保存进度" Command="{Binding SaveProgressCommand}" 
                           Style="{StaticResource SuccessButtonStyle}" Margin="2"/>
                    <Button Content="完成看诊" Command="{Binding CompleteConsultationCommand}" 
                           Style="{StaticResource PrimaryButtonStyle}" Margin="2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧排队列表 -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}" Padding="10">
                        <Grid>
                            <TextBlock Text="候诊队列" FontSize="16" FontWeight="Bold"/>
                            <Button Content="刷新" Command="{Binding RefreshQueueCommand}" 
                                   HorizontalAlignment="Right" Style="{StaticResource LinkButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- 队列列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding WaitingQueue}" 
                            SelectedItem="{Binding SelectedQueueItem}"
                            Background="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="5" Background="{StaticResource CardBackgroundBrush}" 
                                       CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding QueueNumber, StringFormat='#{0}'}" 
                                                      FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding PatientName}" FontSize="16" 
                                                      FontWeight="Bold" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="{Binding RegistrationType}" 
                                                  FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
                                        
                                        <Grid Grid.Row="2" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="12" 
                                                      HorizontalAlignment="Left"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="叫号" 
                                                       Command="{Binding DataContext.CallPatientCommand, 
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Style="{StaticResource LinkButtonStyle}" Margin="2,0"/>
                                                <Button Content="开始看诊" 
                                                       Command="{Binding DataContext.StartConsultationCommand, 
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Style="{StaticResource LinkButtonStyle}" Margin="2,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧看诊内容 -->
            <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="10">
                <!-- 病史采集 -->
                <TabItem Header="病史采集">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <GroupBox Header="主诉" Margin="0,5">
                                <TextBox Text="{Binding ChiefComplaint}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="60"/>
                            </GroupBox>

                            <GroupBox Header="现病史" Margin="0,5">
                                <TextBox Text="{Binding PresentIllness}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="100"/>
                            </GroupBox>

                            <GroupBox Header="既往史" Margin="0,5">
                                <TextBox Text="{Binding PastHistory}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="60"/>
                            </GroupBox>

                            <GroupBox Header="过敏史" Margin="0,5">
                                <TextBox Text="{Binding AllergyHistory}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="40"/>
                            </GroupBox>

                            <GroupBox Header="体格检查" Margin="0,5">
                                <TextBox Text="{Binding PhysicalExamination}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="100"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 中医四诊 -->
                <TabItem Header="中医四诊">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <GroupBox Header="望诊" Margin="0,5">
                                <TextBox Text="{Binding Inspection}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="80"/>
                            </GroupBox>

                            <GroupBox Header="闻诊" Margin="0,5">
                                <TextBox Text="{Binding AuscultationOlfaction}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="60"/>
                            </GroupBox>

                            <GroupBox Header="问诊" Margin="0,5">
                                <TextBox Text="{Binding Inquiry}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="100"/>
                            </GroupBox>

                            <GroupBox Header="切诊" Margin="0,5">
                                <TextBox Text="{Binding Palpation}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="60"/>
                            </GroupBox>

                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Column="0" Header="舌诊" Margin="0,0,5,0">
                                    <TextBox Text="{Binding TongueInspection}" TextWrapping="Wrap" MinHeight="40"/>
                                </GroupBox>

                                <GroupBox Grid.Column="1" Header="脉诊" Margin="5,0,0,0">
                                    <TextBox Text="{Binding PulseCondition}" TextWrapping="Wrap" MinHeight="40"/>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 生命体征 -->
                <TabItem Header="生命体征">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="3" Margin="0,10">
                            <GroupBox Header="体温 (°C)" Margin="5">
                                <TextBox Text="{Binding Temperature}" FontSize="16" 
                                        HorizontalContentAlignment="Center"/>
                            </GroupBox>

                            <GroupBox Header="血压 (mmHg)" Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SystolicPressure}" 
                                            HorizontalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="/" Margin="5,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding DiastolicPressure}" 
                                            HorizontalContentAlignment="Center"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="心率 (次/分)" Margin="5">
                                <TextBox Text="{Binding HeartRate}" FontSize="16" 
                                        HorizontalContentAlignment="Center"/>
                            </GroupBox>

                            <GroupBox Header="呼吸 (次/分)" Margin="5">
                                <TextBox Text="{Binding RespiratoryRate}" FontSize="16" 
                                        HorizontalContentAlignment="Center"/>
                            </GroupBox>
                        </UniformGrid>

                        <!-- 可以添加图表显示区域 -->
                        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" 
                               CornerRadius="5" Margin="5,20">
                            <TextBlock Text="生命体征趋势图（待实现）" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="Gray" FontSize="14"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 诊断处方 -->
                <TabItem Header="诊断处方">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <GroupBox Header="中医辨证" Margin="0,5">
                                <TextBox Text="{Binding TCMDiagnosis}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="60"/>
                            </GroupBox>

                            <GroupBox Header="西医诊断" Margin="0,5">
                                <TextBox Text="{Binding WesternDiagnosis}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="60"/>
                            </GroupBox>

                            <GroupBox Header="诊断（综合）" Margin="0,5">
                                <TextBox Text="{Binding Diagnosis}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="60" FontWeight="Bold"/>
                            </GroupBox>

                            <GroupBox Header="治疗原则" Margin="0,5">
                                <TextBox Text="{Binding TreatmentPrinciple}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="40"/>
                            </GroupBox>

                            <GroupBox Header="医嘱" Margin="0,5">
                                <TextBox Text="{Binding MedicalAdvice}" TextWrapping="Wrap" 
                                        AcceptsReturn="True" MinHeight="60"/>
                            </GroupBox>

                            <Button Content="开具处方" Command="{Binding OpenPrescriptionCommand}" 
                                   Style="{StaticResource PrimaryButtonStyle}" 
                                   HorizontalAlignment="Center" Margin="0,20" Padding="20,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 历史记录 -->
                <TabItem Header="历史记录">
                    <Grid Margin="20">
                        <TextBlock Text="患者历史就诊记录（待实现）" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="Gray" FontSize="14"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="16" IsIndeterminate="{Binding IsLoading}" 
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>