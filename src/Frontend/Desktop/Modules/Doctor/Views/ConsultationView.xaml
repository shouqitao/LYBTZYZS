<UserControl x:Class="LYBT.WPF.Client.Modules.Doctor.Views.ConsultationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="医生看诊" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text=" - 处方开具与打印" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：患者信息和诊断 -->
                <StackPanel Grid.Column="0">
                    <!-- 患者信息 -->
                    <GroupBox Header="患者信息" Margin="0,0,0,15">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名：" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentRecord.Patient.Name}" Margin="0,0,10,0" Height="25"/>
                            
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="性别：" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" SelectedItem="{Binding CurrentRecord.Patient.Gender}" 
                                     Height="25" Margin="0,0,0,10">
                                <ComboBoxItem Content="男"/>
                                <ComboBoxItem Content="女"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="年龄：" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PatientAge}" Margin="0,0,10,10" Height="25"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="电话：" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CurrentRecord.Patient.Phone}" Height="25" Margin="0,0,0,10"/>
                        </Grid>
                    </GroupBox>

                    <!-- 诊断信息 -->
                    <GroupBox Header="诊断信息" Margin="0,0,0,15">
                        <StackPanel Margin="10">
                            <TextBlock Text="主诉：" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CurrentRecord.ChiefComplaint}" Height="50" AcceptsReturn="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                            <TextBlock Text="现病史：" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CurrentRecord.PresentIllness}" Height="60" AcceptsReturn="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                            <TextBlock Text="中医诊断：" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CurrentRecord.TCMDiagnosisResult}" Height="40" AcceptsReturn="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                            <TextBlock Text="治疗原则：" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CurrentRecord.TreatmentPrinciple}" Height="40" AcceptsReturn="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 医嘱 -->
                    <GroupBox Header="医嘱">
                        <StackPanel Margin="10">
                            <TextBox Text="{Binding CurrentRecord.DoctorAdvice}" Height="60" AcceptsReturn="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="复诊时间：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker SelectedDate="{Binding CurrentRecord.FollowUpDate}" Width="150"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- 右侧：处方管理 -->
                <StackPanel Grid.Column="2">
                    <!-- 处方开具 -->
                    <GroupBox Header="处方开具" Margin="0,0,0,15">
                        <StackPanel Margin="10">
                            <!-- 药材选择 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableHerbs}" 
                                         SelectedItem="{Binding SelectedHerb}" DisplayMemberPath="Name" 
                                         IsEditable="True" Height="25"/>
                                <Button Grid.Column="1" Content="添加" Command="{Binding AddHerbCommand}" 
                                       Width="60" Height="25" Margin="5,0,0,0" Background="#4CAF50" Foreground="White"/>
                            </Grid>

                            <!-- 药材列表 -->
                            <DataGrid ItemsSource="{Binding CurrentRecord.Prescription}" AutoGenerateColumns="False" 
                                     Height="300" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="药材名称" Binding="{Binding Herb.Name}" Width="*"/>
                                    <DataGridTextColumn Header="剂量" Binding="{Binding Dosage}" Width="60"/>
                                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="40"/>
                                    <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat=F2}" Width="60"/>
                                    <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=F2}" Width="60" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="操作" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" CommandParameter="{Binding}" 
                                                       Command="{Binding DataContext.RemoveHerbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Background="#F44336" Foreground="White" Height="20" FontSize="10"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 处方总计 -->
                            <Border Background="#E3F2FD" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding PrescriptionSummary}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding TotalAmountText}" Foreground="#1976D2" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- 处方预览 -->
                    <GroupBox Header="处方预览">
                        <StackPanel Margin="10">
                            <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding PrescriptionPreview}" FontFamily="Consolas" FontSize="10" 
                                          Background="#F5F5F5" Padding="10" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 底部操作按钮 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="生成预览" Command="{Binding GeneratePreviewCommand}" 
                       Width="100" Height="35" Margin="0,0,10,0" Background="#2196F3" Foreground="White"/>
                
                <Button Content="保存病历" Command="{Binding SaveRecordCommand}" 
                       Width="100" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White"/>
                
                <Button Content="打印处方" Command="{Binding PrintPrescriptionCommand}" 
                       Width="100" Height="35" Margin="0,0,10,0" Background="#FF9800" Foreground="White"/>
                
                <Button Content="保存PDF" Command="{Binding SavePdfCommand}" 
                       Width="100" Height="35" Margin="0,0,10,0" Background="#9C27B0" Foreground="White"/>
                
                <Button Content="完成看诊" Command="{Binding CompleteConsultationCommand}" 
                       Width="100" Height="35" Background="#4CAF50" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>