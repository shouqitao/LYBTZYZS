<UserControl x:Class="LYBT.WPF.Client.Modules.Doctor.Views.ConsultationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 患者信息栏 -->
        <Border Grid.Row="0" Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 患者基本信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="患者：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRecord.Patient.Name}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="5,0,20,0"/>
                    <TextBlock Text="性别：" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRecord.Patient.GenderText}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="年龄：" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRecord.Patient.AgeDescription}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="手机：" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRecord.Patient.PhoneNumber}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="就诊时间：" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentRecord.ConsultationDate, StringFormat=yyyy-MM-dd HH:mm}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="保存诊疗记录" 
                            Padding="15,8" 
                            Margin="0,0,10,0"
                            Background="#4CAF50" 
                            Foreground="White" 
                            BorderThickness="0"
                            Command="{Binding SaveRecordCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#45A049"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="打印处方" 
                            Padding="15,8" 
                            Margin="0,0,10,0"
                            Background="#2196F3" 
                            Foreground="White" 
                            BorderThickness="0"
                            Command="{Binding PrintPrescriptionCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1976D2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="完成诊疗" 
                            Padding="15,8"
                            Background="#FF9800" 
                            Foreground="White" 
                            BorderThickness="0"
                            Command="{Binding CompleteConsultationCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F57C00"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：诊疗信息录入 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- 主诉 -->
                    <GroupBox Header="主诉" Margin="0,0,0,15">
                        <TextBox Text="{Binding CurrentRecord.ChiefComplaint, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="60" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="5"/>
                    </GroupBox>

                    <!-- 现病史 -->
                    <GroupBox Header="现病史" Margin="0,0,0,15">
                        <TextBox Text="{Binding CurrentRecord.PresentIllness, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="80" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="5"/>
                    </GroupBox>

                    <!-- 既往史 -->
                    <GroupBox Header="既往史" Margin="0,0,0,15">
                        <TextBox Text="{Binding CurrentRecord.PastHistory, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="60" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="5"/>
                    </GroupBox>

                    <!-- 体格检查 -->
                    <GroupBox Header="体格检查" Margin="0,0,0,15">
                        <TextBox Text="{Binding CurrentRecord.PhysicalExamination, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="80" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="5"/>
                    </GroupBox>

                    <!-- 中医四诊 -->
                    <GroupBox Header="中医四诊" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 望诊 -->
                            <TextBlock Grid.Row="0" Text="望诊：" Margin="0,5,0,5"/>
                            <TextBox Grid.Row="1" Text="{Binding CurrentRecord.TCMDiagnosis.Inspection, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,0,0,10"/>

                            <!-- 舌象 -->
                            <TextBlock Grid.Row="2" Text="舌象：" Margin="0,0,0,5"/>
                            <TextBox Grid.Row="3" Text="{Binding CurrentRecord.TCMDiagnosis.TongueExamination, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,0,0,10"/>

                            <!-- 脉象 -->
                            <TextBlock Grid.Row="4" Text="脉象：" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CurrentRecord.TCMDiagnosis.Palpation, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" TextWrapping="Wrap" AcceptsReturn="True" Padding="5"/>
                        </Grid>
                    </GroupBox>

                    <!-- 诊断 -->
                    <GroupBox Header="诊断" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="中医诊断：" Margin="0,5,0,5"/>
                            <TextBox Grid.Row="1" Text="{Binding CurrentRecord.TCMDiagnosisResult, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Text="西医诊断：" Margin="0,0,0,5"/>
                            <TextBox Grid.Row="3" Text="{Binding CurrentRecord.WesternDiagnosis, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="5"/>
                        </Grid>
                    </GroupBox>

                    <!-- 治疗原则 -->
                    <GroupBox Header="治疗原则" Margin="0,0,0,15">
                        <TextBox Text="{Binding CurrentRecord.TreatmentPrinciple, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="60" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="5"/>
                    </GroupBox>

                    <!-- 医嘱 -->
                    <GroupBox Header="医嘱" Margin="0,0,0,15">
                        <TextBox Text="{Binding CurrentRecord.DoctorAdvice, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="80" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="5"/>
                    </GroupBox>

                    <!-- 复诊时间 -->
                    <GroupBox Header="复诊时间">
                        <DatePicker SelectedDate="{Binding CurrentRecord.FollowUpDate}" 
                                    Height="30"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" 
                          Background="#E0E0E0" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch"/>

            <!-- 右侧：处方管理 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 处方操作栏 -->
                <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="处方管理" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="添加药材" 
                                    Padding="10,5" 
                                    Margin="0,0,10,0"
                                    Background="#4CAF50" 
                                    Foreground="White" 
                                    BorderThickness="0"
                                    Command="{Binding AddHerbCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="3"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#45A049"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="加载模板" 
                                    Padding="10,5"
                                    Background="#2196F3" 
                                    Foreground="White" 
                                    BorderThickness="0"
                                    Command="{Binding LoadTemplateCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="3"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1976D2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 处方列表 -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding CurrentRecord.Prescription}" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F8F9FA"
                          RowBackground="White"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="药材名称" Binding="{Binding Herb.Name}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="剂量" Binding="{Binding Dosage}" Width="60"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat=F2}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=F2}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="用法" Binding="{Binding Usage}" Width="100"/>
                        <DataGridTemplateColumn Header="操作" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="删除" 
                                            Padding="5,2" 
                                            Background="#F44336" 
                                            Foreground="White" 
                                            BorderThickness="0"
                                            FontSize="11"
                                            Command="{Binding DataContext.RemoveHerbCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="2"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#D32F2F"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 处方汇总 -->
                <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="处方用法：水煎服，日一剂，早晚温服" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="处方总价：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentRecord.TotalAmount, StringFormat=F2}" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Foreground="#F44336" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" 元" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>