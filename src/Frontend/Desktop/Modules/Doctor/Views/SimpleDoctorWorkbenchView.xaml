<UserControl x:Class="LYBT.WPF.Client.Modules.Doctor.Views.SimpleDoctorWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="20,15">
                <TextBlock Text="医生工作台" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="当前医生：" FontWeight="Bold"/>
                    <Run Text="{Binding CurrentDoctorName}" Foreground="#2E86AB"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：患者队列 -->
            <Border Grid.Column="0" Background="White" CornerRadius="5" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2E86AB" CornerRadius="5,5,0,0" Padding="15,10">
                        <TextBlock Text="待诊患者" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding WaitingPatients}" 
                             SelectedItem="{Binding CurrentRegistration}"
                             BorderThickness="0" Padding="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0">
                                            <Run Text="{Binding QueueNumber}" FontWeight="Bold" Foreground="#2E86AB"/>
                                            <Run Text="号 -"/>
                                            <Run Text="{Binding PatientName}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Text="{Binding RegistrationTime, StringFormat='挂号时间：{0:HH:mm}'}" 
                                                   Foreground="Gray" FontSize="12" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：看诊区域 -->
            <Border Grid.Column="1" Background="White" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 患者信息 -->
                        <GroupBox Grid.Row="0" Header="患者信息" Margin="0,0,0,15">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0">
                                    <Run Text="姓名：" FontWeight="Bold"/>
                                    <Run Text="{Binding CurrentPatient.Name}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1">
                                    <Run Text="性别：" FontWeight="Bold"/>
                                    <Run Text="{Binding CurrentPatient.Gender}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2">
                                    <Run Text="年龄：" FontWeight="Bold"/>
                                    <Run Text="{Binding CurrentPatient.Age}"/>
                                    <Run Text="岁"/>
                                </TextBlock>
                                <TextBlock Grid.Column="3">
                                    <Run Text="电话：" FontWeight="Bold"/>
                                    <Run Text="{Binding CurrentPatient.PhoneNumber}"/>
                                </TextBlock>
                            </Grid>
                        </GroupBox>

                        <!-- 病史采集 -->
                        <GroupBox Grid.Row="1" Header="病史采集" Margin="0,0,0,15">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="主诉 *" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ChiefComplaint}" 
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="现病史 *" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PresentIllness}" 
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"/>
                            </Grid>
                        </GroupBox>

                        <!-- 中医辨证 -->
                        <GroupBox Grid.Row="2" Header="中医辨证" Margin="0,0,0,15">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="辨证 *" FontWeight="Bold" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TcmDiagnosis}" 
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,10"/>

                                <!-- 四诊信息（可选） -->
                                <Expander Grid.Row="1" Grid.Column="1" Header="四诊详情（可选）">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="望诊" Margin="0,0,0,5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LookDiagnosis}" Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="闻诊" Margin="0,0,0,5"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ListenDiagnosis}" Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="问诊" Margin="0,0,0,5"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AskDiagnosis}" Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="切诊"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PulseDiagnosis}"/>
                                    </Grid>
                                </Expander>
                            </Grid>
                        </GroupBox>

                        <!-- 处方开具 -->
                        <GroupBox Grid.Row="3" Header="处方开具" Margin="0,0,0,15">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 验方模板选择 -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="验方模板：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FormulaTemplates}" 
                                              SelectedItem="{Binding SelectedTemplate}"
                                              DisplayMemberPath="Name"/>
                                    <Button Grid.Column="2" Content="应用模板" Margin="10,0,0,0" Padding="10,5"
                                            IsEnabled="{Binding SelectedTemplate, Converter={StaticResource NotNullToBooleanConverter}}"/>
                                </Grid>

                                <!-- 添加药材 -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="添加药材：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableHerbs}" 
                                              SelectedItem="{Binding SelectedHerb}"
                                              DisplayMemberPath="Name"/>
                                    <Button Grid.Column="2" Content="添加" Command="{Binding AddHerbToPrescriptionCommand}" 
                                            Margin="10,0,0,0" Padding="15,5"/>
                                </Grid>

                                <!-- 处方列表 -->
                                <DataGrid Grid.Row="2" ItemsSource="{Binding PrescriptionItems}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="药材名称" Binding="{Binding HerbName}" Width="150" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="剂量" Binding="{Binding Quantity}" Width="80"/>
                                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="单价" Binding="{Binding Price, StringFormat='￥{0:F2}'}" Width="80" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="小计" Binding="{Binding Subtotal, StringFormat='￥{0:F2}'}" Width="100" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="操作" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="删除" Command="{Binding DataContext.RemoveHerbFromPrescriptionCommand, 
                                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource LinkButtonStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 总价 -->
                                <TextBlock Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Run Text="处方总价：" FontWeight="Bold"/>
                                    <Run Text="{Binding TotalPrice, StringFormat='￥{0:F2}'}" Foreground="#FF5722" FontSize="18" FontWeight="Bold"/>
                                </TextBlock>
                            </Grid>
                        </GroupBox>

                        <!-- 操作按钮 -->
                        <Grid Grid.Row="5" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="清空处方" Command="{Binding ClearPrescriptionCommand}" 
                                        Margin="0,0,10,0" Padding="15,8" Background="#FFC107"/>
                                <Button Content="打印处方" Command="{Binding PrintPrescriptionCommand}" 
                                        Margin="0,0,10,0" Padding="15,8" Background="#4CAF50" Foreground="White"/>
                                <Button Content="保存并完成" Command="{Binding SaveAndCompleteCommand}" 
                                        Padding="20,8" Background="#2E86AB" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 加载遮罩 -->
        <Grid Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" CornerRadius="5" Padding="30,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="加载中..." HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>