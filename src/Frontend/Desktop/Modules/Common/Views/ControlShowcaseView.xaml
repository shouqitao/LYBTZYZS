<UserControl x:Class="LYBT.WPF.Client.Modules.Common.Views.ControlShowcaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:LYBT.WPF.Client.Controls;assembly=LYBT.WPF.Client.Core"
             xmlns:herbControls="clr-namespace:LYBT.WPF.Client.Controls.Herbs;assembly=LYBT.WPF.Client.Core"
             xmlns:patientControls="clr-namespace:LYBT.WPF.Client.Controls.Patients;assembly=LYBT.WPF.Client.Core"
             xmlns:doctorControls="clr-namespace:LYBT.WPF.Client.Controls.Doctors;assembly=LYBT.WPF.Client.Core"
             xmlns:formulaControls="clr-namespace:LYBT.WPF.Client.Controls.FormulaTemplates;assembly=LYBT.WPF.Client.Core"
             xmlns:userControls="clr-namespace:LYBT.WPF.Client.Controls.Users;assembly=LYBT.WPF.Client.Core"
             xmlns:prescriptionControls="clr-namespace:LYBT.WPF.Client.Controls.Prescriptions;assembly=LYBT.WPF.Client.Core"
             xmlns:registrationControls="clr-namespace:LYBT.WPF.Client.Controls.Registration;assembly=LYBT.WPF.Client.Core"
             xmlns:billingControls="clr-namespace:LYBT.WPF.Client.Controls.Billing;assembly=LYBT.WPF.Client.Core"
             xmlns:diagnosisControls="clr-namespace:LYBT.WPF.Client.Controls.DiagnosisTreatment;assembly=LYBT.WPF.Client.Core"
             xmlns:queueingControls="clr-namespace:LYBT.WPF.Client.Controls.Queueing;assembly=LYBT.WPF.Client.Core"
             xmlns:recordControls="clr-namespace:LYBT.WPF.Client.Controls.Records;assembly=LYBT.WPF.Client.Core"
             xmlns:pharmacyControls="clr-namespace:LYBT.WPF.Client.Controls.Pharmacy;assembly=LYBT.WPF.Client.Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1000">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="凌隐宝堂中医诊所诊疗系统 - 控件展示"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>
            
            <!-- 核心业务控件 -->
            <Border Background="#F5F5F5"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="核心业务控件"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>
                    
                    <!-- 中药材列表项 -->
                    <TextBlock Text="中药材列表项控件 (HerbListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <herbControls:HerbListItemControl Data="{Binding SampleHerb}"/>
                    </Border>
                    
                    <!-- 患者列表项 -->
                    <TextBlock Text="患者列表项控件 (PatientListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <patientControls:PatientListItemControl Data="{Binding SamplePatient}"/>
                    </Border>
                    
                    <!-- 医生列表项 -->
                    <TextBlock Text="医生列表项控件 (DoctorListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <doctorControls:DoctorListItemControl Data="{Binding SampleDoctor}"/>
                    </Border>
                    
                    <!-- 验方模板列表项 -->
                    <TextBlock Text="验方模板列表项控件 (FormulaTemplateListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <formulaControls:FormulaTemplateListItemControl Data="{Binding SampleFormulaTemplate}"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- 诊疗流程控件 -->
            <Border Background="#F5F5F5"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="诊疗流程控件"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>
                    
                    <!-- 挂号列表项 -->
                    <TextBlock Text="挂号列表项控件 (RegistrationListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <registrationControls:RegistrationListItemControl Data="{Binding SampleRegistration}"/>
                    </Border>
                    
                    <!-- 诊断治疗列表项 -->
                    <TextBlock Text="诊断治疗列表项控件 (DiagnosisTreatmentListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <diagnosisControls:DiagnosisTreatmentListItemControl Data="{Binding SampleDiagnosisTreatment}"/>
                    </Border>
                    
                    <!-- 处方列表项 -->
                    <TextBlock Text="处方列表项控件 (PrescriptionListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <prescriptionControls:PrescriptionListItemControl Data="{Binding SamplePrescription}"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- 业务支持控件 -->
            <Border Background="#F5F5F5"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="业务支持控件"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>
                    
                    <!-- 账单列表项 -->
                    <TextBlock Text="账单列表项控件 (BillingListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <billingControls:BillingListItemControl Data="{Binding SampleBilling}"/>
                    </Border>
                    
                    <!-- 排队列表项 -->
                    <TextBlock Text="排队列表项控件 (QueueItemListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <queueingControls:QueueItemListItemControl 
                            Data="{Binding SampleQueueItem}"
                            QueueNumber="{Binding SampleQueueNumber}"/>
                    </Border>
                    
                    <!-- 病历列表项 -->
                    <TextBlock Text="病历列表项控件 (RecordListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <recordControls:RecordListItemControl Data="{Binding SampleRecord}"/>
                    </Border>
                    
                    <!-- 药房列表项 -->
                    <TextBlock Text="药房列表项控件 (PharmacyListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <pharmacyControls:PharmacyListItemControl Data="{Binding SamplePharmacy}"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- 用户管理控件 -->
            <Border Background="#F5F5F5"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="用户管理控件"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>
                    
                    <!-- 用户列表项 -->
                    <TextBlock Text="用户列表项控件 (UserListItemControl)"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,0,15">
                        <userControls:UserListItemControl Data="{Binding SampleUser}"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- 控件特性说明 -->
            <Border Background="#E3F2FD"
                    CornerRadius="8"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="控件特性"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap"
                               LineHeight="20">
                        <Run Text="• "/>
                        <Run Text="所有控件支持动画效果（淡入、悬停缩放）"/>
                        <LineBreak/>
                        <Run Text="• "/>
                        <Run Text="响应式布局，自适应不同屏幕尺寸"/>
                        <LineBreak/>
                        <Run Text="• "/>
                        <Run Text="状态可视化，使用颜色和图标区分不同状态"/>
                        <LineBreak/>
                        <Run Text="• "/>
                        <Run Text="支持MVVM模式，通过依赖属性进行数据绑定"/>
                        <LineBreak/>
                        <Run Text="• "/>
                        <Run Text="命令绑定支持，可响应用户交互操作"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>