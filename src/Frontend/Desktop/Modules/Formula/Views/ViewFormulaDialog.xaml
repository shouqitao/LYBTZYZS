<Window x:Class="LYBT.Desktop.Formula.Views.ViewFormulaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:LYBT.Desktop.Formula.ViewModels"
        mc:Ignorable="d"
        Title="查看验方模板" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=viewmodels:ViewFormulaDialogViewModel}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColorBrush}" Padding="15,10">
            <TextBlock Text="验方模板详情" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 基本信息 -->
                <GroupBox Grid.Row="0" Header="基本信息" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 验方名称 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="验方名称：" FontWeight="Bold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding Formula.Name}" Margin="0,0,0,10" />

                        <!-- 分类 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分类：" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Formula.Category}" Margin="0,0,0,10" />

                        <!-- 来源 -->
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="来源：" FontWeight="Bold" Margin="10,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="{Binding Formula.Source}" Margin="0,0,0,10" />

                        <!-- 适应症 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="适应症：" FontWeight="Bold" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding Formula.Indications}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <!-- 用法用量 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="用法用量：" FontWeight="Bold" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding Formula.DosageInstruction}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <!-- 创建时间 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="创建时间：" FontWeight="Bold" />
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding Formula.CreateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />

                        <!-- 更新时间 -->
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="更新时间：" FontWeight="Bold" Margin="10,0,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="3"
                                   Text="{Binding Formula.UpdateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                    </Grid>
                </GroupBox>

                <!-- 药材组成 -->
                <GroupBox Grid.Row="1" Header="药材组成" Margin="0,0,0,15">
                    <DataGrid ItemsSource="{Binding HerbItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              Height="200"
                              Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Width="50">
                                <DataGridTextColumn.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                             Path="Header" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="药材名称" Binding="{Binding HerbName}" Width="150" />
                            <DataGridTextColumn Header="用量" Binding="{Binding Quantity}" Width="80" />
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" />
                            <DataGridTextColumn Header="处理方法" Binding="{Binding ProcessingMethod}" Width="100" />
                            <DataGridTextColumn Header="特殊说明" Binding="{Binding SpecialInstructions}" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.RowHeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                          Path=Header}" />
                            </DataTemplate>
                        </DataGrid.RowHeaderTemplate>
                    </DataGrid>
                </GroupBox>

                <!-- 备注信息 -->
                <GroupBox Grid.Row="2" Header="备注" Margin="0,0,0,15">
                    <TextBlock Text="{Binding Formula.Remark}"
                               TextWrapping="Wrap"
                               Margin="10"
                               MinHeight="40" />
                </GroupBox>

                <!-- 统计信息 -->
                <GroupBox Grid.Row="3" Header="统计信息" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="药材数量：" FontWeight="Bold" Margin="0,0,10,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HerbItems.Count}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="预估成本：" FontWeight="Bold" Margin="0,0,10,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalCost, StringFormat='￥{0:F2}'}" />
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- 按钮栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="打印" Command="{Binding PrintCommand}"
                            Width="80" Margin="0,0,10,0" />
                    <Button Content="导出" Command="{Binding ExportCommand}"
                            Width="80" Margin="0,0,10,0" />
                    <Button Content="关闭" Command="{Binding CloseCommand}"
                            Width="80" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>