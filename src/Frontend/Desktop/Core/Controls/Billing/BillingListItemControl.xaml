<UserControl x:Class="LYBT.WPF.Client.Controls.Billing.BillingListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:LYBT.WPF.Client.Core.Behaviors"
             xmlns:converters="clr-namespace:LYBT.WPF.Client.Core.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="900"
             behaviors:AnimationBehaviors.EnableFadeIn="True">
    
    <Border BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F5F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 账单图标 -->
            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="20"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                <Setter Property="Background" Value="#FF9800"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Paid">
                                <Setter Property="Background" Value="#4CAF50"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="PartiallyPaid">
                                <Setter Property="Background" Value="#2196F3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Refunded">
                                <Setter Property="Background" Value="#9C27B0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                <Setter Property="Background" Value="#F44336"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="¥"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

            <!-- 账单信息 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Id, StringFormat='账单号: {0:N}'}"
                           FontSize="12"
                           Foreground="#666"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PatientName}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 账单时间 -->
            <TextBlock Grid.Column="2"
                       Text="{Binding BillingTime, StringFormat='yyyy-MM-dd HH:mm'}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="#666"/>

            <!-- 总金额 -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Text="应收金额"
                           FontSize="11"
                           Foreground="#999"/>
                <TextBlock FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF5722"
                           Margin="0,2,0,0">
                    <TextBlock.Text>
                        <Binding Path="TotalAmount" StringFormat="¥{0:F2}"/>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- 已付金额 -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <TextBlock Text="已付金额"
                           FontSize="11"
                           Foreground="#999"/>
                <TextBlock FontSize="14"
                           FontWeight="Bold"
                           Foreground="#4CAF50"
                           Margin="0,2,0,0">
                    <TextBlock.Text>
                        <Binding Path="PaidAmount" StringFormat="¥{0:F2}"/>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- 状态 -->
            <Border Grid.Column="5"
                    CornerRadius="12" 
                    Padding="12,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                <Setter Property="Background" Value="#FFF3E0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Paid">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="PartiallyPaid">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Refunded">
                                <Setter Property="Background" Value="#F3E5F5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                    <Setter Property="Text" Value="待付款"/>
                                    <Setter Property="Foreground" Value="#F57C00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Paid">
                                    <Setter Property="Text" Value="已付款"/>
                                    <Setter Property="Foreground" Value="#388E3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="PartiallyPaid">
                                    <Setter Property="Text" Value="部分付款"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Refunded">
                                    <Setter Property="Text" Value="已退款"/>
                                    <Setter Property="Foreground" Value="#7B1FA2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter Property="Text" Value="已取消"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 待付金额 -->
            <TextBlock Grid.Column="6"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="#666"
                       Margin="10,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Paid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Refunded">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Text>
                    <MultiBinding StringFormat="待付: ¥{0:F2}">
                        <MultiBinding.Converter>
                            <converters:SubtractConverter/>
                        </MultiBinding.Converter>
                        <Binding Path="TotalAmount"/>
                        <Binding Path="PaidAmount"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="7"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- 收款 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="收款"
                        Command="{Binding DataContext.PayBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Paid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Refunded">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M5,6H23V18H5V6M14,9A3,3 0 0,1 17,12A3,3 0 0,1 14,15A3,3 0 0,1 11,12A3,3 0 0,1 14,9M9,8A2,2 0 0,1 7,10V14A2,2 0 0,1 9,16H19A2,2 0 0,1 21,14V10A2,2 0 0,1 19,8H9M1,10H3V20H19V22H1V10Z"
                                      Fill="#4CAF50" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 打印 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="打印账单"
                        Command="{Binding DataContext.PrintBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z"
                                      Fill="#2196F3" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 查看详情 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="查看详情"
                        Command="{Binding DataContext.ViewBillDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                      Fill="#666" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>