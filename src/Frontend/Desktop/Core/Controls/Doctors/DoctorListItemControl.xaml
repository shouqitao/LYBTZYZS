<UserControl x:Class="LYBT.WPF.Client.Controls.Doctors.DoctorListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="900">
    
    <Border BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F5F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 头像 -->
            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="20"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Gender, Converter={StaticResource GenderToTextConverter}}" Value="男">
                                <Setter Property="Background" Value="#2196F3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Gender, Converter={StaticResource GenderToTextConverter}}" Value="女">
                                <Setter Property="Background" Value="#E91E63"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Gender, Converter={StaticResource GenderToTextConverter}}" Value="未知">
                                <Setter Property="Background" Value="#9E9E9E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding RealName, Converter={StaticResource FirstCharacterConverter}}"
                          FontSize="16"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

            <!-- 姓名 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding RealName}"
                           FontSize="14"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding PinyinCode}"
                           FontSize="12"
                           Foreground="#666"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 性别 -->
            <TextBlock Grid.Column="2"
                       Text="{Binding Gender, Converter={StaticResource GenderToTextConverter}}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <!-- 职称 -->
            <Border Grid.Column="3"
                    Background="#E3F2FD" 
                    CornerRadius="12" 
                    Padding="12,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" 
                          FontSize="12"
                          Foreground="#1976D2"/>
            </Border>

            <!-- 专长 -->
            <TextBlock Grid.Column="4"
                       Text="{Binding Specialty}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Specialty}"/>

            <!-- 联系电话 -->
            <TextBlock Grid.Column="5"
                       Text="{Binding ContactNumber}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="#666"/>

            <!-- 工作状态 -->
            <Border Grid.Column="6"
                    CornerRadius="12" 
                    Padding="12,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WorkStatus}" Value="Clinic">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WorkStatus}" Value="Emergency">
                                <Setter Property="Background" Value="#FFF3E0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WorkStatus}" Value="Meeting">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WorkStatus}" Value="Leave">
                                <Setter Property="Background" Value="#F3E5F5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WorkStatus}" Value="OffDuty">
                                <Setter Property="Background" Value="#EFEBE9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WorkStatus}" Value="Clinic">
                                    <Setter Property="Text" Value="门诊"/>
                                    <Setter Property="Foreground" Value="#388E3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WorkStatus}" Value="Emergency">
                                    <Setter Property="Text" Value="急诊"/>
                                    <Setter Property="Foreground" Value="#F57C00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WorkStatus}" Value="Meeting">
                                    <Setter Property="Text" Value="会议"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WorkStatus}" Value="Leave">
                                    <Setter Property="Text" Value="请假"/>
                                    <Setter Property="Foreground" Value="#7B1FA2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WorkStatus}" Value="OffDuty">
                                    <Setter Property="Text" Value="下班"/>
                                    <Setter Property="Foreground" Value="#5D4037"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 执业证号 -->
            <TextBlock Grid.Column="7"
                       Text="{Binding LicenseNumber}"
                       FontSize="12"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="10,0"/>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="8"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- 查看详情 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="查看详情"
                        Command="{Binding DataContext.ViewDoctorDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                      Fill="#666" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 编辑 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="编辑"
                        Command="{Binding DataContext.EditDoctorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                      Fill="#666" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 排班 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="排班"
                        Command="{Binding DataContext.ScheduleDoctorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V8H19V19M12,10H17V12H12V10M12,14H17V16H12V14Z"
                                      Fill="#4CAF50" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>