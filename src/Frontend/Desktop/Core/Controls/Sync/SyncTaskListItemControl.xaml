<UserControl x:Class="LYBT.WPF.Client.Controls.Sync.SyncTaskListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:LYBT.WPF.Client.Core.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="800"
             behaviors:AnimationBehaviors.EnableFadeIn="True">
    
    <Border BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F5F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 同步任务图标 -->
            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="20"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="待执行">
                                <Setter Property="Background" Value="#607D8B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="执行中">
                                <Setter Property="Background" Value="#2196F3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="已完成">
                                <Setter Property="Background" Value="#4CAF50"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="失败">
                                <Setter Property="Background" Value="#F44336"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M16.24,7.76L15.07,6.59L12,9.66L8.93,6.59L7.76,7.76L10.83,10.83L7.76,13.9L8.93,15.07L12,12L15.07,15.07L16.24,13.9L13.17,10.83L16.24,7.76Z"
                      Fill="White" 
                      Width="20" 
                      Height="20"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="执行中">
                                    <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20V4Z"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="RotateStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="RenderTransform.Angle"
                                                    From="0" To="360"
                                                    Duration="0:0:2"
                                                    RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="RotateStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="已完成">
                                    <Setter Property="Data" Value="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Border>

            <!-- 任务信息 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Id, StringFormat='任务ID: {0:N}'}"
                           FontSize="12"
                           Foreground="#666"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding TaskType}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 触发时间 -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="触发时间"
                           FontSize="11"
                           Foreground="#999"/>
                <TextBlock Text="{Binding TriggerTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                           FontSize="13"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 执行时间（如果有） -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Text="执行时长"
                           FontSize="11"
                           Foreground="#999"/>
                <TextBlock Text="{Binding ExecutionTime, StringFormat='{}{0} 秒'}"
                           FontSize="13"
                           Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionTime}" Value="{x:Null}">
                                    <Setter Property="Text" Value="--"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 状态 -->
            <Border Grid.Column="4"
                    CornerRadius="12" 
                    Padding="12,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="待执行">
                                <Setter Property="Background" Value="#ECEFF1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="执行中">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="已完成">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="失败">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}"
                           FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="待执行">
                                    <Setter Property="Foreground" Value="#455A64"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="执行中">
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="已完成">
                                    <Setter Property="Foreground" Value="#388E3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="失败">
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- 立即执行 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="立即执行"
                        Command="{Binding DataContext.ExecuteTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="执行中">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="已完成">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                      Fill="#2196F3" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 取消执行 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="取消执行"
                        Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="待执行">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="已完成">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="失败">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M7,10L12,15L17,10H7Z"
                                      Fill="#F44336" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 查看日志 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="查看日志"
                        Command="{Binding DataContext.ViewTaskLogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M13,17V18H7V17H13M17,13V14H7V13H17M17,9V10H7V9H17Z"
                                      Fill="#666" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 查看详情 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="查看详情"
                        Command="{Binding DataContext.ViewTaskDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                      Fill="#666" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>