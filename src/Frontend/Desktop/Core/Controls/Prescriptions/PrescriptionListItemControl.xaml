<UserControl x:Class="LYBT.WPF.Client.Controls.Prescriptions.PrescriptionListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:LYBT.Desktop.Core.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="800"
             behaviors:AnimationBehaviors.EnableFadeIn="True">
    
    <Border BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F5F5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 处方图标 -->
            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="20"
                    Background="#FF5722"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">
                <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M12,7L13.5,9L19,9V11H13.5L12,13L10.5,11H5V9H10.5L12,7M7,13H17V15H7V13M7,17H17V19H7V17Z"
                      Fill="White" 
                      Width="20" 
                      Height="20"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Border>

            <!-- 处方编号 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Id, StringFormat='处方编号: {0:N}'}"
                           FontSize="13"
                           Foreground="#666"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding CreateTime, StringFormat='开具时间: {0:yyyy-MM-dd HH:mm}'}"
                           FontSize="12"
                           Foreground="#999"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 患者信息 -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="患者信息"
                           FontSize="12"
                           Foreground="#999"/>
                <TextBlock Text="{Binding PatientName}"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 医生信息 -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Text="开方医生"
                           FontSize="12"
                           Foreground="#999"/>
                <TextBlock Text="{Binding DoctorName}"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 状态 -->
            <Border Grid.Column="4"
                    CornerRadius="12" 
                    Padding="12,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Draft">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Submitted">
                                <Setter Property="Background" Value="#FFF3E0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Dispensed">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Draft">
                                    <Setter Property="Text" Value="草稿"/>
                                    <Setter Property="Foreground" Value="#1976D2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Submitted">
                                    <Setter Property="Text" Value="已提交"/>
                                    <Setter Property="Foreground" Value="#F57C00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Dispensed">
                                    <Setter Property="Text" Value="已配药"/>
                                    <Setter Property="Foreground" Value="#388E3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter Property="Text" Value="已取消"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 药品数量 -->
            <TextBlock Grid.Column="5"
                       Text="{Binding ItemCount, StringFormat='共 {0} 味药'}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="#666"
                       Margin="10,0"/>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- 查看详情 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="查看详情"
                        Command="{Binding DataContext.ViewPrescriptionDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                      Fill="#666" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 打印 -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="打印处方"
                        Command="{Binding DataContext.PrintPrescriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0"
                        Visibility="{Binding Status, Converter={StaticResource PrescriptionStatusToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z"
                                      Fill="#2196F3" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 编辑（仅草稿状态） -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="编辑"
                        Command="{Binding DataContext.EditPrescriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        Margin="4,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Draft">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="Visibility" Value="Collapsed">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="6">
                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                      Fill="#666" 
                                      Width="16" 
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>