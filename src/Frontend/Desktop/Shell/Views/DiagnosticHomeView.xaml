<UserControl x:Class="LYBT.WPF.Client.Shell.Views.DiagnosticHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Grid Background="LightGreen">
        <StackPanel Margin="20">
            <TextBlock Text="诊断HomeView - ViewModelLocator测试" 
                      FontSize="20" 
                      FontWeight="Bold"
                      Margin="0,0,0,20"/>
            
            <TextBlock x:Name="DiagnosticInfo" 
                      Text="正在检查ViewModel绑定..."
                      FontSize="14"/>
            
            <Border Background="White" 
                   BorderBrush="Gray" 
                   BorderThickness="1"
                   Margin="0,20,0,0"
                   Padding="10">
                <StackPanel>
                    <TextBlock Text="DataContext信息：" FontWeight="Bold"/>
                    <TextBlock x:Name="DataContextInfo" Text="未绑定"/>
                    
                    <TextBlock Text="ViewModel类型：" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ViewModelType" Text="未知"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>