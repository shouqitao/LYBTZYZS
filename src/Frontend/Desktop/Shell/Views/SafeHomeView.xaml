<UserControl x:Class="LYBT.Desktop.Shell.Views.SafeHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="False">
    
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="20">
            <StackPanel>
                <TextBlock Text="凌隐宝堂中医诊所诊疗系统" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock x:Name="WelcomeText"
                          Text="欢迎使用系统" 
                          FontSize="16" 
                          Foreground="#B3D9F2" 
                          Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                
                <!-- 快速开始 -->
                <Border Background="White" 
                       BorderBrush="#E0E0E0" 
                       BorderThickness="1" 
                       CornerRadius="5"
                       Margin="0,0,0,20"
                       Padding="20">
                    <StackPanel>
                        <TextBlock Text="快速开始" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Margin="0,0,0,15"/>
                        
                        <Button x:Name="StartConsultationBtn"
                               Height="60"
                               Background="#2E86AB"
                               Foreground="White"
                               FontSize="18"
                               Content="🩺 开始看诊"
                               Click="StartConsultation_Click"/>
                    </StackPanel>
                </Border>

                <!-- 功能模块 -->
                <Border Background="White" 
                       BorderBrush="#E0E0E0" 
                       BorderThickness="1" 
                       CornerRadius="5"
                       Padding="20">
                    <StackPanel>
                        <TextBlock Text="功能模块" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Margin="0,0,0,15"/>
                        
                        <WrapPanel>
                            <Button x:Name="PatientReceptionBtn"
                                   Width="150" Height="100" Margin="5"
                                   Click="PatientReception_Click">
                                <StackPanel>
                                    <TextBlock Text="🏥" FontSize="28"/>
                                    <TextBlock Text="患者接待" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="MedicalCaseBtn"
                                   Width="150" Height="100" Margin="5"
                                   Click="MedicalCase_Click">
                                <StackPanel>
                                    <TextBlock Text="📋" FontSize="28"/>
                                    <TextBlock Text="医疗案例" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="PrescriptionBtn"
                                   Width="150" Height="100" Margin="5"
                                   Click="Prescription_Click">
                                <StackPanel>
                                    <TextBlock Text="💊" FontSize="28"/>
                                    <TextBlock Text="处方查询" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="PatientManageBtn"
                                   Width="150" Height="100" Margin="5"
                                   Click="PatientManage_Click">
                                <StackPanel>
                                    <TextBlock Text="👥" FontSize="28"/>
                                    <TextBlock Text="患者管理" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="HerbViewBtn"
                                   Width="150" Height="100" Margin="5"
                                   Click="HerbView_Click">
                                <StackPanel>
                                    <TextBlock Text="🌿" FontSize="28"/>
                                    <TextBlock Text="药材查看" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="FormulaViewBtn"
                                   Width="150" Height="100" Margin="5"
                                   Click="FormulaView_Click">
                                <StackPanel>
                                    <TextBlock Text="📜" FontSize="28"/>
                                    <TextBlock Text="验方库" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- 管理员功能 -->
                            <Button x:Name="SystemManageBtn"
                                   Width="150" Height="100" Margin="5"
                                   Background="#8B4513"
                                   Foreground="White"
                                   Click="SystemManage_Click">
                                <StackPanel>
                                    <TextBlock Text="⚙️" FontSize="28"/>
                                    <TextBlock Text="系统管理" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="10,5">
                <TextBlock x:Name="StatusText" Text="就绪" HorizontalAlignment="Left"/>
                <TextBlock x:Name="DateTimeText" Text="2025-01-09" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>