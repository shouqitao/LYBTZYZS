<UserControl x:Class="LYBT.Desktop.Shell.Views.FullHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Height="80">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="凌隐宝堂中医诊所" 
                              FontSize="28" 
                              FontWeight="Bold" 
                              Foreground="White"/>
                    <TextBlock Text="管理系统" 
                              FontSize="20" 
                              Foreground="#B3D9F2" 
                              VerticalAlignment="Center" 
                              Margin="20,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="欢迎您，系统管理员" 
                              FontSize="16"
                              Foreground="White" 
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 - 不使用ScrollViewer，直接展示 -->
        <Grid Grid.Row="1" Background="#F5F7FA">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 欢迎信息 -->
                <Border Grid.Row="0" Background="White" 
                       BorderBrush="#E0E0E0" 
                       BorderThickness="1" 
                       CornerRadius="8"
                       Margin="0,0,0,20"
                       Padding="30,20">
                    <StackPanel>
                        <TextBlock Text="系统管理中心" 
                                  FontSize="24" 
                                  FontWeight="Bold"
                                  Foreground="#333333"/>
                        <TextBlock Text="选择以下功能模块开始使用系统" 
                                  FontSize="14" 
                                  Foreground="#666666"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- 功能模块网格 -->
                <Border Grid.Row="1" Background="White" 
                       BorderBrush="#E0E0E0" 
                       BorderThickness="1" 
                       CornerRadius="8"
                       Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="核心功能模块" 
                                  FontSize="18" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20"/>
                        
                        <!-- 第一行功能 -->
                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                            <Border Background="#52C41A" 
                                   CornerRadius="8" 
                                   Margin="10" 
                                   Height="120"
                                   Cursor="Hand">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="用户管理" 
                                                  FontSize="16" 
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  Foreground="White" 
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Border Background="#FAAD14" 
                                   CornerRadius="8" 
                                   Margin="10" 
                                   Height="120"
                                   Cursor="Hand">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="患者档案" 
                                                  FontSize="16" 
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  Foreground="White" 
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Border Background="#2E86AB" 
                                   CornerRadius="8" 
                                   Margin="10" 
                                   Height="120"
                                   Cursor="Hand">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🌿" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="药材管理" 
                                                  FontSize="16" 
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  Foreground="White" 
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                        
                        <!-- 第二行功能 -->
                        <UniformGrid Grid.Row="2" Columns="3">
                            <Border Background="#722ED1" 
                                   CornerRadius="8" 
                                   Margin="10" 
                                   Height="120"
                                   Cursor="Hand">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📜" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="验方管理" 
                                                  FontSize="16" 
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  Foreground="White" 
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Border Background="#F5222D" 
                                   CornerRadius="8" 
                                   Margin="10" 
                                   Height="120"
                                   Cursor="Hand">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="⚙️" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="系统设置" 
                                                  FontSize="16" 
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  Foreground="White" 
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <Border Background="#1890FF" 
                                   CornerRadius="8" 
                                   Margin="10" 
                                   Height="120"
                                   Cursor="Hand">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="数据备份" 
                                                  FontSize="16" 
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center" 
                                                  Foreground="White" 
                                                  Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#2C3E50" Height="35">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="系统就绪" 
                          Foreground="White"
                          VerticalAlignment="Center"
                          FontSize="12"/>
                
                <TextBlock Grid.Column="2" 
                          Text="凌隐宝堂中医诊所管理系统 v1.0" 
                          Foreground="White"
                          VerticalAlignment="Center"
                          FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>