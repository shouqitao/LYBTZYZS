<UserControl x:Class="LYBT.WPF.Client.Controls.Patients.PatientDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="400">
    
    <Border BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            CornerRadius="4" 
            Background="White"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="4"/>
        </Border.Effect>
        
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 头像区域 -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4"
                    Width="60" Height="60"
                    CornerRadius="30"
                    VerticalAlignment="Top"
                    Margin="0,0,16,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Gender}" Value="1">
                                <Setter Property="Background" Value="#2196F3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Gender}" Value="2">
                                <Setter Property="Background" Value="#E91E63"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Gender}" Value="0">
                                <Setter Property="Background" Value="#9E9E9E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharacterConverter}}"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

            <!-- 患者姓名和性别年龄 -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" 
                          FontSize="18" 
                          FontWeight="Bold"/>
                <TextBlock Margin="12,0,0,0"
                          FontSize="14"
                          Foreground="#666"
                          VerticalAlignment="Bottom">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}岁">
                            <Binding Path="Gender" Converter="{StaticResource GenderToTextConverter}"/>
                            <Binding Path="Age"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- 身份证号 -->
            <StackPanel Grid.Row="1" Grid.Column="1" 
                        Orientation="Horizontal" 
                        Margin="0,4,0,0">
                <TextBlock Text="身份证：" 
                          FontSize="12" 
                          Foreground="#999"/>
                <TextBlock Text="{Binding IDNumber, Converter={StaticResource IDNumberMaskConverter}}" 
                          FontSize="12" 
                          Foreground="#666"/>
            </StackPanel>

            <!-- 联系电话 -->
            <StackPanel Grid.Row="2" Grid.Column="1" 
                        Orientation="Horizontal" 
                        Margin="0,4,0,0">
                <TextBlock Text="电话：" 
                          FontSize="12" 
                          Foreground="#999"/>
                <TextBlock Text="{Binding PhoneNumber}" 
                          FontSize="12" 
                          Foreground="#666"/>
            </StackPanel>

            <!-- 标签和状态 -->
            <StackPanel Grid.Row="3" Grid.Column="1" 
                        Orientation="Horizontal" 
                        Margin="0,8,0,0">
                <!-- 会员标识 -->
                <Border Background="#FFF3E0" 
                        CornerRadius="10" 
                        Padding="8,2"
                        Margin="0,0,8,0"
                        Visibility="{Binding IsMember, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="会员" 
                              FontSize="11"
                              Foreground="#FF6F00"/>
                </Border>
                
                <!-- 过敏标识 -->
                <Border Background="#FFEBEE" 
                        CornerRadius="10" 
                        Padding="8,2"
                        Margin="0,0,8,0"
                        Visibility="{Binding HasAllergy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="过敏史" 
                              FontSize="11"
                              Foreground="#D32F2F"/>
                </Border>

                <!-- 最近就诊时间 -->
                <TextBlock FontSize="11"
                          Foreground="#999"
                          VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="最近就诊：{0:yyyy-MM-dd}">
                            <Binding Path="LastVisitTime"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>