<UserControl x:Class="LYBT.WPF.Client.Controls.FormulaTemplates.FormulaTemplateDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="450">
    
    <Border BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            CornerRadius="4" 
            Background="White"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="4"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部信息 -->
            <Border Grid.Row="0" 
                    Background="#F8F9FA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标和名称 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="36" Height="36"
                                CornerRadius="18"
                                Background="#9C27B0"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M12,9V13H9V15H15V13H12V9Z"
                                  Fill="White" 
                                  Width="20" 
                                  Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        
                        <TextBlock Text="{Binding Name}" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 创建信息 -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="创建人：" 
                                  FontSize="12" 
                                  Foreground="#999"/>
                        <TextBlock Text="{Binding CreatedBy}" 
                                  FontSize="12" 
                                  Foreground="#666"
                                  Margin="0,0,12,0"/>
                        <TextBlock Text="创建时间：" 
                                  FontSize="12" 
                                  Foreground="#999"/>
                        <TextBlock Text="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd}'}" 
                                  FontSize="12" 
                                  Foreground="#666"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 药材列表 -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="150"
                          Padding="16">
                <ItemsControl ItemsSource="{Binding Herbs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F0F0F0"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 序号 -->
                                    <Border Grid.Column="0"
                                            Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="#E8EAF6"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, 
                                                         Converter={StaticResource ItemIndexConverter}}"
                                                  FontSize="12"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 药材名称 -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>

                                    <!-- 剂量 -->
                                    <TextBlock Grid.Column="2"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#673AB7"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}{1}">
                                                <Binding Path="Dosage"/>
                                                <Binding Path="Unit"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- 价格 -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Price, StringFormat='￥{0:F2}'}"
                                               FontSize="13"
                                               Foreground="#FF5722"
                                               VerticalAlignment="Center"
                                               Margin="12,0"/>

                                    <!-- 备注 -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Remark}"
                                               FontSize="12"
                                               Foreground="#999"
                                               VerticalAlignment="Center"
                                               MaxWidth="100"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部备注和统计 -->
            <Border Grid.Row="2" 
                    Background="#F8F9FA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 备注 -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Remark}"
                               FontSize="12"
                               Foreground="#666"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 统计信息 -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal">
                        <TextBlock FontSize="12" 
                                  Foreground="#999">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="共 {0} 味药">
                                    <Binding Path="Herbs.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        
                        <TextBlock Text=" · " 
                                  FontSize="12" 
                                  Foreground="#999"
                                  Margin="8,0"/>
                        
                        <TextBlock FontSize="12" 
                                  Foreground="#FF5722"
                                  FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="预估 ￥{0:F2}">
                                    <Binding Path="EstimatedPrice"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>