<UserControl x:Class="LYBT.WPF.Client.Controls.Herbs.HerbDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="400">
    
    <UserControl.Resources>
        <!-- 显示模式样式 -->
        <Style x:Key="CompactBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        
        <Style x:Key="DetailedBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    
    <Border x:Name="RootBorder"
            BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            CornerRadius="4" 
            Background="White"
            Padding="16"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="4"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 药材名称和拼音码 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="32" Height="32"
                        CornerRadius="16"
                        Background="#4CAF50"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <Path Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"
                          Fill="White" 
                          Width="16" 
                          Height="16"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                    <Run Text=" (" Foreground="Gray" FontSize="14"/>
                    <Run Text="{Binding PinyinCode}" Foreground="Gray" FontSize="14"/>
                    <Run Text=")" Foreground="Gray" FontSize="14"/>
                </TextBlock>
            </StackPanel>

            <!-- 基本信息 -->
            <Grid Grid.Row="1" Margin="44,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="产地：" Foreground="#999" FontSize="13" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Origin}" FontSize="13" Margin="0,0,16,0"/>
                
                <TextBlock Grid.Column="2" Text="规格：" Foreground="#999" FontSize="13" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Spec}" FontSize="13"/>
            </Grid>

            <!-- 价格和库存 -->
            <Grid Grid.Row="2" Margin="44,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="￥" FontSize="14" Foreground="#FF5722" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Price, StringFormat='{}{0:F2}'}" 
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="#FF5722"
                             VerticalAlignment="Center"/>
                    <TextBlock Text=" / " Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Unit}" Foreground="#999" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="库存：" Foreground="#999" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Stock}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Unit}" Foreground="#999" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 库存状态指示器 -->
                <Border Grid.Column="2" 
                        CornerRadius="12" 
                        Padding="12,4"
                        HorizontalAlignment="Right">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StockStatusDescription}" Value="正常">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StockStatusDescription}" Value="库存不足">
                                    <Setter Property="Background" Value="#FFF3E0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StockStatusDescription}" Value="缺货">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StockStatusDescription}"
                              FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StockStatusDescription}" Value="正常">
                                        <Setter Property="Foreground" Value="#388E3C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StockStatusDescription}" Value="库存不足">
                                        <Setter Property="Foreground" Value="#F57C00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StockStatusDescription}" Value="缺货">
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- 功效（详细模式下显示） -->
            <Border Grid.Row="3" 
                    x:Name="EffectPanel"
                    Background="#F5F5F5"
                    CornerRadius="4"
                    Padding="12"
                    Margin="44,12,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="功效说明" 
                             FontSize="13"
                             FontWeight="Bold"
                             Foreground="#666"
                             Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Effect}" 
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="#666"
                             LineHeight="18"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>