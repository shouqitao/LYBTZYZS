<UserControl x:Class="LYBT.WPF.Client.Controls.Records.RecordDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="450">
    
    <Border BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            CornerRadius="4" 
            Background="White"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" Direction="270" Color="Black" Opacity="0.1" BlurRadius="4"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部信息 -->
            <Border Grid.Row="0" 
                    Background="#F0F7FF"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 患者信息 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="40" Height="40"
                                CornerRadius="20"
                                Background="#2196F3"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding PatientName, Converter={StaticResource FirstCharacterConverter}}"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PatientName}" 
                                      FontSize="16" 
                                      FontWeight="Bold"/>
                            <TextBlock FontSize="12" 
                                      Foreground="#666"
                                      Margin="0,2,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="就诊时间：{0:yyyy-MM-dd HH:mm}">
                                        <Binding Path="RecordTime"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- 共享状态 -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border CornerRadius="12" 
                                Padding="12,4"
                                Visibility="{Binding IsShared, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E3F2FD" Offset="0"/>
                                    <GradientStop Color="#FFF3E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z"
                                      Fill="#1976D2" 
                                      Width="14" 
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,4,0"/>
                                <TextBlock Text="已共享" 
                                          FontSize="12"
                                          Foreground="#1976D2"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock Text="{Binding Id}" 
                                  FontSize="11" 
                                  Foreground="#999"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 诊断内容 -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="100"
                          Padding="16">
                <TextBlock Text="{Binding Diagnosis}" 
                          TextWrapping="Wrap"
                          FontSize="14"
                          LineHeight="22"/>
            </ScrollViewer>

            <!-- 底部操作栏 -->
            <Border Grid.Row="2" 
                    Background="#FAFAFA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标签 -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal"
                                Margin="16,8">
                        <Border Background="#E8F5E9" 
                                CornerRadius="10" 
                                Padding="8,2"
                                Margin="0,0,8,0">
                            <TextBlock Text="中医诊断" 
                                      FontSize="11"
                                      Foreground="#388E3C"/>
                        </Border>
                        
                        <Border Background="#F3E5F5" 
                                CornerRadius="10" 
                                Padding="8,2"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasPrescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="已开方" 
                                      FontSize="11"
                                      Foreground="#7B1FA2"/>
                        </Border>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal"
                                Margin="16,4">
                        <Button Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="查看详情"
                                Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="6">
                                        <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                              Fill="#666" 
                                              Width="16" 
                                              Height="16"
                                              Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="打印"
                                Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="6">
                                        <Path Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z"
                                              Fill="#666" 
                                              Width="16" 
                                              Height="16"
                                              Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="{Binding IsShared, Converter={StaticResource BooleanToShareTooltipConverter}}"
                                Command="{Binding DataContext.ShareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="6">
                                        <Path Fill="#666" 
                                              Width="16" 
                                              Height="16"
                                              Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShared}" Value="True">
                                                            <Setter Property="Data" Value="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z"/>
                                                            <Setter Property="Fill" Value="#1976D2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsShared}" Value="False">
                                                            <Setter Property="Data" Value="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>