<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    
    <!-- Assembly Information -->
    <AssemblyTitle>LYBT.Shared.Interfaces</AssemblyTitle>
    <AssemblyDescription>凌隐宝堂中医诊所系统 - 共享接口定义库 | 前后端统一契约 | UltraThink架构标准</AssemblyDescription>
    <AssemblyCompany>凌隐宝堂中医诊所</AssemblyCompany>
    <AssemblyProduct>LYBT诊疗管理系统</AssemblyProduct>
    <AssemblyCopyright>Copyright © 凌隐宝堂中医诊所 2025</AssemblyCopyright>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-interfaces-enterprise</InformationalVersion>
    
    <!-- Package Information -->
    <PackageId>LYBT.Shared.Interfaces</PackageId>
    <PackageVersion>2.1.0</PackageVersion>
    <Authors>LYBT开发团队</Authors>
    <PackageDescription>LYBT中医诊所系统共享接口定义 - API客户端接口、业务服务接口、缓存服务接口 | UltraThink双层架构支持</PackageDescription>
    <PackageTags>中医;诊所;接口;契约;API;Refit;企业级;UltraThink</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/shouqitao/LYBTZYZS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DocumentationFile>bin\Debug\net8.0\LYBT.Shared.Interfaces.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>bin\Release\net8.0\LYBT.Shared.Interfaces.xml</DocumentationFile>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Refit" Version="8.0.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" />
  </ItemGroup>

</Project>
