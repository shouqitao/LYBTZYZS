<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- P2-5-7 刻意允许：Entities 依赖 Shared.Models 仅复用 UserRole 等枚举（纯值类型），使领域实体不重定义枚举；08-shared.md 已标注“枚举复用例外”，避免反向依赖争议 -->
    <ProjectReference Include="..\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
  </ItemGroup>

  <!-- 构建时复制文档文件到统一文档目录 -->
  <Target Name="CopyDocumentationFiles" AfterTargets="Build">
    <ItemGroup>
      <DocumentationFiles Include="*.md" />
    </ItemGroup>
    <Copy SourceFiles="@(DocumentationFiles)" DestinationFiles="@(DocumentationFiles->'$(MSBuildProjectDirectory)\..\Documentation\$(MSBuildProjectName)_%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
