{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LYBTDB;Integrated Security=true;TrustServerCertificate=true;"
  },
  "JwtOptions": {
    "Secret": "DEVELOPMENT-ONLY-JWT-SECRET-REPLACE-IN-PRODUCTION",
    "Issuer": "LYBT.WebAPI",
    "Audience": "LYBT.Client",
    "ExpireMinutes": 480,
    "RememberMeExpireMinutes": 43200,
    "ClockSkewSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "LYBT.Infrastructure.Database.DatabaseInitializationService": "Information"
    }
  },
  "AllowedHosts": "*",
  "DefaultPasswords": {
    "SystemAdmin": "DEVELOPMENT-ONLY-ADMIN-PASSWORD",
    "NewUser": "DEVELOPMENT-ONLY-USER-PASSWORD",
    "EnableInDevelopment": true,
    "AllowInProduction": false,
    "OnlyWhenDatabaseEmpty": true,
    "ExpiryDays": 30
  },
  "AuthOptions": {
    "MaxFailedLoginAttempts": 5,
    "AccountLockoutDuration": "00:15:00",
    "EnableDetailedLoginLogging": true
  },
  "UserOptions": {
    "DefaultUserPassword": "DEVELOPMENT-ONLY-USER-PASSWORD",
    "EnableUserCache": true,
    "MaxBatchOperationSize": 100,
    "EnableDetailedAuditLogging": true
  },
  "SysAdminOptions": {
    "DefaultPassword": "DEVELOPMENT-ONLY-ADMIN-PASSWORD",
    "RequirePasswordChangeOnFirstLogin": true,
    "EnableAccountLockout": false
  }
}