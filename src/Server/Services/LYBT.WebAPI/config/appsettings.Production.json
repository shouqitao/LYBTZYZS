{
  "_comment": "生产环境配置 - 仅包含与 appsettings.json 不同的覆盖项",

  "Server": {
    "Endpoints": {
      "Http": {
        "Enabled": true,
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Enabled": false,
        "Url": "https://0.0.0.0:5001",
        "Certificate": {
          "Path": "",
          "Password": ""
        }
      }
    }
  },

  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_SERVER};Database=LYBTDB_Dev;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },

  "Jwt": {
    "SecretKey": "${Jwt__SecretKey}",
    "AccessTokenExpirationMinutes": 30
  },

  "DefaultPasswords": {
    "SysAdminPassword": "${DefaultPasswords__SysAdminPassword}",
    "NewUserPassword": "${DefaultPasswords__NewUserPassword}"
  },

  "Database": {
    "EnsureCreatedInDevelopment": false,
    "ConnectionPool": {
      "MinConnections": 10
    }
  },

  "Logging": {
    "_comment": "节名 Logging（非 Lybt:Logging）——LoggingOptions.SectionName 绑定；DB 日志清理 + 文件日志归档（F-08）",
    "Cleanup": {
      "Enabled": true,
      "RetentionDays": 90,
      "CleanupIntervalHours": 24,
      "InitialDelayMinutes": 5,
      "BatchSize": 1000
    },
    "Archive": {
      "Enabled": true,
      "ArchiveAfterDays": 7,
      "ArchiveDirectory": "archive",
      "DeleteSourceAfterArchive": true,
      "IntervalHours": 24,
      "InitialDelayMinutes": 10,
      "FilePrefixes": [ "lybt-web-api", "bootstrap" ],
      "LogDirectory": "logs"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lybt-web-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "LYBT.WebAPI",
      "Environment": "Production"
    }
  },

  "Cors": {
    "AllowedOrigins": ["http://60.190.215.86:5000"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Request-Id", "X-Correlation-Id"],
    "AllowCredentials": true,
    "MaxAge": 86400
  },

  "DesktopUpdate": {
    "Enabled": true,
    "ReleasesPath": "C:\\Services\\LYBT-releases",
    "MaxRetentionCount": 5,
    "DownloadBaseUrl": "/releases",
    "FeedUrl": "https://your-server.example.com/releases",
    "CheckEndpoint": "/api/version",
    "_comment": "Desktop 自动升级：ReleasesPath 与 WebAPI 部署目录独立，避免 publish 清空"
  },

  "SystemAdmin": {
    "AllowAutoCreateInProduction": false,
    "InitialSetupToken": "${SystemAdmin__InitialSetupToken}"
  },

  "Swagger": {
    "Enabled": false,
    "_comment": "Swagger API 文档开关：生产默认关闭（安全隐藏）。测试发布需在线查看文档时注入环境变量 Swagger__Enabled=true（.env 或服务环境变量——无需改本文件）"
  }
}
