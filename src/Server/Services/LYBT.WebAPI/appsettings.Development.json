{
  "_comment": "开发环境完整配置 - 包含所有必要配置和宽松默认值",
  "_comment_secrets": "安全提示：真实密码/密钥已从本文件移除。开发环境注入方式（二选一）：① dotnet user-secrets（推荐）——在 src/Server/Services/LYBT.WebAPI 目录执行：dotnet user-secrets set \"ConnectionStrings:DefaultConnection\" \"Server=192.168.190.243;Database=LYBTDB_Dev;User ID=sa;Password=<真实密码>;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true\" 与 dotnet user-secrets set \"Jwt:SecretKey\" \"<Base64密钥,解码后>=32字节>\"；② 环境变量——在 .env.development（Program.cs 启动时自动加载）中设置 ConnectionStrings__DefaultConnection / Jwt__SecretKey。缺少注入时本环境无法启动（属预期安全行为）。",

  "ConnectionStrings": {
    "DefaultConnection": "Server=192.168.190.243;Database=LYBTDB_Dev;User ID=sa;Password=__REPLACE__;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Jwt": {
    "SecretKey": "${JWT_SECRET}",
    "Issuer": "LYBT.WebAPI.Dev",
    "Audience": "LYBT.Client.Dev",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },

  "Security": {
    "RateLimiting": {
      "Enabled": false
    },
    "AccountLockout": {
      "Enabled": true,
      "MaxFailedCount": 5,
      "LockoutMinutes": 15
    }
  },

  "Database": {
    "AutoMigrate": true,
    "EnsureCreatedInDevelopment": true
  },

  "SystemAdmin": {
    "UserName": "sysadmin",
    "Email": "admin@lybt.local",
    "DisplayName": "系统管理员",
    "AutoCreateOnStartup": true,
    "SessionTimeoutMinutes": 240
  },

  "DefaultPasswords": {
    "SysAdminPassword": "DevPass123!",
    "NewUserPassword": "DevPass123!",
    "ForceChangeOnFirstLogin": false
  },

  "Json": {
    "UnsafeRelaxedEscaping": true,
    "PropertyNamingPolicy": "CamelCase",
    "IgnoreReadOnlyProperties": false,
    "AllowTrailingCommas": false
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning",
        "Microsoft.WebTools.BrowserLink": "Fatal",
        "Microsoft.AspNetCore.Watch.BrowserRefresh": "Fatal"
      }
    }
  }
}
