{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LYBTDB;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true;Connection Timeout=30"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "LYBT.WebAPI.Dev",
      "Audience": "LYBT.Client.Dev",
      "AccessTokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7,
      "ClockSkewSeconds": 300,
      "RequireHttps": false,
      "_comment": "密钥通过用户机密或环境变量配置，不要在配置文件中硬编码"
    }
  },
  "DatabaseOptions": {
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "EnableAutoMigration": true
  },
  "DefaultPasswords": {
    "EnableInDevelopment": true,
    "SysAdminPassword": "Dev@Admin2025!",
    "NewUserPassword": "Dev@User2025!",
    "ForceChangeOnFirstLogin": true
  },
  "RateLimiting": {
    "Enabled": false
  }
}