{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=:memory:"
  },
  "Lybt": {
    "Infrastructure": {
      "Database": {
        "ConnectionString": "DataSource=:memory:",
        "Migration": {
          "AutoMigrate": false,
          "EnsureCreatedInDevelopment": false
        }
      }
    },
    "Authentication": {
      "Jwt": {
        "SecretKey": "TestSecretKey_MinLength32Characters_ForJWTTokenGeneration_123456789",
        "Issuer": "LYBT.WebAPI.Tests",
        "Audience": "LYBT.Client.Tests",
        "AccessTokenExpirationMinutes": 30,
        "RefreshTokenExpirationDays": 7
      },
      "DefaultPasswords": {
        "SysAdminPassword": "Admin@123456",
        "NewUserPassword": "User@123456"
      }
    },
    "Business": {
      "SystemAdmin": {
        "Username": "sysadmin",
        "Email": "admin@test.com",
        "AutoCreateOnStartup": true
      }
    }
  }
}
