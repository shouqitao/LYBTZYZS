{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=LYBT_Test;Integrated Security=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True"
  },
  "JWT": {
    "SecretKey": "LybtTestSecretKey2025WithMinimum256BitLengthForHS256Algorithm",
    "Issuer": "LYBT-Test",
    "Audience": "LYBT-Test-Client",
    "ExpireMinutes": 480,
    "RememberMeExpireDays": 30
  },
  "Security": {
    "EnableRateLimiting": false,
    "EnableCors": true,
    "AllowedOrigins": ["http://localhost:*", "https://localhost:*"],
    "EnableHttpsRedirection": false,
    "EnableAuthenticationCheck": true,
    "EnableAuthorizationCheck": true
  }
}