{
  "_comment": "集成测试环境配置 - Issue #2231",
  "_comment2": "JWT配置必须与IntegrationTestBase.GenerateTestToken()保持一致",
  "_comment3": "配置节使用扁平路径（与appsettings.json一致），勿使用Lybt:前缀",

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "InMemory"
  },

  "Jwt": {
    "SecretKey": "VGVzdFNlY3JldEtleV9NaW5MZW5ndGgzMkNoYXJzX0ZvckpXVFRva2VuR2VuX0xZQlRfMTIzNDU2",
    "Issuer": "LYBT.WebAPI.Tests",
    "Audience": "LYBT.Client.Tests",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },

  "DefaultPasswords": {
    "SysAdminPassword": "TestAdmin2025@",
    "NewUserPassword": "Test2025@",
    "ForceChangeOnFirstLogin": false
  },

  "Security": {
    "RateLimiting": {
      "Enabled": false
    },
    "AccountLockout": {
      "Enabled": false
    }
  },

  "Database": {
    "AutoMigrate": false,
    "EnsureCreatedInDevelopment": false,
    "Monitoring": {
      "Enabled": false,
      "LogAllQueries": false
    }
  },

  "MemoryCache": {
    "Enabled": true,
    "SizeLimit": 10485760,
    "DefaultExpirationMinutes": 5
  },

  "SystemAdmin": {
    "UserName": "sysadmin",
    "Email": "admin@lybt.com",
    "DisplayName": "系统管理员",
    "AutoCreateOnStartup": false,
    "AllowAutoCreateInProduction": false
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
