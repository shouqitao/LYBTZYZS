{
  "_comment": "集成测试环境配置 - Issue #2231",
  "_comment2": "JWT配置必须与IntegrationTestBase.GenerateTestToken()保持一致",

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "InMemory"
  },

  "Lybt": {
    "Jwt": {
      "SecretKey": "TestSecretKey_MinLength32Characters_ForJWTTokenGeneration_123456789",
      "Issuer": "LYBT.WebAPI.Tests",
      "Audience": "LYBT.Client.Tests",
      "AccessTokenExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7,
      "ClockSkewSeconds": 300
    },
    "DefaultPasswords": {
      "SysAdminPassword": "TestAdmin2025@",
      "NewUserPassword": "Test2025@",
      "ForceChangeOnFirstLogin": false
    },
    "Security": {
      "RateLimiting": {
        "Enabled": false
      }
    },
    "Database": {
      "Migration": {
        "AutoMigrate": false,
        "EnsureCreatedInDevelopment": false
      },
      "Monitoring": {
        "Enabled": false,
        "LogAllQueries": false
      }
    },
    "MemoryCache": {
      "Enabled": true,
      "SizeLimit": 10485760,
      "DefaultExpirationMinutes": 5
    },
    "SystemAdmin": {
      "UserName": "sysadmin",
      "Email": "admin@lybt.com",
      "DisplayName": "系统管理员",
      "AutoCreateOnStartup": false
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
