<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
  <UserSecretsId>2e58e08c-c618-42e2-afc6-44f2bb2efbc8</UserSecretsId>
	  <!-- 为集成测试项目提供内部类型访问权限 -->
	  <InternalsVisibleTo>LYBT.WebAPI.Tests</InternalsVisibleTo>
  </PropertyGroup>

	<ItemGroup>
	  <Compile Remove="logs\**" />
	  <Compile Remove="obj\**" />
	  <Content Remove="logs\**" />
	  <Content Remove="obj\**" />
	  <EmbeddedResource Remove="logs\**" />
	  <EmbeddedResource Remove="obj\**" />
	  <None Remove="logs\**" />
	  <None Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove=".encryption-key" />
	  <None Remove="appsettings.ClinicOptimized.json.backup" />
	  <None Remove="appsettings.json.backup" />
	  <None Remove="appsettings.Production.json.backup" />
	  <None Remove="current-startup.log" />
	  <None Remove="nul" />
	  <None Remove="webapi-start.log" />
	  <None Remove="webapi-startup.log" />
	  <None Remove="webapi.log" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="appsettings.Test.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<!-- OpenSpec: adopt-mapperly-unified-mapping - AutoMapper已移除，改用Mapperly -->
		<PackageReference Include="EPPlus" />
		<!-- Epic #1731: FluentValidation ASP.NET Core集成 -->
		<PackageReference Include="FluentValidation.AspNetCore" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
		<PackageReference Include="Asp.Versioning.Mvc" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
		<!-- Serilog structured logging packages -->
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.MSSqlServer" />
		<PackageReference Include="Serilog.Enrichers.Environment" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<!-- Windows Service支持 -->
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
		<!-- .env文件支持 -->
		<PackageReference Include="DotNetEnv" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Shared\LYBT.Shared.Configuration\LYBT.Shared.Configuration.csproj" />
		<ProjectReference Include="..\..\..\Shared\LYBT.Shared.Models\LYBT.Shared.Models.csproj" />
		<ProjectReference Include="..\..\..\Shared\LYBT.Shared.Utilities\LYBT.Shared.Utilities.csproj" />
		<!-- consolidate-exception-handling: 统一异常处理 -->
		<ProjectReference Include="..\..\..\Shared\LYBT.Shared.ExceptionHandling\LYBT.Shared.ExceptionHandling.csproj" />
		<!-- Phase 3: Auth模块已启用 -->
		<ProjectReference Include="..\..\Modules\LYBT.Module.Auth\LYBT.Module.Auth.csproj" />
		<ProjectReference Include="..\..\Modules\LYBT.Module.Users\LYBT.Module.Users.csproj" />
		<ProjectReference Include="..\..\Modules\LYBT.Module.Herbs\LYBT.Module.Herbs.csproj" />
		<ProjectReference Include="..\..\Modules\LYBT.Module.Patients\LYBT.Module.Patients.csproj" />
		<ProjectReference Include="..\..\Modules\LYBT.Module.Formula\LYBT.Module.Formula.csproj" />
		<ProjectReference Include="..\..\Modules\LYBT.Module.MedicalCase\LYBT.Module.MedicalCase.csproj" />
		<!-- OpenSpec: implement-data-sync - 数据同步模块 -->
		<ProjectReference Include="..\..\Modules\LYBT.Module.Sync\LYBT.Module.Sync.csproj" />
	</ItemGroup>

</Project>