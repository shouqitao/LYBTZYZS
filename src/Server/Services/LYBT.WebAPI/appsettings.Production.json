{
  "_comment1": "🔒 生产环境配置 - Production Environment Configuration",
  "_comment2": "⚠️ 所有敏感信息通过环境变量配置，禁止硬编码密钥",
  "_comment3": "🛡️ 启用安全设置，禁用详细错误信息",
  "AllowedHosts": "*",
  "Lybt": {
    "Authentication": {
      "Jwt": {
        "SecretKey": "#{JWT_SECRET_KEY}#",
        "Issuer": "LYBT.WebAPI.Production",
        "Audience": "LYBT.Client.Production",
        "ExpireMinutes": 480,
        "RememberMeExpireMinutes": 43200,
        "ClockSkewSeconds": 300,
        "RequireHttps": true
      },
      "Options": {
        "MaxFailedLoginAttempts": 3,
        "AccountLockoutDuration": "01:00:00",
        "EnableDetailedLoginLogging": false
      }
    },
    "Infrastructure": {
      "Database": {
        "ConnectionString": "#{DATABASE_CONNECTION_STRING}#",
        "Options": {
          "EnableSensitiveDataLogging": false,
          "EnableDetailedErrors": false,
          "CommandTimeout": 60,
          "ConnectionRetryCount": 5,
          "ConnectionRetryDelay": 30,
          "EnableQueryTracing": false,
          "EnableAutoMigration": false
        },
        "Monitoring": {
          "LogAllQueries": false
        }
      },
      "Cache": {
        "Enabled": true,
        "GlobalKeyPrefix": "LYBT:PROD:",
        "Memory": {
          "SizeLimit": 50000,
          "CompactionPercentage": 0.05,
          "ExpirationScanFrequencySeconds": 120,
          "DefaultCacheDurationMinutes": 30,
          "NullCacheDurationMinutes": 5,
          "UseSlidingExpiration": true,
          "DefaultItemSize": 1,
          "PriorityStrategy": "Performance",
          "EnableStatistics": false,
          "LogEvictions": false
        },
        "Monitoring": {
          "Enabled": false,
          "SamplingIntervalSeconds": 300,
          "HitRateThreshold": 0.9,
          "CapacityThreshold": 0.9,
          "EvictionRateThreshold": 200,
          "HistorySnapshotCount": 5,
          "EnablePerformanceCounters": false
        }
      }
    },
    "Security": {
      "DefaultPasswords": {
        "EnableInDevelopment": false,
        "AllowInProduction": false,
        "OnlyWhenDatabaseEmpty": true,
        "ExpiryDays": 1,
        "SysAdminPassword": "#{ADMIN_DEFAULT_PASSWORD}#",
        "NewUserPassword": "#{USER_DEFAULT_PASSWORD}#"
      },
      "RateLimiting": {
        "Enabled": true,
        "Global": {
          "PermitLimit": 200,
          "WindowSeconds": 60,
          "QueueLimit": 0
        },
        "Login": {
          "PermitLimit": 5,
          "InternalPermitLimit": 20,
          "WindowSeconds": 60,
          "QueueLimit": 0,
          "InternalQueueLimit": 0
        },
        "Api": {
          "UserPermitLimit": 100,
          "AdminPermitLimit": 200,
          "WindowSeconds": 60,
          "QueueLimit": 0
        },
        "WhitelistedIPs": []
      }
    },
    "Users": {
      "EnableUserCache": true,
      "MaxBatchOperationSize": 50,
      "EnableDetailedAuditLogging": false,
      "SysAdmin": {
        "Username": "#{SYSADMIN_USERNAME}#",
        "DefaultPassword": "#{ADMIN_DEFAULT_PASSWORD}#",
        "RequirePasswordChangeOnFirstLogin": true,
        "EnableAccountLockout": true
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error", 
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "LYBT.Module": "Information",
        "LYBT.WebAPI.Controllers": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lybt-web-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "#{DATABASE_CONNECTION_STRING}#",
          "sinkOptionsSection": {
            "tableName": "SystemLogs",
            "schemaName": "dbo",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 100,
            "period": "00:00:10"
          },
          "columnOptionsSection": {
            "disableTriggers": true,
            "clusteredColumnstoreIndex": false,
            "primaryKeyColumnName": "Id",
            "addStandardColumns": ["LogEvent"],
            "removeStandardColumns": ["MessageTemplate", "Level", "TimeStamp", "Exception", "Properties"],
            "additionalColumns": [
              {"ColumnName": "UserId", "DataType": "uniqueidentifier", "AllowNull": true},
              {"ColumnName": "RequestId", "DataType": "nvarchar", "DataLength": 36, "AllowNull": true},
              {"ColumnName": "MachineName", "DataType": "nvarchar", "DataLength": 100, "AllowNull": true},
              {"ColumnName": "ThreadId", "DataType": "int", "AllowNull": true}
            ],
            "id": {"columnName": "Id", "nonClusteredIndex": false},
            "level": {"columnName": "Level", "storeAsEnum": false},
            "timeStamp": {"columnName": "Timestamp"},
            "message": {"columnName": "Message"},
            "exception": {"columnName": "Exception"},
            "messageTemplate": {"columnName": "LoggerName"},
            "properties": {"columnName": "Properties"}
          },
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "LYBT.WebAPI",
      "Environment": "Production"
    }
  }
}