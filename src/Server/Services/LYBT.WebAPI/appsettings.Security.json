{
  "Security": {
    "EncryptionKey": "${ENCRYPTION_KEY}",
    "Https": {
      "RequireHttps": true,
      "HstsMaxAgeDays": 365,
      "HstsIncludeSubdomains": true,
      "HstsPreload": true
    },
    "SecurityHeaders": {
      "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
      "XFrameOptions": "DENY",
      "XContentTypeOptions": "nosniff",
      "ReferrerPolicy": "strict-origin-when-cross-origin",
      "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    },
    "PasswordPolicy": {
      "MinLength": 12,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialChar": true,
      "ForbiddenPatterns": [
        "password",
        "123456",
        "qwerty",
        "admin",
        "user",
        "test",
        "changeme",
        "welcome",
        "login"
      ],
      "PasswordHistoryCount": 5,
      "PasswordExpiryDays": 90
    },
    "RateLimit": {
      "Enabled": true,
      "General": {
        "RequestsPerMinute": 100,
        "RequestsPerHour": 1000,
        "RequestsPerDay": 10000
      },
      "Authentication": {
        "RequestsPerMinute": 5,
        "RequestsPerHour": 20,
        "RequestsPerDay": 100
      },
      "ApiKey": {
        "RequestsPerMinute": 300,
        "RequestsPerHour": 5000,
        "RequestsPerDay": 50000
      }
    },
    "Environment": {
      "HideServerInfo": true,
      "HideDetailedErrors": true,
      "EnableSensitiveDataLogging": false,
      "AllowedHosts": [
        "localhost",
        "127.0.0.1",
        "lybt.example.com"
      ],
      "TrustedProxies": [
        "127.0.0.1",
        "::1"
      ]
    }
  },
  "JwtOptions": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "LYBT.WebAPI",
    "Audience": "LYBT.Client",
    "ExpireMinutes": 15,
    "RememberMeExpireMinutes": 43200,
    "ClockSkewSeconds": 300,
    "RefreshTokenExpirationDays": 7,
    "MinKeyLengthBits": 256,
    "EnableMultiKeyValidation": true,
    "_comment": "安全强化配置 - AccessToken: 15分钟, RefreshToken: 7天, 256位密钥强度"
  },
  "AllowedHosts": "localhost;127.0.0.1;lybt.example.com",
  "DefaultPasswords": {
    "SystemAdmin": "${ADMIN_DEFAULT_PASSWORD}",
    "NewUser": "${USER_DEFAULT_PASSWORD}",
    "EnableInDevelopment": true,
    "AllowInProduction": false,
    "OnlyWhenDatabaseEmpty": true,
    "ExpiryDays": 30
  },
  "AuthOptions": {
    "MaxFailedLoginAttempts": 5,
    "AccountLockoutDuration": "00:15:00",
    "EnableDetailedLoginLogging": false
  },
  "UserOptions": {
    "DefaultUserPassword": "${USER_DEFAULT_PASSWORD}",
    "EnableUserCache": true,
    "MaxBatchOperationSize": 100,
    "EnableDetailedAuditLogging": false
  },
  "SysAdminOptions": {
    "DefaultPassword": "${ADMIN_DEFAULT_PASSWORD}",
    "RequirePasswordChangeOnFirstLogin": true,
    "EnableAccountLockout": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "LYBT.Infrastructure.Database.DatabaseInitializationService": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "IncludeScopes": false,
      "LogToStandardErrorThreshold": "Error"
    }
  }
}