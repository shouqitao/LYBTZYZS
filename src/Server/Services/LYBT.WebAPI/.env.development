# ===== LYBT WebAPI Development Environment Defaults =====
# 开发环境默认配置（可提交到版本控制）
# 开发者可创建本地 .env 文件覆盖这些值

# === 运行环境 ===
ASPNETCORE_ENVIRONMENT=Development

# === 数据库配置 ===
# 开发环境使用Windows身份验证（信任的本地连接）
ConnectionStrings__DefaultConnection=Server=localhost;Database=LYBTDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=30;Max Pool Size=20;Min Pool Size=2;Pooling=true;Application Name=LYBT.WebAPI

# === JWT配置 ===
# 开发环境使用固定的JWT密钥（仅用于开发）
#  生产环境必须使用环境变量覆盖此值
Lybt__Jwt__SecretKey=J4CM3t5EsIA9COGVMpQJoAHfX/mgeIbKxrlbXNKfv34T6AGxRnD/2fRJmh932xWypxhjl0nm7whrsdK9PcY9fw==

# 开发环境使用较长的令牌过期时间（方便调试）
# 测试滑动过期：临时设为5分钟
Lybt__Jwt__AccessTokenExpirationMinutes=5
Lybt__Jwt__ClockSkewSeconds=30
Lybt__Jwt__RefreshTokenExpirationDays=7

# === 数据库连接池配置 ===
# 开发环境使用较小的连接池
Lybt__Database__ConnectionPool__MaxConnections=20
Lybt__Database__ConnectionPool__MinConnections=2

# === 缓存配置 ===
# 开发环境使用较小的缓存（5MB）
Lybt__MemoryCache__SizeLimit=5242880

# === 日志配置 ===
# 开发环境使用Debug级别日志
Serilog__MinimumLevel__Default=Debug

# === 安全配置 ===
# 开发环境禁用限流（方便测试）
Lybt__Security__RateLimiting__Enabled=false

# 开发环境允许所有主机
AllowedHosts=*
