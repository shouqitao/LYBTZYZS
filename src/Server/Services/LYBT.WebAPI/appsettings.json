{
  "_comment1": "⚠️ 警告：此配置文件仅限开发环境使用！生产环境请使用 appsettings.Security.json + 环境变量",
  "_comment2": "⚠️ WARNING: This configuration file is for DEVELOPMENT ONLY! Use appsettings.Security.json + Environment Variables in Production",
  "_comment3": "🔒 包含开发用的默认密钥和连接字符串，禁止在生产环境使用",
  "AllowedHosts": "*",
  "AuthOptions": {
    "MaxFailedLoginAttempts": 5,
    "AccountLockoutDuration": "00:15:00",
    "EnableDetailedLoginLogging": false
  },
  "CacheOptions": {
    "DefaultExpiryMinutes": 30,
    "CacheType": "Memory",
    "MemoryCache": {
      "SizeLimit": 200,
      "CompactionPercentage": 0.10,
      "ExpirationScanFrequency": 30
    },
    "Performance": {
      "EnableCompression": true,
      "CompressionThreshold": 1024,
      "EnableAsync": true,
      "AsyncTimeout": 5000
    },
    "Statistics": {
      "Enabled": false,
      "TrackKeys": false,
      "TrackPerformance": false,
      "RetentionDays": 1
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LYBTDB;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=30;Max Pool Size=20;Min Pool Size=2;Pooling=true"
  },
  "DatabaseOptions": {
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "CommandTimeout": 30,
    "ConnectionRetryCount": 3,
    "ConnectionRetryDelay": 30,
    "EnableQueryTracing": false
  },
  "DefaultPasswords": {
    "EnableInDevelopment": true,
    "AllowInProduction": false,
    "OnlyWhenDatabaseEmpty": true,
    "ExpiryDays": 30
  },
  "JwtOptions": {
    "Secret": "LYBT_JWT_Secret_Key_For_Development_Use_Only_32_Characters_Long_001",
    "Issuer": "LYBT.WebAPI",
    "Audience": "LYBT.Client",
    "ExpireMinutes": 480,
    "RememberMeExpireMinutes": 43200,
    "ClockSkewSeconds": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning", 
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "LYBT.Module": "Information",
        "LYBT.WebAPI.Controllers": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lybt-web-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=localhost;Database=LYBTDB;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=30;Max Pool Size=20;Min Pool Size=2;Pooling=true",
          "sinkOptionsSection": {
            "tableName": "SystemLogs",
            "schemaName": "dbo",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 50,
            "period": "00:00:05"
          },
          "columnOptionsSection": {
            "disableTriggers": true,
            "clusteredColumnstoreIndex": false,
            "primaryKeyColumnName": "Id",
            "addStandardColumns": ["LogEvent"],
            "removeStandardColumns": ["MessageTemplate", "Level", "TimeStamp", "Exception", "Properties"],
            "additionalColumns": [
              {"ColumnName": "UserId", "DataType": "uniqueidentifier", "AllowNull": true},
              {"ColumnName": "RequestId", "DataType": "nvarchar", "DataLength": 36, "AllowNull": true},
              {"ColumnName": "MachineName", "DataType": "nvarchar", "DataLength": 100, "AllowNull": true},
              {"ColumnName": "ThreadId", "DataType": "int", "AllowNull": true}
            ],
            "id": {"columnName": "Id", "nonClusteredIndex": false},
            "level": {"columnName": "Level", "storeAsEnum": false},
            "timeStamp": {"columnName": "Timestamp"},
            "message": {"columnName": "Message"},
            "exception": {"columnName": "Exception"},
            "messageTemplate": {"columnName": "LoggerName"},
            "properties": {"columnName": "Properties"}
          },
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "LYBT.WebAPI"
    }
  },
  "SysAdminOptions": {
    "Username": "clinic_admin",
    "DefaultPassword": "LybtAdmin2025@SecurePass!",
    "RequirePasswordChangeOnFirstLogin": true,
    "EnableAccountLockout": false
  },
  "UserOptions": {
    "EnableUserCache": true,
    "MaxBatchOperationSize": 100,
    "EnableDetailedAuditLogging": false
  }
}
