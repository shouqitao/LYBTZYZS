{
  "_comment1": "凌隐宝堂WebAPI统一配置文件",
  "_comment2": "Issue #1932: 配置整合 - 单一配置文件 + 环境变量覆盖",
  "_comment3": "本地开发：使用 .env.development 默认配置（已加载为环境变量）",
  "_comment4": "生产部署：使用系统环境变量覆盖以下默认值",
  "_comment5": "关键环境变量：DATABASE_CONNECTION_STRING, JWT_SECRET_KEY, JWT_ACCESS_TOKEN_EXPIRATION 等",

  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "_comment": "Epic #1934: 最大请求体大小10MB（用于批量导入Excel文件）"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LYBTDB;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=30;Max Pool Size=20;Min Pool Size=2;Pooling=true;Application Name=LYBT.WebAPI"
  },

  "Lybt": {
    "_comment_phase3.1": "Issue #1761 Phase 3.1: 配置扁平化 - Authentication.* → 顶层",
    "Jwt": {
      "SecretKey": "J4CM3t5EsIA9COGVMpQJoAHfX/mgeIbKxrlbXNKfv34T6AGxRnD/2fRJmh932xWypxhjl0nm7whrsdK9PcY9fw==",
      "Issuer": "LYBT.WebAPI",
      "Audience": "LYBT.Client",
      "AccessTokenExpirationMinutes": 30,
      "RefreshTokenExpirationDays": 7,
      "ClockSkewSeconds": 300,
      "_comment": "JWT配置 - 开发环境默认值，生产环境通过环境变量覆盖"
    },
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireSpecialChar": true
    },
    "Session": {
      "TimeoutMinutes": 120,
      "AllowConcurrentSessions": false,
      "SlidingExpiration": true
    },
    "DefaultPasswords": {
      "SysAdminPassword": "LybtAdmin2025@SecurePass#",
      "NewUserPassword": "Lybt2025@TempPass#",
      "ForceChangeOnFirstLogin": true,
      "_comment": " 生产环境必须通过环境变量覆盖默认密码"
    },
    "Security": {
      "RateLimiting": {
        "Enabled": true,
        "GlobalLimit": {
          "PermitLimit": 200,
          "WindowSeconds": 60,
          "QueueLimit": 0
        },
        "LoginLimit": {
          "PermitLimit": 5,
          "InternalPermitLimit": 20,
          "WindowSeconds": 60,
          "QueueLimit": 0,
          "InternalQueueLimit": 0
        },
        "ApiLimit": {
          "PermitLimit": 100,
          "AdminPermitLimit": 200,
          "WindowSeconds": 60,
          "QueueLimit": 0
        },
        "WhitelistedIPs": ["127.0.0.1", "::1"]
      }
    },
    "_comment_phase2.2": "Issue #1761 Phase 2.2: 配置扁平化 - Infrastructure.* → 顶层",
    "Database": {
      "Migration": {
        "AutoMigrate": false,
        "EnsureCreatedInDevelopment": true
      },
      "ConnectionPool": {
        "MaxConnections": 20,
        "MinConnections": 2,
        "ConnectionTimeoutSeconds": 30,
        "CommandTimeoutSeconds": 30,
        "_comment": "连接池配置 - 可通过 DB_MAX_CONNECTIONS 和 DB_MIN_CONNECTIONS 环境变量覆盖"
      },
      "Monitoring": {
        "Enabled": true,
        "LogAllQueries": false,
        "SlowQueryThresholdMs": 1000
      },
      "RetryPolicy": {
        "MaxRetryCount": 3,
        "BaseDelayMs": 1000,
        "MaxDelayMs": 10000
      }
    },
    "MemoryCache": {
      "Enabled": true,
      "SizeLimit": 104857600,
      "CompactionPercentage": 0.05,
      "ExpirationScanFrequencySeconds": 60,
      "DefaultExpirationMinutes": 5,
      "_comment": "缓存大小限制 - 可通过 CACHE_SIZE_LIMIT 环境变量覆盖（单位：字节）"
    },
    "_comment_phase3.1_business": "Issue #1761 Phase 3.1: 配置扁平化 - Business.* → 顶层",
    "UserManagement": {
      "DefaultRole": "Staff",
      "AllowSelfRegistration": false,
      "RequireEmailConfirmation": true,
      "EnableUserCache": true,
      "MaxBatchOperationSize": 100,
      "EnableDetailedAuditLogging": false
    },
    "SystemAdmin": {
      "UserName": "sysadmin",
      "Email": "admin@lybt.com",
      "DisplayName": "系统管理员",
      "AutoCreateOnStartup": true,
      "SessionTimeoutMinutes": 240,
      "_comment": "系统管理员配置 - 可通过 SYSADMIN_USERNAME 和 SYSADMIN_EMAIL 环境变量覆盖"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "LYBT.Module": "Information",
        "LYBT.WebAPI.Controllers": "Information"
      },
      "_comment": "日志级别 - 可通过 LOG_LEVEL 环境变量覆盖 Default 级别"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lybt-web-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionStringName": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "SystemLogs",
            "schemaName": "dbo",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 50,
            "period": "00:00:05"
          },
          "columnOptionsSection": {
            "disableTriggers": true,
            "clusteredColumnstoreIndex": false,
            "primaryKeyColumnName": "Id",
            "addStandardColumns": ["LogEvent"],
            "removeStandardColumns": ["MessageTemplate", "Level", "TimeStamp", "Exception", "Properties"],
            "additionalColumns": [
              {"ColumnName": "UserId", "DataType": "uniqueidentifier", "AllowNull": true},
              {"ColumnName": "RequestId", "DataType": "nvarchar", "DataLength": 36, "AllowNull": true},
              {"ColumnName": "MachineName", "DataType": "nvarchar", "DataLength": 100, "AllowNull": true},
              {"ColumnName": "ThreadId", "DataType": "int", "AllowNull": true}
            ],
            "id": {"columnName": "Id", "nonClusteredIndex": false},
            "level": {"columnName": "Level", "storeAsEnum": false},
            "timeStamp": {"columnName": "Timestamp"},
            "message": {"columnName": "Message"},
            "exception": {"columnName": "Exception"},
            "messageTemplate": {"columnName": "LoggerName"},
            "properties": {"columnName": "Properties"}
          },
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "LYBT.WebAPI"
    }
  }
}
