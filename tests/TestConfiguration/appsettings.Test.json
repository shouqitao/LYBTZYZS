{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LYBTDB;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=30;Application Name=LYBT.IntegrationTests"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Testing": {
    "DatabaseProvider": "SqlServer",
    "SeedTestData": true,
    "CleanupAfterTests": true,
    "UseTransactions": true,
    "DatabaseTimeout": 30
  },
  "Authentication": {
    "JwtSettings": {
      "SecretKey": "TestSecretKey_MinimumLength32Characters_ForTestingOnly!",
      "Issuer": "LYBT.Test",
      "Audience": "LYBT.Test.API",
      "AccessTokenExpiryInHours": 8,
      "RefreshTokenExpiryInDays": 30
    }
  }
}