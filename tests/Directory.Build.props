<!-- Directory.Build.props - 测试项目统一配置 -->
<Project>

  <!-- 导入根目录配置 -->
  <Import Project="..\Directory.Build.props" />

  <!-- 测试项目特定配置 -->
  <PropertyGroup>
    <!-- 测试结果输出路径（统一到BIN目录） -->
    <TestResultsDirectory>$(MSBuildThisFileDirectory)..\BIN\TestResults\</TestResultsDirectory>

    <!-- 覆盖率报告输出路径（统一到BIN目录） -->
    <CoverletOutputDirectory>$(MSBuildThisFileDirectory)..\BIN\TestResults\Coverage\</CoverletOutputDirectory>

    <!-- 测试项目不生成XML文档 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- 测试项目始终包含私有资产 -->
    <IsPackable>false</IsPackable>

    <!-- 启用测试并行执行 -->
    <RunParallel>true</RunParallel>

    <!-- 测试运行设置文件（使用tests目录下的配置） -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>

    <!-- 解决 Coverlet 并行测试时的文件锁定问题 -->
    <!-- 为每个测试项目创建依赖程序集的本地副本 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- 测试框架包版本管理 -->
  <PropertyGroup>
    <XUnitVersion>2.6.6</XUnitVersion>
    <XUnitRunnerVersion>2.5.7</XUnitRunnerVersion>
    <MoqVersion>4.20.72</MoqVersion>
    <FluentAssertionsVersion>6.12.2</FluentAssertionsVersion>
    <CoverletVersion>6.0.2</CoverletVersion>
  </PropertyGroup>

  <!-- 通用测试包引用 - 统一配置coverlet.collector -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>