<!-- Directory.Build.props - 测试项目统一配置 -->
<Project>

  <!-- 导入根目录配置 -->
  <Import Project="..\Directory.Build.props" />

  <!-- 测试项目特定配置 -->
  <PropertyGroup>
    <!-- 测试结果输出路径（统一到BIN目录） -->
    <TestResultsDirectory>$(MSBuildThisFileDirectory)..\BIN\TestResults\</TestResultsDirectory>

    <!-- 覆盖率报告输出路径（统一到BIN目录） -->
    <CoverletOutputDirectory>$(MSBuildThisFileDirectory)..\BIN\TestResults\Coverage\</CoverletOutputDirectory>

    <!-- 测试项目不生成XML文档 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- 测试项目始终包含私有资产 -->
    <IsPackable>false</IsPackable>

    <!-- 启用测试并行执行 -->
    <RunParallel>true</RunParallel>

    <!-- 测试运行设置文件（使用tests目录下的配置） -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>

    <!-- 解决 Coverlet 并行测试时的文件锁定问题 -->
    <!-- 为每个测试项目创建依赖程序集的本地副本 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- 包版本通过 Directory.Packages.props (CPM) 集中管理 -->
  <!-- coverlet.collector 已移至 Directory.Build.targets，避免重复定义 -->

</Project>