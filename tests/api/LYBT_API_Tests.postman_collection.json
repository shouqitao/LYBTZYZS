{
  "info": {
    "name": "LYBT医疗系统API测试集合",
    "description": "用于测试LYBT中医诊所管理系统所有API端点的完整测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// 设置基础URL",
          "pm.globals.set('base_url', 'http://localhost:5297');"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5297",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 认证测试",
      "item": [
        {
          "name": "1.1 健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('健康检查状态正常', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.status).to.eql('Healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 数据库健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health/database",
              "host": ["{{base_url}}"],
              "path": ["api", "health", "database"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('数据库连接正常', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.status).to.eql('Healthy');",
                  "    pm.expect(response.isConnected).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 超级管理员登录",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sysadmin\",\n  \"password\": \"Admin@123456\",\n  \"rememberMe\": true,\n  \"loginType\": \"Password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/Auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "Auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('登录成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data.token).to.be.a('string');",
                  "    pm.expect(response.data.user.userName).to.eql('sysadmin');",
                  "    pm.expect(response.data.user.role).to.eql('Admin');",
                  "    ",
                  "    // 保存JWT令牌供后续请求使用",
                  "    pm.globals.set('jwt_token', response.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.4 密码哈希测试",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/Auth/hashPassword?password=TestPassword123",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "Auth", "hashPassword"],
              "query": [
                {
                  "key": "password",
                  "value": "TestPassword123"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('密码哈希生成成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data.hash).to.be.a('string');",
                  "    pm.expect(response.data.hash.length).to.be.above(50);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. 业务模块测试",
      "item": [
        {
          "name": "2.1 用户管理",
          "item": [
            {
              "name": "获取活跃用户",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/Users/active",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Users", "active"]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('用户管理端点可访问', function () {",
                      "    pm.response.to.have.status(200);",
                      "    const response = pm.response.json();",
                      "    pm.expect(Array.isArray(response)).to.be.true;",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "搜索用户",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"keyword\": \"admin\",\n  \"pageIndex\": 1,\n  \"pageSize\": 10\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/Users/search",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Users", "search"]
                }
              }
            }
          ]
        },
        {
          "name": "2.2 患者管理",
          "item": [
            {
              "name": "获取活跃患者",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/Patients/active",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Patients", "active"]
                }
              }
            },
            {
              "name": "分页获取患者",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/Patients/paged?pageIndex=1&pageSize=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Patients", "paged"],
                  "query": [
                    {
                      "key": "pageIndex",
                      "value": "1"
                    },
                    {
                      "key": "pageSize",
                      "value": "10"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "2.3 医生管理",
          "item": [
            {
              "name": "获取活跃医生",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/Doctors/active",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Doctors", "active"]
                }
              }
            },
            {
              "name": "分页获取医生",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/Doctors/paged?pageIndex=1&pageSize=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Doctors", "paged"],
                  "query": [
                    {
                      "key": "pageIndex",
                      "value": "1"
                    },
                    {
                      "key": "pageSize",
                      "value": "10"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "2.4 收费管理",
          "item": [
            {
              "name": "获取收费记录",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/Billing",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Billing"]
                }
              }
            }
          ]
        },
        {
          "name": "2.5 处方管理",
          "item": [
            {
              "name": "获取处方列表",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/Prescriptions",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Prescriptions"]
                }
              }
            }
          ]
        },
        {
          "name": "2.6 排队管理",
          "item": [
            {
              "name": "获取排队列表",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/Queueing",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "Queueing"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. 授权测试",
      "item": [
        {
          "name": "3.1 无token访问受保护端点",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/Users/active",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "Users", "active"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('无认证访问应该被拒绝', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 无效token访问",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid_token_here",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/Users/active",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "Users", "active"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('无效token应该被拒绝', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. 性能和负载测试",
      "item": [
        {
          "name": "4.1 并发登录测试",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sysadmin\",\n  \"password\": \"Admin@123456\",\n  \"rememberMe\": true,\n  \"loginType\": \"Password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/Auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "Auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('响应时间小于2秒', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test('登录成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}