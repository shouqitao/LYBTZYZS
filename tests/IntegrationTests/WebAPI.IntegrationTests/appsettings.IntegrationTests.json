{
  "_comment1": "集成测试专用配置文件",
  "_comment2": "数据库连接字符串将由 CustomWebApplicationFactory 动态生成",
  "_comment3": "JWT 密钥使用测试专用值，不得用于生产环境",

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=LYBT_IntegrationTest;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "Lybt": {
    "Authentication": {
      "Jwt": {
        "SecretKey": "TestSecretKey_ForIntegrationTests_DoNotUseInProduction_123456789012345678901234567890123456789012345678901234567890==",
        "Issuer": "LYBT.WebAPI.IntegrationTests",
        "Audience": "LYBT.Client.IntegrationTests",
        "AccessTokenExpirationMinutes": 30,
        "RefreshTokenExpirationDays": 7,
        "ClockSkewSeconds": 300
      },
      "PasswordPolicy": {
        "MinLength": 8,
        "RequireDigit": true,
        "RequireLowercase": true,
        "RequireUppercase": true,
        "RequireSpecialChar": true
      },
      "Session": {
        "TimeoutMinutes": 120,
        "AllowConcurrentSessions": false,
        "SlidingExpiration": true
      },
      "DefaultPasswords": {
        "SysAdminPassword": "Admin123!",
        "NewUserPassword": "Test123!",
        "ForceChangeOnFirstLogin": false
      }
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
