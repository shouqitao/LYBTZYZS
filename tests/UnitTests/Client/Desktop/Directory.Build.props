<Project>
  <!-- Desktop测试项目共享配置 - WPF测试隔离 -->

  <ItemGroup>
    <!-- 复制xunit.runner.json到输出目录以禁用并行执行 -->
    <!-- 这解决了WPF Application.Current静态单例在并行测试时的冲突问题 -->
    <None Include="$(MSBuildThisFileDirectory)..\..\..\TestConfiguration\xunit.runner.json"
          Link="xunit.runner.json"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
