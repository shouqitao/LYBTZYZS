<Project>
  <!-- Server测试项目共享配置 - SQLite InMemory数据库测试 -->
  <!--
    长期优化方案（Microsoft官方推荐）:
    1. 使用SQLite InMemory替代EF Core InMemory Provider
    2. SQLite提供真正的SQL语法、事务支持和外键约束
    3. 禁用并行执行确保测试隔离
  -->

  <ItemGroup>
    <!-- SQLite InMemory测试数据库依赖 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用TestConfiguration项目获取测试基础设施 -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\TestConfiguration\LYBT.Tests.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复制xunit.runner.json到输出目录以禁用并行执行 -->
    <!-- 这解决了数据库在并行测试时的数据冲突问题 -->
    <None Include="$(MSBuildThisFileDirectory)..\..\TestConfiguration\xunit.runner.json"
          Link="xunit.runner.json"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
