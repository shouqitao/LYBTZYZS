{
  "info": {
    "name": "Set Variable Test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "myVar", "value": "" }
  ],
  "item": [
    {
      "name": "Set It",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('myVar', 'test-value-123');",
              "pm.test('Set OK', function() { pm.expect(pm.collectionVariables.get('myVar')).to.eql('test-value-123'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Read It",
      "request": {
        "method": "GET",
        "url": "https://httpbin.org/get"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Read OK', function() { pm.expect(pm.collectionVariables.get('myVar')).to.eql('test-value-123'); });"
            ]
          }
        }
      ]
    }
  ]
}
