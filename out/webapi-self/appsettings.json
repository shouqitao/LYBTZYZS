{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LYBTDB;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true;Connection Timeout=30;Command Timeout=30;Max Pool Size=20;Min Pool Size=2;Pooling=true"
  },
  "JwtOptions": {
    "Secret": "4/HC5fsPxo8xwjDyWCRZ96ZjD/9+pta7QyMmskmCeNLtInboBQBhaBxmriyOm93i",
    "Issuer": "LYBT.WebAPI",
    "Audience": "LYBT.Client",
    "ExpireMinutes": 480,
    "RememberMeExpireMinutes": 43200,
    "ClockSkewSeconds": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lybt-web-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "LYBT.WebAPI",
      "Environment": "Development"
    }
  },
  "AllowedHosts": "*",
  "AuthOptions": {
    "MaxFailedLoginAttempts": 5,
    "AccountLockoutDuration": "00:15:00",
    "EnableDetailedLoginLogging": true
  },
  "UserOptions": {
    "DefaultUserPassword": "ChangeMe123",
    "EnableUserCache": true,
    "MaxBatchOperationSize": 100,
    "EnableDetailedAuditLogging": true
  },
  "CacheOptions": {
    "DefaultExpiryMinutes": 30,
    "CacheType": "Memory",
    "MemoryCache": {
      "SizeLimit": 200,
      "CompactionPercentage": 0.10,
      "ExpirationScanFrequency": 30
    },
    "Performance": {
      "EnableCompression": true,
      "CompressionThreshold": 1024,
      "EnableAsync": true,
      "AsyncTimeout": 5000
    },
    "Statistics": {
      "Enabled": true,
      "TrackKeys": true,
      "TrackPerformance": true,
      "RetentionDays": 7
    }
  },
  "SysAdminOptions": {
    "DefaultPassword": "Admin@123456",
    "RequirePasswordChangeOnFirstLogin": true,
    "EnableAccountLockout": false
  },
  "DatabaseOptions": {
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "CommandTimeout": 30,
    "ConnectionRetryCount": 3,
    "ConnectionRetryDelay": 30,
    "EnableQueryTracing": false
  }
}